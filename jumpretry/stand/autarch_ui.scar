-- STAND ONLY: JumpRetry test - the autarch is selected and the camera looks at the target; the jump order itself is
-- clicked through the HUD by the driver script (xdotool), so it goes through CommandProxy like a player's order.
local L = eliteai_log or (string and string.eliteai_log) or print
local SBP = "sbps/pvp/race_eldar/troops/eld_autarch"
AT = { n = 0, t = 0 }
local TRIAL_T = 8 * 16
local function hgt(s)
	local p = Squad_GetPosition(s)
	local ok, h = pcall(World_GetSurfaceHeight, p.x, p.z)
	if ok and type(h) == "number" then return p.y - h, p end
	return -99, p
end
local function st(s)
	local c = "none"
	if Squad_HasActiveCommand(s) then c = tostring(Squad_GetActiveCommand(s)) end
	return c .. (Squad_IsMoving(s) and " moving" or " still")
end
function AT_Start()
	AT.n = AT.n + 1
	if AT.s then Squad_Destroy(AT.s) end
	local base = AT.base
	AT.sp = World_Pos(base.x + 25, base.y, base.z + 25)
	local ang = 2 * math.pi * 3 / 8                                  -- the direction with the hop (stand 1, 03.11)
	AT.tp = World_Pos(AT.sp.x + 72 * math.cos(ang), AT.sp.y, AT.sp.z + 72 * math.sin(ang))
	AT.s = Squad_CreateAndSpawnToward(World_GetPropertyBagGroupID(SBP), AT.P, 0, AT.sp, AT.tp)
	AT.g = SGroup_CreateIfNotFound("at_g" .. AT.n); SGroup_Add(AT.g, AT.s); SGroup_SetInvulnerable(AT.g, true)
	Squad_ModifyEnergy(AT.s, 500)
	AT.e0 = Squad_GetEnergy(AT.s); AT.t = 0; AT.last = ""; AT.hops = 0; AT.inhop = false; AT.fired = false
		Misc_SelectSquad(AT.s, true)
	Camera_FocusOnPosition(AT.tp, false, 0, false)
	L(string.format("READY %d start=(%.1f,%.1f) target=(%.1f,%.1f) energy=%.1f", AT.n, AT.sp.x, AT.sp.z, AT.tp.x, AT.tp.z, AT.e0))
end
local function finish()
	local p = Squad_GetPosition(AT.s)
	local dx, dz = p.x - AT.tp.x, p.z - AT.tp.z
	L(string.format("RESULT %d fired=%s hops=%d dist_to_target=%.1f energy=%.1f pos=(%.1f,%.1f) state=%s", AT.n, tostring(AT.fired),
		AT.hops, math.sqrt(dx * dx + dz * dz), Squad_GetEnergy(AT.s), p.x, p.z, st(AT.s)))
end
function AT_Tick()
	if not AT.s then return end
	AT.t = AT.t + 1
	if AT.t == 12 or AT.t == 20 then local m = Misc_GetMouseOnTerrain(); if m then L(string.format("  mouse=(%.1f,%.1f)", m.x, m.z)) end end
	local s = st(AT.s); local h, p = hgt(AT.s); local en = Squad_GetEnergy(AT.s)
	if s ~= AT.last then L(string.format("  t=%.3f %s h=%.2f e=%.0f pos=(%.1f,%.1f)", AT.t / 8, s, h, en, p.x, p.z)); AT.last = s end
	if h > 0.6 and h < 5 and not AT.inhop and not AT.fired then AT.inhop = true; AT.hops = AT.hops + 1; L(string.format("  t=%.3f HOP h=%.2f", AT.t / 8, h)) end
	if h < 0.3 then AT.inhop = false end
	if en < AT.e0 - 30 and not AT.fired then AT.fired = true; L(string.format("  t=%.3f FIRED e=%.0f", AT.t / 8, en)) end
	if AT.t >= TRIAL_T then finish(); AT_Start() end
end
function AT_Setup()
	AT.P = World_GetPlayerAt(1)
	AT.base = Player_GetStartingPosition(AT.P)
	AT_Start()
end
Rule_AddOneShot(AT_Setup, 3)
Rule_AddInterval(AT_Tick, 0.125)
L("autarch ui test loaded")
