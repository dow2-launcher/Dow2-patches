-- EliteAI combat director, SCAR side: appended by EliteAI.dll to Elite's elite.scar (loaded in every game).
-- The AI scripts can't give orders themselves (no Command_* in the AI state); the new AI queues them in EliteAI.dll,
-- this rule takes the queue once a second and issues them. No new AI in the game = empty queue = nothing happens.
local _take = eliteai_take_orders or (string and string.eliteai_take_orders)
local _log = eliteai_log or (string and string.eliteai_log) or function() end

-- 0.9: the new AI tells which variant it plays (pseudo-order: id = player id, x = 1..3, mode 9) -> a kicker text over the
-- local player's first squad, repeated for ~10 s ("New AI - variant B (orks)"). NOT Game_ShowSystemMessage: it pauses the
-- simulation (stand 1, 10.11: the match froze right after it).
EliteAI_VariantSeen, EliteAI_VariantText, EliteAI_VariantShows = {}, nil, 0
local function variant_note(pid, v)
	if EliteAI_VariantSeen[pid] then return end
	EliteAI_VariantSeen[pid] = true
	local letter = string.char(64 + math.floor(v + 0.5))
	local who = ""
	pcall(function() who = " (" .. string.gsub(Player_GetRaceName(Player_FromId(pid)), "_race$", "") .. ")" end)
	EliteAI_VariantText = (EliteAI_VariantText and EliteAI_VariantText .. ",  " or "New AI - ") .. "variant " .. letter .. who
	EliteAI_VariantShows = 5
	_log("variant message", pid, letter, EliteAI_VariantText)
end
local function variant_show()
	if EliteAI_VariantShows <= 0 or not EliteAI_VariantText then return end
	EliteAI_VariantShows = EliteAI_VariantShows - 1
	local ok, err = pcall(function()
		local lp = Game_GetLocalPlayer()
		if lp == nil then EliteAI_VariantShows = 0; return end   -- an observer has no player of its own: Player_GetSquads(nil) stops the match
		local sg = Player_GetSquads(lp)
		if SGroup_CountSpawned(sg) == 0 then return end
		local sq = SGroup_GetSpawnedSquadAt(sg, 1)
		if Squad_Count(sq) == 0 then return end
		UI_CreateSquadKickerMessage(lp, sq, LOC(EliteAI_VariantText))
	end)
	if not ok then _log("PCALLERR scar_variant", tostring(err)); EliteAI_VariantShows = 0 end
end

-- main.ai 0.13: 6 = one reinforcement for the squad (no position). mechanics.ai 0.8: 10 = the dodge policy (see DODGE below).
-- mechanics.ai (combat mechanics of the director) orders: 4 = attack the squad with world id x (0.3: its building when it
-- sits in one); 5 = capture the strategic
-- point at x,y,z (the entity is looked up near the position); 100+k = squad ability k at x,y,z; 200+k = squad ability k on
-- the squad with world id x. k = index in EliteAI_MECH_ABILITIES - THE SAME NUMBERING as ABIL in mechanics.ai (keep in sync).
-- Ability ids are resolved lazily (World_GetPropertyBagGroupID, as unitstats v3) - an unused race's abilities are never looked up.
EliteAI_MECH_ABILITIES = {
	[1] = "ability/pvp/race_marine/sm_repair_pvp",
	[2] = "ability/pvp/race_imperial_guard/ig_repair_pvp",
	[3] = "ability/pvp/race_ork/sluggas/ork_repair",
	[4] = "ability/pvp/race_ork/gretchin/grot_repair",
	[5] = "ability/pvp/race_eldar/guardian/eld_repair",
	[6] = "ability/pvp/race_chaos/cultist/csm_repair",
	[7] = "ability/pvp/race_tau/pathfinders/tau_repair",
	[8] = "ability/pvp/race_marine/assault_marine/sm_jump_target_assault",
	[9] = "ability/pvp/race_chaos/raptor/csm_jump_raptor",
	[10] = "ability/pvp/race_ork/stormboys/ork_jump_target_stormboy",
	[11] = "ability/pvp/race_tyranid/ravener/tyr_jump_target_ravener",
	[12] = "ability/pvp/race_eldar/autarch/eld_autarch_jump",
	-- 13-19 (mechanics.ai 0.3, Garrison): grenades thrown at the position of a building with an enemy squad inside
	-- (position-targeted like the jumps; some need a squad upgrade - without it the engine ignores the order)
	[13] = "ability/pvp/race_marine/scout/sm_damage_aoe_grenade",
	[14] = "ability/pvp/race_imperial_guard/devils/ig_grenade_launch_triple",
	[15] = "ability/pvp/race_imperial_guard/kasrkin/ig_damage_aoe_grenade",
	[16] = "ability/pvp/race_eldar/guardian/eld_damage_aoe_grenade",
	[17] = "ability/pvp/race_ork/stikkbomma/ork_damage_aoe_stikkbomb",
	[18] = "ability/pvp/race_chaos/cultist/csm_knockback_aoe_grenades",
	[19] = "ability/pvp/race_grey_knights/storm_troopers/gk_storm_trooper_grenade",
	-- 20 (mechanics.ai 0.9, Defence): the manticore's rockets at the position of a turret, from outside its zone (range 40-150)
	[20] = "ability/pvp/race_imperial_guard/manticore/ig_manticore_shot",
	-- 21-25 (mechanics.ai 0.9, Counter): position abilities that stun / slow a dangerous melee squad (X.CONTROL there)
	[21] = "ability/pvp/race_ork/stikkbomma/ork_immobilize_aoe_stungrenade",
	[22] = "ability/pvp/race_ork/kommandos/ork_immobilize_aoe_stungrenade",
	[23] = "ability/pvp/race_tau/pathfinders/tau_slow_grenade",
	[24] = "ability/pvp/race_grey_knights/operatives/gk_operative_stunbomb",
	[25] = "ability/pvp/race_tyranid/warrior/tyr_electroshock_grub",
	-- mechanics.ai 1.1 (Orca fb 538): the hive tyrant's bioplasma (position), the lictor brood's leap (position, a jump), the
	-- lictor alpha's flesh hook (cast on a squad: mode 200+k)
	[26] = "ability/pvp/race_tyranid/hive_tyrant/tyr_damage_aoe_bioplasma",
	[27] = "ability/pvp/race_tyranid/lictor/tyr_jump_target_leap",
	[28] = "ability/pvp/race_tyranid/lictor_hero/tyr_damage_target_fleshhook",
}
EliteAI_MechAbilityIDs = {}
local function mech_ability(k)
	local name = EliteAI_MECH_ABILITIES[k]
	if not name then return nil end
	local id = EliteAI_MechAbilityIDs[k]
	if id == nil then
		local ok, v = pcall(World_GetPropertyBagGroupID, name)
		id = (ok and v) or false
		EliteAI_MechAbilityIDs[k] = id
		_log("MECH ability", k, name, id and "ok" or ("NOT FOUND " .. tostring(v)))
	end
	return id or nil
end
-- the strategic point entity nearest to pos (neutral or enemy-owned), into the egroup; nil when none within 8 m
local function mech_point(player, pos)
	local eg = EGroup_CreateIfNotFound("eliteai_mech_pts")
	local best, bd
	for _, ot in ipairs({ OT_Neutral, OT_Enemy }) do
		EGroup_Clear(eg)
		World_GetEntitiesNearPoint(player, eg, pos, 8, ot)
		for i = 1, EGroup_CountSpawned(eg) do
			local e = EGroup_GetSpawnedEntityAt(eg, i)
			if Entity_IsStrategicPoint(e) then
				local p = Entity_GetPosition(e)
				local d = (p.x - pos.x) * (p.x - pos.x) + (p.z - pos.z) * (p.z - pos.z)
				if not best or d < bd then best, bd = e, d end
			end
		end
	end
	if not best then return nil end
	EGroup_Clear(eg); EGroup_Add(eg, best)
	return eg
end
local function mech_order(sg, sq, m, x, y, z)
	if m == 4 or m >= 200 then
		local tid = tonumber(x)
		local tsq = Squad_IsValid and Squad_IsValid(tid) and Squad_FromWorldID(tid)
		if not tsq or Squad_Count(tsq) == 0 then return end
		if m == 4 then
			-- mechanics.ai 0.3 (Garrison): a squad inside a building is attacked through the building it holds
			-- (Squad_IsInHoldEntity / Squad_GetHoldEntity: groups.scar:1891-1892, SGroup_GetGarrisonedBuildingEntity)
			local hold = Squad_IsInHoldEntity and Squad_GetHoldEntity and Squad_IsInHoldEntity(tsq) and Squad_GetHoldEntity(tsq)
			if hold then
				local eg = EGroup_CreateIfNotFound("eliteai_mech_hold")
				EGroup_Clear(eg); EGroup_Add(eg, hold)
				Cmd_AttackEGroup(sg, eg)                                      -- command.scar:709
				EliteAI_MechHoldAtt = (EliteAI_MechHoldAtt or 0) + 1
				if EliteAI_MechHoldAtt <= 3 then _log("MECH attack building of squad", x, "x" .. EliteAI_MechHoldAtt) end
			else
				local tg = SGroup_CreateIfNotFound("eliteai_mech_target")
				SGroup_Clear(tg); SGroup_Add(tg, tsq)
				Cmd_AttackSGroup(sg, tg)                                      -- command.scar:685
			end
		else
			local abid = mech_ability(m - 200)
			if abid then Cmd_Ability(sg, abid, tsq, false) end              -- command.scar:1863 (squad target -> Cmd_SquadAbilitySquad)
		end
	elseif m == 5 then
		local pos = World_Pos(tonumber(x), tonumber(y), tonumber(z))
		local eg = mech_point(Squad_GetPlayerOwner(sq), pos)
		if eg then
			Command_SquadEntity(Squad_GetPlayerOwner(sq), sg, SCMD_Capture, eg, false)   -- as Cmd_MoveThenCapture (command.scar:2353) without its ever-growing _activeAttackerTable
		else
			EliteAI_MechNoPoint = (EliteAI_MechNoPoint or 0) + 1
			if EliteAI_MechNoPoint <= 5 then _log("MECH no point at", x, z) end
		end
	elseif m == 7 then
		-- mechanics.ai 0.7 (Defence): attack the enemy building nearest to the position (a turret) - found as mech_point finds a
		-- strategic point, attacked as the building of a garrison above (Cmd_AttackEGroup, command.scar:709)
		local pos = World_Pos(tonumber(x), tonumber(y), tonumber(z))
		local eg = EGroup_CreateIfNotFound("eliteai_mech_def")
		EGroup_Clear(eg)
		World_GetEntitiesNearPoint(Squad_GetPlayerOwner(sq), eg, pos, 10, OT_Enemy)
		local best, bd
		for i = 1, EGroup_CountSpawned(eg) do
			local e = EGroup_GetSpawnedEntityAt(eg, i)
			if e and (Entity_IsBuilding == nil or Entity_IsBuilding(e)) and not (Entity_IsStrategicPoint and Entity_IsStrategicPoint(e)) then
				local p = Entity_GetPosition(e)
				local d = (p.x - pos.x) * (p.x - pos.x) + (p.z - pos.z) * (p.z - pos.z)
				if not best or d < bd then best, bd = e, d end
			end
		end
		if best then
			EGroup_Clear(eg); EGroup_Add(eg, best)
			Cmd_AttackEGroup(sg, eg)
			EliteAI_MechDefAtt = (EliteAI_MechDefAtt or 0) + 1
			if EliteAI_MechDefAtt <= 3 then _log("MECH attack building at", x, z, "x" .. EliteAI_MechDefAtt) end
		else
			EliteAI_MechNoBld = (EliteAI_MechNoBld or 0) + 1
			if EliteAI_MechNoBld <= 5 then _log("MECH no enemy building at", x, z) end
		end
	elseif m == 6 then
		-- main.ai 0.13: one reinforcement for a squad of the director's army that stands at home (Elite's squad tasks, which ask
		-- the engine for reinforcements, do not run for it). The command of the player's reinforce button: the engine checks
		-- the reach of a reinforce point and the money. Both names are checked - without them nothing is called.
		-- main.ai 0.14: x = how many models (1..4; 0 from an older main.ai = 1) - the command once per model, as a player clicks the
		-- button several times (each click takes its money and queues one model)
		if Command_Squad and SCMD_ReinforceUnit then
			local k = math.floor(tonumber(x) or 1)
			if k < 1 then k = 1 elseif k > 4 then k = 4 end
			local owner = Squad_GetPlayerOwner(sq)
			for i = 1, k do Command_Squad(owner, sg, SCMD_ReinforceUnit, false) end
			EliteAI_ReinfN = (EliteAI_ReinfN or 0) + k
			EliteAI_ReinfLines = (EliteAI_ReinfLines or 0) + 1
			if EliteAI_ReinfLines <= 6 then _log("REINF dir scar order", EliteAI_ReinfN, "x" .. k, "models", Squad_Count(sq)) end
		elseif not EliteAI_ReinfWarned then
			EliteAI_ReinfWarned = true
			_log("REINF dir scar: no Command_Squad / SCMD_ReinforceUnit here", type(Command_Squad), type(SCMD_ReinforceUnit))
		end
	elseif m >= 100 then
		local abid = mech_ability(m - 100)
		if abid then Cmd_SquadAbilityPos(sg, abid, World_Pos(tonumber(x), tonumber(y), tonumber(z)), false) end   -- command.scar:1930, autarch.scar:38
	end
end

--------------------------------------------------------------------------------------------------------------------------
-- 0.8 DODGE (reports/newai_1110/TECH_RU.md 16.1; the tester Orca: "it never steps out of a grenade"). A grenade in flight, a
-- charge on its fuse are entities this side sees (World_GetEntitiesNearPoint, owner type OT_Neutral - the polygon's probe,
-- TECH_RU.md 15.15: "POLY PROBE ent ... ebps\projectiles\race_imperial_guard\ig_grenade_launcher_shot"); the AI's own state
-- has no function for them. The reflex therefore lives here (the director's tick of 3 s is too slow for it), the AI gives
-- the policy and is told what happened:
--   AI -> here : pseudo-order mode 10 (id = player id, x = 1 on / 0 off, y = the strongest threat a CAPTURING squad sits
--                through, z = ... a squad in MELEE sits through; 1 weak, 2 medium, 3 heavy, 0 = it always steps out) -
--                mechanics.ai sends it at the start and every 30 s. Without it nothing below runs (no new AI = no cost).
--   here -> AI : AI_DoString (the game's own way from SCAR into a player's AI state, designerlib.scar:137) calls
--                string.eliteai_in[<player id>] of mechanics.ai with numbers: 1 = "squad <id> steps out of a blast at x, z"
--                (the order book starts that squad's series anew), 2 = "a mine / a charge is seen at x, z" (the zone is
--                closed for the goals). Looked up, never assumed; Mech_DodgeTell=0 = not called. The reflex does not need it.
-- Four times a second, for the squads of the players that sent mode 10: the entities near them (one query per cluster of
-- squads; an entity that is not in the table below is looked at once per match - its id is remembered) -> a projectile of
-- EliteAI_DODGE gets a track (id, two positions = its course; nothing else is kept between ticks). A squad is threatened
--   * by one in flight: it stands within the blast radius + DodgePad of the course AND of the spot the projectile will
--     come down on - reckoned from its last three positions (the arc: height, climb, how fast the climb falls off), with
--     15 % of the way still to fly (4 m at most) allowed for the error; a flight that shows no arc (flat, or seen only
--     twice) threatens whoever stands ahead of it within the radius of its course, DodgeHorizon seconds of flight far;
--   * by one that lies (its fuse burns): it stands within the radius + DodgePad of it.
-- It reacts after a human's delay - 0.5 / 0.75 / 1.0 s by (squad id x 7 + the tick the projectile was first seen) mod 3, the
-- same in every run - with a plain move just out of the radius: at a right angle to the course (flight) or straight away
-- from the spot (fuse), radius + pad + 1 m from it and no farther. It stays put when the step costs more than the blast:
-- a vehicle, a squad in a building, one that retreats, a suppressed one (it crawls), a set-up team against a weak one, a
-- capturing / melee squad against what the AI's policy lets it sit through. When the blast is over the squad gets back
-- what it was doing: the capture (it was capturing), the order the AI gave meanwhile, the AI's last order if that was
-- recent, else an attack-move to where it stood. While it steps the AI's marching orders for it wait here (a retreat
-- passes and ends the dodge). Mines and placed charges (EliteAI_DODGE_MINES) count only when the player SEES them
-- (Player_CanSeeEntity; without that function they are never looked at): a squad on one steps off and does not go back.
-- No protected call round an engine call; every function is looked up once ("MECH Dodge api ..."); squads and entities are used in
-- the tick they were read in, only ids and numbers stay.
--
-- The data: key = the blueprint name as the engine gives it, lower case, "/" for "\", without the leading "ebps/".
-- r = blast radius (m), fuse = seconds it lies before it bursts (projectile_ext delay_detonate_time; 0 = on landing),
-- pow = 1 weak (< 60 damage, no disable), 2 medium (60 - 199, or it stuns / burns / lifts), 3 heavy (>= 200),
-- salvo = more of them follow to the same place (the squad moves even when the first one has burst).
-- Source: Elite's attributes unpacked on this server (gamedata/attrib = Elite's overrides, gamedata/orig_attrib = the game):
-- (E) the blueprint is Elite's own, (v) the game's blueprint fired by a weapon of Elite's PvP tree. The radius is the
-- largest radius of the weapon's area_effect (the field names of that parser are approximate - checked against the known
-- 4 m of a frag grenade). SEEN IN THE GAME so far: ig_grenade_launcher_shot only (scene h_ig_setup); every other name is
-- from the files - the line "MECH Dodge see <key>" confirms one, "MECH Dodge unknown projectile <key>" names what the
-- table lacks. NOT here on purpose: the shots of ordinary weapons (grenade launchers, mortars, plasma cannons, missiles -
-- a squad would dance instead of fighting), homing bombs (melta / haywire: thrown at a vehicle), smoke.
EliteAI_DODGE = {
	-- hand grenades with a fuse (the game shows the player a warning circle for these)
	["projectiles/race_marine/sm_frag_grenade_pvp"]                 = { r = 4, fuse = 1.25, pow = 3 },   -- (v) sm_frag_grenade 260: scouts, tacticals, storm troopers
	["projectiles/race_marine/sm_frag_grenade_landraider_pvp"]      = { r = 4, fuse = 1.25, pow = 3 },   -- (v) 260; the weapon is the game's (not checked in 3.2.1)
	["projectiles/race_marine/sm_hellfire_grenade_1_5_delay"]       = { r = 4, fuse = 1.25, pow = 2 },   -- (E) gk_operative_fire_grenade 50 + fire
	["projectiles/race_marine/sm_toxin_grenade_pvp"]                = { r = 4, fuse = 1.25, pow = 1 },   -- (v) sm_toxin_grenade_apothecary 45
	["projectiles/race_eldar/eld_plasma_grenade_pvp"]               = { r = 4, fuse = 1.25, pow = 3 },   -- (v) eld_plasma_grenade 260: guardians, dire avengers
	["projectiles/race_eldar/eld_anti_grav_grenade"]                = { r = 4, fuse = 1.2,  pow = 2 },   -- (E) lifts what it hits
	["projectiles/race_chaos/csm_blight_grenade"]                   = { r = 4, fuse = 1.25, pow = 2 },   -- (E) 65 + the cloud
	["pvp/race_chaos/projectiles/csm_blight_grenade"]               = { r = 4, fuse = 1.25, pow = 2 },   -- (E) the same under the other path
	["projectiles/race_imperial_guard/ig_frag_grenade_kasrkin"]     = { r = 4, fuse = 1.0,  pow = 3 },   -- (E) ig_kasrkin_frag_grenade 260
	["projectiles/race_grey_knights/gk_operative_stun_grenade"]     = { r = 4, fuse = 1.0,  pow = 2 },   -- (E) stuns
	["projectiles/race_grey_knights/gk_frag_grenade"]               = { r = 4, fuse = 0,    pow = 1 },   -- (E) gk_stormtrooper_frag_grenade 50, bursts on landing
	["projectiles/race_ork/ork_stikkbomb_pvp"]                      = { r = 4, fuse = 1.0,  pow = 2 },   -- (v) ork_stikkbomb 40 a bomb, a mob throws several
	["projectiles/race_ork/ork_stikkbomb_hero_pvp"]                 = { r = 4, fuse = 1.0,  pow = 1 },   -- (v) ork_stikkbomb_hero 58
	["projectiles/race_ork/ork_stun_grenade_hero_pvp"]              = { r = 4, fuse = 1.0,  pow = 2 },   -- (v) stuns
	["projectiles/race_ork/ork_stun_grenade_pvp"]                   = { r = 4, fuse = 0,    pow = 2 },   -- (E) stuns, bursts on landing
	["projectiles/race_ork/ork_burna_bomb"]                         = { r = 6, fuse = 0,    pow = 2, linger = 4 },   -- (v) flies 9 m/s, burns where it fell
	["pvp/race_tau/projectiles/tau_photon_grenade_underslung"]      = { r = 4, fuse = 0,    pow = 2 },   -- (E) tau_photon_grenade: blinds
	["projectiles/race_tyranid/ty_electroshock_grub"]               = { r = 6, fuse = 3.0,  pow = 2 },   -- (E) tyr_electroshock_grub 160
	-- charges
	["projectiles/race_imperial_guard/ig_satchel_charge_pvp"]       = { r = 5, fuse = 3.0,  pow = 3 },   -- (v) ig_devils_satchel 390 (the game's weapon; the area in the file is 4 m, 1 m added)
	["projectiles/race_grey_knights/gk_satchel_charge"]             = { r = 5, fuse = 3.75, pow = 3 },   -- (E) gk_operative_satchel_charge 450
	-- salvos of abilities and the artillery of vehicles
	["projectiles/race_imperial_guard/ig_grenade_launcher_shot"]    = { r = 4, fuse = 0,    pow = 1, salvo = true, quick = true },   -- (E) ig_grenade_shot 40 x 3 (the devils' triple launch), 45-55 m/s: SEEN (h_ig_setup);
	                                                                                                             -- 0.9 quick: the three land within a quarter of a second (r9 scene i: "see n 1", "n 2" in one tick, "n 3" in the next) - when the first lies the salvo is over
	["projectiles/race_chaos/csm_frag_grenade_launcher_barrage"]    = { r = 4, fuse = 0,    pow = 1, salvo = true },   -- (E) the grenade barrages (heretics, the IG commander, the sniper squad) 25 a shot, 10-15 m/s
	["projectiles/race_grey_knights/gk_frag_grenade_launcher_barrage"] = { r = 4, fuse = 0, pow = 1, salvo = true },   -- (E) gk_grenade_launcher_barrage
	["pvp/race_imperial_guard/projectiles/ig_manticore_rocket"]     = { r = 6, fuse = 0,    pow = 3, salvo = true },   -- (v) ig_manticore_rockets 170 a rocket, 30 m/s
	["projectiles/race_tyranid/ty_bio_plasma_orb"]                  = { r = 6, fuse = 0,    pow = 2 },   -- (E) tyr_bioplasma_carnifex 150
}
-- mines and placed charges: looked at only when the player sees them. The names are the files' (ebps/projectiles/...: no
-- projectile_ext in them); whether the entity carries the name, and the radii, are NOT checked in the game.
EliteAI_DODGE_MINES = {
	["projectiles/race_marine/sm_prox_mine_pvp"]              = { r = 5, pow = 3 },   -- (E)
	["projectiles/race_grey_knights/gk_prox_mine"]            = { r = 5, pow = 3 },   -- (E)
	["projectiles/race_grey_knights/gk_operatives_snare_mine"] = { r = 5, pow = 2 },  -- (E)
	["projectiles/race_tau/tau_mine_pvp"]                     = { r = 5, pow = 2 },   -- (E) tau_snare_mine_xv8
	["projectiles/race_tau/tau_quill_mine"]                   = { r = 5, pow = 2 },   -- (E) tau_kroot_quill_trap
	["projectiles/race_tau/tau_snare_trap"]                   = { r = 5, pow = 2 },   -- (E)
	["projectiles/race_ork/ork_mekboy_mine_pvp"]              = { r = 5, pow = 3 },   -- (v)
	["projectiles/race_tyranid/tyr_burrow_trap"]              = { r = 5, pow = 2 },   -- (E)
	["projectiles/race_imperial_guard/ig_devils_remote_detonate"] = { r = 6, pow = 3 },   -- (E) the devils' remote bomb
	["projectiles/race_ork/ork_remote_detonate"]              = { r = 6, pow = 3 },   -- (E)
}
-- 0.9 (TECH_RU.md 17.2): what "MECH Dodge unknown projectile" named in s20 and the scenes of r9, looked up in the attributes -
-- known and NOT stepped out of (no "unknown" line for these any more):
EliteAI_DODGE_IGNORE = {
	["projectiles/race_tyranid/tyr_spore_mine"]                     = true,   -- (v) the shot of tyr_spore_mine_launcher (40, 3-38 m, 10-20 m/s, delay 0.1): an ordinary weapon's shot
	["projectiles/race_tyranid/tyr_barbed_strangler"]               = true,   -- (v) the shot of the barbed strangler (warrior 35 r 6, carnifex 125 r 7; every 2 s + reload): an ordinary weapon's shot - a squad would dance
	["projectiles/race_ork/ork_missile"]                            = true,   -- (v) the rokkit of ork_rokkit_launcha and the kommandos' rokkits (12.8-100, r 2-5, up to 45 m/s): an ordinary weapon's shot
	["projectiles/race_imperial_guard/ig_stormtrooper_spawn_effect"] = true,  -- (v) no weapon fires it: the picture of the storm troopers' drop (ebps/pvp/.../buildings/ig_stormtrooper_spawn_effect) - no grenade
}
-- (the code below sits in one block: its helpers are not locals of the whole script - this file is appended to Elite's
-- elite.scar, and a chunk has room for 200 locals)
do
-- set-up teams (the list of mechanics.ai, SETUP_SBPS): they do not pack up for a weak one
local DODGE_SETUP = { "sm_devastator", "csm_havoc", "eld_guardian_shuriken_cannon", "eld_guardian_brightlance", "eld_guardian_d_cannon",
	"ig_heavy_weapon_squad", "ork_lootas", "gk_heavy_weapon_squad", "tau_heavy_weapon_drones" }
local _cfg = eliteai_cfg or (string and string.eliteai_cfg)
local function dnum(key, def)
	local v = _cfg and tonumber(_cfg("Mech_" .. key))
	if v == nil then return def end
	return v
end
EliteAI_Dodge = { players = {}, pids = {}, any = false, skip = {}, proj = {}, mine = {}, sq = {}, last = {}, kind = {}, nm = {}, unknown = {}, n_unknown = 0, tick = 0,
	st = { seen = 0, threat = 0, dodge = 0, late = 0, stay_cap = 0, stay_melee = 0, stay_other = 0, back = 0, held = 0, mines = 0, told = 0 } }
-- the AI's policy (pseudo-order mode 10)
function EliteAI_DodgeCfg(pid, on, hold_cap, hold_melee)
	local D = EliteAI_Dodge
	local c = D.players[pid]
	if c == nil then
		c = {}; D.players[pid] = c
		table.insert(D.pids, pid); table.sort(D.pids)
	end
	local v = ((on or 0) >= 1)
	local hc, hm = math.floor((hold_cap or 1) + 0.5), math.floor((hold_melee or 1) + 0.5)
	if c.on ~= v or c.cap ~= hc or c.melee ~= hm then
		_log("p" .. tostring(pid), "MECH", "Dodge", v and "on" or "off", "a capturing squad sits through", hc, "a melee squad through", hm, "(1 weak 2 medium 3 heavy)")
	end
	c.on, c.cap, c.melee = v, hc, hm
	D.any = false
	for _, id in ipairs(D.pids) do if D.players[id].on then D.any = true end end
end
-- every engine function the reflex calls, looked up once
local function dodge_api()
	local D = EliteAI_Dodge
	local need = { World_GetEntitiesNearPoint = World_GetEntitiesNearPoint, EGroup_CreateIfNotFound = EGroup_CreateIfNotFound, EGroup_Clear = EGroup_Clear,
		EGroup_CountSpawned = EGroup_CountSpawned, EGroup_GetSpawnedEntityAt = EGroup_GetSpawnedEntityAt, Entity_GetBlueprintName = Entity_GetBlueprintName,
		Entity_GetPosition = Entity_GetPosition, Entity_GetGameID = Entity_GetGameID, Player_FromId = Player_FromId, Player_GetSquads = Player_GetSquads,
		SGroup_CountSpawned = SGroup_CountSpawned, SGroup_GetSpawnedSquadAt = SGroup_GetSpawnedSquadAt, Squad_Count = Squad_Count, Squad_GetGameID = Squad_GetGameID,
		Squad_GetPosition = Squad_GetPosition, World_GetGameTime = World_GetGameTime, World_Pos = World_Pos, Cmd_MoveToPos = Cmd_MoveToPos,
		Cmd_AttackMovePos = Cmd_AttackMovePos, SGroup_CreateIfNotFound = SGroup_CreateIfNotFound, SGroup_Clear = SGroup_Clear, SGroup_Add = SGroup_Add }
	local missing = ""
	for _, k in ipairs({ "World_GetEntitiesNearPoint", "EGroup_CreateIfNotFound", "EGroup_Clear", "EGroup_CountSpawned", "EGroup_GetSpawnedEntityAt", "Entity_GetBlueprintName",
		"Entity_GetPosition", "Entity_GetGameID", "Player_FromId", "Player_GetSquads", "SGroup_CountSpawned", "SGroup_GetSpawnedSquadAt", "Squad_Count", "Squad_GetGameID",
		"Squad_GetPosition", "World_GetGameTime", "World_Pos", "Cmd_MoveToPos", "Cmd_AttackMovePos", "SGroup_CreateIfNotFound", "SGroup_Clear", "SGroup_Add" }) do
		if type(need[k]) ~= "function" then missing = missing .. " " .. k end
	end
	if OT_Neutral == nil then missing = missing .. " OT_Neutral" end
	D.api = (missing == "")
	D.state = (type(Squad_HasActiveCommand) == "function" and type(Squad_GetActiveCommand) == "function")
	D.sup = (type(Squad_IsSuppressed) == "function")
	D.hold = (type(Squad_IsInHoldEntity) == "function")
	D.name = (type(Squad_GetBlueprintName) == "function")
	D.see = (type(Player_CanSeeEntity) == "function") and OT_Enemy ~= nil and dnum("DodgeMines", 1) >= 1
	D.tell = (type(AI_DoString) == "function") and dnum("DodgeTell", 0) >= 1
	D.pad, D.scan, D.cluster = dnum("DodgePad", 3), dnum("DodgeScanR", 30), dnum("DodgeCluster", 25)
	D.horizon, D.fly, D.ahead = dnum("DodgeHorizon", 2.5), dnum("DodgeFly", 2), dnum("DodgeAhead", 60)
	D.dmin, D.dstep, D.speed, D.minr = dnum("DodgeDelay", 0.5), dnum("DodgeDelayStep", 0.25), dnum("DodgeWalk", 4), dnum("DodgeMinRange", 8)
	D.arc = (dnum("DodgeArc", 1) >= 1)                                       -- 0 = the landing spot is not reckoned: the course only
	D.spent = (dnum("DodgeLate", 1) >= 1)                                    -- 0.9: 0 = a shell without a fuse that is seen lying is stepped out of as in 0.8
	_log("MECH", "Dodge", "api", D.api and "ok" or ("OFF, missing:" .. missing), "state", D.state and 1 or 0, "SQUADSTATEID_Capture", type(SQUADSTATEID_Capture),
		"SQUADSTATEID_Melee", type(SQUADSTATEID_Melee), "Squad_IsSuppressed", type(Squad_IsSuppressed), "Squad_IsInHoldEntity", type(Squad_IsInHoldEntity),
		"Player_CanSeeEntity", type(Player_CanSeeEntity), "mines", D.see and 1 or 0, "AI_DoString", type(AI_DoString), "tell", D.tell and 1 or 0,
		"pad", D.pad, "scan", D.scan, "delay", D.dmin, "+", D.dstep, "x 0..2", "late", D.spent and 1 or 0)
end
local function dodge_key(nm)
	if type(nm) ~= "string" then return nil end
	local k = string.lower(nm)
	if not string.find(k, "projectiles", 1, true) then return nil end      -- (every name of both tables has it: the rest costs no more)
	k = string.gsub(k, "\\", "/")
	if string.sub(k, 1, 5) == "ebps/" then k = string.sub(k, 6) end
	return k
end
-- "veh" / "setup" / "inf" by the squad's blueprint name, once per squad id
local function dodge_kind(D, s)
	local k = D.kind[s.id]
	if k == nil then
		k = "inf"
		if D.name then
			local nm = Squad_GetBlueprintName(s.sq)
			if type(nm) == "string" then
				nm = string.lower(nm)
				-- 1.0 (Orca fb 529, his log: "Dodge 50004 ...ig_sentinel stays: vehicle - ...sm_frag_grenade_pvp pow 3"): the sentinel
				-- lies in the vehicles folder and has the armour of heavy infantry (kb.yaml units ig_sentinel) - a grenade hurts it,
				-- it steps out like infantry
				if string.find(nm, "vehicles", 1, true) and not string.find(nm, "ig_sentinel", 1, true) then k = "veh"
				else for _, f in ipairs(DODGE_SETUP) do if string.find(nm, f, 1, true) then k = "setup"; break end end end
				D.nm[s.id] = nm
			end
		end
		D.kind[s.id] = k
	end
	s.name = D.nm[s.id]
	return k
end
-- the AI is told (numbers only; the chunk cannot raise: every step of it is guarded)
local function dodge_tell(D, s, kind, id, x, z, r, pow, dur)
	if not D.tell then return end
	AI_DoString(s.pl, string.format("local s = string local t = s and s.eliteai_in local f = t and t[%d] if f then f(%d, %d, %.1f, %.1f, %.1f, %d, %.2f) end",
		s.pid, kind, id, x, z, r, pow, dur))
	D.st.told = D.st.told + 1
end
-- is the squad doing something it should not leave for a blast of this power? Returns why it stays, or nil
local function dodge_stays(D, s, def)
	local kind = dodge_kind(D, s)
	if kind == "veh" then return "vehicle", "other" end
	if D.hold and Squad_IsInHoldEntity(s.sq) then return "in a building", "other" end
	local st = nil
	if D.state and Squad_HasActiveCommand(s.sq) then st = Squad_GetActiveCommand(s.sq) end
	s.st = st
	if st ~= nil and SQUADSTATEID_Retreat ~= nil and st == SQUADSTATEID_Retreat then return "retreats", "other" end
	if D.sup and Squad_IsSuppressed(s.sq) then return "suppressed", "other" end
	if kind == "setup" and def.pow <= 1 then return "a set-up team, a weak one", "other" end
	if st ~= nil and SQUADSTATEID_Capture ~= nil and st == SQUADSTATEID_Capture and def.pow <= s.c.cap then return "captures", "cap" end
	if st ~= nil and SQUADSTATEID_Melee ~= nil and st == SQUADSTATEID_Melee and def.pow <= s.c.melee then return "in melee", "melee" end
	return nil
end
-- the threat of one track for one squad: nil, or the spot to leave { cx, cz }, the time until it bursts, flying or not
local function dodge_threat(D, pr, s, now)
	local R = pr.def.r + D.pad
	if pr.mine then
		local dx, dz = s.x - pr.x, s.z - pr.z
		if dx * dx + dz * dz <= R * R then return pr.x, pr.z, 0, false end
		return nil
	end
	if pr.n < 2 then return nil end                                         -- seen once: no course yet
	if pr.sp > D.fly then
		if pr.n < 3 then return nil end                                      -- seen twice: a course, no arc yet - one more look
		local ux, uz = pr.vx / pr.sp, pr.vz / pr.sp
		local ax, az = s.x - pr.x, s.z - pr.z
		local along = ax * ux + az * uz
		local perp = ax * uz - az * ux
		if perp < 0 then perp = -perp end
		local ahead = pr.sp * D.horizon
		if ahead > D.ahead then ahead = D.ahead end
		if along < -1 or along > ahead + R or perp > R then return nil end
		-- where it comes down: height h above the squad's ground, climbing v now, the climb changing by a (< 0: an arc)
		local a, h = pr.ay, (pr.y or 0) - (s.y or 0)
		if D.arc and a ~= nil and a < -1 and h > 0.3 then
			local v = pr.vy + 0.5 * a * pr.dt
			local t = (-v - math.sqrt(v * v - 2 * a * h)) / a                -- (a < 0, h > 0: the root is real and positive)
			if t < 10 then
				local way = pr.sp * t
				local err = 0.15 * way
				if err > 4 then err = 4 end
				local lx, lz = pr.x + ux * way - s.x, pr.z + uz * way - s.z
				if lx * lx + lz * lz > (R + err) * (R + err) then return nil end   -- it comes down somewhere else
				if along < 0 then along = 0 end
				return pr.x + ux * along, pr.z + uz * along, t + (pr.def.fuse or 0), true, ux, uz
			end
		end
		-- not the thrower's side: a squad within DodgeMinRange of where the projectile was first seen is not what it is thrown at
		-- (our own grenadiers, a squad in melee with the thrower)
		if pr.x0 ~= nil and (s.x - pr.x0) * (s.x - pr.x0) + (s.z - pr.z0) * (s.z - pr.z0) < D.minr * D.minr then return nil end
		if along < 0 then along = 0 end
		return pr.x + ux * along, pr.z + uz * along, along / pr.sp + (pr.def.fuse or 0), true, ux, uz
	end
	local dx, dz = s.x - pr.x, s.z - pr.z
	if dx * dx + dz * dz > R * R then return nil end
	local left = (pr.def.fuse or 0) - (now - (pr.land or now))
	if left < 0 then left = 0 end
	return pr.x, pr.z, left, false
end
-- 0.9 (TECH_RU.md 16.10 / 17.2; scene i of r9: three steps out of the devils' salvo, every one "on its fuse bursts in 0.0 s" -
-- the squad saw the shell lying, i.e. AFTER it had burst, and stepped for nothing). A projectile without a fuse bursts when it
-- lands: one that is seen lying has burst already - no step ("too late"), unless something is still to come there: it burns
-- where it fell (linger), or it is one of a salvo that goes on for seconds (salvo without quick: the manticore's rockets, the
-- grenade barrages). Mech_DodgeLate=0 = as 0.8.
local function dodge_spent(D, pr)
	if not D.spent or pr.mine or pr.n < 2 or pr.sp > D.fly then return false end
	local def = pr.def
	if (def.fuse or 0) > 0 or def.linger then return false end
	if def.salvo and not def.quick then return false end
	return true
end
local function dodge_sg(sq)
	local sg = SGroup_CreateIfNotFound("eliteai_dodge_sg")
	SGroup_Clear(sg); SGroup_Add(sg, sq)
	return sg
end
-- the step: just out of the radius. s = this tick's squad entry, e = its dodge record
local function dodge_step(D, s, e, pr, now)
	local cx, cz, eta, flying, ux, uz = dodge_threat(D, pr, s, now)
	if cx == nil then return false end                                       -- it is out already (it walked on, or the course changed)
	-- 0.9: a shell without a fuse that comes down before the next look (a quarter of a second) cannot be stepped out of
	if D.spent and flying and eta < 0.3 and (pr.def.fuse or 0) <= 0 and not pr.def.linger and not (pr.def.salvo and not pr.def.quick) then return false, "late" end
	if dodge_stays(D, s, pr.def) ~= nil then return false end                -- (what it does now: it began to retreat, to capture ...)
	local R = pr.def.r + D.pad + 1
	local dx, dz = s.x - cx, s.z - cz
	local d = math.sqrt(dx * dx + dz * dz)
	if flying then                                                          -- at a right angle to the course, on the squad's side of it
		local side = dx * uz - dz * ux
		if side > 0.5 or side < -0.5 then side = (side > 0) and 1 or -1
		else local n = math.floor(s.id + 0.5); side = (n - math.floor(n / 2) * 2 == 0) and 1 or -1 end
		dx, dz = uz * side, -ux * side
		local off = (s.x - cx) * dx + (s.z - cz) * dz
		d = (off > 0) and off or 0
	elseif d < 0.5 then                                                     -- on the spot itself: towards the player's base
		local b = (type(Player_GetStartingPosition) == "function") and Player_GetStartingPosition(s.pl) or nil
		if b ~= nil and b.x ~= nil then dx, dz = b.x - cx, b.z - cz else dx, dz = 1, 0 end
		local l = math.sqrt(dx * dx + dz * dz)
		if l < 0.5 then dx, dz, l = 1, 0, 1 end
		dx, dz, d = dx / l, dz / l, 0
	else dx, dz = dx / d, dz / d end
	local step = R - d
	if step < 1 then return false end
	local tx, tz = s.x + dx * step, s.z + dz * step
	Cmd_MoveToPos(dodge_sg(s.sq), World_Pos(tx, s.y, tz))
	local dur = eta + 0.75 + (pr.def.linger or 0) + (pr.def.salvo and 1.5 or 0)
	local walk = step / D.speed + 0.5
	if dur < walk then dur = walk end
	if dur > 8 then dur = 8 end
	e.t_until, e.ox, e.oy, e.oz, e.was, e.mine = now + dur, s.x, s.y, s.z, s.st, pr.mine
	D.st.dodge = D.st.dodge + 1
	_log("p" .. tostring(s.pid), "MECH", "Dodge", s.id, s.name or "-", "steps", string.format("%.1f m", step), "out of", pr.key, "pow", pr.def.pow,
		flying and "in flight" or (pr.mine and "a mine" or "on its fuse"), string.format("bursts in %.1f s delay %.2f back in %.1f", eta, e.delay or 0, dur), "state", tostring(s.st))
	dodge_tell(D, s, 1, s.id, cx, cz, pr.def.r, pr.def.pow, dur)
	return true
end
-- the blast is over: back to what it was doing
local function dodge_back(D, s, e, now)
	local h, l = e.held, D.last[s.id]
	local what = "-"
	if e.was ~= nil and SQUADSTATEID_Capture ~= nil and e.was == SQUADSTATEID_Capture and not e.mine then
		mech_order(dodge_sg(s.sq), s.sq, 5, e.ox, e.oy, e.oz); what = "capture"
	elseif h ~= nil then
		local sg = dodge_sg(s.sq)
		if h.m == 1 then Cmd_MoveToPos(sg, World_Pos(h.x, h.y, h.z))
		elseif h.m == 2 then Cmd_AttackMovePos(sg, World_Pos(h.x, h.y, h.z))
		else mech_order(sg, s.sq, h.m, h.x, h.y, h.z) end
		what = "the order held " .. tostring(h.m)
	elseif e.mine then what = "stays off the mine"
	elseif l ~= nil and now - l.t <= 12 and (l.m == 1 or l.m == 2) then
		local sg = dodge_sg(s.sq)
		if l.m == 1 then Cmd_MoveToPos(sg, World_Pos(l.x, l.y, l.z)) else Cmd_AttackMovePos(sg, World_Pos(l.x, l.y, l.z)) end
		what = "the last order " .. tostring(l.m)
	else
		Cmd_AttackMovePos(dodge_sg(s.sq), World_Pos(e.ox, e.oy, e.oz)); what = "where it stood"
	end
	D.st.back = D.st.back + 1
	if D.st.back <= 20 then _log("p" .. tostring(s.pid), "MECH", "Dodge", s.id, "back:", what) end
end
-- one cluster's entities of one owner type into the tracks
local function dodge_scan(D, c, eg, ot, now, seen, mines)
	EGroup_Clear(eg)
	World_GetEntitiesNearPoint(c.pl, eg, World_Pos(c.x, c.y, c.z), D.cluster + D.scan, ot)
	local n = EGroup_CountSpawned(eg)
	for i = 1, n do
		local ent = EGroup_GetSpawnedEntityAt(eg, i)
		if ent ~= nil then
			local id = Entity_GetGameID(ent)
			if id ~= nil and not D.skip[id] and not seen[id] then
				local pr = D.proj[id] or D.mine[id]
				if pr == nil then
					local key = dodge_key(Entity_GetBlueprintName(ent))
					local def = key and EliteAI_DODGE[key]
					local mdef = key and EliteAI_DODGE_MINES[key]
					if def ~= nil and not mines then
						pr = { key = key, def = def, t0 = now, n = 0, sp = 0, done = {} }
						D.proj[id] = pr
						D.st.seen = D.st.seen + 1
						if D.st.seen <= 30 or D.st.seen - math.floor(D.st.seen / 25) * 25 == 0 then _log("MECH", "Dodge", "see", key, "r", def.r, "fuse", def.fuse or 0, "pow", def.pow, "n", D.st.seen) end
					elseif mdef ~= nil then
						if D.see then pr = { key = key, def = mdef, t0 = now, n = 0, sp = 0, done = {}, mine = true, vis = false }; D.mine[id] = pr
						else D.skip[id] = true end
					else
						D.skip[id] = true                                             -- never looked up again
						if key ~= nil and not mines and def == nil and not EliteAI_DODGE_IGNORE[key] and not D.unknown[key] and D.n_unknown < 60 then
							D.unknown[key] = true; D.n_unknown = D.n_unknown + 1
							_log("MECH", "Dodge", "unknown projectile", key)
						end
					end
				end
				if pr ~= nil then
					local p = Entity_GetPosition(ent)
					if p ~= nil and p.x ~= nil then
						seen[id] = true
						if pr.mine then
							pr.x, pr.y, pr.z, pr.t, pr.n = p.x, p.y, p.z, now, pr.n + 1
							local vis = (Player_CanSeeEntity(c.pl, ent) == true)
							if vis and not pr.vis then
								D.st.mines = D.st.mines + 1
								_log("MECH", "Dodge", "mine seen", pr.key, string.format("at %.0f %.0f", p.x, p.z), "n", D.st.mines)
							end
							pr.vis = vis
						else
							if pr.x ~= nil and now > pr.t then
								local dt = now - pr.t
								pr.vx, pr.vz = (p.x - pr.x) / dt, (p.z - pr.z) / dt
								pr.sp = math.sqrt(pr.vx * pr.vx + pr.vz * pr.vz)
								if pr.sp > D.fly then pr.land = nil elseif pr.land == nil then pr.land = now end   -- it lies: the fuse burns from now
								-- the arc: the climb over the last interval and how it changed since the interval before
								local vy = ((p.y or 0) - (pr.y or 0)) / dt
								if pr.vy ~= nil then pr.ay = (vy - pr.vy) / dt else pr.ay = nil end
								pr.vy, pr.dt = vy, dt
							end
							if pr.x0 == nil then pr.x0, pr.z0 = p.x, p.z end
							pr.x, pr.y, pr.z, pr.t, pr.n = p.x, p.y, p.z, now, pr.n + 1
						end
					end
				end
			end
		end
	end
end
-- 1.0 (Counter, mechanics.ai X.squad_bp; TECH_RU.md 18.2): the blueprint NAME of every squad on the map goes to the new AI's
-- players, once per squad - AI_DoString -> string.eliteai_in[<player id>](3, <squad id>, "<name>"). Squad_GetBlueprintName is
-- this state's own function (dodge_kind above calls it on our squads; the polygon prints what it returns); whether the AI
-- state has it too is not known, and its blueprint ids found no class in the game (17.9) - this way does not depend on
-- either. Every 2 s, for the players that sent mode 10 (on or off); only letters, digits, '_' and '/' go into the chunk.
-- Mech_CounterScarNames=0 = nothing is read and nothing is sent.
local function bp_tell(D)
	if D.bp_api == nil then
		D.bp_api = (type(AI_DoString) == "function" and type(Squad_GetBlueprintName) == "function" and type(World_GetPlayerCount) == "function"
			and type(World_GetPlayerAt) == "function" and type(Player_GetSquads) == "function" and type(SGroup_CountSpawned) == "function"
			and type(SGroup_GetSpawnedSquadAt) == "function" and type(Squad_Count) == "function" and type(Squad_GetGameID) == "function"
			and type(Player_FromId) == "function" and type(Player_IsAlive) == "function") and dnum("CounterScarNames", 0) >= 1
		D.bp_told, D.bp_n = {}, 0
		_log("COUNTER", "names", "elite.scar tells the AI the blueprint names of the squads it sees:", D.bp_api and 1 or 0, "Squad_GetBlueprintName", type(Squad_GetBlueprintName),
			"AI_DoString", type(AI_DoString), "World_GetPlayerAt", type(World_GetPlayerAt))
	end
	if not D.bp_api then return end
	local n = World_GetPlayerCount()
	for i = 1, n do
		local pl = World_GetPlayerAt(i)
		local sg = (pl ~= nil) and Player_GetSquads(pl) or nil
		local cnt = (sg ~= nil) and SGroup_CountSpawned(sg) or 0
		for j = 1, cnt do
			local sq = SGroup_GetSpawnedSquadAt(sg, j)
			if sq ~= nil and Squad_Count(sq) > 0 then
				local id = Squad_GetGameID(sq)
				if type(id) == "number" and not D.bp_told[id] then
					D.bp_told[id] = true
					local nm = Squad_GetBlueprintName(sq)
					if type(nm) == "string" then
						nm = string.gsub(string.gsub(string.lower(nm), "\\", "/"), "[^%w_/]", "")
						for _, pid in ipairs(D.pids) do
							local to = Player_FromId(pid)
							if to ~= nil and Player_IsAlive(to) then
								AI_DoString(to, string.format("local s = string local t = s and s.eliteai_in local f = t and t[%d] if f then f(3, %d, \"%s\") end", pid, id, nm))
							end
						end
						D.bp_n = D.bp_n + 1
						if D.bp_n == 1 or D.bp_n == 20 then _log("COUNTER", "names", "told", D.bp_n, "the last:", id, nm) end
					end
				end
			end
		end
	end
end
function EliteAI_DodgeTick()
	local D = EliteAI_Dodge
	D.bp_tick = (D.bp_tick or 0) + 1
	if table.getn(D.pids) > 0 and D.bp_tick - math.floor(D.bp_tick / 8) * 8 == 1 then bp_tell(D) end   -- 1.0: every 2 s, whatever the dodge policy
	if not D.any then return end
	if D.api == nil then dodge_api() end
	if not D.api then return end
	local now = World_GetGameTime()
	D.tick = D.tick + 1
	-- the squads of the players that asked for it: read now, used now
	local S, by = {}, {}
	for _, pid in ipairs(D.pids) do
		local c = D.players[pid]
		if c.on then
			local pl = Player_FromId(pid)
			local sg = (pl ~= nil) and Player_GetSquads(pl) or nil
			local cnt = (sg ~= nil) and SGroup_CountSpawned(sg) or 0
			for i = 1, cnt do
				local sq = SGroup_GetSpawnedSquadAt(sg, i)
				if sq ~= nil and Squad_Count(sq) > 0 then
					local p = Squad_GetPosition(sq)
					local id = Squad_GetGameID(sq)
					if p ~= nil and p.x ~= nil and id ~= nil then
						local s = { id = id, x = p.x, y = p.y, z = p.z, sq = sq, c = c, pl = pl, pid = pid }
						table.insert(S, s); by[id] = s
					end
				end
			end
		end
	end
	-- clusters of squads, one entity query each
	local C, cr2 = {}, D.cluster * D.cluster
	for _, s in ipairs(S) do
		local hit = false
		for _, c in ipairs(C) do if (s.x - c.x) * (s.x - c.x) + (s.z - c.z) * (s.z - c.z) <= cr2 then hit = true; break end end
		if not hit then table.insert(C, { x = s.x, y = s.y, z = s.z, pl = s.pl }) end
	end
	local eg = EGroup_CreateIfNotFound("eliteai_dodge")
	local seen = {}
	local slow = D.see and (D.tick - math.floor(D.tick / 4) * 4 == 0)             -- mines: once a second
	for _, c in ipairs(C) do
		dodge_scan(D, c, eg, OT_Neutral, now, seen, false)
		if slow then dodge_scan(D, c, eg, OT_Enemy, now, seen, true) end
	end
	-- tracks that are gone (burst, or out of every cluster's reach)
	local gone = {}
	for id, pr in pairs(D.proj) do if not seen[id] then table.insert(gone, id) end end
	for _, id in ipairs(gone) do D.proj[id] = nil; D.skip[id] = true end
	if slow then
		gone = {}
		for id, pr in pairs(D.mine) do if not seen[id] and now - (pr.t or pr.t0) > 3 then table.insert(gone, id) end end
		for _, id in ipairs(gone) do D.mine[id] = nil end
	end
	-- the squads that step, wait to step, or have stepped
	local ids = {}
	for id in pairs(D.sq) do table.insert(ids, id) end
	table.sort(ids)
	for _, id in ipairs(ids) do
		local e, s = D.sq[id], by[id]
		if s == nil then D.sq[id] = nil                                         -- the squad is gone
		elseif e.t_until ~= nil then
			if now >= e.t_until then dodge_back(D, s, e, now); D.sq[id] = nil end
		elseif now >= e.act then
			local pr = D.proj[e.pr] or D.mine[e.pr]
			if pr == nil and e.salvo and e.cx ~= nil and not (D.spent and e.def.quick) then   -- it has burst, more follow: out of the place it was meant for
				pr = { key = e.key, def = e.def, n = 2, sp = 0, x = e.cx, z = e.cz, land = now, t = now }
			end
			if pr == nil or dodge_spent(D, pr) then                                -- 0.9: gone, or it lies without a fuse = it has burst
				D.st.late = D.st.late + 1
				if D.st.late <= 20 then _log("p" .. tostring(s.pid), "MECH", "Dodge", id, "too late:", e.key, (pr == nil) and "burst before the step" or "lies without a fuse: it has burst", "(delay", e.delay, ")") end
				D.sq[id] = nil
			else
				local ok, why = dodge_step(D, s, e, pr, now)
				if not ok then
					if why == "late" then
						D.st.late = D.st.late + 1
						if D.st.late <= 20 then _log("p" .. tostring(s.pid), "MECH", "Dodge", id, "too late:", e.key, "no fuse, it lands before the step", "(delay", e.delay, ")") end
					end
					D.sq[id] = nil
				end
			end
		end
	end
	-- new threats (the tracks in the order of their ids, the squads in the order they were read: the same in every run)
	local pids = {}
	for id, pr in pairs(D.proj) do table.insert(pids, id) end
	for id, pr in pairs(D.mine) do if pr.vis then table.insert(pids, id) end end
	table.sort(pids)
	for _, pid in ipairs(pids) do
		local pr = D.proj[pid] or D.mine[pid]
		for _, s in ipairs(S) do
			local dn = pr.done[s.id]
			if D.sq[s.id] == nil and (dn == nil or (pr.mine and now - dn > 10)) then
				local cx, cz, _, flying = dodge_threat(D, pr, s, now)
				if cx ~= nil and not flying and dodge_spent(D, pr) then           -- 0.9: seen lying, no fuse: it has burst - nothing to step out of
					pr.done[s.id] = now
					D.st.late = D.st.late + 1
					if D.st.late <= 20 then _log("p" .. tostring(s.pid), "MECH", "Dodge", s.id, "too late:", pr.key, "seen lying without a fuse: it has burst, no step") end
				elseif cx ~= nil then
					pr.done[s.id] = now
					D.st.threat = D.st.threat + 1
					local why, cls = dodge_stays(D, s, pr.def)
					if why ~= nil then
						D.st["stay_" .. cls] = D.st["stay_" .. cls] + 1
						if D.st.threat <= 60 then _log("p" .. tostring(s.pid), "MECH", "Dodge", s.id, s.name or "-", "stays:", why, "-", pr.key, "pow", pr.def.pow) end
					else
						local n = math.floor(s.id + 0.5) * 7 + math.floor(pr.t0 * 4 + 0.5)
						local delay = D.dmin + (n - math.floor(n / 3) * 3) * D.dstep
						-- a human's delay, counted from the first sight of the projectile (at least one tick from now)
						local act = pr.t0 + delay
						if act < now + 0.25 then act = now + 0.25 end
						D.sq[s.id] = { pr = pid, key = pr.key, def = pr.def, salvo = pr.def.salvo, cx = cx, cz = cz, t = now, act = act, delay = delay }
						if pr.mine then dodge_tell(D, s, 2, pid, pr.x, pr.z, pr.def.r, pr.def.pow, 60) end
					end
				end
			end
		end
	end
	if now - (D.said or -1000) >= 60 then
		D.said = now
		local t = D.st
		if t.seen + t.mines > 0 then
			_log("MECH", "Dodge", "stats", "t", math.floor(now), "seen", t.seen, "threats", t.threat, "dodge", t.dodge, "late", t.late, "stay_cap", t.stay_cap, "stay_melee", t.stay_melee,
				"stay_other", t.stay_other, "back", t.back, "held", t.held, "mines", t.mines, "told", t.told, "unknown", D.n_unknown)
		end
	end
end
-- an order of the AI for a squad (EliteAI_ExecuteOrders): true = it waits, the squad is stepping out of a blast
function EliteAI_DodgeOrder(id, x, y, z, m)
	local D = EliteAI_Dodge
	if not D.any or m == nil then return false end
	local march = (m == 1 or m == 2 or m == 4 or m == 5 or m == 7 or m >= 100)
	local e = D.sq[id]
	if m == 3 and e ~= nil then D.sq[id] = nil; return false end              -- a retreat ends the dodge
	if not march then return false end
	if e ~= nil and e.t_until ~= nil then
		e.held = { x = x, y = y, z = z, m = m }
		D.st.held = D.st.held + 1
		return true
	end
	if m == 1 or m == 2 then D.last[id] = { x = x, y = y, z = z, m = m, t = World_GetGameTime() } else D.last[id] = nil end
	return false
end
end -- (the dodge block)

function EliteAI_ExecuteOrders()
	if not _take then return end
	local q = _take()
	if EliteAI_VariantShows > 0 and (EliteAI_VariantTick or 0) <= 0 then variant_show(); EliteAI_VariantTick = 2 end
	EliteAI_VariantTick = (EliteAI_VariantTick or 0) - 1
	if not q or q == "" then return end
	local sg = SGroup_CreateIfNotFound("eliteai_director")
	local done, bad = 0, 0
	for id, x, y, z, mode in string.gmatch(q, "(%d+) (%-?[%d%.]+) (%-?[%d%.]+) (%-?[%d%.]+) (%d+);") do
		local wid = tonumber(id)
		if mode == "9" then variant_note(wid, tonumber(x))
		elseif mode == "10" then EliteAI_DodgeCfg(wid, tonumber(x), tonumber(y), tonumber(z))   -- mechanics.ai 0.8: the dodge policy of player wid
		else
		-- a squad that died since the AI queued the order: Squad_FromWorldID on it is an engine assert (in -dev a modal
		-- dialog that stops the game) - check first
		local alive = Squad_IsValid and Squad_IsValid(wid)
		local ok, err = false, "dead"
		-- 0.8: a squad that is stepping out of a blast - its marching orders wait (EliteAI_DodgeOrder keeps the last one)
		if alive and EliteAI_DodgeOrder(wid, tonumber(x), tonumber(y), tonumber(z), tonumber(mode)) then ok, alive = true, false; done = done - 1 end
		if alive then ok, err = pcall(function()
			local sq = Squad_FromWorldID(wid)
			if not sq or Squad_Count(sq) == 0 then return end              -- nothing to order (all models dead)
			SGroup_Clear(sg)
			SGroup_Add(sg, sq)
			-- step 4 of the vanilla base (VANILLA_BASE_RU.md 13.3): the position is built only for the orders that have one (1, 2).
			-- In 4 and 200+k x is the id of the target squad - World_Pos(50002, 0, 0) wrote "World_Pos has generated a position
			-- outside the world and was clamped" into SCAR-trace ~800 times a match (harmless: the value was never used)
			local m = tonumber(mode)
			if m == 1 then Cmd_MoveToPos(sg, World_Pos(tonumber(x), tonumber(y), tonumber(z)))
			elseif m == 2 then Cmd_AttackMovePos(sg, World_Pos(tonumber(x), tonumber(y), tonumber(z)))
			elseif m == 3 then Cmd_Retreat(sg)
			else mech_order(sg, sq, m, x, y, z)                                 -- 4, 5, 100+k, 200+k: mechanics.ai
			end
		end) end
		if not ok and alive then EliteAI_ErrN = (EliteAI_ErrN or 0) + 1
			if EliteAI_ErrN <= 10 or EliteAI_ErrN - math.floor(EliteAI_ErrN / 50) * 50 == 0 then _log("PCALLERR scar_order", EliteAI_ErrN, "mode", mode, tostring(err)) end end
		if ok then done = done + 1 elseif alive then bad = bad + 1; EliteAI_LastBadMode = mode end
		end
	end
	if bad > 0 and not EliteAI_ExecWarned then EliteAI_ExecWarned = true; _log("director: some orders failed", bad, "of", done + bad, "last mode", tostring(EliteAI_LastBadMode)) end
end

if _take and Rule_AddInterval then Rule_AddInterval(EliteAI_ExecuteOrders, 1) end
-- 0.8: the dodge reflex, four times a second (it returns at once until a new AI has sent its policy - mode 10)
if _take and Rule_AddInterval then Rule_AddInterval(EliteAI_DodgeTick, 0.25) end
