if EliteAI_VANILLA then
-- elite-compat: generated from personality/space_marines/hard.ai (vanilla has no t_tau)
import('personality/base_hard.ai')
import('personality/t_tau/buildorder_lib.ai')

-- randomly choose a build order from the given list defined in the buildorders lib 
s_personality.buildorder = RandomlyChooseBuildorder( tau_buildorder )


else
import('personality/base_hard.ai')
import('personality/t_tau/buildorder_lib.ai')

-- randomly choose a build order from the given list defined in the buildorders lib 
s_personality.buildorder = RandomlyChooseBuildorder( tau_buildorder )
s_personality.prefer_power_percentage = 0.5
end
