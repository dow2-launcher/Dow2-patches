if EliteAI_VANILLA then
import('personality/base_standard.ai')
import('personality/space_marines/buildorder_lib.ai')

-- randomly choose a build order from the given list defined in the buildorders lib 
s_personality.buildorder = RandomlyChooseBuildorder( space_marines_buildorder )

s_personality.securing_structures = 
{
	{pbg = EBP.SM_SECURE, buildstyle = BS_Secure, demand_type = DEMAND_Building, limit = 3},
}

s_personality.resource_structures = 
{
	{pbg = EBP.SM_GENERATOR, demand_type = DEMAND_Building, limit = 4},
}

s_personality.tech_tier_upgrades = 
{
	{pbg = UPG.SM_TIER2,},
}

else

-- create global race modifier
raceFact=0.9

import('personality/base_standard.ai')
import('personality/space_marines/buildorder_lib.ai')

-- randomly choose a build order from the given list defined in the buildorders lib 
s_personality.buildorder = RandomlyChooseBuildorder( space_marines_buildorder )

--kk add a value here we can use in the state_analysis code
GEN_BUILDING = SM_GENERATOR

s_personality.securing_structures = 
{
	{pbg = EBP.SM_SECURE, buildstyle = BS_Secure, demand_type = DEMAND_Building, limit = build_max},
	{pbg = EBP.SM_TURRET, buildstyle = BS_Defend, demand_type = DEMAND_Building, limit = 1},
	{pbg = EBP.SM_REINFORCEPOINT, buildstyle = BS_Defend, demand_type = DEMAND_Building, limit = 0},
}

s_personality.resource_structures = 
{
	{pbg = EBP.SM_GENERATOR, demand_type = DEMAND_Building, limit = build_max + 2},
}

s_personality.tech_tier_upgrades = 
{
	{pbg = UPG.SM_TIER2,},
	{pbg = UPG.SM_TIER3,},
}


