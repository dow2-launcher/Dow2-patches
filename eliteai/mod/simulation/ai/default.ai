-- modes of the DLL order queue (elite.scar): 1-3 = the director's, the rest are ours
local ORD_MOVE, ORD_RETREAT, ORD_ATTACK_SQUAD, ORD_CAPTURE, ORD_ABILITY_POS, ORD_ABILITY_SQUAD = 1, 3, 4, 5, 100, 200
local ORD_AMOVE = 2                                                          -- attack-move (the director's ORD_ATTACK of main.ai)
local ORD_ATTACK_STRUCT = 7                                                  -- 0.7: attack the enemy building nearest to a position (elite.scar)

-- state between ticks: numbers and plain tables only
local M = { names = {}, cls = {}, own = {}, en = nil, en_prev = {}, pts = {}, pts_by_key = {}, hqs = {}, conf = {},
	tie = {}, repair = {}, jumped = {}, runner = {}, bad_pt = {}, last_scan = -1, last_stats = 0, last_contact = nil, said = {},
	cap = {}, idle = {}, norole = {}, gren = {}, gar_ord = {},                -- 0.3: can capture, idle clocks, role bans, grenade / assault order times
	pt_seen = {}, pt_ours = {}, dead_pt = {}, exists = {},                    -- 0.6: the memory of the points, targets a runner was lost at, squads alive
	nocap = {}, capfail = {},                                                 -- 0.3: squads that twice stood idle as runners without ever capturing
	st = { focus = 0, focus_sw = 0, retreat = 0, pre = 0, punish = 0, tie = 0, jump = 0, repair = 0, kite = 0, abil = 0, abil_held = 0, abil_over = 0, abil_callin = 0, abil_notgt = 0,
		conf = 0, runner = 0, split = 0, decap = 0, orders = 0, idle = 0, idle_role = 0, goal = 0, gar = 0, gar_assault = 0, gar_hold = 0, gar_bypass = 0, gren = 0 } }
EliteAI.mech = M
-- 0.7: the functions of the Defence / Vehicles / Setup patterns (one local for all of them: the chunk's limits of locals and upvalues)
local X = {}
-- 0.7 Defence: defence buildings by the name of their blueprint (ebps, lower case, a substring) - every race's base turrets and
-- the ones squads build (ig_laser_turret, ig_super_turret, the tarantula)
local DEF_KEYS = { "turret", "tarantula" }
