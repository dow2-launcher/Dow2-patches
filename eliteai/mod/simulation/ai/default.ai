-- ===== EliteAI main.ai =====
-- EliteAI: our module, inserted by EliteAI.dll into Elite's default.ai right before its final InitializeAI() call.
-- Elite's files stay as they are; we only wrap/override a few functions, and only for AI players with the new logic on.
-- On/off per AI player (EliteAI.on): in normal games for the Normal computer; in tests EliteAI.ini [Lua] NewAI decides
-- (all | none | normal | <player ids, e.g. 1000>) so one match can pit the new logic against Elite's (A/B).
-- Every tuning value can be overridden from EliteAI.ini [Lua] without rebuilding (EliteAI.num("Key", default)).

EliteAI = { version = "0.23" }
-- 0.23 (12.11, step 4 of the vanilla base; VANILLA_BASE_RU.md 14.3): WHICH SQUAD WAS LOST, WHERE, IN WHAT STATE. The telemetry counts
-- the squads that are gone ("squads_lost") and nothing says which: in 7 mirrors of step 3 this side lost 56 squads after 12:00
-- against 39 of the released AI with FEWER models lost (479 against 506 a series) - and the log cannot tell a manticore left
-- in front of the army from a squad in a capture task or a brood that was not sent home. The director now keeps, per squad id,
-- what it read at its last look (numbers: role army / cap / build, models, health, under fire, a vehicle, the place, the
-- distance to the HQ), and EliteAI_Sample - the very place that counts the loss - writes one line when the id is gone:
--   "LOST <id> <sbps> t T role R models N of F hp H hit 0|1 veh 0|1 at X Z home D m seen S s ago phase P retreat 0|1 refill 0|1"
-- and "BACK <id> ... after S s" when an id that was counted as lost shows up again (a squad out of a transport or a building
-- is not a loss: "squads_back" in the T line). No engine call is added - the numbers are the ones the scan reads anyway.
-- Nothing is decided by it; both bases write it. LostLog=0 = no lines.
-- 0.22 (12.11, step 3 of the vanilla base; VANILLA_BASE_RU.md 11.1): THE CAPTURE TASKS ARE WATCHED. With the director on the only
-- engine tasks that still move squads are the capture tasks (attack / defend tasks are killed every tick, sniper / immobile
-- tasks are never asked for) - and a squad in one is in nobody's list: no retreat by its health, no "FightLeave", no look at
-- the force it walks into; on the vanilla base it did not even shoot back (tactics.ai TacticFilter_ShouldRetaliate, Relic's
-- health-in-hit-points bug). The director now reads these squads too (the same calls, the same checks as for the army) and
-- hands them to mechanics.ai (state.caps, X.run_capwatch): hurt under fire or outweighed where it stands -> a retreat order,
-- as a squad of the army would get. Mech_CapWatch: 1 on the vanilla base, 0 on the Elite base (the released AI is not changed).
-- AggrMax: the ceiling of Military_SetSquadAggression - vanilla raises it to 1.0 ("allow units to die") at the population
-- cap with a full bank, which is exactly where the new AI ends up; 0.75 on the vanilla base, 1 (no ceiling) on the Elite base.
-- 0.21 (11.11, the vanilla base; reports/ai_doctrine/VANILLA_BASE_RU.md section 7): this module also runs on top of the
-- VANILLA 3.19 scripts. The dispatcher (tools/vanilla_dispatch.py, the head of the served default.ai) decides per player and
-- leaves EliteAI_MODE = { base = "vanilla" | "elite", ours = true | false, real_diff, diff }; without a dispatcher (the DLL
-- appends this module to Elite's own default.ai) EliteAI_MODE is nil and everything is as before. EliteAI.base names the base.
-- On the vanilla base the scripts see Hard (VanillaDiff), not Standard: vanilla's Hard personality is the base of the new AI
-- (T2 + T3, no caps on generators / nodes, attacks bases); the personality fields Elite added are set in s_personality.Create.
EliteAI.base = (type(EliteAI_MODE) == "table" and EliteAI_MODE.base) or "elite"

-- 0.9 (10.11): THREE VARIANTS for testers to compare, chosen in the skirmish menu by the computer slot's difficulty:
-- Easy = "NEW AI A", Normal = "NEW AI B", Hard = "NEW AI C" (EliteAI.dll relabels them); Expert = Elite's AI, untouched.
-- All three play with the standard personality (s_diffLevel/AIPlayer_GetDifficultyLevel -> AD_Standard).
-- A value here is used when EliteAI.ini [Lua] has no such key (ini > variant > default in the code).
-- 0.10 (10.11, owner): variants are NOT characters (no "cautious"/"aggressive"): the same logic, all mechanics on (Mech_* = 1),
-- the same retreat threshold/aggression/targets; A/B/C differ ONLY in how disputed decisions are resolved - the conflict
-- arbiters Conf_* of mod/mechanics.ai (1/2/3, table in reports/newai_1110/MECHANICS_RU.md section 3). Any key can still be
-- Conf_TechVsArmy (10.11): the tech plan of mod/simulation/ai/strategy_tech_purchase.ai (reports/newai_1110/TECH_RU.md).
-- Conf_ReinforceVsSave (10.11): the reinforcement budget of mod/simulation/ai/strategy_unit_purchase.ai (TECH_RU.md section 8):
-- while power piles up and req is short for the next tier / a power unit, a cheap squad is reinforced by rule 1 = only weak
-- and out of a fight, 2 = weak (in a fight too), 3 = in a fight or below Reinf_FullHp; share of the req income 0.2 / 0.35 / 0.5.
-- overridden in EliteAI.ini [Lua] (ini > variant > default in the code).
-- 0.11 (11.11, the scene polygon): Conf_Garrison - an enemy squad in a building next to our point (mod/mechanics.ai 0.3):
-- 1 = assault only with an anti-garrison tool, 2 = by strength, 3 = bypass unless a tool and a margin; Conf_AddonVsUnit -
-- squad upgrades against the next unit (strategy_unit_purchase.ai "energy"): 1 = the unit first, 2 = balanced, 3 = as Elite.
-- The director takes the goal of mechanics.ai (EliteAI.goal: the next point for an army that stood at its target, the
-- building of a garrison, the hold spot) before Elite's best target. reports/newai_1110/TECH_RU.md section 10.
-- 0.12 (11.11, the verification of newai-10, TECH_RU.md 10.10 / 11): the order book (EliteAI_OrderGate below) - every order of
-- the director and of mechanics.ai passes one gate, so a squad is not given the same order again while it is on its way
-- (the scene a: three carnifexes got an attack-move every 3 s for 20 s and moved a metre each time).
--   RetreatHP 0.35 (squad goes home below this health share), RetreatSecs 40, AggrMin 0.75 (floor of Military_SetSquadAggression),
--   AttackTargets 2, Inertia 4, TargetTicks 450, GatherR 30, KiteChance/KiteRatio x1 - identical in A, B, C
EliteAI_VARIANTS = {
	A = { name = "rules A", RetreatHP = 0.35, RetreatSecs = 40, AggrMin = 0.75, AttackTargets = 2, Inertia = 4, TargetTicks = 450,
		GatherR = 30, KiteChance = 1, KiteRatio = 1,
		Mech_Purchase = 1, Mech_FocusFire = 1, Mech_ArmyRetreat = 1, Mech_PunishTurn = 1, Mech_PreRetreat = 1, Mech_MeleeTie = 1, Mech_Repair = 1, Mech_RaceAbilities = 1, Mech_ArmyRoles = 1, Mech_Idle = 1, Mech_Garrison = 1,
		Conf_MeleeApproach = 1, Conf_FocusLeave = 1, Conf_Chase = 1, Conf_Split = 1, Conf_Decap = 1, Conf_HoldVP = 1, Conf_TieVsFocus = 1, Conf_RepairVsFight = 1, Conf_PreEngage = 1, Conf_RunnerFight = 1, Conf_AbilitySave = 1, Conf_TechVsArmy = 1, Conf_ReinforceVsSave = 1, Conf_Garrison = 1, Conf_AddonVsUnit = 1 },
	B = { name = "rules B", RetreatHP = 0.35, RetreatSecs = 40, AggrMin = 0.75, AttackTargets = 2, Inertia = 4, TargetTicks = 450,
		GatherR = 30, KiteChance = 1, KiteRatio = 1,
		Mech_Purchase = 1, Mech_FocusFire = 1, Mech_ArmyRetreat = 1, Mech_PunishTurn = 1, Mech_PreRetreat = 1, Mech_MeleeTie = 1, Mech_Repair = 1, Mech_RaceAbilities = 1, Mech_ArmyRoles = 1, Mech_Idle = 1, Mech_Garrison = 1,
		Conf_MeleeApproach = 2, Conf_FocusLeave = 2, Conf_Chase = 2, Conf_Split = 2, Conf_Decap = 2, Conf_HoldVP = 2, Conf_TieVsFocus = 2, Conf_RepairVsFight = 2, Conf_PreEngage = 2, Conf_RunnerFight = 2, Conf_AbilitySave = 2, Conf_TechVsArmy = 2, Conf_ReinforceVsSave = 2, Conf_Garrison = 2, Conf_AddonVsUnit = 2 },
	C = { name = "rules C", RetreatHP = 0.35, RetreatSecs = 40, AggrMin = 0.75, AttackTargets = 2, Inertia = 4, TargetTicks = 450,
		GatherR = 30, KiteChance = 1, KiteRatio = 1,
		Mech_Purchase = 1, Mech_FocusFire = 1, Mech_ArmyRetreat = 1, Mech_PunishTurn = 1, Mech_PreRetreat = 1, Mech_MeleeTie = 1, Mech_Repair = 1, Mech_RaceAbilities = 1, Mech_ArmyRoles = 1, Mech_Idle = 1, Mech_Garrison = 1,
		Conf_MeleeApproach = 3, Conf_FocusLeave = 3, Conf_Chase = 3, Conf_Split = 3, Conf_Decap = 3, Conf_HoldVP = 3, Conf_TieVsFocus = 3, Conf_RepairVsFight = 3, Conf_PreEngage = 3, Conf_RunnerFight = 3, Conf_AbilitySave = 3, Conf_TechVsArmy = 3, Conf_ReinforceVsSave = 3, Conf_Garrison = 3, Conf_AddonVsUnit = 3 },
}

-- C functions from EliteAI.dll: global, or (AI scripts run in their own environment) via the shared string table
local G0 = getfenv and getfenv(0) or {}
eliteai_log = eliteai_log or G0.eliteai_log or string.eliteai_log
eliteai_cfg = eliteai_cfg or G0.eliteai_cfg or string.eliteai_cfg

local function log(...)
	if eliteai_log then eliteai_log("p" .. tostring(s_selfplayerid), ...) end
end
EliteAI.log = log

-- step 4 (10.11): every swallowed error is logged with its place (a pcall'd engine error leaked the Lua mutex -> hang)
-- 0.13 (11.11, TECH_RU.md 11.10 / 12): no pcall is left around an engine call in this file - every call is preceded by the
-- checks that made it fail (no squad, no models, no point) and goes direct. perr stays for the SCAR side's text and the stubs.
EliteAI.errn = {}
local function perr(tag, err)
	local c = (EliteAI.errn[tag] or 0) + 1; EliteAI.errn[tag] = c
	if c <= 5 or c - math.floor(c / 50) * 50 == 0 then log("PCALLERR", tag, c, tostring(err)) end
end
EliteAI.perr = perr

local function cfg(key, default)
	local v = eliteai_cfg and eliteai_cfg(key)
	if v == nil then return default end
	return v
end
local function num(key, default)
	local v = tonumber(cfg(key, nil))
	if v == nil and EliteAI.vp then v = EliteAI.vp[key] end           -- the match variant's value
	if v == nil then return default end
	return v
end
EliteAI.cfg, EliteAI.num = cfg, num

EliteAI.real_diff = s_diffLevel                                    -- the slot's difficulty = the variant (before ForceDiff)
if type(EliteAI_MODE) == "table" and EliteAI_MODE.real_diff ~= nil then EliteAI.real_diff = EliteAI_MODE.real_diff end   -- the dispatcher has applied ForceDiff / VanillaDiff already
-- tests: the local slot handed to the AI gets Hard; ForceDiff makes the scripts of every AI see the same level
-- (the Elite base only: the vanilla base sees VanillaDiff, set by the dispatcher)
do
	local fd = tonumber(eliteai_cfg and eliteai_cfg("ForceDiff") or "")
	if fd and EliteAI.base ~= "vanilla" then s_diffLevel = fd end
end

-- is the new logic on for this AI player?
local function new_logic_on()
	if type(EliteAI_MODE) == "table" then return EliteAI_MODE.ours == true end   -- 0.21: the dispatcher's decision (vanilla | vanilla+ours | elite+ours | elite)
	local mode = cfg("NewAI", "normal")
	if mode == "all" then return true end
	if mode == "none" then return false end
	if mode == "normal" then                                         -- the menu: Easy/Normal/Hard = A/B/C, Expert = Elite
		local d = EliteAI.real_diff
		return d == AD_Easy or d == AD_Standard or d == AD_Hard
	end
	for id in (string.gmatch or string.gfind)(mode, "%d+") do
		if tonumber(id) == s_selfplayerid then return true end
	end
	return false
end
EliteAI.on = new_logic_on()
if EliteAI.on then
	local d, v = EliteAI.real_diff, string.upper(cfg("Variant" .. tostring(s_selfplayerid), nil) or cfg("Variant", "") or "")  -- tests: [Lua] Variant1000=A or Variant=A
	if not EliteAI_VARIANTS[v] then v = (d == AD_Easy and "A") or (d == AD_Hard and "C") or "B" end
	EliteAI.variant, EliteAI.vp = v, EliteAI_VARIANTS[v]
	-- every variant plays the standard personality and build orders (Elite reads the level again in Reset/buildorder conditions)
	-- 0.21: on the vanilla base every variant plays the level the dispatcher set (Hard, or VanillaDiff) - its wrapper of
	-- AIPlayer_GetDifficultyLevel is in place and default.ai has read s_diffLevel through it
	if EliteAI.base ~= "vanilla" then
		s_diffLevel = AD_Standard
		local Elite_GetDiff = AIPlayer_GetDifficultyLevel
		AIPlayer_GetDifficultyLevel = function(p) Elite_GetDiff(p); return AD_Standard end
	end
end

--------------------------------------------------------------------------------------------------
-- STAGE 1, the skeleton: fight as an army, hold the target, take real fights instead of running between points.
-- Elite gives every combat squad its own task (1 task = 1 squad) with scores that spread squads apart when there is
-- no threat (avoid_clumps 10), switch targets easily (inertia 1.25) and drop a task after 5 s idle at the rally point
-- and 12 s at the target -> squads run around and trickle in one by one.
_G0_RALLY = { InBase = RALLY_InBase, ReinforcePoint = RALLY_ReinforcePoint, LastPosSafe = RALLY_LastPosSafe, None = RALLY_None, NearDefendPoint = RALLY_NearDefendPoint }
local Elite_Request_Combat = Request_Combat
EliteAI.rc = 0
Request_Combat = function(player, group, priority, p)
	EliteAI.rc = EliteAI.rc + 1                                       -- telemetry: proof our wrapper is the one being called
	if EliteAI.on and type(p) == "table" then
		p.score_avoid_clumps_at_no_threat = num("ClumpAvoid", 0)     -- don't push squads apart
		p.score_distance_to_squad = num("DistSquad", 20)            -- prefer targets close to the squad (and so to each other)
		p.score_threat = num("Threat", 8)                           -- prefer places where the enemy army is
		p.score_inertia = num(p.combat_type == COMBAT_Defend and "InertiaDef" or "Inertia", 4)   -- keep the chosen target
		p.timeout_ticks_at_rally = num("RallyTicks", 200)           -- wait for the others at the rally point (ticks = 0.1 s)
		p.timeout_ticks_at_target = num("TargetTicks", 450)         -- don't give up a fight after 12 s
		local rally = cfg("Rally", nil)                             -- where a task gathers before going (Elite: near "its" defend point)
		if rally and _G0_RALLY[rally] then p.rally_location = _G0_RALLY[rally] end
	end
	return Elite_Request_Combat(player, group, priority, p)
end

-- Elite: "easy and normal are only interested in capture points" - Normal attacks nothing but capture points, so it
-- runs between points and never goes for the enemy army or base. The new logic ranks attack targets like Hard does.
local Elite_CalcAttackPriority = Target_CalcAttackPriority
Target_CalcAttackPriority = function(militaryPoint)
	local r
	if EliteAI.on and cfg("PointsOnly", "0") ~= "1" and (s_diffLevel == AD_Easy or s_diffLevel == AD_Standard) then
		-- 0.13: direct (was a pcall around Elite's function and every engine call inside it). Elite calls the same function
		-- with the same point for its Hard AI; a missing point is not ranked at all
		local real = s_diffLevel
		r = 0
		if militaryPoint ~= nil then
			s_diffLevel = AD_Hard
			r = Elite_CalcAttackPriority(militaryPoint) or 0
			s_diffLevel = real
		end
	else
		r = Elite_CalcAttackPriority(militaryPoint)
	end
	if EliteAI.collect and r > 0 then table.insert(EliteAI.collect, { mp = militaryPoint, pr = r }) end
	return r
end

-- a fist, not a spread: Elite registers every point with a priority and each squad-task picks its own -> squads spread
-- over the whole map. The new logic keeps only the best AttackTargets (default 2) so the army converges on them.
local Elite_RankAttackTargets = RankAttackTargets
RankAttackTargets = function()
	if not EliteAI.on then return Elite_RankAttackTargets() end
	EliteAI.collect = {}
	Elite_RankAttackTargets()                                       -- 0.13: direct (was a pcall around all of Elite's ranking)
	local list = EliteAI.collect or {}; EliteAI.collect = nil
	table.sort(list, function(a, b) return a.pr > b.pr end)
	-- 0.7: the position now, not the point: Elite rebuilds its military points, a point kept for the director's next
	-- tick is a dead engine object - reading it crashed the game (R6025 pure virtual call, 0:30-3:00 into a match)
	EliteAI.best_pos = nil
	local mp = list[1] and list[1].mp                               -- collected in this very call: the point is alive
	if mp ~= nil then
		local p = Military_GetMilitaryPointPosition(mp)              -- 0.13: direct, the point checked first
		if p ~= nil and p.x ~= nil and p.z ~= nil then
			EliteAI.best_pos = { x = p.x, y = p.y, z = p.z }; EliteAI.best_key = string.format("%.0f %.0f", p.x, p.z)
		end
	end
	local k = num("AttackTargets", 2)
	if k <= 0 or table.getn(list) <= k then return end
	Military_ClearTargets(s_selfplayer, MTARGET_Attack)
	for i = 1, k do Military_AddTarget(s_selfplayer, MTARGET_Attack, list[i].mp, list[i].pr) end
	Military_SortAndCapTargets(s_selfplayer, MTARGET_Attack)
end

-- stay in a fight longer before squads break off (Elite: 0.4 - 1.0 by population/economy)
local Elite_SetAggression = Military_SetSquadAggression
Military_SetSquadAggression = function(player, level)
	if EliteAI.on then
		level = math.max(level, num("AggrMin", 0.75))
		local amax = num("AggrMax", (EliteAI.base == "vanilla") and 0.75 or 1)   -- 0.22: no "allow units to die" on the vanilla base
		if level > amax then level = amax end
	end
	EliteAI.aggression = level
	return Elite_SetAggression(player, level)
end

-- personality: rank attack targets by threat too (Elite: only defend does), applied on every (re)load of the personality
local Elite_PersonalityCreate = s_personality.Create
s_personality.Create = function()
	Elite_PersonalityCreate()
	if EliteAI.on then
		s_personality.attack_prefer_threat = cfg("AttackPreferThreat", "1") == "1"
		-- 0.21, the vanilla base: the personality is vanilla's own (Hard). Nothing of Elite's personality is brought back; the
		-- two numbers below are ours and can be set from the ini. Base_MaxCapturers: squads vanilla keeps in capture tasks
		-- (vanilla 4; the director and the runners of mechanics.ai take the map, so it is not raised). Base_Glue: vanilla
		-- stops buying units while its army is this many times the closest enemy's (default personality 1.0) - SPEND ignores
		-- the verdict (Spend_NoGlue), the number is left as it is unless set.
		-- Base_SecureMinPts (1; vanilla Hard 4): points owned before the first node is asked for - the node is the way to
		-- the generators, and when / how many is the business of the plan (ENERGY: the first node always, another by need).
		-- Base_PowerLock (15; vanilla 150): the power default.ai keeps back for squad abilities (ability_money_cache) - a
		-- part of the dead power bank. -1 = vanilla's own number.
		if EliteAI.base == "vanilla" then
			local mc, glue, smin, lock = num("Base_MaxCapturers", -1), num("Base_Glue", -1), num("Base_SecureMinPts", 1), num("Base_PowerLock", 15)
			if mc >= 0 then s_personality.max_num_capturers = mc end
			if glue >= 0 then s_personality.glue_military_percentage = glue end
			if smin >= 0 then s_personality.min_captured_pts_before_securing = smin end
			if lock >= 0 then s_powerToLock = lock end
			if not EliteAI.base_said then
				EliteAI.base_said = true
				log("base", "vanilla", "diff", tostring(s_diffLevel), "max_capturers", tostring(s_personality.max_num_capturers), "glue", tostring(s_personality.glue_military_percentage),
					"secure_min_pts", tostring(s_personality.min_captured_pts_before_securing), "max_secured", tostring(s_personality.max_secured_pts), "power_lock", tostring(s_powerToLock))
			end
		end
		if s_personality.kite_chance then s_personality.kite_chance = s_personality.kite_chance * num("KiteChance", 1) end
		if s_personality.kite_ratio then s_personality.kite_ratio = s_personality.kite_ratio * num("KiteRatio", 1) end
	end
end

--------------------------------------------------------------------------------------------------
-- STAGE 2, combat director (Director=1): Elite's job system moves every squad on its own (1 task = 1 squad), whatever
-- we tune (v0.2-v0.4: no effect on spread or results). The director takes the combat squads out of that system and
-- moves them as one army. Orders go through EliteAI.dll to a SCAR rule (the AI state has no Command_*).
EliteAI.director = EliteAI.on and cfg("Director", "1") == "1"
local ORD_MOVE, ORD_ATTACK, ORD_RETREAT = 1, 2, 3
local _order = eliteai_order or (string and string.eliteai_order)
EliteAI.retreating, EliteAI.orders, EliteAI.dir_squads = {}, 0, 0
EliteAI.weak_n = {}                                                -- 0.13: models a squad had when it last went home to be refilled (numbers by squad id)
EliteAI.refill = {}                                                -- 0.14: squads on a refill stay { t, home_t, prog, n, got } (numbers by squad id)
EliteAI.refill_ban = {}                                            -- 0.16: no "ordered" stay for this squad until then (its models did not come)
-- 0.19 (TECH_RU.md 20.4; Orca fb 557: "late, without the map and the income - do not reinforce the squads that bleed"): the models a
-- squad of the army lost lately - its count at the last look (lossn) and the falls { t, k } of the last LossKeepSecs (numbers
-- only); the purse of the refills reads the sum (strategy_unit_purchase.ai r_goal)
EliteAI.lossn, EliteAI.loss = {}, {}
function EliteAI_LossRecent(id, secs)
	local L = EliteAI.loss[id]
	if L == nil then return 0 end
	local now, sum = World_GetGameTime(), 0
	for _, e in ipairs(L) do if now - e.t <= secs then sum = sum + e.k end end
	return sum
end

local function dist(a, b) return math.sqrt((a.x - b.x) ^ 2 + (a.z - b.z) ^ 2) end

-- 0.12 THE ORDER BOOK: one gate for every order to a squad, whoever gives it (the director here, the mechanics of
-- mechanics.ai through morder). Found by the polygon (scene a, newai-10): with a squad under fire somewhere the director's rule
-- "a fight is on: everybody goes there" gave the whole army the same attack-move on every tick (3 s); the carnifexes, for a
-- reason on the engine's side, dropped it within a second each time - 7 orders in 20 s, a metre of movement per order. And the
-- Idle logic and the director sent one squad to two places in turn. The rules (numbers per squad id between ticks, nothing else):
--  * "already on its way": the same order (attack-move / move to a spot within OrderSameR of the last one; attack on the same
--    squad) is not repeated for OrderMoveSecs / OrderAttackSecs; a squad that stands within OrderArriveR of the spot needs none.
--  * no effect: a squad that still stands quiet (the Idle clock of mechanics.ai: did not move, was not hit, did not fire) where
--    it stood when its attack-moves began OrderStuckAfter (6) seconds ago gets a plain move instead ("MECH Order ... -> move":
--    in the scene a plain move worked where the attack-move did not), and the attack-move again once it has moved OrderProgressD.
--  * a ceiling: at most OrderBurst (3) marching orders (attack-moves; moves of the director and of the Idle logic) while the
--    squad stays within OrderProgressD of where the series began, per OrderWindow seconds - whatever the targets (the
--    polygon's order_loop is 4 of a kind in 30 s without 8 m of movement).
--  * one owner: after an order of the Idle logic the director's march orders to that squad wait OrderOwnerHold seconds (a
--    fight - rule 1 - and every order of the mechanics pass).
-- Retreats, captures and abilities keep their own timers and pass. OrderGate=0 switches the gate off.
EliteAI.ord, EliteAI.sqpos, EliteAI.idle_for = {}, {}, {}
EliteAI.ord_st = { sent = 0, skip = 0, alt = 0, cap = 0, held = 0, esc = 0 }
-- 0.17 (TECH_RU.md 16.2; the polygon's scene a, newai-14: "Order 50010 no effect: 3 orders in 18 s ... none until the window
-- is over last 30:2:dir 33:2:dir 36:4:mech" - the carnifex stood 32 s). The ceiling was checked before the replacement
-- "the attack-move had no effect -> a plain move": the third order of the series (an attack on a squad) filled the ceiling,
-- the replacement was never given and the squad waited for the end of the window. Now:
--  * the replacement comes BEFORE the ceiling, and an attack on a squad is replaced too (a plain move towards that squad:
--    EliteAI.enpos of mechanics.ai - numbers of the last scan);
--  * after the replacement had no effect either (the squad still stands quiet where the series began OrderEscSecs after its
--    last order), or at the ceiling, the squad is not left to wait for the window: the next order becomes ANOTHER order to
--    ANOTHER spot - a short plain move (OrderStepD) towards the target first, then a step aside (the side by the squad id);
--    OrderEscMax (2) of these per series, so a series is at most 2 attack-moves + 3 plain moves (the polygon's order_loop is
--    4 of a kind). Lines "MECH Order <id> no effect after N orders: -> step K ...". OrderEsc=0 = the ceiling waits as 0.16.
local function ord_quiet(id, r, p)                                            -- it stands quiet where the series began
	return p ~= nil and r.ax ~= nil and math.sqrt((p.x - r.ax) ^ 2 + (p.z - r.az) ^ 2) <= num("OrderStuckD", 4)
		and (EliteAI.idle_for[id] or 0) >= num("OrderStuckSecs", 4)
end
local function ord_escalate(id, r, p, tx, tz, now, owner)
	if num("OrderEsc", 1) < 1 or p == nil or tx == nil or tz == nil or not ord_quiet(id, r, p) then return nil end
	local last = r.t or -1000
	if r.esc_t and r.esc_t > last then last = r.esc_t end
	if now - last < num("OrderEscSecs", 6) then return nil end
	local k = (r.esc or 0) + 1
	if k > num("OrderEscMax", 2) then return nil end
	local dx, dz = tx - p.x, tz - p.z
	local l = math.sqrt(dx * dx + dz * dz)
	if l < 1 then return nil end
	dx, dz = dx / l, dz / l
	local step = num("OrderStepD", 12)
	local nx, nz, what
	if k == 1 then
		if step > l then step = l end
		nx, nz, what = p.x + dx * step, p.z + dz * step, "a short move towards the target"
	else
		local n = math.floor(id + 0.5) + k
		local side = (n - math.floor(n / 2) * 2 == 0) and 1 or -1               -- the side by the squad id: the same in every run
		nx, nz, what = p.x - dz * side * step, p.z + dx * side * step, "a step aside"
	end
	r.esc, r.esc_t = k, now
	EliteAI.ord_st.esc = (EliteAI.ord_st.esc or 0) + 1
	r.hist = (r.hist and (r.hist .. " ") or "") .. string.format("%.0f:1:esc", now)
	log("MECH", "Order", id, "no effect after", r.n, "orders in", string.format("%.0f s", now - r.at), ": -> step", k, what, string.format("%.0f %.0f", nx, nz), "by", tostring(owner), "last", r.hist or "-")
	return 1, nx, nz
end
-- returns the mode to send (nil = no order) and, when the order was replaced by one to another spot, that spot (x, z)
function EliteAI_OrderGate(id, mode, x, z, now, owner, urgent)
	local st = EliteAI.ord_st
	if id == nil or num("OrderGate", 1) < 1 then st.sent = st.sent + 1; return mode end
	local r = EliteAI.ord[id]
	if mode ~= 1 and mode ~= 2 and mode ~= 4 then                           -- retreat, capture, abilities: their own timers
		if r then r.cls, r.tid, r.x, r.z, r.hold = nil, nil, nil, nil, nil end -- the next order to a spot is a new one (the ceiling still counts)
		st.sent = st.sent + 1
		return mode
	end
	if not r then r = { t = -1000, n = 0, at = now }; EliteAI.ord[id] = r end
	-- 0.18 THE BUILDER WAIT (TECH_RU.md 19.6; every log we have: "secure_req 30 secure_dead 28" (Orca, newai-17), 16 / 15 and 11 / 9
	-- (s22), 20 / 19 (fb 544) - the structure that secures a point is the condition of every generator (strategy_resourcing.ai:
	-- cache.total_pts_secured_w_addon_capacity), and in Orca's match the tyranids had no generator from 12:30 to 21:00). A
	-- request of Elite's is a task the engine gives to a squad; a squad that already builds is left to it (builds() above), but
	-- between the request and the director's next look the squad it was given to gets our march order and the task dies
	-- "inactive". A HYPOTHESIS, not seen in the game: for BuildWaitSecs after the purchase scripts placed a Secure / generator
	-- request (EliteAI.build_req_t) the director's and the Idle logic's march orders are not given while nobody of the army
	-- is under attack - the next look finds the builder building. BuildWaitSecs=0 = off. Counted: stats3 "build_wait".
	local bw = num("BuildWaitSecs", 4)
	if bw > 0 and EliteAI.build_req_t ~= nil and now >= EliteAI.build_req_t and now - EliteAI.build_req_t < bw and not EliteAI.any_hit
		and ((owner == "dir" and not urgent) or owner == "idle") then
		st.bwait = (st.bwait or 0) + 1
		return nil
	end
	-- 0.19 (TECH_RU.md 20.1): ... and while a request is OPEN (EliteAI.build_open, stamped every purchase tick by
	-- strategy_unit_purchase.ai: a node whose verdict is not in yet, a generator task nobody has taken) a squad that stands
	-- within BuildNearR of a power point of ours where something can be built (EliteAI.pw.sites, mechanics.ai's point scan) is
	-- not marched away by the director or the Idle logic - it is the one the engine can give the structure to. Not while
	-- anybody is under attack; the squad that builds is out of the army anyway (builds()). BuildNearR=0 = off. stats3 "build_near".
	local bnr, bo, pw = num("BuildNearR", 30), EliteAI.build_open, EliteAI.pw
	if bnr > 0 and bo ~= nil and now >= bo and now - bo <= num("BuildOpenSecs", 8) and not EliteAI.any_hit
		and ((owner == "dir" and not urgent) or owner == "idle") and type(pw) == "table" and type(pw.sites) == "table" then
		local p = EliteAI.sqpos[id]
		if p ~= nil and p.x ~= nil and p.z ~= nil then
			for _, q in ipairs(pw.sites) do
				if (p.x - q.x) ^ 2 + (p.z - q.z) ^ 2 <= bnr * bnr then st.bnear = (st.bnear or 0) + 1; return nil end
			end
		end
	end
	if owner == "dir" and not urgent and r.hold and now < r.hold then st.held = st.held + 1; return nil end
	local hold = (owner == "idle") and (now + num("OrderOwnerHold", 9)) or nil
	local burst, after = num("OrderBurst", 3), num("OrderStuckAfter", 6)
	if mode == 4 then                                                       -- attack the squad with id x
		if r.cls == 4 and r.tid == x and now - r.t < num("OrderAttackSecs", 10) then st.skip = st.skip + 1; return nil end
		-- 0.16 (TECH_RU.md 15.6; the polygon's scene a, newai-13: a carnifex that drops every order within a second got an
		-- attack-move, an attack on a squad 56 m away (FocusFire), an attack-move ... - each a new order for this book, the
		-- attack on a squad was outside the series and wiped the "attack-move had no effect" check). An attack on a squad given
		-- to a squad that stands quiet (did not move, was not hit, did not fire for OrderStuckSecs) is a march to that target:
		-- it counts in the series and falls under the ceiling. A squad that shoots is not quiet - its focus orders pass as before.
		local p4 = EliteAI.sqpos[id]
		if p4 and (EliteAI.idle_for[id] or 0) >= num("OrderStuckSecs", 4) then
			if r.ax == nil or now - r.at > num("OrderWindow", 30) or math.sqrt((p4.x - r.ax) ^ 2 + (p4.z - r.az) ^ 2) > num("OrderProgressD", 8) then
				r.ax, r.az, r.at, r.n, r.alt, r.hist, r.esc, r.esc_t = p4.x, p4.z, now, 0, nil, nil, nil, nil
			end
			local tp = (type(EliteAI.enpos) == "table") and EliteAI.enpos[x] or nil   -- where that squad was at the last scan ({ x, z })
			if tp ~= nil and (tp.x == nil or tp.z == nil) then tp = nil end
			-- 0.17: the replacement before the ceiling - the orders of this series (attack-moves, attacks) had no effect
			if tp and not r.alt and r.n >= 1 and (r.cls == 2 or r.cls == 4) and ord_quiet(id, r, p4) and now - r.at >= after then
				r.alt = true
				st.alt, st.sent = st.alt + 1, st.sent + 1
				log("MECH", "Order", id, "attack-move had no effect (stands quiet", string.format("%.0f s", EliteAI.idle_for[id] or 0), "): -> move", string.format("to %.0f %.0f", tp.x, tp.z), "towards the squad", x, "by", tostring(owner), "last", r.hist or "-")
				r.hist = (r.hist and (r.hist .. " ") or "") .. string.format("%.0f:1:%s", now, tostring(owner))
				r.cls, r.tid, r.x, r.z, r.t, r.n, r.hold = 1, nil, tp.x, tp.z, now, r.n + 1, hold
				return 1, tp.x, tp.z
			end
			if r.alt or r.n >= burst then
				local m, nx, nz = ord_escalate(id, r, p4, tp and tp.x, tp and tp.z, now, owner)
				if m then st.sent = st.sent + 1; return m, nx, nz end
			end
			if r.n >= burst then
				st.cap = st.cap + 1
				if not r.said or now - r.said >= 30 then
					r.said = now
					log("MECH", "Order", id, "no effect:", r.n, "orders in", string.format("%.0f s", now - r.at), "without", num("OrderProgressD", 8), "m of movement - none until the window is over", "last", r.hist or "-")
				end
				return nil
			end
			r.n = r.n + 1
			r.hist = (r.hist and (r.hist .. " ") or "") .. string.format("%.0f:4:%s", now, tostring(owner))
		end
		r.cls, r.tid, r.x, r.z, r.t, r.hold = 4, x, nil, nil, now, hold
		st.sent = st.sent + 1
		return mode
	end
	if x == nil or z == nil then return nil end
	local p = EliteAI.sqpos[id]                                             -- where the squad is this tick ({ x, y, z }; nil = unknown)
	local pd = num("OrderProgressD", 8)
	if p and math.sqrt((p.x - x) ^ 2 + (p.z - z) ^ 2) <= num("OrderArriveR", 6) then st.skip = st.skip + 1; return nil end   -- it is there
	-- the series: where the squad stood when the orders to a spot began; it starts anew once the squad has moved or the window is over
	local unstuck = false
	if r.ax == nil or now - r.at > num("OrderWindow", 30) then
		r.ax, r.az, r.at, r.n, r.alt, r.hist, r.esc, r.esc_t = p and p.x, p and p.z, now, 0, nil, nil, nil, nil
	elseif p and math.sqrt((p.x - r.ax) ^ 2 + (p.z - r.az) ^ 2) > pd then
		unstuck = (r.alt == true)
		r.ax, r.az, r.at, r.n, r.alt, r.hist, r.esc, r.esc_t = p.x, p.z, now, 0, nil, nil, nil, nil
	end
	local same = (r.cls == mode and r.x ~= nil and math.sqrt((r.x - x) ^ 2 + (r.z - z) ^ 2) <= num("OrderSameR", 10))
	-- no effect: the series began OrderStuckAfter seconds ago with an attack-move, and the squad stands quiet where it began
	-- (whatever the spots were: the fight the army is called to may move)
	-- (0.16: the last order of the series may also have been an attack on a squad - see mode 4 above)
	local stuck = (r.n >= 1 and (r.cls == 2 or r.cls == 4) and ord_quiet(id, r, p) and now - r.at >= after)
	local alt = (mode == 2 and stuck and not r.alt)
	-- (the ceiling is for marches: a plain move of the mechanics - away from a melee squad, out from under a garrison's
	-- windows - is never held back by it)
	local march = (mode == 2 or owner == "dir" or owner == "idle")
	-- 0.17: the replacement was tried (or the ceiling is reached) and the squad still stands: another order to another spot
	if not alt and march and (r.alt or r.n >= burst) then
		local m, nx, nz = ord_escalate(id, r, p, x, z, now, owner)
		if m then st.sent = st.sent + 1; return m, nx, nz end
	end
	if same and not alt and not unstuck and now - r.t < num("OrderMoveSecs", 12) then st.skip = st.skip + 1; return nil end
	-- 0.17: the replacement goes before the ceiling (it is the answer to a series that had no effect, not one more march)
	if not alt and r.n >= burst and march then
		st.cap = st.cap + 1
		if not r.said or now - r.said >= 30 then
			r.said = now
			log("MECH", "Order", id, "no effect:", r.n, "orders to a spot in", string.format("%.0f s", now - r.at), "without", pd, "m of movement - none until the window is over", "last", r.hist or "-")
		end
		return nil
	end
	local send = mode
	if alt then
		send, r.alt = 1, true
		st.alt = st.alt + 1
		log("MECH", "Order", id, "attack-move had no effect (stands quiet", string.format("%.0f s", EliteAI.idle_for[id] or 0), "): -> move", string.format("to %.0f %.0f", x, z), "by", tostring(owner), "last", r.hist or "-")
	end
	r.hist = (r.hist and (r.hist .. " ") or "") .. string.format("%.0f:%d:%s", now, send, tostring(owner))   -- 0.16: the series, for the "no effect" lines (time:mode:owner)
	r.cls, r.tid, r.x, r.z, r.t, r.n, r.hold = mode, nil, x, z, now, r.n + 1, hold
	r.sx, r.sz = p and p.x, p and p.z
	st.sent = st.sent + 1
	return send
end
-- the director's order: u = an entry of its army list ({ sq, id, pos }, valid this tick), through the order book.
-- (0.12: no pcall and no engine call here - the id is read in the army scan, the DLL queue only stores five numbers)
local function order(u, pos, mode, urgent)
	if not _order or not u or not u.id or not pos then return end
	local m, nx, nz = EliteAI_OrderGate(u.id, mode, pos.x, pos.z, EliteAI.now or 0, "dir", urgent)
	if not m then return end
	if nx ~= nil and nz ~= nil then _order(u.id, nx, (u.pos and u.pos.y) or pos.y, nz, m)   -- 0.17: the book gave another spot
	else _order(u.id, pos.x, pos.y, pos.z, m) end
	EliteAI.orders = EliteAI.orders + 1
end
-- 0.15: the squad stops where it stands - a plain move to its own spot ends the march order it had (the order book would
-- skip it as "it is there", so it goes past the book, and the book starts anew for this squad)
local function halt(u)
	if not _order or not u or not u.id or not u.pos then return end
	_order(u.id, u.pos.x, u.pos.y, u.pos.z, ORD_MOVE)
	EliteAI.orders = EliteAI.orders + 1
	EliteAI.ord[u.id] = nil
end

-- 0.16 (TECH_RU.md 15.5): a squad that models were ordered for and that stands farther than RefillNearD from the HQ walks up to
-- it (a plain move past the book, as halt): "at home" is 40 m of the HQ, the reach of the reinforce point is the engine's own
-- and smaller for all we know (s18: "dir no effect 50023 ... out of reach of a reinforce point?" for a squad that was "at home")
local function to_hq(u, hq, d)
	if not _order or not u or not u.id or not u.pos or not hq then return end
	local dh = u.dhome or 0
	if dh <= d or dh <= 0 then halt(u); return end
	local k = d / dh
	_order(u.id, hq.x + (u.pos.x - hq.x) * k, u.pos.y, hq.z + (u.pos.z - hq.z) * k, ORD_MOVE)
	EliteAI.orders = EliteAI.orders + 1
	EliteAI.ord[u.id] = nil
end
-- 0.16: enemy squads at our base by the last scan of mechanics.ai (numbers: EliteAI.mech.en = { x, z }, at most 10 s old;
-- strategy_tech_purchase.ai reads the same for its "enemy_at_base") - how many within r of the HQ; 0 without a fresh scan
local function base_enemies(hq, now, r)
	local m = EliteAI.mech
	if type(m) ~= "table" or type(m.en) ~= "table" or hq == nil or now - (m.last_scan or -1000) > 10 then return 0 end
	local n = 0
	for _, e in ipairs(m.en) do
		if e.x ~= nil and e.z ~= nil and (e.x - hq.x) ^ 2 + (e.z - hq.z) ^ 2 <= r * r then n = n + 1 end
	end
	return n
end
-- 0.16 (mechanics.ai 0.7 Defence): is the spot under a turret the army stays away from this tick (EliteAI.def_block: numbers)
local function def_blocked(pos)
	local b = EliteAI.def_block
	if type(b) ~= "table" or pos == nil or pos.x == nil then return false end
	for _, q in ipairs(b) do if (pos.x - q.x) ^ 2 + (pos.z - q.z) ^ 2 <= q.r * q.r then return true end end
	return false
end
-- 0.16: does the squad build (Elite's construction task: a generator, a power node, a turret)? The engine's functions of the
-- SCAR library, looked up once - a missing one switches the check off, never a call of nil (as mechanics.ai api()):
-- Squad_HasActiveCommand / Squad_GetActiveCommand / SQUADSTATEID_Construction (the polygon's SCAR side reads the same every
-- second for every squad: "POLY ST ... AttackMove->Construction"). The squad exists and has models (the caller checked).
local function builds(sq)
	if EliteAI.api_build == nil then
		EliteAI.api_build = (type(Squad_HasActiveCommand) == "function" and type(Squad_GetActiveCommand) == "function" and type(SQUADSTATEID_Construction) == "number")
		log("api", "Squad_HasActiveCommand", type(Squad_HasActiveCommand), "Squad_GetActiveCommand", type(Squad_GetActiveCommand),
			"SQUADSTATEID_Construction", type(SQUADSTATEID_Construction), "builder check", EliteAI.api_build and 1 or 0)
	end
	if not EliteAI.api_build then return false end
	return Squad_HasActiveCommand(sq) == true and Squad_GetActiveCommand(sq) == SQUADSTATEID_Construction
end

-- Elite's combat tasks would take the squads back: none for a directed AI (snipers, capture etc. stay Elite's)
local Elite_MilitaryExecute = strategy_military.execute
strategy_military.execute = function()
	if EliteAI.director then
		-- 0.13: direct, and only a group that has tasks (Task_CountInGroup: strategy_resourcing.ai:76, strategy_tech_purchase.ai:198).
		-- Elite's execute does not run for a directed AI, so after the first kill the groups stay empty and nothing is called
		if Task_CountInGroup(s_selfplayer, TGROUP_Attack) > 0 then Task_KillGroup(s_selfplayer, TGROUP_Attack) end
		if Task_CountInGroup(s_selfplayer, TGROUP_Defend) > 0 then Task_KillGroup(s_selfplayer, TGROUP_Defend) end
		return
	end
	return Elite_MilitaryExecute()
end

-- 0.13 our HQ: numbers, read once (AIPlayer_GetHomePosition: tactics.ai:508; mechanics.ai keeps the same in EliteAI.mech.home)
local function home_pos()
	local m = EliteAI.mech
	if type(m) == "table" and m.home then return m.home end
	if EliteAI.home == nil then
		local p = AIPlayer_GetHomePosition(s_self_modplayer)
		if p ~= nil and p.x ~= nil and p.z ~= nil then EliteAI.home = { x = p.x, y = p.y, z = p.z } end
	end
	return EliteAI.home
end

-- 0.14 (TECH_RU.md 13) THE REFILL STAY. A squad that went home with a third of its models (RetreatModels) used to be let go
-- by the retreat timer or "back early" - as soon as the purse said no for one tick (s16: "50012 models 1 of 8 -> home to
-- refill", "back early after 6 s at home hp 0.92": one model walked back to the army; the squad was lost 80 s later), or it
-- stood until the 40 s were over while one model came per tick (the polygon's scene b: 33 s, idle_long). Now it has a state of
-- its own (EliteAI.refill[id], numbers): at home it stays while models come or are on their way and leaves when it is full,
-- when it is fit again (above a third) and no model has come for RefillWaitSecs (9 s: the purse holds the req for the unit or
-- has none), under attack, or after RefillMaxSecs (75 s). A squad still down to a third does not walk out to die: it waits for
-- its models until the timeout. Lines: "MECH Refill <id> start models N of M", "MECH Refill <id> models A->B of M" each time
-- models came - the polygon's report (lib/report.py) reads these: a squad that stands at home while they keep coming is being
-- refilled, not idle - and "MECH Refill <id> end models N of M after S s got K why <why>". Refill=0 = as 0.13.
-- 0.15 (TECH_RU.md 14; s17: IG got 3 models in 13 minutes - one batch, and the squad it was ordered for, 6 of 9, was led away
-- as a runner ten seconds later and died with 3; the tyranids' 50008 got 1 of 3 the same way):
--  * a squad at home that models were ordered for stays until they have come - the same stay, entered from the army
--    ("MECH Refill <id> start ... ordered"): it is in nobody's list meanwhile (no runner, no split, no march);
--  * a weak squad (half its models or fewer: RefillModels, the purse's "weak") goes home to refill when nobody of the army
--    is in a fight ("... -> home to refill (quiet)") - a third (RetreatModels) goes at once as before. Only when the purse
--    would pay RefillTripModels (2) models now, the HQ is within RefillTripD (160 m), and no more than a third of the army
--    is away refilling; once per loss. RefillQuiet=0 = off;
--  * a fight at home (a squad of the army there is under attack) ends every stay: "why fight at home".
-- 0.16 (TECH_RU.md 15.5; the verification of newai-13):
--  * a squad that builds is Elite's (see builds above): it is not in the army at all, no stay is begun or kept for it
--    (scene b: "Refill 50010 start ... ordered" and "AttackMove->Construction" in the same second, 27 s, got 0);
--  * a stay "ordered" that brought no model within RefillOrderedSecs (15 s, counted from the moment the squad stands) ends -
--    "why nothing came" - and so does one whose purse says "mute" (REINF dir no effect); the squad is not held by "ordered"
--    again for RefillBanSecs (90 s) (s18: 50023, 2 of 3, stood 24 s for nothing); the squad walks up to the HQ first (to_hq);
--  * the quiet trip is a plain move, not a retreat (a retreat cannot be called off), and is not begun while an enemy squad
--    stands within RefillBaseR (70 m) of the HQ; on its way it ends when the squad is hit or the enemy comes to the base -
--    "why attacked on the way" / "why enemy at home" (s18 5:44: "-> home to refill (quiet)" 11 s after "enemy_at_base 675",
--    the squad ran into them: "end ... got 0 why under attack", 3 models ordered for nothing). RefillQuietMove=0 = a retreat.
local function refill_step(u, f, now)
	local why = nil
	if not u.home then
		if f.home_t then why = "left home"
		elseif now - f.t >= num("RefillWalkSecs", 45) then why = "did not get home"
		elseif f.why == "quiet" and f.walk then
			if u.hit then why = "attacked on the way"
			elseif (EliteAI.base_en or 0) > 0 then why = "enemy at home" end
		end
	else
		if not f.home_t then
			f.home_t, f.prog, f.n, f.got = now, now, u.n, 0
			if f.why then log("MECH", "Refill", u.id, "start", "models", u.n, "of", u.full, f.why)
			else log("MECH", "Refill", u.id, "start", "models", u.n, "of", u.full) end
		end
		if u.n > f.n then
			log("MECH", "Refill", u.id, "models", f.n .. "->" .. u.n, "of", u.full)
			f.prog, f.got = now, f.got + (u.n - f.n)
		end
		f.n = u.n
		if u.moving or f.stand_t == nil then f.stand_t = now end                -- 0.16: the clock of "nothing came" starts when it stands
		local fit = (u.n > u.full * num("RetreatModels", 0.34))
		if u.hit then why = "under attack"
		elseif EliteAI.home_hit then why = "fight at home"
		elseif u.full > 0 and u.n >= u.full then why = "full"
		elseif now - f.home_t >= num("RefillMaxSecs", 75) then why = "timeout"
		elseif f.why == "ordered" and u.refill_why == "mute" then why = "purse mute"                          -- 0.16: REINF dir no effect
		elseif f.why == "ordered" and f.got == 0 and now - f.stand_t >= num("RefillOrderedSecs", 15) then why = "nothing came"
		elseif fit and not u.refill and now - f.prog >= num("RefillWaitSecs", 9) then why = "enough, purse " .. tostring(u.refill_why or "-")
		end
		if (why == "purse mute" or why == "nothing came") then EliteAI.refill_ban[u.id] = now + num("RefillBanSecs", 90) end
	end
	if why then
		EliteAI.refills = (EliteAI.refills or 0) + 1
		log("MECH", "Refill", u.id, "end", "models", u.n, "of", u.full, "after", math.floor(now - (f.home_t or f.t)), "s", "got", f.got or 0, "why", why)
	end
	return why
end

function EliteAI_Director()
	if not EliteAI.director then return end
	local now = World_GetGameTime()
	local army, n = {}, Military_SquadTotalCount(s_selfplayer)
	local hq, home_r = home_pos(), num("Reinf_HomeR", 40)
	local any_hit, home_hit = false, false
	local wm, stand_d = num("RefillModels", 0.5), num("RefillStandD", 3)
	local bfree, rhp, nbuild = (num("BuilderFree", 1) >= 1), num("RetreatHP", 0.35), 0
	EliteAI.build_said = EliteAI.build_said or {}
	-- 0.22: the squads in the engine's capture tasks, for mechanics.ai's watch (numbers and this tick's squad, as the army's entries)
	local capw, caps = (num("Mech_CapWatch", (EliteAI.base == "vanilla") and 1 or 0) >= 1), {}
	local lostL = (num("LostLog", 1) >= 1) and (EliteAI.last or {}) or nil     -- 0.23: the last look at every squad (numbers by squad id)
	for i = 0, n - 1 do
		-- 0.8: an engine call that raises a Lua error inside the AI job leaks the Lua mutex (LuaBinding::GetMutex) on
		-- the xthread worker -> the main thread waits forever (hang). Seen: AISquad_ConvertToSimSquad -> nil for a squad
		-- that is not spawned (dead/in reinforcement) and Squad_GetHealth(nil) raised. Check everything BEFORE the call.
		-- 0.13: the pcall around this scan is gone (it caught the error, the mutex leaked all the same): the squad exists, is
		-- spawned and has models before anything is read from it; an entry without an id or a position is not taken
		local aisq = Military_GetAISquadAtIndex(s_selfplayer, i)
		local incap = (aisq ~= nil) and AISquad_InCaptureTask(aisq)
		if aisq ~= nil and incap and capw then
			-- 0.22: in a capture task - not the army's, but watched (the same calls in the same order, every one after its check)
			local sq = AISquad_ConvertToSimSquad(aisq)
			if sq ~= nil and Squad_Count(sq) > 0 then
				local id, pos = Squad_GetGameID(sq), Squad_GetPosition(sq)
				if id ~= nil and pos ~= nil and pos.x ~= nil and pos.z ~= nil then
					local c = { sq = sq, id = id, pos = pos, hp = Squad_GetHealth(sq) / math.max(Squad_GetHealthMax(sq) or 1, 1),
						hit = Squad_IsUnderAttack(sq, 3), n = Squad_Count(sq), full = 0 }
					c.veh = (SquadQuery_IsVehicle(sq) == true)
					if EliteAI_ReinforceFull then c.full = EliteAI_ReinforceFull(aisq) or 0 end
					if hq ~= nil then c.dhome = math.sqrt((pos.x - hq.x) ^ 2 + (pos.z - hq.z) ^ 2) end
					table.insert(caps, c)
				end
			end
		end
		if aisq ~= nil and not incap then
			local sq = AISquad_ConvertToSimSquad(aisq)
			if sq ~= nil and Squad_Count(sq) > 0 then
				local id, pos = Squad_GetGameID(sq), Squad_GetPosition(sq)
				local hp = Squad_GetHealth(sq) / math.max(Squad_GetHealthMax(sq) or 1, 1)
				local hit = Squad_IsUnderAttack(sq, 3)
				-- 0.16: a squad that builds is left to Elite's construction task, as one in a capture task (the director led the
				-- builders away: "ENERGY gen hold dead", "TECH build hold dead" - nobody builds it). One that is badly hurt
				-- under fire is the director's all the same (it goes home below)
				if id ~= nil and bfree and builds(sq) and not (hit and hp < rhp) then
					nbuild = nbuild + 1
					if lostL and pos ~= nil and pos.x ~= nil and pos.z ~= nil then          -- 0.23
						lostL[id] = { t = now, role = "build", x = pos.x, z = pos.z, hp = hp, n = -1, full = 0, hit = hit and 1 or 0, veh = 0, dh = -1 }
					end
					local bs = EliteAI.build_said[id]
					if bs == nil or now - bs >= 60 then
						EliteAI.build_said[id] = now
						log("MECH", "Builder", id, "builds: left to its task", "hp", string.format("%.2f", hp))
					end
				elseif id ~= nil and pos ~= nil and pos.x ~= nil and pos.z ~= nil then
					local u = { sq = sq, id = id, pos = pos, hp = hp, hit = hit, n = Squad_Count(sq), full = 0 }
					local ln = EliteAI.lossn[id]                                   -- 0.19: the models it lost since the last look
					if ln ~= nil and u.n < ln then
						local L = EliteAI.loss[id] or {}
						table.insert(L, { t = now, k = ln - u.n })
						EliteAI.loss[id] = L
					end
					EliteAI.lossn[id] = u.n
					u.veh = (SquadQuery_IsVehicle(sq) == true)                    -- 0.16 (tactics.ai; mechanics.ai weight_of reads the same)
					if EliteAI_ReinforceFull then u.full = EliteAI_ReinforceFull(aisq) or 0 end   -- models of a complete squad of its kind
					-- 0.13 (TECH_RU.md 12): a squad of the director's army never asked for reinforcements - the engine's list is filled
					-- by Elite's squad tasks, which do not run for it. At home (Reinf_HomeR of our HQ) a squad that misses models gets
					-- one reinforce order per tick through the SCAR side (mode 6); strategy_unit_purchase.ai (EliteAI_ReinforceDir)
					-- is the purse and the count. u.refill = models are on their way: the squad is not sent out yet.
					if hq ~= nil then u.dhome = math.sqrt((pos.x - hq.x) ^ 2 + (pos.z - hq.z) ^ 2) end
					if u.dhome ~= nil and u.dhome <= home_r then
						u.home = true
						if _order and EliteAI_ReinforceDir then
							-- 0.14: k models at once when the purse pays them (x of the order = how many; elite.scar repeats the command)
							-- 0.15: "moving" - it is not standing yet (EliteAI.sqpos still holds the positions of the last tick): the purse
							-- does not count a model as lost before the squad has arrived
							local was = EliteAI.sqpos[id]
							local moving = (was == nil) or (math.sqrt((pos.x - was.x) ^ 2 + (pos.z - was.z) ^ 2) > stand_d)
							u.moving = moving
							local k, busy, why = EliteAI_ReinforceDir(aisq, id, u.n, now, moving)
							if type(k) == "number" and k >= 1 then
								_order(id, k, 0, 0, 6); EliteAI.reinf_orders = (EliteAI.reinf_orders or 0) + k
								u.ordered = k
							end
							u.refill, u.refill_why = busy and true or false, why
						end
						if u.hit then home_hit = true end
					elseif EliteAI_ReinforceCan and u.full >= 3 and u.n <= u.full * wm then
						u.can = EliteAI_ReinforceCan(aisq, u.n, id) or 0              -- 0.15: would the purse pay it now (the quiet refill trip; 0.19: up to its goal)
					end
					if u.hit then any_hit = true end
					table.insert(army, u)
				end
			end
		end
	end
	EliteAI.dir_squads, EliteAI.builders, EliteAI.caps_n = table.getn(army), nbuild, (capw and table.getn(caps) or -1)
	if lostL then                                                               -- 0.23: for the "LOST" line of EliteAI_Sample
		for _, u in ipairs(army) do
			lostL[u.id] = { t = now, role = "army", x = u.pos.x, z = u.pos.z, hp = u.hp, n = u.n, full = u.full, hit = u.hit and 1 or 0, veh = u.veh and 1 or 0, dh = u.dhome or -1 }
		end
		for _, c in ipairs(caps) do
			lostL[c.id] = { t = now, role = "cap", x = c.pos.x, z = c.pos.z, hp = c.hp, n = c.n, full = c.full, hit = c.hit and 1 or 0, veh = c.veh and 1 or 0, dh = c.dhome or -1 }
		end
		for id, r in pairs(lostL) do if now - r.t > num("LostKeepSecs", 240) then lostL[id] = nil end end   -- (each entry on its own)
		EliteAI.last = lostL
	end
	EliteAI.base_en = base_enemies(hq, now, num("RefillBaseR", 70))             -- 0.16: enemy squads at our base (the quiet trip)
	-- 0.12: the order book reads the time and the positions of this tick (numbers only)
	EliteAI.now, EliteAI.sqpos = now, {}
	for _, u in ipairs(army) do EliteAI.sqpos[u.id] = { x = u.pos.x, y = u.pos.y, z = u.pos.z } end
	for id, r in pairs(EliteAI.ord) do if now - r.t > 120 then EliteAI.ord[id] = nil end end   -- squads that are gone (each entry on its own)
	local lkeep = num("LossKeepSecs", 300)
	for id, L in pairs(EliteAI.loss) do                                         -- 0.19: old falls (each entry on its own)
		local keep = {}
		for _, e in ipairs(L) do if now - e.t <= lkeep then table.insert(keep, e) end end
		if table.getn(keep) == 0 then EliteAI.loss[id], EliteAI.lossn[id] = nil, nil else EliteAI.loss[id] = keep end
	end
	EliteAI.home_hit, EliteAI.any_hit = home_hit, any_hit                       -- (0.18: any_hit for the builder wait of the order book)
	-- 0.15: the stays of squads that are gone (dead, or taken by Elite's capture task) end; how many of the army are away refilling
	local in_army, away = {}, 0
	for _, u in ipairs(army) do in_army[u.id] = true end
	for id in pairs(EliteAI.refill) do if in_army[id] then away = away + 1 else EliteAI.refill[id] = nil end end   -- (each entry on its own)
	for id, t in pairs(EliteAI.refill_ban) do if now >= t then EliteAI.refill_ban[id] = nil end end              -- (each entry on its own)
	local away_max = math.max(1, math.floor(table.getn(army) / 3))
	-- "quiet": nobody of the army is under attack and the mechanics saw no enemy in contact for RefillQuietSecs
	local mech_c = (type(EliteAI.mech) == "table") and EliteAI.mech.army_contact or nil
	local quiet = (not any_hit) and (mech_c == nil or now - mech_c >= num("RefillQuietSecs", 9)) and num("RefillQuiet", 1) >= 1
	-- badly hurt squads go home (once; they come back to the army after RetreatSecs)
	local active = {}
	local rm, stay = num("RetreatModels", 0.34), (num("Refill", 1) >= 1)
	local vehs_on = (EliteAI_Mechanics ~= nil and tonumber(cfg("Mech_Vehicles", nil) or 1) >= 1)
	for _, u in ipairs(army) do
		local r = EliteAI.retreating[u.id]
		local f = EliteAI.refill[u.id]
		local thin = (rm > 0 and u.full >= 3 and u.n <= u.full * rm)          -- down to a third of its models
		if f then
			-- 0.14: it went home to be refilled - it stays there while the models come (refill_step: why it leaves, or nil)
			if refill_step(u, f, now) then
				EliteAI.refill[u.id], EliteAI.retreating[u.id] = nil, nil
				table.insert(active, u)
			elseif f.walk and not u.home and hq ~= nil then
				order(u, hq, ORD_MOVE, true)                                     -- 0.16: the quiet trip is a plain move (the book repeats it when due)
			end
		elseif r and now - r < num("RetreatSecs", 40) then
			-- still on the way / healing
			if stay and thin and u.home and not u.hit then
				-- 0.14: sent home by its health, it arrives with a third of its models - the refill stay, not the timer
				EliteAI.weak_n[u.id] = u.n
				EliteAI.refill[u.id] = { t = now }
			-- 0.13 (the polygon's scene b: the hero stood at the base for 34 s after its retreat, healthy, until the 40 s were
			-- over): back to the army before the timer once it is home, healthy again (RetreatBackHP) and has no model on its way
			elseif u.home and not u.refill and u.hp >= num("RetreatBackHP", 0.9) and now - r >= num("RetreatMinSecs", 6) then
				EliteAI.retreating[u.id] = nil; table.insert(active, u)
				EliteAI.back_early = (EliteAI.back_early or 0) + 1
				log("MECH", "Retreat", u.id, "back early after", math.floor(now - r), "s at home hp", string.format("%.2f", u.hp))
			end
		elseif u.veh and vehs_on then
			-- 0.16 (TECH_RU.md 15.8): a vehicle has no retreat - the order did nothing and the vehicle then stood 40 s without any
			-- (it was "on its way home"). It stays the army's: mechanics.ai (Vehicles) takes a damaged one out of the fire
			EliteAI.retreating[u.id] = nil; table.insert(active, u)
		elseif u.hp < num("RetreatHP", 0.35) then
			EliteAI.retreating[u.id] = now; order(u, u.pos, ORD_RETREAT, true)
		elseif thin and u.n < (EliteAI.weak_n[u.id] or 9999) and not (u.home and (u.hit or not stay)) then
			-- 0.13: the same threshold by models - a squad down to a third of its models goes home to be refilled whatever the
			-- health of the models left (the health share above is of the squad's health as the engine counts it). Once per
			-- loss: it does not go again until it has lost another model (no walking to and fro when it could not be refilled).
			-- 0.14: one that is at home already (it came with the army, or was built there) stays without a retreat order
			EliteAI.weak_n[u.id] = u.n
			if not u.home then
				EliteAI.retreating[u.id] = now; order(u, u.pos, ORD_RETREAT, true)
				log("MECH", "Retreat", u.id, "models", u.n, "of", u.full, "-> home to refill")
			end
			if stay then EliteAI.refill[u.id] = { t = now }; away = away + 1 elseif u.home then table.insert(active, u) end
		elseif stay and u.home and (u.ordered or 0) >= 1 and not u.hit and not home_hit and now >= (EliteAI.refill_ban[u.id] or 0) then
			-- 0.15: models were ordered for it this tick - it stays at home until they have come (refill_step lets it go: full,
			-- nothing more to come, a fight, the timeout). Was: it marched off with the army, the models were lost
			-- 0.16: not a squad whose models did not come the last time (refill_ban); it walks up to the HQ (to_hq)
			EliteAI.retreating[u.id] = nil
			EliteAI.refill[u.id] = { t = now, why = "ordered", home_t = now, prog = now, n = u.n, got = 0 }
			log("MECH", "Refill", u.id, "start", "models", u.n, "of", u.full, "ordered")
			to_hq(u, hq, num("RefillNearD", 18))
		elseif stay and quiet and not u.home and u.full >= 3 and u.n <= u.full * wm and u.n < (EliteAI.weak_n[u.id] or 9999)
			and (u.can or 0) >= num("RefillTripModels", 2) and away < away_max and (u.dhome or 99999) <= num("RefillTripD", 160)
			and (EliteAI.base_en or 0) == 0 then
			-- 0.15: weak (half its models or fewer) and nobody fights - home to refill, once per loss
			-- 0.16: not while the enemy is at our base, and by a plain move it can be called off on the way (refill_step)
			EliteAI.weak_n[u.id] = u.n
			local walk = (num("RefillQuietMove", 1) >= 1 and hq ~= nil)
			EliteAI.retreating[u.id] = now
			if walk then order(u, hq, ORD_MOVE, true) else order(u, u.pos, ORD_RETREAT, true) end
			EliteAI.refill[u.id] = { t = now, why = "quiet", walk = walk }; away = away + 1
			log("MECH", "Retreat", u.id, "models", u.n, "of", u.full, "-> home to refill (quiet)", "purse", u.can, "home", math.floor(u.dhome or -1), "m")
		else
			-- (0.15: "once per loss" holds up to the weak threshold - a squad back from a trip that brought nothing does not go again)
			if u.full > 0 and u.n > u.full * math.max(rm, (num("RefillQuiet", 1) >= 1) and wm or 0) then EliteAI.weak_n[u.id] = nil end
			EliteAI.retreating[u.id] = nil; table.insert(active, u)
		end
	end
	-- mechanics.ai (10.11): true = it ordered the army this tick; it also drops the squads it ordered from `active`
	if EliteAI_Mechanics and EliteAI_Mechanics({ now = now, army = army, active = active, caps = caps }) then return end
	if table.getn(active) == 0 then return end
	-- 1) a fight is on: everybody goes there (help, don't trickle)
	for _, u in ipairs(active) do
		if u.hit and not def_blocked(u.pos) then                 -- (0.16: a squad shot under a turret the army stays away from does not call it there)
			-- (0.12: the order book repeats it to a squad only when the fight has moved or after OrderMoveSecs)
			for _, v in ipairs(active) do order(v, u.pos, ORD_ATTACK, true) end
			EliteAI.phase = "fight"; return
		end
	end
	-- 2) no fight: the target, as one army
	local target, tkey = EliteAI.best_pos, EliteAI.best_key      -- {x, y, z}: dist() and order() read only the fields
	-- 0.11: the goal of mechanics.ai first while it is fresh (numbers only: { x, y, z, key, kind, t }) - the next point for an
	-- army that stood at its target, the building of the Garrison pattern, the hold spot in front of it
	local goal = EliteAI.goal
	if goal and goal.x and goal.z and now - (goal.t or -1000) <= num("Mech_GoalSecs", 60) then
		target, tkey = goal, "goal " .. tostring(goal.kind) .. " " .. tostring(goal.key)
	end
	if not target then return end
	if def_blocked(target) then EliteAI.phase = "def_hold"; return end         -- 0.16: the target is under such a turret - nobody is marched in (mechanics.ai gives the goal)
	-- 0.18 (mechanics.ai 1.1 Map; Orca's log, fb 544: "Goal end point 18/105 ..." and in the same tick "Order ... -> move to -96 -98
	-- by dir" - the enemy's base): Elite's own target inside the zone of a turret that nobody storms is not marched at either.
	-- The goal of mechanics.ai ended after its Defence pass of this tick; the next pass gives the next goal
	if target == EliteAI.best_pos and EliteAI_MechClosed and EliteAI_MechClosed(target.x, target.z) then EliteAI.phase = "def_hold"; return end
	local cx, cz = 0, 0
	for _, u in ipairs(active) do cx = cx + u.pos.x; cz = cz + u.pos.z end
	cx, cz = cx / table.getn(active), cz / table.getn(active)
	local spread = 0
	for _, u in ipairs(active) do spread = spread + math.sqrt((u.pos.x - cx) ^ 2 + (u.pos.z - cz) ^ 2) end
	spread = spread / table.getn(active)
	local gr = num("GatherR", 30)
	if spread > gr then                                          -- gather on the squad that is closest to the target
		local lead = active[1]
		-- 0.20 (TECH_RU.md 21.4; "it does not gather its army, it comes in single squads"): while an enemy force waits at the target
		-- or on the way (mechanics.ai X.run_engage: EliteAI.eng.threat of this tick) the army gathers on its MIDDLE squad - the one
		-- nearest to the centre - not on the one nearest to the enemy, which then stood there alone. GatherRear=0 = as before
		local eg = EliteAI.eng
		local rear = (type(eg) == "table" and eg.t == now and eg.threat == true and num("GatherRear", 1) >= 1)
		local cpos = { x = cx, z = cz }
		for _, u in ipairs(active) do
			if rear then
				if dist(u.pos, cpos) < dist(lead.pos, cpos) then lead = u end
			elseif dist(u.pos, target) < dist(lead.pos, target) then lead = u end
		end
		if rear then EliteAI.gather_rear = (EliteAI.gather_rear or 0) + 1 end
		for _, u in ipairs(active) do if u ~= lead and dist(u.pos, lead.pos) > gr * 0.6 then order(u, lead.pos, ORD_MOVE) end end
		EliteAI.phase = "gather"
	else
		-- 0.12: every tick, per squad - the order book lets it through when the target is new for that squad or OrderMoveSecs
		-- (12 s, the old period of the whole army) have passed since its last order there
		for _, u in ipairs(active) do order(u, target, ORD_ATTACK) end
		if EliteAI.phase ~= "attack" or EliteAI.attack_mp ~= tkey then EliteAI.attack_t = now end
		EliteAI.phase, EliteAI.attack_mp = "attack", tkey
	end
end

--------------------------------------------------------------------------------------------------
-- telemetry: what this AI has and does, every 30 s of game time (A/B comparison, reading a match without video)
local function gametime()
	local t = World_GetGameTime()                                    -- 0.13: direct, as everywhere else in these scripts
	if t then return math.floor(t) end
	return -1
end

-- losses, counted every 5 s: models that left a squad (killed; reinforcements only add) and whole squads that are gone
EliteAI.seen, EliteAI.models_lost, EliteAI.squads_lost, EliteAI.engaged = {}, 0, 0, 0
EliteAI.gone, EliteAI.squads_back = {}, 0                           -- 0.23: the ids counted as lost (the time, the models) and those that came back
-- 0.23: one line per squad that is gone, with what the director read at its last look (numbers and strings only)
local function lost_line(id, n)
	local t = World_GetGameTime() or -1
	EliteAI.gone[id] = { t = t, n = n }
	if num("LostLog", 1) < 1 then return end
	local m = EliteAI.mech
	local nm = (type(m) == "table" and type(m.names) == "table" and m.names[id]) or "?"
	if nm == "" then nm = "?" end
	local r = EliteAI.last and EliteAI.last[id]
	if r == nil then
		log("LOST", id, nm, "t", math.floor(t), "role", "?", "models", n, "phase", EliteAI.phase or "-")
		return
	end
	log("LOST", id, nm, "t", math.floor(t), "role", r.role, "models", n, "of", r.full or 0, "hp", string.format("%.2f", r.hp or -1), "hit", r.hit or 0, "veh", r.veh or 0,
		"at", string.format("%.0f %.0f", r.x or 0, r.z or 0), "home", string.format("%.0f", r.dh or -1), "m", "seen", string.format("%.0f", t - (r.t or t)), "s ago",
		"phase", EliteAI.phase or "-", "retreat", (EliteAI.retreating and EliteAI.retreating[id]) and 1 or 0, "refill", (EliteAI.refill and EliteAI.refill[id]) and 1 or 0)
	EliteAI.last[id] = nil
end
function EliteAI_Sample()
	-- 0.13: no pcall around the scan (TECH_RU.md 12): the group and every squad are checked before they are read; a squad
	-- without models is counted and nothing else is asked of it (no position, no "under attack")
	local sg = Player_GetSquads(s_self_modplayer)
	if sg == nil then return end
	local now, engaged = {}, 0
	local xs, zs, n2 = {}, {}, 0
	for i = 1, (SGroup_CountSpawned(sg) or 0) do
		local sq = SGroup_GetSpawnedSquadAt(sg, i)
		if sq ~= nil then
			local id, n = Squad_GetGameID(sq), Squad_Count(sq) or 0
			if id ~= nil then
				now[id] = n
				local before = EliteAI.seen[id]
				if before and n < before then EliteAI.models_lost = EliteAI.models_lost + (before - n) end
				if n > 0 then
					if Squad_IsUnderAttack(sq, 5) then engaged = engaged + 1 end
					local pos = Squad_GetPosition(sq)
					if pos ~= nil and pos.x ~= nil and pos.z ~= nil then n2 = n2 + 1; xs[n2] = pos.x; zs[n2] = pos.z end
				end
			end
		end
	end
	for id, n in pairs(EliteAI.seen) do
		if now[id] == nil then
			EliteAI.squads_lost = EliteAI.squads_lost + 1; EliteAI.models_lost = EliteAI.models_lost + n
			lost_line(id, n)                                                  -- 0.23: which, where, in what state
		end
	end
	-- 0.23: an id counted as lost that is here again was not a loss (out of a transport / a building)
	for id, n in pairs(now) do
		local g = EliteAI.gone[id]
		if g ~= nil then
			EliteAI.gone[id] = nil
			EliteAI.squads_back = EliteAI.squads_back + 1
			if num("LostLog", 1) >= 1 then
				log("BACK", id, "t", math.floor(World_GetGameTime() or -1), "after", string.format("%.0f", (World_GetGameTime() or 0) - g.t), "s", "models", g.n, "->", n)
			end
		end
	end
	EliteAI.seen, EliteAI.engaged = now, engaged
	-- army spread: mean distance of squads to their centre (a fist = small), averaged over the samples
	if n2 >= 2 then
		local cx, cz = 0, 0
		for i = 1, n2 do cx = cx + xs[i]; cz = cz + zs[i] end
		cx, cz = cx / n2, cz / n2
		local d = 0
		for i = 1, n2 do d = d + math.sqrt((xs[i] - cx) ^ 2 + (zs[i] - cz) ^ 2) end
		EliteAI.spread_sum = (EliteAI.spread_sum or 0) + d / n2; EliteAI.spread_n = (EliteAI.spread_n or 0) + 1
	end
end

function EliteAI_Telemetry()
	local c = cache or {}
	local att = Task_CountCombat(s_selfplayer, COMBAT_Attack)         -- 0.13: direct, as Elite's strategy_military.ai:98-99
	local def = Task_CountCombat(s_selfplayer, COMBAT_Defend)
	local side = EliteAI.on and "new" or "elite"
	if EliteAI.base == "vanilla" then side = EliteAI.on and "vanilla_ours" or "vanilla" end
	local r, rr = c.resources or {}, c.resources_rate or {}
	local gens = -1                                                   -- (a count of our generators: strategy_resourcing.ai, UtilPBG_CountTotal)
	local rs = s_personality and s_personality.resource_structures
	if rs and rs[1] and rs[1].pbg then gens = UtilPBG_CountTotal(rs[1].pbg) end
	local function f(x) if type(x) == "number" then return math.floor(x) end; return -1 end
	log("T", gametime(), side,
		"mil", math.floor(c.military_value or -1), "lost", EliteAI.models_lost, "squads_lost", EliteAI.squads_lost, "engaged", EliteAI.engaged,
		"spread", math.floor((EliteAI.spread_sum or 0) / math.max(EliteAI.spread_n or 0, 1)),
		"squads", c.military_count or -1, "pop", c.current_population_personnel or -1, "pts", c.total_pts_owned or -1,
		"vp", c.self_vp_tickers or -1, "vp_enemy", c.enemy_vp_tickers or -1,
		"rc", EliteAI.rc, "dir", EliteAI.dir_squads, "orders", EliteAI.orders, "phase", EliteAI.phase or "-", "att", att or -1, "def", def or -1, "aggr", EliteAI.aggression or -1,
		"attpct", string.format("%.2f", (state_analysis and state_analysis.military_attackPercentage) or -1),
		"race", tostring(s_current_race), "popmax", f(c.max_population_personnel), "tier", f(c.tech_tier_level), "gens", f(gens),
		"req", f(r.requisition), "pow", f(r.power), "reqr", f(rr.requisition), "powr", f(rr.power),
		"caps", EliteAI.caps_n or -1, "builders", EliteAI.builders or -1, "squads_back", EliteAI.squads_back or 0)
end

local Elite_InitializeAI = InitializeAI
function InitializeAI()
	Elite_InitializeAI()
	log("init", "race", tostring(s_current_race), "difficulty", tostring(s_diffLevel), "team", tostring(s_self_team),
		"logic", EliteAI.on and "new" or "elite", "eliteai", EliteAI.version, "base", EliteAI.base)
	-- what the AI environment can do directly (for a combat director that orders squads itself)
	local avail = {}
	for _, n in ipairs({ "Command_SquadPos", "Command_SquadAttackMovePos", "Command_Squad", "Military_GetAISquadAtIndex",
			"AISquad_ConvertToSimSquad", "AISquad_InCombatTask", "Military_SquadTotalCount", "Military_GetMilitaryPointPosition",
			"SCMD_Move", "SCMD_AttackMove", "SCMD_Retreat", "Squad_GetPosition", "Squad_GetHealth", "World_GetPlayerAt" }) do
		table.insert(avail, n .. "=" .. type(getfenv(1)[n]))
	end
	log("api", table.concat(avail, " "))
	if EliteAI.on then
		log("variant", EliteAI.variant, EliteAI.vp.name, "real_diff", tostring(EliteAI.real_diff))
		-- the SCAR side shows it to the player: a pseudo-order, id = player id, x = variant 1..3, mode 9
		if _order then _order(s_selfplayerid or 0, string.byte(EliteAI.variant) - 64, 0, 0, 9) end   -- (a DLL function: five numbers into its queue)
	end
	TimeRule_AddInterval(EliteAI_Sample, 5, 0)
	if EliteAI.director then TimeRule_AddInterval(EliteAI_Director, num("DirectorSecs", 3), 0) end
	TimeRule_AddInterval(EliteAI_Telemetry, 30, 0)
end

-- ===== EliteAI mechanics.ai =====
-- EliteAI mechanics.ai: combat mechanics of the director + the conflict arbiters that make variants A/B/C differ.
-- (10.11, the owner) The variants are NOT difficulty or temperament: every mechanic is ON in every variant, the goal is one
-- good player. A, B, C differ ONLY where the logic hits a genuine conflict of decisions (hold cover or kite from melee,
-- focus a target or stay put under fire, chase or regroup, split to capture or keep the army ...): every such place is an
-- arbiter function with a rule picked by EliteAI.num("Conf_<Name>", <variant index A=1 B=2 C=3>), hysteresis (a decision
-- holds for Mech_ConfHold seconds) and a log line on every switch: "MECH Conf_<Name> <subject> X->Y <reason>".
-- Mechanics: FocusFire, ArmyRetreat, PunishTurn, PreRetreat, MeleeTie, Repair, RaceAbilities, ArmyRoles - each behind
-- EliteAI.num("Mech_<Name>", 1) read from EliteAI.ini [Lua] (1 = on; the variant tables of main.ai do not switch mechanics).
--
-- LOADING: the AI environment has no dofile/include (import() reads only files that exist inside Elite's archives), so this
-- text is appended to main.ai: EliteAI.dll reads Elite_DLLs\EliteAI\mechanics.ai and puts it right after main.ai in the
-- default.ai chunk (dll/eliteai.c); without a rebuilt DLL: cat mod/main.ai mod/mechanics.ai > Elite_DLLs\EliteAI\main.ai.
-- The file uses only globals (EliteAI.*, engine API), nothing local to main.ai, so it works as part of the main.ai chunk
-- and as a separate chunk alike. Orders go through the DLL queue (eliteai_order) to elite.scar; modes added there:
-- 4 = attack a squad, 5 = capture the point at a position, 100+k = ability k at a position, 200+k = ability k on a squad
-- (k: ABIL below = EliteAI_MECH_ABILITIES in elite.scar); 0.7: 7 = attack the enemy building nearest to a position (a turret).
--
-- CALL: EliteAI_Mechanics(state) from EliteAI_Director (main.ai) after the hurt squads were sent home and before the
-- director's own orders; state = { now, army, active }: the director's lists of { sq, id, pos = {x,y,z}, hp (0..1), hit }
-- (sq is valid for this tick only). Returns true when the mechanics ordered the army this tick (the director then issues
-- nothing); otherwise false, having removed from state.active the squads it ordered.
--
-- SAFETY (from real hangs/crashes - HANDOFF steps 3-4, 0.7 R6025): no engine object is kept between ticks (numeric ids and
-- {x,y,z} only); every engine call on a squad is preceded by "squad exists and has models"; no pcall around engine calls
-- (an error inside leaks the Lua mutex -> hang); deterministic decisions only (engine time/data, no os.time/math.random);
-- the enemy and the points are scanned once per director tick (3 s), names of own squads are fetched once per squad id.
--
-- 0.3 (11.11, the scene polygon - reports/polygon_1111, TECH_RU.md section 10):
--  * Idle: a squad that stands without an order out of a fight (did not move, was not hit, did not fire for Mech_IdleSecs)
--    goes back to the army / to the director's target; a runner or split squad found idle loses the role (a carnifex was
--    made a runner and stood with a capture order it cannot execute); only squads that can capture (PBG_CanCapture) get
--    capture roles; an army standing at its target gets the next goal (EliteAI.goal, read by the director in main.ai).
--  * Garrison: an enemy squad inside a building (Squad_IsInHoldEntity) next to our point / target / base is a pattern of
--    its own: the arbiter Conf_Garrison (A/B/C) says assault (the army concentrates on the building: grenades, flamers and
--    vehicles on it, melee squads wait at the exit), hold (stay out of its range between it and our base for a short
--    while) or bypass (go on with other targets); EliteAI.gar tells the purchase scripts to raise the demand of the
--    counter units of reports/tactics_kb/kb.yaml (threats.garrisoned_enemy) while it lasts.

-- 0.4 (11.11, the verification of newai-10 - TECH_RU.md 10.10 / 11):
--  * every order goes through the order book of main.ai (EliteAI_OrderGate): no repeat while the squad is on its way, a plain
--    move when an attack-move had no effect, a ceiling per squad, and the director waits after an order of the Idle logic.
--  * Garrison: found also while the director has no squad of its own (every squad in a capture task: scene b3, 44 s late) -
--    then "the army" is at our HQ; a grenade squad farther than GarGrenR walks up to throw (b2: the devils stood 37 m off,
--    no grenade in 120 s); a squad that is a tool against the garrison is no runner while the garrison is stormed or held.

-- 0.6 (11.11, the verification of newai-12 and Orca's match against a human - TECH_RU.md 13.10 / 14):
--  * RaceAbilities: a call-in (a global that brings squads for req) is a unit bought through another channel - it goes when it
--    gives more than the plan's unit for the same money (a fight, a raid at our base, a bargain), the save state holds nothing
--    by itself, no hold lasts for ever; a targeted ability without a target and the squad-targeted buffs are no candidates.
--  * ArmyRoles: the runner is not sent to die - no runner for a small army (Conf_RunnerArmy), no hero after the opening, no
--    target where the enemy is, just was or stands next to the way, a target a runner was lost at is closed, our lost points
--    near the army first.

-- 0.7 (11.11, the verification of newai-13 and Orca's fb 511 - TECH_RU.md 15):
--  * RaceAbilities: the call-in or the unit is decided before the unit is bought (EliteAI_MechCallInFirst, asked by the units budget).
--  * Defence: the enemy's turrets - not entered without the odds, taken down by vehicles / armour-piercing / artillery, what
--    failed is remembered. Vehicles: with the army, a damaged one out of the fire (a vehicle has no retreat). Setup: enemy
--    heavy-weapon teams are the first focus target, get a grenade / a jump / a squad from the side; the purchase scripts
--    are told to buy the race's answers.

-- 1.5 (12.11, step 4 of the vanilla base - VANILLA_BASE_RU.md 14.3): a vehicle in the retreat of the whole army gets a plain move to
-- our HQ instead of the retreat order it cannot execute (retreat_order; Mech_RetreatVeh: 1 on the vanilla base, 0 on the Elite base).
EliteAI_MECH_VERSION = "1.5"

-- every tunable (EliteAI.ini [Lua] Mech_<Key> overrides); metres and seconds of game time; "strength" = health points
-- (a squad ~ 300-900, a tank ~ 1500+), vehicles weighted by VehW
local MP = {
	-- shared
	ZoneR = 45,          -- the fight zone: enemies within this distance of the army centre
	SightR = 30,         -- an enemy is "in contact" when it is under attack or within SightR of one of our squads
	HomeR = 40,          -- within this distance of our HQ the army never retreats (it fights at home)
	VehW = 1.3,          -- weight of a vehicle's health in strength sums
	ScanSecs = 0,        -- rescan the enemy at most this often (0 = every director tick)
	StatsSecs = 60,      -- period of the "MECH stats" log line
	ConfHold = 6,        -- a conflict decision holds at least this long (hysteresis against flapping)
	-- FocusFire
	FocusR = 40,         -- candidates: enemies in contact within FocusR of the army centre or FocusNear of a squad under attack
	FocusNear = 25,
	FocusKeep = 0.5,     -- inertia: keep the current target while its score >= best score - FocusKeep ...
	FocusMinSecs = 6,    -- ... and always for this long after choosing it
	FocusHpW = 2.0, FocusCntW = 1.0, FocusValW = 0.5, FocusDistW = 0.5, FocusVehPen = 0.4,
	FocusLeaveR = 25,    -- Conf_FocusLeave: a squad under fire farther than this from the target would have to leave its spot
	FocusLeaveHp = 0.35, -- Conf_FocusLeave rule 2: it leaves only for a target below this health share
	-- ArmyRetreat
	RetreatRatio = 1.6,  -- enemy strength in the zone / ours >= this -> the whole army goes home
	RetreatMinW = 600,   -- ... and the enemy strength is at least this
	RetreatHold = 15,    -- no "come back" check for this long after the retreat started
	RetreatMax = 75,     -- the retreat ends after this whatever the enemy does
	ReturnRatio = 1.0,   -- come back when enemy strength near the old fight spot <= our total strength * ReturnRatio
	VPHoldR = 25,        -- Conf_HoldVP: a victory point we own/capture within this distance of the army centre ...
	HoldVPMult = 1.6,    -- ... multiplies RetreatRatio (rule 2: only while we lose the ticker race, rule 3: always)
	-- PreRetreat
	PreR = 90,           -- incoming enemy groups are looked for up to this distance
	PreClose = 6,        -- "approaching": the enemy squad moved at least this much towards our centre since the last scan
	PreAngle = 60,       -- degrees off the direction of the current fight/target: beyond = flank/rear (full weight)
	PreFrontW = 0.5,     -- weight of forces coming head-on (Conf_PreEngage rule 3: 0)
	PreRatio = 1.4,      -- (zone + incoming) / ours >= PreRatio -> retreat before the blow
	PreMinW = 400,       -- ... and the incoming force is at least this
	PreWinK = 0.5,       -- Conf_PreEngage rule 2: finish the current fight when the zone enemy is below ours * PreWinK
	-- PunishTurn
	PunishR = 45,        -- a retreating enemy within this distance of the army centre
	PunishMove = 5,      -- "moving away": moved at least this much away from our centre since the last scan
	PunishHp = 0.6,      -- ... and either lost health since the last scan or is below this share
	PunishMaxRatio = 1.0,-- only while the enemy in the zone is not stronger than us
	PunishMaxHome = 130, -- never chase farther than this from our HQ
	PunishSecs = 10,     -- a chase ends after this ...
	PunishLostR = 70,    -- ... or when the target is farther than this from the army centre
	ChaseR = 35,         -- Conf_Chase rule 1: only squads within this distance of the target chase, the rest regroup
	-- MeleeTie
	TieR = 35,           -- ranged enemies within this distance of our melee squad
	TieMinHP = 0.45,     -- our melee squad needs this health share
	TieSecs = 10,        -- keep the chosen shooter this long
	RangedMinD = 12,     -- an enemy squad shooting its target from at least this distance counts as a ranged squad
	TieHeroes = 1,       -- melee heroes take part too
	JumpMin = 12, JumpMax = 32, JumpCd = 25,   -- jump squads jump on a target this far away, once per JumpCd
	-- Conf_MeleeApproach (enemy melee coming at our ranged squad)
	MeleeThreatR = 18,   -- an enemy melee squad this close and closing ...
	MeleeClose = 3,      -- ... by at least this much since the last scan
	FriendR = 15,        -- rule 1: hold when at least MeleeHoldFriends own squads are within FriendR, else kite
	MeleeHoldFriends = 2,
	MeleeKiteK = 1.0,    -- rule 2: kite when the attacker is stronger than our squad * MeleeKiteK
	KiteD = 14,          -- kite: move this far away from the attacker
	-- Repair
	RepairHP = 0.7,      -- a vehicle below this health share wants repair ...
	RepairDoneHP = 0.95, -- ... until this
	RepairSafeR = 40,    -- no enemy within this distance of the vehicle and of the repairer
	RepairSafeR2 = 20,   -- Conf_RepairVsFight rule 2: a repair in progress on a vehicle below RepairKeepHp goes on until this
	RepairKeepHp = 0.5,
	RepairMaxD = 70,     -- the repairer is at most this far from the vehicle
	RepairSecs = 30,     -- an assignment is re-made after this
	-- RaceAbilities (player/global abilities through Elite's own player_abilities.ai)
	AbilBudget = 60,     -- weight of BUDGET_PlayerAbility (Elite: 25 of ~265 -> ~9 % of the income)
	AbilUnitHold = 1,    -- 0.5: 1 = an ability that takes req / power and the unit the plan waits for: Conf_AbilityVsUnit decides; 0 = nothing is held
	AbilCallInFirst = 1, -- 0.7: 1 = the units budget asks the arbiter before it buys (or locks the money of) the plan's unit: a call-in that passes is cast there
	AbilUnitEta = 40,    -- Conf_AbilityVsUnit rules 2 / 3: a unit farther than this (s, at the income) is "far" (a call-in that arrives at the HQ goes)
	AbilHoldMax = 90,    -- 0.6: an ability held this long without a break while it could be cast goes all the same (nothing is held for ever) ...
	AbilHoldGap = 15,    -- ... a hold that was interrupted for this long starts anew
	AbilBargainK = 1.3,  -- 0.6: a call-in worth this many times its req (RA_WORTH) is the better unit - it goes
	AbilFightLo = 0.6,   -- 0.6 Conf_AbilityVsUnit: a call-in goes into a fight where we weigh at least this share of the enemy in contact ...
	AbilFightHi = 1.8,   -- ... and, rule 1, at most this (a fight that is won anyway: the req stays with the unit)
	AbilRaidR = 45,      -- 0.6 "defend": enemy squads within this distance of our HQ ...
	AbilRaidPointR = 25, -- ... or of a point of ours they are taking / of a power point of ours,
	AbilRaidFriendR = 30,-- with no squad of ours within this distance,
	AbilRaidMax = 2,     -- and at most this many of them (a raid; an army at our base is the army's business)
	AbilDemand = 30,     -- demand of an ability we want now (Elite adds -5..5; > 1 is needed)
	AbilSpawnDemand = 12,-- demand of spawn/reinforcement abilities out of a fight
	AbilFightSecs = 8,   -- "in a fight": enemy contact within this many seconds
	AbilR = 60,          -- our clump search: enemies in contact within this distance of the army centre
	AbilClumpR = 12,     -- a clump = enemy squads within this distance of one of them
	AbilMinClump = 2,    -- Conf_AbilitySave rule 2: damage abilities need a clump of at least this many squads
	AbilFriendR = 10,    -- no own squad within this distance of the clump position (friendly fire)
	AbilQuiet = 1,       -- 0.8: 1 = a targeted call-in with no fight and no raid to land in may land next to the army (it is a unit bought
	                     --      through another channel: the arbiter weighs it against the plan's unit as a call-in that arrives at the HQ); 0 = as 0.7
	AbilQuietOff = 12,   -- 0.8: ... this far from the army's middle squad, towards our HQ
	AbilWatchSecs = 60,  -- 0.8: one line per call-in this often: can the engine cast it, its cost and the bank with the red resource, why not
	-- ArmyRoles
	Runners = 1,         -- secondary squads that run between points ...
	Runners2At = 8,      -- ... two of them when the army has at least this many squads
	RunnerFleeR = 30,    -- enemy squads within this distance of the runner: fight one (Conf_RunnerFight) or go elsewhere
	RunnerPointR = 40,   -- a point with enemies within this distance is skipped by the runner
	RunnerAvoidR = 80,   -- after a threat the runner prefers points at least this far from it (the other flank)
	RunnerAvoidSecs = 45,
	RunnerVpBonus = 30,  -- victory points count this many metres closer
	RunnerReissue = 20,  -- the capture order is repeated after this (safety)
	RunnerOpenSecs = 150,-- 0.6: the opening - until then a small army has its runner and a hero may be one (nobody stands in the field yet)
	RunnerMinArmy = 4,   -- 0.6 Conf_RunnerArmy: an army of at most this many squads is small (rule 3: one more)
	RunnerSeenSecs = 45, -- 0.6: an enemy point where an enemy stood within RunnerPointR during the last ... seconds is watched: no target
	RunnerPathR = 35,    -- 0.6: no target whose way (a straight line) passes within this distance of an enemy force:
	RunnerPathK = 1.0,   -- ... two squads or more, or one that weighs at least this many times the runner
	RunnerDeadSecs = 150,-- 0.6: the target a runner was lost on its way to is nobody's target for this long
	RunnerOwnR = 90,     -- 0.6: a point that was ours within this distance of the army comes first ...
	RunnerOwnBonus = 60, -- ... it counts this many metres closer (the runner's choice and the army's next goal)
	EliteCapturers = 1,  -- Elite's own capture tasks left (s_personality.max_num_capturers; Elite: 8)
	SplitAfter = 6,      -- the core splits to the points this long after the last enemy contact ...
	SplitWindow = 30,    -- ... but only within this time after a fight
	SplitR = 70,         -- points within this distance of the army centre
	SplitPointSafeR = 50,-- a point with enemies within this distance is not taken by the split
	SplitSecs = 40,      -- the split ends after this at the latest
	SplitReissue = 20,
	SplitCooldown = 30,  -- no new split this long after the last one
	SplitMinHp = 0.5,    -- a squad below this health share does not go
	EnemyHalfK = 1.0,    -- "enemy half": the point is closer to an enemy HQ than EnemyHalfK * its distance to our base
	DecapEnemyR = 50,    -- Conf_Decap rule 2/3: enemies within this distance of the point -> neutralise only
	SplitStay = 18,      -- the rest of the army covers the splitting squads this long, then the director leads it on
	-- Idle (0.3): a squad left without an order out of a fight
	IdleSecs = 12,       -- idle = did not move, was not hit, did not fire, is not busy (repair, capture) for this long
	IdleMoveD = 3,       -- "did not move": within this distance of the spot where the clock started
	IdleFireTicks = 50,  -- "did not fire": AISquad_HasFiredWeapon over this many ticks (0.1 s)
	IdleNearSecs = 4,    -- ... with an enemy within IdleEnemyR it is sent at that enemy already after this long (the polygon's idle_near_enemy is 10 s; a tick is 3 s)
	IdleEnemyR = 35,
	IdleReissue = 9,     -- at most one idle order per squad per this long
	IdleTries = 3,       -- after this many idle orders without moving the squad is left alone for IdleMute s (it cannot move)
	IdleMute = 60,
	IdleRoleBan = 120,   -- a runner / split squad found idle is not given a capture role again for this long
	IdleCapR = 14,       -- a squad this close to a point we are capturing is busy capturing, not idle
	IdleCapMax = 45,     -- 0.9: ... a squad without a capture role for this long at most
	IdleTargetR = 18,    -- "at the target": within this distance of the director's target / the goal
	IdleArmySecs = 12,   -- the army standing at its target for this long gets the next goal
	GoalSecs = 60,       -- a goal lives at most this long
	GoalCapReissue = 20, -- the capture order of the squad that takes the goal point is repeated after this
	GoalWait = 12,       -- the army waits this long for that squad, then it gets the next goal (the squad finishes and follows)
	GoalStaleSecs = 180, -- the director's target where the army stood idle counts as used up this long (while Elite keeps it on top)
	GoalBaseR = 60,      -- an enemy squad this close to an enemy HQ is not a goal (base defences)
	-- Garrison (0.3): an enemy squad inside a building next to our point / target / base
	GarApi = 1,          -- 1 = ask the engine (Squad_IsInHoldEntity); 0 = the pattern is off
	GarPointR = 30,      -- "next to": within this distance of a point of ours / on our half, of the target, of the army ...
	GarHomeR = 70,       -- ... or this close to our HQ
	GarBldR = 8,         -- squads within this distance of the garrison squad are in the same building
	GarSupportR = 35,    -- enemy squads outside the building within this distance of it fight for it
	GarCoverK = 2.0,     -- a garrison counts this many times its strength for an army without an anti-garrison tool ...
	GarToolK = 1.0,      -- ... and this many with one (grenades, flamers: reports/tactics_kb/kb.yaml garrisoned_enemy)
	GarRatio = 1.5,      -- Conf_Garrison rule 2: assault when ours / (garrison * cover + support) >= this (no tool) ...
	GarToolRatio = 1.0,  -- ... or this with a tool (rule 1: a tool is required; rule 3: tool and 1.2x this)
	GarBruteRatio = 3.0, -- rules 1 and 3: without a tool only at this ratio
	GarEngageR = 55,     -- the army farther than this from the building walks there as one fist (the director's goal) ...
	GarReissue = 9,      -- ... closer: every squad gets its own order, repeated after this
	GarGrenR = 28,       -- a grenade squad throws from at most this far (else it comes closer) ...
	GarGrenCd = 20,      -- ... once per this long
	GarMeleeR = 14,      -- melee squads wait this far from the building (a building is not fought in melee; they take the exit)
	GarHoldR = 45,       -- "hold": the spot this far from the building towards our HQ
	GarHoldSecs = 24,    -- "hold" lasts this long (once; at our HQ: again after GarBypassSecs of "bypass", and so on)
	GarHoldNearR = 110,  -- ... and only an army within this distance of the building holds (a far one does not walk back to stand)
	GarBypassSecs = 60,
	GarDangerR = 40,     -- hold / bypass: a squad under fire this close to the building pulls back to the hold spot
	GarLogSecs = 30,     -- period of the "Garrison ... state" line
	GarConfHold = 16,    -- a Conf_Garrison decision holds at least this long (two switches in 30 s at most)
	GarKeepK = 0.7,      -- an assault under way goes on down to this share of the ratio that starts one (and with half a tool)
	-- Defence (0.7): the enemy's base defences - turrets (found by the engine's entity list, else assumed at every enemy HQ)
	DefScanSecs = 15,    -- the enemy's defence buildings are looked up this often (they do not move)
	DefR = 40,           -- a turret's zone: within this distance of it a squad is under its guns
	DefW = 1200,         -- strength of one turret at full health (ours: a squad ~ 300-900, a tank ~ 1500+)
	DefClusterR = 45,    -- turrets within this distance of one another cover each other: their strengths add up
	BaseDefR = 55,       -- no entity list: the zone around an enemy HQ ...
	BaseDefW = 2400,     -- ... and its strength (two turrets)
	DefSupportR = 40,    -- enemy squads within this distance of the turret fight for it
	DefArmyR = 75,       -- our squads within this distance of the turret are the force that would go in
	DefRatio = 1.5,      -- go in when ours / (turrets + their squads) >= this ...
	DefToolRatio = 1.1,  -- ... or this with something that takes a turret down (vehicles, armour-piercing, artillery: DEF_TOOLS)
	DefKeepK = 0.7,      -- an assault under way goes on down to this share of that ratio
	DefMemK = 0.5,       -- every squad we lost / that was beaten back under this turret makes it count this much stronger ...
	DefMemSecs = 300,    -- ... for this long after the last one
	DefLossPad = 10,     -- a squad that died / went home hurt within the zone + this is that turret's
	DefOutD = 8,         -- "out": to a spot this far outside the zone
	DefHoldD = 15,       -- the army's hold spot: this far outside the zone, towards our HQ
	DefNearPad = 25,     -- a turret matters while a squad of ours is within its zone + this, or the army's target lies in the zone
	DefReissue = 6,      -- a squad is ordered out / at the turret at most this often
	DefRetreat = 1,      -- 0.8: 1 = a squad under fire inside a zone the army stays away from retreats when walking out is too slow (below); 0 = it walks
	DefWalkD = 4,        -- 0.8: ... it is suppressed (Squad_IsSuppressed, when the engine has it here), or deeper than this inside the zones
	                     --      (the shortest way out; scene f: a suppressed squad walked 12 m in 11 s),
	DefRetreatHP = 0.75, -- 0.8: ... or below this health,
	DefOutSecs = 3,      -- 0.8: ... or still inside this long after it was first seen there (the next tick)
	DefBeatenHP = 0.5,   -- 0.8: a squad Defence itself sent home above this health was not "beaten back" (the turret's memory does not count it)
	DefArtR = 110,       -- artillery within this distance shells a turret the army stays away from
	DefRangeData = 1,    -- 0.9: 1 = a turret's zone is the range of its weapon (DEF_RANGE, Elite's attributes) + DefRangePad; 0 = DefR for every turret (0.8)
	DefRangeDef = 49,    -- 0.9: ... the range of a turret the table does not name (the heavy-bolter / shuriken / shoota turrets of every base: 49)
	DefRangePad = 3,
	Siege = 1,           -- 0.9: 1 = a squad that outranges the turret shells it from a spot outside its zone, one decision per squad and turret (below); 0 = as 0.8
	SiegeStandD = 20,    -- 0.9: the spot is this far outside the zone (never farther than the squad's range - SiegeInD, never closer than its minimum range + SiegeInD)
	SiegeInD = 5,
	SiegeSpotR = 8,      -- 0.9: "at the spot": within this distance of it
	SiegeCoverR = 100,   -- 0.9: a siege is begun (and begun anew) only with another squad of the army within this distance of the squad
	SiegeHoldSecs = 60,  -- 0.9: the decision holds until the turret is gone, the squad is lost, or this long - no "siege -> out -> siege" (s20: a manticore lost that way)
	SiegeCastSecs = 20,  -- 0.9: the ability that shells the turret is ordered at most this often (the recharge is the engine's)
	SiegeNeedSecs = 90,  -- 0.9: "the army stays away from a turret and nothing of ours outranges it" is fresh this long (EliteAI.def_need: the counter layer asks for the tools)
	DefConfHold = 16,    -- assault / avoid holds this long (two switches in 30 s at most)
	DodgeCfgSecs = 30,   -- 0.8 Dodge: the policy is sent to elite.scar again this often (a lost queue costs half a minute at most)
	DangerSecs = 60,     -- 0.8 Dodge: a mine / a charge elite.scar told us about closes its spot for this long after it was last seen ...
	DangerPad = 6,       -- ... the spot's radius + this (points inside are nobody's, nothing is marched at there)
	DefLogSecs = 20,
	-- Vehicles (0.7): with the army, not ahead of it; a damaged one out of the fire
	VehBackHP = 0.4,     -- a vehicle below this health share with an enemy within VehDangerR pulls back behind the army ...
	VehBackDoneHP = 0.65,-- ... and takes no part until it is above this, or VehBackSecs after the last enemy contact of the army
	VehBackSecs = 9,
	VehBackD = 40,       -- the spot: this far behind the infantry's centre, towards our HQ
	VehDangerR = 45,
	VehLeadD = 20,       -- "ahead": this much closer to the army's target than the nearest infantry squad ...
	VehAloneD = 35,      -- ... with no infantry squad of ours within this distance
	VehReissue = 6,
	-- 1.0 (Orca fb 529): what comes in is counted, not only what is left; a transport is never the point of the army
	VehRate = 0.03,      -- a vehicle that loses this share of its health a second (over VehRateSecs) ...
	VehRateSecs = 3,
	VehTtd = 12,         -- ... and would be dead within this many seconds at that rate pulls back, whatever its health
	VehLightHP = 0.7,    -- a light vehicle / transport (X.VEH_LIGHT) under fire below this health with an anti-vehicle squad or a set-up team within VehAvR pulls back
	VehAvR = 40,
	VehCalm = 8,         -- pulled back early: it stays out until it has not been hit for this long (and VehBackDoneHP / the army's contact, as before)
	VehTransport = 1,    -- 1 = a transport (TRANSPORTS) keeps VehTransD behind the nearest infantry squad on the way to the target and in a fight
	VehTransD = 10,
	VehRunner = 1,       -- 1 = the pull-back rules hold for a runner that is a vehicle as well (0 = a runner is the runner logic's alone, as 0.9)
	-- Setup (0.7): enemy heavy-weapon teams that set up (SETUP_SBPS) and support heroes
	FocusSetupW = 0.8,   -- FocusFire: a set-up team scores this much more ...
	FocusSupportW = 0.5, -- ... a support hero this much
	SetupR = 45,         -- our squads within this distance of a set-up team in contact act against it
	SetupGrenR = 30,     -- a grenade squad throws from at most this far (GarGrenCd between throws)
	SetupCone = 55,      -- degrees to either side of where the team shoots: its arc - not walked through
	SetupNearD = 12,     -- closer than this the arc does not matter any more (the team must pack up to turn)
	SetupFlankD = 22,    -- the flank spot: this far to the side of the team
	SetupReissue = 6,
	SetupApproach = 1,   -- 1.0: 1 = a squad with a grenade / stun / knock-back walks to its throw range of a set-up team (0 = it throws only from where it stands)
	SetupBuyMin = 2,     -- the purchase scripts are told (EliteAI.setup) once the enemy fields this many set-up teams
	-- Counter (0.9): the answer to what the enemy fields
	CounterMemSecs = 120,  -- an enemy squad counts this long after it was last seen
	CounterSightR = 45,    -- no AIPlayer_CanSeeSquad here: a squad within this distance of one of ours (or fighting us) is seen
	CounterDomShare = 0.5, -- Conf_CounterVsPlan rule 1: a share class is countered from this share of the remembered strength
	CounterBuySecs = 15,   -- ... rule 2: a class that has been present for this long
	CounterConfHold = 30,  -- counter / plan holds this long (two switches a minute at most)
	CounterMult = 2.0,     -- the demand of an answer to a countered class while we have none ...
	CounterMultHave = 1.3, -- ... with fewer than CounterMaxHave of them
	CounterMaxHave = 2,
	CounterMultPlan = 1.2, -- a class that is seen but left to the plan: its answer while we have none
	CounterAddonMult = 2.0,-- a squad upgrade against a countered class
	CounterLogSecs = 30,
	CounterAvFocus = 1,  -- 1.0: 1 = a squad with an anti-vehicle weapon (X.is_av) shoots the enemy's vehicle, not the army's focus target
	CounterBpLog = 40,   -- 1.0: "COUNTER bp squad ..." - how an enemy squad was recognised - for the first this many squads of a match
	CounterTech = 1,       -- 1 = against a line of set-up teams, with a tool against them in the army, the next tier comes CounterTechSecs earlier
	CounterTechSecs = 45,
	CounterControl = 1,    -- 1 = stun / slow / knock-back abilities on a dangerous melee squad that comes at us
	CtrlFriendR = 6,       -- ... not with a squad of ours this close to it
	CtrlTargetCd = 12,     -- ... one throw per target per this long
	CtrlLead = 1.0,        -- ... aimed where it will be in this many seconds
	FocusDetectW = 0.4,    -- FocusFire: a detector scores this much more
	-- 1.1 Map (TECH_RU.md 19; Orca fb 544 / 550): our own points before the enemy's base, a point is captured by one or two
	-- squads while the army covers or goes on, nothing is marched at inside a zone the army stays out of
	Map = 1,             -- 0 = as 1.0
	MapThreatR = 35,     -- an enemy squad within this distance of a point threatens it (the generators stand around a power point)
	MapHomeR = 110,      -- "our side": within this distance of our HQ, or closer to our base than to an enemy HQ (enemy_half is false)
	MapLostSecs = 180,   -- a point that was ours within this many seconds and is not now is "lost": taken back before any other point
	MapDefRatio = 0.85,  -- the army goes to a threatened point of ours when ours >= theirs there x this (1.3: was 0.7 = 1 / 1.43 - the very odds the fight is left at, 1 / RetreatLocalRatio; Malum fb 621: "Goal defend ... enemy 2469 ours 2008", lost)
	MapDefSecs = 12,     -- the goal "defend" lives this long after the last threat was seen at its point
	MapFarD = 120,       -- Conf_MapDefend rules 2 and 3: a requisition point farther than this from the army is left to the runners
	MapCappers = 2,      -- squads of the army that capture its goal points at a time (1.0: one)
	MapCapAhead = 45,    -- the capturing squad is sent when the army's centre is within this distance of the goal point (1.0: IdleTargetR)
	MapMoveOn = 1,       -- 1 = while its point is being captured the army goes on to the next point at once, or covers (0 = it waits GoalWait at the point)
	MapCoverD = 22,      -- the cover spot: this far from the point towards the nearest enemy HQ
	MapHoldOwn = 1,      -- 1 = target under a turret the army stays away from and no other goal: hold at our point nearest to it, not at the edge of the zone
	-- 1.2 (TECH_RU.md 20): the purchase scripts' look at our power points; the regressions of the polygon's scenes g and m
	PowerScan = 1,       -- 1 = a power point of ours: has it a node, how many generators (EliteAI.pw for strategy_unit_purchase.ai); 0 = no such calls
	PowerSlots = 3,      -- generators a node takes (strategic_point_pvp: maximum_addon_structures)
	-- step 3 of the vanilla base (VANILLA_BASE_RU.md 11.3): in a team game "ours" is the TEAM's point - the ally's power points (his
	-- nodes, his generators) were counted as places where we can build ("power points ours 4 without a node 2", "free places 0"
	-- for an IG whose own two points had lost their nodes and whose ally's two were full). 1 = EliteAI.pw (own / unsec / slots /
	-- sites) counts only the points this player owns (Player_GetID == s_selfplayerid, as targets.ai:14-17); 0 = the team's, as
	-- 1.3. The default is by the base: 1 on the vanilla base, 0 on the Elite base (the released AI is not changed)
	PowerMine = (EliteAI.base == "vanilla") and 1 or 0,
	-- 1.4 (step 3 of the vanilla base, VANILLA_BASE_RU.md 11.1): the squads in the engine's capture tasks (X.run_capwatch)
	CapWatch = (EliteAI.base == "vanilla") and 1 or 0,   -- 1 = they are watched (main.ai hands them over as state.caps); 0 = left to the engine, as 1.3
	-- 1.5 (step 4 of the vanilla base, VANILLA_BASE_RU.md 14.3): a vehicle in the army's retreat (retreat_order)
	RetreatVeh = (EliteAI.base == "vanilla") and 1 or 0, -- 1 = it gets a plain move to our HQ; 0 = the retreat order it cannot execute, as 1.4
	CapWatchR = 40,      -- the enemy "at" such a squad: within this distance of it
	CapWatchSupR = 45,   -- our squads of the army within this distance of it count as its support (whole)
	CapWatchRatio = 1.4, -- it leaves when the enemy there >= (its own strength + the support) x this (= RetreatLocalRatio)
	CapWatchMinW = 500,  -- ... and the enemy there weighs at least this (a single scout squad stops nobody: it shoots back or finishes the capture)
	CapWatchSecs = 40,   -- one retreat order per squad in this many seconds (= RetreatSecs: it runs home meanwhile)
	MapOnBaseR = 95,     -- "the army goes on": never to a point within this distance of an enemy HQ ...
	MapOnThreatR = 60,   -- ... nor to one with enemy squads within this distance that weigh more than MapOnRatio of the army
	MapOnRatio = 0.5,
	MapBusySecs = 10,    -- Conf_MapDefend 2 / 3: the far requisition point is left only while the army is busy (an enemy in contact this many seconds ago, or storming)
	RoleSecs = 120,      -- a squad that was a runner / a capturing squad within this many seconds is still one for the refill (EliteAI_MechRole)
	-- 1.3 (TECH_RU.md 21.4 / 21.5; Malum fb 621 / 623: 15 squads lost, Orca fb 634: 105 models): the fight is judged where it is,
	-- and the army does not march into a force it cannot beat
	RetreatLocal = 1,    -- 1 = the strengths of a retreat are those AT THE FIGHT (X.fight), 0 = as 1.2 (the whole army against the zone of its centre)
	FightR = 45,         -- the fight: our squads and the enemy's within this distance of the squad of ours that has the most enemy on it
	FightSupportR = 90,  -- our squads of the line outside the fight but within this distance of it ...
	FightSupportK = 0.5, -- ... count this much (they arrive during it)
	RetreatLocalRatio = 1.4, -- enemy strength at the fight / ours there >= this -> they leave (HoldVP multiplies it as RetreatRatio)
	FightArmyShare = 0.5,    -- the squads at the fight weigh this share of the army or more: the whole army goes home; less: only they do ("FightLeave")
	Trade = 1,           -- 1 = a fight that is being lost by the trade is left before the ratio says so
	TradeSecs = 9,       -- ... it has lasted this long,
	TradeLoss = 0.3,     -- we have lost this share of the strength we had in it at our best,
	TradeEnemyK = 0.5,   -- the enemy less than this much of that share of his,
	TradeRatio = 1.1,    -- and he outweighs us there by this
	Engage = 1,          -- 1 = the march is judged before it starts (X.run_engage); 0 = as 1.2
	EngageR = 55,        -- the force the march meets: enemy squads within this distance of the target ...
	EngagePathR = 35,    -- ... or of the straight way to it
	EngageMinW = 500,    -- a force below this stops nobody
	EngageNeed = 1.0,    -- the army goes when ours + the allies' there x EngageAllyK >= that force x this (Conf_Engage: x1.15 / x1 / x0.85)
	EngageAllyK = 0.7,
	EngageAllies = 1,    -- 1 = the allies' squads at the target are looked up when ours alone are not enough (0 = never)
	EngageStandoff = 65, -- the rally point lies at least this far from the target
	EngageHomeR = 80,    -- a target this close to our HQ is always marched at; a fight this close is left at RetreatRatio, not by the trade (the army stands longer at home)
	EngageDecayAfter = 90,   -- a hold longer than this lowers the need ...
	EngageDecaySecs = 240,   -- ... over this many seconds ...
	EngageDecayMin = 0.65,   -- ... down to this share of it (no standing at home for ever, Orca fb 559)
	EngageVpK = 0.8,     -- the need x this while we are behind in the ticker race with EngageVpLow tickets or fewer
	EngageVpLow = 200,
	EngageHold = 9,      -- hysteresis of the verdict, seconds
	EngageBadSecs = 45,  -- an enemy squad that was dropped as a goal is not one again for this long
	RunnerSafe2At = 6,   -- a second runner from this many squads while the map is quiet (0 = only from Runners2At)
	RunnerSafeSecs = 20, -- ... "quiet": the army out of contact for this long and no enemy squad within MapHomeR of our HQ
	MapWay = 1,          -- 1 = a free point within MapWayR of the marching army is captured by one of its squads on the way (TECH_RU.md 21.5)
	MapWayR = 40,
	MapWayArmy = 3,      -- ... by an army of this many squads of the line or more
	-- 1.1 the raider role (Orca fb 538: "the lictor went head-on; it is a side capper, infiltration, sudden attacks")
	Raid = 1,
	RaidFleeR = 28,      -- enemy squads within this distance: one that is weaker is fought, anything else is left (back towards the army)
	RaidMinHP = 0.5,     -- below this health share it is the army's again
	RaidReissue = 8,
	RaidSeenSecs = 20,   -- no target where an enemy stood within RunnerPointR during the last ... seconds
	SetupSquadAbil = 1,  -- 1 = abilities cast on a squad (the lictor alpha's flesh hook) are used against set-up teams (order mode 200+k)
}

