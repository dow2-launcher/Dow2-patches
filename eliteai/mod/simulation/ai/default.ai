-- ===== EliteAI dispatcher (branch vanilla-ours; tools/vanilla_dispatch.py) =====
do
	local G0 = getfenv and getfenv(0) or {}
	eliteai_log = eliteai_log or G0.eliteai_log or string.eliteai_log
	eliteai_cfg = eliteai_cfg or G0.eliteai_cfg or string.eliteai_cfg
	local function cfg(k, d) local v = eliteai_cfg and eliteai_cfg(k); if v == nil then return d end; return v end
	local id = AI_GetPlayerID()
	local real = AIPlayer_GetDifficultyLevel(AIPlayer_GetLocal(id))
	-- [Lua] NewAI = groups "<what>[:<who>]" separated by spaces; the first group that names this player wins.
	--   what: vanilla | vanilla+ours | elite+ours (= ours) | elite;  who: normal (default) | all | none | player ids "1000,1002"
	--   a group without <what> is the old form (normal | all | none | 1000,1002) = the new AI for those players
	-- newai-22 (12.11.2026): the new AI = the vanilla base + our layer. No key and the old forms (an EliteAI.ini a tester kept
	-- from earlier versions, e.g. NewAI=normal) play vanilla+ours; the released Elite base stays reachable as elite+ours[:who]
	local DEF = "vanilla+ours"
	-- (string.find with explicit classes only: no gmatch, no %S in the game's AI Lua)
	local function who_has(who)
		if who == "all" then return true end
		if who == "none" then return false end
		if who == "normal" or who == "" then return real == AD_Easy or real == AD_Standard or real == AD_Hard end
		local pos = 1
		while true do
			local s, e, x = string.find(who, "([0-9]+)", pos)
			if not s then return false end
			if tonumber(x) == id then return true end
			pos = e + 1
		end
	end
	local WHAT = { ["vanilla"] = { "vanilla", false }, ["vanilla+ours"] = { "vanilla", true }, ["elite+ours"] = { "elite", true },
		["ours"] = { "elite", true }, ["elite"] = { "elite", false } }
	local mode = string.lower(cfg("NewAI", "normal"))
	local base, ours, pos, bad = "elite", false, 1, nil
	while true do
		local s, e, grp = string.find(mode, "([^ ;|]+)", pos)
		if not s then break end
		pos = e + 1
		local what, who = DEF, grp
		local c = string.find(grp, ":", 1, true)
		if c then what, who = string.sub(grp, 1, c - 1), string.sub(grp, c + 1)
		elseif WHAT[grp] then what, who = grp, "normal" end
		local w = WHAT[what]
		if not w then bad = grp
		elseif who_has(who) then base, ours = w[1], w[2]; break end
	end
	-- BRAIN (branch brain; mod/brain/*.ai, BRAIN_DESIGN_RU.md): [Lua] Brain = 0 (off: nothing changes) | 1 (default since newai-24: a new-AI player
	-- whose race has a brain profile: orks) | all (every new-AI player, whatever its race - bench experiments).
	-- A brain player plays the vanilla base with our old layer OFF (main.ai / mechanics.ai passive) and the brain's own rules.
	local brain = false
	do
		local bk = string.lower(tostring(cfg("Brain", "1")))
		if ours and bk ~= "0" and bk ~= "" then
			local race = AIPlayer_GetRace(AI_GetPlayer())                -- (default.ai reads the same a few lines below)
			brain = (bk == "all") or (bk == "1" and race == "orks")
			if brain then base, ours = "vanilla", false end
			if eliteai_log then eliteai_log("p" .. tostring(id), "dispatch", "Brain", bk, "race", tostring(race), "brain", brain and 1 or 0) end
		end
	end
	EliteAI_VANILLA = (base == "vanilla")
	-- the level the scripts see. Elite base: ForceDiff (tests). Vanilla base: VanillaDiff; without it the slot's own level for
	-- the plain vanilla and Hard under our layer (the base of the new AI: T2 + T3, no caps of the personality, attacks bases)
	local lvl
	if EliteAI_VANILLA then
		lvl = tonumber(cfg("VanillaDiff", "") or "")
		if lvl == nil and (ours or brain) then lvl = AD_Hard end
	else
		lvl = tonumber(cfg("ForceDiff", "") or "")
	end
	if lvl then
		local orig = AIPlayer_GetDifficultyLevel
		AIPlayer_GetDifficultyLevel = function(p) orig(p); return lvl end
	end
	EliteAI_MODE = { base = base, ours = ours, brain = brain, real_diff = real, diff = lvl or real, newai = mode }   -- main.ai reads it (EliteAI.on, EliteAI.base)
	if eliteai_log then
		eliteai_log("p" .. tostring(id), "dispatch", base .. (ours and "+ours" or ""), "slot_diff", tostring(real), "diff", tostring(lvl or real), "NewAI", tostring(mode))
		if bad then eliteai_log("p" .. tostring(id), "dispatch", "NewAI: unknown group", tostring(bad), "(ignored)") end
	end
	-- what the AI asks to produce (units, upgrades, tiers, build order; not the reinforcements): 'p<id> REQ <sec> <pitem> <blueprint>'
	if eliteai_log and Request_Production and PBG_GetName then
		local orig_rp, n = Request_Production, 0
		Request_Production = function(...)
			local _, _, _, pitem, pbg = ...
			if pbg ~= nil and pitem ~= PITEM_SquadReinforce and n < 600 then
				n = n + 1
				eliteai_log("p" .. tostring(id), "REQ", math.floor(World_GetGameTime() or -1), tostring(pitem), tostring(PBG_GetName(pbg)))
			end
			return orig_rp(...)
		end
	end
end
if EliteAI_VANILLA then

