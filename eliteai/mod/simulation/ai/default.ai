	"race_tau/troops/tau_heavy_weapon_drones" }
local SUPPORT_SBPS = { "race_marine/heroes/sm_apothecary", "race_marine/heroes/sm_techmarine", "race_eldar/heroes/eld_warlock", "race_eldar/heroes/eld_farseer",
	"race_chaos/heroes/csm_plague_marine_champion", "race_chaos/heroes/csm_sorceror", "race_ork/heroes/ork_hero_mekboy",
	"race_imperial_guard/heroes/ig_inquisitor", "race_imperial_guard/heroes/ig_commissar_lord", "race_grey_knights/heroes/gk_daemonhunter",
	"race_tau/heroes/tau_ethereal", "race_tyranid/heroes/tyr_hive_tyrant" }

local function mlog(...) if EliteAI.log then EliteAI.log("MECH", ...) end end
local function fmt(...) return string.format(...) end
local function prm(k) return EliteAI.num("Mech_" .. k, MP[k]) end
local function mech_on(name)                                                  -- ini only: Mech_<Name>=0 switches it off
	local v = tonumber(EliteAI.cfg("Mech_" .. name, nil))
	if v == nil then return true end
	return v >= 1
end
local function vidx() local v = EliteAI.variant; return (v == "B" and 2) or (v == "C" and 3) or 1 end
local function rule(name)                                                     -- Conf_<Name> = 1/2/3 (default: the variant)
	local r = math.floor(EliteAI.num("Conf_" .. name, vidx()))
	if r < 1 then r = 1 elseif r > 3 then r = 3 end
	return r
end
-- the conflict arbiter's memory: a decision holds ConfHold seconds (hysteresis), every switch is logged
local function decide(name, subject, v, reason, now, hold)
	local key = name .. ":" .. tostring(subject)
	local c = M.conf[key]
	if not c then M.conf[key] = { v = v, t = now }; return v end
	if c.v == v then return v end
	if now - c.t < (hold or prm("ConfHold")) then return c.v end
	mlog("Conf_" .. name, subject, c.v .. "->" .. v, reason or "")
	c.v, c.t = v, now
	M.st.conf = M.st.conf + 1
	return v
end

local _morder = eliteai_order or (string and string.eliteai_order)
-- 0.4: through the order book of main.ai (EliteAI_OrderGate: the same order is not repeated to a squad on its way; it may turn
-- an attack-move that had no effect into a plain move). owner "idle" = the Idle logic (the director then waits); returns
-- true when the order went out
local function morder(id, x, y, z, mode, owner)                               -- the DLL only stores five numbers: cannot raise
	if not _morder or not id then return false end
	local send, nx, nz = mode, nil, nil
	if EliteAI_OrderGate then
		send, nx, nz = EliteAI_OrderGate(id, mode, x, z, M.now or 0, owner or "mech", true)
		if not send then return false end
	end
	if nx ~= nil and nz ~= nil then                                           -- 0.8: the book replaced the order by a plain move to another spot
		local sp = EliteAI.sqpos and EliteAI.sqpos[id]
		_morder(id, nx, (sp and sp.y) or 0, nz, send)
	else _morder(id, x or 0, y or 0, z or 0, send) end
	M.st.orders = M.st.orders + 1
	if EliteAI.orders then EliteAI.orders = EliteAI.orders + 1 end
	local r = M.idle[id]                                                       -- 0.3 Idle: a squad that just got an order is not idle yet
	if r and M.now then r.t0 = M.now end
	return true
end

local function d2(ax, az, bx, bz) local dx, dz = ax - bx, az - bz; return math.sqrt(dx * dx + dz * dz) end
local function centre(list)
	local n = table.getn(list)
	if n == 0 then return nil end
	local cx, cz = 0, 0
	for _, u in ipairs(list) do cx = cx + u.pos.x; cz = cz + u.pos.z end
	return cx / n, cz / n
end
local function spread_of(list, cx, cz)
	local n = table.getn(list)
	if n == 0 then return 0 end
	local s = 0
	for _, u in ipairs(list) do s = s + d2(u.pos.x, u.pos.z, cx, cz) end
	return s / n
end
local function home()                                                         -- our HQ, read once (tactics.ai:508)
	if not M.home then
		local p = AIPlayer_GetHomePosition(s_self_modplayer)
		if p and p.x then M.home = { x = p.x, y = p.y, z = p.z } end
	end
	return M.home
end
-- strength of one of our squads (director entry: sq valid this tick, Squad_Count > 0 checked by the director)
local function weight_of(u)
	if u.hmax == nil then u.hmax = Squad_GetHealthMax(u.sq); u.veh = SquadQuery_IsVehicle(u.sq) end
	return u.hmax * u.hp * (u.veh and prm("VehW") or 1)
end
local function our_weight(list)
	local w = 0
	for _, u in ipairs(list) do w = w + weight_of(u) end
	return w
end
local function has_key(name, keys)
	for _, k in ipairs(keys) do if string.find(name, k, 1, true) then return true end end
	return false
end
local function ends_with(name, key)                                           -- ".../troops/eld_guardian" but not ".../eld_guardian_shuriken_cannon"
	local n, k = string.len(name), string.len(key)
	return n >= k and string.sub(name, n - k + 1) == key
end
-- 0.3: engine functions outside Elite's own AI scripts, looked up once (a missing one switches its mechanic off, never a call
-- of nil): Squad_IsInHoldEntity(squad) - the game's SCAR library groups.scar:1891/2556/2736, defendai.scar:195 (on an enemy
-- squad); bound by the same binder of DOW2.exe (0x8c2140) as Squad_GetHealthMax / Squad_IsUnderAttack /
-- Squad_FindCoverCompareCurrent which Elite's AI scripts call (tactics.ai:277, player-tactics.ai:51, tactics.ai:518)
local function api()
	if M.api then return M.api end
	M.api = {
		hold = (type(Squad_IsInHoldEntity) == "function") and EliteAI.num("Mech_GarApi", MP.GarApi) >= 1,
		fired = (type(AISquad_HasFiredWeapon) == "function"),                 -- tactics.ai:292
		cancap = (type(PBG_CanCapture) == "function"),                        -- strategy_unit_purchase.ai:170
		-- 0.7 Defence: the enemy's buildings. EGroup_CountSpawned / EGroup_GetSpawnedEntityAt / Entity_GetPosition /
		-- Entity_GetHealthPercentage are Elite's (tactics.ai:72-75, 733, 386); Player_GetEntities and Entity_GetBlueprintName are
		-- of the same library (the SCAR side of the game uses them) - looked up, never assumed
		ents = (type(Player_GetEntities) == "function" and type(EGroup_CountSpawned) == "function" and type(EGroup_GetSpawnedEntityAt) == "function"
			and type(Entity_GetBlueprintName) == "function" and type(Entity_GetPosition) == "function" and type(Entity_GetHealthPercentage) == "function")
			and EliteAI.num("Mech_DefApi", 1) >= 1,
		-- 0.7 Setup: an enemy squad's blueprint id against the ids of the blueprints we know by name (Squad_GetBlueprintID:
		-- player-tactics.ai:50; PBG_Get of an sbps path: strategy_unit_purchase.ai:26-50; PBG_GetID: player-tactics.ai:50)
		bpid = (type(Squad_GetBlueprintID) == "function" and type(PBG_Get) == "function" and type(PBG_GetID) == "function") and EliteAI.num("Mech_SetupApi", 1) >= 1,
		-- 0.8 Defence: is a squad of ours suppressed (it crawls: walking out from under a turret takes too long). The SCAR side
		-- of the game calls it with a squad (one argument); the same library as Squad_IsUnderAttack - looked up, never assumed
		sup = (type(Squad_IsSuppressed) == "function") and EliteAI.num("Mech_SupApi", 1) >= 1,
		-- 0.9 Counter: does our player see that squad (the fog of war). Elite's tactics.ai:116 has the call, commented out:
		-- "AIPlayer_CanSeeSquad( s_selfplayer, target_squad )" - the same arguments here; never called by Elite's scripts in
		-- the game, so: looked up, and Mech_CounterSeeApi=0 = not called (then: within CounterSightR of one of our squads)
		see = (type(AIPlayer_CanSeeSquad) == "function") and EliteAI.num("Mech_CounterSeeApi", 1) >= 1,
		-- 1.0 Counter: the blueprint NAME of a squad. elite.scar (the SCAR state) calls Squad_GetBlueprintName on our squads since
		-- 0.8 and the polygon prints the names it returns ("sbps\\pvp\\race_ork\\troops\\ork_slugga"); in THIS state it is looked up -
		-- Mech_CounterNameApi=0 = not called (then: the blueprint id, and the names elite.scar tells us - EliteAI_ScarNote kind 3)
		bpname = (type(Squad_GetBlueprintName) == "function") and EliteAI.num("Mech_CounterNameApi", 1) >= 1,
	}
	X.clog("api", "AIPlayer_CanSeeSquad", type(AIPlayer_CanSeeSquad), "use", M.api.see and 1 or 0, "(0 = seen is what stands within", prm("CounterSightR"), "m of one of ours)")
	X.clog("api", "Squad_GetBlueprintName", type(Squad_GetBlueprintName), "use", M.api.bpname and 1 or 0, "(0 = a squad's blueprint by its id, and by the names elite.scar tells)")
	mlog("api", "Squad_IsSuppressed", type(Squad_IsSuppressed), "use", M.api.sup and 1 or 0)
	mlog("api", "Squad_IsInHoldEntity", type(Squad_IsInHoldEntity), "use", M.api.hold and 1 or 0, "AISquad_HasFiredWeapon", type(AISquad_HasFiredWeapon),
		"PBG_CanCapture", type(PBG_CanCapture))
	mlog("api", "Player_GetEntities", type(Player_GetEntities), "Entity_GetBlueprintName", type(Entity_GetBlueprintName), "defence scan", M.api.ents and "entities" or "at enemy HQs",
		"Squad_GetBlueprintID", type(Squad_GetBlueprintID), "setup teams", M.api.bpid and "by blueprint id" or "off")
	return M.api
end


-- how much the enemy squad moved towards a point since the last scan (negative = away); nil without a last scan
local function approach(e, x, z)
	if not e.px then return nil end
	local d = d2(e.x, e.z, x, z)
	if d <= 0 then return nil end
	local mx, mz = e.x - e.px, e.z - e.pz
	return (mx * (x - e.x) + mz * (z - e.z)) / d
end
--------------------------------------------------------------------------------------------------
-- the enemy, once per tick: { id, x, y, z, hp, hmax, n, veh, hit, w, d (to our centre), contact, tdist (distance to the
-- squad it is fighting), px/pz/php (last scan) }; nothing but numbers survives the tick
local function scan_enemies(now, cx, cz, army, want_tdist)
	local ss = prm("ScanSecs")
	if M.en and ss > 0 and now - M.last_scan < ss then
		for _, e in ipairs(M.en) do e.d = d2(e.x, e.z, cx, cz) end
		return M.en
	end
	local list, prev, seen, vw = {}, M.en_prev, {}, prm("VehW")
	local hold_api = api().hold                                               -- 0.3: is the squad inside a building (Garrison)
	local bp = X.classes()                                                    -- 0.7: blueprint id -> "setup" / "support" (nil without the api)
	local see = api().see                                                     -- 0.9 Counter: the fog of war
	local known = (bp ~= nil) or api().bpname or (M.sname_n or 0) > 0         -- 1.0: is there any way to tell what a squad is
	local n_pl = World_GetPlayerCount()                                       -- cache.ai:62-64
	for i = 1, n_pl do
		local p = World_GetPlayerAt(i)
		if p and Player_IsAlive(p) and Player_GetRelationship(s_self_modplayer, p) == R_ENEMY then   -- cache.ai:65, tactics.ai:22
			local sg = Player_GetSquads(p)                                    -- main.ai Sample; tactics.ai:109-112
			local cnt = sg and SGroup_CountSpawned(sg) or 0
			for j = 1, cnt do
				local sq = SGroup_GetSpawnedSquadAt(sg, j)
				local n = sq and Squad_Count(sq) or 0
				if n > 0 then                                                  -- no position/health for a squad without models
					local id, pos, hmax = Squad_GetGameID(sq), Squad_GetPosition(sq), Squad_GetHealthMax(sq)
					local hp, veh = Squad_GetHealth(sq) / math.max(hmax, 1), SquadQuery_IsVehicle(sq)
					local e = { id = id, x = pos.x, y = pos.y, z = pos.z, hp = hp, hmax = hmax, n = n, veh = veh,
						hit = Squad_IsUnderAttack(sq, 3), w = hmax * hp * (veh and vw or 1) }
					if hold_api then e.held = (Squad_IsInHoldEntity(sq) == true) end   -- groups.scar:1891 (sq exists, has models)
					if known then                                                  -- 0.7 / 1.0 (the squad exists and has models)
						local k = X.squad_bp(sq, id)
						if k.kind == "setup" then e.setup = true elseif k.kind == "support" then e.support = true end
						e.cls, e.by = k.cls, k.by
					end
					if see then e.vis = (AIPlayer_CanSeeSquad(s_selfplayer, sq) == true) end   -- 0.9 (the squad exists and has models)
					e.d = d2(e.x, e.z, cx, cz)
					local pr = prev[id]
					if pr then e.px, e.pz, e.php = pr.x, pr.z, pr.hp end
					seen[id] = { x = e.x, z = e.z, hp = hp }
					table.insert(list, e)
				end
			end
		end
	end
	local sr, contact = prm("SightR"), false
	for _, e in ipairs(list) do
		e.contact = e.hit
		if not e.contact then
			for _, u in ipairs(army) do if d2(e.x, e.z, u.pos.x, u.pos.z) <= sr then e.contact = true; break end end
		end
		if e.contact then contact = true end
		if e.vis == nil then                                                    -- 0.9: no fog-of-war function - what is near one of ours, or fights us
			e.vis = e.contact
			if not e.vis then
				local cr = prm("CounterSightR")
				for _, u in ipairs(army) do if d2(e.x, e.z, u.pos.x, u.pos.z) <= cr then e.vis = true; break end end
			end
		end
		-- verify 10.11: SquadQuery_GetAnySquadCombatTarget is no longer called on ENEMY squads (Elite calls it on its own
		-- squads only; unproven on others = hang risk). "Ranged" surrogate from numbers only: in contact, not a vehicle,
		-- not closing in since the last scan, and keeps tdist = distance to our nearest squad
		if want_tdist and e.contact and not e.veh and e.px then
			local nd, nu
			for _, u in ipairs(army) do local d = d2(e.x, e.z, u.pos.x, u.pos.z); if not nd or d < nd then nd, nu = d, u end end
			if nd then
				local a = approach(e, nu.pos.x, nu.pos.z)
				if a and a < prm("MeleeClose") then e.tdist = nd end
			end
		end
	end
	if contact then M.last_contact = now end
	M.en, M.en_prev, M.last_scan = list, seen, now
	-- 0.8: where every enemy squad was at this scan, by id - the order book of main.ai turns an attack on a squad that had
	-- no effect into a plain move towards it (numbers only)
	local ep = {}
	for _, e in ipairs(list) do ep[e.id] = { x = e.x, z = e.z } end
	EliteAI.enpos = ep
	return list
end
local function enemy_weight_near(en, x, z, r)
	local w, n = 0, 0
	for _, e in ipairs(en) do if d2(e.x, e.z, x, z) <= r then w = w + e.w; n = n + 1 end end
	return w, n
end

-- 0.3: may this squad get a capture role (runner, split, the goal's capturing squad)? PBG_CanCapture, asked once per squad in
-- scan_own. Safety net: when the engine says "no" for every squad of an army of three or more, the answer is not what we
-- think it is - the check is dropped for the match (logged once) and the Idle logic alone weeds out squads that stand
-- with a capture order. Mech_CapCheck=0 drops it from the start.
local function can_cap(id) return not M.nocap[id] and (M.cap_off == true or M.cap[id] == true) end
local function cap_check(army)
	if M.cap_off ~= nil then return end
	if not api().cancap or EliteAI.num("Mech_CapCheck", 1) < 1 then
		M.cap_off = true; mlog("api", "capture check off:", api().cancap and "Mech_CapCheck=0" or "no PBG_CanCapture"); return
	end
	local n, yes = 0, 0
	for _, u in ipairs(army) do
		if M.cap[u.id] ~= nil then n = n + 1; if M.cap[u.id] then yes = yes + 1 end end
	end
	if yes > 0 then M.cap_off = false
	elseif n >= 3 then M.cap_off = true; mlog("api", "PBG_CanCapture says none of", n, "squads can capture: the check is dropped for this match") end
end
-- our squads through the AI side, every tick: sbps name once per squad id (AISquad -> PBG -> name: strategy_addon.ai:188,
-- strategy_unit_purchase.ai:104) and the melee flags (tactics.ai:280, 327)
local function scan_own(army)
	local own, exists = {}, {}
	local n = Military_SquadTotalCount(s_selfplayer)
	for i = 0, n - 1 do
		local aisq = Military_GetAISquadAtIndex(s_selfplayer, i)
		-- 0.6: every squad that is alive, also one in Elite's capture task (M.exists: "runner gone" = taken by that task, or dead?).
		-- AISquad_ConvertToSimSquad on such a squad: strategy_unit_purchase.ai r_models does it every units tick (in game since s17)
		local sq0 = aisq and AISquad_ConvertToSimSquad(aisq)                     -- nil for a squad that is not spawned
		if sq0 and Squad_Count(sq0) > 0 then exists[Squad_GetGameID(sq0)] = true end
		local sq = sq0 and not AISquad_InCaptureTask(aisq) and sq0                -- as main.ai 0.8 (hang fix)
		if sq and Squad_Count(sq) > 0 then
			local id = Squad_GetGameID(sq)
			if M.names[id] == nil then
				local pbg = AISquad_ConvertToPBG(aisq)
				local nm = pbg and PBG_GetName(pbg) or ""
				M.names[id] = string.gsub(string.lower(nm or ""), "\\", "/")
				-- 0.3: can this squad capture a point (strategy_unit_purchase.ai:170)? Asked once per squad; a squad that
				-- cannot is never a runner / split squad (a carnifex stood with a capture order it could not execute)
				M.cap[id] = (pbg ~= nil and api().cancap and PBG_CanCapture(s_selfplayer, pbg)) and true or false
			end
			own[id] = { meleed = AISquad_IsUnderMeleeAttack(aisq), mstance = AISquad_IsInMeleeStance(aisq) }
			if api().fired then own[id].fired = AISquad_HasFiredWeapon(aisq, prm("IdleFireTicks")) and true or false end   -- tactics.ai:292
		end

	end
	for _, u in ipairs(army) do if M.names[u.id] == nil then M.names[u.id] = "" end end
	M.own, M.exists = own, exists
	cap_check(army)
end

local function cls_of(name)                                                   -- melee / jump ability / repair ability / runner
	local c = M.cls[name]
	if c then return c end
	c = { melee = has_key(name, MELEE) or (prm("TieHeroes") >= 1 and has_key(name, MELEE_HEROES)), runner = has_key(name, RUNNER_KEYS) }
	for _, r in ipairs(REPAIRERS) do if string.find(name, r[1], 1, true) then c.repair = r[2]; break end end
	for _, j in ipairs(JUMPERS) do if string.find(name, j[1], 1, true) then c.jump = j[2]; break end end
	for _, g in ipairs(GAR_TOOLS) do if ends_with(name, g[1]) then c.gar, c.gar_abil, c.gar_w = g[2], g[3], g[4]; break end end   -- 0.3 Garrison
	if not c.gar and has_key(name, GAR_SIEGE) then c.siege = true end
	M.cls[name] = c
	return c
end
local function ucls(u) return cls_of(M.names[u.id] or "") end
-- a jump squad jumps on the target when it is JumpMin..JumpMax away (once per JumpCd), otherwise an attack order
local function attack_or_jump(u, e, now)
	local c = ucls(u)
	local d = d2(u.pos.x, u.pos.z, e.x, e.z)
	if c.jump and d >= prm("JumpMin") and d <= prm("JumpMax") and now - (M.jumped[u.id] or -1000) >= prm("JumpCd") then
		M.jumped[u.id] = now; M.st.jump = M.st.jump + 1
		morder(u.id, e.x, e.y, e.z, ORD_ABILITY_POS + c.jump)
		mlog("Jump", u.id, "->", e.id, fmt("d %.0f ability %d", d, c.jump))
	else
		morder(u.id, e.id, 0, 0, ORD_ATTACK_SQUAD)
	end
end

--------------------------------------------------------------------------------------------------
-- capturable points (targets.ai:453-495 pattern), every tick, numbers only: Elite rebuilds its military points, a kept
-- point object is a dead one (0.7 R6025). owner = team number or -1 (neutral)
local function scan_points()
	local pts, byk, hqs = {}, {}, {}
	local pw_api = (prm("PowerScan") >= 1 and type(Military_MilitaryPointIsSecuredPoint) == "function"
		and type(Military_GetCapturePointFromMilitaryPoint) == "function" and type(AIResource_GetCapturePointAddOnCount) == "function")
	local function add(mp, team, mine)
		if not Military_IsMilitaryPointValid(mp) then return end
		local t = Military_GetMilitaryPointType(mp)
		local p = Military_GetMilitaryPointPosition(mp)
		if not p then return end
		if t == MPT_HQ then
			if team ~= s_self_team then table.insert(hqs, { x = p.x, y = p.y, z = p.z }) end
			return
		end
		if t ~= MPT_VictoryPoint and t ~= MPT_PowerPoint and t ~= MPT_RequisitionPoint then return end
		local e = { x = p.x, y = p.y, z = p.z, vp = (t == MPT_VictoryPoint), pow = (t == MPT_PowerPoint), owner = team,
			dbase = Military_GetMilitaryPointDistanceToBase(s_selfplayer, mp),
			enemy_cap = Military_IsMilitaryPointBeingCapturedByEnemy(s_selfplayer, mp),
			us_cap = Military_IsMilitaryPointBeingCapturedByUs(s_selfplayer, mp) }
		e.key = fmt("%.0f/%.0f", e.x, e.z)
		e.ours = (team == s_self_team)
		e.mine = (e.ours and mine ~= false)                                     -- step 3: this player's own point (PowerMine=0: any point of the team)
		e.enemy = (team ~= -1 and team ~= s_self_team)
		-- 1.2 (TECH_RU.md 20.1): a power point of ours - has it its node (the structure every generator needs), and how many
		-- generators stand at it. The calls and their order are Elite's own for every military point (targets.ai:92-97); the
		-- purchase scripts read the sums (EliteAI.pw): a node is asked for only while a point lacks one
		if e.pow and e.ours and pw_api then
			e.sec = (Military_MilitaryPointIsSecuredPoint(mp) == true)
			if e.sec then
				local cp = Military_GetCapturePointFromMilitaryPoint(s_selfplayer, mp)
				if cp ~= nil then e.addons = AIResource_GetCapturePointAddOnCount(s_selfplayer, cp) end
			end
		end
		table.insert(pts, e); byk[e.key] = e
	end
	local n_pl = World_GetPlayerCount()
	local mine_on = (prm("PowerMine") >= 1 and type(Player_GetID) == "function" and s_selfplayerid ~= nil)
	for i = 1, n_pl do
		local pl = World_GetPlayerAt(i)
		if pl then
			local team = Player_GetTeam(pl)
			local mine = true
			if mine_on and team == s_self_team then mine = (Player_GetID(pl) == s_selfplayerid) end   -- (targets.ai:14-17: the same call on the same players)
			local cnt = Military_GetMilitaryPointCount(s_selfplayer, pl)
			for j = 0, cnt - 1 do add(Military_GetMilitaryPointAt(s_selfplayer, pl, j), team, mine) end
		end
	end
	local cnt = Military_GetNeutralMilitaryPointCount(s_selfplayer)
	for j = 0, cnt - 1 do add(Military_GetNeutralMilitaryPointAt(s_selfplayer, j), -1) end
	local k = prm("EnemyHalfK")
	for _, e in ipairs(pts) do                                                -- "enemy half": closer to an enemy HQ than to our base
		local dh
		for _, h in ipairs(hqs) do local d = d2(e.x, e.z, h.x, h.z); if not dh or d < dh then dh = d end end
		e.enemy_half = (dh ~= nil and e.dbase ~= nil and dh < e.dbase * k)
	end
	M.pts, M.pts_by_key, M.hqs = pts, byk, hqs
	if pw_api then                                                            -- numbers for the purchase scripts (strategy_unit_purchase.ai e_pw)
		local own, unsec, slots, sites = 0, 0, 0, {}
		for _, e in ipairs(pts) do
			if e.pow and e.ours and e.mine then
				own = own + 1
				local free = 0
				if not e.sec then unsec = unsec + 1
				elseif type(e.addons) == "number" then free = math.max(0, prm("PowerSlots") - e.addons); slots = slots + free end
				if not e.sec or free > 0 then table.insert(sites, { x = e.x, z = e.z }) end   -- where a node / a generator can be built (main.ai's order book)
			end
		end
		EliteAI.pw = { t = World_GetGameTime(), own = own, unsec = unsec, slots = slots, sites = sites }
	end
	return pts
end
-- 0.6 the memory of the points (numbers by point key): when an enemy squad last stood within RunnerPointR of it (pt_seen), when
-- it was last ours (pt_ours: a point that is not ours now and has an entry here was taken from us)
local function points_memory(en, now)
	local r = prm("RunnerPointR")
	for _, p in ipairs(M.pts) do
		if p.ours then M.pt_ours[p.key] = now end
		local _, n = enemy_weight_near(en, p.x, p.z, r)
		if n > 0 then M.pt_seen[p.key] = now end
	end
end
-- Conf_Decap: a point on the enemy half - neutralise only, or capture fully (victory points: always fully)
local function decap_only(p, en, now)
	if p.vp then return false end
	local r, v = rule("Decap"), "full"
	local ew = enemy_weight_near(en, p.x, p.z, prm("DecapEnemyR"))
	if r == 1 then
		if EliteAI.num("DecapOnly_EnemyHalf", 1) >= 1 and p.enemy_half then v = "decap" end
	elseif r == 2 then
		if p.enemy_half and ew > 0 then v = "decap" end
	else
		if ew > 0 then v = "decap" end
	end
	return decide("Decap", p.key, v, fmt("enemy_half %s enemies %.0f", tostring(p.enemy_half), ew), now) == "decap"
end
-- is the capture job at this point finished for us?
local function point_done(p, en, now)
	if p.ours then return true, "ours" end
	if not p.enemy and decap_only(p, en, now) then return true, "neutralised" end
	return false
end

--------------------------------------------------------------------------------------------------
-- ArmyRetreat / PreRetreat: one retreat state for both (M.retreat = { t0, reason, bx, bz, last })
-- 1.5 (step 4 of the vanilla base; VANILLA_BASE_RU.md 14.3) A VEHICLE IN THE ARMY'S RETREAT. A vehicle has no retreat (main.ai 0.16,
-- TECH_RU.md 15.8: "the order did nothing and the vehicle then stood 40 s"): the director leaves it in the army, FightLeave gives
-- it a plain move home, the Vehicles pattern takes a damaged one behind the infantry. The retreat of the WHOLE army did not know:
-- start_retreat / run_retreat gave every squad the retreat order, and while M.retreat lasts (15-75 s, 25 s on average in s3h)
-- this file returns before any other pattern and the director orders nothing - a vehicle kept the order it had (the attack-move
-- into the fight the infantry had just left) for the whole of it. s3h, 7 mirrors, after 12:00: of the 36 squads this side's IG
-- lost, 27 were lost within a minute of an "ArmyRetreat start" (the released AI's IG: 15 of 27), and the ids that vanish are
-- vehicles first (manticores 18 of 53, chimeras; the orks' deff dreads) - each one bought again for 270-300 req. Now a vehicle
-- gets a plain move to our HQ at the start and at every repeat (the order book lets a move through as any other).
-- Mech_RetreatVeh: 1 on the vanilla base, 0 on the Elite base (the released AI is not changed). "veh_home" in stats4.
local function retreat_order(u)
	local h = M.home
	if prm("RetreatVeh") >= 1 and u.veh and h then
		morder(u.id, h.x, u.pos.y, h.z, ORD_MOVE)
		M.st.veh_home = (M.st.veh_home or 0) + 1
		return
	end
	morder(u.id, u.pos.x, u.pos.y, u.pos.z, ORD_RETREAT)
end
local function start_retreat(state, reason, cx, cz, info)
	M.retreat = { t0 = state.now, reason = reason, bx = cx, bz = cz, last = state.now }
	M.punish, M.focus, M.split = nil, nil, nil
	for _, u in ipairs(state.active) do retreat_order(u) end
	M.st[reason] = M.st[reason] + 1
	mlog(reason == "pre" and "PreRetreat" or "ArmyRetreat", "start", info, "squads", table.getn(state.active), "t", math.floor(state.now))
	EliteAI.phase = "m_retreat"
end
local function run_retreat(state, en, cx, cz, h)
	local r, now = M.retreat, state.now
	if now - r.last >= 9 then                                                 -- keep those still out there going home
		r.last = now
		for _, u in ipairs(state.active) do
			if not h or d2(u.pos.x, u.pos.z, h.x, h.z) > prm("HomeR") then retreat_order(u) end
		end
	end
	EliteAI.phase = "m_retreat"
	if now - r.t0 < prm("RetreatHold") then return true end
	local ours, there, athome, zr = our_weight(state.army), 0, 0, prm("ZoneR") * 1.2
	for _, e in ipairs(en) do
		if d2(e.x, e.z, r.bx, r.bz) <= zr then there = there + e.w end
		if h and d2(e.x, e.z, h.x, h.z) <= prm("HomeR") then athome = athome + e.w end
	end
	local why
	if athome > 0 then why = "enemy at home"
	elseif there <= ours * prm("ReturnRatio") then why = "enemy gone or we recovered"
	elseif now - r.t0 > prm("RetreatMax") then why = "timeout" end
	if why then
		mlog(r.reason == "pre" and "PreRetreat" or "ArmyRetreat", "end", why, fmt("there %.0f ours %.0f after %.0f s", there, ours, now - r.t0))
		M.retreat = nil
		return false                                                          -- the director resumes this tick
	end
	return true
end
-- Conf_HoldVP: a victory point under our feet raises the retreat threshold (rule 1: never, 2: while we lose the ticker
-- race, 3: always)
local function hold_vp_mult(cx, cz, now)
	local r = rule("HoldVP")
	local v = "normal"
	if r >= 2 then
		local vp
		for _, p in ipairs(M.pts) do
			if p.vp and (p.ours or p.us_cap) and d2(p.x, p.z, cx, cz) <= prm("VPHoldR") then vp = p; break end
		end
		if vp then
			local losing = cache and cache.self_vp_tickers and cache.enemy_vp_tickers and cache.self_vp_tickers < cache.enemy_vp_tickers
			if r == 3 or losing then v = "hold" end
		end
	end
	v = decide("HoldVP", "army", v, "", now)
	return v == "hold" and prm("HoldVPMult") or 1
end
-- the enemy in the fight zone outweighs us -> go home before the squads are broken one by one
-- 1.3 (TECH_RU.md 21.5) THE FIGHT WHERE IT IS. Malum's log (fb 621, grey knights): "ArmyRetreat start enemy 2635 ours 485 ratio 5.44
-- squads 2", "enemy 1601 ours 853 ratio 1.88 squads 2" - the retreat came when two squads were left of seven. The old check
-- weighed the enemy within ZoneR of the CENTRE of all active squads against ALL of them: a squad that had just left the base
-- pulled the centre away from the fight and counted as its strength. X.fight finds the fight - the squad of the line with
-- the most enemy strength within FightR of it, the others in contact around it - and weighs what is THERE: ours at the fight,
-- half of ours within FightSupportR (they arrive), the enemy at the fight. Lost at RetreatLocalRatio (1.4), or by the TRADE
-- (TradeSecs in, we lost TradeLoss of our best strength there, the enemy less than half that share, and he outweighs us).
-- Who leaves: the whole army when the squads at the fight are FightArmyShare of it (as before: M.retreat), else only they
-- ("MECH FightLeave ...": a retreat order each, EliteAI.retreating - the director keeps them out of the army until they are home
-- and healthy or RetreatSecs have passed). The old check still runs after it. Mech_RetreatLocal=0 = 1.2.
function X.fight(state, en)
	local sr, fr = prm("SightR"), prm("FightR")
	local best, bw
	for _, u in ipairs(state.active) do
		if not M.runner[u.id] and not X.is_raider(u.id) then
			local inf, w = u.hit, 0
			for _, e in ipairs(en) do
				local d = d2(e.x, e.z, u.pos.x, u.pos.z)
				if d <= fr then w = w + e.w end
				if not inf and e.contact and d <= sr then inf = true end
			end
			if inf and w > 0 and (not best or w > bw or (w == bw and u.id < best.id)) then best, bw = u, w end
		end
	end
	if not best then return nil end
	local F = { x = best.pos.x, z = best.pos.z, ours = 0, sup = 0, enw = 0, n = 0, ids = {} }
	for _, u in ipairs(state.active) do
		local d = d2(u.pos.x, u.pos.z, F.x, F.z)
		if d <= fr then F.ours, F.n = F.ours + weight_of(u), F.n + 1; table.insert(F.ids, u.id)
		elseif d <= prm("FightSupportR") and not M.runner[u.id] and not X.is_raider(u.id) then F.sup = F.sup + weight_of(u) end
	end
	for _, e in ipairs(en) do if d2(e.x, e.z, F.x, F.z) <= fr then F.enw = F.enw + e.w end end
	return F
end
local function check_army_retreat(state, en, cx, cz, h)
	if not h then return false end
	local now = state.now
	local F = (prm("RetreatLocal") >= 1) and X.fight(state, en) or nil
	local vpm = hold_vp_mult(F and F.x or cx, F and F.z or cz, now)
	if F and d2(F.x, F.z, h.x, h.z) > prm("HomeR") then
		local T = M.trade
		if T == nil or now - T.last > 12 or d2(T.x, T.z, F.x, F.z) > prm("FightSupportR") then T = { t0 = now, opk = F.ours, epk = F.enw } end
		T.last, T.x, T.z = now, F.x, F.z
		if F.ours > T.opk then T.opk = F.ours end
		if F.enw > T.epk then T.epk = F.enw end
		M.trade = T
		local ours = F.ours + F.sup * prm("FightSupportK")
		-- (next to our base - within EngageHomeR of the HQ - the army stands longer: the old ratio on the numbers of the fight, no trade rule)
		local at_home = d2(F.x, F.z, h.x, h.z) <= prm("EngageHomeR")
		local need = (at_home and prm("RetreatRatio") or prm("RetreatLocalRatio")) * vpm
		local why = nil
		if F.enw >= prm("RetreatMinW") and F.enw >= ours * need then
			why = fmt("enemy %.0f ours %.0f (+%.0f near) ratio %.2f need %.2f at the fight", F.enw, F.ours, F.sup, F.enw / math.max(ours, 1), need)
		elseif prm("Trade") >= 1 and not at_home and now - T.t0 >= prm("TradeSecs") and F.enw >= prm("RetreatMinW")
			and F.ours <= T.opk * (1 - prm("TradeLoss")) and F.enw >= T.epk * (1 - prm("TradeLoss") * prm("TradeEnemyK"))
			and F.enw >= ours * prm("TradeRatio") * vpm then
			why = fmt("trade: ours %.0f of %.0f, the enemy %.0f of %.0f after %.0f s", F.ours, T.opk, F.enw, T.epk, now - T.t0)
			M.st.trade = (M.st.trade or 0) + 1
		end
		if why then
			local line = 0
			for _, u in ipairs(state.active) do if not M.runner[u.id] and not X.is_raider(u.id) then line = line + weight_of(u) end end
			M.trade = nil
			if F.ours + F.sup >= line * prm("FightArmyShare") then
				M.st.fight_army = (M.st.fight_army or 0) + 1
				start_retreat(state, "retreat", F.x, F.z, why)
				return true
			end
			-- a detachment: only the squads at the fight leave, the army goes on
			local gone = {}
			for _, id in ipairs(F.ids) do gone[id] = true end
			for i = table.getn(state.active), 1, -1 do
				local u = state.active[i]
				if gone[u.id] then
					if u.veh then
						morder(u.id, h.x, u.pos.y, h.z, ORD_MOVE)                        -- a vehicle has no retreat (main.ai 0.16): a plain move towards home, the army's next tick
					else
						morder(u.id, u.pos.x, u.pos.y, u.pos.z, ORD_RETREAT)
						if type(EliteAI.retreating) == "table" then EliteAI.retreating[u.id] = now end
					end
					table.remove(state.active, i)
				end
			end
			if M.fl_t == nil or now - M.fl_t >= 15 then                           -- (a vehicle is still the army's next tick: one line per 15 s)
				M.fl_t = now
				M.st.fight_leave = (M.st.fight_leave or 0) + 1
				mlog("FightLeave", F.n, "squads", why, fmt("the army %.0f is elsewhere", line))
			end
		end
	end
	if d2(cx, cz, h.x, h.z) <= prm("HomeR") then return false end
	local zr, enw = prm("ZoneR"), 0
	for _, e in ipairs(en) do if e.d <= zr then enw = enw + e.w end end
	if enw < prm("RetreatMinW") then return false end
	local ours = our_weight(state.active)
	local ratio = prm("RetreatRatio") * vpm
	if enw >= ours * ratio then
		start_retreat(state, "retreat", cx, cz, fmt("enemy %.0f ours %.0f ratio %.2f need %.2f", enw, ours, enw / math.max(ours, 1), ratio))
		return true
	end
	return false
end
-- a big force is coming at us from the flank/rear (approaching squads outside the zone, direction off the fight axis);
-- Conf_PreEngage: 1 = retreat as computed, 2 = finish a fight we are winning first, 3 = flank forces only, higher bar
local function check_pre_retreat(state, en, cx, cz, h)
	if not h or d2(cx, cz, h.x, h.z) <= prm("HomeR") then return false end
	local now, r = state.now, rule("PreEngage")
	local zr, pr, close = prm("ZoneR"), prm("PreR"), prm("PreClose")
	local zonew, nearest = 0, nil
	for _, e in ipairs(en) do
		if e.d <= zr then zonew = zonew + e.w; if not nearest or e.d < nearest.d then nearest = e end end
	end
	local rx, rz                                                              -- the fight axis: nearest enemy in the zone, else the attack target
	if nearest then rx, rz = nearest.x - cx, nearest.z - cz
	elseif EliteAI.best_pos then rx, rz = EliteAI.best_pos.x - cx, EliteAI.best_pos.z - cz end
	local rl = rx and math.sqrt(rx * rx + rz * rz) or 0
	local frontw = (r == 3) and 0 or prm("PreFrontW")
	local cosmin, inc, ninc, flank = math.cos(prm("PreAngle") * math.pi / 180), 0, 0, 0
	for _, e in ipairs(en) do
		if e.d > zr and e.d <= pr then
			local app = approach(e, cx, cz)
			if app and app >= close then
				local wgt = 1
				if rl > 0 then
					local vx, vz = e.x - cx, e.z - cz
					local vl = math.sqrt(vx * vx + vz * vz)
					local c = vl > 0 and (vx * rx + vz * rz) / (vl * rl) or 1
					if c >= cosmin then wgt = frontw else flank = flank + 1 end
				else flank = flank + 1 end
				inc, ninc = inc + e.w * wgt, ninc + 1
			end
		end
	end
	if ninc == 0 or inc < prm("PreMinW") then return false end
	local ours = our_weight(state.active)
	local need = prm("PreRatio") * ((r == 3) and 1.3 or 1)
	local v = "retreat"
	if zonew + inc < ours * need then v = "stay"
	elseif r == 2 and zonew > 0 and zonew < ours * prm("PreWinK") then v = "engage" end
	v = decide("PreEngage", "army", v, fmt("incoming %.0f zone %.0f ours %.0f", inc, zonew, ours), now)
	if v == "retreat" then
		start_retreat(state, "pre", cx, cz, fmt("incoming %.0f (%d squads, %d flank) zone %.0f ours %.0f", inc, ninc, flank, zonew, ours))
		return true
	end
	return false
end

--------------------------------------------------------------------------------------------------
-- PunishTurn: an enemy squad that took damage and moves away from us -> the army (jump squads by jumping) hits its back,
-- while the enemy in the zone is not stronger than us and not far from our HQ. Conf_Chase: 1 = only squads near the
-- target chase, the rest regroup at the centre; 2 = chase only with a compact army, else regroup; 3 = everybody chases
local function run_punish(state, en, cx, cz, h, taken)
	local now, p, zr, enw = state.now, M.punish, prm("ZoneR"), 0
	for _, e in ipairs(en) do if e.d <= zr then enw = enw + e.w end end
	local ratio = enw / math.max(our_weight(state.active), 1)
	local byid = {}
	for _, e in ipairs(en) do byid[e.id] = e end
	if p then
		local e, why = byid[p.id], nil
		if not e then why = "target gone"
		elseif now - p.t0 > prm("PunishSecs") then why = "timeout"
		elseif e.d > prm("PunishLostR") then why = "too far"
		elseif h and d2(e.x, e.z, h.x, h.z) > prm("PunishMaxHome") then why = "too far from home"
		elseif ratio > prm("PunishMaxRatio") * 1.3 then why = "enemy too strong" end
		if why then mlog("PunishTurn", "end", why, "target", p.id, fmt("after %.0f s", now - p.t0)); M.punish = nil; p = nil end
	end
	if not p then
		if ratio > prm("PunishMaxRatio") then return false end
		local best
		for _, e in ipairs(en) do
			if e.contact and not e.nogo and e.d <= prm("PunishR") and (not h or d2(e.x, e.z, h.x, h.z) <= prm("PunishMaxHome")) then
				local app = approach(e, cx, cz)
				if app and -app >= prm("PunishMove") and (e.hp < e.php - 0.03 or e.hp <= prm("PunishHp")) then
					if not best or e.hp < best.hp or (e.hp == best.hp and e.d < best.d) then best = e end
				end
			end
		end
		if not best then return false end
		p = { id = best.id, t0 = now }
		M.punish, M.st.punish = p, M.st.punish + 1
		mlog("PunishTurn", "start", "target", best.id, fmt("hp %.2f d %.0f %s ratio %.2f", best.hp, best.d, best.veh and "veh" or "inf", ratio))
	end
	local e = byid[p.id]
	local r, v = rule("Chase"), "all"
	if r == 1 then v = "near" elseif r == 2 then v = (spread_of(state.active, cx, cz) <= EliteAI.num("GatherR", 30)) and "all" or "regroup" end
	v = decide("Chase", "army", v, fmt("target %d spread %.0f", e.id, spread_of(state.active, cx, cz)), now)
	if v == "regroup" then M.punish = nil; return false end                   -- the director gathers the army instead
	local n = 0
	for _, u in ipairs(state.active) do
		if not taken[u.id] then
			if v == "all" or d2(u.pos.x, u.pos.z, e.x, e.z) <= prm("ChaseR") then attack_or_jump(u, e, now)
			else morder(u.id, cx, u.pos.y, cz, ORD_MOVE) end
			taken[u.id] = true; n = n + 1
		end
	end
	EliteAI.phase = "m_punish"
	return n > 0
end

--------------------------------------------------------------------------------------------------
-- FocusFire: everybody shoots the most vulnerable enemy squad in contact (low health, few models, valuable and hurt),
-- with inertia so the target does not flip every tick. Conf_FocusLeave for a squad under fire that would have to leave
-- its spot: 1 = it stays and keeps its own fight, 2 = it goes only for a nearly dead target, 3 = it always goes
local function run_focus(state, en, cx, cz, taken)
	local now, fr, fn = state.now, prm("FocusR"), prm("FocusNear")
	local hits = {}
	for _, u in ipairs(state.active) do if u.hit then table.insert(hits, u) end end
	local best, bests, cur, curs
	local vt = nil
	local av_on = mech_on("Counter") and prm("CounterAvFocus") >= 1
	for _, e in ipairs(en) do
		-- (0.7: nor is an enemy under the guns of a turret the army stays away from - e.nogo, the Defence pattern)
		if e.contact and not e.gar and not e.nogo then                         -- 0.3: a garrison is the Garrison pattern's (storm or leave), not a focus target
			local near = e.d <= fr
			if not near then for _, u in ipairs(hits) do if d2(e.x, e.z, u.pos.x, u.pos.z) <= fn then near = true; break end end end
			if near then
				local s = (1 - e.hp) * prm("FocusHpW") + (1 / math.max(e.n, 1)) * prm("FocusCntW")
					+ math.min(e.hmax / 1500, 2) * (1 - e.hp) * prm("FocusValW") - (e.d / fr) * prm("FocusDistW")
				if e.hit then s = s + 0.3 end
				if e.veh and e.hp > 0.4 then s = s - prm("FocusVehPen") end
				-- 0.7 (Orca, fb 511 / 513): set-up teams and support heroes first - a heavy weapon that is set up pins the whole
				-- army, a healer / a shield undoes the focus on everything else
				if e.setup then s = s + prm("FocusSetupW") elseif e.support then s = s + prm("FocusSupportW")
				elseif X.has_cls(e, "detector") then s = s + prm("FocusDetectW") end   -- 0.9 (fb 513: detectors among the first targets)
				if M.focus_force == e.id then s = s + 5 end                      -- Conf_MeleeApproach rule 3: shoot the attacker
				if not best or s > bests or (s == bests and e.id < best.id) then best, bests = e, s end
				if M.focus and e.id == M.focus.id then cur, curs = e, s end
				-- 1.0: the vehicle our anti-vehicle squads shoot (the most hurt one, then the lower id)
				if (e.veh or X.has_cls(e, "vehicle")) and (not vt or e.hp < vt.hp or (e.hp == vt.hp and e.id < vt.id)) then vt = e end
			end
		end
	end
	if not best then
		if M.focus then mlog("FocusFire", "end", "no target", fmt("after %.0f s", now - M.focus.t0)); M.focus = nil end
		return false
	end
	local pick, picks = best, bests
	if cur and (now - M.focus.t0 < prm("FocusMinSecs") or curs >= bests - prm("FocusKeep")) then pick, picks = cur, curs end
	if not M.focus or M.focus.id ~= pick.id then
		if M.focus then M.st.focus_sw = M.st.focus_sw + 1 end
		M.focus = { id = pick.id, t0 = now }
		M.st.focus = M.st.focus + 1
		mlog("FocusFire", "target", pick.id, fmt("hp %.2f n %d hmax %.0f d %.0f %s score %.2f", pick.hp, pick.n, pick.hmax, pick.d, pick.veh and "veh" or "inf", picks))
		local pc = (pick.setup and "setup") or (pick.support and "support") or (X.has_cls(pick, "detector") and "detector") or nil
		if pc then
			M.st.cn_focus = (M.st.cn_focus or 0) + 1
			X.clog("focus", "target", pick.id, "class", pc, fmt("score %.2f d %.0f hp %.2f", picks, pick.d, pick.hp))
		end
	end
	local n, r = 0, rule("FocusLeave")
	for _, u in ipairs(state.active) do
		if not taken[u.id] then
			-- 1.0 (Orca fb 529: the dreadnought was ignored): a squad with an anti-vehicle weapon shoots the vehicle, whatever the
			-- army's target is (Mech_CounterAvFocus=0 = the army's target for everybody)
			local tgt = pick
			if av_on and vt ~= nil and vt.id ~= pick.id and X.is_av(M.names[u.id]) then
				tgt = vt
				M.av_said = M.av_said or {}
				if now - (M.av_said[u.id] or -1000) >= prm("CounterLogSecs") then
					M.av_said[u.id] = now
					M.st.cn_av = (M.st.cn_av or 0) + 1
					X.clog("focus", "av", u.id, string.gsub(M.names[u.id] or "", "^.*/", ""), "-> vehicle", vt.id, fmt("hp %.2f d %.0f", vt.hp, d2(u.pos.x, u.pos.z, vt.x, vt.z)),
						"(the army's target", pick.id .. ")")
				end
			end
			local go, d = true, d2(u.pos.x, u.pos.z, tgt.x, tgt.z)
			if u.hit and d > prm("FocusLeaveR") then                             -- it would leave its spot under fire
				local v = "go"
				if r == 1 then v = "stay" elseif r == 2 then v = (tgt.hp < prm("FocusLeaveHp")) and "go" or "stay" end
				-- 1.1 (the polygon's scene d, r15: "Conf_FocusLeave 50009: stay->go, go->stay, stay->go in 18 s" - three targets,
				-- one after the other, each with its own answer): the subject is the squad and its target, not the squad alone
				go = decide("FocusLeave", u.id .. ">" .. tgt.id, v, fmt("target %d d %.0f hp %.2f", tgt.id, d, tgt.hp), now) == "go"
			end
			if go then morder(u.id, tgt.id, 0, 0, ORD_ATTACK_SQUAD) end         -- "stay": no order, it keeps its own fight
			taken[u.id] = true; n = n + 1
		end
	end
	EliteAI.phase = "m_focus"
	return n > 0
end

--------------------------------------------------------------------------------------------------
-- Conf_MeleeApproach: an enemy melee squad is coming at one of our ranged squads - hold the spot (cover, friends) or kite
-- away. 1 = hold with MeleeHoldFriends friends near, else kite; 2 = kite when the attacker is stronger; 3 = never kite,
-- the army focuses the attacker (M.focus_force)
local function run_melee_approach(state, en, cx, cz, taken)
	local now, n, tr = state.now, 0, prm("MeleeThreatR")
	for _, u in ipairs(state.active) do
		if not taken[u.id] and not ucls(u).melee then
			weight_of(u)
			if not u.veh then
				local thr, thd
				for _, e in ipairs(en) do
					if not e.veh and e.px and not (e.tdist and e.tdist >= prm("RangedMinD")) then
						local d = d2(e.x, e.z, u.pos.x, u.pos.z)
						if d <= tr and d2(e.px, e.pz, u.pos.x, u.pos.z) - d >= prm("MeleeClose") and (not thr or d < thd) then thr, thd = e, d end
					end
				end
				local o = M.own[u.id]
				if thr and not (o and o.meleed) then                           -- already in melee: kiting is too late, the director's RetreatHP handles it
					local r, v = rule("MeleeApproach"), "hold"
					if r == 1 then
						local friends = 0
						for _, f in ipairs(state.active) do if f.id ~= u.id and d2(f.pos.x, f.pos.z, u.pos.x, u.pos.z) <= prm("FriendR") then friends = friends + 1 end end
						if friends < prm("MeleeHoldFriends") then v = "kite" end
					elseif r == 2 then
						if thr.w > weight_of(u) * prm("MeleeKiteK") then v = "kite" end
					else
						M.focus_force = thr.id
					end
					v = decide("MeleeApproach", u.id, v, fmt("melee %d d %.0f w %.0f/%.0f", thr.id, thd, thr.w, weight_of(u)), now)
					if v == "kite" then
						local ax, az = u.pos.x - thr.x, u.pos.z - thr.z
						local al = math.sqrt(ax * ax + az * az)
						if al < 1 then ax, az = cx - u.pos.x, cz - u.pos.z; al = math.max(math.sqrt(ax * ax + az * az), 1) end
						local k = prm("KiteD") / al
						morder(u.id, u.pos.x + ax * k, u.pos.y, u.pos.z + az * k, ORD_MOVE)
						taken[u.id] = true; n = n + 1; M.st.kite = M.st.kite + 1
					end
				end
			end
		end
	end
	return n
end

--------------------------------------------------------------------------------------------------
-- MeleeTie: our melee squads (jump squads by jumping) go into the enemy's ranged squads - the ones shooting their target
-- from a distance - to tie them up. jumpers_only: Conf_TieVsFocus rule 3
local function run_tie(state, en, taken, jumpers_only)
	local now, tr, rmin, n = state.now, prm("TieR"), prm("RangedMinD"), 0
	local byid = {}
	for _, e in ipairs(en) do byid[e.id] = e end
	for _, u in ipairs(state.active) do
		local c = ucls(u)
		if not taken[u.id] and u.hp >= prm("TieMinHP") and c.melee and (not jumpers_only or c.jump) then
			local t = M.tie[u.id]
			local e = t and byid[t.id]
			if e and (now - t.t0 > prm("TieSecs") or d2(u.pos.x, u.pos.z, e.x, e.z) > tr * 1.3) then e = nil end
			if not e then
				local best, bd
				for _, f in ipairs(en) do
					if f.contact and not f.veh and not f.held and f.tdist and f.tdist >= rmin then   -- 0.3: nobody ties up a squad inside a building
						local d = d2(u.pos.x, u.pos.z, f.x, f.z)
						if d <= tr then
							local s = d / tr + f.hp                                -- close and hurt first
							if not best or s < bd or (s == bd and f.id < best.id) then best, bd = f, s end
						end
					end
				end
				if best then
					e = best; M.tie[u.id] = { id = e.id, t0 = now }; M.st.tie = M.st.tie + 1
					mlog("MeleeTie", u.id, "->", e.id, fmt("hp %.2f d %.0f shooting from %.0f", e.hp, d2(u.pos.x, u.pos.z, e.x, e.z), e.tdist))
				else M.tie[u.id] = nil end
			end
			if e then attack_or_jump(u, e, now); taken[u.id] = true; n = n + 1 end
		end
	end
	return n
end

--------------------------------------------------------------------------------------------------
-- Repair: repair-capable squads (REPAIRERS) repair our damaged vehicles out of combat (no enemy near either of them).
-- Conf_RepairVsFight: 1 = stop at RepairSafeR; 2 = a repair in progress on a badly damaged vehicle goes on down to
-- RepairSafeR2; 3 = no repair at all while the army is in a fight
local function run_repair(state, en, taken)
	local now, n, r = state.now, 0, rule("RepairVsFight")
	local infight = M.last_contact and now - M.last_contact <= prm("AbilFightSecs")
	local function threatened(x, z, rad)
		for _, e in ipairs(en) do if d2(e.x, e.z, x, z) <= rad then return true end end
		return false
	end
	local byid, act, vehs = {}, {}, {}
	for _, u in ipairs(state.active) do act[u.id] = true end
	for _, u in ipairs(state.army) do                                          -- vehicles: also the ones sent home
		byid[u.id] = u
		weight_of(u)
		if u.veh and u.hp < prm("RepairHP") and not u.hit and not threatened(u.pos.x, u.pos.z, prm("RepairSafeR")) then table.insert(vehs, u) end
	end
	-- current assignments (sorted: no dependence on the order of pairs())
	local rids, assigned = {}, {}
	for rid in pairs(M.repair) do table.insert(rids, rid) end
	table.sort(rids)
	for _, rid in ipairs(rids) do
		local a = M.repair[rid]
		local u, v = byid[rid], byid[a.vid]
		local safe = prm("RepairSafeR")
		if r == 2 and v and v.hp < prm("RepairKeepHp") then safe = prm("RepairSafeR2") end
		local ok = u and v and act[rid] and not taken[rid] and u.hp >= 0.4 and not u.hit and v.hp < prm("RepairDoneHP")
			and now - a.t0 <= prm("RepairSecs") and not threatened(u.pos.x, u.pos.z, safe) and not threatened(v.pos.x, v.pos.z, safe)
			and d2(u.pos.x, u.pos.z, v.pos.x, v.pos.z) <= prm("RepairMaxD")
		if ok and r == 3 and infight then ok = false end
		if ok and u and v and threatened(v.pos.x, v.pos.z, 60) then         -- the conflict is real: log the decision
			ok = decide("RepairVsFight", rid, "repair", fmt("vehicle %d hp %.2f", a.vid, v.hp), now) == "repair"
		end
		if ok then assigned[a.vid] = rid
		else
			M.repair[rid] = nil
			if u and v and threatened(v.pos.x, v.pos.z, 60) then decide("RepairVsFight", rid, "fight", fmt("vehicle %d hp %.2f", a.vid, v.hp), now) end
			mlog("Repair", "end", rid, "vehicle", a.vid, v and fmt("hp %.2f", v.hp) or "gone", fmt("after %.0f s", now - a.t0))
		end
	end
	-- new assignments: the most damaged vehicle first, the nearest free repairer
	if not (r == 3 and infight) then
		table.sort(vehs, function(a, b) if a.hp ~= b.hp then return a.hp < b.hp end return a.id < b.id end)
		for _, v in ipairs(vehs) do
			if not assigned[v.id] then
				local best, bd
				for _, u in ipairs(state.active) do
					if not taken[u.id] and not M.repair[u.id] and u.id ~= v.id and u.hp >= 0.4 and not u.hit and ucls(u).repair then
						local d = d2(u.pos.x, u.pos.z, v.pos.x, v.pos.z)
						if d <= prm("RepairMaxD") and (not best or d < bd or (d == bd and u.id < best.id)) and not threatened(u.pos.x, u.pos.z, prm("RepairSafeR")) then best, bd = u, d end
					end
				end
				if best then
					M.repair[best.id] = { vid = v.id, t0 = now }
					assigned[v.id] = best.id
					M.st.repair = M.st.repair + 1
					mlog("Repair", best.id, "->", "vehicle", v.id, fmt("hp %.2f d %.0f ability %d", v.hp, bd, ucls(best).repair))
				end
			end
		end
	end
	local vids = {}
	for vid in pairs(assigned) do table.insert(vids, vid) end
	table.sort(vids)
	for _, vid in ipairs(vids) do
		local rid = assigned[vid]
		local c = cls_of(M.names[rid] or "")
		if c.repair then
			morder(rid, vid, 0, 0, ORD_ABILITY_SQUAD + c.repair)
			taken[rid] = true
			if act[vid] then taken[vid] = true end                            -- the vehicle stays put while being repaired
			n = n + 1
		end
	end
	return n
end

--------------------------------------------------------------------------------------------------
-- RaceAbilities: the race's global (player) abilities through Elite's own player_abilities.ai, which on its own hardly
-- ever casts them: BUDGET_PlayerAbility gets ~9 % of the income, AITacticDemand_Default returns 5 (-5..5 random, > 1
-- needed), and a targeted ability needs PositionTargetFilter_EnemyClumpPosition = a clump the AI "sees" with threat >= 2,
-- else the money is held and nothing is cast. Here: the budget weight is raised, the demand is ours (in a fight: high;
-- spawn abilities: moderate at any time) and when Elite finds no clump, the biggest enemy clump in contact with the
-- army is the target. Conf_AbilitySave: 1 = in a fight (spawns any time); 2 = damage abilities only on a real clump;
-- 3 = whenever castable
--
-- 0.6 (TECH_RU.md 14) THE ABILITIES ARE PART OF THE GAME. s17 (newai-12): the tyranids cast no call-in in 13 minutes. A
-- call-in (a global that brings squads for req: SPAWN_KEYS and a req cost - every race has them, 300-650 req) can be cast
-- only in the ticks the bank holds its price, and those are the ticks a unit of the plan has its money; the "save" state
-- (on for 434 of 690 s) made every spawn ability "no candidate" before the arbiter below ever saw it. But a call-in IS a
-- unit, bought through another channel: it needs no HQ, it lands where the fight is, and it is paid in part with the red
-- resource that lies idle otherwise ("without number": two broods for 300 req - s12, squads 8 -> 10). Now:
--  * the save state holds nothing by itself; what is decided is "this ability or the unit the plan waits for", in one
--    place (Conf_AbilityVsUnit below), and no hold lasts for ever (AbilHoldMax);
--  * an ability goes when it gives more than the unit for the same money: a call-in that brings more than its price
--    ("bargain", RA_WORTH), a call-in on a raid at our base / at a point of ours they are taking / at our power point with
--    no squad of ours there ("defend"), a call-in into the fight the army is in ("fight": the squad is there now, the unit
--    of the plan in a minute and a half), a call-in that arrives at the HQ while the unit is far ("unit_far"); or when the
--    bank pays both (nothing is held then, as before);
--  * a call-in never lands on a clump far from the army (Elite's own target): only on the clump in contact or the raid;
--  * a targeted ability with nowhere to go is no candidate (was: chosen, "no target", and its cost locked off the budgets
--    after this one, util/budget.ai:345 - a spore without a target took 350 req off the units budget of that tick);
--  * a squad-targeted ability (the buffs: gk_buff_target_*, ork_buff_target_*, eld / sm / tyr_buff_target_damage ...) is no
--    candidate either: neither Elite's nor Relic's PlayerAbility_CastOnTarget has a branch for it, and the engine has no
--    Request_PlayerAbility* / Command_Player*Ability for a squad target (names of DOW2.exe) - "no target" every tick was
--    all it ever did (Orca's match: gk_buff_target_damage x8 every 30 s);
--  * a call-in that was cast counts as the unit bought (EliteAI_UnitCallIn of strategy_unit_purchase.ai: line "callin",
--    the save state ends as with a unit, the wait for the plan's unit starts anew).
local function ra_on() return EliteAI.on and mech_on("RaceAbilities") end
local function ra_name(pbg) return string.lower(PBG_GetName(pbg) or "") end  -- player_abilities.ai:60
local function ra_cost(pbg)                                                   -- req, power (player_abilities.ai:259)
	local c = AIAbility_GetCost(s_self_modplayer, pbg)
	return (c and c.requisition) or 0, (c and c.power) or 0
end
local function ra_worth(name, cr)                                             -- the req worth of what a call-in brings (RA_WORTH; else its own price)
	for _, w in ipairs(RA_WORTH) do if string.find(name, w[1], 1, true) then return w[2] end end
	return cr
end
-- the fight in numbers, once per tick (nothing but numbers is kept): M.clump = the biggest clump of enemies in contact with
-- no squad of ours on it (friendly fire: the target of the damage abilities); M.clump_any = the biggest clump in contact
-- whoever stands on it (a call-in lands among its own melee squads too - an army of hormagaunts has no other clump);
-- M.fight = { ew, n, ow } - the enemy in contact around the army and our weight there; M.raid = enemy squads (AbilRaidMax at
-- most) at our HQ, at a point of ours they are taking or at our power point, with no squad of ours within AbilRaidFriendR -
-- where a call-in defends
local function ra_clump(en, cx, cz, army, h)
	local best, bw, bn
	local any, aw, an
	local cr, fr, ar = prm("AbilClumpR"), prm("AbilFriendR"), prm("AbilR")
	local ew, ecnt = 0, 0
	for _, e in ipairs(en) do
		if e.contact and e.d <= ar then
			ew, ecnt = ew + e.w, ecnt + 1
			local w, n = enemy_weight_near(en, e.x, e.z, cr)
			local friend = false
			for _, u in ipairs(army) do if d2(u.pos.x, u.pos.z, e.x, e.z) <= fr then friend = true; break end end
			if not friend and (not best or w > bw or (w == bw and e.id < best.id)) then best, bw, bn = e, w, n end
			if not e.held and (not any or w > aw or (w == aw and e.id < any.id)) then any, aw, an = e, w, n end
		end
	end
	if best then M.clump = { x = best.x, y = best.y, z = best.z, n = bn, w = bw, id = best.id } else M.clump = nil end
	if any then M.clump_any = { x = any.x, y = any.y, z = any.z, n = an, w = aw, id = any.id } else M.clump_any = nil end
	local ow = 0
	for _, u in ipairs(army) do if d2(u.pos.x, u.pos.z, cx, cz) <= ar then ow = ow + weight_of(u) end end
	M.fight = { ew = ew, n = ecnt, ow = ow }
	local raid, rw
	local rr, pr, ffr, rmax = prm("AbilRaidR"), prm("AbilRaidPointR"), prm("AbilRaidFriendR"), prm("AbilRaidMax")
	for _, e in ipairs(en) do
		if not e.held then
			local kind = nil
			if h and d2(e.x, e.z, h.x, h.z) <= rr then kind = "base"
			else
				for _, p in ipairs(M.pts or {}) do
					if p.ours and (p.enemy_cap or p.pow) and d2(e.x, e.z, p.x, p.z) <= pr then kind = (p.enemy_cap and "point " or "power ") .. p.key; break end
				end
			end
			if kind then
				local friend = false
				for _, u in ipairs(army) do if d2(u.pos.x, u.pos.z, e.x, e.z) <= ffr then friend = true; break end end
				if not friend then
					local w, n = enemy_weight_near(en, e.x, e.z, cr)
					if n <= rmax and (not raid or w > rw or (w == rw and e.id < raid.id)) then
						raid, rw = { x = e.x, y = e.y, z = e.z, n = n, w = w, id = e.id, kind = kind }, w
					end
				end
			end
		end
	end
	M.raid = raid
	-- 0.8 (TECH_RU.md 16.4; s19: tyranids 0 casts - the engine let a targeted ability be cast in 5 ticks of the match, each
	-- time nobody was fighting: "nowhere to go" = no candidate). The spot next to the army: its squad nearest to the centre,
	-- AbilQuietOff towards our HQ (not on the squads' heads). Numbers only
	local q = nil
	if prm("AbilQuiet") >= 1 then
		local bu, bd
		for _, u in ipairs(army) do
			local d = d2(u.pos.x, u.pos.z, cx, cz)
			if not bd or d < bd or (d == bd and u.id < bu.id) then bu, bd = u, d end
		end
		if bu then
			local qx, qz = bu.pos.x, bu.pos.z
			if h then
				local dx, dz = h.x - qx, h.z - qz
				local l = math.sqrt(dx * dx + dz * dz)
				if l > 1 then local k = math.min(prm("AbilQuietOff"), l) / l; qx, qz = qx + dx * k, qz + dz * k end
			end
			q = { x = qx, y = bu.pos.y, z = qz, id = bu.id }
		end
	end
	M.quiet = q
end
-- has Elite a clump it sees (the question of its own AITacticDemand_Artillery / PositionTargetFilter_EnemyClumpPosition,
-- player-tactics.ai:131-160)? Asked at most once per tick; only the answer is kept
local function ra_elite_target(now)
	if M.ra_et ~= now then
		M.ra_et, M.ra_ep = now, false
		if type(AIPlayer_GetBestArtilleryPosition) == "function" then
			M.ra_ep = (AIPlayer_GetBestArtilleryPosition(s_selfplayer, { threat_weighting = 1.0, importance_weighting = 0.5, must_be_seen = true, min_threat = 2 }) ~= nil)
		end
	end
	return M.ra_ep
end
local function ra_demand(pbg, d)
	local name, now = ra_name(pbg), World_GetGameTime()
	local targeted = AIAbility_IsTargeted(pbg)
	-- verify 10.11: a squad-targeted ability (buff on a squad) is never cast by Elite (PlayerAbility_CastOnTarget does
	-- positions only) - a raised demand made it the top ability forever and held the money of ALL abilities (stand: ork camo,
	-- eldar damage buff "no target" every few s). 0.6: no candidate at all (was: Elite's own demand, 5 +- 5 - chosen whenever
	-- nothing else was, "no target" x9 every 30 s for the whole match)
	if targeted and not AIAbility_DoesTargetPosition(pbg) then return 1 end
	local fight = M.last_contact and now - M.last_contact <= prm("AbilFightSecs")
	local spawn = has_key(name, SPAWN_KEYS)
	local callin = spawn and (ra_cost(pbg)) > 0                                -- brings squads for req: a unit by another channel
	if targeted then
		-- 0.6: nowhere to go = no candidate (nothing is chosen, nothing is locked). A call-in goes to our fight or to a raid only
		-- 0.8: ... or next to the army when nobody fights (M.quiet): a unit bought through another channel
		if not (M.clump ~= nil or (callin and (M.raid ~= nil or M.clump_any ~= nil or (M.quiet ~= nil and not M.retreat))) or (not callin and ra_elite_target(now))) then
			M.st.abil_notgt = (M.st.abil_notgt or 0) + 1
			return 1
		end
		if callin and M.retreat and not M.raid then return 1 end               -- nothing is dropped into a fight the army is leaving
	end
	local r, dem = rule("AbilitySave"), 1
	if r == 3 then dem = prm("AbilDemand")
	elseif callin and targeted and M.raid then dem = prm("AbilDemand")        -- the raid at our base is the fight
	elseif fight then
		if r == 2 and not spawn and not has_key(name, { "buff" }) then
			dem = (M.clump and M.clump.n >= prm("AbilMinClump")) and prm("AbilDemand") or 1
		else dem = prm("AbilDemand") end
	elseif spawn then dem = prm("AbilSpawnDemand") end
	if dem > 1 then
		M.ra_said = M.ra_said or {}
		if not M.ra_said[name] or now - M.ra_said[name] > 30 then M.ra_said[name] = now; mlog("RaceAbilities", "demand", name, dem, fight and "fight" or "quiet") end
	end
	return dem
end
-- 0.5 (TECH_RU.md 13) Conf_AbilityVsUnit - an ability that takes req or power against the unit the plan waits for. s16: at 6:55
-- the genestealer (350/45) had its money and waited for the HQ (the T2 research); the ability budget came first in that tick and
-- cast tyr_spawn_mycetic_spore_raveners (350 req; bank 394 -> 60) - the genestealer was not bought for the rest of the match.
-- The rule: while a unit is waited for (EliteAI_UnitClaim of strategy_unit_purchase.ai: the plan's next unit, short of money
-- or waiting for the HQ) an ability whose cost would leave the bank (less the tasks) below the unit's cost is no candidate -
-- its entry in Elite's demand table is dropped after CalcPlayerAbilityDemand, whatever demand function rated it, so it is not
-- chosen and locks nothing (a failed cast would hold its cost off the budgets after it, util/budget.ai:345). With a bank that
-- pays both nothing is held; an ability that costs neither req nor power (the red resource only) is never held.
-- 0.6 (TECH_RU.md 14): the same for the tech plan's reserve (EliteAI_TechReserve: the ability budget was the only one that could
-- still take the req of a research the plan had promoted) and for the save state that saves without a claim; and the unit is
-- no longer first whatever happens - an ability passes when it gives more than the unit for the same money:
--   bargain  - a call-in worth at least AbilBargainK (1.3) times its req (RA_WORTH) with somewhere to go: it is the better unit;
--   defend   - a targeted call-in and a raid at our base / point / power point (M.raid): it lands there now (also over the
--              tech plan's reserve - the plan itself gives way to the army while the enemy is at the base);
--   fight    - a targeted call-in, the army in a fight with a clump to land on, not retreating. Where the outcome is not
--              clear the arbiter decides (A / B / C = 1 / 2 / 3): 1 - only an open fight, ours / theirs in contact between
--              AbilFightLo (0.6) and AbilFightHi (1.8): a fight that is won anyway leaves the req with the unit, a lost one
--              is not fed; 2 - any fight we do not lose (>= AbilFightLo: the finishing blow counts); 3 - any fight;
--   unit_far - a call-in that arrives at the HQ as the unit would: rules 2 / 3 when the unit waits for the HQ or is more than
--              AbilUnitEta (40 s) of income away (a squad now against the unit later); rule 1 - the unit of the plan first;
--   target   - rules 2 / 3: an ability that is no call-in and costs req (ork_waaagh) with a clump of AbilMinClump squads;
--   held     - whatever was held for AbilHoldMax (90 s) without a break while it could be cast (the bank held its price all
--              that time and the unit still was not bought) goes: nothing is held for ever.
-- Lines: "RaceAbilities hold <ability> unit <sbps> R/P <why> eta N cost R/P free R/P rule K held S" and "... over unit <ability>
-- <reason> unit <sbps> ..." (once per 30 s per ability); stats: abil_held, abil_over, abil_callin, abil_notgt.
-- Mech_AbilUnitHold=0 = off (nothing is held).
local function ra_unit_hold()
	if not ra_on() or prm("AbilUnitHold") < 1 or type(s_player_ability_demand) ~= "table" then return end
	local bank = cache and cache.resources
	if bank == nil then return end
	local now = World_GetGameTime()
	local ur, up, eta, uname, why
	if type(EliteAI_UnitClaim) == "function" then ur, up, eta, uname, why = EliteAI_UnitClaim() end   -- numbers and strings (nil = no unit is waited for)
	local tasks = Task_CountCost(s_selfplayer, false)                       -- util/budget.ai:271: what the requests placed already hold
	local rr, rp = 0, 0
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end   -- strategy_tech_purchase.ai: numbers
	rr, rp = rr or 0, rp or 0
	local fr = (bank.requisition or 0) - ((tasks and tasks.requisition) or 0) - rr
	local fp = (bank.power or 0) - ((tasks and tasks.power) or 0) - rp
	if ur == nil and type(EliteAI_R) == "table" and EliteAI_R.save == true and type(EliteAI_ReinforceNeed) == "function" then
		local need, what = EliteAI_ReinforceNeed()                             -- saving without a claim: what it saves for reads as a unit short of money
		local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
		if (need or 0) > 0 then
			ur, up, uname, why = need, 0, what or "-", "save"
			eta = (need > fr) and ((rate > 0) and (60 * (need - fr) / rate) or 11111) or 0
		end
	end
	if ur == nil and rr + rp <= 0 then return end
	if ur == nil then ur, up, eta, uname, why = 0, 0, 0, "tech", "reserve" end
	local r = rule("AbilityVsUnit")
	local fight = M.last_contact and now - M.last_contact <= prm("AbilFightSecs")
	local F = M.fight
	local ratio = (F and F.ew > 0) and (F.ow / F.ew) or nil
	M.ra_said, M.ra_hold, M.ra_pass = M.ra_said or {}, M.ra_hold or {}, M.ra_pass or {}
	for pbg, dem in pairs(s_player_ability_demand) do                       -- each entry on its own: the order of pairs() does not matter
		if pbg and dem ~= false then
			local cr, cp = ra_cost(pbg)
			if (cr > 0 and fr - cr < ur) or (cp > 0 and fp - cp < up) then    -- the bank does not pay both
				local name = ra_name(pbg)
				local callin = has_key(name, SPAWN_KEYS) and cr > 0
				local targeted = AIAbility_IsTargeted(pbg)
				local reserve = (rr + rp > 0) and ((cr > 0 and fr - cr < 0) or (cp > 0 and fp - cp < 0))   -- it would take the research's money itself
				local pass = nil
				if callin and targeted then
					if M.raid then pass = "defend"
					elseif fight and (M.clump or M.clump_any) and not M.retreat then
						if ra_worth(name, cr) >= cr * prm("AbilBargainK") then pass = "bargain"
						elseif r >= 3 then pass = "fight"
						elseif ratio and ratio >= prm("AbilFightLo") and (r >= 2 or ratio <= prm("AbilFightHi")) then pass = "fight" end
					elseif M.quiet and not M.retreat and not (fight and (M.clump or M.clump_any)) then
						-- 0.8: nobody to land on - it lands next to the army: weighed as a call-in that arrives at the HQ, and where the
						-- outcome is not clear the arbiter decides (the red resource it takes has no other buyer here; the unit comes
						-- later): 1 - the unit of the plan first (a bargain aside); 2 - also when the unit waits for the HQ, is far, or
						-- would be bought now for no less req and power than the call-in ("cheaper": a squad at the army now, the
						-- unit with the next money); 3 - whenever the engine lets it be cast ("quiet")
						if ra_worth(name, cr) >= cr * prm("AbilBargainK") then pass = "bargain"
						elseif r >= 3 then pass = "quiet"
						elseif r >= 2 and (why == "channel" or ((why == "money" or why == "save") and eta > prm("AbilUnitEta"))) then pass = "unit_far"
						elseif r >= 2 and why == "ready" and cr <= ur and cp <= up then pass = "cheaper" end
					end
				elseif callin then
					if ra_worth(name, cr) >= cr * prm("AbilBargainK") then pass = "bargain"
					elseif r >= 2 and (why == "channel" or ((why == "money" or why == "save") and eta > prm("AbilUnitEta"))) then pass = "unit_far" end
				elseif r >= 2 and fight and M.clump and M.clump.n >= prm("AbilMinClump") then pass = "target" end
				if reserve and pass ~= "defend" then pass = nil end
				local h = M.ra_hold[name]
				if h == nil or now - h.last > prm("AbilHoldGap") then h = { t0 = now, last = now }; M.ra_hold[name] = h end
				h.last = now
				if not pass and not reserve and now - h.t0 >= prm("AbilHoldMax") then pass = "held" end
				local k = name .. (pass and "|over" or "|unit")
				local say = (not M.ra_said[k] or now - M.ra_said[k] > 30)
				if say then M.ra_said[k] = now end
				if pass then
					if h.cnt ~= now then h.cnt = now; M.st.abil_over = (M.st.abil_over or 0) + 1 end
					M.ra_pass[name] = { t = now, why = pass }
					if say then
						mlog("RaceAbilities", "over unit", name, pass, "unit", uname, ur .. "/" .. up, why, "eta", math.floor(eta), "cost", cr .. "/" .. cp,
							"ratio", ratio and fmt("%.2f", ratio) or "-", "rule", r, "held", math.floor(now - h.t0))
					end
				else
					s_player_ability_demand[pbg] = false                       -- HighestPlayerAbilityDemand skips it (player_abilities.ai:297)
					if h.cnt ~= now then h.cnt = now; M.st.abil_held = (M.st.abil_held or 0) + 1 end   -- (0.7: once per tick - the units budget asks too)
					if say then
						mlog("RaceAbilities", "hold", name, "unit", uname, ur .. "/" .. up, why, "eta", math.floor(eta), "cost", cr .. "/" .. cp,
							"free", math.floor(fr) .. "/" .. math.floor(fp), "rule", r, "held", math.floor(now - h.t0))
					end
				end
			end
		end
	end
end
EliteAI_MechAbilityUnitHold = ra_unit_hold                                    -- the stub run
EliteAI_MechAbilityScan = ra_clump                                            -- the stub run
if type(CalcPlayerAbilityDemand) == "function" and type(PlayerAbility_Cast) == "function" and not EliteAI_MechRA_Wrapped then
	EliteAI_MechRA_Wrapped = true
	local E_Calc, E_Demand, E_Cast, E_Pos = CalcPlayerAbilityDemand, AITacticDemand_Default, PlayerAbility_Cast, PositionTargetFilter_EnemyClumpPosition
	CalcPlayerAbilityDemand = function() EliteAI.mech.in_pa = true; E_Calc(); EliteAI.mech.in_pa = nil; EliteAI_MechAbilityUnitHold() end   -- 0.5: the unit first
	AITacticDemand_Default = function(pbg)                                    -- also the demand of squad tactics: only inside CalcPlayerAbilityDemand
		local d = E_Demand(pbg)
		if EliteAI.mech.in_pa and EliteAI.on and EliteAI_MechAbilityDemand then return EliteAI_MechAbilityDemand(pbg, d) end
		return d
	end
	PlayerAbility_Cast = function(pbg)
		if not (EliteAI.on and EliteAI_MechAbilityCast) then return E_Cast(pbg) end
		return EliteAI_MechAbilityCast(pbg, E_Cast)
	end
	PositionTargetFilter_EnemyClumpPosition = function(a1, a2)             -- also a squad tactic filter: only inside PlayerAbility_Cast
		local p = E_Pos(a1, a2)
		if EliteAI.mech.in_cast and EliteAI.on and EliteAI_MechAbilityPos then return EliteAI_MechAbilityPos(p) end
		return p
	end
end
-- the three bodies of the wrappers above. The wrappers are installed once per Lua state and call these by name, so a chunk
-- that is loaded again (the stub run loads it per scenario) brings its own state M with it
function EliteAI_MechAbilityDemand(pbg, d)
	if not ra_on() then return d end
	return ra_demand(pbg, d)
end
function EliteAI_MechAbilityCast(pbg, E_Cast)
	if not ra_on() then return E_Cast(pbg) end
	local nm, t = ra_name(pbg), World_GetGameTime()
	local cr, cp = ra_cost(pbg)
	local callin = has_key(nm, SPAWN_KEYS) and cr > 0
	M.in_cast, M.cast_callin = true, callin
	local ok = E_Cast(pbg)
	M.in_cast, M.cast_callin = nil, nil
	M.ra_nt = M.ra_nt or {}
	if ok then
		M.st.abil = M.st.abil + 1
		local cost = { requisition = cr, power = cp }
		-- 0.3: the purchase book of strategy_unit_purchase.ai (energy): what the ability cost
		if type(EliteAI_EnergyNote) == "function" then EliteAI_EnergyNote("abil", cost) end
		-- 0.5: the models a spawn ability brings are paid with it - not booked as reinforcements (strategy_unit_purchase.ai r_models)
		if type(EliteAI_ReinforceFree) == "function" and has_key(nm, SPAWN_KEYS) then EliteAI_ReinforceFree() end
		-- 0.6: a call-in is a unit bought (the line "callin", the save state, the wait of the plan's unit)
		if callin then
			M.st.abil_callin = (M.st.abil_callin or 0) + 1
			if type(EliteAI_UnitCallIn) == "function" then EliteAI_UnitCallIn(nm, cost) end
		end
		local ps = M.ra_pass and M.ra_pass[nm]
		mlog("RaceAbilities", "cast", nm, "cost", cr .. "/" .. cp, "why", (ps and ps.t == t) and ps.why or "free", M.ra_first and "before the unit" or "")
		if M.ra_hold then M.ra_hold[nm] = nil end
	else                                                                      -- "no target": once per 30 s per ability, with a count
		local r = M.ra_nt[nm] or { t = -1000, n = 0 }
		r.n = r.n + 1; M.ra_nt[nm] = r
		if t - r.t >= 30 then mlog("RaceAbilities", "no target", nm, "x" .. r.n); r.t, r.n = t, 0 end
	end
	return ok
end
function EliteAI_MechAbilityPos(p)
	if not ra_on() then return p end
	if M.cast_callin then
		-- 0.6: a call-in lands on the raid at our base or on the clump our army fights - never on a clump Elite sees elsewhere
		local tg = M.raid or M.clump or M.clump_any
		if tg then
			mlog("RaceAbilities", "pos", M.raid and ("raid " .. tg.kind) or "clump", fmt("%d squads %.0f at %.0f %.0f", tg.n, tg.w, tg.x, tg.z))
			return World_Pos(tg.x, tg.y, tg.z)                                 -- player-tactics.ai:188
		end
		if M.quiet and not M.retreat then                                     -- 0.8: nobody fights - next to the army
			mlog("RaceAbilities", "pos", "quiet", fmt("next to the army (squad %d) at %.0f %.0f", M.quiet.id, M.quiet.x, M.quiet.z))
			return World_Pos(M.quiet.x, M.quiet.y, M.quiet.z)
		end
		return p
	end
	if M.clump and (not p or p.x == COORD_INVALID) then
		mlog("RaceAbilities", "pos", fmt("clump %d squads %.0f at %.0f %.0f", M.clump.n, M.clump.w, M.clump.x, M.clump.z))
		return World_Pos(M.clump.x, M.clump.y, M.clump.z)                    -- player-tactics.ai:188
	end
	return p
end
-- 0.7 (TECH_RU.md 15.2) THE CALL-IN OR THE UNIT IS DECIDED BEFORE THE UNIT IS BOUGHT. The arbiter above runs inside the ability
-- budget, and the budgets of a tick run one after another (util/budget.ai:297, by their totals): the units budget is nearly
-- always first. A unit that has its money is bought there, and a unit that is short of it locks its cost for the budgets
-- after it - so the ability budget saw the bank only in the ticks it happened to run first. The polygon's scene d (newai-13):
-- the bank reached 355 at 31 s, the genestealer (350) was bought in that tick and only then came "demand ...spore_raveners
-- 30 fight" - no cast in 120 s; s18: 1 cast in 13 minutes. Now the units budget asks here at the moment it would buy the
-- unit, or lock its cost (TryPurchaseUnitChoice of strategy_unit_purchase.ai: the unit is the claim - "ready", "money" or
-- "channel"): Elite's own CalcPlayerAbilityDemand runs (our demand, then the arbiter above against that claim), and a
-- call-in the arbiter let pass over the unit in this very tick (M.ra_pass) and that this budget can pay is cast at once
-- through Elite's PlayerAbility_Cast - as Elite's own units budget casts its ability-spawned units (strategy_unit_purchase.ai,
-- PURCHASETYPE_ABILITY). Returns the ability's name and its cost (the engine's object: the units budget is charged with it,
-- a call-in is a unit bought through another channel) or nil = the unit goes on as it was. Nothing new is decided here:
-- the rules are the arbiter's. Among several call-ins that passed: the most worth per req, then by name.
-- Mech_AbilCallInFirst=0 = off (only the ability budget casts, as 0.6).
-- 0.8 (TECH_RU.md 16.4): why is no call-in cast? s19, tyranids: not one "demand" line in 13 minutes - the engine did not offer
-- the abilities (AIPlayer_CanPlayerCastAbility), and the log could not tell why. One line per call-in every AbilWatchSecs:
-- "RaceAbilities watch <ability> can 0|1 cost R/P/red bank R/P/red avail R/P why ok|red|req|power|engine" (engine = the
-- money is there: the recharge, a requirement, the population). The red resource is the field "action" of the engine's
-- resource amounts (util/budget.ai:180) - read when it is a number, "-" otherwise.
local function ra_watch(avail)
	local now = World_GetGameTime()
	if now - (M.ra_wt or -1000) < prm("AbilWatchSecs") then return end
	M.ra_wt = now
	local bank = cache and cache.resources
	local br, bp, ba = bank and bank.requisition, bank and bank.power, bank and bank.action
	for _, pbg in pairs(s_player_ability_list) do                          -- each entry on its own: the order of pairs() does not matter
		if pbg then
			local name = ra_name(pbg)
			local c = AIAbility_GetCost(s_self_modplayer, pbg)
			local cr, cp, ca = (c and c.requisition) or 0, (c and c.power) or 0, c and c.action
			if cr > 0 and has_key(name, SPAWN_KEYS) then
				local can = (AIPlayer_CanPlayerCastAbility(s_selfplayer, pbg) == true)
				local why = "ok"
				if not can then
					if type(ca) == "number" and type(ba) == "number" and ba < ca then why = "red"
					elseif type(br) == "number" and br < cr then why = "req"
					elseif type(bp) == "number" and bp < cp then why = "power"
					else why = "engine" end
				end
				M.st.abil_watch_can = (M.st.abil_watch_can or 0) + (can and 1 or 0)
				mlog("RaceAbilities", "watch", name, "can", can and 1 or 0,
					"cost", fmt("%d/%d/%s", cr, cp, type(ca) == "number" and fmt("%d", ca) or "-"),
					"bank", fmt("%s/%s/%s", type(br) == "number" and fmt("%d", br) or "-", type(bp) == "number" and fmt("%d", bp) or "-", type(ba) == "number" and fmt("%d", ba) or "-"),
					"avail", fmt("%d/%d", avail.requisition or 0, avail.power or 0), "why", why,
					"fight", (M.clump or M.clump_any) and 1 or 0, "raid", M.raid and 1 or 0, "quiet", M.quiet and 1 or 0)
			end
		end
	end
end
function EliteAI_MechCallInFirst(avail)
	if not ra_on() or prm("AbilCallInFirst") < 1 or avail == nil then return nil end
	if type(s_player_ability_list) ~= "table" or type(s_player_ability_demand) ~= "table" then return nil end
	if type(CalcPlayerAbilityDemand) ~= "function" or type(PlayerAbility_Cast) ~= "function" or s_playerabilities_enabled ~= true then return nil end
	if prm("AbilWatchSecs") > 0 then ra_watch(avail) end
	if TASK_PlayerAbility ~= nil and Task_CountActive(s_selfplayer, TASK_PlayerAbility, false) > 0 then return nil end   -- player_abilities.ai:242: one at a time
	local ar, ap = avail.requisition or 0, avail.power or 0
	-- is there a call-in the engine lets us cast (player_abilities.ai:62) and this budget can pay? (yes / no over all of them)
	local any = false
	for _, pbg in pairs(s_player_ability_list) do
		if pbg and not any and AIPlayer_CanPlayerCastAbility(s_selfplayer, pbg) then
			local cr, cp = ra_cost(pbg)
			if cr > 0 and cr <= ar and cp <= ap and has_key(ra_name(pbg), SPAWN_KEYS) then any = true end
		end
	end
	if not any then return nil end
	local now = World_GetGameTime()
	for k in pairs(s_player_ability_demand) do s_player_ability_demand[k] = false end   -- as clear_kv_list (player_abilities.ai:252)
	CalcPlayerAbilityDemand()
	local best, bname, bk
	for pbg, dem in pairs(s_player_ability_demand) do                       -- the best by worth, ties by name: the order of pairs() does not matter
		if pbg and dem ~= false then
			local name = ra_name(pbg)
			local ps = M.ra_pass and M.ra_pass[name]
			local cr, cp = ra_cost(pbg)
			if ps and ps.t == now and cr > 0 and cr <= ar and cp <= ap and has_key(name, SPAWN_KEYS) then
				local k = ra_worth(name, cr) / cr
				if not best or k > bk or (k == bk and name < bname) then best, bname, bk = pbg, name, k end
			end
		end
	end
	if not best then return nil end
	M.ra_first = now                                                           -- (the line "cast" names it: "... first")
	local ok = PlayerAbility_Cast(best)                                        -- the wrapper above: "cast", "callin", the books
	M.ra_first = nil
	if not ok then return nil end
	M.st.abil_first = (M.st.abil_first or 0) + 1
	return bname, AIAbility_GetCost(s_self_modplayer, best)
end
local function run_race_abilities()
	s_playerabilities_enabled = true
	local w = prm("AbilBudget")
	if ai_budget and ai_budget.budget_list and ai_budget.budget_list["BUDGET_PlayerAbility"] and ai_budget:getweight("BUDGET_PlayerAbility") ~= w then
		ai_budget:setweight("BUDGET_PlayerAbility", w)
		mlog("RaceAbilities", "budget weight", w)
	end
end

--------------------------------------------------------------------------------------------------
-- ArmyRoles: the core (the director's army) fights together; right after a won fight it splits briefly to take the points
-- around, then gathers again (Conf_Split). 1-2 cheap/fast squads are runners: they go from point to point, fight a lone
-- weaker squad (Conf_RunnerFight), leave for the other flank when they meet an army. Points on the enemy half are only
-- neutralised (Conf_Decap, DecapOnly_EnemyHalf), victory points always captured fully. Elite's own capture tasks are
-- capped at EliteCapturers.
-- 0.6 (TECH_RU.md 14, Orca's match against a human: GK, 3-6 squads) THE RUNNER IS NOT SENT TO DIE. One squad after another was
-- sent alone to the enemy's points far from the army ("-> -91/95 enemy capture" five times, four squads lost, the hero the
-- first of them), while our own points went from 7 to 0. Now:
--  * a small army keeps its squads (Conf_RunnerArmy; the opening - RunnerOpenSecs - aside): 1 = an army of RunnerMinArmy (4)
--    squads or fewer has no runner; 2 = it has one, for the points on our half or within RunnerOwnR of the army only;
--    3 = no runner up to RunnerMinArmy + 1 squads. The army takes the points it stands at (the split, the goals);
--  * a hero is a runner in the opening only;
--  * no target where the enemy is or just was: an enemy within RunnerPointR of the point now (as before), an enemy point
--    with an enemy there during the last RunnerSeenSecs, a way that passes an enemy force (way_blocked) - also checked every
--    tick on the way ("runner <id> drops <point>");
--  * the target a runner was lost on its way to is nobody's for RunnerDeadSecs ("runner lost <id> at <point>");
--  * a point that was ours and lies near the army comes first (RunnerOwnBonus).
-- 1.1 MAP, the helpers (TECH_RU.md 19). "Our side" of the map; a point of ours that was lost a moment ago; the squads of the
-- army that capture its goal points (M.cappers = { { id, key, t0, last } ... }: numbers and strings); is the director's own
-- target inside a zone the army stays out of
function X.map_side(p)
	local hh = home()
	if hh and d2(p.x, p.z, hh.x, hh.z) <= prm("MapHomeR") then return true end
	return not p.enemy_half
end
function X.map_lost(p, now)
	if prm("Map") < 1 or p.ours then return false end
	local was = M.pt_ours[p.key]
	if was == nil or now - was > prm("MapLostSecs") then return false end
	return X.map_side(p)
end
function X.capper_of(id) for _, c in ipairs(M.cappers or {}) do if c.id == id then return c end end return nil end
function X.capper_at(key) for _, c in ipairs(M.cappers or {}) do if c.key == key then return c end end return nil end
function X.capper_drop(id)
	local l = M.cappers or {}
	for i = table.getn(l), 1, -1 do if l[i].id == id then table.remove(l, i) end end
end
function X.target_closed()
	local b = EliteAI.best_pos
	return prm("Map") >= 1 and b ~= nil and b.x ~= nil and b.z ~= nil and X.under_turret(b.x, b.z) == true
end
-- the director (main.ai): may the army be marched at this spot? false = it lies in the zone of a turret nobody storms
function EliteAI_MechClosed(x, z)
	if x == nil or z == nil or prm("Map") < 1 or not mech_on("Defence") then return false end
	return X.under_turret(x, z) == true
end
-- 1.1 the raider role: who (the end of the sbps name). Elite's attributes: the lictor brood (sbps/pvp/race_tyranid/troops/tyr_lictor)
-- has the infiltration and a leap and nothing else - Orca fb 538: "a side capper, infiltration, sudden attacks", not a squad of the line
X.RAIDERS = { "troops/tyr_lictor" }
-- 1.2 (TECH_RU.md 20.4; Orca fb 557: "do not refill the side cappers to a full squad"): what a squad of ours is, for the purse of
-- the refills (strategy_unit_purchase.ai r_goal) - "runner" (it is one, or was within RoleSecs: it stands at home to refill and
-- the role is given to another meanwhile), "capper" (it takes the army's goal points), nil = a squad of the line. Numbers only.
function EliteAI_MechRole(id)
	if id == nil or not EliteAI.on then return nil end
	local now = World_GetGameTime()
	M.role_t = M.role_t or {}
	if M.runner ~= nil and M.runner[id] then M.role_t[id] = now; return "runner" end
	if X.capper_of(id) then M.role_t[id] = now; return "capper" end
	local t = M.role_t[id]
	if t ~= nil and now - t <= prm("RoleSecs") then return "runner" end
	return nil
end
function X.is_raider(id)
	if prm("Raid") < 1 then return false end
	local nm = M.names[id] or ""
	for _, k in ipairs(X.RAIDERS) do if ends_with(nm, k) then return true end end
	return false
end
local function seg_dist(px, pz, ax, az, bx, bz)                               -- the distance of a point to the stretch a-b
	local vx, vz = bx - ax, bz - az
	local l2, t = vx * vx + vz * vz, 0
	if l2 > 0 then
		t = ((px - ax) * vx + (pz - az) * vz) / l2
		if t < 0 then t = 0 elseif t > 1 then t = 1 end
	end
	return d2(px, pz, ax + vx * t, az + vz * t)
end
local function way_blocked(u, p, en)                                          -- an enemy force next to the straight way from the squad to the point
	local r, n, w = prm("RunnerPathR"), 0, 0
	for _, e in ipairs(en) do
		if seg_dist(e.x, e.z, u.pos.x, u.pos.z, p.x, p.z) <= r then n, w = n + 1, w + e.w end
	end
	return n >= 2 or (n == 1 and w >= weight_of(u) * prm("RunnerPathK"))
end
local function is_hero(id) return string.find(M.names[id] or "", "/heroes/", 1, true) ~= nil end
-- how many runners the army has now and where they may go ("all" / "near" / "none")
local function runner_plan(state)
	local n, now = table.getn(state.army), state.now
	local want = prm("Runners")
	-- 0.9: the second runner comes at Runners2At squads and goes two squads below it, not at the same number (s20, tyranids at 7-8
	-- squads: a ravener was made a runner, sent to a point and released three times in a minute, and stood in between)
	if n >= prm("Runners2At") then M.runner2 = true elseif n <= prm("Runners2At") - 2 then M.runner2 = false end
	if M.runner2 then want = want + 1 end
	-- 1.3 (TECH_RU.md 21.5; Malum fb 623: 2-4 points for 26 minutes with an army of 4-7 squads - one runner, 19 trips): a second
	-- runner already from RunnerSafe2At (6) squads while the map is QUIET - the army out of contact for RunnerSafeSecs and no
	-- enemy squad within MapHomeR of our HQ; the verdict holds 20 s. RunnerSafe2At=0 = off.
	local s2 = prm("RunnerSafe2At")
	if s2 > 0 and want >= 1 and not M.runner2 and n >= s2 then                -- (a SECOND runner: none with Mech_Runners=0)
		local quiet = (M.army_contact == nil or now - M.army_contact >= prm("RunnerSafeSecs"))
		local h = home()
		if quiet and h then
			for _, e in ipairs(M.en or {}) do
				if d2(e.x, e.z, h.x, h.z) <= prm("MapHomeR") then quiet = false; break end
			end
		end
		if decide("RunnerSafe", "army", quiet and "two" or "one", fmt("squads %d", n), now, 20) == "two" then
			want = want + 1
			M.st.runner_safe = (M.st.runner_safe or 0) + 1
		end
	end
	local r, mode = rule("RunnerArmy"), "all"
	local small = prm("RunnerMinArmy") + ((r == 3) and 1 or 0)
	if n <= small and now >= prm("RunnerOpenSecs") then mode = (r == 2) and "near" or "none" end
	mode = decide("RunnerArmy", "army", mode, fmt("squads %d small %d", n, small), now, 16)
	if mode == "none" then want = 0 end
	if M.runner_mode == nil then mlog("ArmyRoles", "runners", mode, "army", n, "small", small, "rule", r) end   -- (the switches: "Conf_RunnerArmy army X->Y")
	M.runner_mode = mode
	return want
end
local function pick_runners(state, taken)
	local want = runner_plan(state)
	local alive, have, ids = {}, 0, {}
	for _, u in ipairs(state.army) do alive[u.id] = u end
	for id in pairs(M.runner) do table.insert(ids, id) end
	table.sort(ids)
	-- 0.4: a squad that is a sure tool against a garrison (flamers, grenades: weight 1 in GAR_TOOLS) is no runner while the
	-- garrison is stormed or held (b2: one of the two devils squads captured points all through the assault)
	local G = M.gar
	local gtool = (G ~= nil and (G.v == "assault" or G.v == "hold"))
	local function is_tool(u) local c = ucls(u); return c.gar ~= nil and (c.gar_w or 1) >= 1 end
	local opening = (state.now < prm("RunnerOpenSecs"))
	for _, id in ipairs(ids) do
		if not alive[id] then
			-- 0.6: lost (it is not among our squads any more), not just taken by Elite's capture task: where it went is closed
			local R = M.runner[id]
			if not M.exists[id] and R.tgt then
				M.dead_pt[R.tgt] = state.now
				M.st.runner_lost = (M.st.runner_lost or 0) + 1
				mlog("ArmyRoles", "runner lost", id, "at", R.tgt, "no runner there for", prm("RunnerDeadSecs"), "s")
			end
			M.runner[id] = nil; mlog("ArmyRoles", "runner gone", id)
		elseif have >= want then M.runner[id] = nil; mlog("ArmyRoles", "runner released", id, (want == 0) and "small army" or "")
		elseif gtool and is_tool(alive[id]) then
			M.runner[id] = nil
			mlog("ArmyRoles", "runner released", id, M.names[id] or "?", "a tool against the garrison", G.id, G.v)
		elseif not opening and is_hero(id) then
			M.runner[id] = nil; mlog("ArmyRoles", "runner released", id, "a hero stays with the army")
		else have = have + 1 end
	end
	while have < want do
		local best, bs
		for _, u in ipairs(state.active) do
			-- 0.3: only a squad that can capture (a carnifex became a runner and stood with an order it could not execute),
			-- and not one the Idle logic just took out of a capture role
			if not M.runner[u.id] and not taken[u.id] and can_cap(u.id) and not (gtool and is_tool(u)) and not X.is_raider(u.id)
				and not (M.split and M.split.assign[u.id])                        -- 0.4: one capture role per squad (it got two moves in a tick)
				and (opening or not is_hero(u.id))                                -- 0.6
				and not (M.norole[u.id] and state.now - M.norole[u.id] < prm("IdleRoleBan")) then
				weight_of(u)
				local c = ucls(u)
				if not u.veh then
					local s = (c.runner and 0 or 100000) + u.hmax
					if not best or s < bs or (s == bs and u.id < best.id) then best, bs = u, s end
				end
			end
		end
		if not best then break end
		M.runner[best.id] = { t0 = state.now, last = -1000 }
		M.st.runner = M.st.runner + 1
		have = have + 1
		mlog("ArmyRoles", "runner", best.id, M.names[best.id] or "?")
	end
end
-- may a runner go for this point now (0.6)? false, why
local function runner_safe(u, p, en, now, cx, cz)
	local _, en_n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))
	if en_n > 0 then return false, "enemy at the point" end
	if X.under_turret(p.x, p.z) then return false, "under a turret" end      -- 0.7 Defence
	if p.enemy and M.pt_seen[p.key] and now - M.pt_seen[p.key] < prm("RunnerSeenSecs") then return false, "enemy seen there" end
	if M.runner_mode == "near" and p.enemy_half and d2(cx, cz, p.x, p.z) > prm("RunnerOwnR") then return false, "far for a small army" end
	if way_blocked(u, p, en) then return false, "enemy force on the way" end
	return true
end
local function pick_runner_point(u, en, now, R, cx, cz)
	local best, bs
	local ar, av = prm("RunnerAvoidR"), (R.avoid_t and now - R.avoid_t <= prm("RunnerAvoidSecs"))
	local busy = {}                                                          -- 1.3: a point another runner goes to or a squad of the army captures is not this runner's
	for _, R2 in pairs(M.runner) do if R2 ~= R and R2.tgt then busy[R2.tgt] = true end end   -- (a set: the order of pairs() does not matter)
	for _, c in ipairs(M.cappers or {}) do busy[c.key] = true end
	for _, p in ipairs(M.pts) do
		if not p.ours and not busy[p.key] and not point_done(p, en, now) and not (M.bad_pt[p.key] and now - M.bad_pt[p.key] < 40)   -- verify 10.11: a neutralised point on the enemy half is done (was: endless "-> x neutral decap / neutralised" loop)
			and not (M.dead_pt[p.key] and now - M.dead_pt[p.key] < prm("RunnerDeadSecs")) then
			if runner_safe(u, p, en, now, cx, cz) then
				local s = d2(u.pos.x, u.pos.z, p.x, p.z) - (p.vp and prm("RunnerVpBonus") or 0)
				if M.pt_ours[p.key] and d2(cx, cz, p.x, p.z) <= prm("RunnerOwnR") then s = s - prm("RunnerOwnBonus") end   -- 0.6: it was ours
				if X.map_lost(p, now) then s = s - 1000 end                         -- 1.1: lost a moment ago, on our side - before any other
				if av then s = s + math.max(0, ar - d2(p.x, p.z, R.avoid_x, R.avoid_z)) * 2 end
				if not best or s < bs or (s == bs and p.key < best.key) then best, bs = p, s end
			end
		end
	end
	return best
end
local function run_runners(state, en, taken, cx, cz)
	local now = state.now
	local ids = {}
	for id in pairs(M.runner) do table.insert(ids, id) end
	table.sort(ids)
	local act = {}
	for _, u in ipairs(state.active) do act[u.id] = u end
	for _, id in ipairs(ids) do
		local u, R = act[id], M.runner[id]
		if u and not taken[id] then
			taken[id] = true                                                   -- a runner is never the director's
			-- enemies around the runner
			local near, nn, nw = nil, 0, 0
			for _, e in ipairs(en) do
				local d = d2(e.x, e.z, u.pos.x, u.pos.z)
				if d <= prm("RunnerFleeR") then nn = nn + 1; nw = nw + e.w; if not near or d < near.du then e.du = d; near = e end end
			end
			local fought = false
			-- 0.6: the target on the way - an enemy came to the point, or an enemy force stands next to the way: it is dropped
			local p0 = (nn == 0) and R.tgt and M.pts_by_key[R.tgt]
			if p0 then
				local okp, whyp = runner_safe(u, p0, en, now, cx, cz)
				if not okp then
					M.st.runner_drop = (M.st.runner_drop or 0) + 1
					mlog("ArmyRoles", "runner", id, "drops", p0.key, whyp)
					M.bad_pt[R.tgt] = now; R.tgt = nil
					morder(id, cx, u.pos.y, cz, ORD_MOVE)                       -- back towards the army (a move cancels the capture)
				end
			end
			if nn > 0 then
				local uw, v = weight_of(u), "flee"
				if nn == 1 and not near.veh and not near.held then                -- 0.3: never a squad inside a building
					local r = rule("RunnerFight")
					if r == 1 then v = (near.w <= uw) and "fight" or "flee"
					elseif r == 2 then v = (near.w <= uw and near.hp < 0.7) and "fight" or "flee" end
				end
				v = decide("RunnerFight", id, v, fmt("enemies %d w %.0f ours %.0f", nn, nw, uw), now)
				if v == "fight" then
					morder(id, near.id, 0, 0, ORD_ATTACK_SQUAD); fought = true; R.last = -1000
				else
					if R.tgt then M.bad_pt[R.tgt] = now end
					R.avoid_x, R.avoid_z, R.avoid_t, R.tgt = near.x, near.z, now, nil
				end
			end
			if not fought then
				local p = R.tgt and M.pts_by_key[R.tgt]
				if p then
					local done, why = point_done(p, en, now)
					if done then
						if why == "neutralised" then M.st.decap = M.st.decap + 1 end
						mlog("ArmyRoles", "runner", id, "point", p.key, why)
						p, R.tgt = nil, nil
						morder(id, cx, u.pos.y, cz, ORD_MOVE)                   -- a move cancels the capture (decap only)
					end
				end
				if not p then
					p = pick_runner_point(u, en, now, R, cx, cz)
					if p then
						R.tgt, R.last = p.key, -1000
						mlog("ArmyRoles", "runner", id, "->", p.key, p.vp and "VP" or (p.enemy and "enemy" or "neutral"), decap_only(p, en, now) and "decap" or "capture")
					end
				end
				if p then
					if now - R.last >= prm("RunnerReissue") then morder(id, p.x, p.y, p.z, ORD_CAPTURE); R.last = now end
				else
					taken[id] = nil                                            -- nothing to capture: the director may use it
				end
			end
		end
	end
end
-- Conf_Split: how much of the core goes to the points right after a fight. 1 = up to 2 squads (a third of the army);
-- 2 = up to half of an army of 5+; 3 = never (only the runners capture, the army stays one fist)
local function split_max(n)
	local r = rule("Split")
	if r == 1 then return math.min(2, math.floor(n / 3)) end
	if r == 2 then return (n >= 5) and math.min(3, math.floor(n / 2)) or 0 end
	return 0
end
local function run_split(state, en, cx, cz, taken)
	local now = state.now
	local contact = M.last_contact and now - M.last_contact < 1
	local sp = M.split
	if sp then
		local why, left = nil, 0
		if contact then why = "enemy contact" elseif now - sp.t0 > prm("SplitSecs") then why = "timeout" end
		local act = {}
		for _, u in ipairs(state.active) do act[u.id] = u end
		local ids = {}
		for id in pairs(sp.assign) do table.insert(ids, id) end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local a, u = sp.assign[id], act[id]
			local p = M.pts_by_key[a.key]
			local done, dwhy = true, "gone"
			if u and p then done, dwhy = point_done(p, en, now) end
			if done then
				if dwhy == "neutralised" then M.st.decap = M.st.decap + 1 end
				mlog("ArmyRoles", "split", id, "point", a.key, dwhy)
				sp.assign[id] = nil
				if u then morder(id, cx, u.pos.y, cz, ORD_MOVE); taken[id] = true end   -- back to the army (and the capture is cancelled)
			else
				if now - a.last >= prm("SplitReissue") then morder(id, p.x, p.y, p.z, ORD_CAPTURE); a.last = now end
				taken[id] = true; left = left + 1
			end
		end
		if left == 0 and not why then why = "points taken" end
		if why then
			mlog("ArmyRoles", "split end", why, fmt("after %.0f s", now - sp.t0))
			decide("Split", "army", "keep", why, now, 16)
			M.split, M.split_end = nil, now
			return false
		end
		-- 0.3: the rest of the army does not just stand (it stood up to SplitSecs without an order): it covers the capturing
		-- squads - attack-move to the centre of their points, repeated after SplitReissue - for SplitStay s, then the
		-- director leads it on (the squads at the points stay taken until their points are done)
		if now - sp.t0 > prm("SplitStay") then return false end
		if now - (sp.cover or -1000) >= prm("SplitReissue") then
			sp.cover = now
			local sx, sz, sn = 0, 0, 0
			for _, id in ipairs(ids) do
				local a = sp.assign[id]
				local p = a and M.pts_by_key[a.key]
				if p then sx, sz, sn = sx + p.x, sz + p.z, sn + 1 end
			end
			if sn > 0 then
				sx, sz = sx / sn, sz / sn
				for _, u in ipairs(state.active) do
					if not taken[u.id] and d2(u.pos.x, u.pos.z, sx, sz) > 12 then morder(u.id, sx, u.pos.y, sz, ORD_AMOVE) end
				end
			end
		end
		EliteAI.phase = "m_split"
		return true
	end
	if contact or not M.last_contact then return false end
	local since = now - M.last_contact
	if since < prm("SplitAfter") or since > prm("SplitWindow") then return false end
	if M.split_end and now - M.split_end < prm("SplitCooldown") then return false end
	local free = {}
	for _, u in ipairs(state.active) do if not taken[u.id] and not M.runner[u.id] then table.insert(free, u) end end   -- 0.4: a runner without a point is still a runner
	local maxs = split_max(table.getn(free))
	local v = decide("Split", "army", (maxs > 0) and "split" or "keep", fmt("squads %d after fight %.0f s", table.getn(free), since), now, 16)   -- 0.3: 16 s (the number of free squads changes from tick to tick; two switches in 30 s at most)
	if v ~= "split" or maxs <= 0 then return false end
	-- points around the army, free of enemies, the nearest free squad for each
	local cands = {}
	for _, p in ipairs(M.pts) do
		if not p.ours and d2(p.x, p.z, cx, cz) <= prm("SplitR") and not point_done(p, en, now) then
			local _, n = enemy_weight_near(en, p.x, p.z, prm("SplitPointSafeR"))
			if n == 0 then table.insert(cands, p) end
		end
	end
	table.sort(cands, function(a, b) local da, db = d2(a.x, a.z, cx, cz), d2(b.x, b.z, cx, cz); if da ~= db then return da < db end return a.key < b.key end)
	local assign, cnt, used, keys = {}, 0, {}, ""
	for _, p in ipairs(cands) do
		if cnt >= maxs then break end
		local best, bd
		for _, u in ipairs(free) do
			if not used[u.id] and u.hp >= prm("SplitMinHp") and can_cap(u.id)                            -- 0.3: can capture, not banned by Idle
				and not (M.norole[u.id] and now - M.norole[u.id] < prm("IdleRoleBan")) then
				weight_of(u)
				if not u.veh then

					local d = d2(u.pos.x, u.pos.z, p.x, p.z)
					if not best or d < bd or (d == bd and u.id < best.id) then best, bd = u, d end
				end
			end
		end
		if best then
			used[best.id] = true
			assign[best.id] = { key = p.key, last = now }
			morder(best.id, p.x, p.y, p.z, ORD_CAPTURE)
			taken[best.id] = true
			cnt = cnt + 1
			keys = keys .. " " .. p.key .. (decap_only(p, en, now) and "(decap)" or "")
		end
	end
	if cnt == 0 then return false end
	M.split = { t0 = now, assign = assign }
	M.st.split = M.st.split + 1
	mlog("ArmyRoles", "split start", cnt, "squads ->", keys, fmt("army %d", table.getn(free)))
	EliteAI.phase = "m_split"
	return true
end
local function run_army_roles(state, en, cx, cz, taken)
	if s_personality then
		local cap = prm("EliteCapturers")
		if s_personality.max_num_capturers ~= cap then s_personality.max_num_capturers = cap; mlog("ArmyRoles", "Elite capturers", cap) end
	end
	pick_runners(state, taken)
	run_runners(state, en, taken, cx, cz)
	if M.retreat then return false end
	return run_split(state, en, cx, cz, taken)
end

--------------------------------------------------------------------------------------------------
-- 0.3 Goal: where the director takes the army when its own target is used up (Idle) or the Garrison pattern wants the army
-- somewhere. EliteAI.goal = { x, y, z, key, kind, t, pt } - numbers and strings only; EliteAI_Director (main.ai) uses it
-- instead of EliteAI.best_pos while it is fresh (t within Mech_GoalSecs). kind: "point" (the next point to take), "enemy"
-- (the nearest enemy squad in the field), "gar" (the building of a garrison we storm), "gar_hold" (the hold spot), "bypass"
-- (another place instead of the garrisoned one), "detour" (round the building of a garrison we leave alone).

local function set_goal(kind, key, x, y, z, now, why, is_point)
	local g = EliteAI.goal
	if g and g.kind == kind and g.key == key then g.t = now; g.x, g.y, g.z = x, y, z; return end   -- the same goal: keep it alive
	EliteAI.goal = { x = x, y = y, z = z, key = key, kind = kind, t = now, t0 = now, pt = is_point and true or false }
	M.st.goal = M.st.goal + 1
	mlog("Goal", kind, key, fmt("at %.0f %.0f", x, z), why or "")
end
local function clear_goal(why, kinds)
	local g = EliteAI.goal
	if not g or (kinds and not kinds[g.kind]) then return end
	mlog("Goal", "end", g.kind, g.key, why or "", fmt("after %.0f s", (M.now or g.t0) - g.t0))
	EliteAI.goal = nil
end
local GAR_GOALS = { gar = true, gar_hold = true, bypass = true, detour = true }

-- the next place for an army with nothing to do: the nearest point that is not ours, not done (Conf_Decap) and free of
-- enemies (a garrisoned point is not: its squad is an enemy within RunnerPointR), victory points first; else the nearest
-- enemy squad in the field (not in a building, not within GoalBaseR of an enemy HQ: base defences are not squads, the
-- army's strength check does not see them); else nothing - the army stays where it is
-- 1.2 (TECH_RU.md 20.5; the polygon's scene g, r17: "Goal end point -60/32 ... the army goes on" -> "Goal point -46/100 next
-- while -60/32 is captured" - the next point lay at the orks' base, the dreadnought and the rhino were lost there while the
-- squad that could have taken it was still capturing the first one). safe = the army goes on WITHOUT waiting: not to a point
-- within MapOnBaseR of an enemy HQ, nor to one with enemy squads within MapOnThreatR that weigh more than MapOnRatio of the
-- army; without such a point the army covers its capturing squad (goal_tick below), as when there is no other point.
function X.on_unsafe(p, en, ow)
	for _, q in ipairs(M.hqs or {}) do if d2(p.x, p.z, q.x, q.z) <= prm("MapOnBaseR") then return "enemy base" end end
	local w = enemy_weight_near(en, p.x, p.z, prm("MapOnThreatR"))
	if w > ow * prm("MapOnRatio") then return "enemy near" end
	return nil
end
local function next_goal(state, en, cx, cz, skip, safe)
	local now = state.now
	local best, bs
	local ow = 0
	if safe then for _, u in ipairs(state.active) do if not M.runner[u.id] then ow = ow + weight_of(u) end end end
	for _, p in ipairs(M.pts) do
		if not p.ours and not p.us_cap and p.key ~= skip and not X.capper_at(p.key)   -- (1.1: not the one a squad of ours is taking)
			and not point_done(p, en, now) and not (M.bad_pt[p.key] and now - M.bad_pt[p.key] < 60)
			and not (safe and X.on_unsafe(p, en, ow)) then
			local _, n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))
			if n == 0 and not X.under_turret(p.x, p.z) then                      -- (0.7: not a point under a turret, unless that turret is being stormed)
				local s = d2(cx, cz, p.x, p.z) - (p.vp and prm("RunnerVpBonus") or 0)
				if M.pt_ours[p.key] and s <= prm("RunnerOwnR") then s = s - prm("RunnerOwnBonus") end   -- 0.6: a point that was ours, near the army, first
				if X.map_lost(p, now) then s = s - 1000 end                         -- 1.1: lost a moment ago, on our side - before any other, wherever the army is
				if not best or s < bs or (s == bs and p.key < best.key) then best, bs = p, s end
			end
		end
	end
	if best then return "point", best.key, best.x, best.y, best.z end
	if safe then return nil end                                               -- (the army covers; it does not go for an enemy squad while its point is taken)
	local be, bd
	for _, e in ipairs(en) do
		if not e.held and not e.nogo and not (M.eng_bad and M.eng_bad[tostring(e.id)] and now - M.eng_bad[tostring(e.id)] < prm("EngageBadSecs")) then   -- (1.3)
			local inbase = false
			for _, q in ipairs(M.hqs) do if d2(e.x, e.z, q.x, q.z) <= prm("GoalBaseR") then inbase = true; break end end
			if not inbase then
				local d = d2(cx, cz, e.x, e.z)
				if not be or d < bd or (d == bd and e.id < be.id) then be, bd = e, d end
			end
		end
	end
	if be and bd > prm("IdleTargetR") then return "enemy", tostring(be.id), be.x, be.y, be.z end
	return nil
end
-- the director's own target is used up: the army stood idle at it (M.stale = { key, t }) and Elite still has it on top.
-- Then the army goes from goal to goal and is not sent back to that target in between.
local function stale_target(now)
	local s = M.stale
	return s ~= nil and EliteAI.best_key == s.key and now - s.t < prm("GoalStaleSecs")
end
-- every tick: the goal's life (it ends when its point is done, or after GoalSecs without getting closer) and the one squad
-- that captures the goal point once the army stands on it (M.capper = { id, key, t0, last }; it stays taken while it captures)
local function goal_tick(state, en, cx, cz, taken)
	local now = state.now
	local map_on = prm("Map") >= 1
	-- 1.1 (TECH_RU.md 19.2; Orca fb 550: "it captures a point with the whole army, no map control"): up to MapCappers squads
	-- capture the army's goal points, each sent when the army is MapCapAhead from the point; the army does not stand at the
	-- point - it goes on to the next one, or covers the capturing squad when there is none
	M.cappers = M.cappers or {}
	for i = table.getn(M.cappers), 1, -1 do
		local c = M.cappers[i]
		local p, u = M.pts_by_key[c.key], nil
		for _, v in ipairs(state.active) do if v.id == c.id then u = v; break end end
		local why = nil
		if not p or not u then why = "gone"
		elseif point_done(p, en, now) then why = "done"
		elseif now - c.t0 > 75 then why = "timeout"
		elseif d2(u.pos.x, u.pos.z, p.x, p.z) > prm("SplitR") then why = "far"
		elseif map_on and d2(cx, cz, p.x, p.z) > prm("IdleTargetR") * 2 then
			local _, n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))    -- the army has gone on and an enemy comes: not alone there
			if n > 0 then why = "enemy at the point" end
		end
		if why then
			table.remove(M.cappers, i)
			if why == "enemy at the point" then
				M.bad_pt[c.key] = now
				morder(c.id, cx, u.pos.y, cz, ORD_MOVE)                          -- back to the army (a move cancels the capture)
				taken[c.id] = true
				mlog("Goal", "capture", c.id, "leaves", c.key, why)
			end
		else
			if not p.us_cap and now - c.last >= prm("GoalCapReissue") then morder(c.id, p.x, p.y, p.z, ORD_CAPTURE); c.last = now end
			taken[c.id] = true
		end
	end
	local g = EliteAI.goal
	if not g then return end
	local d = d2(cx, cz, g.x, g.z)
	if not g.dmin or d < g.dmin - 3 then g.dmin = d; if not GAR_GOALS[g.kind] or g.kind == "bypass" then g.t = now end end   -- getting closer: alive
	if now - g.t > prm("GoalSecs") then clear_goal("timeout"); return end
	if g.kind == "cover" then                                                 -- 1.1: it lives while a squad of ours captures that point
		local p = M.pts_by_key[g.key]
		if not p or not X.capper_at(g.key) or point_done(p, en, now) then clear_goal((p and p.ours) and "the point is ours" or "nobody captures there") else g.t = now end
		return
	end
	if not g.pt then return end
	local p = M.pts_by_key[g.key]
	if not p then clear_goal("point gone"); return end
	local done, why = point_done(p, en, now)
	if done then
		-- 1.1: on to the next one also when the director's own target lies in a zone the army stays out of (Orca's log: after
		-- every "Goal end point ..." the army got one attack-move at the enemy's base before Defence gave the next goal)
		local chain = (g.kind == "point") and (stale_target(now) or X.target_closed())
		clear_goal("point " .. tostring(why))
		if chain then                                                         -- on to the next one, not back to the used-up target
			local kind, key, x, y, z = next_goal(state, en, cx, cz)
			if kind then set_goal(kind, key, x, y, z, now, "next after " .. p.key, kind == "point") end
		end
		return
	end
	local n_army = 0
	for _, u in ipairs(state.active) do if not M.runner[u.id] and not X.is_raider(u.id) then n_army = n_army + 1 end end
	local maxc = map_on and math.min(prm("MapCappers"), math.max(1, math.floor(n_army / 3))) or 1
	local ahead = prm("IdleTargetR")
	if map_on and prm("MapCapAhead") > ahead then
		local _, n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))        -- ahead of the army only to a point nobody stands at
		if n == 0 then ahead = prm("MapCapAhead") end
	end
	local here = X.capper_at(p.key)
	if d <= ahead and not p.us_cap and not here and table.getn(M.cappers) < maxc then
		local best, bd
		for _, u in ipairs(state.active) do
			if not taken[u.id] and not M.runner[u.id] and not X.capper_of(u.id) and not X.is_raider(u.id) and can_cap(u.id)
				and not (M.norole[u.id] and now - M.norole[u.id] < prm("IdleRoleBan")) then
				local du = d2(u.pos.x, u.pos.z, p.x, p.z)
				if not best or du < bd or (du == bd and u.id < best.id) then best, bd = u, du end
			end
		end
		if best then
			here = { id = best.id, key = p.key, t0 = now, last = now }
			table.insert(M.cappers, here)
			morder(best.id, p.x, p.y, p.z, ORD_CAPTURE)
			taken[best.id] = true
			M.st.capper = (M.st.capper or 0) + 1
			mlog("Goal", "capture", best.id, M.names[best.id] or "?", "point", p.key, fmt("the army %.0f m from it", d))
		elseif d <= prm("IdleTargetR") then
			M.bad_pt[p.key] = now                                              -- nobody here can capture: not this point again for a while
			clear_goal("no squad that can capture")
			return
		end
	end
	if map_on and prm("MapMoveOn") >= 1 and g.kind == "point" and (here or p.us_cap) then
		local kind, key, x, y, z = next_goal(state, en, cx, cz, p.key, true)
		if kind == "point" then
			clear_goal("point " .. p.key .. " is being captured: the army goes on")
			set_goal(kind, key, x, y, z, now, "next while " .. p.key .. " is captured", true)
			M.st.map_on = (M.st.map_on or 0) + 1
		elseif here then
			-- no other point to take: the army covers its squad - MapCoverD from the point towards the nearest enemy HQ
			local qx, qz, qd
			for _, q in ipairs(M.hqs) do local dq = d2(p.x, p.z, q.x, q.z); if not qd or dq < qd then qx, qz, qd = q.x, q.z, dq end end
			local tx, tz = p.x, p.z
			if qd and qd > 1 then
				local k = math.min(prm("MapCoverD"), qd * 0.5) / qd
				tx, tz = p.x + (qx - p.x) * k, p.z + (qz - p.z) * k
				if X.under_turret(tx, tz) then tx, tz = p.x, p.z end
			end
			clear_goal("point " .. p.key .. " is being captured: the army covers")
			set_goal("cover", p.key, tx, p.y, tz, now, "no other point: between " .. p.key .. " and the enemy")
			M.st.map_cover = (M.st.map_cover or 0) + 1
		end
	end
end

--------------------------------------------------------------------------------------------------
-- 0.3 Idle: a squad that stands without an order out of a fight (the polygon: a carnifex stood 30-70 s after the fight
-- while the others went on; the army stood on a taken target). Per squad id: M.idle = { x, z, t0, last, n, mute } - the spot
-- and the time since the squad neither moved (IdleMoveD) nor fought (hit, fired, in melee) nor was busy (sent home, repair).
-- Idle for IdleSecs: a runner / split squad that is not capturing loses the role (and is not given one for IdleRoleBan);
-- the squad goes (attack-move) to the others when they are elsewhere, else to the director's target / goal; with an enemy
-- within IdleEnemyR it attacks that enemy after IdleNearSecs. When the army as a whole stands at its target, the next
-- goal is chosen (next_goal) and the director leads the army there. Every order is logged: "MECH Idle <id> <sbps> still
-- N s role R -> army|target|enemy|pull_back ...". Numbers only between ticks; orders through the same DLL queue.
local function idle_clock(state)
	local now, mv = state.now, prm("IdleMoveD")
	local act, rep = {}, {}
	for _, u in ipairs(state.active) do act[u.id] = true end
	for rid, a in pairs(M.repair) do rep[rid] = true; rep[a.vid] = true end    -- a set: the order of pairs() does not matter
	for _, u in ipairs(state.army) do
		local r, o = M.idle[u.id], M.own[u.id]
		local quiet = act[u.id] and not u.hit and not rep[u.id] and not (o and (o.fired or o.meleed))
		if not r then
			M.idle[u.id] = { x = u.pos.x, z = u.pos.z, t0 = now, last = -1000, n = 0, mute = -1 }
		elseif d2(u.pos.x, u.pos.z, r.x, r.z) > mv then
			r.x, r.z, r.t0, r.n = u.pos.x, u.pos.z, now, 0
		elseif not quiet then
			r.t0 = now
		end
	end
	-- 0.4: how long every squad has stood quiet, for the order book of main.ai (numbers; the table is rebuilt every tick)
	local f = {}
	for _, u in ipairs(state.army) do local r = M.idle[u.id]; if r then f[u.id] = now - r.t0 end end
	EliteAI.idle_for = f
end
local function idle_capturing(u)                                               -- at a point we are capturing: busy, not idle
	local cr = prm("IdleCapR")
	for _, p in ipairs(M.pts) do
		if p.us_cap and d2(u.pos.x, u.pos.z, p.x, p.z) <= cr then return true end
	end
	return false
end
-- where an idle squad goes: to the others when most of them are elsewhere (fewer than half of the army's squads within
-- GatherR of it: a squad that stands with the main body does not walk back for a straggler), else to the target / goal
local function idle_dest(state, u)
	local ox, oz, on, near = 0, 0, 0, 0
	local gr = EliteAI.num("GatherR", 30)
	for _, v in ipairs(state.active) do
		if v.id ~= u.id and not M.runner[v.id] then
			ox, oz, on = ox + v.pos.x, oz + v.pos.z, on + 1
			if d2(u.pos.x, u.pos.z, v.pos.x, v.pos.z) <= gr then near = near + 1 end
		end
	end
	if on > 0 and near * 2 < on then
		ox, oz = ox / on, oz / on
		if d2(u.pos.x, u.pos.z, ox, oz) > gr * 0.6 then return "army", ox, u.pos.y, oz end
	end
	local g = EliteAI.goal or ((not stale_target(state.now)) and (not X.target_closed()) and EliteAI.best_pos) or nil   -- (1.1: not a target under a turret nobody storms)
	if g and g.x and d2(u.pos.x, u.pos.z, g.x, g.z) > prm("IdleTargetR") then return "target", g.x, g.y or u.pos.y, g.z end
	return nil
end
local function run_idle(state, en, cx, cz, taken, covering)
	local now, n = state.now, 0
	local secs, near_secs, er, reissue = prm("IdleSecs"), prm("IdleNearSecs"), prm("IdleEnemyR"), prm("IdleReissue")
	local army_n, idle_n = 0, 0
	for _, u in ipairs(state.active) do
		local r = M.idle[u.id]
		if r then
			local still = now - r.t0
			local role = "army"
			if M.runner[u.id] then role = "runner"
			elseif M.split and M.split.assign[u.id] then role = "split"
			elseif X.capper_of(u.id) then role = "capper" end
			local rec = nil                                                        -- the role's record: it remembers that the squad did capture
			if role == "runner" then rec = M.runner[u.id] elseif role == "split" then rec = M.split.assign[u.id] elseif role == "capper" then rec = X.capper_of(u.id) end
			if rec and still >= near_secs and idle_capturing(u) then
				r.t0 = now; still = 0
				rec.capd = true
			end
			-- 0.9: a squad without a role that stands at a point we are capturing is capturing it (a runner released while it
			-- captured: s20, 50019 at 65/-96 got "-> army at 65 -94" - an attack-move that broke the capture off)
			-- Only a squad that can capture, and for IdleCapMax at most (a capture takes less).
			if role == "army" and still >= near_secs and can_cap(u.id) and idle_capturing(u) then
				r.capt = r.capt or now
				if now - r.capt <= prm("IdleCapMax") then r.t0 = now; still = 0 end
			elseif role == "army" then r.capt = nil end
			if role == "army" then
				army_n = army_n + 1
				if still >= prm("IdleArmySecs") and not taken[u.id] then idle_n = idle_n + 1 end
			end
			local mine = (role ~= "army") or (not taken[u.id] and not covering)   -- an army squad ordered this tick / covering a split is not ours
			if mine and still >= near_secs and now >= r.mute and now - r.last >= reissue then
				local ne, nd
				for _, e in ipairs(en) do
					local d = d2(e.x, e.z, u.pos.x, u.pos.z)
					if d <= er and (not ne or d < nd or (d == nd and e.id < ne.id)) then ne, nd = e, d end
				end
				local what, x, y, z
				if ne then
					if ne.nogo then what = nil                                         -- 0.7: under a turret the army stays away from - left alone
					elseif not ne.gar_skip then what = "enemy"
					elseif M.gar and M.gar.hold and nd <= prm("GarDangerR") then
						what, x, y, z = "pull_back", M.gar.hold.x, u.pos.y, M.gar.hold.z   -- a garrison we do not storm: not under its windows
					end
				elseif still >= secs then
					what, x, y, z = idle_dest(state, u)
				end
				local release = (role ~= "army") and (what ~= nil or (still >= secs and not ne))
				if release then
					-- a squad that stood idle in a capture role without ever capturing, twice: whatever PBG_CanCapture says, it
					-- gets no capture role again
					if rec and not rec.capd then
						M.capfail[u.id] = (M.capfail[u.id] or 0) + 1
						if M.capfail[u.id] >= 2 and not M.nocap[u.id] then
							M.nocap[u.id] = true
							mlog("Idle", u.id, M.names[u.id] or "?", "twice idle in a capture role without capturing: no capture role any more")
						end
					end
					if role == "runner" then M.runner[u.id] = nil
					elseif role == "split" then M.split.assign[u.id] = nil
					else X.capper_drop(u.id) end


					M.norole[u.id] = now
					M.st.idle_role = M.st.idle_role + 1
					if not what then mlog("Idle", u.id, M.names[u.id] or "?", fmt("still %.0f s", still), "role", role, "-> released") end
				end
				if what then
					-- 0.4: owner "idle" - the director's march orders to this squad wait OrderOwnerHold (it sent the squad one
					-- way and the director's gathering the other); an order the order book holds back is not counted or logged
					local sent
					if what == "enemy" then sent = morder(u.id, ne.id, 0, 0, ORD_ATTACK_SQUAD, "idle")
					elseif what == "pull_back" then sent = morder(u.id, x, y, z, ORD_MOVE, "idle")
					else sent = morder(u.id, x, y, z, ORD_AMOVE, "idle") end
					r.last = now
					if sent then
						r.t0, r.n = now, r.n + 1
						taken[u.id] = true
						n = n + 1
						M.st.idle = M.st.idle + 1
						mlog("Idle", u.id, M.names[u.id] or "?", fmt("still %.0f s", still), "role", role, "->", what,
							ne and fmt("enemy %d d %.0f", ne.id, nd) or fmt("at %.0f %.0f", x, z), "try", r.n, "phase", EliteAI.phase or "-")
						if r.n >= prm("IdleTries") then
							r.mute, r.n = now + prm("IdleMute"), 0
							mlog("Idle", u.id, "does not move after", prm("IdleTries"), "orders: left alone for", prm("IdleMute"), "s")
							-- 0.9 (TECH_RU.md 17.3): what the squad is doing, for the next log - s20 could not tell why a ravener
							-- ignored seven orders in 100 s. Squad_HasActiveCommand / Squad_GetActiveCommand are main.ai's builder
							-- check (in the game since newai-14), Squad_IsSuppressed is Defence's; the squad exists and has models
							local cmd, sup = "-", "-"
							if EliteAI.api_build and u.sq ~= nil then cmd = (Squad_HasActiveCommand(u.sq) == true) and tostring(Squad_GetActiveCommand(u.sq)) or "none" end
							if api().sup and u.sq ~= nil then sup = (Squad_IsSuppressed(u.sq) == true) and 1 or 0 end
							local o = M.own[u.id] or {}
							mlog("Idle", u.id, "stuck:", "command", cmd, "suppressed", sup, "melee_stance", o.mstance and 1 or 0, "meleed", o.meleed and 1 or 0,
								"fired", o.fired and 1 or 0, "hit", u.hit and 1 or 0, fmt("hp %.2f at %.0f %.0f", u.hp, u.pos.x, u.pos.z))
						end
					end
				end
			end
		end
	end
	-- the army as a whole (half of it or more) stands at its target with nothing to do: the next goal, the director leads
	-- (not while it holds in front of a garrison or covers a split - those waits are short and meant)
	if army_n > 0 and idle_n * 2 >= army_n and not covering and not (M.gar and M.gar.v == "hold") then
		local g = EliteAI.goal or ((not stale_target(now)) and (not X.target_closed()) and EliteAI.best_pos) or nil
		local at = (g == nil) or (g.x ~= nil and d2(cx, cz, g.x, g.z) <= prm("IdleTargetR") * 1.5)
		local gc = EliteAI.goal and X.capper_at(EliteAI.goal.key) or nil
		-- a squad is taking the goal point: wait a little; 1.1: the army that covers its capturing squad waits for it (goal_tick ends the cover)
		if at and not (EliteAI.goal and EliteAI.goal.kind == "cover") and not (EliteAI.goal and EliteAI.goal.pt and gc and now - gc.t0 < prm("GoalWait"))
			and not (M.eng and M.eng.hold) then                                   -- 1.3: while the army holds, X.run_engage gives the goals (safe points, the rally point)

			local kind, key, x, y, z = next_goal(state, en, cx, cz)
			if kind then
				if not EliteAI.goal and EliteAI.best_key then M.stale = { key = EliteAI.best_key, t = now } end   -- it stood at the director's target
				set_goal(kind, key, x, y, z, now, fmt("the army (%d of %d squads) stood at its target", idle_n, army_n), kind == "point")   -- the same goal again: refreshed
			elseif not M.said.nogoal or now - M.said.nogoal >= 60 then
				M.said.nogoal = now
				mlog("Idle", "army", fmt("%d of %d squads stand", idle_n, army_n), "no goal: every point is ours or held by the enemy, no enemy squad in the field")
			end

		end
	end
	return n
end

--------------------------------------------------------------------------------------------------
-- 0.3 Garrison: an enemy squad inside a building (the polygon: a squad in a building at our nearest point - no squad of ours
-- came within 35 m in 100 s, the point dropped out of every target list: runners and the split skip points with enemies,
-- the director's target was elsewhere). Detector: Squad_IsInHoldEntity on the enemy squads of the scan, the building next
-- to our HQ / a point of ours or on our half / the director's target / the army. The answer follows the tactics base
-- (reports/tactics_kb KB_RU.md section T2, kb.yaml threats.garrisoned_enemy): flamers, grenades and area
-- weapons beat a garrison, plain shooting hardly hurts it, melee on the building is bad, the squad that leaves is caught at
-- the exit. The arbiter Conf_Garrison (A/B/C = 1/2/3, hysteresis ConfHold, every switch logged):
--   1 = tools first: assault only with an anti-garrison tool in the army (and ours >= garrison x GarToolRatio), or when we
--       outweigh it GarBruteRatio times with the cover factor; otherwise wait;
--   2 = by strength: assault when ours >= (garrison x cover + support) x GarRatio, with a tool x GarToolRatio; otherwise wait;
--   3 = bypass: assault only with a tool and a margin (x1.2) or by brute force; otherwise bypass at once.
-- "wait" next to something of ours (rules 1, 2; rule 3 only at our HQ) = "hold" for GarHoldSecs (the army stands GarHoldR
-- from the building towards our HQ: out of its range, between it and the base, while the counter units are asked for),
-- then "bypass": the director goes on - when its target is the garrisoned place, another place is the goal ("bypass"), when
-- its way passes the building, a point GarDangerR + 10 from it on the side of the way comes first ("detour"). A garrison at
-- our HQ is held again after GarBypassSecs. The decision is taken anew every tick: tools bought meanwhile turn it into an
-- assault wherever the army is. In hold / bypass the garrison's fire does not call the army in (the director's rule 1):
-- a squad it hits goes back to the hold spot (hold) or runs on past it with a plain move (bypass). The garrison is never a
-- FocusFire / MeleeTie / RunnerFight target - storming it is this pattern's decision.

-- "assault": the army walks to the building as one fist (goal "gar"), then every squad gets its order: grenade squads
-- throw (ability at the building's position, once per GarGrenCd), the Autarch jumps on it, flamers / vehicles / shooters
-- attack the building (elite.scar: an attack order on a squad inside a building becomes an attack on the building), melee
-- squads wait GarMeleeR away for the squad that comes out (they join the attack after 20 s).
-- EliteAI.gar = { id, t0, v, tools, x, z } tells the purchase scripts (strategy_unit_purchase.ai "GAR"): counter units and
-- flamer / grenade upgrades get a higher demand once the garrison has held for Gar_BuySecs.
local function gar_tool(u)                                                     -- weight as an anti-garrison tool, kind
	local c = ucls(u)
	if c.gar then return c.gar_w or 1, c.gar end
	weight_of(u)
	if u.veh or c.siege then return 0.5, "siege" end
	return 0, nil
end
local function gar_find(en, h)                                                 -- the garrison closest to our HQ among those next to something of ours
	local pr = prm("GarPointR")
	local best, bwhy, bd
	for _, e in ipairs(en) do
		if e.held then
			local why
			if h and d2(e.x, e.z, h.x, h.z) <= prm("GarHomeR") then why = "home" end
			if not why then
				for _, p in ipairs(M.pts) do
					if (p.ours or p.us_cap or not p.enemy_half) and d2(e.x, e.z, p.x, p.z) <= pr then why = "point " .. p.key; break end
				end
			end
			if not why and EliteAI.best_pos and d2(e.x, e.z, EliteAI.best_pos.x, EliteAI.best_pos.z) <= pr then why = "target" end
			if not why and e.d <= prm("ZoneR") then why = "army" end
			if why then
				local d = h and d2(e.x, e.z, h.x, h.z) or e.d
				if not best or d < bd or (d == bd and e.id < best.id) then best, bwhy, bd = e, why, d end
			end
		end
	end
	return best, bwhy
end
-- hold / bypass: nobody stands under the windows. A squad the garrison shoots at (no other enemy around it) is not "a fight
-- the army runs to" (the director's rule 1: u.hit is cleared) and gets a plain move, no attack-move that would stop to shoot
-- the building: "hold" - back to the hold spot (which moves 10 m further when squads are hit on it); "bypass" - on to
-- where the army is going (tx, tz: the goal / the director's target), it runs past instead of turning round under fire
local function gar_pull_back(state, en, G, taken, tx, tz)
	local now, dr, sr = state.now, prm("GarDangerR") * 1.4, prm("SightR")
	for _, u in ipairs(state.active) do
		local d = d2(u.pos.x, u.pos.z, G.x, G.z)
		if u.hit and d <= dr then
			local other = false
			for _, x in ipairs(en) do
				if not x.gar and d2(x.x, x.z, u.pos.x, u.pos.z) <= sr then other = true; break end
			end
			if not other then
				u.hit = false
				if not M.gar_ord[u.id] or now - M.gar_ord[u.id] >= prm("GarReissue") then
					M.gar_ord[u.id] = now
					if tx then
						morder(u.id, tx, u.pos.y, tz, ORD_MOVE)
						mlog("Garrison", "run past", u.id, M.names[u.id] or "?", fmt("d %.0f to %.0f %.0f", d, tx, tz))
					else
						if d2(u.pos.x, u.pos.z, G.hold.x, G.hold.z) <= 8 and (G.hr or 0) < 80 then G.hr = (G.hr or prm("GarHoldR")) + 10 end   -- hit on the spot: it is in range
						morder(u.id, G.hold.x, u.pos.y, G.hold.z, ORD_MOVE)
						mlog("Garrison", "pull back", u.id, M.names[u.id] or "?", fmt("d %.0f hold %.0f m", d, G.hr or prm("GarHoldR")))
					end
				end
				taken[u.id] = true
			end
		end
	end
end
-- bypass: the straight way from the army (ax, az) to where it goes (tx, tz) passes within r of the building (bx, bz) -> the
-- point r + 10 from the building on the side the way passes (nil when the way is clear or the building is behind / beyond)
local function gar_detour(ax, az, tx, tz, bx, bz, r)
	local sx, sz = tx - ax, tz - az
	local sl2 = sx * sx + sz * sz
	if sl2 < 1 then return nil end
	local k = ((bx - ax) * sx + (bz - az) * sz) / sl2                          -- the building's projection on the way, 0..1
	if k <= 0 or k >= 1 then return nil end
	local px, pz = ax + sx * k, az + sz * k
	local nx, nz = px - bx, pz - bz
	local nl = math.sqrt(nx * nx + nz * nz)
	if nl >= r then return nil end
	if nl < 1 then local sl = math.sqrt(sl2); nx, nz, nl = -sz / sl, sx / sl, 1 end   -- the building right on the way: to the left of it
	return bx + nx / nl * (r + 10), bz + nz / nl * (r + 10)
end
local function run_garrison(state, en, cx, cz, h, taken)
	local now = state.now
	local G = M.gar
	local e, why
	if G then                                                                   -- the one we know, while its squad is still inside
		for _, x in ipairs(en) do if x.id == G.id then e = x; break end end
		if e and e.held then why = G.why else e = nil end
	end
	if not e then e, why = gar_find(en, h) end
	if not e then
		if G then
			mlog("Garrison", "end", G.id, "the squad left the building or is gone", fmt("after %.0f s", now - G.t0), "last", G.v or "-")
			M.gar, EliteAI.gar = nil, nil
			clear_goal("garrison over", GAR_GOALS)
		end
		return false
	end
	if not G or G.id ~= e.id then
		if G then mlog("Garrison", "end", G.id, "replaced by", e.id); clear_goal("another garrison", GAR_GOALS) end
		G = { id = e.id, t0 = now, why = why, last_log = now }
		M.gar = G
		M.st.gar = M.st.gar + 1
		mlog("Garrison", "found", e.id, fmt("at %.0f %.0f", e.x, e.z), "near", why, fmt("hp %.2f n %d w %.0f", e.hp, e.n, e.w))
	end
	G.x, G.y, G.z = e.x, e.y, e.z
	-- strengths: the squads in the building, the enemy around it, ours and our tools (runners are not the army)
	local gw, sup = 0, 0
	for _, x in ipairs(en) do
		local d = d2(x.x, x.z, e.x, e.z)
		if x.held and d <= prm("GarBldR") then gw = gw + x.w; x.gar = true
		elseif d <= prm("GarSupportR") then sup = sup + x.w end
	end
	local ours, tools = 0, 0
	for _, u in ipairs(state.active) do
		if not M.runner[u.id] then
			ours = ours + weight_of(u)
			tools = tools + gar_tool(u)
		end
	end
	-- an assault under way is not called off by a small change (a squad sent home, one model lost): the thresholds are lower
	local keep = (G.v == "assault")
	local kk, tneed = keep and prm("GarKeepK") or 1, keep and 0.5 or 1
	local has_tool = (tools >= tneed)
	local coverk = has_tool and prm("GarToolK") or prm("GarCoverK")
	local ratio = ours / math.max(gw * coverk + sup, 1)
	local r = rule("Garrison")
	local v = "wait"
	if r == 1 then
		if (has_tool and ratio >= prm("GarToolRatio") * kk) or ratio >= prm("GarBruteRatio") * kk then v = "assault" end
	elseif r == 2 then
		if ratio >= (has_tool and prm("GarToolRatio") or prm("GarRatio")) * kk then v = "assault" end
	else
		if (has_tool and ratio >= prm("GarToolRatio") * 1.2 * kk) or ratio >= prm("GarBruteRatio") * kk then v = "assault" end
	end
	if v == "wait" then
		-- hold first (GarHoldSecs: the army between the building and our base while the counters are asked for), then bypass;
		-- only a garrison at our HQ is held again and again (hold, GarBypassSecs of bypass, hold ...)
		G.wait0 = G.wait0 or now
		local ours_near = (why == "home") or (r ~= 3 and why ~= "target" and why ~= "army" and d2(cx, cz, e.x, e.z) <= prm("GarHoldNearR"))
		v = "bypass"
		if ours_near then
			local w, hs = now - G.wait0, prm("GarHoldSecs")
			if why == "home" then
				local cyc = hs + prm("GarBypassSecs")
				w = w - math.floor(w / cyc) * cyc
			end
			if w < hs then v = "hold" end
		end
	else
		G.wait0 = nil
	end
	local reason = fmt("ours %.0f garrison %.0f support %.0f tools %.1f ratio %.2f near %s", ours, gw, sup, tools, ratio, why)
	local first = (M.conf["Garrison:" .. tostring(G.id)] == nil)
	v = decide("Garrison", G.id, v, reason, now, prm("GarConfHold"))
	if first then mlog("Garrison", G.id, "->", v, reason, "rule", r) end

	if G.v ~= v then M.st["gar_" .. v] = (M.st["gar_" .. v] or 0) + 1 end
	G.v, G.tools, G.ratio = v, tools, ratio
	if now - G.last_log >= prm("GarLogSecs") then
		G.last_log = now
		mlog("Garrison", "state", G.id, v, reason, fmt("for %.0f s", now - G.t0))
	end
	-- the hold spot: GarHoldR from the building towards our HQ (not beyond it)
	local hx, hz = cx - e.x, cz - e.z
	if h then hx, hz = h.x - e.x, h.z - e.z end
	local hl = math.sqrt(hx * hx + hz * hz)
	if hl < 1 then hx, hz, hl = 1, 0, 1 end
	local hr = math.min(G.hr or prm("GarHoldR"), hl)
	G.hold = { x = e.x + hx / hl * hr, z = e.z + hz / hl * hr }
	EliteAI.gar = { id = G.id, t0 = G.t0, v = v, tools = tools, x = G.x, z = G.z }
	for _, x in ipairs(en) do if x.gar then x.gar_skip = (v ~= "assault") end end
	if v == "hold" then
		set_goal("gar_hold", tostring(G.id), G.hold.x, e.y, G.hold.z, now, "hold: out of the garrison's range, between it and our base")
		gar_pull_back(state, en, G, taken)
		return false                                                          -- (EliteAI.phase stays the director's: a foreign phase makes it re-issue its orders every tick)
	end
	if v == "bypass" then
		local g, bp = EliteAI.goal, EliteAI.best_pos
		local dr = prm("GarDangerR")
		if g and (g.kind == "gar" or g.kind == "gar_hold") then clear_goal("garrison bypass", GAR_GOALS); g = nil end
		if g and g.kind == "detour" and d2(cx, cz, g.x, g.z) <= prm("IdleTargetR") then clear_goal("round the building"); g = nil end
		if bp and d2(bp.x, bp.z, e.x, e.z) <= dr then                          -- the director's own target is the garrisoned place
			if g and g.kind == "bypass" then
				g.t = now
			elseif not g then
				local kind, key, x, y, z = next_goal(state, en, cx, cz)
				if kind then set_goal("bypass", key, x, y, z, now, "the director's target is the garrisoned place", kind == "point") end
			end
		end
		-- the way to where the army goes passes the building: round it (a goal GarDangerR + 10 from it on the side of the way)
		g = EliteAI.goal
		local to = (g and g.kind ~= "detour") and g or bp
		if g and g.kind == "detour" then
			g.t = now
		elseif to and to.x then
			local wx, wz = gar_detour(cx, cz, to.x, to.z, e.x, e.z, dr + 5)
			if wx then set_goal("detour", tostring(G.id), wx, e.y, wz, now, fmt("the way to %.0f %.0f passes the building", to.x, to.z)) end
		end
		g = EliteAI.goal or bp
		if g and g.x then gar_pull_back(state, en, G, taken, g.x, g.z) else gar_pull_back(state, en, G, taken) end
		return false
	end
	-- assault
	if d2(cx, cz, e.x, e.z) > prm("GarEngageR") then
		set_goal("gar", tostring(G.id), e.x, e.y, e.z, now, "assault: the army walks to the building as one fist")
		return false
	end

	clear_goal("garrison engaged", GAR_GOALS)
	local n, mr = 0, prm("GarMeleeR")
	local ax, az = cx - e.x, cz - e.z
	local al = math.sqrt(ax * ax + az * az)
	if al < 1 then ax, az, al = hx, hz, hl end
	local wx, wz = e.x + ax / al * mr, e.z + az / al * mr                       -- where melee squads wait: on our side of the building
	for _, u in ipairs(state.active) do
		if not taken[u.id] and not M.runner[u.id] then
			local c = ucls(u)
			local _, kind = gar_tool(u)
			local d = d2(u.pos.x, u.pos.z, e.x, e.z)
			local last = M.gar_ord[u.id]
			local due = (not last) or now - last >= prm("GarReissue")
			local gren_ready = c.gar_abil and now - (M.gren[u.id] or -1000) >= prm("GarGrenCd")
			if gren_ready and d > prm("GarGrenR") and (c.gar_w or 1) >= 1 then
				-- 0.4: walk up to throwing distance (b2: the devils fired from 37 m and never threw): a plain move to the spot
				-- GarGrenR - 4 from the building on the squad's own side; the throw follows on the tick it gets there
				if due then
					local k = (prm("GarGrenR") - 4) / d
					local px, pz = e.x + (u.pos.x - e.x) * k, e.z + (u.pos.z - e.z) * k
					if morder(u.id, px, u.pos.y, pz, ORD_MOVE) then
						M.st.gar_appr = (M.st.gar_appr or 0) + 1
						mlog("Garrison", "approach", u.id, M.names[u.id] or "?", "->", G.id, fmt("d %.0f -> %.0f m to throw", d, prm("GarGrenR") - 4))
					end
					M.gar_ord[u.id] = now
				end
			elseif gren_ready and d <= prm("GarGrenR") then
				M.gren[u.id], M.gar_ord[u.id] = now, nil                         -- the attack order follows on the next tick
				M.st.gren = M.st.gren + 1
				morder(u.id, e.x, e.y, e.z, ORD_ABILITY_POS + c.gar_abil)
				mlog("Garrison", "grenade", u.id, M.names[u.id] or "?", "->", G.id, fmt("d %.0f ability %d", d, c.gar_abil))
			elseif kind == "jump" and c.jump and d >= prm("JumpMin") and d <= prm("JumpMax") and now - (M.jumped[u.id] or -1000) >= prm("JumpCd") then
				M.jumped[u.id], M.gar_ord[u.id] = now, nil
				M.st.jump = M.st.jump + 1
				morder(u.id, e.x, e.y, e.z, ORD_ABILITY_POS + c.jump)
				mlog("Garrison", "jump", u.id, M.names[u.id] or "?", "->", G.id, fmt("d %.0f ability %d", d, c.jump))
			elseif c.melee and not kind and now - (G.melee0 or now) < 20 then
				G.melee0 = G.melee0 or now                                       -- melee: the exit first, the building after 20 s
				if due and d2(u.pos.x, u.pos.z, wx, wz) > 6 then
					morder(u.id, wx, u.pos.y, wz, ORD_MOVE)
					M.gar_ord[u.id] = now
				end
			elseif due then
				morder(u.id, G.id, 0, 0, ORD_ATTACK_SQUAD)                       -- elite.scar: the building is attacked
				M.gar_ord[u.id] = now
			end
			taken[u.id] = true
			n = n + 1
		end
	end
	EliteAI.phase = "m_garrison"
	return n > 0
end

--------------------------------------------------------------------------------------------------
-- 0.7 (TECH_RU.md 15.7 - 15.9; Orca's match against a human, fb 511 of reports/newai_1110/BACKLOG_RU.md) DEFENCE, VEHICLES, SETUP.
--
-- DEFENCE - "it runs under the base turrets and dies there again and again". Nothing knew the turrets: the enemy scan reads
-- squads, a squad that is shot calls the whole army to its spot (the director's rule 1), and the retreat check weighs squads
-- only. Now the defence buildings are known (M.defs: by the engine's entity list when the functions are there - blueprint
-- names with DEF_KEYS - else one zone of BaseDefR around every enemy HQ) and each has a strength (DefW per turret x its
-- health; turrets within DefClusterR cover each other). For a turret the army is near to (a squad within its zone + DefNearPad,
-- or the army's target inside the zone):
--   ours (the active squads within DefArmyR) / (turrets x (1 + DefMemK x squads lost there) + enemy squads within DefSupportR)
--   >= DefRatio (1.5), or DefToolRatio (1.1) with something that takes a turret down (vehicles, monsters, DEF_TOOLS)  -> assault:
--        the tools attack the turret itself (order mode 7: the enemy building at that spot), the rest fight as usual;
--   else -> avoid: every squad inside the zone walks out (DefOutD outside it), nobody is sent in - the zone is in
--        EliteAI.def_block (the director of main.ai: a squad shot inside it does not call the army there, a target inside
--        it is not marched at), enemies inside it are no targets (e.nogo: FocusFire, PunishTurn, Idle, the goals), points
--        inside it are nobody's (runners, goals); the army gets another goal (next_goal) or holds DefHoldD outside the zone;
--        artillery within DefArtR ("art": it outranges the turret) shells the turret meanwhile.
-- The memory (M.def_mem[key] = { lost, t }): a squad of ours that died, or went home hurt, within the zone + DefLossPad is
-- that turret's - each makes it count DefMemK stronger for DefMemSecs ("Defence <key> lost a squad there: N"), so what failed
-- is not tried again with the same force. Lines "MECH Defence <key> assault|avoid ours W theirs W (turrets N x W, lost K)
-- need R tools N", "Conf_BaseDef <key> avoid->assault ...", "Defence <key> out <id> ...", "... siege <id> <sbps>".
-- Mech_Defence=0 = off; Mech_DefApi=0 = the zones at the enemy HQs only.
function X.blocked(x, z, pad)
	local b = EliteAI.def_block
	if type(b) ~= "table" then return false end
	for _, q in ipairs(b) do if d2(x, z, q.x, q.z) <= q.r + (pad or 0) then return true, q end end
	return false
end
-- a point under a turret is nobody's target before anybody has walked up to it: every known defence building closes its zone
-- for the runners and the goals, except one the army is storming now (d.v, set by X.run_def this tick or an earlier one)
function X.under_turret(x, z)
	for _, d in ipairs(M.defs or {}) do
		if d.v ~= "assault" and d2(x, z, d.x, d.z) <= d.r then return true, d end
	end
	return false
end
function X.tool(u)                                                            -- "art" / "av" / nil
	local name = M.names[u.id] or ""
	for _, t in ipairs(DEF_TOOLS) do if ends_with(name, t[1]) then return t[2] end end
	weight_of(u)
	if has_key(name, TRANSPORTS) then return nil end
	if u.veh or has_key(name, GAR_SIEGE) then return "av" end
	return nil
end
-- 0.8 (TECH_RU.md 16.3; the polygon's scene f, newai-14: 50008 stood in the zones of two turrets, was ordered out along the
-- line from the first turret, 6 s later along the line from the second, walked 12 m in 11 s - suppressed - and lost 2 of 3
-- models). The way out is one for all the zones the army stays away from: the point DefOutD outside every one of them that
-- is nearest to the squad (16 directions, the first "straight away from this turret"; one of the others wins only when it
-- is at least half a metre shorter). Returns x, z and the length of the way.
function X.def_exit(px, pz, d0, defs)
	local pad, nd = prm("DefOutD"), 16
	local bx, bz = px - d0.x, pz - d0.z
	local bl = math.sqrt(bx * bx + bz * bz)
	if bl < 1 then                                                            -- on the turret itself: towards our HQ
		local hh = home()
		bx, bz = (hh and hh.x or (px + 1)) - d0.x, (hh and hh.z or pz) - d0.z
		bl = math.max(math.sqrt(bx * bx + bz * bz), 1)
	end
	bx, bz = bx / bl, bz / bl
	local best_l, best_x, best_z
	for i = 0, nd - 1 do
		local k = (i - math.floor(i / 2) * 2 == 1) and ((i + 1) / 2) or (-(i / 2))   -- 0, 1, -1, 2, -2 ... 8
		local a = k * 2 * math.pi / nd
		local c, sn = math.cos(a), math.sin(a)
		local ux, uz = bx * c - bz * sn, bx * sn + bz * c
		local L = 0
		for pass = 1, 6 do                                                     -- the ray leaves one zone into the next: until it is out of all
			local moved = false
			for _, q in ipairs(defs) do
				if q.v ~= "assault" then
					local R = q.r + pad
					local wx, wz = px + ux * L - q.x, pz + uz * L - q.z
					if wx * wx + wz * wz < R * R - 0.01 then
						local ox, oz = px - q.x, pz - q.z
						local b = ox * ux + oz * uz
						local disc = b * b - (ox * ox + oz * oz - R * R)
						if disc > 0 then
							local t = -b + math.sqrt(disc)
							if t > L then L = t; moved = true end
						end
					end
				end
			end
			if not moved then break end
		end
		if best_l == nil or L < best_l - 0.5 then best_l, best_x, best_z = L, px + ux * L, pz + uz * L end
	end
	return best_x, best_z, best_l
end
-- 0.9: a turret's zone by its blueprint name
function X.def_r(nm)
	if prm("DefRangeData") < 1 then return prm("DefR") end
	for _, t in ipairs(DEF_RANGE) do if string.find(nm, t[1], 1, true) then return t[2] + prm("DefRangePad") end end
	return prm("DefRangeDef") + prm("DefRangePad")
end
function X.siege_row(u)
	local name = M.names[u.id] or ""
	for _, t in ipairs(SIEGE) do if ends_with(name, t[1]) then return t end end
	return nil
end
-- 0.9 SIEGE FROM OUTSIDE (TECH_RU.md 17.1; s20: "siege 50023 d 105", "d 48", "d 43", "out ... d 37 hp 0.56", "siege d 49", "out ...
-- d 37 hp 0.22", "lost a squad there: 50023" - the manticore was sent at the turret with an attack order, drove up to the
-- range of its las turret, that was inside the zone, the next tick ordered it out, two ticks later at the turret again).
-- One decision per squad and turret, kept in M.siege[id] = { key, mode, x, z, t0 } until the turret is gone, the squad is
-- lost or SiegeHoldSecs:
--   "standoff" - its range reaches from outside the zone: the spot SiegeStandD outside the zone (inside its range, beyond
--                its minimum range, outside every other turret's zone) on the squad's side of the turret; it goes there
--                with a plain move - also when it stands inside the zone now - and fires from there (the ability at the
--                turret's position, or an attack order when its own weapon reaches);
--   "none"     - its range does not reach, or there is no such spot: it is no siege squad for that turret - it is ordered
--                like everybody else (out of the zone, in with an assault) and never at the turret from outside.
-- Returns true = ordered here (the squad is taken), "skip" = it shells another turret (nothing for this one), nil = not a
-- siege squad here.
function X.siege_tick(u, d, defs, now, h, act)
	local row = X.siege_row(u)
	if row == nil then return nil end
	M.siege = M.siege or {}
	local S = M.siege[u.id]
	local du = d2(u.pos.x, u.pos.z, d.x, d.z)
	if S ~= nil and S.key ~= d.key then
		if S.mode == "standoff" then return "skip" end
		return nil
	end
	if S == nil then
		if du > prm("DefArtR") then return nil end
		-- not alone: a decision is taken only with another squad of the army within SiegeCoverR of this one (the army went on to
		-- another goal: the squad follows it at the next decision, SiegeHoldSecs at the latest)
		local cover = false
		for _, v in ipairs(act or {}) do
			if v.id ~= u.id and not M.runner[v.id] and d2(v.pos.x, v.pos.z, u.pos.x, u.pos.z) <= prm("SiegeCoverR") then cover = true; break end
		end
		if not cover then return nil end
		S = { key = d.key, t0 = now, last = -1000, cast = -1000, range = row[2], minr = row[3] }
		local far = row[2] - prm("SiegeInD")
		local why = nil
		if far < d.r + 1 then why = fmt("its range %d does not reach from outside the zone %d", row[2], d.r)
		else
			local sd = math.min(far, math.max(d.r + prm("SiegeStandD"), row[3] + prm("SiegeInD")))
			local bx, bz = u.pos.x - d.x, u.pos.z - d.z
			local bl = math.sqrt(bx * bx + bz * bz)
			if bl < 1 then
				bx, bz = (h and h.x or (d.x + 1)) - d.x, (h and h.z or d.z) - d.z
				bl = math.max(math.sqrt(bx * bx + bz * bz), 1)
			end
			bx, bz = bx / bl, bz / bl
			for i = 0, 15 do                                                      -- the squad's side first, then turned by 22.5 degrees: 1, -1, 2, -2 ... 8
				local k = (i - math.floor(i / 2) * 2 == 1) and ((i + 1) / 2) or (-(i / 2))
				local a = k * math.pi / 8
				local c, sn = math.cos(a), math.sin(a)
				local px, pz = d.x + (bx * c - bz * sn) * sd, d.z + (bx * sn + bz * c) * sd
				local free = true
				for _, q in ipairs(defs) do if q.key ~= d.key and d2(px, pz, q.x, q.z) <= q.r + 1 then free = false; break end end
				if free then S.x, S.z, S.sd = px, pz, sd; break end
			end
			if S.x == nil then why = "no spot outside the zones of the other turrets" end
		end
		if why then
			S.mode = "none"
			M.st.def_nosiege = (M.st.def_nosiege or 0) + 1
			mlog("Defence", d.key, "siege", u.id, M.names[u.id] or "?", "no:", why, "- other means; held", prm("SiegeHoldSecs"), "s")
		else
			S.mode = "standoff"
			M.st.def_standoff = (M.st.def_standoff or 0) + 1
			mlog("Defence", d.key, "siege", u.id, M.names[u.id] or "?", fmt("stand-off: range %d (min %d) zone %d -> the spot %.0f %.0f, %.0f m from the turret (now %.0f m)", row[2], row[3], d.r, S.x, S.z, S.sd, du),
				"held until the turret is gone or", prm("SiegeHoldSecs"), "s")
		end
		M.siege[u.id] = S
	end
	if S.mode ~= "standoff" then return nil end
	weight_of(u)
	-- a damaged squad under fire is not held at its spot: the Vehicles mechanic / the director's retreat take it out
	if u.hit and u.hp < prm("VehBackHP") then return nil end
	local ds = d2(u.pos.x, u.pos.z, S.x, S.z)
	if ds > prm("SiegeSpotR") then
		if now - S.last >= prm("DefReissue") then
			S.last = now
			morder(u.id, S.x, u.pos.y, S.z, ORD_MOVE)
			if not S.said then S.said = true; mlog("Defence", d.key, "siege", u.id, fmt("to its spot %.0f %.0f (%.0f m away, %.0f m from the turret now)", S.x, S.z, ds, du)) end
		end
	elseif row[4] then
		if now - S.cast >= prm("SiegeCastSecs") then
			S.cast = now
			morder(u.id, d.x, d.y or 0, d.z, ORD_ABILITY_POS + row[4])
			M.st.def_siege = (M.st.def_siege or 0) + 1
			mlog("Defence", d.key, "siege", u.id, M.names[u.id] or "?", fmt("fires ability %d from %.0f m (outside the zone %d)", row[4], du, d.r))
		end
	elseif now - S.cast >= prm("DefReissue") * 2 then
		S.cast = now
		morder(u.id, d.x, d.y or 0, d.z, ORD_ATTACK_STRUCT)
		M.st.def_siege = (M.st.def_siege or 0) + 1
		mlog("Defence", d.key, "siege", u.id, M.names[u.id] or "?", fmt("attacks from %.0f m (outside the zone %d)", du, d.r))
	end
	return true
end
-- the decisions that are over (each entry on its own; the ids sorted for the log)
function X.siege_end(defs, now)
	if M.siege == nil then return end
	local live, ids = {}, {}
	for _, d in ipairs(defs) do live[d.key] = true end
	for id in pairs(M.siege) do table.insert(ids, id) end
	table.sort(ids)
	for _, id in ipairs(ids) do
		local S = M.siege[id]
		local why = nil
		if M.exists ~= nil and M.exists[id] ~= true then why = "the squad is lost"
		elseif not live[S.key] then why = "the turret is gone"
		elseif now - S.t0 >= prm("SiegeHoldSecs") then why = "time" end
		if why then
			M.siege[id] = nil
			mlog("Defence", S.key, "siege", id, "ends after", math.floor(now - S.t0), "s why", why, "mode", S.mode)
		end
	end
end
-- 1.0 (Orca fb 527: "did the scan take our own turrets for the enemy's?"): only the entities of the players the engine calls
-- our ENEMY are read (Player_GetRelationship == R_ENEMY, the filter of scan_enemies; we ourselves and our allies are never
-- asked for theirs), and every turret keeps the index and the team of the player it was read from - the scan line names
-- them ("<key> owner p<i> team <t>", "we: team <t>"). A turret whose owner's team is ours is dropped and counted ("own_team
-- skipped N": must stay 0 - a number above 0 says the engine's relationship answer is not what we think it is).
function X.def_scan(now, en_players)
	if M.def_t ~= nil and now - M.def_t < prm("DefScanSecs") then return end
	M.def_t = now
	local list, own_skip = {}, 0
	if api().ents then
		local n_pl = World_GetPlayerCount()
		for i = 1, n_pl do
			local p = World_GetPlayerAt(i)
			if p and Player_IsAlive(p) and Player_GetRelationship(s_self_modplayer, p) == R_ENEMY then
				local team = Player_GetTeam(p)                                      -- (scan_points asks the same of every player)
				local eg = (team ~= s_self_team) and Player_GetEntities(p) or nil
				if team == s_self_team then own_skip = own_skip + 1 end
				local cnt = eg and EGroup_CountSpawned(eg) or 0
				for j = 1, cnt do
					local e = EGroup_GetSpawnedEntityAt(eg, j)
					if e ~= nil then
						local nm = string.lower(Entity_GetBlueprintName(e) or "")
						if has_key(nm, DEF_KEYS) then
							local pos, hp = Entity_GetPosition(e), Entity_GetHealthPercentage(e) or 1
							if pos ~= nil and pos.x ~= nil and pos.z ~= nil and hp > 0 then
								table.insert(list, { x = pos.x, y = pos.y, z = pos.z, hp = hp, w = prm("DefW") * hp, r = X.def_r(nm), key = fmt("%.0f/%.0f", pos.x, pos.z), n = 1,
									own = i, team = team })
							end
						end
					end
				end
			end
		end
	else
		for _, q in ipairs(M.hqs or {}) do
			table.insert(list, { x = q.x, y = q.y or 0, z = q.z, hp = 1, w = prm("BaseDefW"), r = prm("BaseDefR"), key = fmt("hq %.0f/%.0f", q.x, q.z), n = 2, virtual = true })
		end
	end
	table.sort(list, function(a, b) return a.key < b.key end)
	local was = {}
	for _, d in ipairs(M.defs or {}) do was[d.key] = d.v end                   -- the decision outlives the rescan
	for _, d in ipairs(list) do d.v = was[d.key] end
	local sig = {}
	for i, d in ipairs(list) do if i <= 8 then table.insert(sig, d.key .. " owner " .. (d.own and ("p" .. d.own .. " team " .. tostring(d.team)) or "hq")) end end
	sig = table.concat(sig, ", ")
	if table.getn(list) ~= (M.defs and table.getn(M.defs) or -1) or sig ~= M.def_sig then
		M.def_sig = sig
		mlog("Defence", "scan", table.getn(list), api().ents and "turrets" or "zones at enemy HQs", "t", math.floor(now), "|", sig, "| we: team", tostring(s_self_team),
			"own_team skipped", own_skip)
	end
	M.defs = list
end
function X.run_def(state, en, cx, cz, h, taken)
	local now = state.now
	X.def_scan(now)
	M.def_mem, M.def_in, M.def_ord, M.def_said = M.def_mem or {}, M.def_in or {}, M.def_ord or {}, M.def_said or {}
	local defs = M.defs or {}
	local sg_on = prm("Siege") >= 1
	if sg_on then X.siege_end(defs, now) elseif M.siege then M.siege = nil end
	local skeys, need_n, need_key = {}, 0, nil                                -- 0.9: the turrets somebody shells from outside; the ones nothing of ours outranges
	for _, S in pairs(M.siege or {}) do if S.mode == "standoff" then skeys[S.key] = true end end   -- (a set)
	-- the memory: who was inside a zone at the last tick and is dead, or was sent home hurt, now
	local alive_now = {}
	for _, u in ipairs(state.army) do alive_now[u.id] = true end
	for id, key in pairs(M.def_in) do                                         -- each entry on its own: the order of pairs() does not matter
		local dead = (M.exists ~= nil and M.exists[id] ~= true)
		local home = (not dead) and EliteAI.retreating ~= nil and EliteAI.retreating[id] ~= nil and now - EliteAI.retreating[id] <= 4
		if home and M.def_own ~= nil and M.def_own[id] ~= nil and now - M.def_own[id] <= 60 then home = false end   -- 0.8: sent home by Defence itself, not beaten
		M.def_cnt = M.def_cnt or {}
		if (dead or home) and now - (M.def_cnt[id] or -1000) >= 60 then        -- (once per squad: it is still inside while it runs home)
			M.def_cnt[id] = now
			local m = M.def_mem[key] or { lost = 0, t = now }
			m.lost, m.t = m.lost + 1, now
			M.def_mem[key] = m
			M.st.def_lost = (M.st.def_lost or 0) + 1
			mlog("Defence", key, dead and "lost a squad there:" or "a squad was beaten back there:", id, "count", m.lost, "it counts", fmt("x%.1f", 1 + prm("DefMemK") * m.lost), "for", prm("DefMemSecs"), "s")
		end
	end
	for key, m in pairs(M.def_mem) do if now - m.t > prm("DefMemSecs") then M.def_mem[key] = nil end end
	for id, t in pairs(M.def_cnt or {}) do if now - t > 120 then M.def_cnt[id] = nil end end
	local inside = {}
	for _, d in ipairs(defs) do
		for _, u in ipairs(state.army) do
			if inside[u.id] == nil and d2(u.pos.x, u.pos.z, d.x, d.z) <= d.r + prm("DefLossPad") then inside[u.id] = d.key end
		end
	end
	M.def_in = inside
	-- the army's destination this tick (the goal while it is fresh, else the director's target)
	local g = EliteAI.goal
	local dest = (g and g.x and now - (g.t or -1000) <= prm("GoalSecs")) and g or EliteAI.best_pos
	local blocks, hold_for = {}, nil
	local def_seen = {}                                                       -- 0.8: who is inside a zone it has to leave, this tick
	for _, d in ipairs(defs) do
		local near = (dest ~= nil and dest.x ~= nil and d2(dest.x, dest.z, d.x, d.z) <= d.r + 5) or (skeys[d.key] == true)
		if not near then
			for _, u in ipairs(state.active) do if d2(u.pos.x, u.pos.z, d.x, d.z) <= d.r + prm("DefNearPad") then near = true; break end end
		end
		local c = M.conf["BaseDef:" .. d.key]
		if near then
			-- the force that would go in: the army's squads near the turret - or the whole army when its target lies in the zone
			-- (an army that is still on its way is weighed before it arrives, not squad by squad as they come up)
			local ow, on_, tools, arts = 0, 0, 0, 0
			local whole = (dest ~= nil and dest.x ~= nil and d2(dest.x, dest.z, d.x, d.z) <= d.r + 5)
			for _, u in ipairs(state.active) do
				if not M.runner[u.id] and (whole or d2(u.pos.x, u.pos.z, d.x, d.z) <= prm("DefArmyR")) then
					ow, on_ = ow + weight_of(u), on_ + 1
					local t = X.tool(u)
					if t then tools = tools + 1 end
					if t == "art" then arts = arts + 1 end
				end
			end
			local tw, tn = 0, 0
			for _, q in ipairs(defs) do if d2(q.x, q.z, d.x, d.z) <= prm("DefClusterR") then tw, tn = tw + q.w, tn + q.n end end
			local mem = M.def_mem[d.key]
			local lost = mem and mem.lost or 0
			local sw = enemy_weight_near(en, d.x, d.z, prm("DefSupportR"))
			local ew = tw * (1 + prm("DefMemK") * lost) + sw
			local need = (tools > 0) and prm("DefToolRatio") or prm("DefRatio")
			if c and c.v == "assault" then need = need * prm("DefKeepK") end
			local v = (ew <= 0 or ow >= ew * need) and "assault" or "avoid"
			local why = fmt("ours %.0f (%d squads) theirs %.0f (turrets %d x %.0f, lost %d, squads %.0f) need %.2f tools %d", ow, on_, ew, tn, tw, lost, sw, need, tools)
			v = decide("BaseDef", d.key, v, why, now, prm("DefConfHold"))
			d.v = v
			if not M.def_said[d.key] or now - M.def_said[d.key] >= prm("DefLogSecs") then
				M.def_said[d.key] = now
				mlog("Defence", d.key, v, why)
			end
			if v == "avoid" then
				table.insert(blocks, { x = d.x, z = d.z, r = d.r, key = d.key })
				M.st.def_avoid = (M.st.def_avoid or 0) + 1
				if near and dest ~= nil and dest.x ~= nil and d2(dest.x, dest.z, d.x, d.z) <= d.r + 5 then hold_for = d end
				local n_stand = 0
				for _, u in ipairs(state.active) do
					if not taken[u.id] then
						local du = d2(u.pos.x, u.pos.z, d.x, d.z)
						local last = M.def_ord[u.id] or -1000
						local sg = nil                                                    -- 0.9: the squads that outrange it - one decision, from outside
						if sg_on and not d.virtual then sg = X.siege_tick(u, d, defs, now, h, state.active) end
						if sg == true then taken[u.id] = true; n_stand = n_stand + 1
						elseif sg == "skip" then
							if du <= prm("DefArtR") then n_stand = n_stand + 1 end       -- (it shells the turret next to this one)
						elseif du <= d.r then
							-- 0.8: out by the shortest way out of all the zones (X.def_exit), at once; a squad under fire that
							-- cannot walk out quickly retreats (a retreat is fast and cannot be suppressed; a vehicle has none)
							local ex, ez, L = X.def_exit(u.pos.x, u.pos.z, d, defs)
							local depth = L - prm("DefOutD")
							M.def_first, M.def_ret, M.def_own = M.def_first or {}, M.def_ret or {}, M.def_own or {}
							local first = M.def_first[u.id] or now
							M.def_first[u.id] = first
							def_seen[u.id] = true
							local why = nil
							local sup = api().sup and u.sq ~= nil and Squad_IsSuppressed(u.sq) == true
							if prm("DefRetreat") >= 1 and (u.hit or sup) and not u.veh then
								-- 11.11 (Orca fb 550: squads pressed retreat at every banshee scream / ranger volley near his base):
								-- suppressed alone is no reason - a suppressed squad walks out unless it is deep in the zone or hurt
								if sup and (depth > prm("DefWalkD") or u.hp < prm("DefRetreatHP")) then why = "suppressed"
								elseif depth > prm("DefWalkD") then why = "deep"
								elseif u.hp < prm("DefRetreatHP") then why = "hurt"
								elseif now - first >= prm("DefOutSecs") then why = "slow" end
							end
							if why then
								if now - (M.def_ret[u.id] or -1000) >= prm("DefReissue") then
									M.def_ret[u.id] = now
									morder(u.id, u.pos.x, u.pos.y, u.pos.z, ORD_RETREAT)
									if EliteAI.retreating then EliteAI.retreating[u.id] = now end
									if u.hp >= prm("DefBeatenHP") then M.def_own[u.id] = now end
									M.st.def_retreat = (M.st.def_retreat or 0) + 1
									mlog("Defence", d.key, "retreat", u.id, M.names[u.id] or "?", fmt("d %.0f hp %.2f", du, u.hp), fmt("the way out %.0f m", L), "why", why)
								end
							elseif now - last >= prm("DefReissue") then
								M.def_ord[u.id] = now
								morder(u.id, ex, u.pos.y, ez, ORD_MOVE)
								M.st.def_out = (M.st.def_out or 0) + 1
								mlog("Defence", d.key, "out", u.id, M.names[u.id] or "?", fmt("d %.0f hp %.2f", du, u.hp), fmt("to %.0f %.0f (%.0f m)", ex, ez, L))
							end
							taken[u.id] = true
						elseif not sg_on and not d.virtual and du <= prm("DefArtR") and X.tool(u) == "art" then   -- (Mech_Siege=0: as 0.8)
							if now - last >= prm("DefReissue") * 2 then
								M.def_ord[u.id] = now
								morder(u.id, d.x, d.y or 0, d.z, ORD_ATTACK_STRUCT)
								M.st.def_siege = (M.st.def_siege or 0) + 1
								mlog("Defence", d.key, "siege", u.id, M.names[u.id] or "?", fmt("d %.0f (the army stays out)", du))
							end
							taken[u.id] = true
						end
					end
				end
				-- 0.9: the army stays away and nothing of ours shells it from outside - other means are asked for (EliteAI.def_need)
				if n_stand == 0 and not d.virtual then need_n = need_n + 1; need_key = need_key or d.key end
			else
				M.st.def_assault = (M.st.def_assault or 0) + 1
				if not d.virtual then
					for _, u in ipairs(state.active) do
						local sg = nil
						if sg_on and not taken[u.id] then sg = X.siege_tick(u, d, defs, now, h, state.active) end
						if sg == true then taken[u.id] = true
						elseif sg == "skip" then
						elseif not taken[u.id] and d2(u.pos.x, u.pos.z, d.x, d.z) <= prm("DefArmyR") and X.tool(u) ~= nil and u.hp >= prm("VehBackHP") then
							if now - (M.def_ord[u.id] or -1000) >= prm("DefReissue") * 2 then
								M.def_ord[u.id] = now
								morder(u.id, d.x, d.y or 0, d.z, ORD_ATTACK_STRUCT)
								M.st.def_siege = (M.st.def_siege or 0) + 1
								mlog("Defence", d.key, "siege", u.id, M.names[u.id] or "?", "assault")
							end
							taken[u.id] = true
						end
					end
				end
			end
		else
			d.v = nil                                                           -- nobody is near: its zone is closed for the runners and the goals again
			if c and c.v == "avoid" and now - c.t < prm("DefConfHold") then
				table.insert(blocks, { x = d.x, z = d.z, r = d.r, key = d.key })   -- just left it: the zone stays closed for the hold time
			end
		end
	end
	-- 0.8: the mines / charges elite.scar told us about (EliteAI_ScarNote): their spots are closed like a turret's zone
	if M.danger then
		local keys = {}
		for key in pairs(M.danger) do table.insert(keys, key) end
		table.sort(keys)
		for _, key in ipairs(keys) do
			local g = M.danger[key]
			if now - g.t > prm("DangerSecs") then M.danger[key] = nil
			else table.insert(blocks, { x = g.x, z = g.z, r = g.r + prm("DangerPad"), key = "mine " .. key }) end
		end
	end
	EliteAI.def_block = blocks
	if need_n > 0 then
		local N = EliteAI.def_need
		if type(N) ~= "table" or now - (N.t or -1000) > prm("SiegeNeedSecs") then
			N = { t0 = now }
			mlog("Defence", need_key, "the army stays away and nothing of ours outranges it: other means are asked for (turrets", need_n, ")")
		end
		N.t, N.n, N.key = now, need_n, need_key
		EliteAI.def_need = N
	elseif type(EliteAI.def_need) == "table" and now - (EliteAI.def_need.t or -1000) > prm("SiegeNeedSecs") then
		EliteAI.def_need = nil
	end
	if M.def_first then for id in pairs(M.def_first) do if not def_seen[id] then M.def_first[id] = nil end end end   -- it is out: the clock starts anew
	for _, e in ipairs(en) do if X.blocked(e.x, e.z, 0) then e.nogo = true end end
	-- the army's destination lies under a turret it stays away from: another goal, or the hold spot outside the zone
	if hold_for ~= nil then
		local d = hold_for
		if g and (g.kind == "point" or g.kind == "enemy") and d2(g.x, g.z, d.x, d.z) <= d.r + 5 then clear_goal("under a turret " .. d.key) end
		local kind, key, x, y, z = next_goal(state, en, cx, cz)
		if kind then
			if EliteAI.best_key and EliteAI.best_pos and d2(EliteAI.best_pos.x, EliteAI.best_pos.z, d.x, d.z) <= d.r + 5 then M.stale = { key = EliteAI.best_key, t = now } end
			set_goal(kind, key, x, y, z, now, "instead of the target under the turret " .. d.key, kind == "point")
		else
			local bx, bz = (h and h.x or cx) - d.x, (h and h.z or cz) - d.z
			local bl = math.max(math.sqrt(bx * bx + bz * bz), 1)
			local k = (d.r + prm("DefHoldD")) / bl
			local hx, hy, hz, hwhy = d.x + bx * k, d.y or 0, d.z + bz * k, "the target is under a turret and there is no other goal"
			if prm("Map") >= 1 and prm("MapHoldOwn") >= 1 then
				-- 1.1 (Orca fb 550: "it pressed under the enemy's base and bled at the turrets"): the army does not wait at the edge
				-- of the zone, where every chase leads into it - it holds at our point nearest to that turret
				local bp, bd
				for _, p in ipairs(M.pts) do
					if p.ours and not X.blocked(p.x, p.z, prm("DefHoldD")) then
						local dp = d2(p.x, p.z, d.x, d.z)
						if not bp or dp < bd or (dp == bd and p.key < bp.key) then bp, bd = p, dp end
					end
				end
				if bp then hx, hy, hz, hwhy = bp.x, bp.y, bp.z, "the target is under a turret and there is no other goal: the army holds at our point " .. bp.key end
			end
			set_goal("def_hold", d.key, hx, hy, hz, now, hwhy)
		end
	else
		local gg = EliteAI.goal
		if gg and gg.kind == "def_hold" then
			local still = false
			for _, q in ipairs(blocks) do if q.key == gg.key then still = true end end
			if not still then clear_goal("the turret is not avoided any more") end
		end
	end
end

-- VEHICLES - "the Rhino drives ahead alone and dies". A vehicle is faster than the infantry and the director gives everybody
-- the same attack-move: it arrives first. And a vehicle has no retreat (the director's "go home below RetreatHP" is a retreat
-- order - a vehicle ignores it), so a damaged one stayed in the fire until it died. Two rules, per vehicle of the army:
--  * damaged (below VehBackHP 0.4) with an enemy within VehDangerR: a plain move to the spot VehBackD behind the infantry
--    (towards our HQ) - out of the fire, where the Repair mechanic finds it (it repairs out of a fight only); it stays out
--    until it is above VehBackDoneHP or the army has had no contact for VehBackSecs ("Vehicle <id> ... -> back");
--  * ahead: closer to the army's target than the nearest infantry squad by VehLeadD (20 m) with no infantry squad of ours
--    within VehAloneD (35 m) - it goes back to the nearest infantry squad and comes on with it ("... -> waits for the army").
-- An army of vehicles only has nobody to wait for. Mech_Vehicles=0 = off.
-- 1.0 (Orca fb 527 / 529: "the chimera drove ahead alone and did not carry the guard; the sentinels were given away on open
-- ground - a grenade, the devastators: the bot does not reckon what comes in"). Three more rules:
--  * the RATE: the health of every vehicle is remembered between ticks (numbers); one that loses VehRate of it a second and
--    would be dead within VehTtd at that rate pulls back at once ("-> back: loses 0.05 a second, 9 s to live") - 0.7 waited
--    for 0.4 and the chimera left at 0.16;
--  * a LIGHT vehicle (X.VEH_LIGHT: the transports and the sentinel) that is hit, below VehLightHP, with an anti-vehicle squad
--    of the enemy (X.is_av by its blueprint: tankbustas, brightlance, fire dragons ...; a carrier of an anti-vehicle upgrade;
--    a set-up team) within VehAvR pulls back ("-> back: light, hp 0.62, <enemy blueprint> 28 m away"). Pulled back early it
--    stays out until it has not been hit for VehCalm;
--  * a TRANSPORT is never the point: on the way and in a fight it keeps VehTransD behind the nearest infantry squad, on the
--    side of our HQ ("... transport -> behind the infantry"); the chimera is IG's reinforce point (ig_chimera_mobile_base) -
--    behind the line is where it works. Mech_VehTransport=0 = the "ahead and alone" rule of 0.7 only.
-- NOT done: loading the infantry and carrying it. The engine has Command_SquadSquadLoad and SCMD_Load / SCMD_Unload /
-- SCMD_UnloadSquads (the strings of DOW2.exe), but the game's SCAR library (command.scar) is not unpacked on this server and
-- the arguments of the call could not be read - a call with guessed arguments is the kind of engine error that left the Lua
-- mutex locked (HANDOFF, step 3). To be done after command.scar is read (TECH_RU.md 18.6).
X.VEH_LIGHT = { "ig_sentinel", "ig_chimera", "sm_rhino", "gk_rhino", "ork_wartrukk", "tau_devilfish" }
function X.enemy_av(e)                                                         -- is this enemy squad a threat to a vehicle (by what we know of it)
	if e.setup then return true end
	local k = M.ecls and M.ecls[e.id]
	local key = k and k.key or nil
	if key == nil then return false end
	for _, t in ipairs(DEF_TOOLS) do if t[2] == "av" and ends_with(key, t[1]) then return true end end
	for _, row in ipairs(X.AV_UPG) do if ends_with(key, row[2]) then return true end end
	return false
end
-- runners_only: the pass before the roles - a RUNNER that is a vehicle (the sentinel is IG's runner) is pulled out of the
-- fire by the same rules (it is "taken" then: the runner logic leaves it alone this tick); nothing else is done in that pass
function X.run_veh(state, en, cx, cz, h, taken, runners_only)
	local now = state.now
	M.veh = M.veh or {}
	local inf, vehs = {}, {}
	for _, u in ipairs(state.active) do
		weight_of(u)
		-- 1.0: the sentinel is no vehicle for the engine (SquadQuery_IsVehicle is false: Orca's log has it as the RUNNER, and
		-- pick_runners takes no vehicle) - so this pattern never looked at it. A squad of X.VEH_LIGHT is a vehicle here by its name
		if u.veh or has_key(M.names[u.id] or "", X.VEH_LIGHT) then table.insert(vehs, u) elseif not M.runner[u.id] then table.insert(inf, u) end
	end
	if table.getn(vehs) == 0 then return 0 end
	local icx, icz = centre(inf)
	local g = EliteAI.goal
	local dest = (g and g.x and now - (g.t or -1000) <= prm("GoalSecs")) and g or EliteAI.best_pos
	local contact = M.army_contact ~= nil and now - M.army_contact <= prm("VehBackSecs")
	local n = 0
	for _, u in ipairs(vehs) do
		local r = M.veh[u.id]
		if not r then r = { last = -1000 }; M.veh[u.id] = r end
		if not taken[u.id] and (not runners_only or M.runner[u.id]) then
			local danger = false
			for _, e in ipairs(en) do if d2(e.x, e.z, u.pos.x, u.pos.z) <= prm("VehDangerR") then danger = true; break end end
			-- 1.0: the rate of the damage (the health at the sample VehRateSecs ago; a repair makes it negative)
			if u.hit then r.hit_t = now end
			if r.s_t == nil or now - r.s_t > prm("VehRateSecs") * 3 then r.s_t, r.s_hp, r.rate = now, u.hp, 0
			elseif now - r.s_t >= prm("VehRateSecs") then r.rate = (r.s_hp - u.hp) / (now - r.s_t); r.s_t, r.s_hp = now, u.hp end
			local nm = M.names[u.id] or ""
			local light, why = false, nil
			for _, key in ipairs(X.VEH_LIGHT) do if ends_with(nm, key) then light = true; break end end
			if not r.back and (danger or u.hit) then
				if (r.rate or 0) >= prm("VehRate") and u.hp / r.rate <= prm("VehTtd") then
					why = fmt("loses %.2f a second, %.0f s to live", r.rate, u.hp / r.rate)
				elseif light and u.hit and u.hp < prm("VehLightHP") then
					local ae, ad
					for _, e in ipairs(en) do
						local d = d2(e.x, e.z, u.pos.x, u.pos.z)
						if d <= prm("VehAvR") and e.vis ~= false and X.enemy_av(e) and (not ad or d < ad or (d == ad and e.id < ae.id)) then ae, ad = e, d end
					end
					if ae then
						local k = M.ecls and M.ecls[ae.id]
						why = fmt("light, hp %.2f, %s %.0f m away", u.hp, (k and k.key and string.gsub(k.key, "^.*/", "")) or (ae.setup and "a set-up team") or "?", ad)
					end
				end
			end
			-- 0.9: "the army has no contact" ends it only when nothing threatens the vehicle itself (s20: a chimera at 0.05 was "back in
			-- the line" and "-> back" again in the same tick, seven times - an enemy within VehDangerR of it, none near the army's centre)
			local calm = (not r.early) or (now - (r.hit_t or -1000) >= prm("VehCalm"))   -- 1.0: pulled back early - not while it is still shot at
			if r.back and ((u.hp >= prm("VehBackDoneHP") and calm) or (not contact and not danger and not u.hit)) then
				mlog("Vehicle", u.id, M.names[u.id] or "?", fmt("hp %.2f", u.hp), "back in the line", fmt("after %.0f s", now - r.back))
				r.back, r.early = nil, nil
			end
			if not r.back and why ~= nil then
				r.back, r.early = now, true
				M.st.veh_back, M.st.veh_early = (M.st.veh_back or 0) + 1, (M.st.veh_early or 0) + 1
				mlog("Vehicle", u.id, M.names[u.id] or "?", fmt("hp %.2f", u.hp), "-> back:", why, icx and "- behind the infantry" or "- towards home")
			end
			if not r.back and u.hp < prm("VehBackHP") and (danger or u.hit) then
				r.back = now
				M.st.veh_back = (M.st.veh_back or 0) + 1
				mlog("Vehicle", u.id, M.names[u.id] or "?", fmt("hp %.2f", u.hp), "-> back", icx and "behind the infantry" or "towards home")
			end
			if r.back then
				-- the spot: behind the infantry's centre towards our HQ (no infantry: from where it stands towards the HQ)
				local fx, fz = icx or u.pos.x, icz or u.pos.z
				local tx, tz = fx, fz
				if h then
					local dx, dz = h.x - fx, h.z - fz
					local dl = math.sqrt(dx * dx + dz * dz)
					if dl > 1 then local k = math.min(prm("VehBackD"), dl) / dl; tx, tz = fx + dx * k, fz + dz * k end
				end
				if now - r.last >= prm("VehReissue") and d2(u.pos.x, u.pos.z, tx, tz) > 6 then r.last = now; morder(u.id, tx, u.pos.y, tz, ORD_MOVE) end
				taken[u.id] = true; n = n + 1
			elseif not runners_only and icx and dest ~= nil and dest.x ~= nil then
				local nf, nd                                                      -- the nearest infantry squad of ours
				for _, f in ipairs(inf) do
					local d = d2(f.pos.x, f.pos.z, u.pos.x, u.pos.z)
					if not nd or d < nd or (d == nd and f.id < nf.id) then nf, nd = f, d end
				end
				local lead = d2(nf.pos.x, nf.pos.z, dest.x, dest.z) - d2(u.pos.x, u.pos.z, dest.x, dest.z)
				local trans = prm("VehTransport") >= 1 and has_key(nm, TRANSPORTS)
				if trans and (lead > 0 or nd > prm("VehAloneD")) then
					-- 1.0: a transport nearer to the target than the infantry next to it (or far from all of it): the spot VehTransD
					-- behind that squad, on the side of our HQ (no HQ known: away from the target)
					local bx, bz = (h and h.x or (2 * nf.pos.x - dest.x)) - nf.pos.x, (h and h.z or (2 * nf.pos.z - dest.z)) - nf.pos.z
					local bl = math.sqrt(bx * bx + bz * bz)
					if bl < 1 then bx, bz, bl = 0, 0, 1 end
					local tx, tz = nf.pos.x + bx / bl * prm("VehTransD"), nf.pos.z + bz / bl * prm("VehTransD")
					if now - r.last >= prm("VehReissue") and d2(u.pos.x, u.pos.z, tx, tz) > 6 then
						r.last = now
						morder(u.id, tx, nf.pos.y, tz, ORD_MOVE)
						M.st.veh_trans = (M.st.veh_trans or 0) + 1
						if not r.said or now - r.said >= 20 then
							r.said = now
							mlog("Vehicle", u.id, nm, fmt("transport %.0f m ahead of the infantry, the nearest squad %.0f m away", lead, nd), "-> behind the infantry")
						end
					end
					taken[u.id] = true; n = n + 1
				elseif nd > prm("VehAloneD") and lead >= prm("VehLeadD") then
					if now - r.last >= prm("VehReissue") then
						r.last = now
						morder(u.id, nf.pos.x, nf.pos.y, nf.pos.z, ORD_MOVE)
						M.st.veh_wait = (M.st.veh_wait or 0) + 1
						if not r.said or now - r.said >= 20 then
							r.said = now
							mlog("Vehicle", u.id, M.names[u.id] or "?", fmt("%.0f m ahead of the infantry, the nearest squad %.0f m away", lead, nd), "-> waits for the army")
						end
					end
					taken[u.id] = true; n = n + 1
				end
			end
		end
	end
	return n
end

-- SETUP - "it does not knock set-up teams out with grenades / suppression / a flank, it walks into their arc". A heavy
-- weapon that is set up pins everything in front of it; it is weak to a grenade, a jump, a squad at its side (kb.yaml
-- threats.suppression_spam: grenade, jump, flank_melee - the team must pack up to turn). The enemy's set-up teams are
-- known by blueprint id (X.classes; SETUP_SBPS). For each one in contact, our squads within SetupR that are not ordered yet:
--  * a grenade squad (the grenade abilities of GAR_TOOLS) within SetupGrenR throws at it (GarGrenCd between throws);
--  * a jump squad jumps onto it (attack_or_jump);
--  * a melee squad comes from the side: while it stands inside the team's arc (SetupCone to either side of the line from
--    the team to our army's centre - where it shoots) and farther than SetupNearD, it walks to the flank spot (SetupFlankD
--    to the side of the team, the nearer side), then attacks;
--  * everybody else: FocusFire rates a set-up team FocusSetupW higher (and a support hero FocusSupportW) - the first target.
-- The count of set-up teams goes to the purchase scripts (EliteAI.setup = { n, t0, t }: strategy_unit_purchase.ai raises
-- the counter units of the race while the enemy fields SetupBuyMin of them). Lines "MECH Setup <eid> grenade|jump|flank|
-- attack <id> <sbps> ...". Mech_Setup=0 = off; without the blueprint ids (api line: "setup teams off") nothing is done.
-- 1.0 (TECH_RU.md 17.9: in the game "COUNTER data ... 62 of 62" and not one class in ~90 "seen" lines, while the set-up
-- teams of the same scan were recognised). 0.9 kept two tables - blueprint id -> "setup" / "support" (filled by ipairs over
-- a list, proven in the game) and blueprint id -> classes (filled by pairs over X.CN_UNITS, never hit in the game; the stub
-- with ids that were strings - and with numbers - finds every class, so the cause is not in this file's logic and is NOT
-- established). Now there is ONE way: X.bp_rows() = every blueprint we know, by its path ("race_x/troops/unit" -> { kind,
-- cls }), walked as a sorted list; M.bpn[blueprint id] = that path, written in the loop that the set-up teams are found by.
-- A squad is recognised once (X.squad_bp, by squad id; numbers and strings only are kept):
--   1. by NAME when we have it - Squad_GetBlueprintName in this state (looked up, Mech_CounterNameApi=0 = not called), or
--      the name elite.scar read in the SCAR state and told us (EliteAI_ScarNote kind 3; Mech_CounterScarNames=0 = not sent);
--   2. by blueprint ID (M.bpn) - what 0.7 does for the set-up teams.
-- Both are read when both are there; they must agree ("by name (id says ...)" in the log when not). The log says what was
-- really found: "COUNTER data ... | PBG_Get N of R named K distinct ids D readback B | <three ids>" (named = the blueprint
-- PBG_Get returned carries the name we asked for; distinct = different ids among them; readback = asked again, the same id),
-- "COUNTER bp squad <id> bid <n> name <path|-> class <...> by name|id|scar|none" once per enemy squad (the first CounterBpLog),
-- and "known K of N (name A id B scar C none D)" in every "seen" line.
function X.bp_key(nm)                                                          -- "sbps\pvp\race_x\troops\unit" -> "race_x/troops/unit"
	if type(nm) ~= "string" then return nil end
	local k = string.gsub(string.lower(nm), "\\", "/")
	k = string.gsub(k, "%.%a+$", "")                                           -- (a file extension, should the engine give one)
	local i = string.find(k, "race_", 1, true)                                -- every path of ours starts at the race folder
	if i then k = string.sub(k, i) end
	return k
end
function X.bp_rows()
	if M.rows ~= nil then return M.rows, M.row_keys end
	local rows, keys = {}, {}
	local function row(path) local r = rows[path]; if r == nil then r = {}; rows[path] = r; table.insert(keys, path) end; return r end
	for _, path in ipairs(SETUP_SBPS) do row(path).kind = "setup" end
	for _, path in ipairs(SUPPORT_SBPS) do row(path).kind = "support" end
	for path, cls in pairs(X.CN_UNITS) do row(path).cls = cls end               -- (each entry on its own: the order of pairs() does not matter)
	table.sort(keys)
	M.rows, M.row_keys = rows, keys
	return rows, keys
end
function X.classes()
	if M.bp ~= nil or M.bp_off then return M.bp end
	if not api().bpid then
		M.bp_off = true
		if mech_on("Counter") then X.clog("data", "no blueprint ids here (Squad_GetBlueprintID / PBG_Get / PBG_GetID): squads are known by name only") end
		return nil
	end
	local rows, keys = X.bp_rows()
	local bp, bpn, ns, nh, nc, nall = {}, {}, 0, 0, 0, 0
	local got, named, sample = 0, 0, {}
	for _, path in ipairs(keys) do
		local r = rows[path]
		if r.cls ~= nil then nall = nall + 1 end
		local pbg = PBG_Get("sbps/pvp/" .. path)                                -- strategy_unit_purchase.ai:26-50 (Elite's, the same form)
		if pbg ~= nil then
			local id = PBG_GetID(pbg)
			got = got + 1
			if X.bp_key(PBG_GetName(pbg)) == path then named = named + 1 end      -- (PBG_GetName of a PBG_Get: strategy_defence_purchase.ai:125)
			if id ~= nil then
				bpn[id] = path
				if r.kind ~= nil then bp[id] = r.kind end
				if r.kind == "setup" then ns = ns + 1 elseif r.kind == "support" then nh = nh + 1 end
				if r.cls ~= nil then nc = nc + 1 end
				if table.getn(sample) < 3 then table.insert(sample, path .. "=" .. tostring(id)) end
			end
		end
	end
	local distinct, back = 0, 0
	for _ in pairs(bpn) do distinct = distinct + 1 end                          -- (a count: the order of pairs() does not matter)
	for _, path in ipairs(keys) do                                            -- asked again: is the id of a path the same, and is it ours
		local pbg = PBG_Get("sbps/pvp/" .. path)
		if pbg ~= nil and bpn[PBG_GetID(pbg)] == path then back = back + 1 end
	end
	M.bp, M.bpn = bp, bpn
	mlog("Setup", "data", "set-up teams", ns, "of", table.getn(SETUP_SBPS), "support heroes", nh, "of", table.getn(SUPPORT_SBPS))
	if mech_on("Counter") then
		X.clog("data", "enemy blueprints with a class", nc, "of", nall, "| PBG_Get", got, "of", table.getn(keys), "named", named, "distinct ids", distinct,
			"readback", back, "|", table.concat(sample, " "))
	end
	return bp
end
-- what an enemy squad is: { kind = "setup" | "support" | nil, cls = "light mswarm" | nil, by = "name" | "id" | "scar" | "none",
-- key = its path or nil }, found once per squad id (a squad that was "none" is asked again when elite.scar has told its name).
-- Entry: the squad exists and has models (scan_enemies).
function X.squad_bp(sq, id)
	M.ecls = M.ecls or {}
	local k = M.ecls[id]
	local told = M.sname ~= nil and M.sname[id] or nil
	if k ~= nil and not (k.by == "none" and told ~= nil) then return k end
	local rows = X.bp_rows()
	local bid, idkey = nil, nil
	if M.bpn ~= nil then
		bid = Squad_GetBlueprintID(sq)
		if bid ~= nil then idkey = M.bpn[bid] end
	end
	-- the name first; a name that is in none of our tables while the id is (a name in a form we do not expect) leaves it to the id
	local nkey, by = nil, "none"
	if api().bpname then
		nkey = X.bp_key(Squad_GetBlueprintName(sq))
		if nkey ~= nil and nkey ~= "" then by = "name" else nkey = nil end
	end
	if nkey == nil and told ~= nil then nkey, by = told, "scar" end
	local key = nkey
	if idkey ~= nil and (key == nil or rows[key] == nil) then key, by = idkey, "id" end
	local r = key and rows[key] or nil
	k = { kind = r and r.kind or nil, cls = r and r.cls or nil, by = by, key = key }
	M.ecls[id] = k
	M.st.cn_bp = (M.st.cn_bp or 0) + 1
	local diff = (idkey ~= nil and nkey ~= nil and idkey ~= nkey) and ((by == "id") and ("(the name says " .. nkey .. ")") or ("(id says " .. idkey .. ")")) or ""
	if diff ~= "" then M.st.cn_bp_diff = (M.st.cn_bp_diff or 0) + 1 end
	if mech_on("Counter") and (M.st.cn_bp <= prm("CounterBpLog") or diff ~= "") and (M.st.cn_bp_said or 0) < prm("CounterBpLog") * 2 then
		M.st.cn_bp_said = (M.st.cn_bp_said or 0) + 1
		X.clog("bp", "squad", id, "bid", tostring(bid), "name", key or "-", "class", (k.cls or "-") .. (k.kind and (" " .. k.kind) or ""), "by", by, diff)
	end
	return k
end
-- 1.0 (Orca fb 529: "the devastators were never knocked down or suppressed; the grenades went at the scouts"): 0.7 threw only when
-- the grenade squad already stood within SetupGrenR of the team - a team that sits 40 m away never saw a grenade. Now the
-- squad that has a tool WALKS to its throw range (as the Garrison pattern's grenadiers do): from outside the team's arc
-- straight in, from inside the arc to the side first; one squad per team; the tool = the stun / slow / knock-back ability of
-- X.CONTROL with its real range and minimum range (stikkbommas 60 / 20, cultists 50 / 10, frag grenades 25 / 8 ...), else the
-- grenade / launch of GAR_TOOLS (SetupGrenR, minimum 8 m, the devils' launch 15 m). The team is this squad's cast target
-- before anything else: X.run_setup runs before X.run_control, a squad on its way is "taken". Mech_SetupApproach=0 = as 0.7.
X.SETUP_MIN = { [ABIL_GREN_IG_DEVILS] = 15 }                                   -- (minimum ranges, Elite's attributes; the rest 8)
-- 1.1 (Orca fb 538: "no ability was used to break the heavy weapon team's set-up - not the raveners', no bioplasma of the hive
-- tyrant; no dash"): the tools that are no grenades - { end of the sbps name, ability (ABIL), range, minimum range, "pos" = cast
-- at the team's spot / "squad" = cast on the team (order mode 200+k, as the repair is), the upgrade it needs (a part of its
-- name) or false }. Elite's attributes: the hive tyrant's bioplasma (range 40, wargear acc_hive_bioplasma), the lictor alpha's
-- flesh hook (range 36). A tool whose upgrade we have not bought (EliteAI_MechAddonBought) is no tool: the squad does not walk
-- up to cast what it does not have (the warriors' electroshock grub of X.CONTROL needs tyr_thorax_swarm - 1.0 walked them to
-- 20 m of the team without it). A jump squad is a tool as well: it walks to its jump range (JumpMax) - round the arc - and jumps.
X.SETUP_TOOLS = {
	{ "heroes/tyr_hive_tyrant", ABIL_TYR_BIOPLASMA, 38, 8, "pos", "acc_hive_bioplasma" },
	{ "heroes/tyr_hero_lictor", ABIL_TYR_FLESHHOOK, 34, 4, "squad", false },
}
function X.has_addon(key) return key == nil or key == false or (M.addons ~= nil and M.addons[key] == true) end
function X.setup_tool(nm, c)
	for _, row in ipairs(X.SETUP_TOOLS) do
		if ends_with(nm, row[1]) and X.has_addon(row[6]) and (row[5] ~= "squad" or prm("SetupSquadAbil") >= 1) then return row[2], row[3], row[4], row[5] end
	end
	for _, row in ipairs(X.CONTROL) do if ends_with(nm, row[1]) and X.has_addon(row[6]) then return row[2], row[3], row[4] end end
	if c.gar_abil then return c.gar_abil, prm("SetupGrenR"), X.SETUP_MIN[c.gar_abil] or 8 end
	if c.jump then return c.jump, prm("JumpMax"), prm("JumpMin"), "jump" end
	return nil
end
function X.run_setup(state, en, cx, cz, taken)
	local now = state.now
	-- the count for the purchase scripts (numbers only)
	local ns = 0
	for _, e in ipairs(en) do if e.setup then ns = ns + 1 end end
	local S = EliteAI.setup
	if ns >= prm("SetupBuyMin") then
		if type(S) ~= "table" then S = { t0 = now }; EliteAI.setup = S; mlog("Setup", "enemy fields", ns, "set-up teams: the purchase scripts are told") end
		S.n, S.t = ns, now
	elseif type(S) == "table" and now - (S.t or 0) > 30 then
		EliteAI.setup = nil
		mlog("Setup", "enemy set-up teams", ns, ": the purchase scripts are told no more")
	end
	if ns == 0 then return 0 end
	M.setup_ord = M.setup_ord or {}
	local n = 0
	local teams = {}
	local appr = prm("SetupApproach") >= 1
	-- 1.0: a team that we SEE counts too, not only one "in contact" (hit by us, or within SightR 30 m): devastators shoot from
	-- beyond that - the team that pinned Orca's army was never "in contact" and the pattern never looked at it. The grenade
	-- (throw and approach) and the jump are for every team in sight within SetupR; the melee flank stays for teams in contact
	for _, e in ipairs(en) do if e.setup and (e.contact or (appr and e.vis)) and not e.held and not e.nogo then table.insert(teams, e) end end
	table.sort(teams, function(a, b) if a.d ~= b.d then return a.d < b.d end return a.id < b.id end)
	for _, e in ipairs(teams) do
		-- where it shoots: from the team towards our army's centre
		local fx, fz = cx - e.x, cz - e.z
		local fl = math.sqrt(fx * fx + fz * fz)
		if fl < 1 then fx, fz, fl = 0, 1, 1 end
		fx, fz = fx / fl, fz / fl
		local gren_done, appr_done = false, false                                -- (1.1: one cast per team and tick, one squad on its way to it)
		for _, u in ipairs(state.active) do
			if not taken[u.id] and not M.runner[u.id] then
				local d = d2(u.pos.x, u.pos.z, e.x, e.z)
				local c = ucls(u)
				local last = M.setup_ord[u.id] or -1000
				if d <= prm("SetupR") then
					local ab, rng, rmin, amode = nil, 0, 0, nil
					if appr then ab, rng, rmin, amode = X.setup_tool(M.names[u.id] or "", c)
					elseif c.gar_abil then ab, rng, rmin = c.gar_abil, prm("SetupGrenR"), 0 end
					local cd_ok
					if amode == "jump" then cd_ok = (now - (M.jumped[u.id] or -1000) >= prm("JumpCd")) and u.hp >= prm("TieMinHP")   -- (1.1)
					else cd_ok = (now - (M.gren[u.id] or -1000) >= prm("GarGrenCd")) end
					local can = ab ~= nil and cd_ok
					if can and not gren_done and d <= rng and d >= rmin then
						gren_done = true
						if amode == "jump" then
							attack_or_jump(u, e, now)
							M.st.setup_jump = (M.st.setup_jump or 0) + 1
							mlog("Setup", e.id, "jump", u.id, M.names[u.id] or "?", fmt("d %.0f", d))
						else
							M.gren[u.id] = now
							if amode == "squad" then morder(u.id, e.id, 0, 0, ORD_ABILITY_SQUAD + ab)   -- 1.1: cast on the team itself
							else morder(u.id, e.x, e.y, e.z, ORD_ABILITY_POS + ab) end
							M.st.setup_gren = (M.st.setup_gren or 0) + 1
							mlog("Setup", e.id, amode and "cast" or "grenade", u.id, M.names[u.id] or "?", fmt("d %.0f ability %d", d, ab), amode or "")
						end
						taken[u.id] = true; n = n + 1
					elseif can and not appr_done and appr and d > rng and u.hp >= prm("TieMinHP") then
						appr_done = true                                                -- (one squad per team walks up)
						if now - last >= prm("SetupReissue") then
							M.setup_ord[u.id] = now
							local ux, uz = (u.pos.x - e.x) / math.max(d, 0.1), (u.pos.z - e.z) / math.max(d, 0.1)
							local in_arc = (ux * fx + uz * fz) >= math.cos(math.rad(prm("SetupCone")))
							local tr = math.max(rng - 4, rmin + 1)
							local px, pz = ux, uz                                       -- outside its arc: straight in, to the throw range
							if in_arc then                                              -- inside: the side of the firing line the squad is on
								local side = (fx * uz - fz * ux) >= 0 and 1 or -1
								px, pz = -fz * side, fx * side
							end
							morder(u.id, e.x + px * tr, u.pos.y, e.z + pz * tr, ORD_MOVE)
							M.st.setup_appr = (M.st.setup_appr or 0) + 1
							mlog("Setup", e.id, "approach", u.id, M.names[u.id] or "?", fmt("d %.0f -> %.0f m to cast ability %d%s", d, tr, ab, in_arc and " (round its arc)" or ""))
						end
						taken[u.id] = true; n = n + 1
					elseif c.jump and d >= prm("JumpMin") and d <= prm("JumpMax") and now - (M.jumped[u.id] or -1000) >= prm("JumpCd") and u.hp >= prm("TieMinHP") then
						attack_or_jump(u, e, now)
						M.st.setup_jump = (M.st.setup_jump or 0) + 1
						mlog("Setup", e.id, "jump", u.id, M.names[u.id] or "?", fmt("d %.0f", d))
						taken[u.id] = true; n = n + 1
					elseif c.melee and e.contact and u.hp >= prm("TieMinHP") then
						-- inside the arc? the angle between where it shoots and the line from the team to our squad
						local ux, uz = (u.pos.x - e.x) / math.max(d, 0.1), (u.pos.z - e.z) / math.max(d, 0.1)
						local cosa = ux * fx + uz * fz
						local in_arc = d > prm("SetupNearD") and cosa >= math.cos(math.rad(prm("SetupCone")))
						if now - last >= prm("SetupReissue") then
							M.setup_ord[u.id] = now
							if in_arc then
								-- the flank spot on the squad's side of the firing line
								local side = (fx * uz - fz * ux) >= 0 and 1 or -1
								local px, pz = -fz * side, fx * side                     -- the firing line turned 90 degrees to that side
								morder(u.id, e.x + px * prm("SetupFlankD"), u.pos.y, e.z + pz * prm("SetupFlankD"), ORD_MOVE)
								M.st.setup_flank = (M.st.setup_flank or 0) + 1
								mlog("Setup", e.id, "flank", u.id, M.names[u.id] or "?", fmt("d %.0f in its arc: to the side first", d))
							else
								morder(u.id, e.id, 0, 0, ORD_ATTACK_SQUAD)
								mlog("Setup", e.id, "attack", u.id, M.names[u.id] or "?", fmt("d %.0f from its side", d))
							end
						end
						taken[u.id] = true; n = n + 1
					end
				end
			end
		end
	end
	return n
end

--------------------------------------------------------------------------------------------------
-- 0.9 COUNTER - the answer to what the enemy fields (TECH_RU.md 17.4; the owner and the tester Orca, fb 513 / 515: "several lines
-- of behaviour, changed by the player's army: against masses of sluggas - shotguns and suppression; keep the warboss / the nobs
-- at a distance by abilities; set-up teams and support heroes are the first targets"). Three parts, one core for every race,
-- the races' data in the tables below (reports/tactics_kb/kb.yaml; what kb.yaml does not say is not made up - it is marked):
--  1. SEEN: the enemy squads we SEE (AIPlayer_CanSeeSquad - the game's own fog-of-war question, looked up, Mech_CounterSeeApi=0 =
--     not called; without it: what stands within CounterSightR of one of our squads or fights us) are classified by blueprint
--     id (X.CN_UNITS: kb.yaml units.*.armor_class / role) and remembered: M.cn.mem[id] = { last seen, classes, strength }. A
--     squad counts for CounterMemSecs after it was last seen; one that is no squad any more right after we saw it is forgotten
--     at once (we saw it die). Nothing is read about a squad we do not see. Line "COUNTER seen ...".
--  2. DEMAND: per class - n squads, its share of the remembered strength, our answers in the army - the arbiter
--     Conf_CounterVsPlan says "counter" or "plan" (answer now, or keep the purchase plan: both cost, the outcome is not clear):
--       1 (A) = the plan first: counter only what dominates (a share class at CounterDomShare of the strength, a count class
--               at twice its minimum);
--       2 (B) = by weight: counter a class that is present (X.CN_MIN: squads, share) for CounterBuySecs;
--       3 (C) = the counter first: from one squad short of the minimum on, at once.
--     Hysteresis CounterConfHold, every switch "MECH Conf_CounterVsPlan <class> plan->counter ...". The purchase scripts ask
--     EliteAI_MechCounterMult(<sbps>) for every buildable squad - an answer of X.CN_ANSWER to a class that is countered gets
--     x CounterMult while we have none, x CounterMultHave below CounterMaxHave of them (an answer, not an army of answers);
--     a class on "plan" gives its answer x CounterMultPlan while we have none - and EliteAI_MechCounterAddon(<upgrade>) for
--     the squad upgrades (X.CN_ADDON, by name: flamers and shotguns against light masses, plasma and power weapons against
--     heavy infantry, melta / lascannon / missiles against vehicles). Garrisons and set-up teams keep their own multipliers
--     (EliteAI.gar, EliteAI.setup: steps 19 and 22) - they are in the "seen" line, not counted twice. Line "COUNTER demand ...".
--     The tech plan asks EliteAI_MechCounterTech: against set-up teams with an answer of ours in the army the next tier
--     comes CounterTechSecs earlier (kb.yaml suppression_spam.general: tech_up_if_line_holds, never without an answer;
--     rules 2 and 3). Line "COUNTER tech ...".
--  3. FOCUS: set-up teams, support heroes (0.7) and detectors are the first focus targets ("COUNTER focus target <id> class
--     ..."); a dangerous melee squad (class mhero: warboss, nobs, force commander, seer council ...) that comes at us and has
--     none of ours next to it gets a stun / slow / knock-back ability thrown at where it will be in a second, by a squad
--     that has one (X.CONTROL; cast as the grenades are: ORD_ABILITY_POS through elite.scar, no new engine call) - "COUNTER
--     focus control <id> ... <- <squad> ability K".
-- Mech_Counter=0 = all of it off; Mech_CounterControl=0, Mech_CounterTech=0, Counter_Buy=0 (the purchase side) = the parts.
--
-- the enemy's squads by blueprint ("sbps/pvp/<this>") -> classes, generated from kb.yaml units (54 of its 71 units have an armour
-- class or a role that is a class): light = armor_class infantry (set-up teams aside), mswarm = light and a melee role, heavy =
-- heavy / super heavy infantry, vehicle = armor_class vehicle (and whatever the engine calls a vehicle), jump = a jump role,
-- invis = infiltrator, sniper, detector = a detector role, mhero = elite_melee / super_heavy_melee / melee_tank. NOT in kb.yaml
-- (no armour class there, so no light / heavy for them): dire avengers, warp spiders, dark reapers, wraithguard, autarch,
-- bloodletters, zoanthropes, carnifex, spore mines, tau drones, knarloc - they count in the total only.
X.CN_UNITS = {
	["race_eldar/troops/eld_guardian"] = "light", ["race_eldar/troops/eld_banshee"] = "light mswarm", ["race_eldar/troops/eld_ranger"] = "light sniper detector",
	["race_eldar/troops/eld_fire_dragon"] = "heavy", ["race_eldar/vehicles/eld_wraithlord"] = "vehicle", ["race_eldar/vehicles/eld_falcon"] = "vehicle",
	["race_eldar/troops/eld_seer_council"] = "mhero", ["race_eldar/vehicles/eld_fire_prism"] = "vehicle", ["race_marine/troops/sm_scout_marine"] = "light",
	["race_marine/troops/sm_tactical_marine"] = "heavy", ["race_marine/troops/sm_assault_marine"] = "heavy jump", ["race_marine/troops/sm_devastator"] = "heavy",
	["race_marine/troops/sm_devastator_plasma_cannon"] = "heavy", ["race_marine/vehicles/sm_dreadnought"] = "vehicle", ["race_marine/troops/sm_terminator"] = "heavy",
	["race_marine/troops/sm_terminator_assault"] = "heavy mhero", ["race_marine/vehicles/sm_whirlwind"] = "vehicle", ["race_chaos/troops/csm_cultist"] = "light mswarm",
	["race_chaos/troops/csm_tactical_marine"] = "heavy", ["race_chaos/troops/csm_havoc"] = "heavy", ["race_chaos/troops/csm_raptor"] = "heavy jump",
	["race_chaos/troops/csm_noise_marines"] = "heavy", ["race_chaos/troops/csm_plague_marines"] = "heavy", ["race_chaos/vehicles/csm_dreadnought"] = "vehicle",
	["race_chaos/troops/csm_terminator"] = "heavy", ["race_imperial_guard/troops/ig_guardsmen_squad"] = "light", ["race_imperial_guard/troops/ig_devils"] = "detector",
	["race_imperial_guard/troops/ig_spotter_squad"] = "light", ["race_imperial_guard/vehicles/ig_sentinel"] = "heavy", ["race_imperial_guard/troops/ig_ogryn_squad"] = "mhero",
	["race_imperial_guard/vehicles/ig_manticore"] = "vehicle", ["race_imperial_guard/vehicles/ig_leman_russ"] = "vehicle", ["race_ork/troops/ork_slugga"] = "light mswarm",
	["race_ork/troops/ork_shoota"] = "light", ["race_ork/troops/ork_stormboy"] = "light mswarm jump", ["race_ork/troops/ork_kommandos"] = "light invis",
	["race_ork/troops/ork_stikkbommas"] = "light", ["race_ork/troops/ork_nob_squad"] = "heavy mhero", ["race_ork/troops/ork_tankbustas"] = "light",
	["race_ork/vehicles/ork_deff_dread"] = "vehicle", ["race_tyranid/troops/tyr_termagaunt"] = "light", ["race_tyranid/troops/tyr_hormagaunt"] = "light mswarm",
	["race_tyranid/troops/tyr_ravener"] = "jump", ["race_tyranid/troops/tyr_warrior"] = "heavy", ["race_grey_knights/troops/gk_strike_squad"] = "heavy",
	["race_grey_knights/troops/gk_interceptor_squad"] = "heavy jump", ["race_grey_knights/troops/gk_purgation_squad"] = "heavy", ["race_grey_knights/troops/gk_operatives"] = "light",
	["race_grey_knights/troops/gk_vindicare_assassin"] = "sniper", ["race_tau/troops/tau_fire_warriors"] = "light", ["race_tau/troops/tau_pathfinders"] = "light",
	["race_tau/troops/tau_kroot_squad"] = "light mswarm", ["race_tau/troops/tau_vespid_squad"] = "jump", ["race_tau/vehicles/tau_devilfish"] = "vehicle",
	-- the melee heroes (NOT kb.yaml, which has no heroes: the director's own list MELEE_HEROES above, by their blueprints)
	["race_ork/heroes/ork_warboss"] = "mhero", ["race_marine/heroes/sm_force_commander"] = "mhero", ["race_marine/heroes/sm_force_commander_terminator"] = "mhero",
	["race_chaos/heroes/csm_chaos_lord"] = "mhero", ["race_ork/heroes/ork_hero_kommando"] = "mhero", ["race_tyranid/heroes/tyr_hero_lictor"] = "mhero",
	["race_tyranid/heroes/tyr_hero_ravener"] = "mhero", ["race_grey_knights/heroes/gk_brother_captain"] = "mhero",
}
-- our answers, by the end of the sbps name. Source per class:
--  light / mswarm - kb.yaml threats.melee_swarm (flamers, aoe, suppression_plus_knockback, walker_counter_initiate; tau: fire
--    warriors) and units.*.counters infantry / light_infantry / blobs / melee_blob / orks / ork_t1 / shoota / ranged_blob /
--    melee: the suppression teams, the area weapons, the walkers that counter melee. Orks: kb.yaml has no answer of theirs.
--  heavy - threats.heavy_infantry_mass and counters heavy_infantry (the rest is upgrades: plasma, power weapons - X.CN_ADDON).
--  vehicle - counters vehicle / vehicle_haywire; the venom-cannon warriors, zoanthropes, broadsides and wraithguard are the
--    armour-piercing squads of DEF_TOOLS (Elite's attributes), not kb.yaml. IG, chaos, GK: upgrades only (X.CN_ADDON).
--  mhero - kb.yaml: "kite, plasma, dispersed_knockback" - no unit; the plasma upgrades and X.CONTROL.
--  jump - threats.jump_infantry (IG: ig_devils) and counters jump / jump_infantry. Others: no data.
--  invis - the detectors of kb.yaml (roles sniper_detector, anti_setup_detector_flame). Others: no data.
--  sniper - threats.sniper_turtle: eldar rangers, "all: jump" (the jump squads of JUMPERS and kb.yaml).
--  turret - the squads that outrange turrets (SIEGE above; kb.yaml: the plasma devastators counter "turret").
X.CN_ANSWER = {
	light = { "sm_devastator", "ig_heavy_weapon_squad", "eld_guardian_shuriken_cannon", "csm_havoc", "ork_lootas", "gk_heavy_weapon_squad",
		"sm_whirlwind", "ig_manticore", "gk_purgation_squad", "tau_vespid_squad", "csm_noise_marines", "troops/tyr_warrior", "eld_dark_reaper",
		-- 1.1 (Orca fb 538, IG against the tyranids: "it took no anti-shooter - one or two tyrant guards against the shooting blob
		-- would have pushed it off its position, broken the generators and taken the map"; not kb.yaml - the tester's word)
		"tyr_tyrant_guard" },
	mswarm = { "sm_devastator", "ig_heavy_weapon_squad", "eld_guardian_shuriken_cannon", "csm_havoc", "ork_lootas", "gk_heavy_weapon_squad",
		"sm_whirlwind", "ig_devils", "gk_purgation_squad", "tau_vespid_squad", "csm_noise_marines", "sm_dreadnought", "eld_wraithlord", "tau_fire_warriors" },
	heavy = { "sm_devastator_plasma_cannon", "eld_fire_dragon", "eld_dark_reaper", "eld_wraithguard", "tyr_zoanthrope" },
	vehicle = { "eld_guardian_brightlance", "eld_fire_dragon", "eld_warp_spider", "ork_tankbustas", "sm_terminator_assault",
		"tyr_warrior_venom_cannon", "tyr_zoanthrope", "tau_broadside", "eld_wraithguard",
		-- 1.0 (Orca fb 529: "no storm troopers with the melta, no lascannon for the heavy weapon team"): the infantry that TAKES an
		-- anti-vehicle upgrade (X.AV_UPG, Elite's attributes) - without the carrier the upgrade cannot be bought at all
		"ig_stormtrooper_squad", "ig_kasrkin_squad", "ig_heavy_weapon_squad", "troops/sm_devastator", "troops/sm_tactical_marine", "csm_raptor",
		"gk_heavy_weapon_squad", "tau_crisis" },
	mhero = {},
	jump = { "ig_devils", "eld_banshee", "eld_wraithlord" },
	invis = { "eld_ranger", "ig_devils" },
	sniper = { "eld_ranger", "sm_assault_marine", "csm_raptor", "ork_stormboy", "troops/tyr_ravener", "gk_interceptor_squad", "tau_vespid_squad" },
	turret = { "ig_manticore", "sm_whirlwind", "sm_devastator_plasma_cannon", "eld_fire_prism", "eld_guardian_d_cannon", "eld_guardian_brightlance", "tyr_zoanthrope", "tau_broadside" },
}
-- squad upgrades by a part of their blueprint name (Elite's attributes, upgrade/pvp: ig_guardsmen_flamer, sm_flamer, sm_shotgun,
-- ork_burna, ig_guardsmen_plasma_gun, sm_plasma_gun, ig_kasrkin_melta_guns, sm_devastator_lascannon, sm_missile_launcher,
-- ig_sentinel_missile, eld_brightlance, tyr_venom_cannon_warrior ...). What the upgrade does is taken from its name.
X.CN_ADDON = {
	-- (1.1, Orca fb 538: "the warriors got no suppression upgrade against the infantry" - upgrade/pvp/race_tyranid/troops/
	-- tyr_barbed_strangler_warrior; kb.yaml tyr_warrior: "Barbed Strangler instant-suppress"; tyr_venom_warrior = the warriors' venom cannon)
	light = { "flamer", "shotgun", "burna", "barbed_strangler" }, mswarm = { "flamer", "shotgun", "burna", "barbed_strangler" },
	heavy = { "plasma", "power_fist", "power_sword", "power_claw", "power_axe" }, mhero = { "plasma" },
	vehicle = { "melta", "lascannon", "missile_launcher", "sentinel_missile", "rokkit", "brightlance", "venom_cannon", "venom_warrior", "haywire", "av_kit", "fusion", "railgun" },
}
-- 1.1 the upgrades that answer SET-UP teams (not a class of the count: EliteAI.setup, SetupBuyMin teams standing) - by a part of
-- the name. Orca fb 538: "no wargear on the hive tyrant - the bioplasma against the heavy weapon teams"; the warriors' barbed
-- strangler suppresses a team that has set up (kb.yaml suppression_spam.responses.tyranids: tyr_warrior_barbed_strangler)
X.SETUP_ADDON = { "acc_hive_bioplasma", "barbed_strangler_warrior" }
-- 1.0: the anti-vehicle squad upgrades and the squad that takes each - { a part of the upgrade's blueprint name, the end of the
-- carrier's sbps name }. Elite's attributes: the upgrade stands in the squad_upgrade list of that sbps (upgrade/pvp/<race>/troops,
-- sbps/pvp). Once we have bought one, the squads of its carrier shoot the vehicle first (X.is_av).
X.AV_UPG = {
	{ "ig_stormtrooper_squad_av_kit", "ig_stormtrooper_squad" }, { "ig_kasrkin_melta_guns", "ig_kasrkin_squad" }, { "ig_heavy_weapon_squad_lascannon", "ig_heavy_weapon_squad" },
	{ "ig_sentinel_missile", "ig_sentinel" }, { "sm_missile_launcher", "troops/sm_tactical_marine" }, { "sm_devastator_lascannon", "troops/sm_devastator" },
	{ "sm_multimelta_dreadnought", "vehicles/sm_dreadnought" }, { "sm_predator_lascannon", "sm_predator" }, { "csm_raptor_meltaguns", "csm_raptor" },
	{ "csm_predator_lascannon", "csm_predator" }, { "csm_dreadnought_missile_launcher", "csm_dreadnought" }, { "gk_heavy_weapon_squad_lascannon", "gk_heavy_weapon_squad" },
	{ "gk_dread_multimelta", "gk_dreadnought" }, { "gk_rhino_lascannon", "gk_rhino" }, { "eld_platform_brightlance", "eld_guardian_shuriken_cannon" },
	{ "eld_brightlance", "eld_wraithlord" }, { "eld_autarch_fusion_gun", "eld_autarch" }, { "tau_crisis_fusion_blaster", "tau_crisis" },
	{ "tau_crisis_missile_launcher", "tau_crisis" }, { "tau_stealth_suits_fusiongun", "tau_stealth_suits" }, { "tau_hammerhead_railgun", "tau_hammerhead" },
	{ "tyr_venom_cannon_carnifex", "tyr_carnifex" },
}
-- the squads whose own weapon is anti-vehicle (DEF_TOOLS "av": Elite's attributes; ork_tankbustas, the brightlance platform,
-- fire dragons, wraithguard, zoanthropes, venom-cannon warriors, broadsides; the plasma devastators are in that list for the
-- turrets) and the carriers of an upgrade of X.AV_UPG that we have bought in this match
function X.is_av(nm)
	if nm == nil or nm == "" then return false end
	for _, t in ipairs(DEF_TOOLS) do if t[2] == "av" and ends_with(nm, t[1]) then return true end end
	local b = M.av_bought
	if b ~= nil then for _, row in ipairs(X.AV_UPG) do if b[row[2]] and ends_with(nm, row[2]) then return true end end end
	return false
end
-- the purchase scripts: an upgrade was BOUGHT (e_addon_settle: its task is active / the count grew). Names only
function EliteAI_MechAddonBought(name)
	if type(name) ~= "string" then return end
	name = string.gsub(string.lower(name), "\\", "/")
	-- 1.1: the upgrades a tool of X.SETUP_TOOLS / X.CONTROL needs (strings)
	for _, tb in ipairs({ X.SETUP_TOOLS, X.CONTROL }) do
		for _, row in ipairs(tb) do
			local need = row[6]
			if need and string.find(name, need, 1, true) then
				M.addons = M.addons or {}
				if not M.addons[need] then
					M.addons[need] = true
					mlog("Setup", "upgrade", need, "bought: ability", row[2], "of", row[1], "is a tool now")
				end
			end
		end
	end
	for _, row in ipairs(X.AV_UPG) do
		if string.find(name, row[1], 1, true) then
			M.av_bought = M.av_bought or {}
			if not M.av_bought[row[2]] then
				M.av_bought[row[2]] = true
				X.clog("av", "upgrade", string.gsub(name, "^.*/", ""), "bought: the squads of", row[2], "shoot a vehicle first")
			end
		end
	end
end
-- a class is "present" from { this many squads, this share of the remembered strength } (kb.yaml threats.*.detect: melee_swarm >= 2
-- melee squads, heavy_infantry_mass share >= 0.5, sniper_turtle >= 2, jump_infantry >= 1, a vehicle / walker at all)
X.CN_MIN = { light = { 3, 0.3 }, mswarm = { 2, 0 }, heavy = { 2, 0.5 }, vehicle = { 1, 0 }, mhero = { 1, 0 }, jump = { 1, 0 }, invis = { 1, 0 }, sniper = { 2, 0 }, turret = { 1, 0 } }
X.CN_ORDER = { "light", "mswarm", "heavy", "vehicle", "mhero", "jump", "invis", "sniper", "turret" }
-- who keeps a dangerous melee squad off: { end of the sbps name, ability (ABIL, elite.scar), range, minimum range, what it does } -
-- position abilities of squads, Elite's attributes (ability/pvp): 21-25 are new in elite.scar (the stikkbommas' and the
-- kommandos' stun grenade 60 / 34 m, the pathfinders' photon grenade - a slow - 30 m, the GK operatives' stun bomb 32 m, the
-- warriors' electroshock grub 24 m - that one needs its upgrade), the rest are the grenades of 0.3 (a frag grenade knocks
-- infantry down; whether it does that to a commander is NOT checked). An ability whose upgrade is missing or that is on its
-- recharge is ignored by the engine. The first row that fits a squad is used.
X.CONTROL = {
	{ "ork_stikkbommas", 21, 60, 20, "stun" }, { "ork_kommandos", 22, 34, 0, "stun" }, { "tau_pathfinders", 23, 30, 8, "slow" }, { "gk_operatives", 24, 32, 0, "stun" },
	{ "troops/tyr_warrior", 25, 24, 0, "stun", "thorax_swarm" }, { "sm_scout_marine", ABIL_GREN_SM, 25, 8, "knockback" }, { "ig_kasrkin_squad", ABIL_GREN_IG_KASRKIN, 25, 8, "knockback" },
	{ "eld_guardian", ABIL_GREN_ELD, 25, 8, "knockback" }, { "csm_cultist", ABIL_GREN_CSM, 50, 10, "knockback" },
}
function X.clog(...) if EliteAI.log then EliteAI.log("COUNTER", ...) end end
-- 1.1 (the polygon's scene k, r15: "COUNTER demand ig_heavy_weapon_squad x1.2999999523163 class vehicle" - the ini numbers are
-- single floats; the scene waited for "x1.3"): a multiplier is written as "2" or "1.3"
function X.mul(m) if m == math.floor(m) then return fmt("%d", m) end return fmt("%.1f", m) end
function X.has_cls(e, c) return e.cls ~= nil and string.find(" " .. e.cls .. " ", " " .. c .. " ", 1, true) ~= nil end
function X.counter_tick(state, en, now)
	local C = M.cn
	if C == nil then C = { mem = {}, st = {}, dsaid = {}, said = -1000, key = "" }; M.cn = C end
	-- 1) what we see now
	local live, nvis = {}, 0
	for _, e in ipairs(en) do
		live[e.id] = true
		if e.vis then
			nvis = nvis + 1
			local cls = e.cls or ""
			if e.veh and not X.has_cls(e, "vehicle") then cls = (cls == "") and "vehicle" or (cls .. " vehicle") end   -- (what the engine calls a vehicle)
			C.mem[e.id] = { t = now, cls = cls, w = e.w, setup = e.setup, held = e.held, support = e.support, by = e.by or "none" }
		end
	end
	-- 2) the memory: forgotten when we saw it die (in sight at the last tick, no squad any more) or CounterMemSecs after it was last seen
	local ids = {}
	for id in pairs(C.mem) do table.insert(ids, id) end
	table.sort(ids)
	local agg, total, nmem = { setup = { n = 0, w = 0 }, garrison = { n = 0, w = 0 }, support = { n = 0, w = 0 } }, 0, 0
	local byn = { name = 0, id = 0, scar = 0, none = 0 }
	for _, k in ipairs(X.CN_ORDER) do agg[k] = { n = 0, w = 0 } end
	local mem_s, prev = prm("CounterMemSecs"), C.prev or now
	C.dt, C.prev = now - prev, now
	for _, id in ipairs(ids) do
		local m = C.mem[id]
		if (not live[id] and m.t >= prev) or now - m.t > mem_s then
			C.mem[id] = nil
		else
			nmem, total = nmem + 1, total + m.w
			byn[m.by] = (byn[m.by] or 0) + 1
			-- 11.11: no string.gmatch and no %S here - in the game's AI Lua the pattern "%S+" finds nothing (classes never
			-- reached `seen`, 18.12; checked in the game: "([^ ]+)" with string.find works)
			local pos, cls = 1, m.cls or ""
			while true do
				local s1, e1, word = string.find(cls, "([^ ]+)", pos)
				if not s1 then break end
				local a = agg[word]
				if a then a.n, a.w = a.n + 1, a.w + m.w end
				pos = e1 + 1
			end
			if m.setup then agg.setup.n = agg.setup.n + 1 end
			if m.held then agg.garrison.n = agg.garrison.n + 1 end
			if m.support then agg.support.n = agg.support.n + 1 end
		end
	end
	local N = EliteAI.def_need                                                -- the turrets nothing of ours outranges (Defence)
	if type(N) == "table" and now - (N.t or -1000) <= prm("SiegeNeedSecs") then agg.turret.n = N.n or 1 end
	-- 3) our answers in the army, per class; the tools against set-up teams (jump, grenades: the Setup pattern's)
	local have, sh = {}, 0
	for _, k in ipairs(X.CN_ORDER) do have[k] = 0 end
	for _, u in ipairs(state.army) do
		local nm = M.names[u.id] or ""
		for _, k in ipairs(X.CN_ORDER) do
			for _, key in ipairs(X.CN_ANSWER[k]) do if ends_with(nm, key) then have[k] = have[k] + 1; break end end
		end
		local c = cls_of(nm)
		if c.jump or c.gar_abil then sh = sh + 1 end
	end
	C.setup_have = sh
	-- 4) the arbiter, per class
	local r = rule("CounterVsPlan")
	local out, parts, key = {}, {}, ""
	for _, k in ipairs(X.CN_ORDER) do
		local a, mn = agg[k], X.CN_MIN[k]
		local share = (total > 0 and k ~= "turret") and (a.w / total) or 0
		if a.n > 0 then
			local st = C.st[k]
			if st == nil then st = { t0 = now }; C.st[k] = st end
			local present = a.n >= mn[1] and share >= mn[2]
			local want = "plan"
			if r == 1 then
				if present and ((mn[2] > 0 and share >= prm("CounterDomShare")) or (mn[2] == 0 and a.n >= mn[1] * 2)) then want = "counter" end
			elseif r == 2 then
				if present and now - st.t0 >= prm("CounterBuySecs") then want = "counter" end
			elseif a.n >= math.max(1, mn[1] - 1) and share >= mn[2] * 0.5 then want = "counter" end
			-- the decision holds CounterConfHold (the first "plan" of a class may be left at any time: it is no decision yet)
			local hold = prm("CounterConfHold")
			if st.v == nil then
				st.v, st.vt = want, (want == "counter") and now or (now - hold)
				if want == "counter" then mlog("Conf_CounterVsPlan", k, "->counter", fmt("n %d share %.2f have %d rule %d", a.n, share, have[k], r)) end
			elseif st.v ~= want and now - st.vt >= hold then
				mlog("Conf_CounterVsPlan", k, st.v .. "->" .. want, fmt("n %d share %.2f have %d rule %d", a.n, share, have[k], r))
				st.v, st.vt = want, now
				M.st.conf = M.st.conf + 1
			end
			local v = st.v
			out[k] = { n = a.n, share = share, v = v, have = have[k] }
			table.insert(parts, fmt("%s %d %.2f %s have %d", k, a.n, share, v, have[k]))
			key = key .. k .. a.n .. v
		else
			C.st[k] = nil                                                       -- (the class is gone: the next sighting is decided anew)
		end
	end
	EliteAI.counter = { t = now, cls = out, rule = r, n = nmem, total = total }
	M.st.cn_mem = nmem
	key = key .. "|" .. agg.setup.n .. "|" .. agg.garrison.n .. "|" .. agg.support.n .. "|" .. byn.none
	M.st.cn_known, M.st.cn_none = nmem - byn.none, byn.none
	if nmem > 0 and ((key ~= C.key and now - C.said >= 6) or now - C.said >= prm("CounterLogSecs")) then
		C.key, C.said = key, now
		X.clog("seen", "t", math.floor(now), "squads", nmem, "visible", nvis, "weight", math.floor(total), "|", table.concat(parts, " | "),
			"| setup", agg.setup.n, "garrison", agg.garrison.n, "support", agg.support.n, "| rule", r, "see", api().see and "api" or "range",
			"| known", nmem - byn.none, "of", nmem, fmt("(name %d id %d scar %d none %d)", byn.name, byn.id, byn.scar, byn.none))
	end
end
-- the purchase scripts: the multiplier of a buildable squad's demand (strategy_unit_purchase.ai EliteAI_PurchaseMult). Numbers only
function EliteAI_MechCounterMult(name, cur)
	local C = EliteAI.counter
	if not EliteAI.on or not mech_on("Counter") or type(C) ~= "table" or type(name) ~= "string" or M.cn == nil then return 1 end
	local now = World_GetGameTime()                                           -- (a count that is 30 s old is not used: the director does not run)
	if now - (C.t or -1000) > 30 then return 1 end
	name = string.gsub(string.lower(name), "\\", "/")
	local best, bk = 1, nil
	for _, k in ipairs(X.CN_ORDER) do
		local c = C.cls[k]
		if c ~= nil then
			for _, key in ipairs(X.CN_ANSWER[k]) do
				if ends_with(name, key) then
					local m = 1
					if c.v == "counter" then
						if c.have == 0 then m = prm("CounterMult") elseif c.have < prm("CounterMaxHave") then m = prm("CounterMultHave") end
					elseif c.have == 0 then m = prm("CounterMultPlan") end
					if m > best then best, bk = m, k end
					break
				end
			end
		end
	end
	if bk ~= nil then
		M.st.cn_demand = (M.st.cn_demand or 0) + 1
		local c = C.cls[bk]
		local sk = name .. "|" .. tostring(c.v) .. "|" .. tostring(best)
		if now - (M.cn.dsaid[sk] or -1000) >= prm("CounterLogSecs") then
			M.cn.dsaid[sk] = now
			X.clog("demand", string.gsub(name, "^.*/", ""), "x" .. X.mul(best), "class", bk, "n", c.n, fmt("share %.2f", c.share), "have", c.have, "decision", c.v, "rule", C.rule, "of this", cur or 0)
		end
	end
	return best
end
-- ... and of a squad upgrade (the addon filter): by a part of its name, only for a class that is countered
function EliteAI_MechCounterAddon(name)
	local C = EliteAI.counter
	if not EliteAI.on or not mech_on("Counter") or type(C) ~= "table" or type(name) ~= "string" or M.cn == nil then return 1 end
	local now = World_GetGameTime()                                           -- (a count that is 30 s old is not used: the director does not run)
	if now - (C.t or -1000) > 30 then return 1 end
	name = string.gsub(string.lower(name), "\\", "/")
	local S = EliteAI.setup                                                   -- 1.1: SetupBuyMin set-up teams stand - their answers go as a countered class
	if type(S) == "table" and now - (S.t or -1000) <= 30 and has_key(name, X.SETUP_ADDON) then
		local m = prm("CounterAddonMult")
		M.st.cn_demand = (M.st.cn_demand or 0) + 1
		if now - (M.cn.dsaid["s|" .. name] or -1000) >= prm("CounterLogSecs") then
			M.cn.dsaid["s|" .. name] = now
			X.clog("demand", "addon", string.gsub(name, "^.*/", ""), "x" .. X.mul(m), "class", "setup", "n", S.n or 0, "rule", C.rule)
		end
		return m, "setup"
	end
	for _, k in ipairs(X.CN_ORDER) do
		local c, keys = C.cls[k], X.CN_ADDON[k]
		if c ~= nil and c.v == "counter" and keys ~= nil and has_key(name, keys) then
			local m = prm("CounterAddonMult")
			M.st.cn_demand = (M.st.cn_demand or 0) + 1
			if now - (M.cn.dsaid["a|" .. name] or -1000) >= prm("CounterLogSecs") then
				M.cn.dsaid["a|" .. name] = now
				X.clog("demand", "addon", string.gsub(name, "^.*/", ""), "x" .. X.mul(m), "class", k, "n", c.n, fmt("share %.2f", c.share), "rule", C.rule)
			end
			return m, k
		end
	end
	return 1
end
-- the tech plan (strategy_tech_purchase.ai): how many seconds earlier the next tier is wanted. The enemy holds a line of set-up
-- teams (EliteAI.setup: SetupBuyMin of them) and we have a tool against them: out-teching the line is the answer of kb.yaml
-- (suppression_spam.general tech_up_if_line_holds; "never a fast tech without an answer to the set-up teams")
function EliteAI_MechCounterTech(k)
	if not EliteAI.on or not mech_on("Counter") or prm("CounterTech") < 1 or M.cn == nil then return 0 end
	local S, now = EliteAI.setup, World_GetGameTime()
	if type(S) ~= "table" or now - (S.t or -1000) > 30 then return 0 end
	local r = rule("CounterVsPlan")
	if r == 1 or (M.cn.setup_have or 0) < 1 then return 0 end
	local s = prm("CounterTechSecs")
	if now - (M.cn.tsaid or -1000) >= 60 then
		M.cn.tsaid = now
		X.clog("tech", "T" .. tostring((k or 1) + 1), s, "s earlier: enemy set-up teams", S.n or 0, "our tools against them", M.cn.setup_have, "rule", r)
	end
	return s
end
-- a dangerous melee squad that comes at us: an ability that stuns / slows / knocks back, thrown at where it will be in CtrlLead s
function X.run_control(state, en, cx, cz, taken)
	if prm("CounterControl") < 1 then return 0 end
	local now, n = state.now, 0
	local tg = {}
	for _, e in ipairs(en) do
		if e.contact and e.vis and not e.held and not e.nogo and e.hp > 0.15 and X.has_cls(e, "mhero") then table.insert(tg, e) end
	end
	if table.getn(tg) == 0 then return 0 end
	table.sort(tg, function(a, b) if a.d ~= b.d then return a.d < b.d end return a.id < b.id end)
	M.ctrl = M.ctrl or {}
	for _, e in ipairs(tg) do
		-- not with one of ours next to it (the blast hits both; that fight is MeleeTie's), one throw per target per CtrlTargetCd
		local friend = false
		for _, u in ipairs(state.army) do if d2(u.pos.x, u.pos.z, e.x, e.z) <= prm("CtrlFriendR") then friend = true; break end end
		if not friend and now - (M.ctrl[e.id] or -1000) >= prm("CtrlTargetCd") then
			local best, bd, brow
			for _, u in ipairs(state.active) do
				if not taken[u.id] and not M.runner[u.id] and now - (M.gren[u.id] or -1000) >= prm("GarGrenCd") then
					local nm = M.names[u.id] or ""
					for _, row in ipairs(X.CONTROL) do
						if ends_with(nm, row[1]) and X.has_addon(row[6]) then
							local d = d2(u.pos.x, u.pos.z, e.x, e.z)
							if d >= row[4] + 1 and d <= row[3] - 1 and (bd == nil or d < bd or (d == bd and u.id < best.id)) then best, bd, brow = u, d, row end
							break
						end
					end
				end
			end
			if best ~= nil then
				local tx, tz = e.x, e.z
				local dt = M.cn and M.cn.dt or 0
				if e.px ~= nil and dt > 0 and dt <= 10 then                        -- where it will be: its way since the last tick, CtrlLead s on (6 m at most)
					local k = prm("CtrlLead") / dt
					local lx, lz = (e.x - e.px) * k, (e.z - e.pz) * k
					local ll = math.sqrt(lx * lx + lz * lz)
					if ll > 6 then lx, lz = lx * 6 / ll, lz * 6 / ll end
					tx, tz = tx + lx, tz + lz
				end
				M.gren[best.id], M.ctrl[e.id] = now, now
				morder(best.id, tx, e.y, tz, ORD_ABILITY_POS + brow[2])
				taken[best.id] = true; n = n + 1
				M.st.cn_ctrl = (M.st.cn_ctrl or 0) + 1
				X.clog("focus", "control", e.id, "class mhero", "<-", best.id, M.names[best.id] or "?", "ability", brow[2], brow[5], fmt("d %.0f hp %.2f at %.0f %.0f", bd, e.hp, tx, tz))
			end
		end
	end
	for id, t in pairs(M.ctrl) do if now - t > 120 then M.ctrl[id] = nil end end   -- (each entry on its own)
	return n
end

--------------------------------------------------------------------------------------------------
-- 0.8 DODGE (TECH_RU.md 16.1). The reflex itself is elite.scar's (the SCAR side sees a grenade in flight, this state does
-- not; four times a second there, 3 s here). This side gives the policy and is told:
--  * the policy, pseudo-order mode 10 (id = our player id): on / off (Mech_Dodge), and what a squad that does something it
--    would have to drop sits through - where stepping out and staying both cost and the outcome is not clear the arbiter
--    decides, Conf_DodgeBusy (A / B / C = 1 / 2 / 3; threats are 1 weak, 2 medium, 3 heavy):
--      1 - a capturing squad sits through a weak one, a melee squad through a medium one (only a heavy one breaks a melee);
--      2 - both sit through a weak one only (a melee is left for a medium one too);
--      3 - both sit through a medium one (the capture and the melee come first, a heavy one aside).
--    A weak grenade never takes a squad off a point (all three). Mech_DodgeHoldCap / Mech_DodgeHoldMelee = 0..3 set them by hand.
--  * elite.scar tells through the game's AI_DoString (when it is there): EliteAI_ScarNote below, registered in
--    string.eliteai_in[player id] (the string table is what the DLL's functions reach this state through). Numbers only,
--    no engine call inside. 1 = a squad steps out of a blast (the order book starts its series anew - it was moved by
--    somebody else), 2 = a mine / a charge is seen (M.danger: Defence closes the spot, DangerSecs).
function EliteAI_ScarNote(kind, id, x, z, r, pow, dur)
	if type(kind) ~= "number" or type(id) ~= "number" then return end
	if kind == 3 then                                                         -- 1.0: "squad <id> is the blueprint <name>" (a string; kept by squad id)
		if type(x) == "string" then
			M.sname = M.sname or {}
			if M.sname[id] == nil then M.sname_n = (M.sname_n or 0) + 1 end
			M.sname[id] = X.bp_key(x)
		end
		return
	end
	local now = M.now or 0
	M.st.dodge_notes = (M.st.dodge_notes or 0) + 1
	x, z, r, pow, dur = tonumber(x) or 0, tonumber(z) or 0, tonumber(r) or 0, tonumber(pow) or 0, tonumber(dur) or 0
	if kind == 1 then
		M.dodge = M.dodge or {}
		M.dodge[id] = { t = now, dur = dur }
		M.st.dodge = (M.st.dodge or 0) + 1
		if type(EliteAI.ord) == "table" then EliteAI.ord[id] = nil end
		if M.st.dodge <= 10 then mlog("Dodge", "note", id, "steps out of a blast", fmt("at %.0f %.0f r %.0f pow %.0f for %.1f s", x, z, r, pow, dur)) end
	elseif kind == 2 then
		M.danger = M.danger or {}
		local key = fmt("%.0f/%.0f", x, z)
		if M.danger[key] == nil then
			M.st.dodge_mines = (M.st.dodge_mines or 0) + 1
			mlog("Dodge", "note", "a mine at", key, fmt("r %.0f pow %.0f", r, pow), "- its spot is closed for", prm("DangerSecs"), "s")
		end
		M.danger[key] = { x = x, z = z, r = r, t = now }
	end
end
function X.dodge_cfg(now, on)
	if not _morder or s_selfplayerid == nil then return end
	if not M.said.note then                                                   -- where elite.scar finds us
		M.said.note = true
		if type(string) == "table" then
			local t = string.eliteai_in
			if type(t) ~= "table" then t = {}; string.eliteai_in = t end
			t[s_selfplayerid] = EliteAI_ScarNote
		end
	end
	local r = rule("DodgeBusy")
	local hc, hm = (r == 3) and 2 or 1, (r == 2) and 1 or 2
	local v = EliteAI.num("Mech_DodgeHoldCap", -1)
	if v >= 0 then hc = math.floor(v) end
	v = EliteAI.num("Mech_DodgeHoldMelee", -1)
	if v >= 0 then hm = math.floor(v) end
	local key = (on and 100 or 0) + hc * 10 + hm
	if M.dodge_key == key and now - (M.dodge_t or -1000) < prm("DodgeCfgSecs") then return end
	if M.dodge_key ~= key then
		mlog("Dodge", on and "on" or "off", "rule", r, "a capturing squad sits through", hc, "a melee squad through", hm, "(1 weak 2 medium 3 heavy) -> elite.scar, mode 10")
	end
	M.dodge_key, M.dodge_t = key, now
	_morder(s_selfplayerid, on and 1 or 0, hc, hm, 10)
end

--------------------------------------------------------------------------------------------------
-- 1.1 MAP (TECH_RU.md 19; the tester Orca, fb 544 / 550: "it lost its generators and instead of taking them back it pressed under
-- the enemy's base and bled at the turrets; it captures a point with the whole army; no map control"). Nothing looked at our
-- own points: the director's target is Elite's best attack target (the enemy's base as a rule), a squad that is shot calls
-- the army, a point or a generator farm that is attacked calls nobody. Now, every tick, before the goal's life:
--  * DEFEND: a point of ours - or one lost within MapLostSecs - on our side of the map (MapHomeR of our HQ, or not on the enemy
--    half) with an enemy squad within MapThreatR, or being captured by the enemy, is the army's goal ("Goal defend <key> ...")
--    before any other: power points (the generators stand around them) first, then victory points, then the rest, the nearest
--    to our base first; only against a force the army can face (ours >= theirs x MapDefRatio) - else "Map defend <key> left".
--    The goal lives MapDefSecs after the last threat; a point that was lost and is free then is taken back at once (goal "point").
--    The arbiter Conf_MapDefend (A / B / C - what to give up is not clear): 1 = every such point calls the army; 2 = a requisition
--    point farther than MapFarD from the army is left to the runners (the army keeps its goal - a trade); 3 = as 2, and while
--    the army storms a turret zone (Conf_BaseDef "assault" next to it) only the generators call it back.
--  * a lost point of ours on our side is the first of the points for the army's next goal and for the runners (X.map_lost).
--  * the capture is one or two squads' work (goal_tick above), the army goes on or covers.
-- The Garrison pattern's goals are not touched (an enemy in a building at our point is its case). Mech_Map=0 = as 1.0.
-- 1.3 (TECH_RU.md 21.5; Malum fb 623: "bad map control" - 2-4 points for 26 minutes): A FREE POINT ON THE WAY. The army took points
-- only as goals (when it stood at its target with nothing to do) and by its one or two runners. Now a point that is not ours,
-- has no enemy at it (RunnerPointR), is not under a turret and lies within MapWayR of the army's centre while it is out of
-- contact is captured by ONE squad of the army (the same roll as the goal's capturing squads: MapCappers at a time, its life
-- is goal_tick's), the army goes on. Mech_MapWay=0 = off. Line "MECH Goal capture <id> ... point K on the way".
function X.way_capture(state, en, cx, cz, taken)
	if prm("MapWay") < 1 or prm("Map") < 1 then return end
	local now = state.now
	if M.army_contact ~= nil and now - M.army_contact <= prm("MapBusySecs") then return end
	M.cappers = M.cappers or {}
	local n_army = 0
	for _, u in ipairs(state.active) do if not M.runner[u.id] and not X.is_raider(u.id) then n_army = n_army + 1 end end
	if n_army < prm("MapWayArmy") then return end
	if table.getn(M.cappers) >= math.min(prm("MapCappers"), math.max(1, math.floor(n_army / 3))) then return end
	local best, bd
	for _, p in ipairs(M.pts) do
		if not p.ours and not p.us_cap and not X.capper_at(p.key) and not point_done(p, en, now)
			and not (M.bad_pt[p.key] and now - M.bad_pt[p.key] < 60) and not X.under_turret(p.x, p.z) then
			local d = d2(cx, cz, p.x, p.z)
			if d <= prm("MapWayR") then
				local _, n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))
				if n == 0 and (not best or d < bd or (d == bd and p.key < best.key)) then best, bd = p, d end
			end
		end
	end
	if not best then return end
	local sq, sd
	for _, u in ipairs(state.active) do
		if not taken[u.id] and not M.runner[u.id] and not X.capper_of(u.id) and not X.is_raider(u.id) and can_cap(u.id) and not u.veh
			and not (M.norole[u.id] and now - M.norole[u.id] < prm("IdleRoleBan")) then
			local du = d2(u.pos.x, u.pos.z, best.x, best.z)
			if not sq or du < sd or (du == sd and u.id < sq.id) then sq, sd = u, du end
		end
	end
	if not sq then M.bad_pt[best.key] = now; return end
	table.insert(M.cappers, { id = sq.id, key = best.key, t0 = now, last = now })
	morder(sq.id, best.x, best.y, best.z, ORD_CAPTURE)
	taken[sq.id] = true
	M.st.capper, M.st.way_cap = (M.st.capper or 0) + 1, (M.st.way_cap or 0) + 1
	mlog("Goal", "capture", sq.id, M.names[sq.id] or "?", "point", best.key, fmt("on the way: the army %.0f m from it", bd))
end
-- 1.3 (TECH_RU.md 21.4) THE MARCH IS JUDGED BEFORE IT STARTS. The testers: "it does not gather its army, it runs in single squads, it
-- throws its units away" (Malum fb 593 / 614 / 623, Orca fb 557 / 634). Malum's log (fb 621): after "ArmyRetreat end timeout there
-- 3670 ours 1731" the director marched the two squads back at the same force ("ArmyRetreat start enemy 1601 ours 853" 3 minutes
-- later, "end timeout there 3915 ours 1837") - a retreat ended by its clock, and nothing asked whether the army could win where
-- it was sent. ArmyRetreat and PreRetreat judge a fight that is on or a force that comes; nobody judged the one that waits.
-- Every tick, for the target the director would march at (the fresh goal of this file, else Elite's own target):
--   the force there = the enemy squads within EngageR of the target or EngagePathR of the straight way to it (all of them: this
--   file reads every enemy squad's place, the turrets are the Defence pattern's); ours = the squads of the line the director
--   has now; the allies' squads within EngageR of the target or of our own centre x EngageAllyK (looked up only when ours alone
--   are not enough).
--   GO when the force is below EngageMinW or ours + allies >= force x EngageNeed x (Conf_Engage 1 / 2 / 3: 1.15 / 1 / 0.85).
--   Else HOLD: a goal of ours that is not safe is dropped (a point: not chosen again for a minute); Elite's target is not
--   marched at - the army takes the nearest SAFE point instead (next_goal's "safe": no enemy base near, no force there), and
--   with none it waits at the RALLY point: our own point nearest to the target that is on our side, has no enemy at it and
--   lies EngageStandoff away, else our HQ. There the squads that were refilled and the new ones join it, and the verdict is
--   asked again every tick. A hold longer than EngageDecayAfter lowers the need (down to EngageDecayMin over EngageDecaySecs)
--   and so does a ticker race we are losing (EngageVpK): the army does not stand at home for ever.
-- Not asked: for a target at our base (EngageHomeR; enemy squads that close to our HQ are in no force either), for the goals of the Garrison / Defence patterns and "defend" (run_map has its own
-- ratio), while the army is in contact (the fight is ArmyRetreat's). EliteAI.eng = { t, threat, hold } for the director (it
-- gathers on its middle squad, not on the one nearest to the target, while a force waits there). Lines "MECH Conf_Engage army
-- go->hold ...", "MECH Engage hold|go ...", "MECH Goal rally ...". Mech_Engage=0 = 1.2.
function X.allies_near(x, z, r, x2, z2)                                       -- within r of the target, or of our own centre (they march with us)
	local w, n = 0, 0
	local n_pl = World_GetPlayerCount()
	for i = 1, n_pl do
		local p = World_GetPlayerAt(i)
		if p and Player_IsAlive(p) and Player_GetTeam(p) == s_self_team then    -- (scan_points asks the team of every player)
			local sg = Player_GetSquads(p)                                    -- the calls of scan_enemies, on the squads of our own team
			local cnt = sg and SGroup_CountSpawned(sg) or 0
			for j = 1, cnt do
				local sq = SGroup_GetSpawnedSquadAt(sg, j)
				if sq and Squad_Count(sq) > 0 then
					local id = Squad_GetGameID(sq)
					if id ~= nil and not M.exists[id] then                     -- not a squad of ours (scan_own)
						local pos = Squad_GetPosition(sq)
						if pos ~= nil and pos.x ~= nil and pos.z ~= nil and (d2(pos.x, pos.z, x, z) <= r or (x2 ~= nil and d2(pos.x, pos.z, x2, z2) <= r)) then
							w = w + Squad_GetHealth(sq) * (SquadQuery_IsVehicle(sq) and prm("VehW") or 1)   -- (an enemy's weight is hmax x hp share: the same number)
							n = n + 1
						end
					end
				end
			end
		end
	end
	return w, n
end
function X.engage_force(en, cx, cz, tx, tz, h)
	local w, n, er, pr, hr = 0, 0, prm("EngageR"), prm("EngagePathR"), prm("EngageHomeR")
	for _, e in ipairs(en) do
		-- (an enemy squad at our base is no force "on the way": the army fights at home whatever the odds - HomeR, the director)
		if (d2(e.x, e.z, tx, tz) <= er or seg_dist(e.x, e.z, cx, cz, tx, tz) <= pr) and not (h and d2(e.x, e.z, h.x, h.z) <= hr) then w, n = w + e.w, n + 1 end
	end
	return w, n
end
function X.engage_rally(en, tx, tz, h, cur)                                   -- cur: the rally point of now - it stays while it is good (no walking to and fro)
	local best, bd
	for _, p in ipairs(M.pts) do
		if p.ours and X.map_side(p) and not X.under_turret(p.x, p.z) then
			local d = d2(p.x, p.z, tx, tz)
			if d >= prm("EngageStandoff") then
				local _, n = enemy_weight_near(en, p.x, p.z, prm("MapThreatR"))
				if n == 0 then
					if cur ~= nil and p.key == cur then return p.key, p.x, p.y, p.z end
					if not best or d < bd or (d == bd and p.key < best.key) then best, bd = p, d end
				end
			end
		end
	end
	if best then return best.key, best.x, best.y, best.z end
	return "home", h.x, h.y or 0, h.z
end
-- 1.4 (step 3 of the vanilla base; VANILLA_BASE_RU.md 11.1) THE CAPTURE TASKS ARE WATCHED. A squad in the engine's capture task is
-- outside every list of this file and of the director - in the mirror of step 2 a quarter of the vanilla side's squads at
-- any moment (T: squads - dir = 1.7-1.9 of 6-7). Nobody sent it home when it was shot to a third, nobody looked at the force
-- it stood in. For each of them (state.caps: this tick's squad, position, health, models - main.ai), every tick:
--   HURT: under attack and below RetreatHP of its health or down to RetreatModels of its models -> a retreat order (the
--         director's own thresholds for a squad of the army);
--   OUTWEIGHED: under attack, or an enemy squad within SightR of it, and the enemy within CapWatchR weighs CapWatchMinW or more
--         and at least CapWatchRatio x (the squad + our army's squads within CapWatchSupR) -> a retreat order.
-- One order per squad per CapWatchSecs (a retreat cannot be called off; the engine's task takes the squad out again when it
-- is home - it then walks to a point with its models refilled by the engine's own reinforcement request, not with two models).
-- A vehicle is not watched (it has no retreat and does not capture). Not at home (HomeR of the HQ). Lines "MECH CapWatch <id> hurt|leaves ...",
-- "caps / cap_hurt / cap_leave" in stats9. Mech_CapWatch=0 = as 1.3 (the default on the Elite base).
function X.run_capwatch(state, en, h)
	local caps = state.caps
	if prm("CapWatch") < 1 or type(caps) ~= "table" or not h then return end
	local now = state.now
	M.capw = M.capw or {}
	local seen = {}
	local rhp, rm = EliteAI.num("RetreatHP", 0.35), EliteAI.num("RetreatModels", 0.34)
	local wr, sr, need, minw, sight = prm("CapWatchR"), prm("CapWatchSupR"), prm("CapWatchRatio"), prm("CapWatchMinW"), prm("SightR")
	for _, c in ipairs(caps) do
		seen[c.id] = true
		local last = M.capw[c.id]
		if not c.veh and (last == nil or now - last >= prm("CapWatchSecs")) and d2(c.pos.x, c.pos.z, h.x, h.z) > prm("HomeR") then
			local why = nil
			local thin = (rm > 0 and (c.full or 0) >= 3 and c.n <= c.full * rm)
			if c.hit and (c.hp < rhp or thin) then
				why = fmt("hurt hp %.2f models %d of %d", c.hp, c.n, c.full or 0)
				M.st.cap_hurt = (M.st.cap_hurt or 0) + 1
			else
				local ew, n, near = 0, 0, false
				for _, e in ipairs(en) do
					local d = d2(e.x, e.z, c.pos.x, c.pos.z)
					if d <= wr then ew, n = ew + e.w, n + 1 end
					if d <= sight then near = true end
				end
				if (c.hit or near) and ew >= minw then
					local ours, sup = weight_of(c), 0
					for _, u in ipairs(state.army) do
						if d2(u.pos.x, u.pos.z, c.pos.x, c.pos.z) <= sr then sup = sup + weight_of(u) end
					end
					if ew >= (ours + sup) * need then
						why = fmt("leaves: enemy %.0f (%d squads) ours %.0f (+%.0f near) ratio %.2f need %.2f", ew, n, ours, sup, ew / math.max(ours + sup, 1), need)
						M.st.cap_leave = (M.st.cap_leave or 0) + 1
					end
				end
			end
			if why then
				M.capw[c.id] = now
				morder(c.id, c.pos.x, c.pos.y, c.pos.z, ORD_RETREAT)               -- (the order book lets a retreat through and keeps no series for it)
				mlog("CapWatch", c.id, why, fmt("at %.0f %.0f home %.0f m", c.pos.x, c.pos.z, d2(c.pos.x, c.pos.z, h.x, h.z)))
			end
		end
	end
	for id in pairs(M.capw) do if not seen[id] and now - M.capw[id] >= prm("CapWatchSecs") then M.capw[id] = nil end end   -- (each entry on its own)
end
function X.run_engage(state, en, cx, cz, h)
	local now = state.now
	local G = M.eng or { hold = false }
	M.eng = G
	EliteAI.eng = nil
	local function release(why)
		if EliteAI.goal and EliteAI.goal.kind == "rally" then clear_goal(why) end
		if G.hold then
			G.hold, G.t0 = false, nil
			mlog("Engage", "go", why)
		end
	end
	if not h then return end
	local g = EliteAI.goal
	if g and (GAR_GOALS[g.kind] or g.kind == "def_hold" or g.kind == "defend") then release("the goal " .. g.kind .. " leads"); return end
	local ow, on = 0, 0
	for _, u in ipairs(state.active) do if not M.runner[u.id] and not X.is_raider(u.id) then ow, on = ow + weight_of(u), on + 1 end end
	if on == 0 then return end
	if M.army_contact ~= nil and now - M.army_contact <= 3 then                -- the fight is on: ArmyRetreat's
		if g and g.kind == "rally" then g.t = now end
		return
	end
	-- the need: the rule, the length of the hold, the ticker race
	local r = rule("Engage")
	local need = prm("EngageNeed") * ((r == 1) and 1.15 or ((r == 3) and 0.85 or 1))
	if G.hold and G.t0 ~= nil and now - G.t0 > prm("EngageDecayAfter") then
		local k = 1 - (1 - prm("EngageDecayMin")) * math.min(1, (now - G.t0 - prm("EngageDecayAfter")) / math.max(prm("EngageDecaySecs"), 1))
		need = need * k
	end
	if cache and cache.self_vp_tickers and cache.enemy_vp_tickers and cache.self_vp_tickers < cache.enemy_vp_tickers
		and cache.self_vp_tickers <= prm("EngageVpLow") then need = need * prm("EngageVpK") end
	local function judge(tx, tz)                                               -- true = the army may go; the force, the allies counted
		local tw, tn = X.engage_force(en, cx, cz, tx, tz, h)
		if tw < prm("EngageMinW") then return true, tw, 0, tn end
		if ow >= tw * need then return true, tw, 0, tn end
		local aw = 0
		if prm("EngageAllies") >= 1 then aw = X.allies_near(tx, tz, prm("EngageR"), cx, cz) * prm("EngageAllyK") end
		return (ow + aw >= tw * need), tw, aw, tn
	end
	-- 1) a goal of ours (a point, an enemy squad, a cover) that the army cannot take is dropped
	local fresh = g ~= nil and g.x ~= nil and now - (g.t or -1000) <= EliteAI.num("Mech_GoalSecs", 60)
	local gtw = 0
	if fresh and g.kind ~= "rally" then
		local ok, tw, aw, tn = judge(g.x, g.z)
		gtw = tw
		if not ok and d2(g.x, g.z, h.x, h.z) > prm("EngageHomeR") then
			if g.pt then M.bad_pt[g.key] = now end
			if g.kind == "enemy" then M.eng_bad = M.eng_bad or {}; M.eng_bad[g.key] = now end   -- (next_goal: not this squad again for EngageBadSecs)
			M.st.eng_drop = (M.st.eng_drop or 0) + 1
			clear_goal(fmt("Engage: the force there %.0f (%d squads) ours %.0f allies %.0f need %.2f", tw, tn, ow, aw, need))
			g, fresh = nil, false
		end
	end
	-- 2) Elite's own target
	local bp = EliteAI.best_pos
	if not (bp and bp.x and bp.z) then
		release("Elite has no target")
		EliteAI.eng = { t = now, hold = false, threat = (fresh and gtw >= prm("EngageMinW")) }
		return
	end
	local eok, etw, eaw, etn = true, 0, 0, 0
	if d2(bp.x, bp.z, h.x, h.z) > prm("EngageHomeR") then eok, etw, eaw, etn = judge(bp.x, bp.z) end
	local v = decide("Engage", "army", eok and "go" or "hold", fmt("the force at Elite's target %.0f (%d squads) ours %.0f allies %.0f need %.2f", etw, etn, ow, eaw, need), now, prm("EngageHold"))
	if v == "go" then
		release(fmt("the force at the target %.0f ours %.0f allies %.0f need %.2f", etw, ow, eaw, need))
		EliteAI.eng = { t = now, hold = false, threat = ((fresh and gtw or etw) >= prm("EngageMinW")) }
		return
	end
	if not G.hold then
		G.hold, G.t0 = true, now
		M.st.eng_hold = (M.st.eng_hold or 0) + 1
		mlog("Engage", "hold", fmt("the force at Elite's target %.0f (%d squads) ours %.0f (%d squads) allies %.0f need %.2f rule %d", etw, etn, ow, on, eaw, need, r))
	end
	M.st.eng_ticks = (M.st.eng_ticks or 0) + 1
	EliteAI.eng = { t = now, hold = true, threat = (fresh and gtw >= prm("EngageMinW")) }
	if fresh and g.kind ~= "rally" then return end                             -- a safe goal: the army does that
	-- 3) the nearest safe point, else the rally point
	local kind, key, x, y, z = next_goal(state, en, cx, cz, nil, true)
	if kind == "point" then
		if g and g.kind == "rally" then clear_goal("a safe point: " .. tostring(key)) end
		M.st.eng_point = (M.st.eng_point or 0) + 1
		set_goal("point", key, x, y, z, now, "Engage: a safe point while the army cannot take Elite's target", true)
		return
	end
	local rkey, rx, ry, rz = X.engage_rally(en, bp.x, bp.z, h, (g and g.kind == "rally") and g.key or nil)
	if g and g.kind == "rally" and g.key ~= rkey then clear_goal("the rally point moves to " .. rkey) end
	if not (EliteAI.goal and EliteAI.goal.kind == "rally") then M.st.eng_rally = (M.st.eng_rally or 0) + 1 end
	set_goal("rally", rkey, rx, ry, rz, now, fmt("Engage: the army waits for its squads, the force at the target %.0f ours %.0f need %.2f", etw, ow, need))
end
function X.run_map(state, en, cx, cz, h)
	local now = state.now
	local g = EliteAI.goal
	if g and GAR_GOALS[g.kind] then return end
	local MAP = M.map or { said = -1000 }
	M.map = MAP
	local ow = 0
	for _, u in ipairs(state.active) do if not M.runner[u.id] and not X.is_raider(u.id) then ow = ow + weight_of(u) end end
	local r = rule("MapDefend")
	local storming = false
	for _, d in ipairs(M.defs or {}) do if d.v == "assault" and d2(cx, cz, d.x, d.z) <= prm("DefArmyR") then storming = true; break end end
	local best, bs, bw, bn
	for _, p in ipairs(M.pts) do
		local was = M.pt_ours[p.key]
		if (p.ours or (was ~= nil and now - was <= prm("MapLostSecs"))) and X.map_side(p) and not X.under_turret(p.x, p.z) then
			local w, n = 0, 0
			for _, e in ipairs(en) do
				if not e.held and d2(e.x, e.z, p.x, p.z) <= prm("MapThreatR") then w, n = w + e.w, n + 1 end
			end
			if n > 0 or (p.ours and p.enemy_cap) then
				local skip = false
				-- 1.2 (TECH_RU.md 20.5; the polygon's scene m, r17: a scout squad stood at our requisition point from the first
				-- second, the army marched at the enemy's base 245 m away and "Goal defend" came at 62 s - rule 2 left the point
				-- "to the runners", and no runner is ever sent to a point of ours). The far point is left only while the army is
				-- BUSY - an enemy in contact within MapBusySecs, or a turret zone being stormed; a marching army turns round
				if r >= 2 and not p.pow and not p.vp and d2(cx, cz, p.x, p.z) > prm("MapFarD")
					and (storming or now - (M.army_contact or -1000) <= prm("MapBusySecs")) then skip = true end
				if r >= 3 and storming and not p.pow then skip = true end
				if not skip then
					local sc = (p.pow and 0 or (p.vp and 1000 or 2000)) + (p.dbase or 0)
					if g and g.kind == "defend" and g.key == p.key then sc = sc - 500 end   -- the one the army is going to stays (within its class)
					if not best or sc < bs or (sc == bs and p.key < best.key) then best, bs, bw, bn = p, sc, w, n end
				end
			end
		end
	end
	if best then
		local ok = (bn == 0) or (ow >= bw * prm("MapDefRatio"))
		local what = (best.pow and "power" or (best.vp and "VP" or "req")) .. (best.ours and "" or " lost")
		local why = fmt("%s %s enemy %.0f (%d squads%s) ours %.0f rule %d", best.key, what, bw, bn, best.enemy_cap and ", capturing" or "", ow, r)
		local v = decide("MapDefend", "army", ok and "defend" or "leave", why, now, 16)
		if ok and v == "defend" then
			MAP.t = now
			M.st.map_def = (M.st.map_def or 0) + 1
			set_goal("defend", best.key, best.x, best.y, best.z, now, why)
			return
		end
		if not ok and now - MAP.said >= 30 then
			MAP.said = now
			M.st.map_left = (M.st.map_left or 0) + 1
			mlog("Map", "defend", best.key, "left:", why, "need", prm("MapDefRatio"))
		end
	end
	g = EliteAI.goal
	if g and g.kind == "defend" then
		if now - (MAP.t or -1000) < prm("MapDefSecs") then g.t = now; return end
		local p = M.pts_by_key[g.key]
		clear_goal("no threat there for " .. prm("MapDefSecs") .. " s")
		if p and not p.ours and not p.us_cap and not X.under_turret(p.x, p.z) and not point_done(p, en, now) then
			local _, n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))
			if n == 0 then set_goal("point", p.key, p.x, p.y, p.z, now, "it was ours: taken back", true) end
		end
	end
end
-- 1.1 THE RAIDER (Orca fb 538: "the lictor was a doubtful buy and went head-on; a lictor is a side capper - infiltration, sudden
-- attacks"). A squad of X.RAIDERS is not a squad of the line: it goes - by plain moves, an infiltrated squad stays unseen while
-- it does not attack - to the enemy's points behind its army: an enemy power point first (there it attacks the generators -
-- order mode 7, the enemy building at that spot - for RaidReissue x 3, then captures when it can), then the other enemy points
-- and the neutral ones on the enemy half that it can capture; never a point with an enemy squad within RunnerPointR now or
-- RaidSeenSecs ago, or under a turret. With one weaker squad next to it (a lone capturing squad) it attacks that squad; with
-- anything else within RaidFleeR it drops the point and walks back towards the army. Hurt (RaidMinHP), or with no target, it
-- is the army's. M.rdr[id] = { key, last, at } (numbers / strings). Lines "MECH Raid <id> ...". Mech_Raid=0 = a squad of the line.
function X.raid_bad(p, en, now)
	local _, n = enemy_weight_near(en, p.x, p.z, prm("RunnerPointR"))
	if n > 0 then return "enemy at the point" end
	if X.under_turret(p.x, p.z) then return "under a turret" end
	if M.pt_seen[p.key] and now - M.pt_seen[p.key] < prm("RaidSeenSecs") then return "enemy seen there" end
	return nil
end
function X.run_raid(state, en, cx, cz, taken)
	if prm("Raid") < 1 then return end
	local now = state.now
	M.rdr = M.rdr or {}
	local alive = {}
	for _, u in ipairs(state.army) do alive[u.id] = true end
	for id in pairs(M.rdr) do if not alive[id] then M.rdr[id] = nil end end   -- (each entry on its own)
	for _, u in ipairs(state.active) do
		if X.is_raider(u.id) and not taken[u.id] then
			local R = M.rdr[u.id]
			if u.hp < prm("RaidMinHP") then
				if R then M.rdr[u.id] = nil; mlog("Raid", u.id, fmt("hp %.2f", u.hp), "hurt: with the army") end
			else
				if not R then
					R = { last = -1000 }
					M.rdr[u.id] = R
					M.st.raid = (M.st.raid or 0) + 1
					mlog("Raid", u.id, M.names[u.id] or "?", "a raider: the enemy's points and generators, not the line")
				end
				local near, nn = nil, 0
				for _, e in ipairs(en) do
					if not e.held then
						local d = d2(e.x, e.z, u.pos.x, u.pos.z)
						if d <= prm("RaidFleeR") then nn = nn + 1; if not near or d < near.dr then e.dr = d; near = e end end
					end
				end
				if nn == 1 and not near.veh and not near.nogo and near.w <= weight_of(u) * 0.8 then
					morder(u.id, near.id, 0, 0, ORD_ATTACK_SQUAD)                    -- a lone weaker squad: its prey
					taken[u.id] = true
				elseif nn > 0 then
					if R.key then
						M.bad_pt[R.key] = now
						mlog("Raid", u.id, "leaves", R.key, "enemy squads", nn)
						R.key, R.at = nil, nil
					end
					if now - R.last >= prm("RaidReissue") then R.last = now; morder(u.id, cx, u.pos.y, cz, ORD_MOVE) end
					taken[u.id] = true
				else
					local p = R.key and M.pts_by_key[R.key] or nil
					if p then
						local bad = p.ours and "ours" or X.raid_bad(p, en, now)
						if bad then
							mlog("Raid", u.id, "point", p.key, bad)
							if bad ~= "ours" then M.bad_pt[p.key] = now end
							p, R.key, R.at = nil, nil, nil
						end
					end
					if not p then
						local cc = can_cap(u.id)
						local bp, bsc
						for _, q in ipairs(M.pts) do
							local theirs = (X.capper_at(q.key) ~= nil)                         -- a point another squad of ours is taking is not doubled
							for _, RR in pairs(M.runner) do if RR.tgt == q.key then theirs = true end end   -- (any: the order of pairs() does not matter)
							if not theirs and not q.ours and (q.enemy or q.enemy_half) and (cc or (q.pow and q.enemy))
								and not (M.bad_pt[q.key] and now - M.bad_pt[q.key] < 60) and not X.raid_bad(q, en, now) then
								local sc = d2(u.pos.x, u.pos.z, q.x, q.z) - ((q.pow and q.enemy) and 60 or 0) - (q.enemy and 20 or 0)
								if not bp or sc < bsc or (sc == bsc and q.key < bp.key) then bp, bsc = q, sc end
							end
						end
						p = bp
						if p then
							R.key, R.last, R.at = p.key, -1000, nil
							mlog("Raid", u.id, "->", p.key, p.pow and "power" or (p.vp and "VP" or "req"), p.enemy and "enemy" or "neutral", cc and "can capture" or "generators only")
						end
					end
					if p then
						if now - R.last >= prm("RaidReissue") then
							R.last = now
							if d2(u.pos.x, u.pos.z, p.x, p.z) > 14 then
								morder(u.id, p.x, p.y, p.z, ORD_MOVE)
							else
								R.at = R.at or now
								local bash = p.pow and p.enemy and (now - R.at < prm("RaidReissue") * 3 or not can_cap(u.id))
								if bash then morder(u.id, p.x, p.y, p.z, ORD_ATTACK_STRUCT)
								elseif can_cap(u.id) then morder(u.id, p.x, p.y, p.z, ORD_CAPTURE)
								else M.bad_pt[p.key] = now; R.key, R.at = nil, nil end
								if not R.said_at then R.said_at = true; mlog("Raid", u.id, "at", p.key, bash and "attacks the generators" or "captures") end
							end
						end
						if R.key then taken[u.id] = true end
					end
				end
			end
		end
	end
end

local function stats(state)
	if state.now - M.last_stats < prm("StatsSecs") then return end
	M.last_stats = state.now
	local alive = {}
	for _, u in ipairs(state.army) do alive[u.id] = true end
	for _, t in ipairs({ M.tie, M.repair, M.jumped, M.names, M.cap, M.idle, M.norole, M.gren, M.gar_ord, M.nocap, M.capfail, M.def_ord or {}, M.veh or {}, M.setup_ord or {}, M.def_ret or {}, M.def_own or {}, M.dodge or {} }) do   -- forget squads that are gone
		for id in pairs(t) do if not alive[id] then t[id] = nil end end
	end
	for key, c in pairs(M.conf) do                                             -- old decisions of dead squads / points
		if state.now - c.t > 300 then M.conf[key] = nil end
	end
	local s = M.st
	local tasks = -1
	if TASK_PlayerAbility ~= nil then tasks = Task_CountActive(s_selfplayer, TASK_PlayerAbility, false) end   -- player_abilities.ai:242
	mlog("stats", "t", math.floor(state.now), "focus", s.focus, "switch", s.focus_sw, "retreat", s.retreat, "pre", s.pre, "punish", s.punish,
		"tie", s.tie, "jump", s.jump, "kite", s.kite, "repair", s.repair, "abil", s.abil, "abil_tasks", tasks, "abil_held", s.abil_held or 0, "abil_over", s.abil_over or 0,
		"abil_callin", s.abil_callin or 0, "abil_first", s.abil_first or 0, "abil_notgt", s.abil_notgt or 0,
		"runner", s.runner, "runner_lost", s.runner_lost or 0, "runner_drop", s.runner_drop or 0, "split", s.split,
		"decap", s.decap, "conf_sw", s.conf, "orders", s.orders, "enemies", table.getn(M.en or {}), "points", table.getn(M.pts or {}), "phase", EliteAI.phase or "-")
	local g, G = EliteAI.goal, M.gar
	mlog("stats2", "t", math.floor(state.now), "idle", s.idle, "idle_role", s.idle_role, "goals", s.goal, "goal", g and (g.kind .. " " .. tostring(g.key)) or "-",
		"garrisons", s.gar, "assault", s.gar_assault, "hold", s.gar_hold, "bypass", s.gar_bypass, "grenades", s.gren,
		"garrison", G and (tostring(G.id) .. " " .. tostring(G.v)) or "-")
	mlog("stats4", "t", math.floor(state.now), "def_avoid", s.def_avoid or 0, "def_assault", s.def_assault or 0, "def_out", s.def_out or 0, "def_siege", s.def_siege or 0,
		"def_lost", s.def_lost or 0, "def_retreat", s.def_retreat or 0, "def_standoff", s.def_standoff or 0, "def_nosiege", s.def_nosiege or 0, "turrets", table.getn(M.defs or {}), "veh_back", s.veh_back or 0, "veh_early", s.veh_early or 0, "veh_trans", s.veh_trans or 0, "veh_wait", s.veh_wait or 0,
		"setup_gren", s.setup_gren or 0, "setup_approach", s.setup_appr or 0, "setup_jump", s.setup_jump or 0, "setup_flank", s.setup_flank or 0, "enemy_setups", (type(EliteAI.setup) == "table") and EliteAI.setup.n or 0,
		"veh_home", s.veh_home or 0, "retreat_veh", prm("RetreatVeh"))
	mlog("stats5", "t", math.floor(state.now), "dodge", s.dodge or 0, "dodge_notes", s.dodge_notes or 0, "dodge_mines", s.dodge_mines or 0, "dodge_rule", rule("DodgeBusy"))
	mlog("stats6", "t", math.floor(state.now), "counter_known", s.cn_known or 0, "counter_none", s.cn_none or 0, "bp_asked", s.cn_bp or 0, "bp_differ", s.cn_bp_diff or 0, "av_focus", s.cn_av or 0,
		"counter_seen", s.cn_mem or 0, "counter_demand", s.cn_demand or 0, "counter_focus", s.cn_focus or 0, "counter_control", s.cn_ctrl or 0,
		"counter_rule", rule("CounterVsPlan"), "see", (M.api and M.api.see) and "api" or "range")
	local nr = 0
	for _ in pairs(M.rdr or {}) do nr = nr + 1 end                              -- (a count)
	mlog("stats7", "t", math.floor(state.now), "map_defend", s.map_def or 0, "map_left", s.map_left or 0, "cappers", s.capper or 0, "cappers_now", table.getn(M.cappers or {}),
		"map_on", s.map_on or 0, "map_cover", s.map_cover or 0, "raiders", s.raid or 0, "raiders_now", nr, "map_rule", rule("MapDefend"))
	mlog("stats8", "t", math.floor(state.now), "eng_hold", s.eng_hold or 0, "eng_ticks", s.eng_ticks or 0, "eng_drop", s.eng_drop or 0, "eng_point", s.eng_point or 0, "eng_rally", s.eng_rally or 0,
		"holding", (M.eng and M.eng.hold) and 1 or 0, "fight_army", s.fight_army or 0, "fight_leave", s.fight_leave or 0, "trade", s.trade or 0, "way_cap", s.way_cap or 0, "runner_safe", s.runner_safe or 0, "engage_rule", rule("Engage"))
	mlog("stats9", "t", math.floor(state.now), "caps", table.getn(state.caps or {}), "cap_hurt", s.cap_hurt or 0, "cap_leave", s.cap_leave or 0,
		"cap_watch", prm("CapWatch"), "power_mine", prm("PowerMine"), "pw_own", (type(EliteAI.pw) == "table") and EliteAI.pw.own or -1,
		"pw_unsec", (type(EliteAI.pw) == "table") and EliteAI.pw.unsec or -1, "pw_slots", (type(EliteAI.pw) == "table") and EliteAI.pw.slots or -1)
	local o = EliteAI.ord_st
	if o then mlog("stats3", "t", math.floor(state.now), "orders_sent", o.sent, "repeat_skipped", o.skip, "to_move", o.alt, "ceiling", o.cap, "director_waited", o.held, "approach", s.gar_appr or 0, "escalated", o.esc or 0, "build_wait", o.bwait or 0, "build_near", o.bnear or 0) end
end

-- entry point (see the header); the order inside a tick: retreats (whole army) > Garrison (assault: the whole army) > the
-- goal's capturing squad, runners, split > Repair, MeleeApproach, MeleeTie (per squad) > PunishTurn > FocusFire > Idle
function EliteAI_Mechanics(state)
	if not state or not state.army or not state.active then return false end
	local now = state.now or World_GetGameTime()
	state.now = now
	M.now = now
	X.dodge_cfg(now, mech_on("Dodge"))                                        -- 0.8: the dodge policy for elite.scar (the reflex is there)
	local on = {}
	for _, k in ipairs({ "FocusFire", "Repair", "ArmyRetreat", "PreRetreat", "PunishTurn", "MeleeTie", "RaceAbilities", "ArmyRoles", "Idle", "Garrison", "Defence", "Vehicles", "Setup", "Counter" }) do on[k] = mech_on(k) end
	if not M.said.on then
		M.said.on = true
		mlog("on", "variant", tostring(EliteAI.variant or "-"), "idx", vidx(), "version", EliteAI_MECH_VERSION,
			"FocusFire", on.FocusFire and 1 or 0, "Repair", on.Repair and 1 or 0, "ArmyRetreat", on.ArmyRetreat and 1 or 0, "PreRetreat", on.PreRetreat and 1 or 0,
			"PunishTurn", on.PunishTurn and 1 or 0, "MeleeTie", on.MeleeTie and 1 or 0, "RaceAbilities", on.RaceAbilities and 1 or 0, "ArmyRoles", on.ArmyRoles and 1 or 0,
			"Idle", on.Idle and 1 or 0, "Garrison", on.Garrison and 1 or 0, "Defence", on.Defence and 1 or 0, "Vehicles", on.Vehicles and 1 or 0, "Setup", on.Setup and 1 or 0, "Counter", on.Counter and 1 or 0)
		mlog("rules", "MeleeApproach", rule("MeleeApproach"), "FocusLeave", rule("FocusLeave"), "Chase", rule("Chase"), "Split", rule("Split"),
			"Decap", rule("Decap"), "HoldVP", rule("HoldVP"), "TieVsFocus", rule("TieVsFocus"), "RepairVsFight", rule("RepairVsFight"),
			"PreEngage", rule("PreEngage"), "RunnerFight", rule("RunnerFight"), "AbilitySave", rule("AbilitySave"), "Garrison", rule("Garrison"),
			"AbilityVsUnit", rule("AbilityVsUnit"), "RunnerArmy", rule("RunnerArmy"), "CounterVsPlan", rule("CounterVsPlan"), "MapDefend", rule("MapDefend"), "Engage", rule("Engage"),
			"Map", prm("Map"), "Raid", prm("Raid"))
		api()
	end
	if not (on.FocusFire or on.Repair or on.ArmyRetreat or on.PreRetreat or on.PunishTurn or on.MeleeTie or on.RaceAbilities or on.ArmyRoles
		or on.Idle or on.Garrison or on.Defence or on.Vehicles or on.Setup or on.Counter) then return false end
	M.focus_force = nil
	local cx, cz = centre(state.active)
	if not cx then cx, cz = centre(state.army) end
	local h = home()
	if not cx then
		if not h then return false end
		cx, cz = h.x, h.z
	end
	-- 0.3: the army's centre without the runners (last tick's roles) - for the goals, the Idle logic and the Garrison pattern
	-- (a runner on the far flank moved the centre off the army and the army never "arrived")
	local ax, az, an = 0, 0, 0
	for _, u in ipairs(state.active) do
		if not M.runner[u.id] then ax, az, an = ax + u.pos.x, az + u.pos.z, an + 1 end
	end
	if an > 0 then ax, az = ax / an, az / an else ax, az = cx, cz end
	local en = scan_enemies(now, cx, cz, state.army, on.MeleeTie or on.FocusFire)
	-- 0.6: when the army itself last had an enemy in contact within AbilR (main.ai's quiet refill trip reads it; M.last_contact
	-- also counts an enemy our ally fights at the other end of the map)
	for _, e in ipairs(en) do if e.contact and e.d <= prm("AbilR") then M.army_contact = now; break end end
	scan_own(state.army)
	if on.Counter then X.counter_tick(state, en, now) elseif EliteAI.counter then EliteAI.counter = nil end   -- 0.9: what we see of the enemy, the arbiter per class
	local map_on = prm("Map") >= 1                                              -- 1.1
	if on.ArmyRoles or on.Idle or on.Garrison or on.Defence or map_on or rule("HoldVP") >= 2 then scan_points(); points_memory(en, now) end
	if on.RaceAbilities then ra_clump(en, cx, cz, state.army, h); run_race_abilities() end
	stats(state)
	if on.Idle then idle_clock(state) end                                      -- 0.3: before any return, the clocks run every tick
	X.run_capwatch(state, en, h)                                               -- 1.4: the squads in the engine's capture tasks (before any return)
	-- 1) the whole army: retreats
	if M.retreat then
		if run_retreat(state, en, cx, cz, h) then return true end
	elseif table.getn(state.active) > 0 then
		if on.ArmyRetreat and check_army_retreat(state, en, cx, cz, h) then return true end
		if on.PreRetreat and check_pre_retreat(state, en, cx, cz, h) then return true end
	end
	local taken = {}
	-- 1a) 0.7 Defence: the enemy's turrets - the zones the army stays out of this tick (EliteAI.def_block, e.nogo), squads
	-- walk out of them, the tools go at a turret that is stormed. Before everything that sends squads somewhere
	if on.Defence then X.run_def(state, en, ax, az, h, taken) elseif EliteAI.def_block then EliteAI.def_block = nil end
	-- 1b) 0.3 Garrison: an enemy squad in a building next to something of ours (assault = the whole army is ordered here).
	-- 0.4: also while the director has no squad of its own (all of them in Elite's capture tasks, sent home or runners: the
	-- scene b3 - found 44 s late and "bypass" at once): the garrison is found, the decision taken and the purchase scripts
	-- told (EliteAI.gar) all the same; "the army" is then where its squads will come from - our HQ
	local gtook = false
	if on.Garrison and api().hold then
		local gx, gz = ax, az
		if an == 0 and h then gx, gz = h.x, h.z end
		gtook = run_garrison(state, en, gx, gz, h, taken)
	elseif M.gar then
		M.gar, EliteAI.gar = nil, nil
		clear_goal("Garrison off", GAR_GOALS)
	end
	if table.getn(state.active) == 0 then return false end
	if map_on then X.run_map(state, en, ax, az, h) end                          -- 1.1: a point of ours that is attacked - before any other goal
	if prm("Engage") >= 1 then X.run_engage(state, en, ax, az, h) elseif EliteAI.eng then EliteAI.eng = nil end   -- 1.3: may the army march where it is sent
	if on.Idle or on.Garrison or map_on then goal_tick(state, en, ax, az, taken) end   -- the goal's life, the squads that take the goal points
	if map_on then X.way_capture(state, en, ax, az, taken) end                  -- 1.3: a free point next to the marching army
	-- 2) roles: runners (always theirs), the split after a fight (true = the rest of the army covers the split)
	local covering = false
	if on.Vehicles and on.ArmyRoles and prm("VehRunner") >= 1 then X.run_veh(state, en, ax, az, h, taken, true) end   -- 1.0: a runner that is a vehicle leaves the fire too
	if on.ArmyRoles then covering = run_army_roles(state, en, cx, cz, taken) end
	if on.ArmyRoles then X.run_raid(state, en, ax, az, taken) end               -- 1.1: the raiders are not squads of the line
	local took = false
	if not covering then
		-- 3) per squad
		if on.Vehicles then X.run_veh(state, en, ax, az, h, taken) end             -- 0.7: before Repair - a vehicle sent back is found there
		if on.Setup then X.run_setup(state, en, ax, az, taken) end                 -- 0.7: grenades, jumps and the flank against set-up teams
		if on.Counter then X.run_control(state, en, ax, az, taken) end             -- 0.9: a stun / slow / knock-back on a dangerous melee squad that comes at us
		if on.Repair then run_repair(state, en, taken) end
		run_melee_approach(state, en, cx, cz, taken)
		local r7 = rule("TieVsFocus")
		if on.MeleeTie and r7 == 1 then run_tie(state, en, taken, false) end       -- tie first, the rest focus
		-- 4) the rest of the army
		if on.PunishTurn then took = run_punish(state, en, cx, cz, h, taken) end
		if on.MeleeTie and r7 == 3 and not took then run_tie(state, en, taken, true) end   -- jump squads tie, the rest focus
		if not took and on.FocusFire then took = run_focus(state, en, cx, cz, taken) end
		if on.MeleeTie and r7 == 2 and not took then run_tie(state, en, taken, false) end  -- focus first; tie only without a focus target
	end
	-- 5) 0.3 Idle: squads nobody ordered and that stand out of a fight; the next goal for an army that stands at its target
	if on.Idle then run_idle(state, en, ax, az, taken, covering) end

	if covering then return true end                                           -- as before: the director issues nothing during the cover
	-- the squads ordered here are not the director's this tick
	local keep, removed = {}, 0
	for _, u in ipairs(state.active) do if taken[u.id] then removed = removed + 1 else table.insert(keep, u) end end
	if removed > 0 then
		for i = table.getn(state.active), 1, -1 do table.remove(state.active, i) end
		for _, u in ipairs(keep) do table.insert(state.active, u) end
	end
	return took or gtook
end


-- ===== /EliteAI =====
InitializeAI()
