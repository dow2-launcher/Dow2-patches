-- ===== EliteAI brain/10_perception.ai =====
do
	local function eliteai_brain_10_perception()
-- BRAIN 10_perception: the world model. Built anew every tick from the engine, numbers only; the other modules read
-- nothing but this table (W) - no module asks the engine about the world on its own.
--
-- Honest by construction (R17): an enemy squad enters W.en only while OUR player sees it (AIPlayer_CanSeeSquad; without the
-- function - within Sight m of one of our squads). What was seen and is hidden now stays in W.ghosts for GhostSecs with its
-- last position and age: memory, as a person has it. Points, their owners and the HQ spots are on every player's minimap.
--
-- W = {
--   now, home = { x, y, z },
--   own   = { u ... } every squad of ours that is alive;  army = those the brain commands (not building, not in the
--           engine's capture task);  by_id
--   en    = { e ... } visible enemy squads;  ghosts = { e ... } hidden ones, with e.age
--   pts   = { p ... } points: key, x, y, z, vp, pow, ours, enemy, neutral, enemy_cap, us_cap, dbase;  ehq = { { x, y, z } ... }
--   vp    = { ours, enemy, neutral (victory points held), t_ours, t_enemy (tickets until each side wins), behind }
--   fights = { F ... } see fights() below
-- }
-- unit u / e: id, key (blueprint), d (row of Brain.UNITS or nil), x, y, z, hp (0..1, living models), hpabs, n (models),
--   full, eff (n / full * hp), veh, hit (shot at in the last 3 s), can_ret, mel; own only: dhome, home, incap, builds,
--   retreating, capturing, moving, contact, ed (distance to the nearest visible enemy), fight (its fight or nil)
-- Cadence: every brain tick (1 s); points every PointSecs (3 s).
-- Log: 'BR SEE <t> api ...' once; 'BR SEE <t> seen <id> <unit> ...' the first time an enemy blueprint is seen;
--      'BR W <t> own N army N en N ghosts N fights N vp o/e/n' every 10 s.

Brain.perception = {}
local P = Brain.perception
P.names, P.seen, P.hist, P.fprev, P.last_pos, P.kinds = {}, {}, {}, {}, {}, {}
local d2 = Brain.d2

local function api()
	if P.api then return P.api end
	P.api = {
		see = (type(AIPlayer_CanSeeSquad) == "function") and Brain.num("SeeApi", 1) >= 1,
		bpname = (type(Squad_GetBlueprintName) == "function"),
		cmd = (type(Squad_HasActiveCommand) == "function" and type(Squad_GetActiveCommand) == "function"),
		st_build = (type(SQUADSTATEID_Construction) == "number"),
		st_retreat = (type(SQUADSTATEID_Retreat) == "number"),
		st_capture = (type(SQUADSTATEID_Capture) == "number"),
		-- step 2: the engine's own retreat rule reads the aggression of each AI squad; Military_SetSquadAggression (the
		-- player's number) did not stop it for squads that are in no task of Relic's (bench 13.11) - Brain_SquadAggression=1 sets it per squad too
		aggr = (type(AISquad_SetAggression) == "function") and Brain.num("SquadAggression", 0) >= 1,   -- (tried: a squad reads 0.5 whatever the player number is; setting 1.0 every tick changed nothing - 12 engine retreats against 10 in 15 scenes; off)
	}
	Brain.log("SEE", "api", "AIPlayer_CanSeeSquad", type(AIPlayer_CanSeeSquad), "use", P.api.see and 1 or 0,
		"Squad_GetBlueprintName", type(Squad_GetBlueprintName), "Squad_GetActiveCommand", type(Squad_GetActiveCommand),
		"SQUADSTATEID_Retreat", type(SQUADSTATEID_Retreat), "SQUADSTATEID_Construction", type(SQUADSTATEID_Construction),
		"SQUADSTATEID_Capture", type(SQUADSTATEID_Capture), "AISquad_SetAggression", type(AISquad_SetAggression), "use", P.api.aggr and 1 or 0)
	return P.api
end

function P.home()
	if not P.home_pos then
		local p = AIPlayer_GetHomePosition(s_self_modplayer)
		if p and p.x then P.home_pos = { x = p.x, y = p.y, z = p.z } end
	end
	return P.home_pos
end

-- the data row and what follows from it; a blueprint without a row gets guesses and is named once in the log
local function describe(u)
	local d = Brain.UNITS and Brain.UNITS[u.key] or nil
	u.d = d
	if d ~= nil then
		u.full = d.n
		u.can_ret = (d.ret ~= 0) and not u.veh
		u.mel = (d.mel == 1)
	else
		u.full = u.n
		u.can_ret = not u.veh
		u.mel = false
		if u.key ~= nil and not P.kinds["nodata|" .. u.key] then
			P.kinds["nodata|" .. u.key] = true
			Brain.log("SEE", "no data row for", (u.key == "") and "(no name)" or u.key, "- strength by health only")
		end
	end
	if u.full < u.n then u.full = u.n end
	u.eff = (u.n / math.max(u.full, 1)) * u.hp
end

-- ---- our squads ----------------------------------------------------------------------------------------------------------
local function scan_own(W)
	local a = api()
	local hq, home_r = W.home, Brain.num("HomeR", 40)
	local n = Military_SquadTotalCount(s_selfplayer)
	for i = 0, n - 1 do
		local aisq = Military_GetAISquadAtIndex(s_selfplayer, i)
		if aisq ~= nil then
			local sq = AISquad_ConvertToSimSquad(aisq)                    -- nil for a squad that is not spawned
			if sq ~= nil and Squad_Count(sq) > 0 then
				local id, pos = Squad_GetGameID(sq), Squad_GetPosition(sq)
				if id ~= nil and pos ~= nil and pos.x ~= nil and pos.z ~= nil then
					local hmax = math.max(Squad_GetHealthMax(sq) or 1, 1)
					local hpabs = Squad_GetHealth(sq) or 0
					local u = { id = id, x = pos.x, y = pos.y, z = pos.z, hpabs = hpabs, hp = hpabs / hmax, hmax = hmax, n = Squad_Count(sq),
						hit = (Squad_IsUnderAttack(sq, 3) == true), veh = (SquadQuery_IsVehicle(sq) == true), own = true, sq = sq }   -- (sq: the engine's squad, good for THIS tick only)
					if P.names[id] == nil then
						local pbg = AISquad_ConvertToPBG(aisq)
						P.names[id] = Brain.bp_key(pbg and PBG_GetName(pbg) or "")
					end
					u.key = P.names[id]
					describe(u)
					u.incap = (AISquad_InCaptureTask(aisq) == true)
					if a.aggr then
						if not P.aggr_said and type(AISquad_GetAggression) == "function" then
							P.aggr_said = true
							Brain.log("SEE", "aggression of squad", id, "was", tostring(AISquad_GetAggression(aisq)), "- set to", Brain.num("Aggression", 1.0), "for every squad, every tick")
						end
						AISquad_SetAggression(aisq, Brain.num("Aggression", 1.0))
					end
					if a.cmd and Squad_HasActiveCommand(sq) == true then
						local c = Squad_GetActiveCommand(sq)
						u.builds = (a.st_build and c == SQUADSTATEID_Construction) or false
						u.retreating = (a.st_retreat and c == SQUADSTATEID_Retreat) or false
						u.capturing = (a.st_capture and c == SQUADSTATEID_Capture) or false
					end
					if hq ~= nil then u.dhome = d2(u.x, u.z, hq.x, hq.z); u.home = (u.dhome <= home_r) end
					local lp = P.last_pos[id]
					u.moving = (lp ~= nil) and (d2(u.x, u.z, lp.x, lp.z) > 1.5) or false
					table.insert(W.own, u)
					W.by_id[id] = u
					if not u.incap and not u.builds then table.insert(W.army, u) end
				end
			end
		end
	end
	local lp = {}
	for _, u in ipairs(W.own) do lp[u.id] = { x = u.x, z = u.z } end
	P.last_pos = lp
end

-- ---- the enemy: what our player sees now, and what it remembers ---------------------------------------------------
local function scan_enemies(W)
	local a = api()
	local now, sight = W.now, Brain.num("Sight", 40)
	local vis_now = {}
	local n_pl = World_GetPlayerCount()
	local n_side = 0                                                    -- the players that are not enemies: ourselves and the allies
	for i = 1, n_pl do
		local p = World_GetPlayerAt(i)
		if p and Player_GetRelationship(s_self_modplayer, p) ~= R_ENEMY then n_side = n_side + 1 end
	end
	P.n_allies = math.max(n_side - 1, 0)
	for i = 1, n_pl do
		local p = World_GetPlayerAt(i)
		if p and Player_IsAlive(p) and Player_GetRelationship(s_self_modplayer, p) == R_ENEMY then
			local sg = Player_GetSquads(p)
			local cnt = sg and SGroup_CountSpawned(sg) or 0
			for j = 1, cnt do
				local sq = SGroup_GetSpawnedSquadAt(sg, j)
				local n = sq and Squad_Count(sq) or 0
				if n > 0 then
					local pos = Squad_GetPosition(sq)
					local vis = false
					if pos ~= nil and pos.x ~= nil and pos.z ~= nil then
						if a.see then vis = (AIPlayer_CanSeeSquad(s_selfplayer, sq) == true)
						else
							for _, u in ipairs(W.own) do if d2(pos.x, pos.z, u.x, u.z) <= sight then vis = true; break end end
						end
					end
					-- Step 6 (bench s6_g9, live_ork_vs_sm_090fd4: 'fight F1 PRESS why stronger ratio 489.00 ... ours 2 489 enemy 1 0',
					-- 100 s - 320 s: two squads of five stood over the enemy's FALLEN HERO (health 0, it lies until it is paid
					-- for) and 'pressed the fight'; 149 of 1570 fight lines of nine games were against an enemy of strength 0).
					-- A squad without health is not an enemy to fight: it is not seen (Brain_SeeDowned=1: as before).
					if vis and (Squad_GetHealth(sq) or 0) <= 0 and Brain.num("SeeDowned", 0) < 1 then
						vis = false
						P.seen[Squad_GetGameID(sq)] = nil
					end
					-- nothing else is read from a squad our player does not see
					if vis then
						local id = Squad_GetGameID(sq)
						local hmax = math.max(Squad_GetHealthMax(sq) or 1, 1)
						local hpabs = Squad_GetHealth(sq) or 0
						local e = { id = id, x = pos.x, y = pos.y, z = pos.z, hpabs = hpabs, hp = hpabs / hmax, hmax = hmax, n = n,
							hit = (Squad_IsUnderAttack(sq, 3) == true), veh = (SquadQuery_IsVehicle(sq) == true), sq = sq }
						if a.cmd and a.st_retreat and Squad_HasActiveCommand(sq) == true then e.retreating = (Squad_GetActiveCommand(sq) == SQUADSTATEID_Retreat) end
						if P.names[id] == nil then
							P.names[id] = a.bpname and Brain.bp_key(Squad_GetBlueprintName(sq)) or ""
							P.enemy_ever = true
							Brain.log("SEE", "seen", id, Brain.short(P.names[id]), "models", n, "at", Brain.f0(e.x), Brain.f0(e.z))
						end
						e.key = P.names[id]
						describe(e)
						table.insert(W.en, e)
						vis_now[id] = true
						P.seen[id] = { id = id, key = e.key, x = e.x, y = e.y, z = e.z, hp = e.hp, hpabs = e.hpabs, hmax = e.hmax, n = e.n, veh = e.veh, t = now }
					end
				end
			end
		end
	end
	local keep, gs = {}, Brain.num("GhostSecs", 20)
	for _, id in ipairs(Brain.keys(P.seen)) do
		local s = P.seen[id]
		if now - s.t <= gs then
			keep[id] = s
			if not vis_now[id] then
				local g = { id = id, key = s.key, x = s.x, y = s.y, z = s.z, hp = s.hp, hpabs = s.hpabs, hmax = s.hmax, n = s.n, veh = s.veh,
					hit = false, age = now - s.t, ghost = true }
				describe(g)
				table.insert(W.ghosts, g)
			end
		end
	end
	P.seen = keep
	table.sort(W.ghosts, function(x, y) return x.id < y.id end)
end

-- ---- points --------------------------------------------------------------------------------------------------------------
-- ---- step 6: the enemy's turrets ----------------------------------------------------------------------------------------
-- Orca, mark 9: 'after the turrets went up it has no idea what to do, runs back and forth'. A turret is an ENTITY of the
-- enemy player, not a squad: the brain did not see it at all - the fights around one read 'lost10s 392:0'. The enemy's
-- entities are listed as the old AI's Defence layer lists them (mechanics.ai X.def_scan: Player_GetEntities,
-- EGroup_GetSpawnedEntityAt, Entity_GetBlueprintName / Position / HealthPercentage - in the game since newai-14), every
-- TurretScanSecs (5 s); a blueprint with 'turret' in its name that stands. Fog: a turret is KNOWN once a squad of ours
-- has been within TurretSeeR (45 m) of it, and stays known while it stands. W.turrets = { x, y, z, hp, key }.
-- Brain_Turrets=0: off.
P.turrets, P.turrets_t, P.tur_seen = {}, -100, {}
local function scan_turrets(W)
	local now = W.now
	if now - P.turrets_t < Brain.num("TurretScanSecs", 5) then return P.turrets end
	P.turrets_t = now
	if P.tur_api == nil then
		P.tur_api = (type(Player_GetEntities) == "function" and type(EGroup_CountSpawned) == "function" and type(EGroup_GetSpawnedEntityAt) == "function"
			and type(Entity_GetBlueprintName) == "function" and type(Entity_GetPosition) == "function" and type(Entity_GetHealthPercentage) == "function")
			and Brain.num("Turrets", 1) >= 1
		Brain.log("SEE", "api", "Player_GetEntities", type(Player_GetEntities), "Entity_GetBlueprintName", type(Entity_GetBlueprintName), "turrets", P.tur_api and 1 or 0)
	end
	local list = {}
	if not P.tur_api then P.turrets = list; return list end
	for i = 1, World_GetPlayerCount() do
		local p = World_GetPlayerAt(i)
		if p and Player_IsAlive(p) and Player_GetRelationship(s_self_modplayer, p) == R_ENEMY and Player_GetTeam(p) ~= s_self_team then
			local eg = Player_GetEntities(p)
			local cnt = eg and EGroup_CountSpawned(eg) or 0
			for j = 1, cnt do
				local e = EGroup_GetSpawnedEntityAt(eg, j)
				if e ~= nil then
					local nm = string.lower(Entity_GetBlueprintName(e) or "")
					if string.find(nm, "turret", 1, true) ~= nil then
						local pos, hp = Entity_GetPosition(e), Entity_GetHealthPercentage(e) or 1
						-- (not the turrets of the enemy's base: every HQ has its own from the first second, the plan keeps away from
						-- the base anyway - bench s6_l8_c against s6_l8_c0, 24 games: with them counted the brain was ahead in 14,
						-- without any turret rule in 19)
						local base = false
						if pos ~= nil and pos.x ~= nil and pos.z ~= nil then
							for _, h in ipairs(P.ehq or {}) do if d2(pos.x, pos.z, h.x, h.z) <= Brain.num("TurretBaseR", 75) then base = true end end
						end
						if pos ~= nil and pos.x ~= nil and pos.z ~= nil and hp > 0 and not base then
							local key = string.format("%.0f/%.0f", pos.x, pos.z)
							local seen = P.tur_seen[key]
							if not seen then
								for _, u in ipairs(W.own) do if d2(u.x, u.z, pos.x, pos.z) <= Brain.num("TurretSeeR", 45) then seen = true; break end end
								if seen then
									P.tur_seen[key] = true
									Brain.log("SEE", "turret", Brain.short(Brain.bp_key(nm)), "at", key, "hp", Brain.f2(hp))
								end
							end
							if seen then table.insert(list, { x = pos.x, y = pos.y or 0, z = pos.z, hp = hp, key = key }) end
						end
					end
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.key < b.key end)
	P.turrets = list
	return list
end

local function scan_points(now)
	local pts, hqs = {}, {}
	local function add(mp, team)
		if not Military_IsMilitaryPointValid(mp) then return end
		local t = Military_GetMilitaryPointType(mp)
		local p = Military_GetMilitaryPointPosition(mp)
		if not p then return end
		if t == MPT_HQ then
			if team ~= s_self_team then table.insert(hqs, { x = p.x, y = p.y, z = p.z }) end
			return
		end
		if t ~= MPT_VictoryPoint and t ~= MPT_PowerPoint and t ~= MPT_RequisitionPoint then return end
		local e = { x = p.x, y = p.y, z = p.z, vp = (t == MPT_VictoryPoint), pow = (t == MPT_PowerPoint),
			dbase = Military_GetMilitaryPointDistanceToBase(s_selfplayer, mp),
			enemy_cap = (Military_IsMilitaryPointBeingCapturedByEnemy(s_selfplayer, mp) == true),
			us_cap = (Military_IsMilitaryPointBeingCapturedByUs(s_selfplayer, mp) == true) }
		e.key = string.format("%.0f/%.0f", e.x, e.z)
		e.ours = (team == s_self_team)
		e.neutral = (team == -1)
		e.enemy = (not e.ours and not e.neutral)
		table.insert(pts, e)
	end
	local n_pl = World_GetPlayerCount()
	for i = 1, n_pl do
		local pl = World_GetPlayerAt(i)
		if pl then
			local team = Player_GetTeam(pl)
			local cnt = Military_GetMilitaryPointCount(s_selfplayer, pl)
			for j = 0, cnt - 1 do add(Military_GetMilitaryPointAt(s_selfplayer, pl, j), team) end
		end
	end
	local cnt = Military_GetNeutralMilitaryPointCount(s_selfplayer)
	for j = 0, cnt - 1 do add(Military_GetNeutralMilitaryPointAt(s_selfplayer, j), -1) end
	-- a point is in the lists of several players of a team: one entry per place
	local uniq, seen = {}, {}
	for _, e in ipairs(pts) do if not seen[e.key] then seen[e.key] = true; table.insert(uniq, e) end end
	P.pts, P.ehq, P.pts_t = uniq, hqs, now
end

-- ---- strength ------------------------------------------------------------------------------------------------------------
-- Not the sum of health (R25): a group is worth sqrt(its health x its damage per second against what it faces).
-- The damage comes from the data row (per armour class of the target), scaled by the models alive; 'mix' = the shares of
-- the opponent's health by armour class { inf, hinf, veh }. A blueprint without a row deals NoDataDps x its full health.
function P.mix_of(list)
	local m, sum = { inf = 0, hinf = 0, veh = 0 }, 0
	for _, u in ipairs(list) do
		local arm = (u.d and u.d.arm) or (u.veh and "veh" or "inf")
		local c = (arm == "veh" or arm == "bld") and "veh" or ((arm == "hinf" or arm == "shinf") and "hinf" or "inf")
		m[c] = m[c] + u.hpabs; sum = sum + u.hpabs
	end
	if sum <= 0 then return { inf = 1, hinf = 0, veh = 0 } end
	m.inf, m.hinf, m.veh = m.inf / sum, m.hinf / sum, m.veh / sum
	return m
end
function P.dps_of(u, mix)
	local d = u.d
	if d == nil then return u.hmax * Brain.num("NoDataDps", 0.1) end
	local k = u.n / math.max(d.n, 1)
	if k > 1.3 then k = 1.3 end
	return k * (mix.inf * d.dI + mix.hinf * d.dH + mix.veh * d.dV)
end
function P.strength(list, mix)
	local hp, dps = 0, 0
	for _, u in ipairs(list) do hp = hp + u.hpabs; dps = dps + P.dps_of(u, mix) end
	return math.sqrt(hp * math.max(dps, 0.01)), hp
end

-- ---- health history: what each side lost in the last seconds -----------------------------------------------------
local function note_hist(W)
	local now, keep = W.now, {}
	local function note(u, side)
		local h = P.hist[u.id] or { side = side, s = {} }
		table.insert(h.s, { t = now, hp = u.hpabs })
		while table.getn(h.s) > 0 and now - h.s[1].t > 14 do table.remove(h.s, 1) end
		h.x, h.z, h.last, h.gone = u.x, u.z, now, nil
		keep[u.id] = h
	end
	for _, u in ipairs(W.army) do note(u, 1) end
	for _, e in ipairs(W.en) do note(e, 2) end
	-- a squad that is not there any more: ours = lost; the enemy's = lost only if it was nearly dead when last seen
	-- (it may simply have walked into the fog). Its last health counts as a loss for the window.
	for _, id in ipairs(Brain.keys(P.hist)) do
		local h = P.hist[id]
		if keep[id] == nil and now - (h.last or now) <= 12 then
			local last = h.s[table.getn(h.s)]
			if h.gone == nil then
				local dead = (h.side == 1 and W.by_id[id] == nil) or (h.side == 2 and last ~= nil and last.hp <= Brain.num("GoneDeadHp", 120))
				h.gone = dead and (last and last.hp or 0) or 0
			end
			keep[id] = h
		end
	end
	P.hist = keep
	P.hist_ids = Brain.keys(keep)                                       -- (the sums of P.loss go in this order: a float sum must not depend on pairs())
end
-- health lost by the side (1 ours / 2 the enemy) within r of x z during the last 'secs'
function P.loss(side, x, z, r, secs, now)
	local sum = 0
	for _, id in ipairs(P.hist_ids or {}) do
		local h = P.hist[id]
		if h.side == side and h.x ~= nil and d2(h.x, h.z, x, z) <= r then
			local first
			for _, s in ipairs(h.s) do if now - s.t <= secs then first = s; break end end
			local last = h.s[table.getn(h.s)]
			if first ~= nil and last ~= nil and first.hp > last.hp then sum = sum + (first.hp - last.hp) end
			if h.gone ~= nil and now - h.last <= secs then sum = sum + h.gone end
		end
	end
	return sum
end

-- ---- fights --------------------------------------------------------------------------------------------------------------
-- A fight = a clump of visible enemy squads (ClumpR) and the squads of our army that are IN it (each of ours in one fight).
-- Who is in (step 2, bench 13.11: the list jumped 1-4 squads from second to second and the verdict with it):
--   in  - within EngageR (45 m) of an enemy squad of the clump;
--   out - only beyond LeaveR (60 m) of every enemy squad of the fight it was in. In between it stays where it was.
--   A squad that is in a fight stays in THAT fight while it is within LeaveR of it, even when another clump is nearer.
-- The fight itself is remembered for FightKeepSecs after the last tick it had one of ours (the enemy stepped into the fog
-- for a second, our squad was knocked out of the circle): the same key, age, verdict when it is back.
-- A squad with a capture job (55_capture.ai) goes on with it (step 3; bench 13.11: a capturer 80 m from a fight we were
-- winning 1.5 : 1 was pulled in as support, its job dropped, given again): it is IN a fight only when it is shot at or
-- the enemy is within CapFightR (25 m); within SupportR it is listed apart (capsup) and its strength is not in s_all -
-- the army module calls it only into a fight that is lost without it and even with it (s_allc).
-- The fight's AGE counts from first contact (step 3): the first tick one of ours in it, or one of its enemy squads, is
-- under fire (Squad_IsUnderAttack) - not from the tick the clump came within EngageR, and not from the brain's first tick.
-- Before contact the age is 0; seen_age is the old measure. keep.tc_first = the fight was already on when the brain took
-- over (its true start is not known: the age is a lower bound).
-- F = { key, x, z (the enemy's centre), en, ours, support (ours within SupportR, in no fight, no capture job), capsup,
--   s_ours, s_en, s_all, s_allc, ratio (ours : enemy), ratio_all (with support), loss_ours, loss_en (10 s), age, seen_age, t0,
--   keep (a table of numbers the army module carries from tick to tick), ids (the squads in it: "id id id") }
-- A clump with none of ours in it is W.threats (seen, not fought). The same fight is recognised next tick by its place.
P.member = {}
local CARRY = { "t0", "key", "verdict", "verdict_t", "pending", "pending_n", "rs", "ras", "rcs", "keep" }
local function fights(W)
	local now = W.now
	local clump_r, engage_r, support_r = Brain.num("ClumpR", 35), Brain.num("EngageR", 45), Brain.num("SupportR", 80)
	local leave_r = math.max(Brain.num("LeaveR", 60), engage_r)
	local cl = {}
	-- The ENEMY's side of a fight has a memory too (step 3; bench lib3, r38_ork_005074_3m33: the clump of one fight went
	-- 1 -> 3 -> 1 squads within two seconds as two enemy groups passed ClumpR of each other, the verdict PRESS, HOLD,
	-- PRESS): an enemy squad that was in a fight stays in it while it is within ClumpOutR (50 m) of where that fight
	-- was; only the others are clumped by ClumpR. Brain_ClumpKeep=0: off.
	local placed, seeds = {}, {}
	if Brain.num("ClumpKeep", 1) >= 1 then
		local out_r, pk = Brain.num("ClumpOutR", 50), {}
		for _, q in ipairs(P.fprev) do pk[q.key] = q end
		for _, e in ipairs(W.en) do
			local q = pk[(P.emember or {})[e.id] or ""]
			if q ~= nil and d2(e.x, e.z, q.x, q.z) <= out_r then
				local c = seeds[q.key]
				if c == nil then c = { x = 0, z = 0, en = {}, ours = {}, support = {}, capsup = {}, seed = q }; seeds[q.key] = c; table.insert(cl, c) end
				table.insert(c.en, e); placed[e.id] = true
			end
		end
		for _, c in ipairs(cl) do
			local sx, sz, k = 0, 0, table.getn(c.en)
			for _, m in ipairs(c.en) do sx = sx + m.x; sz = sz + m.z end
			c.x, c.z = sx / k, sz / k
		end
	end
	for _, e in ipairs(W.en) do
	if not placed[e.id] then
		local best, bd
		for _, c in ipairs(cl) do
			local d = d2(e.x, e.z, c.x, c.z)
			if d <= clump_r and (bd == nil or d < bd) then best, bd = c, d end
		end
		if best == nil then best = { x = 0, z = 0, en = {}, ours = {}, support = {}, capsup = {} }; table.insert(cl, best) end
		table.insert(best.en, e)
		local sx, sz, k = 0, 0, table.getn(best.en)
		for _, m in ipairs(best.en) do sx = sx + m.x; sz = sz + m.z end
		best.x, best.z = sx / k, sz / k
	end
	end
	-- which fight of the last ticks is this clump? (the nearest within FightSameR; one clump per remembered fight) - known
	-- BEFORE the squads are counted, so that a squad can stay in its fight
	local prev, used = P.fprev, {}
	for _, c in ipairs(cl) do if c.seed ~= nil then used[c.seed.key] = true; c.prev = c.seed; c.seed = nil end end
	for _, c in ipairs(cl) do
	if c.prev == nil then
		local pb, pd
		for _, q in ipairs(prev) do
			if not used[q.key] then
				local d = d2(q.x, q.z, c.x, c.z)
				if d <= Brain.num("FightSameR", 30) and (pd == nil or d < pd) then pb, pd = q, d end
			end
		end
		if pb ~= nil then used[pb.key] = true; c.prev = pb end
	end
	end
	local mem = P.member
	local jobs = (Brain.capture ~= nil and Brain.num("CapKeep", 1) >= 1) and Brain.capture.jobs or {}
	local cap_r = math.min(Brain.num("CapFightR", 25), engage_r)
	for _, u in ipairs(W.army) do
		local bc, bd, ed, sc, sd, fc, fd
		local was = mem[u.id]
		local in_r = (jobs[u.id] ~= nil and not u.hit) and cap_r or engage_r
		for _, c in ipairs(cl) do
			local mine = (was ~= nil and c.prev ~= nil and c.prev.key == was)
			for _, e in ipairs(c.en) do
				local d = d2(u.x, u.z, e.x, e.z)
				if ed == nil or d < ed then ed = d end
				if d <= in_r and (bd == nil or d < bd) then bc, bd = c, d end
				if d <= engage_r and (fd == nil or d < fd) then fc, fd = c, d end
				if mine and d <= leave_r and (sd == nil or d < sd) then sc, sd = c, d end
			end
		end
		u.ed = ed
		u.contact = (bc ~= nil) or u.hit
		if sc ~= nil then bc = sc end                                    -- it stays in its fight
		if bc ~= nil and not u.retreating then table.insert(bc.ours, u); u.fight = bc end   -- (a squad that is running home is not our strength there)
		if bc == nil and fc ~= nil and not u.retreating then u.near_clump = fc end
	end
	-- a capturer and an enemy GROUP that nobody of ours is fighting, within EngageR: that is its own trouble, not a fight
	-- of others it is kept out of - it is in (the loner rule of the army module walks it back before it is shot at)
	for _, u in ipairs(W.army) do
		local c = u.near_clump
		if c ~= nil and u.fight == nil and table.getn(c.ours) == 0 and table.getn(c.en) >= Brain.num("LonerEnemy", 2) then
			table.insert(c.ours, u); u.fight = c
		end
		u.near_clump = nil
	end
	local nextp, mem_next, emem_next = {}, {}, {}
	for _, c in ipairs(cl) do
		local pb = c.prev
		c.prev = nil
		if table.getn(c.ours) > 0 then
			for _, u in ipairs(W.army) do
				if u.fight == nil and not u.retreating and d2(u.x, u.z, c.x, c.z) <= support_r then
					if jobs[u.id] ~= nil then table.insert(c.capsup, u) else table.insert(c.support, u) end
				end
			end
			local mix_en, mix_us = P.mix_of(c.en), P.mix_of(c.ours)
			c.s_ours = P.strength(c.ours, mix_en)
			c.s_en = P.strength(c.en, mix_us)
			local all = {}
			for _, u in ipairs(c.ours) do table.insert(all, u) end
			for _, u in ipairs(c.support) do table.insert(all, u) end
			c.s_all = P.strength(all, mix_en)
			if table.getn(c.capsup) > 0 then
				for _, u in ipairs(c.capsup) do table.insert(all, u) end
				c.s_allc = P.strength(all, mix_en)
			else c.s_allc = c.s_all end
			c.ratio = c.s_ours / math.max(c.s_en, 1)
			c.ratio_all = c.s_all / math.max(c.s_en, 1)
			c.loss_ours = P.loss(1, c.x, c.z, engage_r + 15, 10, now)
			c.loss_en = P.loss(2, c.x, c.z, clump_r + 15, 10, now)
			if pb ~= nil then for _, f in ipairs(CARRY) do c[f] = pb[f] end
			else P.fseq = (P.fseq or 0) + 1; c.t0, c.key, c.keep = now, "F" .. P.fseq, {} end
			if c.keep == nil then c.keep = {} end
			local kp = c.keep
			if kp.tc == nil then
				local hot = false
				for _, u in ipairs(c.ours) do if u.hit then hot = true; break end end
				if not hot then for _, e in ipairs(c.en) do if e.hit then hot = true; break end end end
				if hot then kp.tc = now; kp.tc_first = (P.t_first == now) end
			end
			c.seen_age, c.last = now - c.t0, now
			if Brain.num("FightAgeContact", 1) >= 1 then c.age = (kp.tc ~= nil) and (now - kp.tc) or 0 else c.age = c.seen_age end
			local ids = {}
			for _, u in ipairs(c.ours) do mem_next[u.id] = c.key; table.insert(ids, u.id) end
			for _, e in ipairs(c.en) do emem_next[e.id] = c.key end
			table.sort(ids)
			c.ids = table.concat(ids, " ")
			table.insert(W.fights, c)
			table.insert(nextp, c)
		else
			table.insert(W.threats, c)
			-- a fight of the last ticks with none of ours in it now: remembered for a while, at the clump's new place
			if pb ~= nil and now - (pb.last or now) <= Brain.num("FightKeepSecs", 4) then
				local q = { x = c.x, z = c.z, last = pb.last }
				for _, f in ipairs(CARRY) do q[f] = pb[f] end
				table.insert(nextp, q)
			end
		end
	end
	-- a remembered fight whose clump is not seen at all this tick
	for _, q in ipairs(prev) do
		if not used[q.key] and now - (q.last or now) <= Brain.num("FightKeepSecs", 4) then
			local r = { x = q.x, z = q.z, last = q.last }
			for _, f in ipairs(CARRY) do r[f] = q[f] end
			table.insert(nextp, r)
		end
	end
	P.emember = emem_next
	P.fprev, P.member = nextp, mem_next          -- (tables of numbers and of this tick's unit entries: no engine object inside)
end
-- (the army module writes verdict / verdict_t / pending / rs / ras and F.keep on F: the same table P.fprev holds, so the next tick's fight carries them)

-- ---- the tick ------------------------------------------------------------------------------------------------------------
function P.update(now)
	local W = { now = now, own = {}, army = {}, by_id = {}, en = {}, ghosts = {}, fights = {}, threats = {}, home = P.home() }
	P.t_first = P.t_first or now
	scan_own(W)
	scan_enemies(W)
	W.turrets = scan_turrets(W)
	if P.pts == nil or now - (P.pts_t or -100) >= Brain.num("PointSecs", 3) then scan_points(now) end
	W.pts, W.ehq = P.pts or {}, P.ehq or {}
	W.vp = { ours = 0, enemy = 0, neutral = 0 }
	for _, p in ipairs(W.pts) do
		if p.vp then
			if p.ours then W.vp.ours = W.vp.ours + 1 elseif p.enemy then W.vp.enemy = W.vp.enemy + 1 else W.vp.neutral = W.vp.neutral + 1 end
		end
	end
	-- the score of the race: the tickets each side has LEFT (Relic's cache.ai keeps them fresh). Step 5, bench lib6 (three
	-- games against a live computer, all three lost on tickets): the first number is OUR tickets - it fell 443 -> 13 while
	-- the enemy held all three points ('vp 0/3/0 tickets 13:384 not behind') and stood at 500 while we held one and the enemy
	-- none ('vp 1/0/2 tickets 500:488 behind'). The flag was upside down since step 1. Behind = we have fewer tickets left;
	-- without the numbers - fewer victory points held. Losing = the enemy holds more of them now (our tickets run).
	W.vp.losing = (W.vp.ours < W.vp.enemy)
	if type(cache) == "table" and type(cache.self_vp_tickers) == "number" and type(cache.enemy_vp_tickers) == "number" and (cache.vp_total or 0) > 0 then
		W.vp.t_ours, W.vp.t_enemy = cache.self_vp_tickers, cache.enemy_vp_tickers
		if Brain.num("VpBehindFix", 1) >= 1 then W.vp.behind = (W.vp.t_ours < W.vp.t_enemy) or (W.vp.t_enemy == W.vp.t_ours and W.vp.ours < W.vp.enemy)
		else W.vp.behind = (W.vp.t_enemy < W.vp.t_ours) or (W.vp.t_enemy == W.vp.t_ours and W.vp.ours < W.vp.enemy) end
	else
		W.vp.behind = (W.vp.ours < W.vp.enemy)
	end
	note_hist(W)
	fights(W)
	Brain.W = W
	Brain.every("see_w", Brain.num("WorldLogSecs", 10), function()
		Brain.log("W", "own", table.getn(W.own), "army", table.getn(W.army), "en", table.getn(W.en), "ghosts", table.getn(W.ghosts),
			"fights", table.getn(W.fights), "threats", table.getn(W.threats),
			"vp", W.vp.ours .. "/" .. W.vp.enemy .. "/" .. W.vp.neutral, "orders", Brain.st.orders, "skipped", Brain.st.skipped)
	end)
	return W
end

	end
	eliteai_brain_10_perception()
end

-- ===== EliteAI brain/20_plan.ai =====
do
	local function eliteai_brain_20_plan()
-- BRAIN 20_plan: the strategic plan - where the army's fist goes and why (the victory point race, the map).
-- Owns: R10, R11, R13, R14, R16 (and R26 tech timing, R53/R54 with 85_endgame - later stages).
-- In:  W (points and their owners, the fights, the fist's centre from the army module).
-- Out: Brain.plan.objective = { kind = "fight" | "take" | "guard" | "home", key, x, y, z, why } - the army marches there.
-- Cadence: every PlanSecs (5 s); an objective is kept for at least ObjHoldSecs unless it is done or gone.
-- Log: 'BR PLAN <t> objective <KIND> <key> at X Z why <reason> score S vp o/e/n'.
--
-- First slice: one objective for the whole fist. A fight of ours that we hold comes first (everybody goes where the fight
-- is); else the point worth most per metre of the way - a victory point before a power point before a requisition point,
-- an enemy's victory point first while we hold fewer of them than the enemy (R14); nothing to take - stand at our point
-- nearest to the enemy. The enemy HQ is never an objective. Later stages: the score of the VP race, tech and economy goals.

Brain.plan = {}
local L = Brain.plan
local d2 = Brain.d2

local function point_score(p, cx, cz, W)
	if p.ours then return nil end
	-- R12 / R16: a point one of ours is already capturing is taken care of - the fist goes on to the next one
	if Brain.capture ~= nil and Brain.capture.covered(p.key) then return nil end
	local worth = (p.vp and Brain.num("ObjVP", 3)) or (p.pow and Brain.num("ObjPow", 2)) or Brain.num("ObjReq", 1)
	if p.vp and p.enemy and (W.vp.behind or W.vp.losing) then worth = worth * Brain.num("ObjBehindK", 1.5) end   -- R14: behind in the race
	if p.enemy_cap or p.enemy then worth = worth * 1.0 else worth = worth * Brain.num("ObjNeutralK", 1.2) end -- a free point is cheap to take
	-- Step 6: no power point is ours and the power income is the HQ's own (30_economy.ai: crisis) - a power point is worth
	-- more than a victory point until one is ours again (Orca's match 2: ten minutes without one, 'потеряв гены - поплыл')
	local E = Brain.economy
	local crisis = (E ~= nil and E.crisis and (E.pow_pts or 0) == 0)
	if p.pow and crisis then worth = worth * Brain.num("ObjPowCrisisK", 4) end
	-- Step 6 (the race, R14): behind on tickets while the enemy holds more victory points than we do - the fist's objective
	-- is a victory point, not the requisition point next door (bench s6_l8_0, 24 games: 100 of 972 TAKE objectives in that
	-- state were power / requisition points; the side captures of 55_capture.ai go on). Not in a power crisis.
	if not p.vp and not crisis and W.vp.behind and W.vp.losing then worth = worth * Brain.num("ObjRaceK", 0.4) end
	-- Step 6: burnt ground (50_army.ai: a place where we lost four times what the enemy lost - a nest of set-up teams or
	-- turrets) is not the next objective while another point is to be had
	if Brain.army ~= nil and Brain.army.zone_at ~= nil then
		local z = Brain.army.zone_at(p.x, p.z)
		-- (step 7, the turret scenes from people's replays - test/scenes7, t7_tur_afeb88_9m10: an IG player put a turret 16 m
		-- from a victory point, the fist went on marching to that point and spent 27 % of its squad-seconds inside the
		-- turret's circle with nothing that could break it. A point inside the circle of a turret that stands is no
		-- objective until a machine or a squad whose trade is armour stands with the army - Brain_ObjTurret=0: only x ObjZoneK)
		if z ~= nil and z.turret ~= nil and not Brain.army.can_siege and Brain.num("ObjTurret", 1) >= 1 then return nil end
		if z ~= nil then worth = worth * Brain.num("ObjZoneK", 0.2) end
	end
	-- Step 7: THE PUSH (L.push below) - the fist goes for the enemy's victory point, the small points are the capturers'
	if L.push ~= nil then
		if p.vp and p.enemy then worth = worth * Brain.num("PushVpK", 1.5) elseif not p.vp and not crisis then worth = worth * Brain.num("PushOtherK", 0.4) end
	end
	for _, h in ipairs(W.ehq) do                                                                            -- R15: not under the enemy's base
		if d2(p.x, p.z, h.x, h.z) <= Brain.num("ObjHqR", 55) then return nil end
	end
	return worth / (Brain.num("ObjDist0", 40) + d2(p.x, p.z, cx, cz))
end

-- Does this fight pull the whole fist? Step 5 (bench lib6, three games against a live computer lost on tickets with
-- 'vp 0/3/0'): any fight we pressed or held anywhere on the map was the objective, the fist walked from one skirmish of a
-- capturer to the next across the map (objective FIGHT at -95 -66, then 74 -84, then 17 -60 within a minute) and no
-- capture job starts while the objective is a fight - the victory points stayed the enemy's all game. Now a fight is the
-- fist's objective only when it is near the fist (PlanFightR 60), at a victory point (PlanFightVpR 40), at home
-- (PlanFightHomeR 70), or - while we are not losing the race - when half of the army is in it already. The other fights
-- are left to the squads that are in them (their verdicts, their support). PlanFightRule=0: any fight, as before.
local function fight_pulls(F, c, W)
	if Brain.num("PlanFightRule", 1) < 1 then return true end
	if Brain.capture ~= nil and Brain.capture.clash ~= nil and Brain.capture.clash.key == F.key then return true end   -- the first clash calls everybody
	-- Step 7 (the race: 'do not lose on tickets while winning fights'): the enemy holds more victory points, we are behind
	-- and RaceAlarmTickets (150) or fewer are left - only a fight at a victory point or at home is the fist's business
	local alarm = (W.vp.losing and W.vp.behind and (W.vp.t_ours or 500) <= Brain.num("RaceAlarmTickets", 150))
	if not alarm and d2(F.x, F.z, c.x, c.z) <= Brain.num("PlanFightR", 60) then return true end
	if W.home ~= nil and d2(F.x, F.z, W.home.x, W.home.z) <= Brain.num("PlanFightHomeR", 70) then return true end
	for _, p in ipairs(W.pts) do
		if p.vp and d2(F.x, F.z, p.x, p.z) <= Brain.num("PlanFightVpR", 40) then return true end
	end
	if not W.vp.losing and table.getn(F.ours) * 2 >= table.getn(W.army) then return true end
	return false
end

-- Step 7: THE PUSH. The late game of step 6 had no plan of its own: after the 15th minute the fist went on taking the
-- nearest point worth most per metre, two squads captured at the sides, the set-up team stood at its post - the enemy's
-- victory point was one objective among many. People who are even or ahead by the 12th-14th minute gather everything and
-- go for the enemy's victory point. From PushSecs (780 s) on, while we are not behind on tickets by more than
-- PushBehindOk (40) and PushArmy (5) squads of the army are fit (not on the way home, models x health 0.5+), the plan is a
-- PUSH: the enemy's victory points are worth PushVpK x, the other points PushOtherK x (20_plan), one side capture
-- instead of two (55_capture.ai), the set-up team walks with the fist (50_army.ai), the fist stages with
-- StageFracPush (0.8) of its squads, and the Waaagh goes into the push's fight (70_abilities.ai). It ends when fewer
-- than PushStopArmy (3) fit squads are left - then not again for PushRestSecs (60 s). Brain_Push=0: off.
-- Log: 'BR PLAN <t> PUSH START|END why ...'.
function L.push_update(W)
	local now = W.now
	if Brain.num("Push", 1) < 1 then L.push = nil; return end
	local fit = 0
	for _, u in ipairs(W.army) do
		if not u.retreating and (u.eff or 0) >= Brain.num("PushFitEff", 0.5) then fit = fit + 1 end
	end
	local to, te = W.vp.t_ours or 500, W.vp.t_enemy or 500
	if L.push ~= nil then
		local why
		if fit < Brain.num("PushStopArmy", 3) then why = "only " .. fit .. " fit squads are left"
		elseif to < te - 2 * Brain.num("PushBehindOk", 40) then why = "behind on tickets " .. to .. ":" .. te .. " - the race rules take over" end
		if why ~= nil then
			Brain.log("PLAN", "PUSH", "END", "why", why, "lasted", Brain.f0(now - L.push.t0), "s", "tickets", to .. ":" .. te, "vp", W.vp.ours .. "/" .. W.vp.enemy .. "/" .. W.vp.neutral)
			L.push, L.push_end = nil, now
		end
		return
	end
	if now < Brain.num("PushSecs", 780) or now - (L.push_end or -1000) < Brain.num("PushRestSecs", 60) then return end
	if fit >= Brain.num("PushArmy", 5) and to >= te - Brain.num("PushBehindOk", 40) then
		L.push = { t0 = now }
		L.push_n = (L.push_n or 0) + 1
		Brain.log("PLAN", "PUSH", "START", "why", (to > te and "ahead" or "even") .. " on tickets " .. to .. ":" .. te .. " with " .. fit .. " fit squads of " .. table.getn(W.army) ..
			": everything to the enemy's victory point", "vp", W.vp.ours .. "/" .. W.vp.enemy .. "/" .. W.vp.neutral, "n", L.push_n)
	end
end

function L.update(W)
	local now = W.now
	local A = Brain.army
	local c = (A and A.centre) or W.home
	if c == nil then return end
	L.push_update(W)
	local cur = L.objective
	local pick
	-- 1. a fight we are holding or winning: the fist goes there
	local bf
	for _, F in ipairs(W.fights) do
		if (F.verdict == "press" or F.verdict == "hold") then
			if fight_pulls(F, c, W) then
				if bf == nil or F.s_en > bf.s_en then bf = F end
			else
				Brain.say("PLAN", "fight_left|" .. F.key, 30, { "fight", F.key, "LEFT to its squads", "why", "far from the fist (" .. Brain.f0(d2(F.x, F.z, c.x, c.z)) .. " m), not at a victory point, not at home",
					"ours", table.getn(F.ours), "of", table.getn(W.army), W.vp.losing and "the race is being lost" or "-" }, F.key)
			end
		end
	end
	if bf ~= nil then
		pick = { kind = "fight", key = bf.key, x = bf.x, y = c.y or 0, z = bf.z, why = "our fight " .. bf.verdict, score = bf.ratio }
	else
		-- 2. the best point to take
		local bp, bs
		for _, p in ipairs(W.pts) do
			local s = point_score(p, c.x, c.z, W)
			if s ~= nil and (bs == nil or s > bs) then bp, bs = p, s end
		end
		if bp ~= nil then
			pick = { kind = "take", key = bp.key, x = bp.x, y = bp.y, z = bp.z, score = bs,
				why = (bp.vp and "victory point" or (bp.pow and "power point" or "requisition point")) .. (bp.enemy and " of the enemy" or " free") }
		else
			-- 3. guard: our point nearest to an enemy HQ (the front); none - home
			local gp, gd
			for _, p in ipairs(W.pts) do
				if p.ours then
					for _, h in ipairs(W.ehq) do
						local d = d2(p.x, p.z, h.x, h.z)
						if gd == nil or d < gd then gp, gd = p, d end
					end
				end
			end
			if gp ~= nil then pick = { kind = "guard", key = gp.key, x = gp.x, y = gp.y, z = gp.z, why = "nothing to take: our front point", score = 0 }
			elseif W.home ~= nil then pick = { kind = "home", key = "home", x = W.home.x, y = W.home.y, z = W.home.z, why = "no points known", score = 0 } end
		end
	end
	if pick == nil then return end
	-- keep the current objective while it is still valid and young (no hopping between two points of the same worth)
	if cur ~= nil and cur.key ~= pick.key and pick.kind ~= "fight" and cur.kind == "take" and now - cur.t < Brain.num("ObjHoldSecs", 20) then
		for _, p in ipairs(W.pts) do
			if p.key == cur.key and not p.ours and not (Brain.capture ~= nil and Brain.capture.covered(p.key)) then return end
		end
	end
	if cur == nil or cur.key ~= pick.key or cur.kind ~= pick.kind then pick.t = now else pick.t = cur.t end
	L.objective = pick
	local UP = { fight = "FIGHT", take = "TAKE", guard = "GUARD", home = "HOME" }   -- (string.upper does nothing in the game's AI Lua)
	Brain.say("PLAN", "objective", 30, { "objective", UP[pick.kind], pick.key, "at", Brain.f0(pick.x), Brain.f0(pick.z), "why", pick.why,
		"score", Brain.f2(pick.score), "vp", W.vp.ours .. "/" .. W.vp.enemy .. "/" .. W.vp.neutral,
		"tickets", tostring(W.vp.t_ours) .. ":" .. tostring(W.vp.t_enemy), W.vp.behind and "behind" or "not behind" })
end

	end
	eliteai_brain_20_plan()
end

-- ===== EliteAI brain/30_economy.ai =====
do
	local function eliteai_brain_30_economy()
-- BRAIN 30_economy: income and spending - what is bought, when, and what the money waits for.
-- Owns: R18, R19, R22, R23 (and R26-R28 tech timing together with the plan).
-- In:  W; the engine's resource plumbing (cache.resources / cache.resources_rate, AIProduction_*, AIResource_*), the race
--      profile's economy plan (60_roles.ai 'econ': the people's times from replays), the composition module's choice.
-- Out: requests through Relic's production plumbing (the engine builds, queues, pays):
--        Request_Production(.., PITEM_Spawn, pbg) a squad;  (.., PITEM_SquadReinforce, pbg) one more model;
--        Request_Production(.., PITEM_Upgrade, pbg) the tier;  Request_AISquadProduction(aisq, .., PITEM_SquadUpgrade, pbg)
--        wargear of the hero / an upgrade of a squad;  Request_Secure the post on a point;  Request_Generator;
--        Request_Resurrection the fallen hero.
-- Cadence: 1 s (one look at the purse; at most MaxBuys requests a tick).
-- Log: 'BR ECON <t> BUY <kind> <what> cost R/P why <reason> bank R/P'  - a request went to the engine;
--      'BR ECON <t> KEEP <what> cost R/P why <reason> bank R/P'        - the money waits for it (the cheaper wishes below
--                                                                       it may spend only what is left above its price);
--      'BR ECON <t> STATE ...' once a minute: what was bought so far (the scene's sums are read from the last one).
--
-- STAGE (step 4, orks): migrated. Brain.LEGACY.purchases / buildorder are off while this module is on (Brain_Econ=1, the
-- default; 0 = Relic's purchase scripts as in step 3). The purse is ONE list of wishes in the order of importance:
--   the fallen hero > one more model for a squad the engine can refill > the opening squads > the first post > the tier
--   when its time has come > generators by the clock > the next squad by the clock > the hero's wargear by the clock >
--   an upgrade of a squad by the clock > more posts > money lying idle (one squad above the clock).
-- The clock is the people's (human_baseline_1113, orks): squads above the starters 2 at once, the 3rd by 2:30, the 4th
-- after T2, the 5th after T3; generators 1 / 2 / 3 by 2:00 / 3:00 / 7:00; T2 clicked at 6:40, T3 at 13:20; the hero's
-- wargear 1 / 2 / 3 pieces by 1:50 / 4:00 / 9:00; an upgrade of a squad every ~110 s from 1:15 on.
-- The coordinator's note (13.11): where a choice is disputed, the old AI's variant C is the default - the tier before the
-- army once two squads stand (TechVsArmy 3), reinforcing never waits for savings (ReinforceVsSave 3), an upgrade does not
-- wait for the next unit (AddonVsUnit 3).
Brain.economy = {}
local E = Brain.economy
E.n = { unit = 0, veh = 0, gen = 0, post = 0, tier = 0, gear = 0, upg = 0, reinf = 0, revive = 0 }
E.pending, E.gear, E.upg, E.order_log = {}, {}, {}, {}
E.t_unit, E.t_tier, E.t_float, E.hold = -1000, {}, -1000, nil
E.spent = {}                                       -- { t, req } of every request of the last seconds (70_abilities.ai: the global's price after them)
E.build = { gen = { fails = 0, placed = {} }, post = { fails = 0, placed = {} } }   -- building requests: the watch, the failures in a row, what was placed
-- the requisition asked for since the game second t0 (the engine charges it within a second or two; elite.scar's purse lags)
function E.spent_since(t0)
	local sum = 0
	for _, e in ipairs(E.spent) do if e.t >= t0 then sum = sum + e.req end end
	return sum
end

local NEED = { "AIProduction_GetBuildableSquadCount", "AIProduction_GetBuildableSquadAt", "AIProduction_CanProduce", "AIProduction_CanProduceNow",
	"AIPlayer_GetProductionCost", "AIPlayer_GetStructureCost", "Request_Production", "Request_AISquadProduction", "Request_Secure", "Request_Generator",
	"Request_Resurrection", "AIProduction_GetProductionItemCount", "AIProduction_GetProductionItemAt", "AIProduction_CanAISquadProduce",
	"AIProduction_CanAISquadProduceNow", "Task_CountAISquadProduction", "AIProduction_CanNonSquadProduce", "Task_CountActivePBG", "Task_CountPBG",
	"Task_CountProduction", "Task_CountInGroup", "Task_Count", "AIProduction_AnyReinforcementsNeeded", "AIProduction_GetReinforcementSquadCount",
	"AIProduction_GetReinforcementSquadPBGAt", "AIResource_GetNumSecuredCapturePoints", "AIResource_GetNumUnconsciousSquads",
	"AIResource_GetUnconsciousSquad", "AIResource_GetResurrectSquadCost", "Construction_CanConstruct", "PBG_GetCount", "PBG_GetName",
	"Military_SquadTotalCount", "Military_GetAISquadAtIndex", "AISquad_ConvertToSimSquad", "AISquad_ConvertToPBG", "Squad_GetGameID" }
local NEEDV = { "PITEM_Spawn", "PITEM_Upgrade", "PITEM_SquadUpgrade", "PITEM_SquadReinforce", "TGROUP_BuildUnits", "TPRIORITY_BuildUnits", "TGROUP_Tech",
	"TPRIORITY_Tech", "TGROUP_AddOns", "TPRIORITY_AddOns", "TGROUP_DefenceSecure", "TPRIORITY_DefenceSecure", "TGROUP_ResourceAddOns", "TPRIORITY_BuildOrder",
	"TGROUP_Resurrect", "s_selfplayer", "s_self_modplayer" }
-- is the module in charge? (the race has a plan, the key is on, every engine function it calls is there - named once if not)
function E.active()
	if E.on ~= nil then return E.on end
	local prof = Brain.roles.profile()
	local G = getfenv and getfenv(0) or {}
	local miss
	for _, k in ipairs(NEED) do if type(G[k]) ~= "function" and miss == nil then miss = k end end
	for _, k in ipairs(NEEDV) do if G[k] == nil and miss == nil then miss = k end end
	if type(cache) ~= "table" or type(UPG) ~= "table" or type(EBP) ~= "table" then miss = miss or "cache / UPG / EBP" end
	E.on = (Brain.num("Econ", 1) >= 1) and prof ~= nil and prof.econ ~= nil and miss == nil
	Brain.log("ECON", "stage", E.on and "brain" or "legacy", "key", Brain.num("Econ", 1), "plan", (prof and prof.econ) and 1 or 0, "missing", miss or "-")
	return E.on
end

local function cost_rp(c) if c == nil then return 0, 0 end return c.requisition or 0, c.power or 0 end
local function rp(r, p) return Brain.f0(r) .. "/" .. Brain.f0(p) end
local function short_pbg(pbg) return Brain.short(Brain.bp_key(PBG_GetName(pbg) or "")) end
-- "upgrade\pvp\race_ork\wargear\wp1_ork_kustom_shoota" -> "wargear/wp1_ork_kustom_shoota" (what the profile's lists name)
local function upg_key(pbg)
	local k = Brain.bp_key(PBG_GetName(pbg) or "")
	local i = string.find(k, "/", 1, true)
	return i and string.sub(k, i + 1) or k
end
-- the step of a clock { t1, t2, ... }: how many of them have passed
local function steps(list, now)
	local n = 0
	for _, t in ipairs(list or {}) do if now >= t then n = n + 1 end end
	return n
end
local function plan_num(key, default)
	local prof = Brain.roles.profile()
	local v = prof and prof.econ and prof.econ[key]
	return Brain.num("Econ" .. key, (type(v) == "number") and v or default)
end

-- ---- the look: numbers only --------------------------------------------------------------------------------------------
-- the tier: 1..3 and whether the next research is queued / running (the first tier upgrade that the HQ can still research
-- or that sits in a task is the one we are at - CalculateCurrentTechLevel of the vanilla base, with the profile's list)
local function tier_look(P)
	local n = table.getn(P.tiers)
	for i = 1, n do
		local pbg = UPG[P.tiers[i]]
		if pbg ~= nil then
			if Task_CountActivePBG(s_selfplayer, pbg, nil) > 0 then return i, true, pbg end
			if AIProduction_CanNonSquadProduce(s_selfplayer, PITEM_Upgrade, pbg) then return i, false, pbg end
		end
	end
	return n + 1, false, nil
end
function E.look(W)
	local P = Brain.roles.profile().econ
	local r, rr = cache.resources, cache.resources_rate or {}
	local S = { now = W.now, req = r.requisition or 0, pow = r.power or 0, ireq = (rr.requisition or 0) / 60, ipow = (rr.power or 0) / 60,
		pop = cache.current_population_personnel or 0, popmax = cache.max_population_personnel or 0, P = P }
	local purse = Brain.purse
	if purse ~= nil and purse.t ~= nil and W.now - purse.t <= 3 then S.req, S.pow, S.red = purse.req, purse.pow, purse.red end   -- the game's own count (elite.scar, mode 13)
	S.tier, S.researching, S.tier_pbg = tier_look(P)
	S.squads, S.hero, S.veh, S.kinds, S.fighting, S.home_fight = 0, nil, 0, {}, 0, false
	for _, u in ipairs(W.own) do
		local hero = (u.d ~= nil and u.d.arm == "cmd") or string.find(u.key or "", "heroes/", 1, true) ~= nil
		if hero then S.hero = u
		elseif u.d == nil or (u.d.pop or 0) > 0 then
			S.squads = S.squads + 1
			S.kinds[u.key] = (S.kinds[u.key] or 0) + 1
			if u.veh then S.veh = S.veh + 1 end
		end
		if u.fight ~= nil then S.fighting = S.fighting + 1; if (u.dhome or 999) < Brain.num("EconHomeFightR", 70) then S.home_fight = true end end
	end
	-- squads asked for and not yet on the field: the oldest request is done when the army is bigger than it was at the
	-- request (one a tick), and is forgotten after PendingSecs (the engine did not start it, or the squad died at once)
	local keep, came = {}, false
	for _, p in ipairs(E.pending) do
		if not came and S.squads > p.had then came = true
		elseif W.now - p.t < Brain.num("EconPendingSecs", 90) then
			if came then p.had = math.max(p.had, S.squads) end
			table.insert(keep, p)
		end
	end
	E.pending = keep
	S.pending = table.getn(E.pending)
	S.posts = AIResource_GetNumSecuredCapturePoints(s_selfplayer) or 0
	S.post_tasks = Task_CountPBG(s_selfplayer, EBP[P.post])
	S.gens_seen = (PBG_GetCount(s_selfplayer, EBP[P.gen]) or 0)
	S.gens = S.gens_seen + (Task_CountActivePBG(s_selfplayer, EBP[P.gen], nil) or 0)
	S.gen_tasks = Task_CountInGroup(s_selfplayer, TGROUP_ResourceAddOns)
	-- where a post can really go: the power points we own (a post is the node of a power point - a requisition point and
	-- a victory point take none; the verifier, 13.11: 'points owned - posts' counted them all and the request for a post
	-- that has no place went out once a minute all game long)
	S.post_sites = cache.total_power_pts_owned or cache.total_pts_owned or 0
	S.gen_room = cache.total_pts_secured_w_addon_capacity or 0
	-- Step 6 (Orca's match 2, 14.11: the power point with the post and the generator was lost at 3:27 and never retaken -
	-- 'gens 0 posts 0 ... income/min 294/10' from 5:00 to the end, 500-850 requisition in the bank, no wargear, tier 2 at
	-- 10:51). POWER CRISIS = the power income is the HQ's own (PowDeadIncome 15 a minute or less) after the opening: the
	-- tier's hour is moot, its power guard is off, nothing waits for it - the brain fights with what the requisition buys
	-- and takes a power point back (20_plan.ai, 55_capture.ai read Brain.economy.crisis).
	S.pow_pts, S.post_threat, S.post_safe = 0, 0, 0
	for _, p in ipairs(W.pts or {}) do
		if p.pow and p.ours then
			S.pow_pts = S.pow_pts + 1
			local near = false
			for _, e in ipairs(W.en or {}) do if Brain.d2(e.x, e.z, p.x, p.z) <= Brain.num("EconPostThreatR", 45) then near = true; break end end
			if near then S.post_threat = S.post_threat + 1 else S.post_safe = S.post_safe + 1 end
		end
	end
	S.crisis = (Brain.num("EconCrisis", 1) >= 1 and W.now >= Brain.num("EconCrisisFrom", 150) and S.ipow * 60 <= Brain.num("EconPowDeadIncome", 15))
	if S.crisis ~= (E.crisis or false) then
		Brain.log("ECON", S.crisis and "CRISIS" or "CRISIS over", "why", "power income", Brain.f0(S.ipow * 60), "a minute, power points ours", S.pow_pts, "posts", S.posts,
			"generators", S.gens_seen, S.crisis and "- the tier waits, no power guard, a power point is the objective" or "- the clock again")
	end
	E.crisis, E.pow_pts = S.crisis, S.pow_pts
	E.build_look(S)
	return S
end

-- ---- building requests: did the engine place it? ------------------------------------------------------------------------
-- Request_Secure / Request_Generator choose the place themselves and say nothing when they find none (the verifier,
-- 13.11: a request that works gives the game's build command within the same second, one that fails gives nothing - and
-- the brain repeated it every 30 / 60 s for the rest of the game: 96 requests, 32 build commands in six scenes).
-- Every request is watched for BuildWatchSecs (4 s): placed = the engine's count of the building / of its tasks / of the
-- secured points rose, or the bank fell by most of the price beyond what the purse itself asked for. Not placed = a
-- failure for THE SITES AS THEY ARE (the engine picks the site, so the count is kept per set of sites: owned power points
-- / posts / posts with room for a generator); the next request waits gap x K^failures (a generator: K 1.5, 120 s at most; a post: K 2,
-- 240 s at most - bench s5_x_a with K 2 and 300 s for both: in two scenes of six the first generator failed three times in
-- a row, the next try was 4 min off and there was no generator at 5:00 where the repeated requests of step 4 had two). A change of
-- the sites or a placed building clears the count.
-- A placed building is counted as standing for BuildSecs (gen 40, post 30) even when the engine's count does not show it
-- yet (bench vf34_x4, x_8e3f50: five generators placed against a plan of three).
-- Log: 'BR ECON <t> BUILD <gen|post> PLACED|FAILED n <failures> sites <sig> seen A > B tasks A > B bank A > B next in S'.
local function build_sig(S, kind)
	if kind == "post" then return S.post_sites .. "/" .. S.posts end
	return S.posts .. "/" .. S.gen_room
end
local function build_count(S, kind) if kind == "post" then return S.posts else return S.gens_seen end end
local function build_tasks(S, kind) if kind == "post" then return S.post_tasks else return S.gen_tasks end end
function E.build_gap(kind)
	local B = E.build[kind]
	local gap = Brain.num(kind == "gen" and "EconGenGapSecs" or "EconPostGapSecs", kind == "gen" and 30 or 60)
	if B.fails > 0 and Brain.num("EconBuildBackoff", 1) >= 1 then gap = math.min(gap * ((kind == "gen" and Brain.num("EconGenBackoffK", 1.5) or Brain.num("EconPostBackoffK", 2)) ^ B.fails), Brain.num("EconBuildBackoffMax", kind == "gen" and 120 or 240)) end
	return gap
end
function E.build_look(S)
	for _, kind in ipairs({ "gen", "post" }) do
		local B = E.build[kind]
		local sig = build_sig(S, kind)
		local w = B.watch
		if w ~= nil then
			local rose = build_count(S, kind) > w.count or build_tasks(S, kind) > w.tasks
			-- (the bank now against the bank at the request less everything the purse asked for since, the request itself aside)
			local paid = (w.bank - (E.spent_since(w.t) - w.spent0 - w.cost)) - S.req >= 0.6 * w.cost
			if rose or (paid and S.now - w.t >= 1) then
				B.watch, B.fails, B.sig = nil, 0, nil
				table.insert(B.placed, S.now)
				Brain.log("ECON", "BUILD", kind, "PLACED", "by", rose and "the engine's count" or "the bank", "sites", sig, "seen", w.count, ">", build_count(S, kind), "tasks", w.tasks, ">", build_tasks(S, kind),
					"bank", Brain.f0(w.bank), ">", Brain.f0(S.req), "after", Brain.f0(S.now - w.t), "s")
			elseif S.now - w.t >= Brain.num("EconBuildWatchSecs", 4) and kind == "gen" and (S.post_threat or 0) > 0 and Brain.num("EconGenThreat", 1) >= 1 then
				-- (step 6; the verifier of step 5: 68 % of the failed generator requests had the enemy within 40 m of our post -
				-- nobody builds under fire; that is no failure of the site, the pause does not grow)
				B.watch = nil
				Brain.log("ECON", "BUILD", kind, "NOT PLACED", "why the enemy is at our post (" .. S.post_threat .. " of " .. S.pow_pts .. " power points): not counted as a failure", "sites", w.sig)
			elseif S.now - w.t >= Brain.num("EconBuildWatchSecs", 4) then
				B.watch, B.fails = nil, B.fails + 1
				B.sig = w.sig
				Brain.log("ECON", "BUILD", kind, "FAILED", "n", B.fails, "sites", w.sig, "seen", w.count, ">", build_count(S, kind), "tasks", w.tasks, ">", build_tasks(S, kind),
					"bank", Brain.f0(w.bank), ">", Brain.f0(S.req), "next in", Brain.f0(E.build_gap(kind)), "s")
			end
		end
		if B.fails > 0 and B.sig ~= nil and B.sig ~= sig then
			Brain.log("ECON", "BUILD", kind, "sites changed", B.sig, ">", sig, ": the", B.fails, "failures are forgotten")
			B.fails, B.sig = 0, nil
		end
		-- what was placed and may not be in the engine's count yet
		local keep, life = {}, Brain.num(kind == "gen" and "EconGenBuildSecs" or "EconPostBuildSecs", kind == "gen" and 40 or 60)
		for _, t in ipairs(B.placed) do if S.now - t < life then table.insert(keep, t) end end
		B.placed = keep
	end
	-- (the engine's count may or may not hold a building under construction: the placed ones only fill the gap up to what
	-- was seen when the first of them was asked for - never counted twice)
	local G = E.build.gen
	S.gens_building = table.getn(G.placed)
	if S.gens_building > 0 and G.seen_at_place ~= nil then S.gens = math.max(S.gens, G.seen_at_place + S.gens_building) end
	if S.gens_building == 0 and G.watch == nil then G.seen_at_place = nil end
	local Q = E.build.post
	S.posts_building = 0
	if table.getn(Q.placed) > 0 and Q.seen_at_place ~= nil then S.posts_building = math.max(Q.seen_at_place + table.getn(Q.placed) - S.posts, 0) end
	if table.getn(Q.placed) == 0 and Q.watch == nil then Q.seen_at_place = nil end
end
local function build_asked(S, kind, cost)
	local B = E.build[kind]
	B.watch = { t = S.now, sig = build_sig(S, kind), count = build_count(S, kind), tasks = build_tasks(S, kind), bank = S.req, cost = cost, spent0 = E.spent_since(S.now) }
	if B.seen_at_place == nil then B.seen_at_place = build_count(S, kind) end
end

-- ---- the purse -----------------------------------------------------------------------------------------------------------
-- One wish: can the bank pay it above what is kept for the wishes before it? yes -> fn() places the request; no and
-- 'wait' -> its price is kept from the wishes below. Returns true when bought.
local function wish(S, kind, what, req, pow, why, wait, fn)
	if S.buys >= Brain.num("EconMaxBuys", 2) then return false end
	if S.req - S.keep_req >= req and S.pow - S.keep_pow >= pow then
		fn()
		S.req, S.pow, S.buys = S.req - req, S.pow - pow, S.buys + 1
		E.n[kind] = (E.n[kind] or 0) + 1
		table.insert(E.order_log, { t = S.now, kind = kind, what = what })
		table.insert(E.spent, { t = S.now, req = req })
		if table.getn(E.spent) > 40 then table.remove(E.spent, 1) end
		Brain.log("ECON", "BUY", kind, what, "cost", rp(req, pow), "why", why, "bank", rp(S.req + req, S.pow + pow), "n", E.n[kind])
		return true
	end
	if wait then
		S.keep_req, S.keep_pow = S.keep_req + req, S.keep_pow + pow
		Brain.say("ECON", "keep|" .. kind, Brain.num("EconKeepLogSecs", 30), { "KEEP", kind, what, "cost", rp(req, pow), "why", why, "bank", rp(S.req, S.pow),
			"income/min", rp(S.ireq * 60, S.ipow * 60) }, kind .. "|" .. what)
	end
	return false
end
-- power is the narrow resource before a tier: a wish that costs power may not take away what the research will need at
-- its hour (the bank + the income until then must still pay it). PowGuardSecs before the hour, and after it until bought.
function E.pow_free(S, pow, gear_n)
	if pow <= 0 or S.next_tier_t == nil then return true end
	if S.crisis then return true end
	-- (step 6, Orca's match 2: 'KEEP gear ... nothing of the list can be bought' was never the reason - the guard was: from
	-- 160 s on no piece passed it, with 70-106 power banked, and the hero had none at 8:02 and none at 13:00. People wear two
	-- pieces by 4:00, before tier 2: the first GearFree (2) pieces do not wait for the tier)
	-- (the first always; the second when it puts the tier off by no more than GearDelaySecs 30 s)
	if gear_n ~= nil and gear_n < Brain.num("EconGearFree", 2) then
		if gear_n == 0 then return true end
		local left2 = math.max(S.next_tier_t - S.now, 0) + Brain.num("EconGearDelaySecs", 30)
		if (S.pow - pow) + S.ipow * left2 >= S.next_tier_pow then return true end
	end
	if S.now < S.next_tier_t - Brain.num("EconPowGuardSecs", 240) then return true end
	local left = math.max(S.next_tier_t - S.now, 0)
	return (S.pow - pow) + S.ipow * left >= S.next_tier_pow
end

-- the engine's list of squad upgrades a squad of ours can take now: { pbg, key, req, pow } (wargear of the hero as well)
local function upgrades_of(aisq)
	local out = {}
	local n = AIProduction_GetProductionItemCount(s_selfplayer, PITEM_SquadUpgrade)
	for i = 0, n - 1 do
		local pbg = AIProduction_GetProductionItemAt(s_selfplayer, PITEM_SquadUpgrade, i)
		if pbg ~= nil and Task_CountPBG(s_selfplayer, pbg) == 0 and AIProduction_CanAISquadProduce(aisq, PITEM_SquadUpgrade, pbg)
			and AIProduction_CanAISquadProduceNow(aisq, PITEM_SquadUpgrade, pbg) then
			local r, p = cost_rp(AIPlayer_GetProductionCost(s_self_modplayer, PITEM_SquadUpgrade, pbg))
			table.insert(out, { pbg = pbg, key = upg_key(pbg), req = r, pow = p })
		end
	end
	return out
end
-- the first of the profile's list (substrings, in the order of preference) that the squad can take and has not been
-- asked for; without a match - nothing (an unknown upgrade is not bought blind)
local function choose(list, prefs, had, slot_of, ok)
	for _, pat in ipairs(prefs or {}) do
		for _, c in ipairs(list) do
			if string.find(c.key, pat, 1, true) ~= nil and not had[c.key] and (slot_of == nil or not had[slot_of(c.key)]) and (ok == nil or ok(pat)) then return c end
		end
	end
	return nil
end
local function gear_slot(key)
	local i = string.find(key, "wargear/", 1, true)
	if i == nil then return "slot?" end
	return "slot:" .. string.sub(key, i + 8, i + 10)                       -- wp1 / arm / acc: one piece a slot
end
local function aisquad_by_id(id)
	for i = 0, Military_SquadTotalCount(s_selfplayer) - 1 do
		local aisq = Military_GetAISquadAtIndex(s_selfplayer, i)
		local sq = aisq and AISquad_ConvertToSimSquad(aisq) or nil
		if sq ~= nil and Squad_GetGameID(sq) == id then return aisq end
	end
	return nil
end

function E.update(W)
	if type(cache) ~= "table" or type(cache.resources) ~= "table" then return end
	if not E.active() then
		local r, rr = cache.resources, cache.resources_rate or {}
		Brain.say("ECON", "bank", Brain.num("BankLogSecs", 30), { "bank", Brain.f0(r.requisition), Brain.f0(r.power), "income", Brain.f1(rr.requisition), Brain.f1(rr.power),
			"pop", tostring(cache.current_population_personnel), "of", tostring(cache.max_population_personnel), "stage legacy" })
		return
	end
	local S = E.look(W)
	local P, now = S.P, W.now
	S.buys, S.keep_req, S.keep_pow = 0, 0, 0
	-- a takeover in mid-game (a bench scene from 5:00): whoever played before is taken to have kept the clock - the pieces
	-- and upgrades due by now are not bought a second time (what the hero wears cannot be read)
	if E.t_start == nil then
		E.t_start = now
		if now > Brain.num("EconOpeningSecs", 90) then
			E.n.gear = steps(P.gear_t, now)
			if now >= P.upg_first then E.n.upg = math.min(1 + math.floor((now - P.upg_first) / P.upg_every), plan_num("upg_max", 10)) end
			Brain.log("ECON", "takeover at", Brain.f0(now), "s: the clock is taken as kept so far - wargear", E.n.gear, "upgrades", E.n.upg)
		end
	end
	-- the next tier: its hour and its price (for the power guard and for the wish itself)
	local tier_t = P.tier_t[S.tier]
	if tier_t ~= nil then tier_t = Brain.num("EconTier" .. (S.tier + 1) .. "Secs", tier_t) end
	if tier_t ~= nil and S.tier_pbg ~= nil and not S.researching then
		S.next_tier_t = tier_t
		S.next_tier_req, S.next_tier_pow = cost_rp(AIPlayer_GetProductionCost(s_self_modplayer, PITEM_Upgrade, S.tier_pbg))
	end

	local want = P.army0 + steps(P.army_t, now)                       -- the squads that should stand by the clock

	-- 1. the fallen hero (people pay for it at the HQ about a minute after it fell)
	if AIResource_GetNumUnconsciousSquads(s_selfplayer) > 0 then
		E.t_down = E.t_down or now
		if Task_Count(s_selfplayer, TGROUP_Resurrect) == 0 and now - E.t_down >= Brain.num("EconReviveSecs", 20) then
			local aisq = AIResource_GetUnconsciousSquad(s_selfplayer)
			if aisq ~= nil then
				local r, p = cost_rp(AIResource_GetResurrectSquadCost(aisq))
				local pbg = AISquad_ConvertToPBG(aisq)
				if pbg ~= nil then
					wish(S, "revive", short_pbg(pbg), r, p, "the hero fell " .. Brain.f0(now - E.t_down) .. " s ago", true, function()
						Request_Resurrection(s_selfplayer, TGROUP_Resurrect, TPRIORITY_BuildUnits + 20, pbg) end)
				end
			end
		end
	else E.t_down = nil end

	-- 2. one more model for a squad the engine can refill now (at the HQ, at a banner): never waits for savings
	-- (step 6, Orca: 'one model a second' - a person clicks the button for every squad at the refill point at once: up to
	-- ReinfBatch (3) requests a tick, one a squad, while fewer than that many are in the works; they are not counted
	-- against MaxBuys)
	local batch = Brain.num("EconReinfBatch", 3)
	if Brain.num("EconReinforce", 1) >= 1 and Task_CountProduction(s_selfplayer, PITEM_SquadReinforce) < batch and AIProduction_AnyReinforcementsNeeded(s_selfplayer) then
		local n = AIProduction_GetReinforcementSquadCount(s_selfplayer)
		local buys0, k = S.buys, 0
		for i = 0, n - 1 do
			local pbg = AIProduction_GetReinforcementSquadPBGAt(s_selfplayer, i)
			-- (step 7: the population the late core waits for is not filled up again with tier 1 models - 8b below)
			local held = false
			if pbg ~= nil and E.pop_hold ~= nil and S.popmax - S.pop < E.pop_hold.pop + Brain.num("EconPopHoldPad", 2) then
				local d = Brain.UNITS[Brain.bp_key(PBG_GetName(pbg) or "")]
				held = (d ~= nil and (d.t or 1) <= 1 and d.arm ~= "cmd")
				if held then E.pop_hold.skipped = (E.pop_hold.skipped or 0) + 1 end
			end
			if pbg ~= nil and k < batch and not held then
				local r, p = cost_rp(AIPlayer_GetProductionCost(s_self_modplayer, PITEM_SquadReinforce, pbg))
				S.buys = 0
				if wish(S, "reinf", short_pbg(pbg), r, p, "a squad at a refill point is short of models (" .. n .. " such)", false, function()
					Request_Production(s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits + 20, PITEM_SquadReinforce, pbg) end) then k = k + 1 else break end
			end
		end
		S.buys = buys0
	end

	-- 3. the fight's global is waiting for its requisition (70_abilities.ai asks: E.hold = { req, t, why }). It is kept from
	-- everything below - NOT from the reinforcing above (the verifier, 13.11: with the hold first a squad at the HQ was not
	-- refilled while a fight was on and the bank was below 200 + a model's price; 'reinforcing never waits for savings')
	if E.hold ~= nil then
		if now - E.hold.t <= Brain.num("EconHoldSecs", 20) then
			S.keep_req = S.keep_req + E.hold.req
			Brain.say("ECON", "keep|global", 30, { "KEEP", "global", E.hold.why, "cost", rp(E.hold.req, 0), "why the fight's global is ready but for the requisition", "bank", rp(S.req, S.pow) }, "global")
		else E.hold = nil end
	end

	-- the squads: how many should stand by the clock, how many do
	local have = S.squads + S.pending
	local opening = (now < Brain.num("EconOpeningSecs", 90) and have < P.army0)         -- (a takeover in mid-game has no opening)
	S.opening = opening
	local function buy_unit(why, wait)
		local pick, cands = Brain.composition.pick(W, S, E)
		if pick == nil then
			Brain.say("ECON", "nounit", 60, { "KEEP", "unit", "-", "why", "nothing the engine can produce fits (" .. cands .. " candidates; population " .. S.pop .. " of " .. S.popmax .. ")" }, "nounit")
			return false
		end
		return wish(S, "unit", Brain.short(pick.key), pick.req, pick.pow, why .. " - " .. pick.why, wait, function()
			Request_Production(s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits, PITEM_Spawn, pick.pbg)
			table.insert(E.pending, { key = pick.key, t = now, had = S.squads })
			if pick.veh then E.n.veh = E.n.veh + 1 end
			if pick.tier == S.tier then E.tier_unit = S.tier end
			E.t_unit = now
			S.pending = S.pending + 1
		end)
	end
	-- 4. the opening squads: at once, nothing before them
	if opening and have < want then buy_unit("the opening: squad " .. (have + 1) .. " of " .. P.army0, true) end

	-- 5. the first post (people: 0:42-0:51, right after the opening squads)
	local function buy_post(why, wait)
		local pbg = EBP[P.post]
		-- (bench s4_a: a post under construction is neither a task nor a secured point - 11 requests in 10 s; one a PostGapSecs)
		-- (step 5: only where a post can go - an owned power point without one; a post just placed counts; a request the
		-- engine did not place is repeated with a growing gap)
		if pbg == nil or S.post_tasks > 0 or E.build.post.watch ~= nil or now - (E.t_post or -1000) < E.build_gap("post")
			or S.post_sites - S.posts - S.posts_building <= 0 or not Construction_CanConstruct(s_selfplayer, pbg) then return false end
		local r, p = cost_rp(AIPlayer_GetStructureCost(s_self_modplayer, pbg))
		return wish(S, "post", short_pbg(pbg), r, p, why .. " (sites " .. S.post_sites .. ", posts " .. S.posts .. ")", wait, function()
			Request_Secure(s_selfplayer, TGROUP_DefenceSecure, TPRIORITY_DefenceSecure, pbg); E.t_post = now; build_asked(S, "post", r) end)
	end
	local posts_want = steps(P.post_t, now)
	if not opening and S.posts + S.post_tasks + S.posts_building < math.min(posts_want, 1) then buy_post("the first post by the clock (" .. Brain.f0(P.post_t[1]) .. " s)", true) end

	-- 6. the tier at its hour. Disputed with the army (TechVsArmy): rule 3 = the research first once two squads stand and
	-- no fight is on at home; EconTechRule=1: only with the army the clock asks for.
	-- (idle money and a full army bring the hour forward, inside the people's own spread: T2 6:01-7:34, T3 11:53-15:16)
	if S.next_tier_t ~= nil and S.req >= S.next_tier_req + Brain.num("EconFloatReq", 500) - 200 and S.pow >= S.next_tier_pow and S.squads >= want then
		S.next_tier_t = S.next_tier_t - Brain.num("EconTierEarlySecs", 60)
	end
	if S.next_tier_t ~= nil and now >= S.next_tier_t - Brain.num("EconTierSaveSecs", 30) then
		local rule = Brain.num("EconTechRule", 3)
		local army_ok = (rule >= 3 and S.squads >= 2) or (rule < 3 and S.squads >= want - 1)
		if army_ok and not S.home_fight then
			local name = short_pbg(S.tier_pbg)
			local why = "its hour " .. Brain.f0(S.next_tier_t) .. " s (people's median), squads " .. S.squads
			-- Step 6: the money waits for the tier only while its POWER is near (TierPowWaitSecs 45 s of income away). Orca's
			-- match 2: 'KEEP tier tier_2 cost 300/125 ... bank 799/97 income/min 294/10' - 300 requisition (and 200 more for
			-- the global) were kept for four minutes for 28 power that came at 10 a minute; the squads of the clock and the
			-- 'floating bank' rule both stood behind it.
			local pow_eta = (S.next_tier_pow - S.pow) / math.max(S.ipow, 0.001)
			local far = (Brain.num("EconTierPowWait", 1) >= 1 and S.pow < S.next_tier_pow and (S.crisis or pow_eta > math.max(S.next_tier_t - now, 0) + Brain.num("EconTierPowWaitSecs", 45)))
			if now >= S.next_tier_t and far then
				S.tier_far = true
				Brain.say("ECON", "keep|tierfar", 30, { "KEEP", "tier", "-", "why", "the power of " .. name .. " is " .. (S.crisis and "not coming (power crisis)" or (Brain.f0(pow_eta) .. " s away")) ..
					": nothing is kept for it", "bank", rp(S.req, S.pow), "income/min", rp(S.ireq * 60, S.ipow * 60) }, "tierfar")
			elseif now >= S.next_tier_t then
				if wish(S, "tier", name, S.next_tier_req, S.next_tier_pow, why, true, function()
					Request_Production(s_selfplayer, TGROUP_Tech, TPRIORITY_Tech, PITEM_Upgrade, S.tier_pbg) end) then E.t_tier[S.tier + 1] = now end
			elseif far then
				S.tier_far = true
			else
				S.keep_req, S.keep_pow = S.keep_req + S.next_tier_req, S.keep_pow + S.next_tier_pow
				Brain.say("ECON", "keep|tier", 30, { "KEEP", "tier", name, "cost", rp(S.next_tier_req, S.next_tier_pow), "why", why .. " is " .. Brain.f0(S.next_tier_t - now) .. " s away", "bank", rp(S.req, S.pow) }, name)
			end
		else
			Brain.say("ECON", "tierwait", 30, { "KEEP", "tier", "-", "why", S.home_fight and "a fight at home: the army first" or ("only " .. S.squads .. " squads stand: the army first") }, "tierwait")
		end
	end

	-- 7. generators by the clock (one building task at a time; a generator needs a post with room)
	local gens_want = math.min(steps(P.gen_t, now), plan_num("gen_max", 3))
	-- (one request per GenGapSecs: bench s4_x, a live opponent - the request went out every second for a minute and more,
	-- the bank was not charged and no task stayed: nobody was free to build. The engine charges when the building is placed.)
	-- (step 5: a generator placed and not yet in the engine's count is counted - S.gens; a request the engine did not place
	-- waits a growing gap)
	local gen_unsafe = (Brain.num("EconGenThreat", 1) >= 1 and S.pow_pts > 0 and S.post_safe == 0)
	if gen_unsafe and S.gens < gens_want and not opening then
		Brain.say("ECON", "keep|genthreat", 30, { "KEEP", "gen", "-", "why", "the enemy stands at our only post (" .. S.post_threat .. " of " .. S.pow_pts .. " power points under its guns): no generator now",
			"bank", rp(S.req, S.pow) }, "genthreat")
	end
	if not opening and not gen_unsafe and S.gens < gens_want and S.gen_tasks == 0 and S.gen_room > 0 and E.build.gen.watch == nil
		and now - (E.t_gen or -1000) >= E.build_gap("gen") then
		local pbg = EBP[P.gen]
		if pbg ~= nil and Construction_CanConstruct(s_selfplayer, pbg) then
			local r, p = cost_rp(AIPlayer_GetStructureCost(s_self_modplayer, pbg))
			wish(S, "gen", short_pbg(pbg), r, p, "generator " .. (S.gens + 1) .. " of " .. gens_want .. " by the clock", true, function()
				Request_Generator(s_selfplayer, TGROUP_ResourceAddOns, TPRIORITY_BuildOrder, pbg); E.t_gen = now; build_asked(S, "gen", r) end)
		end
	end

	-- 8a. (step 7) THE LATE CORE and the population: at tier 3 the profile's core squad (orks: the nobz) is wanted whatever
	-- the squad clock says (40_composition.ai C.late_core), and before the clock's squad. The bank lay idle at the
	-- population cap (bench, 48 live games of step 6: 515 / 280 in the bank at 91+ of 100, 12 squads ordered after 15:00
	-- in 36 games) because the two squads 'above the clock' and every lost model of a tier 1 squad had filled the 20
	-- population the nobz need. The purse now keeps POPULATION as it keeps money:
	--   * from EconCoreReserveSecs (600 s) on, while no core squad stands, a squad above the clock (12 below) is not
	--     ordered into the core's room (S.pop_reserve, read by C.pick);
	--   * from the click of tier 3 on, while the core does not fit, the tier 1 squads are not refilled (step 2 above):
	--     they fight on as they are, the room comes with their losses, the core is ordered the second it fits.
	-- People swap the weak for the strong the same way - they stop refilling the squad they no longer want.
	-- Log: 'BR ECON <t> SWAP unit <core> why ... it needs P population, N are free' / 'BUY unit ... why the late core ...'.
	local hold0 = E.pop_hold
	E.pop_hold = nil
	local core_on = (P.late_core ~= nil and Brain.num("EconLateCore", 1) >= 1 and not opening)
	local core_stands = false
	if core_on then
		local k1 = P.late_order and P.late_order[1] and P.late_order[1].key   -- (the room is kept for the first squad of the order)
		if (S.kinds[k1] or 0) > 0 then core_stands = true end
		for _, q in ipairs(E.pending) do if q.key == k1 then core_stands = true end end
		if not core_stands and now >= Brain.num("EconCoreReserveSecs", 600) and Brain.UNITS[k1] ~= nil then S.pop_reserve = Brain.UNITS[k1].pop or 0 end
	end
	local core
	if core_on and S.tier >= 3 then core = Brain.composition.late_core(W, S, E) end
	if S.tier >= 3 and core == nil then S.pop_reserve = nil end        -- (not wanted now: the enemy is machines, or the core stands)
	if core_on and not core_stands and S.researching and S.tier == 2 and (S.pop_reserve or 0) > 0 and S.popmax - S.pop < S.pop_reserve then
		-- (the research of tier 3 runs: the room is made meanwhile)
		E.pop_hold = { pop = S.pop_reserve, key = "the tier 3 core", t = hold0 and hold0.t or now, skipped = hold0 and hold0.skipped or 0 }
	end
	if core ~= nil then
		local room = S.popmax - S.pop
		if room < core.pop then
			-- (the hold is not for ever: after EconPopHoldMaxSecs (150 s) without the room the tier 1 squads are refilled
			-- again for as long, then the next try - an army of half squads is worse than one without nobz)
			local hmax = Brain.num("EconPopHoldMaxSecs", 150)
			if hold0 ~= nil and now - hold0.t > hmax then E.pop_rest = now end
			if (core.have == 0 or S.req >= Brain.num("EconCore2HoldReq", 900)) and now - (E.pop_rest or -1000) >= hmax then
				E.pop_hold = { pop = core.pop, key = core.key, t = hold0 and hold0.t or now, skipped = hold0 and hold0.skipped or 0 }
				S.keep_req, S.keep_pow = S.keep_req + core.req, S.keep_pow + core.pow
				Brain.say("ECON", "swap", 60, { "SWAP", "unit", Brain.short(core.key), "cost", rp(core.req, core.pow), "why", core.why .. ": it needs " .. core.pop .. " population, " .. room .. " are free of " .. S.popmax ..
					" - the tier 1 squads are not refilled until it fits", "bank", rp(S.req, S.pow), "held", Brain.f0(now - E.pop_hold.t), "s", "refills skipped", E.pop_hold.skipped }, "swap|" .. core.key)
			end
			core = nil
		elseif now - E.t_unit >= Brain.num("EconUnitGapSecs", 20) then
			wish(S, "unit", Brain.short(core.key), core.req, core.pow, core.why .. (hold0 and (" - the room was made in " .. Brain.f0(now - hold0.t) .. " s") or ""), true, function()
				Request_Production(s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits, PITEM_Spawn, core.pbg)
				table.insert(E.pending, { key = core.key, t = now, had = S.squads })
				if core.veh then E.n.veh = E.n.veh + 1 end
				if core.tier == S.tier then E.tier_unit = S.tier end
				E.t_unit = now
				S.pending = S.pending + 1
			end)
		end
	end
	-- 8. the next squad by the clock (a lost squad is replaced: the clock counts the living)
	local kr, kp = S.keep_req, S.keep_pow
	-- (step 5: while the tier's research runs the squad the clock asks for waits for it, TierUnitWaitSecs (90 s) at most and
	-- with four squads standing - people's first order after a research is of the new tier, 46-110 s after the click; bench
	-- lib6: the squad of 840 s was bought at tier 2 a minute before tier 3 came, and no nobz for the rest of the game)
	local t_click = E.t_tier[S.tier + 1]
	local tier_wait = (S.researching and t_click ~= nil and now - t_click < Brain.num("EconTierUnitWaitSecs", 90) and S.squads >= 4 and not S.home_fight)
	if not opening and have < want and now - E.t_unit >= Brain.num("EconUnitGapSecs", 20) and core == nil then
		if tier_wait then
			Brain.say("ECON", "keep|unitwait", 30, { "KEEP", "unit", "-", "why", "the research of tier " .. (S.tier + 1) .. " runs (" .. Brain.f0(now - t_click) .. " s): the next squad is of the new tier",
				"bank", rp(S.req, S.pow) }, "unitwait")
		else buy_unit("squads " .. S.squads .. " + " .. S.pending .. " on the way, the clock asks " .. want, true) end
	end
	-- Disputed: an upgrade now or the money kept for the next squad (the old AI's AddonVsUnit). Rule 3 (variant C, the
	-- default): the hero's piece and a squad's upgrade do not wait for the squad the clock asks for - people buy the burna
	-- and two pieces of wargear before their third squad. EconAddonRule=1: the squad's price is kept from them.
	local unit_kr, unit_kp = S.keep_req - kr, S.keep_pow - kp
	-- (step 5: the REQUISITION is free for them; the power a squad waits for is kept - or the lootas the clock asks for at
	-- 150 s would lose their 30 power to every piece of wargear)
	if Brain.num("EconAddonRule", 3) >= 3 then S.keep_req = kr end

	-- 9. the hero's wargear by the clock: one piece a slot (weapon, armour, accessory), the profile's order
	-- (money lying idle goes into the hero and the squads first: the clock of the pieces and of the upgrades runs ahead)
	local floating = unit_kr == 0 and ((S.req - S.keep_req >= Brain.num("EconFloatReq", 500)) or (S.keep_pow == 0 and S.pow >= Brain.num("EconFloatPow", 150)))
	local gear_want = steps(P.gear_t, now)
	if floating and now >= P.gear_t[1] then gear_want = table.getn(P.gear_t) end
	if S.hero ~= nil and E.n.gear < gear_want and not S.hero.retreating then
		local aisq = aisquad_by_id(S.hero.id)
		if aisq ~= nil and Task_CountAISquadProduction(aisq) == 0 then
			local had = E.gear
			local list = upgrades_of(aisq)
			local c = choose(list, P.gear[S.hero.key], had, gear_slot)
			if c ~= nil and E.pow_free(S, c.pow, E.n.gear) then
				wish(S, "gear", Brain.short(c.key), c.req, c.pow, "wargear " .. (E.n.gear + 1) .. " of " .. gear_want .. " by the clock for " .. Brain.short(S.hero.key), true, function()
					Request_AISquadProduction(aisq, TGROUP_AddOns, TPRIORITY_AddOns, PITEM_SquadUpgrade, c.pbg)
					had[c.key], had[gear_slot(c.key)] = true, true
				end)
			elseif c == nil then
				Brain.say("ECON", "nogear", 120, { "KEEP", "gear", "-", "why", "nothing of the list can be bought by " .. Brain.short(S.hero.key) .. " now (pieces so far " .. E.n.gear .. ")" }, "nogear")
			end
		end
	end

	-- 9b. (step 6) the SWAP by the situation, as people do: machines of the enemy seen (remembered CompMemSecs) and the hero
	-- can take its anti-machine weapon - it is bought over the weapon it wears (the slot is replaced by the engine), once.
	local _, _, en_veh = Brain.composition.enemy_mix(W)
	local swap = P.gear_swap and S.hero ~= nil and P.gear_swap[S.hero.key] or nil
	if swap ~= nil and (en_veh or 0) >= 1 and not E.gear["swap|" .. swap] and not S.hero.retreating and Brain.num("EconGearSwap", 1) >= 1 then
		local aisq = aisquad_by_id(S.hero.id)
		if aisq ~= nil and Task_CountAISquadProduction(aisq) == 0 then
			local c = choose(upgrades_of(aisq), { swap }, {}, nil)
			if c ~= nil then
				wish(S, "gear", Brain.short(c.key), c.req, c.pow, "the swap: " .. en_veh .. " machines of the enemy seen - the weapon against them for " .. Brain.short(S.hero.key), false, function()
					Request_AISquadProduction(aisq, TGROUP_AddOns, TPRIORITY_AddOns, PITEM_SquadUpgrade, c.pbg)
					E.gear["swap|" .. swap], E.gear[c.key], E.gear[gear_slot(c.key)] = true, true, true
				end)
			end
		end
	end

	-- 10. an upgrade of a squad by the clock: the squad with the fewest upgrades first, the profile's order for its kind
	local upg_want = 0
	if now >= P.upg_first then upg_want = math.min(1 + math.floor((now - P.upg_first) / P.upg_every), plan_num("upg_max", 10)) end
	if floating and now >= P.upg_first and now - (E.t_upg or -1000) >= Brain.num("EconFloatUpgSecs", 20) then upg_want = math.max(upg_want, E.n.upg + 1) end
	-- (step 7, the late game: at tier 3 the clock's ten upgrades are spent long ago and the bank lies idle at the population
	-- cap - a squad of the top tier takes every upgrade of its list (the nobz: kit, hammers, the leader with the klaw), the
	-- others a third one, one upgrade every EconLateUpgSecs (30 s) while the bank is above EconLateUpgReq (300))
	local late_upg = (S.tier >= 3 and Brain.num("EconLateUpg", 1) >= 1 and S.req - S.keep_req >= Brain.num("EconLateUpgReq", 300))
	if late_upg and now - (E.t_upg or -1000) >= Brain.num("EconLateUpgSecs", 30) then upg_want = math.max(upg_want, E.n.upg + 1) end
	if E.n.upg < upg_want then
		local best, best_c, best_aisq
		for _, u in ipairs(W.own) do
			local prefs = P.upg[u.key]
			if prefs ~= nil and (en_veh or 0) >= 1 and P.upg_veh ~= nil and P.upg_veh[u.key] ~= nil then prefs = P.upg_veh[u.key] end
			if prefs ~= nil and not u.retreating then
				local had = E.upg[u.id] or { n = 0 }
				local per = Brain.num("EconUpgPerSquad", 2)
				if late_upg then per = math.max(per, Brain.num("EconLateUpgPerSquad", 3)) end
				if had.n < per and (best == nil or had.n < (E.upg[best.id] or { n = 0 }).n) then
					local aisq = aisquad_by_id(u.id)
					if aisq ~= nil and Task_CountAISquadProduction(aisq) == 0 then
						-- (step 6, Orca's match 1: 'beamy deffguns with no machine around' - 3 of 7 upgrades; an upgrade the profile
						-- marks 'veh' is bought only while machines of the enemy are remembered)
						local c = choose(upgrades_of(aisq), prefs, had, nil, function(pat)
							local need = P.upg_need and P.upg_need[pat]
							return need == nil or (need == "veh" and (en_veh or 0) >= 1)
						end)
						if c ~= nil and E.pow_free(S, c.pow) then best, best_c, best_aisq = u, c, aisq end
					end
				end
			end
		end
		if best ~= nil then
			wish(S, "upg", Brain.short(best_c.key), best_c.req, best_c.pow, "upgrade " .. (E.n.upg + 1) .. " of " .. upg_want .. " by the clock for " .. best.id .. " " .. Brain.short(best.key), false, function()
				Request_AISquadProduction(best_aisq, TGROUP_AddOns, TPRIORITY_AddOns, PITEM_SquadUpgrade, best_c.pbg)
				local had = E.upg[best.id] or { n = 0 }
				had.n = had.n + 1; had[best_c.key] = true
				E.t_upg = now
				E.upg[best.id] = had
			end)
		end
	end

	if Brain.num("EconAddonRule", 3) >= 3 then S.keep_req = S.keep_req + unit_kr end

	-- 11. more posts by the clock
	if not opening and S.posts + S.post_tasks + S.posts_building < posts_want then buy_post("post " .. (S.posts + 1) .. " of " .. posts_want .. " by the clock", false) end

	-- 12. money lying idle (R22: no banking): a squad above the clock, when nothing above is waiting for the money
	-- (step 6: 'nothing waits' = the money ABOVE what is kept; the gap is short while the bank is twice the line)
	local free_req = S.req - S.keep_req
	local fgap = Brain.num("EconFloatGapSecs", 60)
	if free_req >= 1.5 * Brain.num("EconFloatReq", 500) then fgap = fgap / 3 end
	if not opening and free_req >= Brain.num("EconFloatReq", 500) and now - E.t_unit >= fgap
		and have < want + Brain.num("EconFloatSquads", 2) + (S.crisis and 1 or 0) and not tier_wait then
		S.float_buy = true
		buy_unit("the bank floats (" .. Brain.f0(S.req) .. " requisition, " .. Brain.f0(S.keep_req) .. " of it kept)", false)
		S.float_buy = nil
	end

	Brain.say("ECON", "state", 60, { "STATE", "units", E.n.unit, "veh", E.n.veh, "gens", S.gens, "posts", S.posts, "tier", S.tier .. (S.researching and "+" or ""),
		"gear", E.n.gear, "upg", E.n.upg, "reinf", E.n.reinf, "revive", E.n.revive, "squads", S.squads, "of", want, "bank", rp(S.req, S.pow),
		"income/min", rp(S.ireq * 60, S.ipow * 60), "pop", S.pop .. "/" .. S.popmax, "red", S.red and Brain.f0(S.red) or "?" }, "state")
end

	end
	eliteai_brain_30_economy()
end

-- ===== EliteAI brain/40_composition.ai =====
do
	local function eliteai_brain_40_composition()
-- BRAIN 40_composition: what the army is made of - which unit is bought next and why.
-- Owns: R24, R25, R27, R28, R47, R48 (R42 with 70_abilities.ai).
-- In:  W (the enemy seen: W.en, W.ghosts and every enemy blueprint ever seen - by armour class), Brain.UNITS (Elite's real
--      numbers: cost, population, tier, damage per armour class), our own army, the look of 30_economy.ai (S).
-- Out: C.pick(W, S, E) -> { key, pbg, req, pow, veh, score, why } for the economy module, or nil; never a unit of another
--      race (the engine's own list of what the HQ produces is the candidate list), never a unit without a data row.
-- Log: the reason goes into the purchase line ('BR ECON ... BUY unit <unit> ... why ... - <answer>'), the scores of all
--      candidates into 'BR COMP <t> pick <unit> of <unit:score ...> mix inf/hinf/veh'.
--
-- The value of a candidate = its strength per cost against the enemy's SEEN mix (the same formula as a fight's strength:
-- sqrt(health x damage against that mix), power counted PowK x requisition), times what the army lacks:
--   * the opening squads are the profile's (people: shoota, shoota in 86-93 % of the ork games);
--   * the same kind again is worth less (/ (1 + SameK x how many of it stand)): a mixed army, not six of one;
--   * a melee squad's damage counts MeleeK (0.6): it has to reach its target first;
--   * a line of shooters behind the mobs and mobs in front of the shooters: the scarcer side x LackK;
--   * vehicles seen and nothing of ours that hurts them: x AvK for the squads whose damage to vehicles is real;
--   * the first squad after a new tier is of that tier (people order it 46-110 s after the research): x NewTierK;
--   * machines are VehShare (20 %) of the orders at most (people: 10-15 %), so the first one comes as the 5th order -
--     and it is due then (x VehDueK) when there is none;
--   * power counts PowK x requisition while the bank has little of it, 1 x when it lies idle.
-- STAGE (step 4, orks): migrated - the brain chooses, Relic's demand tables do not run.
Brain.composition = {}
local C = Brain.composition
C.seen_keys = {}
-- strength per 100 requisition-equivalents of a blueprint against a mix { inf, hinf, veh } (power counts PowK x)
function C.value(key, mix, powk)
	local d = Brain.UNITS and Brain.UNITS[key]
	if d == nil then return 0 end
	local cost = d.req + (powk or Brain.num("PowK", 2.5)) * d.pow
	if cost <= 0 then return 0 end
	local dps = mix.inf * d.dI + mix.hinf * d.dH + mix.veh * d.dV
	-- (a machine's health is worth more than a squad's: small arms hardly scratch it - CompVehHpK 2.5; without it a deff
	-- dread scored below every squad and machines were 2 of 31 orders against the people's 10-15 %)
	local hp = d.hp * ((d.arm == "veh") and Brain.num("CompVehHpK", 2.5) or 1)
	return 100 * math.sqrt(hp * math.max(dps, 0.01)) / cost
end
-- the enemy as seen so far. Step 5: REMEMBERED for CompMemSecs (240 s), not only what stands in sight this second - the
-- mix used to be '0.00/1.00/0.00 seen 1' one minute and '1.00/0.00/0.00 seen 1' the next, and a dreadnought seen a minute
-- ago did not ask for tankbustas. C.mem[id] = { key, w = full health, t = last seen }; by the health of the armour class.
-- Before the first sighting - a plain guess (infantry with some heavy infantry).
-- Returns the mix, the squads counted, the machines among them, the set-up teams among them.
C.mem = {}
function C.update(W)
	for _, e in ipairs(W.en or {}) do
		local w = e.hmax or e.hpabs or 0
		if e.id ~= nil and w > 0 then C.mem[e.id] = { key = e.key or "", w = w, t = W.now, veh = e.veh } end
	end
	local old = Brain.num("CompMemSecs", 240)
	for _, id in ipairs(Brain.keys(C.mem)) do if W.now - C.mem[id].t > old then C.mem[id] = nil end end
end
function C.enemy_mix(W)
	C.update(W)
	local m, sum, n, veh_n, setup_n = { inf = 0, hinf = 0, veh = 0 }, 0, 0, 0, 0
	for _, id in ipairs(Brain.keys(C.mem)) do
		local e = C.mem[id]
		local d = Brain.UNITS[e.key]
		local arm = (d and d.arm) or (e.veh and "veh" or "inf")
		local c = (arm == "veh") and "veh" or ((arm == "hinf" or arm == "shinf") and "hinf" or "inf")
		if arm ~= "bld" then
			m[c] = m[c] + e.w; sum = sum + e.w; n = n + 1
			if c == "veh" then veh_n = veh_n + 1 end
			if d ~= nil and d.setup == 1 then setup_n = setup_n + 1 end
		end
	end
	if sum <= 0 then return { inf = 0.7, hinf = 0.25, veh = 0.05 }, 0, 0, 0 end
	m.inf, m.hinf, m.veh = m.inf / sum, m.hinf / sum, m.veh / sum
	return m, n, veh_n, setup_n
end
-- Step 7: THE LATE CORE (the complaint: 'nobz are almost never bought' - bench, 48 live games of step 6: a nob squad in
-- 3 of 36 games that reached tier 3; the squad clock asks for 6 squads and 7 stand, the population is 93 of 100, so no
-- order is made at all, and when one is, the dread / the tankbustas outscore the nobz). People who reach tier 3 order
-- a nob squad (human_baseline_1113: 'the first new unit after T3 - ... a nob squad ...'). At tier 3, while the enemy is
-- mostly infantry (CompCoreInfMix 0.5 of what was seen), the profile's core squad (econ.late_core: orks - the nobz,
-- 3000 health in heavy armour, a mob that does reach its target) is wanted whatever the squad clock says: one, a second
-- when the bank holds twice its price. It does not ask the engine about population - the purse makes the room
-- (30_economy.ai, 8b). Returns { key, pbg, req, pow, pop, why } or nil. Brain_EconLateCore=0: off.
function C.late_core(W, S, E)
	local P = S.P
	if P.late_core == nil or S.tier < 3 then return nil end
	local mix, seen, en_veh = C.enemy_mix(W)
	if mix.inf + mix.hinf < Brain.num("CompCoreInfMix", 0.5) then return nil end
	local can = {}
	local cnt = AIProduction_GetBuildableSquadCount(s_selfplayer)
	for i = 0, cnt - 1 do
		local pbg = AIProduction_GetBuildableSquadAt(s_selfplayer, i)
		local key = pbg and Brain.bp_key(PBG_GetName(pbg) or "") or ""
		if P.late_core[key] ~= nil and Brain.UNITS[key] ~= nil and AIProduction_CanProduce(s_selfplayer, PITEM_Spawn, pbg) == true then can[key] = pbg end
	end
	for _, e in ipairs(P.late_order or {}) do
		local pbg, d = can[e.key], Brain.UNITS[e.key]
		if pbg ~= nil and e.n <= Brain.num("CompCoreMax", 2) then
			local have = (S.kinds[e.key] or 0)
			for _, q in ipairs(E.pending) do if q.key == e.key then have = have + 1 end end
			local c = AIPlayer_GetProductionCost(s_self_modplayer, PITEM_Spawn, pbg)
			local r, p = (c and c.requisition) or d.req, (c and c.power) or d.pow
			local k = Brain.num("CompCore2K", 2)
			if have < e.n and (not e.rich or (S.req >= k * r and S.pow >= k * p)) then
				return { key = e.key, pbg = pbg, req = r, pow = p, pop = d.pop or 0, tier = d.t, have = have, veh = (d.arm == "veh"),
					why = "the late core: " .. Brain.short(e.key) .. " " .. (have + 1) .. " of " .. e.n .. " at tier " .. S.tier .. " against infantry (" .. Brain.f0((mix.inf + mix.hinf) * 100) .. " % of the enemy seen)"
						.. (e.rich and ", the bank holds twice its price" or "") }
			end
		end
	end
	return nil
end
function C.pick(W, S, E)
	local P = S.P
	local mix, seen, en_veh, en_setup = C.enemy_mix(W)
	-- (step 7: a turret of the enemy that stands in the field asks for a squad that breaks armour as a machine does - the
	-- infantry keeps out of its circle and nothing else of ours can take it; Brain_CompTurretAv=0: off)
	local n_tur = table.getn((Brain.army and Brain.army.turrets) or {})
	if n_tur > 0 and Brain.num("CompTurretAv", 1) >= 1 then en_veh = (en_veh or 0) + n_tur end
	local opening_i = E.n.unit + 1
	local open_key = (S.opening and P.opening) and P.opening[opening_i] or nil
	local mel, rng, av, brk, top, setups = 0, 0, 0, 0, 0, 0
	local breakers = P.breakers or {}
	for _, u in ipairs(W.own) do
		if u.d ~= nil and (u.d.pop or 0) > 0 then
			if u.d.mel == 1 then mel = mel + 1 else rng = rng + 1 end
			if (u.d.dV or 0) >= Brain.num("CompAvDps", 30) then av = av + 1 end
			if breakers[u.key] then brk = brk + 1 end
			if u.d.setup == 1 then setups = setups + 1 end
			if (u.d.t or 1) >= S.tier and u.d.arm ~= "cmd" then top = top + 1 end
		end
	end
	-- the opening squads are the people's, not a choice of this module: they count CompOpenSameK (0.5) each against one
	-- more of their kind (the verifier, 13.11: the two opening shootas divided every later shoota by 3)
	local open_n = {}
	for _, k in ipairs(P.opening or {}) do open_n[k] = (open_n[k] or 0) + 1 end
	-- machines: people's are 10-15 % of their orders. One is allowed from the 4th order on (VehShare 0.25) and is DUE at
	-- tier 2+ when none stands and the machines so far are below VehMinShare (0.12) of the orders - also after the first
	-- one died (it used to be due once a game)
	local veh_ok = (E.n.veh + 1) <= Brain.num("CompVehShare", 0.25) * (E.n.unit + 1)
	-- the first squad after a new tier is of that tier - and at tier 3 while none of that tier stands (the late game asks
	-- for nobz / a tank: bench lib6, 20+ min - the T3 squad came once in three games)
	local fresh_tier = (S.tier >= 2 and ((E.tier_unit or 1) < S.tier or (S.tier >= 3 and top == 0)))
	local av_need = math.min(en_veh, Brain.num("CompAvMax", 2))
	-- power is dear while the bank has little of it and cheap when it lies idle (PowK 2.5 below PowLow 100, 1 from PowHigh 250 on)
	local lo, hi = Brain.num("CompPowLow", 100), Brain.num("CompPowHigh", 250)
	local powk = Brain.num("PowK", 2.5)
	if S.pow >= hi then powk = 1 elseif S.pow > lo then powk = powk - (powk - 1) * (S.pow - lo) / (hi - lo) end
	-- (power lying idle is nearly free: bench lib6 - 300-750 power in the bank from the 12th minute on, people's mean 35)
	if S.pow >= 2 * hi then powk = Brain.num("CompPowIdleK", 0.4) end
	-- a machine is due: people's machines are 10-15 % of their orders; none so far among VehDueOrders (4) orders at tier 2+
	local veh_due = (S.tier >= 2 and S.veh == 0 and E.n.unit >= Brain.num("CompVehDueOrders", 3) and E.n.veh < Brain.num("CompVehMinShare", 0.12) * (E.n.unit + 1))
	local best, n, parts = nil, 0, {}
	local cnt = AIProduction_GetBuildableSquadCount(s_selfplayer)
	for i = 0, cnt - 1 do
		local pbg = AIProduction_GetBuildableSquadAt(s_selfplayer, i)
		local key = pbg and Brain.bp_key(PBG_GetName(pbg) or "") or ""
		local d = Brain.UNITS[key]
		local skip = P.never and P.never[key]
		-- Step 5: the engine's 'can produce NOW' is also 'can pay now' (bench s5_x_a, six scenes: at 150 s with 27 power in
		-- the bank the lootas - 30 power - were not in the list at all, the choice was 'shoota or slugga' in six scenes of
		-- six; 'nothing the engine can produce fits (0 candidates; population 39 of 100)' = the bank was below every
		-- price). A squad the bank cannot pay yet stays a candidate when its price arrives within CompUnitPowSecs /
		-- CompUnitReqSecs (the purse then keeps the money for it: KEEP unit); one the engine refuses with the price in
		-- hand (the queue, a requirement) is not.
		local c0 = (pbg ~= nil and d ~= nil) and AIPlayer_GetProductionCost(s_self_modplayer, PITEM_Spawn, pbg) or nil
		local r0, p0 = (c0 and c0.requisition) or 0, (c0 and c0.power) or 0
		-- CompWaitShort: 1 (default) = only when it is the POWER that is short (the verifier's case: lootas / stormboyz at
		-- 150 s); 2 = the requisition as well; 0 = as the engine says. Bench, nine live games each: 2 (s5_*_d) against 0
		-- (s5_k0_d) - victory points held 1.26 : 1.02 against 1.39 : 0.95, models lost 351 against 266: waiting for
		-- requisition too leaves the army a squad short for no gain that could be measured.
		local ws = Brain.num("CompWaitShort", 1)
		local short = (ws >= 2 and (r0 > S.req or p0 > S.pow)) or (ws >= 1 and p0 > S.pow and r0 <= S.req)
		if d ~= nil and not skip and d.arm ~= "cmd" and (d.pop or 0) > 0 and AIProduction_CanProduce(s_selfplayer, PITEM_Spawn, pbg) == true
			and (AIProduction_CanProduceNow(s_selfplayer, PITEM_Spawn, pbg) or short) then
			n = n + 1
			local veh = (d.arm == "veh")
			local v, why = C.value(key, mix, powk), "strength per cost against the enemy seen"
			if seen == 0 then why = "strength per cost (no enemy seen yet)" end
			-- a mob's damage is on paper until it has walked into the fire (bench s4_x1, six long scenes with a live opponent:
			-- 12 slugga squads of 31 orders - people's ork armies are shootas first, a slugga squad in 23 % of the games)
			-- (step 5: a heavy mob - nobz, 3000 health in heavy armour - does reach its target: CompHeavyMeleeK 0.85; bench
			-- s5_l6_a: at tier 3 the nobz scored 121 against the kommandos' 188 and were not bought in three long games)
			if d.mel == 1 then v = v * ((d.arm == "hinf" or d.arm == "shinf") and Brain.num("CompHeavyMeleeK", 0.85) or Brain.num("CompMeleeK", 0.6)) end
			local same = (S.kinds[key] or 0)
			same = same - math.min(same, open_n[key] or 0) * (1 - Brain.num("CompOpenSameK", 0.5))
			v = v / (1 + Brain.num("CompSameK", 1.0) * same)
			if d.mel == 1 and mel < rng then v = v * Brain.num("CompLackK", 1.3); why = why .. ", the mobs are fewer than the shooters"
			elseif d.mel ~= 1 and rng < mel then v = v * Brain.num("CompLackK", 1.3); why = why .. ", the shooters are fewer than the mobs" end
			-- machines seen (remembered): one squad that hurts them per machine, CompAvMax (2) at most
			if (mix.veh >= Brain.num("CompAvMix", 0.15) or en_veh >= 1) and av < math.max(av_need, 1) and (d.dV or 0) >= Brain.num("CompAvDps", 30) then
				v = v * Brain.num("CompAvK", 2.5); why = "machines seen (" .. en_veh .. ", " .. Brain.f0(mix.veh * 100) .. " % of the enemy) and " .. av .. " of ours hurt them"
			end
			-- set-up teams seen (remembered) and nothing of ours that breaks them (grenades, a jump, a stealth squad)
			if en_setup >= 1 and brk == 0 and breakers[key] then
				v = v * Brain.num("CompSetupK", 2.5); why = why .. ", set-up teams seen (" .. en_setup .. ") and nothing of ours breaks them"
			end
			if fresh_tier and d.t == S.tier then v = v * Brain.num("CompNewTierK", 1.6); why = why .. ", the first squad of tier " .. S.tier end
			if veh and veh_due then v = v * Brain.num("CompVehDueK", 2); why = why .. ", a machine is due (none among " .. E.n.unit .. " orders)" end
			if veh and not veh_ok then v = 0 end
			-- Step 6 (Orca's match 1: lootas three times, two of them in a row at 10:02 and 11:29 with two squads standing):
			-- a set-up team needs a line in front of it - one, a second only with CompSetup2Squads (5) other squads; a squad
			-- whose trade is machines (the profile's role 'av') waits until one is seen, or until the hour machines are
			-- likely (CompAvLikelySecs 480) - then one.
			if d.setup == 1 and Brain.num("CompSetupCap", 1) >= 1 and (setups >= 2 or (setups >= 1 and S.squads - setups < Brain.num("CompSetup2Squads", 5))) then v = 0 end
			local prow = Brain.roles.profile().units[key]
			if prow ~= nil and prow.role == "av" and en_veh == 0 and (W.now < Brain.num("CompAvLikelySecs", 480) or av >= 1) and Brain.num("CompAvNeedsVeh", 1) >= 1 then v = 0 end
			-- a squad whose power is not there within UnitPowSecs, or is the tier's, is not waited for: the next best is taken
			local c = AIPlayer_GetProductionCost(s_self_modplayer, PITEM_Spawn, pbg)
			local r, p = (c and c.requisition) or 0, (c and c.power) or 0
			-- (step 5: UnitPowSecs 30 -> 75. The verifier, 13.11: the third squad is chosen at 150-350 s with next to no
			-- power in the bank - lootas and stormboyz were struck out and the choice was 'a shoota divided by 3 or a
			-- slugga'; people's third order is lootas 41 %, stormboyz next. Its power arrives within a minute: it is waited for.)
			if p > 0 and (p > S.pow - S.keep_pow + S.ipow * Brain.num("CompUnitPowSecs", 75) or not E.pow_free(S, p)) then v = 0 end
			if r > S.req - S.keep_req + S.ireq * Brain.num("CompUnitReqSecs", 45) then v = 0 end
			-- (population: the engine's own answer went with 'can produce now' - a squad that does not fit is no candidate)
			if (d.pop or 0) > (S.popmax or 0) - (S.pop or 0) then v = 0 end
			-- (step 7: the room kept for the tier 3 core - 30_economy.ai 8a; a squad of the core itself and the clock's own squads are not held by it)
			if S.float_buy and (S.pop_reserve or 0) > 0 and not (P.late_core and P.late_core[key]) and (d.pop or 0) > (S.popmax or 0) - (S.pop or 0) - S.pop_reserve then v = 0 end
			if open_key ~= nil then
				if key == open_key then v, why = 1000, "the people's opening" else v = 0 end
			end
			if v > 0 then
				table.insert(parts, Brain.short(key) .. ":" .. Brain.f1(v))
				if best == nil or v > best.score then
					best = { key = key, pbg = pbg, req = r, pow = p, veh = veh, score = v, why = why, tier = d.t }
				end
			end
		end
	end
	if best ~= nil then
		Brain.say("COMP", "pick", 20, { "pick", Brain.short(best.key), "of", table.concat(parts, " "), "mix", Brain.f2(mix.inf) .. "/" .. Brain.f2(mix.hinf) .. "/" .. Brain.f2(mix.veh),
			"seen", seen, "machines", en_veh, "setups", en_setup, "mobs", mel, "shooters", rng, "av", av, "breakers", brk }, best.key .. "|" .. table.getn(parts))
	end
	return best, n
end

	end
	eliteai_brain_40_composition()
end

-- ===== EliteAI brain/50_army.ai =====
do
	local function eliteai_brain_50_army()
-- BRAIN 50_army: the army - one fist, the fights it takes, how it leaves them. The only module that moves combat squads.
-- Owns: R1-R7 (first slice; step 2: who is in a fight, the loner, the fight's clock), then R9, R11, R15, R20 with the plan and the roles.
-- In:  W (10_perception.ai: the army's squads, the visible enemy, the fights with both sides' strength and losses, points),
--      Brain.plan.objective (20_plan.ai), roles and charge casts (60_roles.ai, 70_abilities.ai).
-- Out: orders (Brain.order), A.centre (the fist's centre, for the plan), A.st[id] (what each squad is doing: numbers).
-- Cadence: every brain tick (1 s). A verdict that gets worse must stand VerdictTicksDown ticks (2 s) before it is acted
--      on - the reaction time of a person, and no flapping; one that gets better is taken at once.
-- Log:
--   'BR ARMY <t> fight <F> <PRESS|HOLD|STEP|LEAVE> why <reason> ratio R with_support R ours N S enemy N S lost10s A:B age S at X Z'
--   'BR ARMY <t> fist <MARCH|WAIT|AT|STAND|BACK|ATTACK> together K/N centre X Z to <objective> [threat N@X,Z ratio R] why <reason>'
--   'BR ARMY <t> squad <id> <unit> <RETREAT|HOME|BACK> why <reason> ...'   and every order as 'BR ORD ...' (00_core.ai)
--
-- The rules, in the order they are applied each tick (a squad taken by one is not touched by the next):
--  1. SURVIVE (R3, R4). The retreat order (X) is for a squad that is dying, nobody else: shot at AND models x health
--     below DyingEff (0.3) - in a fight we are winning also health below PressRetHP (R1: a healthy squad is not pulled out
--     of a won fight). Never from suppression or a scratch. A machine (no retreat in the engine) drives home below
--     MachineHomeHP when shot at (R33). At home: refilled (orks: to the last boy), released at HealHP.
--  2. FIGHT (R1, R2, R5, R6). Each fight is judged on its own numbers, every tick, by this player alone - not by what an
--     ally does, not by what happened a minute ago:
--       ratio >= Win (1.3)               PRESS  everybody fights, the support (ours within SupportR) joins
--       ratio >= Even (0.8)              HOLD   the same; but bleeding (we lost TradeK x what the enemy lost over 10 s, the
--                                               fight older than TradeSecs, and weaker even with the support) -> STEP
--       weaker, support makes us even    HOLD   the support is called in
--       ratio >= Lost (0.45)             STEP   a fighting withdrawal: StepD metres towards our point behind, stand and
--                                               shoot, again. Nobody gets the retreat order; the support waits at that point.
--       below                            LEAVE  not before the fight is LeaveMinAge (10 s) old - until then it is a STEP. Then the
--                                               retreat order for a squad that is shot at and hurt (below LeaveRetEff 0.5), one
--                                               squad at a time (the most hurt first, the next after LeaveRetGap 5 s); the
--                                               others WALK to the point behind (R1, R2: no X for a healthy squad, none for a
--                                               squad that is not in the fight)
--     Who is in a fight: in at EngageR (45 m), out at LeaveR (60 m) - 10_perception.ai. One squad of ours against a group
--     is no fight of its own (AVOID): it waits for the fist out of range or walks back to it - loner() below.
--     Calibrated against people (human_baseline_1113): they hold a fight ~19 s (10-33) before the first retreat and send
--     home one squad at a time (77 % of the retreat episodes).
--     Captures are 55_capture.ai's (one squad a point); the engine's own retreat is switched off (elite.scar, mode 12).
--  3. FIST (R7). The squads that are in no fight are one group: the centre is where most of them stand; a squad outside
--     FistR walks to it; the group marches to the plan's objective only while FistFrac of it is together, a squad that
--     got ahead waits. Before contact the fist weighs the enemy it sees (or remembers) ahead: weaker than it - BACK to our point behind / STAND,
--     clearly stronger - ATTACK it, else the march goes on.

Brain.army = {}
local A = Brain.army
A.st = {}
A.stats = { retreat = 0, home = 0, step = 0, leave = 0, charge = 0, verdicts = 0, mem_in = 0, mem_out = 0, loner = 0, not_ours = 0, young = 0 }
local d2 = Brain.d2
local O = Brain.ORD
local RANK = { press = 3, hold = 2, step = 1, leave = 0, avoid = 0 }
local UP = { press = "PRESS", hold = "HOLD", step = "STEP", leave = "LEAVE", avoid = "AVOID" }   -- (string.upper does nothing in the game's AI Lua: seen on the bench)

local function f0(v) return Brain.f0(v) end
local function f2(v) return Brain.f2(v) end

-- ---- step 6: burnt ground ---------------------------------------------------------------------------------------------
-- Orca's match 2 (14.11), marks 7-9: 'no counter to set-up teams', 'after the turrets went up it runs back and forth'.
-- The log: 'fight F15 ... enemy 2 603 ... lost10s 459:0', 'F26 ... lost10s 392:0', 'F10 PRESS why stronger ratio 2.43 ...
-- lost10s 448:3' - squads walked one after another into devastators and turrets (a turret is no squad: the brain does not
-- see it at all), were judged 'stronger' or 'waiting out of range', lost 250-450 health in ten seconds for nothing and
-- came again a minute later. A place where a fight was ROUTED ON THE TRADE (judge(): we lost TradeRoutK 4 x what the
-- enemy lost, 200+ health in 10 s) is remembered ZoneSecs (90 s, refreshed by every new rout there) as a circle of ZoneR
-- (45 m): a fight inside it is not pressed below ZonePressRatio (2) unless a machine of ours is in it (the siege), the
-- plan does not choose a point inside it while another is to be had (20_plan.ai). Not near home (ZoneHomeR 70).
A.zones = {}
function A.zone_at(x, z)
	if Brain.num("Zone", 1) < 1 then return nil end
	local now = Brain.now or 0
	-- (a turret we know is burnt ground while it stands: TurretR 42 m around it)
	for _, tu in ipairs(A.turrets or {}) do
		if d2(x, z, tu.x, tu.z) <= Brain.num("TurretR", 42) then return { x = tu.x, z = tu.z, r = Brain.num("TurretR", 42), t = now, t0 = 0, n = 1, turret = tu } end
	end
	for _, q in ipairs(A.zones) do
		if now - q.t <= Brain.num("ZoneSecs", 90) and d2(x, z, q.x, q.z) <= q.r then return q end
	end
	return nil
end
local function zone_note(F, W, lo, le)
	if Brain.num("Zone", 1) < 1 then return end
	if W.home ~= nil and d2(F.x, F.z, W.home.x, W.home.z) <= Brain.num("ZoneHomeR", 70) then return end
	local q = A.zone_at(F.x, F.z)
	if q ~= nil then q.t, q.n = W.now, q.n + 1; return end                        -- (a turret's zone is rebuilt every look: nothing is kept on it)
	local keep = {}
	for _, o in ipairs(A.zones) do if W.now - o.t <= Brain.num("ZoneSecs", 90) then table.insert(keep, o) end end
	A.zones = keep
	table.insert(A.zones, { x = F.x, z = F.z, r = Brain.num("ZoneR", 45), t = W.now, t0 = W.now, n = 1 })
	A.stats.zones = (A.stats.zones or 0) + 1
	Brain.log("ARMY", "zone", "BURNT", "at", f0(F.x), f0(F.z), "r", f0(Brain.num("ZoneR", 45)), "why", "we lost", f0(lo), "against", f0(le), "in 10 s in", F.key,
		"(enemy squads seen " .. table.getn(F.en) .. "): a nest - not walked into for", f0(Brain.num("ZoneSecs", 90)), "s without a machine or twice its strength")
end

-- ---- step 6: cover ------------------------------------------------------------------------------------------------------
-- Orca, mark 1: 'stands in the open instead of taking cover'. The engine knows the cover spots (CoverSpotManager) and gives
-- the best one near a place: Squad_FindCoverCompareCurrent(squad, position, search radius, the farthest it may go,
-- compare with where it stands) - Relic's own tactic filter (tactics.ai PositionTargetFilter_Cover) calls it the same way;
-- it returns the position asked for when it finds nothing better. A SHOOTING squad (not a mob, not a machine) of a fight
-- we take goes to the cover spot nearest to where it would stand: on its way into range (around the place RNG - 6 m from
-- its nearest enemy) and once it stands in range. One question a squad per CoverSecs (6 s); the spot must leave the enemy
-- in range and be no nearer to it than CoverEnemyMinD (10 m). The order is a MOVE (a few metres), then it stands and
-- shoots; the spot is kept CoverHoldSecs (20 s) - no new search while it stands there in range. Brain_Cover=0: off.
A.cover = { t = {}, at = {}, asked = 0, found = 0 }
A.flanks = {}
local function cover_api()
	if A.cover.api == nil then
		A.cover.api = (type(Squad_FindCoverCompareCurrent) == "function" and type(World_Pos) == "function") and Brain.num("Cover", 1) >= 1
		Brain.log("ARMY", "cover", "api", "Squad_FindCoverCompareCurrent", type(Squad_FindCoverCompareCurrent), "World_Pos", type(World_Pos), "use", A.cover.api and 1 or 0)
	end
	return A.cover.api
end
-- the cover spot for u near (x, z): { x, y, z } and its distance to the nearest enemy of 'en'; nil when there is none
function A.find_cover(u, x, z, r, en, rng)
	if not cover_api() or u.sq == nil then return nil end
	local now = Brain.now or 0
	local last = A.cover.t[u.id]
	if last ~= nil and now - last < Brain.num("CoverSecs", 6) then return nil end
	A.cover.t[u.id] = now
	A.cover.asked = A.cover.asked + 1
	local c = Squad_FindCoverCompareCurrent(u.sq, World_Pos(x, u.y or 0, z), r, 2.5 * r, true)
	if c == nil or c.x == nil or c.z == nil then return nil end
	if d2(c.x, c.z, x, z) < 1.5 or d2(c.x, c.z, u.x, u.z) < 3 then return nil end          -- nothing better / it stands there
	local ed
	for _, e in ipairs(en or {}) do local d = d2(c.x, c.z, e.x, e.z); if ed == nil or d < ed then ed = d end end
	if ed ~= nil and (ed > rng - 1 or ed < Brain.num("CoverEnemyMinD", 10)) then return nil end
	A.cover.found = A.cover.found + 1
	return { x = c.x, y = c.y or u.y or 0, z = c.z }, ed
end
-- a set-up team's barrel: the place beside it for a mob that stands in front of it (nil = no detour: not a set-up team,
-- no heading, already beside / behind it, or already in the scrap)
local function flank_point(u, t)
	if Brain.num("Flank", 1) < 1 or t.sq == nil or type(Squad_GetHeading) ~= "function" or not (t.d ~= nil and t.d.setup == 1) then return nil end
	local dx, dz = u.x - t.x, u.z - t.z
	local dist = math.sqrt(dx * dx + dz * dz)
	if dist <= Brain.num("FlankInD", 12) or dist > Brain.num("FlankMaxD", 55) then return nil end
	local h = Squad_GetHeading(t.sq)
	if h == nil or h.x == nil or h.z == nil then return nil end
	local hl = math.sqrt(h.x * h.x + h.z * h.z)
	if hl < 0.01 then return nil end
	local cos = (dx * h.x + dz * h.z) / (dist * hl)
	if cos < Brain.num("FlankCos", 0.5) then return nil end                                   -- outside 60 degrees of its barrel
	local s = ((h.x * dz - h.z * dx) >= 0) and 1 or -1                                      -- the side we are on
	local side = math.min(dist, Brain.num("FlankD", 22))
	return { x = t.x + (-h.z / hl) * s * side - h.x / hl * 4, z = t.z + (h.x / hl) * s * side - h.z / hl * 4, cos = cos }
end

local function retreat(u, why)
	Brain.order(u, O.RETREAT, 0, 0, 0, why)
	if A.st[u.id] == nil or A.st[u.id].mode ~= "retreat" then
		A.stats.retreat = A.stats.retreat + 1
		-- the fight's clock (the human measure: the first retreat comes ~19 s into a fight, one squad at a time)
		local F = u.fight
		local k = F and F.keep
		if k ~= nil then k.rets = (k.rets or 0) + 1 end
		Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "RETREAT", "why", table.concat(why, " "),
			"fight_age", F and f0(F.age) or "-", "nth", k and k.rets or "-")
	end
	A.st[u.id] = { mode = "retreat", t = Brain.now }
end
local function go_home(u, W, why)
	if W.home == nil then return end
	Brain.order(u, O.MOVE, W.home.x, W.home.y, W.home.z, why)
	if A.st[u.id] == nil or A.st[u.id].mode ~= "retreat" then
		A.stats.home = A.stats.home + 1
		Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "HOME", "why", table.concat(why, " "))
	end
	A.st[u.id] = { mode = "retreat", t = Brain.now, walk = true }
end

-- A squad that WALKS away from the enemy (a loner going back to the fist, a lost fight left on foot, the support sent
-- to our point behind) and takes losses on the way gets the retreat order (step 3; bench 13.11, f_1c56ef_6m28: sluggas
-- walking away from five squads went 6 -> 3 models in 10 s before the 'dying' rule gave the order). Not from a scratch
-- (R3): under fire AND
--   a model lost since the walk began and models x health below WalkRetEff (0.7), or
--   models x health down by WalkLossEff (0.3) since the walk began and below WalkLossMaxEff (0.6) - a hero, a squad
--   whose boys are all hurt.
-- (The first cut of the rule - any 0.15 of models x health - sent sluggas home at 0.74 with six boys of six and the
-- warboss at 0.63: bench label s3_a.) st.eff0 / st.n0 = the squad when the walk began. Brain_WalkRet=0: off.
local WALKING = { wait = true, regroup = true, walk = true, behind = true, back = true }
local function eff0_of(u)
	local st = A.st[u.id]
	if st ~= nil and WALKING[st.mode] and st.eff0 ~= nil then return st.eff0, st.n0 or u.n end
	return u.eff, u.n
end
local function bleeds(u, e0, n0)
	if not (u.hit and u.can_ret) or Brain.num("WalkRet", 1) < 1 then return false end
	if (n0 or u.n) - u.n >= 1 and u.eff < Brain.num("WalkRetEff", 0.7) then return true end
	return (e0 - u.eff) >= Brain.num("WalkLossEff", 0.3) and u.eff < Brain.num("WalkLossMaxEff", 0.6)
end
-- why the army took a squad this tick (for 55_capture.ai's DROP line: the reason must be the true one)
function A.why_taken(u)
	local st = A.st[u.id]
	local m = st and st.mode or nil
	if u.retreating then return (st ~= nil and st.not_ours) and "it retreats (not by the brain's order)" or "it retreats (the retreat order)" end
	if m == "retreat" then return st.walk and "it drives home hurt" or "the retreat order" end
	if m == "heal" then return "it heals at home" end
	if u.fight ~= nil then
		if m == "wait" or m == "regroup" then return "alone against a group in " .. tostring(u.fight.key) .. " (" .. m .. ")" end
		return "in a fight " .. tostring(u.fight.key)
	end
	if m == "join" then return "called to a fight" end
	if m == "step" or m == "behind" or m == "walk" or m == "back" then return "walking back from a lost fight (" .. m .. ")" end
	return "taken by the army (" .. tostring(m) .. ")"
end

-- ---- 1. survive ------------------------------------------------------------------------------------------------------
A.nhist = {}
local function survive(u, W, taken)
	local now = W.now
	local st = A.st[u.id]
	-- (the squad's models over the last FastLossSecs: the rule 'losing models fast' below)
	local h = A.nhist[u.id]
	if h == nil then h = {}; A.nhist[u.id] = h end
	table.insert(h, { t = now, n = u.n })
	while h[1] ~= nil and now - h[1].t > Brain.num("FastLossSecs", 10) do table.remove(h, 1) end
	if st ~= nil and (st.mode == "retreat" or st.mode == "heal") then
		taken[u.id] = true
		if u.retreating then return end
		if u.home then
			if st.mode ~= "heal" then st.mode, st.t = "heal", now end
			local prof = Brain.roles.profile()
			local to = Brain.num("ReinforceTo", (prof and prof.reinforce_to) or 0.8)
			local missing = math.ceil(u.full * to) - u.n
			if missing > 0 and not u.hit and u.can_ret then
				if missing > 4 then missing = 4 end
				Brain.order(u, O.REINFORCE, missing, 0, 0, { "refill at home", "models", u.n, "of", u.full })
			end
			local healed = (u.hp >= Brain.num("HealHP", 0.8) and missing <= 0)
			local waited = (now - st.t >= Brain.num("HealMaxSecs", 45) and u.hp >= Brain.num("HealMinHP", 0.6))
			if healed or waited then
				A.st[u.id] = nil; taken[u.id] = nil
				Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "BACK", "why", healed and "healed and refilled" or "waited long enough",
					"hp", f2(u.hp), "models", u.n .. "/" .. u.full)
			end
			return
		end
		-- not at home and not running: the order did not take, or it was a walk
		if now - st.t >= 3 then
			if u.can_ret and u.hit and u.eff < Brain.num("DyingEff", 0.3) and not st.walk then
				Brain.order(u, O.RETREAT, 0, 0, 0, { "dying, still out", "eff", f2(u.eff) })
			elseif W.home ~= nil then
				Brain.order(u, O.MOVE, W.home.x, W.home.y, W.home.z, { "on its way home", "hp", f2(u.hp) })
			end
		end
		return
	end
	-- a squad that runs home without an order of the brain (the engine's own squad logic does that even at aggression 1.0:
	-- bench 13.11; or a person's order just before the brain took over): it cannot be stopped - it is treated as retreating
	-- (no orders, not the fist's, no capture job), healed and refilled at home like the others, and named in the log
	if u.retreating then
		taken[u.id] = true
		A.stats.not_ours = A.stats.not_ours + 1
		Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "RETREAT_SEEN", "why", "it runs home without an order of the brain (the engine's own rule)",
			"hp", f2(u.hp), "models", u.n .. "/" .. u.full, "fight", (u.fight and u.fight.key) or "-")
		A.st[u.id] = { mode = "retreat", t = now, not_ours = true }
		return
	end
	if not u.hit then return end
	local F = u.fight
	if u.can_ret then
		local press = (F ~= nil and F.verdict == "press")
		-- (step 6, mark 1: 'RETREAT why dying eff 0.06 hp 0.35 models 1/6' - in a pressed fight only the HEALTH of the boys
		-- left was asked, and five of six died first: a squad down to PressRetModels (a third) of its models is dying too)
		local few = (u.full >= 3 and u.n <= math.max(1, math.floor(u.full * Brain.num("PressRetModels", 0.34))))
		if u.eff < Brain.num("DyingEff", 0.3) and (not press or u.hp < Brain.num("PressRetHP", 0.5) or few) then
			taken[u.id] = true
			retreat(u, { "dying", "eff", f2(u.eff), "hp", f2(u.hp), "models", u.n .. "/" .. u.full, "fight", F and F.key or "-", F and f2(F.ratio) or "-" })
		elseif F ~= nil and (not press or Brain.num("FastLossPress", 1) >= 1) and Brain.num("FastLoss", 1) >= 1 then
			-- Step 5 (the price of step 3: model losses on lib3 32 -> 62, and squads began to die - 0 scenes with a squad lost
			-- at step 2, 4 at step 3; r38_ork_005074_3m33: a shoota squad held an 'even' fight, ratio 0.8-0.9, against one
			-- strong squad, went 5 -> 3 -> 1 models and died on the way home after 'dying eff 0.28, models 2/5'; the human
			-- pulled the same squad out at 4 of 5). A squad that LOSES MODELS FAST - FastLossFrac (0.3) of its full count,
			-- 2 at least, within FastLossSecs (10 s) - in a fight that is not pressed and where we lose more than the enemy
			-- gets the retreat order while it still has the health to get home (below FastLossEff 0.7).
			local n0 = u.n
			for _, e in ipairs(h) do if e.n > n0 then n0 = e.n end end
			local lost = n0 - u.n
			-- (step 6: in a PRESSED fight too - half the squad gone in 10 s while we lose twice what the enemy loses)
			local need = math.max(2, math.ceil(u.full * (press and Brain.num("FastLossFracPress", 0.5) or Brain.num("FastLossFrac", 0.3))))
			local against = (F.loss_en or 0) < (F.loss_ours or 0)
			if press then against = (F.loss_ours or 0) > 2 * (F.loss_en or 0) end
			if lost >= need and u.eff < Brain.num("FastLossEff", 0.7) and against then
				taken[u.id] = true
				retreat(u, { "losing models fast:", lost, "in", f0(Brain.num("FastLossSecs", 10)), press and "s in a pressed fight that trades badly" or "s in a fight that is not won", "eff", f2(u.eff), "models", u.n .. "/" .. u.full,
					"fight", F.key, f2(F.ratio), "lost10s", f0(F.loss_ours or 0) .. ":" .. f0(F.loss_en or 0) })
			end
		end
	elseif u.hp < Brain.num("MachineHomeHP", 0.5) then
		taken[u.id] = true
		go_home(u, W, { "machine hurt under fire", "hp", f2(u.hp), "fight", F and F.key or "-" })
	end
end

-- ---- 2. fights -------------------------------------------------------------------------------------------------------
-- The line above which a fight is pressed and an enemy seen near is attacked: Win (1.3); in the late game (from LateSecs
-- 840 s = the people's T3 hour on) LateWin (1.0) - with an even or better army the fist pushes (tester Malum, fb 860 and
-- before: "in the late game both bots are too careful - no wall on wall").
function A.win_line(W)
	if W.now >= Brain.num("LateSecs", 840) then return math.min(Brain.num("LateWin", 1.0), Brain.num("Win", 1.3)) end
	return Brain.num("Win", 1.3)
end
-- the verdict of this tick by the numbers alone
local function judge(F, W)
	local s_en = F.s_en
	-- what we saw here seconds ago and do not see now still counts, at a discount (memory, not sight)
	local gh = {}
	for _, g in ipairs(W.ghosts) do if d2(g.x, g.z, F.x, F.z) <= Brain.num("ClumpR", 35) + 15 then table.insert(gh, g) end end
	if table.getn(gh) > 0 then s_en = s_en + Brain.num("GhostK", 0.5) * Brain.perception.strength(gh, Brain.perception.mix_of(F.ours)) end
	F.ghosts = table.getn(gh)
	local r, ra = F.s_ours / math.max(s_en, 1), F.s_all / math.max(s_en, 1)
	-- smoothed over the ticks of this fight: who stands within EngageR changes every second, the verdict must not (bench, 13.11)
	local k = Brain.num("RatioNewK", 0.6)
	if F.rs ~= nil then r, ra = k * r + (1 - k) * F.rs, k * ra + (1 - k) * F.ras end
	local rac = (F.s_allc or F.s_all) / math.max(s_en, 1)
	if F.rcs ~= nil then rac = k * rac + (1 - k) * F.rcs end
	F.rs, F.ras, F.rcs = r, ra, rac
	F.ratio, F.ratio_all, F.ratio_cap = r, ra, rac
	-- the lines between the verdicts have a width (step 2, bench 13.11: with the same five squads in a fight the ratio
	-- wandered 1.09-1.47 around Win and the verdict went PRESS, HOLD, PRESS five times): a verdict gets WORSE only when the
	-- ratio is VerdictBand (15 %) below the line, it gets better at the line itself
	local band = 1 - Brain.num("VerdictBand", 0.15)
	local cur = F.verdict
	if F.keep ~= nil and F.keep.ph then cur = nil end                    -- (the HOLD of a first look is a wait, not a verdict that was held)
	local win, even, lost, sup = A.win_line(W), Brain.num("Even", 0.8), Brain.num("Lost", 0.45), Brain.num("SupportHold", 1.0)
	if cur == "press" then win = win * band end
	if cur == "press" or cur == "hold" then even, sup = even * band, sup * band end
	if cur == "press" or cur == "hold" or cur == "step" then lost = lost * band end
	-- the capturers near (F.capsup: squads with a capture job within SupportR). They keep their job unless the fight is
	-- ours to lose and they are needed: lost or a step back without them, even with them - then all of them are called
	-- (F.call = "all"). The hero is not kept out of a fight: it is called whenever the fight is not won without it ("hero").
	F.call = nil
	if r < win and Brain.capture ~= nil then
		for _, u in ipairs(F.capsup or {}) do if Brain.capture.is_hero(u) then F.call = "hero" end end
	end
	-- Step 6 (Orca's match 2, mark 1: 'lost a squad for nothing, misjudged the damage' - 'fight F1 PRESS why stronger ratio
	-- 2.01 ... lost10s 441:63', the sluggas went 6 -> 1 in it; mark 6: 'F10 PRESS why stronger ratio 2.43 ... lost10s 448:3').
	-- The numbers on paper are checked against THE TRADE of the last 10 s once the fight is TradeFixSecs (12 s) old and we
	-- lost TradeFixMin (200) health in them:
	--   a rout: we lost TradeRoutK (4) x the enemy's losses + 150 (and our mobs are not in the scrap yet, or the fight is
	--     TradeRoutScrapSecs 20 s old), the paper ratio below TradeRoutMaxRatio (3) -> STEP, and the place is burnt ground;
	--   bad: TradeBadK (2) x + 150 -> a fight 'stronger on paper' is a HOLD (nobody is called in, the squads that lose
	--     models fast are sent home by the survive rule - which does not apply to a pressed fight).
	local lo, le = F.loss_ours or 0, F.loss_en or 0
	local machine = false
	for _, u in ipairs(F.ours) do if u.veh then machine = true end end
	F.trade = nil
	if Brain.num("TradeFix", 1) >= 1 and F.age >= Brain.num("TradeFixSecs", 12) and lo >= Brain.num("TradeFixMin", 200) then
		local scrap = false
		for _, u in ipairs(F.ours) do if u.mel and u.ed ~= nil and u.ed <= Brain.num("ScrapD", 8) then scrap = true end end
		if lo > Brain.num("TradeRoutK", 4) * le + 150 and (not scrap or F.age >= Brain.num("TradeRoutScrapSecs", 20)) then F.trade = "rout"
		elseif lo > Brain.num("TradeBadK", 2) * le + 150 then F.trade = "bad" end
		if F.trade == "rout" and r < Brain.num("TradeRoutMaxRatio", 3) then
			zone_note(F, W, lo, le)
			F.call = nil
			return "step", "routed on the trade: we lost " .. f0(lo) .. " against " .. f0(le) .. " in 10 s - the paper says " .. f2(r)
		end
	end
	local zq = A.zone_at(F.x, F.z)
	-- (a turret's circle stops a fight only when the trade is already bad: a fight that goes well next to a turret goes on)
	if zq ~= nil and zq.turret ~= nil and F.trade == nil then zq = nil end
	if zq ~= nil and not machine and r < Brain.num("ZonePressRatio", 2) and F.trade ~= "rout" and le <= lo then
		F.call = nil
		if zq.turret ~= nil then return "step", "under the enemy's turret at " .. zq.turret.key .. ": not without a machine or twice its strength" end
		return "step", "burnt ground (routed here " .. f0(W.now - zq.t) .. " s ago, " .. zq.n .. " x): not again without a machine or twice its strength"
	end
	if r >= win then
		if F.trade == "bad" then return "hold", "stronger on paper, but we lose " .. f0(lo) .. " against " .. f0(le) .. " in 10 s" end
		return "press", "stronger"
	end
	if r >= even then
		if F.age >= Brain.num("TradeSecs", 10) and ra < Brain.num("TradeRatioAll", 1.0)
			and F.loss_ours > Brain.num("TradeK", 1.5) * F.loss_en + Brain.num("TradeMin", 150) then
			return "step", "bleeding: we lose more than the enemy and are no stronger"
		end
		return "hold", "even fight"
	end
	if ra >= sup and table.getn(F.support) > 0 then return "hold", "weaker alone, even with the support near" end
	if rac >= sup and table.getn(F.capsup or {}) > 0 then F.call = "all"; return "hold", "weaker without the capturers near, even with them: they are called" end
	F.call = nil                                                         -- (nobody is called into a fight that is lost anyway)
	if r >= lost then return "step", "weaker" end
	return "leave", "lost"
end

-- our point behind the fight (closer to home than the fight, out of it, no visible enemy at it); else home
local function fallback(F, W)
	local h = W.home
	if h == nil then return nil end
	local dfh = d2(F.x, F.z, h.x, h.z)
	local best, bd
	for _, p in ipairs(W.pts) do
		if p.ours then
			local dp, dh = d2(p.x, p.z, F.x, F.z), d2(p.x, p.z, h.x, h.z)
			if dh < dfh - 15 and dp >= Brain.num("FallMinD", 60) then
				local clear = true
				for _, e in ipairs(W.en) do if d2(e.x, e.z, p.x, p.z) <= 35 then clear = false; break end end
				if clear and (bd == nil or dp < bd) then best, bd = p, dp end
			end
		end
	end
	if best ~= nil then return { x = best.x, y = best.y, z = best.z, key = best.key } end
	return { x = h.x, y = h.y, z = h.z, key = "home" }
end

-- one squad in a fight we take (PRESS / HOLD): by its role
local function engage(u, F, W)
	local roles = Brain.roles
	local role = roles.of(u)
	-- Step 6: grenades and the hero's abilities first (70_abilities.ai B.on_fight); a throw is not cancelled by a new order
	if Brain.abilities.on_fight ~= nil and Brain.abilities.on_fight(u, role, F, W) == "busy" then return end
	if roles.is_melee(role) then
		local t = roles.melee_target(u, F)
		if t ~= nil then
			local dist = d2(u.x, u.z, t.x, t.z)
			local cast = Brain.abilities.on_charge(u, role, t, dist)
			-- Step 6 (R37, marks 7-8 'no counter to set-up teams'): a mob in front of a set-up team's barrel does not run
			-- down the barrel - it goes to the place beside the team (FlankD 22 m to the side it is on) and charges from there
			local fp = (cast ~= "pos" and role ~= "jump") and flank_point(u, t) or nil
			-- (the team turns its barrel after the mob: FlankMaxSecs (8 s) of going round one team, then the charge - no
			-- circling; again not before FlankAgainSecs 30 s)
			if fp ~= nil then
				local fk = A.flanks[u.id]
				if fk == nil or fk.tid ~= t.id or W.now - fk.t0 > Brain.num("FlankAgainSecs", 30) then fk = { tid = t.id, t0 = W.now }; A.flanks[u.id] = fk end
				if W.now - fk.t0 > Brain.num("FlankMaxSecs", 8) then fp = nil end
			end
			if fp ~= nil then
				A.stats.flank = (A.stats.flank or 0) + 1
				Brain.order(u, O.MOVE, fp.x, u.y, fp.z, { "flank the set-up team", t.id, Brain.short(t.key), "dist", f0(dist), "in its arc cos", f2(fp.cos), F.key })
			elseif cast ~= "pos" then
				if Brain.order(u, O.MELEE, t.id, 0, 0, { "charge", t.id, Brain.short(t.key), "dist", f0(dist), F.key, F.verdict }) then
					A.stats.charge = A.stats.charge + 1
				end
			end
		end
		-- (only vehicles in reach: a choppa does a tenth to armour - the squad stays with the line, no order)
		return
	end
	-- Step 5 (tester Malum, fb 860: "killa kans / the deff dread are lost while milling around"; bench lib3 / lib7, the
	-- dread's orders in a fight: 'close to range 45' - 'not ahead of the infantry' - 'close to range 45' ... it was led as
	-- a gun with a range of 45 m that may not pass the boyz, and never charged). A MELEE WALKER goes in with the line: it
	-- charges the enemy the mobs would charge once our nearest infantry is within WalkerLeadD (12 m) of being as close as
	-- it is; further ahead than that it waits where it stands (one order, not back and forth). Brain_WalkerMelee=0: as before.
	if role == "walker" and u.d ~= nil and u.d.mel == 1 and Brain.num("WalkerMelee", 1) >= 1 then
		local di, k = nil, 0
		for _, v in ipairs(F.ours) do
			local vr = roles.of(v)
			if not roles.is_machine(vr) and not roles.is_rear(vr) then
				k = k + 1
				if v.ed ~= nil and (di == nil or v.ed < di) then di = v.ed end
			end
		end
		local st = A.st[u.id]
		-- (not once it is in the scrap: bench s5_w_b, r33_ork_deff_dread_140c4e - 'waits for the boyz its 3 theirs 22' pulled it
		-- out of a melee for a second; within WalkerInD 15 m of the enemy it fights on)
		if k > 0 and u.ed ~= nil and di ~= nil and u.ed < di - Brain.num("WalkerLeadD", 12) and u.ed > Brain.num("WalkerInD", 15) then
			if st == nil or st.mode ~= "walker_wait" then
				A.st[u.id] = { mode = "walker_wait", t = W.now }
				Brain.order(u, O.MOVE, u.x, u.y, u.z, { "walker: waits for the boyz", "its", f0(u.ed), "theirs", f0(di), F.key })
			end
			return
		end
		local t = roles.melee_target(u, F)
		if t == nil then
			local bd
			for _, e in ipairs(F.en) do
				local dist = d2(u.x, u.z, e.x, e.z)
				if dist <= Brain.num("ChargeR", 45) and (bd == nil or dist < bd) then t, bd = e, dist end
			end
		end
		if t ~= nil and (k > 0 or F.verdict == "press") then
			A.st[u.id] = { mode = "walker_charge", t = W.now }
			if Brain.order(u, O.MELEE, t.id, 0, 0, { "walker: charge with the line", t.id, Brain.short(t.key), "dist", f0(d2(u.x, u.z, t.x, t.z)), "boyz at", f0(di or -1), F.key, F.verdict }) then
				A.stats.charge = A.stats.charge + 1
			end
			return
		end
		if u.ed == nil or u.ed > Brain.num("ChargeR", 45) - 5 then
			Brain.order(u, O.AMOVE, F.x, u.y, F.z, { "walker: to the fight", "enemy at", f0(u.ed or -1), F.key, F.verdict })
		end
		return
	end
	if roles.is_machine(role) or roles.is_rear(role) then
		-- R33: a machine (and a healer) is never the first into the enemy: not closer to it than our nearest infantry
		local di, sx, sz, k = nil, 0, 0, 0
		for _, v in ipairs(F.ours) do
			local vr = roles.of(v)
			if not roles.is_machine(vr) and not roles.is_rear(vr) then
				if v.ed ~= nil and (di == nil or v.ed < di) then di = v.ed end
				sx, sz, k = sx + v.x, sz + v.z, k + 1
			end
		end
		local lead = roles.is_rear(role) and Brain.num("RearBehindD", 12) or Brain.num("MachineBehindD", 5)
		if k > 0 and u.ed ~= nil and di ~= nil and u.ed < di + lead - 5 then
			Brain.order(u, O.MOVE, sx / k, u.y, sz / k, { "not ahead of the infantry", "its", f0(u.ed), "theirs", f0(di), F.key })
			return
		end
		if roles.is_rear(role) then return end
	end
	local rng = (u.d ~= nil and u.d.rng > 0) and u.d.rng or 35
	-- Step 6: cover (see A.find_cover above). Not for a machine.
	local now = W.now
	local cv = A.cover.at[u.id]
	local use_cover = not roles.is_machine(role) and Brain.num("Cover", 1) >= 1
	if cv ~= nil and (cv.fight ~= F.key or now - cv.t >= Brain.num("CoverHoldSecs", 20)) then cv = nil; A.cover.at[u.id] = nil end
	if cv ~= nil then
		local dc = d2(u.x, u.z, cv.x, cv.z)
		if dc > 4 and now - cv.t < Brain.num("CoverWalkSecs", 8) then return end              -- on its way to the spot
		if dc <= 4 and u.ed ~= nil and u.ed <= rng then return end                              -- in the spot, the enemy in range: it shoots
	end
	if u.ed == nil or u.ed > rng - 3 then
		local c, ced
		if use_cover and u.ed ~= nil and u.ed <= rng + Brain.num("CoverApproachD", 25) then
			local ne, nd
			for _, e in ipairs(F.en) do local d = d2(u.x, u.z, e.x, e.z); if nd == nil or d < nd then ne, nd = e, d end end
			if ne ~= nil and nd > 1 then
				local k = (rng - 6) / nd
				c, ced = A.find_cover(u, ne.x + (u.x - ne.x) * k, ne.z + (u.z - ne.z) * k, Brain.num("CoverR", 12), F.en, rng)
			end
		end
		if c ~= nil then
			A.cover.at[u.id] = { x = c.x, z = c.z, t = now, fight = F.key }
			Brain.order(u, O.MOVE, c.x, c.y, c.z, { "to cover in range", f0(rng), "enemy at", f0(u.ed or -1), "from the spot", f0(ced or -1), F.key, F.verdict })
		else
			Brain.order(u, O.AMOVE, F.x, u.y, F.z, { "close to range", f0(rng), "enemy at", f0(u.ed or -1), F.key, F.verdict })
		end
	elseif use_cover then
		-- in range: it stands and shoots - from the cover spot within CoverR (12 m) when there is one
		local c, ced = A.find_cover(u, u.x, u.z, Brain.num("CoverR", 12), F.en, rng)
		if c ~= nil then
			A.cover.at[u.id] = { x = c.x, z = c.z, t = now, fight = F.key }
			Brain.order(u, O.MOVE, c.x, c.y, c.z, { "to cover: it stood in the open", "enemy at", f0(u.ed or -1), "from the spot", f0(ced or -1), F.key, F.verdict })
		end
	end
end

-- R7 "a loner does not engage a group" (step 2; bench 13.11: one shoota squad that met three squads was judged as its
-- own fight 1 : 3, verdict LEAVE, the retreat order). One squad of ours against LonerEnemy (2) or more enemy squads, not
-- stronger than all of them by itself, with an army to go back to: this is not a fight of ours - verdict AVOID.
--   the fist is near and with it we are no weaker (with_support >= Even): the squad WAITS LonerKeepD (50 m) from the enemy,
--     out of its guns, the support walks up; when a second squad is in, the fight is judged as any other;
--   else it walks back to the fist (REGROUP) - the fist weighs that enemy as a threat by its own rule;
--   shot at by an overwhelming enemy (ratio below LonerRetRatio) and hurt below LonerRetHP: the retreat order (one squad,
--     not within LeaveRetGap of another retreat order in this fight).
-- The verdict AVOID has a hysteresis of its own (step 3; bench 13.11: 4 of the 4 'there and back' verdict changes left
-- were AVOID <-> another verdict - the squad is alone, then a second one steps into the circle, then out):
--   in:  at once from a first look or a bad verdict; from a fight we were taking (PRESS / HOLD) only when the squad has
--        been alone AvoidInTicks (2) ticks;
--   out: at once when the fight has become one we take by the numbers (PRESS / HOLD with the squads now in it); while
--        the numbers are still bad AVOID stands for AvoidHoldSecs (4 s) after the last tick the squad was alone - the
--        squads in it then all do what the loner does (out of range / back to the fist), not a STEP for 2 s and AVOID again.
-- A squad that walks away and loses models gets the retreat order (bleeds() above), without waiting for 'dying'.
-- 'v' = this tick's verdict by the numbers (judge). Returns true when the fight was handled here.
local function loner(F, W, taken, v)
	if Brain.num("Loner", 1) < 1 then return false end
	local now, K = W.now, F.keep
	local n_ours = table.getn(F.ours)
	local n_en = table.getn(F.en) + (F.ghosts or 0)
	local alone = (n_ours == 1 and n_en >= Brain.num("LonerEnemy", 2) and F.ratio < Brain.num("Win", 1.3))
	local was = (F.verdict == "avoid")
	local vhold = Brain.num("VerdictHoldSecs", 4)                        -- every verdict stands this long, AVOID too (see fight())
	local stood = now - (F.verdict_t or now)
	if alone then
		if not was and F.verdict ~= nil and not K.ph then
			if stood < vhold then return false end
			if F.verdict == "press" or F.verdict == "hold" then
				K.alone_n = (K.alone_n or 0) + 1
				if K.alone_n < Brain.num("AvoidInTicks", 2) then return false end
			end
		end
	else
		K.alone_n = nil
		if not was or n_ours == 0 then return false end
		if RANK[v] >= RANK.hold then if stood >= vhold then return false end
		elseif now - (K.avoid_last or -100) >= Brain.num("AvoidHoldSecs", 4) and stood >= vhold then return false end
	end
	-- the army it can go back to: the squads that are in no fight and not on their way home
	local sx, sz, sy, k = 0, 0, 0, 0
	for _, w in ipairs(W.army) do
		local st = A.st[w.id]
		if w.fight == nil and not w.retreating and not (st ~= nil and (st.mode == "retreat" or st.mode == "heal" or st.mode == "cap" or st.mode == "post")) then
			sx, sz, sy, k = sx + w.x, sz + w.z, sy + w.y, k + 1
		end
	end
	if k == 0 then return false end                                      -- nobody to wait for: it is judged as a fight
	if not was then
		F.verdict, F.verdict_t, F.pending, F.pending_n = "avoid", now, nil, nil
		A.stats.verdicts = A.stats.verdicts + 1
	end
	if alone then K.avoid_last = now end
	local coming = (table.getn(F.support) > 0 and F.ratio_all >= Brain.num("Even", 0.8))
	Brain.say("ARMY", "fight|" .. F.key, Brain.num("FightLogSecs", 5), { "fight", F.key, "AVOID", "why", alone and "one squad against" or "held: was one squad against", n_en,
		"- not its fight alone:", coming and "it waits for the fist" or "back to the fist", "ratio", f2(F.ratio), "with_support", f2(F.ratio_all), "ours", n_ours, f0(F.s_ours),
		"enemy", table.getn(F.en), f0(F.s_en), "ghosts", F.ghosts or 0, "lost10s", f0(F.loss_ours) .. ":" .. f0(F.loss_en), "support", table.getn(F.support),
		"age", f0(F.age), "at", f0(F.x), f0(F.z) }, "avoid|" .. (coming and "wait" or "back"))
	for _, w in ipairs(F.support) do
		if not taken[w.id] and coming then
			taken[w.id] = true; A.st[w.id] = { mode = "join", t = now }
			Brain.order(w, O.AMOVE, F.x, w.y, F.z, { "join: one of ours waits there", F.key, "with_support", f2(F.ratio_all) })
		end
	end
	local what = coming and "wait" or "regroup"
	for _, u in ipairs(F.ours) do
		if not taken[u.id] then
			taken[u.id] = true
			local e0, n0 = eff0_of(u)
			local over
			if Brain.num("WalkRet", 1) >= 1 then over = (u.eff < Brain.num("LonerRetEff", 0.5)) else over = (u.hp < Brain.num("LonerRetHP", 0.5)) end
			over = over and u.hit and u.can_ret and F.ratio < Brain.num("LonerRetRatio", 0.3) and now - (K.ret_t or -100) >= Brain.num("LeaveRetGap", 5)
			if bleeds(u, e0, n0) then
				K.ret_t = now
				retreat(u, { "alone, walking away from a group and taking losses", F.key, "enemy", n_en, "eff", f2(e0), "->", f2(u.eff), "models", n0, "->", u.n, "of", u.full })
			elseif over then
				K.ret_t = now
				retreat(u, { "alone, shot at by an overwhelming enemy and hurt", F.key, "enemy", n_en, "ratio", f2(F.ratio), "eff", f2(u.eff), "hp", f2(u.hp) })
			else
				local st = A.st[u.id]
				if st == nil or st.mode ~= what then
					A.stats.loner = A.stats.loner + 1
					Brain.log("ARMY", "squad", u.id, Brain.short(u.key), coming and "WAITS" or "REGROUP", "why", "alone against", n_en, "enemy squads", "ratio", f2(F.ratio),
						"with_support", f2(F.ratio_all), coming and "the fist is coming: it holds out of range" or "back to the fist", "fist", k, "at", f0(sx / k), f0(sz / k), F.key)
				end
				A.st[u.id] = { mode = what, t = now, eff0 = e0, n0 = n0 }
				if coming then
					local keep = Brain.num("LonerKeepD", 50)
					-- (step 6, marks 7-8: 'WAITS ... it holds out of range' while 'lost10s 459:0' - 50 m is inside a devastator's
					-- 49 m once it turns; out of range = the longest gun seen there + LonerKeepPad 10 m. Still shot at out
					-- there (a turret the brain does not see) - back to the fist)
					local mr = 0
					for _, e in ipairs(F.en) do if e.d ~= nil and (e.d.rng or 0) > mr then mr = e.d.rng end end
					if Brain.num("LonerKeepRange", 1) >= 1 then keep = math.max(keep, mr + Brain.num("LonerKeepPad", 10)) end
					local ed = u.ed or keep
					if u.hit and ed >= keep - 6 and Brain.num("LonerKeepRange", 1) >= 1 then
						Brain.order(u, O.MOVE, sx / k, sy / k, sz / k, { "alone: shot at out of range (a gun we do not see): back to the fist", "enemy at", f0(ed), F.key })
					elseif ed < keep - 4 then
						-- away from the nearest enemy squad, along the line from the enemy's centre through the squad
						local dx, dz = u.x - F.x, u.z - F.z
						local d = math.sqrt(dx * dx + dz * dz)
						if d < 1 then dx, dz, d = (sx / k) - u.x, (sz / k) - u.z, math.max(d2(u.x, u.z, sx / k, sz / k), 1) end
						local step = keep - ed + 4
						Brain.order(u, O.MOVE, u.x + dx / d * step, u.y, u.z + dz / d * step, { "alone: out of range, the fist is coming", "enemy at", f0(ed), F.key })
					end
				else
					Brain.order(u, O.MOVE, sx / k, sy / k, sz / k, { "alone against", n_en, ": back to the fist", F.key, "ratio", f2(F.ratio) })
				end
			end
		end
	end
	return true
end

local function fight(F, W, taken)
	local now = W.now
	local v, why = judge(F, W)
	-- who is in the fight: a line when the list changes (with the hysteresis of 10_perception.ai this is rare)
	local keep = F.keep
	if keep.ids ~= nil and keep.ids ~= F.ids then
		local is, pin, pout = {}, {}, {}
		for _, u in ipairs(F.ours) do is[u.id] = true; if not keep.idset[u.id] then table.insert(pin, "+" .. u.id) end end
		for _, id in ipairs(keep.idlist) do if not is[id] then table.insert(pout, "-" .. id) end end
		A.stats.mem_in, A.stats.mem_out = A.stats.mem_in + table.getn(pin), A.stats.mem_out + table.getn(pout)
		Brain.log("ARMY", "fight", F.key, "MEMBERS", table.concat(pin, " "), table.concat(pout, " "), "ours", table.getn(F.ours), "age", f0(F.age))
	end
	if keep.ids ~= F.ids then
		keep.ids, keep.idset, keep.idlist = F.ids, {}, {}
		for _, u in ipairs(F.ours) do keep.idset[u.id] = true; table.insert(keep.idlist, u.id) end
	end
	-- first contact (the fight's clock starts here: 10_perception.ai)
	if keep.tc ~= nil and not keep.tc_said then
		keep.tc_said = true
		Brain.log("ARMY", "fight", F.key, "CONTACT", keep.tc_first and "it was on when the brain took over (the age is a lower bound)" or "first fire",
			"seen", f0(F.seen_age), "s before", "ours", table.getn(F.ours), "enemy", table.getn(F.en))
	end
	if loner(F, W, taken, v) then return end
	if F.verdict == "avoid" then
		-- no loner any more. Good numbers: a first look. Bad numbers (they were bad all through AVOID): that verdict at
		-- once - not a HOLD 'first look' with a charge for two seconds in between
		-- Step 5 (the verifier on lib3: three AVOID -> LEAVE / STEP after 1-3 s - the loner had left the fight or had nobody
		-- to go back to): AVOID stands its VerdictHoldSecs like every verdict; for the seconds left the squads go on with
		-- what AVOID told them (a dying squad still leaves by the survive rule at any second).
		local stood = now - (F.verdict_t or now)
		if RANK[v] < RANK.hold and Brain.num("AvoidHoldSecs", 4) > 0 then
			if stood < Brain.num("VerdictHoldSecs", 4) and Brain.num("AvoidStands", 1) >= 1 then
				Brain.say("ARMY", "fight|" .. F.key, Brain.num("FightLogSecs", 5), { "fight", F.key, "AVOID", "why", "held: avoid stands " .. f0(Brain.num("VerdictHoldSecs", 4)) .. " s, " .. f0(stood) .. " so far - then",
					v, "ratio", f2(F.ratio), "with_support", f2(F.ratio_all), "ours", table.getn(F.ours), f0(F.s_ours), "enemy", table.getn(F.en), f0(F.s_en), "age", f0(F.age) }, "avoid|stands")
				for _, u in ipairs(F.ours) do taken[u.id] = true end
				return
			end
			F.verdict, F.verdict_t, F.pending, F.pending_n = v, now, nil, nil; A.stats.verdicts = A.stats.verdicts + 1
		else F.verdict, F.pending, F.pending_n = nil, nil, nil end
	end
	if F.verdict == nil then
		-- the first look at a fight: a bad verdict is not acted on at once either (it starts as HOLD and must stand its ticks)
		if RANK[v] >= RANK.hold then F.verdict, F.verdict_t = v, now
		else F.verdict, F.verdict_t, F.pending, F.pending_n = "hold", now, v, 1; F.keep.ph = true; why = why .. " (not yet: first look)" end
	elseif v ~= F.verdict then
		if F.pending == v then F.pending_n = (F.pending_n or 0) + 1 else F.pending, F.pending_n = v, 1 end
		local need = (RANK[v] < RANK[F.verdict]) and Brain.num("VerdictTicksDown", 2) or Brain.num("VerdictTicksUp", 1)
		-- every verdict stands VerdictHoldSecs (4 s) before the next one, better or worse (step 3; the verifier on lib3,
		-- r38_ork_007e41_0m45: PRESS <-> HOLD and HOLD <-> STEP with the same squads - the 15 % band is not enough). The
		-- first look's waiting HOLD is no verdict and is not held; a dying squad leaves by the survive rule at any second.
		local stood = now - (F.verdict_t or now)
		if not F.keep.ph and stood < Brain.num("VerdictHoldSecs", 4) then
			F.keep.held = true
			why = why .. " (not yet: " .. F.verdict .. " stands " .. f0(Brain.num("VerdictHoldSecs", 4)) .. " s, " .. f0(stood) .. " so far)"
		elseif F.pending_n >= need then F.verdict, F.verdict_t, F.pending, F.pending_n = v, now, nil, nil; F.keep.ph, F.keep.held = nil, nil; A.stats.verdicts = A.stats.verdicts + 1
		else F.keep.held = nil; why = why .. " (not yet: was " .. F.verdict .. ")" end
	else
		F.pending, F.pending_n, F.keep.ph, F.keep.held = nil, nil, nil, nil
	end
	v = F.verdict
	Brain.say("ARMY", "fight|" .. F.key, Brain.num("FightLogSecs", 5), { "fight", F.key, UP[v], "why", why, "ratio", f2(F.ratio),
		"with_support", f2(F.ratio_all), "ours", table.getn(F.ours), f0(F.s_ours), "enemy", table.getn(F.en), f0(F.s_en), "ghosts", F.ghosts or 0,
		"lost10s", f0(F.loss_ours) .. ":" .. f0(F.loss_en), "support", table.getn(F.support), "age", f0(F.age), "at", f0(F.x), f0(F.z) }, v .. "|" .. string.gsub(why, "[%d%.]+", "N"))
	if (v == "press" or v == "hold") and F.pending ~= nil and RANK[F.pending] < RANK[v] and not F.keep.held then
		-- a worse verdict is forming: no new charge, nobody is called in - the squads go on with what they do for this tick
		for _, u in ipairs(F.ours) do taken[u.id] = true end
		for _, u in ipairs(F.support) do taken[u.id] = true end
		return
	end
	if v == "press" or v == "hold" then
		-- the capturers that are called (judge: F.call): their job ends with the true reason, they come as support
		if F.call ~= nil then
			for _, u in ipairs(F.capsup or {}) do
				if not taken[u.id] and (F.call == "all" or Brain.capture.is_hero(u)) then
					Brain.capture.release(u, "called to the fight " .. F.key .. " " .. v .. ": ratio " .. f2(F.ratio) .. ", with the support " .. f2(F.ratio_all) ..
						", with the capturers " .. f2(F.ratio_cap) .. ((F.call == "hero") and " - the hero is not kept out of a fight that is not won" or " - lost without them"))
					table.insert(F.support, u)
				end
			end
		end
		for _, u in ipairs(F.ours) do
			if not taken[u.id] then taken[u.id] = true; A.st[u.id] = { mode = "fight", t = now }; engage(u, F, W) end
		end
		-- R33 for the support too (step 3; bench lib3, r33_ork_007e41_7m45: a trukk called to a fight drove to the enemy's
		-- centre ahead of the boys - 37 % of the scene's seconds in front of the infantry): a machine or a healer that is
		-- called joins our infantry in the fight (their centre), not the enemy; no infantry of ours there - it waits.
		local roles = Brain.roles
		local ix, iz, ik = 0, 0, 0
		for _, w in ipairs(F.ours) do
			local wr = roles.of(w)
			if not roles.is_machine(wr) and not roles.is_rear(wr) then ix, iz, ik = ix + w.x, iz + w.z, ik + 1 end
		end
		-- Step 7: the support comes in together (A.stage_gate): the squads that are called and still out of the enemy's
		-- reach wait at its edge for each other - not one by one into the fight as each gets back from the base
		local sup_wait = {}
		if Brain.num("Stage", 1) >= 1 and Brain.num("StageSupport", 1) >= 1 then
			local cand = {}
			for _, u in ipairs(F.support) do
				local ur = roles.of(u)
				if not taken[u.id] and not roles.is_machine(ur) and not roles.is_rear(ur) then table.insert(cand, u) end
			end
			if table.getn(cand) >= 2 then
				local g, ready, sn = A.stage_gate(F.key, cand, F.en, W, false, Brain.num("StageSupSecs", 6))
				if g == "wait" then
					for _, u in ipairs(cand) do sup_wait[u.id] = true; taken[u.id] = true end
					Brain.say("ARMY", "fstage|" .. F.key, 10, { "fight", F.key, "STAGE", "why", "the support waits at the edge of the enemy's reach for each other", "there", ready, "of", sn }, "stage")
				end
			end
		end
		for _, u in ipairs(F.support) do
			if not taken[u.id] then
				taken[u.id] = true; A.st[u.id] = { mode = "join", t = now }
				local ur = roles.of(u)
				if (roles.is_machine(ur) or roles.is_rear(ur)) and Brain.num("JoinBehind", 1) >= 1 then
					if ik > 0 then
						Brain.order(u, O.MOVE, ix / ik, u.y, iz / ik, { "join the fight behind our infantry", F.key, v, "infantry in it", ik })
					end
				else
					Brain.order(u, O.AMOVE, F.x, u.y, F.z, { "join the fight", F.key, v, "ratio", f2(F.ratio), "with_support", f2(F.ratio_all) })
				end
			end
		end
		return
	end
	local fb = fallback(F, W)
	if fb == nil then return end
	-- the human measure (baseline 13.11): the first retreat comes 19 s into a fight (10-33). A fight that is lost on the
	-- numbers but younger than LeaveMinAge is left by the fighting withdrawal (STEP) first; a dying squad still leaves by
	-- the survive rule at any second.
	if v == "leave" and F.age < Brain.num("LeaveMinAge", 10) then
		if not F.keep.young then F.keep.young = true; A.stats.young = A.stats.young + 1
			Brain.log("ARMY", "fight", F.key, "YOUNG", "why", "lost on the numbers, but the fight is", f0(F.age), "s old: a step back first, the retreat order not before", f0(Brain.num("LeaveMinAge", 10)), "s") end
		v, why = "step", "lost, the fight is young"
	end
	if v == "step" then
		local step_d, hold = Brain.num("StepD", 25), Brain.num("StepHoldSecs", 8)
		for _, u in ipairs(F.ours) do
			if not taken[u.id] then
				taken[u.id] = true
				local st = A.st[u.id]
				if st == nil or st.mode ~= "step" or now - st.t >= hold then
					local d = d2(u.x, u.z, fb.x, fb.z)
					local k = (d > step_d) and (step_d / d) or 1
					st = { mode = "step", t = now, tx = u.x + (fb.x - u.x) * k, tz = u.z + (fb.z - u.z) * k }
					A.st[u.id] = st
					A.stats.step = A.stats.step + 1
				end
				Brain.order(u, O.MOVE, st.tx, u.y, st.tz, { "step back", f0(step_d), "towards", fb.key, F.key, why, "ratio", f2(F.ratio) })
			end
		end
		for _, u in ipairs(F.support) do
			if not taken[u.id] then
				local e0, n0 = eff0_of(u)
				taken[u.id] = true; A.st[u.id] = { mode = "behind", t = now, tx = fb.x, tz = fb.z, eff0 = e0, n0 = n0 }
				Brain.order(u, O.MOVE, fb.x, fb.y, fb.z, { "wait behind the fight at", fb.key, F.key, "ratio", f2(F.ratio) })
			end
		end
		return
	end
	-- LEAVE
	-- the retreat order: shot at AND hurt (below LeaveRetEff). A healthy squad shot at in a lost fight walks back with the
	-- others and keeps its guns (R1's check: no X for a squad with half its health). One squad at a time: the most hurt
	-- first, the next not before LeaveRetGap s - people press X squad by squad (77 % of their retreats are one squad).
	-- (LeaveRetRatio > 0 = also a healthy squad when the enemy is that overwhelming; off by default.)
	local worst
	for _, u in ipairs(F.ours) do
		if not taken[u.id] and u.hit and u.can_ret and (u.eff < Brain.num("LeaveRetEff", 0.5) or F.ratio < Brain.num("LeaveRetRatio", 0)) then
			if worst == nil or u.eff < worst.eff then worst = u end
		end
	end
	if worst ~= nil and now - (F.keep.ret_t or -100) < Brain.num("LeaveRetGap", 5) then worst = nil end
	for _, u in ipairs(F.ours) do
		if not taken[u.id] then
			taken[u.id] = true
			if worst ~= nil and u.id == worst.id then
				F.keep.ret_t = now
				retreat(u, { "fight lost, shot at", (u.eff < Brain.num("LeaveRetEff", 0.5)) and "and hurt" or "by an overwhelming enemy", F.key, "ratio", f2(F.ratio), "eff", f2(u.eff) })
			elseif u.hit and not u.can_ret then
				go_home(u, W, { "fight lost, machine shot at", F.key, "ratio", f2(F.ratio) })
			elseif bleeds(u, eff0_of(u)) then
				local e0, n0 = eff0_of(u)
				F.keep.ret_t = now
				retreat(u, { "fight lost: walking away and taking losses", F.key, "ratio", f2(F.ratio), "eff", f2(e0), "->", f2(u.eff), "models", n0, "->", u.n, "of", u.full })
			else
				local e0, n0 = eff0_of(u)
				A.st[u.id] = { mode = "walk", t = now, tx = fb.x, tz = fb.z, eff0 = e0, n0 = n0 }
				A.stats.leave = A.stats.leave + 1
				Brain.order(u, O.MOVE, fb.x, fb.y, fb.z, { "fight lost: walk to", fb.key, F.key, "ratio", f2(F.ratio), u.hit and "shot at, not hurt" or "not shot at" })
			end
		end
	end
	for _, u in ipairs(F.support) do
		if not taken[u.id] then
			local e0, n0 = eff0_of(u)
			taken[u.id] = true; A.st[u.id] = { mode = "behind", t = now, tx = fb.x, tz = fb.z, eff0 = e0, n0 = n0 }
			Brain.order(u, O.MOVE, fb.x, fb.y, fb.z, { "fight lost near, not in it: walk to", fb.key, F.key })
		end
	end
end

-- ---- 3. the fist -----------------------------------------------------------------------------------------------------
-- where most of a list of squads stand: the squad with most neighbours within r, the mean of those
function A.group_centre(list, r)
	local seed, sn
	for _, u in ipairs(list) do
		local k = 0
		for _, v in ipairs(list) do if d2(u.x, u.z, v.x, v.z) <= r then k = k + 1 end end
		if sn == nil or k > sn then seed, sn = u, k end
	end
	if seed == nil then return nil end
	local cx, cz, cy, k = 0, 0, 0, 0
	for _, v in ipairs(list) do if d2(seed.x, seed.z, v.x, v.z) <= r then cx, cz, cy, k = cx + v.x, cz + v.z, cy + v.y, k + 1 end end
	return cx / k, cz / k, cy / k
end

-- Step 7: THE STAGE - 'the army arrives in pieces' (bench, 48 live games of step 6: in the fights where we lost 250+ in
-- 10 s for next to nothing 1.9 squads of 6.7 alive were there; the others were on the march or 'joining' one by one).
-- A group that is about to go into an enemy it knows about does not walk in as each squad arrives: every squad walks up
-- to the edge of the enemy's reach (its longest gun + StagePad, 50-62 m from its nearest squad) and waits there; when
-- StageFrac of the squads that are coming (people: 67 % of the squads are in the main group in 1v1, 80 % in a team game
-- - human_baseline_1113) stand at that edge, all go in the same second. The wait is StageMaxSecs (20 s) at most from
-- the first squad at the edge (with two there; 2 x that with one) - no stall in front of a point the enemy is taking.
-- Used by the fist before contact (the enemy seen or remembered); the support of a fight that is on (the squads called
-- from within SupportR) only waits StageSupSecs (6 s) for each other - our squads in that fight need them.
-- Brain_Stage=0: off. Log: 'fist STAGE ...' / 'fight <F> STAGE ...' and the orders 'stage: ...'.
A.stage = {}
local function stage_keep(en)
	local mr = 0
	for _, e in ipairs(en) do if e.d ~= nil and (e.d.rng or 0) > mr then mr = e.d.rng end end
	if mr <= 0 then mr = 40 end
	return math.max(Brain.num("StageMinD", 50), math.min(mr + Brain.num("StagePad", 8), Brain.num("StageMaxD", 62)))
end
local function near_enemy(u, en)
	local bd, be
	for _, e in ipairs(en) do
		local d = d2(u.x, u.z, e.x, e.z)
		if bd == nil or d < bd then bd, be = d, e end
	end
	return bd, be
end
-- cand = the squads that are to go in; en = the enemy they go into. Returns "go" (the gate is open: order them in) or
-- "wait" (the stage orders are given here), ready, n.
function A.stage_gate(key, cand, en, W, team, max_secs)
	local now = W.now
	local n = table.getn(cand)
	if n == 0 or table.getn(en) == 0 then return "go", 0, 0 end
	local st = A.stage[key]
	if st ~= nil and now - st.seen > 10 then st = nil end                   -- (an old stage of the same name)
	if st == nil then st = { seen = now }; A.stage[key] = st end
	st.seen = now
	if st.go ~= nil and now - st.go < Brain.num("StageGoSecs", 20) then return "go", n, n end
	local keep = stage_keep(en)
	local band = Brain.num("StageBand", 10)
	local ready, hit = 0, false
	local dist = {}
	for _, u in ipairs(cand) do
		local d, e = near_enemy(u, en)
		dist[u.id] = { d = d, e = e }
		if d <= keep + band then ready = ready + 1 end
		if u.hit and d <= keep + band then hit = true end
	end
	local frac = team and Brain.num("StageFracTeam", 0.8) or Brain.num("StageFrac1v1", 0.7)
	if Brain.plan.push ~= nil then frac = math.max(frac, Brain.num("StageFracPush", 0.8)) end
	local need = math.min(n, math.ceil(n * Brain.num("StageFrac", frac) - 0.001))
	if ready > 0 and st.t0 == nil then st.t0 = now end
	if ready == 0 then st.t0 = nil end
	local waited = (st.t0 ~= nil) and (now - st.t0) or 0
	local max_s = max_secs or Brain.num("StageMaxSecs", 20)
	if max_secs ~= nil then need = n end                                     -- (the support of a fight that is on: all of them, but a few seconds only)
	local why
	if ready >= need then why = ready .. " of " .. n .. " at the edge"
	elseif hit then why = "shot at at the edge"
	elseif waited >= max_s and ready >= 2 then why = "waited " .. f0(waited) .. " s with " .. ready .. " of " .. n
	elseif waited >= 2 * max_s then why = "waited " .. f0(waited) .. " s" end
	if why ~= nil then
		st.go, st.t0 = now, nil
		A.stats.stage_go = (A.stats.stage_go or 0) + 1
		Brain.log("ARMY", "stage", key, "GO", "why", why, "ready", ready, "of", n, "edge", f0(keep), "waited", f0(waited))
		return "go", ready, n
	end
	A.stats.stage_wait = (A.stats.stage_wait or 0) + 1
	for _, u in ipairs(cand) do
		local q = dist[u.id]
		local e = q.e
		local ust = A.st[u.id]
		if q.d > keep + band - 6 or q.d < keep - 8 then
			-- to the edge: the point at 'keep' from the enemy's nearest squad on the line to this squad (a squad that got
			-- nearer walks back out of reach)
			local k = keep / math.max(q.d, 1)
			A.st[u.id] = { mode = "stage", t = now }
			Brain.order(u, O.MOVE, e.x + (u.x - e.x) * k, u.y, e.z + (u.z - e.z) * k, { "stage: to the edge of the enemy's reach", f0(keep), "enemy at", f0(q.d), "there", ready .. "/" .. n, key })
		elseif ust == nil or ust.mode ~= "stage" or ust.held == nil then
			A.st[u.id] = { mode = "stage", t = now, held = true }
			Brain.order(u, O.MOVE, u.x, u.y, u.z, { "stage: wait at the edge for the others", "enemy at", f0(q.d), "there", ready .. "/" .. n, key })
		end
	end
	return "wait", ready, n
end

local function fist(W, taken)
	local now = W.now
	local list = {}
	-- (a squad that captures - a job of 55_capture.ai, or one found capturing with no enemy in sight - is taken there, R12 / R55)
	-- Step 5 (tester Malum, fb 860: "the lootas need not walk with everybody - it is enough to cover some direction of the
	-- map and fall back when needed"): a set-up team that is free holds a POST - our victory point nearest to the enemy
	-- (then our other points, front first; never one under the enemy's base) - instead of marching with the fist. It goes
	-- there by attack-move and stays; a fight near it takes it as any squad (the fight / loner / survive rules), so it
	-- falls back when it must. Only from SetupPostSecs (150 s) on and with SetupPostArmy (4) squads standing, so that the
	-- fist is not left thin. Brain_SetupPost=0: it walks with the fist as before.
	-- Log: 'BR ARMY <t> squad <id> <unit> POST at <point> why covers the direction ... dist D'.
	local posted = 0
	-- (step 7: not during a push - the set-up team walks with the fist then)
	if Brain.num("SetupPost", 1) >= 1 and now >= Brain.num("SetupPostSecs", 150) and table.getn(W.army) >= Brain.num("SetupPostArmy", 4) and Brain.plan.push == nil then
		local posts
		for _, u in ipairs(W.army) do
			local mu = Brain.capture.muster
			if not taken[u.id] and Brain.roles.of(u) == "setup" and not (mu ~= nil and d2(u.x, u.z, mu.x, mu.z) <= Brain.num("MusterD", 150)) then
				if posts == nil then
					posts = {}
					for _, p in ipairs(W.pts) do
						if p.ours then
							local dh
							for _, h in ipairs(W.ehq) do local d = d2(p.x, p.z, h.x, h.z); if dh == nil or d < dh then dh = d end end
							if dh ~= nil and dh > Brain.num("ObjHqR", 55) + 15 then table.insert(posts, { p = p, d = dh - (p.vp and 1000 or 0) }) end
						end
					end
					table.sort(posts, function(a, b) if a.d ~= b.d then return a.d < b.d end; return a.p.key < b.p.key end)
				end
				local st = A.st[u.id]
				local p
				if st ~= nil and st.mode == "post" then for _, e in ipairs(posts) do if e.p.key == st.key then p = e.p end end end
				if p == nil and table.getn(posts) > 0 then p = posts[posted - math.floor(posted / table.getn(posts)) * table.getn(posts) + 1].p end
				if p ~= nil then
					posted = posted + 1
					taken[u.id] = true
					local d = d2(u.x, u.z, p.x, p.z)
					if st == nil or st.mode ~= "post" or st.key ~= p.key then
						Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "POST", "at", p.key, "why", "a set-up team covers a direction:", p.vp and "our victory point nearest to the enemy" or "our front point", "dist", f0(d))
					end
					if d > Brain.num("SetupPostR", 12) and (st == nil or st.mode ~= "post" or st.key ~= p.key or now - (st.t or 0) >= 10) then
						A.st[u.id] = { mode = "post", key = p.key, t = now }
						Brain.order(u, O.AMOVE, p.x, p.y, p.z, { "post: cover", p.key, "dist", f0(d) })
					elseif st == nil or st.mode ~= "post" or st.key ~= p.key then A.st[u.id] = { mode = "post", key = p.key, t = now } end
				end
			end
		end
	end
	-- Step 6: THE SIEGE of a turret we know (mark 9: 'no idea what to do after the turrets went up'). The infantry keeps
	-- out of its circle (burnt ground); a machine, and a squad whose trade is armour (the profile's role 'av'), within
	-- TurretSiegeR (110 m) of one goes for it - elite.scar's order 7 'attack the enemy building nearest to the place' -
	-- when no enemy squad is seen within TurretGuardR (35 m) of the turret, or the sieging squads are a machine.
	if table.getn(W.turrets or {}) > 0 and Brain.num("TurretSiege", 1) >= 1 then
		for _, u in ipairs(W.army) do
			local role = Brain.roles.of(u)
			if not taken[u.id] and (u.veh or role == "av") and role ~= "transport" and (u.veh and u.hp >= Brain.num("MachineHomeHP", 0.5) or (not u.veh and u.eff >= 0.5)) then
				local bt, bd
				for _, tu in ipairs(W.turrets) do
					local d = d2(u.x, u.z, tu.x, tu.z)
					if d <= Brain.num("TurretSiegeR", 110) and (bd == nil or d < bd) then bt, bd = tu, d end
				end
				local guarded = false
				if bt ~= nil and not u.veh then
					for _, e in ipairs(W.en) do if d2(e.x, e.z, bt.x, bt.z) <= Brain.num("TurretGuardR", 35) then guarded = true; break end end
				end
				if bt ~= nil and not guarded then
					taken[u.id] = true
					local st = A.st[u.id]
					if st == nil or st.mode ~= "siege" or st.key ~= bt.key then
						A.stats.siege = (A.stats.siege or 0) + 1
						Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "SIEGE", "turret at", bt.key, "hp", f2(bt.hp), "dist", f0(bd), "why", u.veh and "a machine takes the turret" or "its trade is armour: it takes the turret")
					end
					A.st[u.id] = { mode = "siege", key = bt.key, t = now }
					Brain.order(u, O.ATTACK_BLD, bt.x, bt.y, bt.z, { "siege the turret at", bt.key, "dist", f0(bd) })
				end
			end
		end
	end
	for _, u in ipairs(W.army) do if not taken[u.id] then table.insert(list, u) end end
	table.sort(list, function(a, b) return a.id < b.id end)
	local n = table.getn(list)
	if n == 0 then return end
	local fist_r = Brain.num("FistR", 40)
	local cx, cz, cy = A.group_centre(list, fist_r)
	A.centre = { x = cx, y = cy, z = cz }
	local inside, n_in = {}, 0
	local outside = {}
	for _, u in ipairs(list) do
		local d = d2(u.x, u.z, cx, cz)
		if d <= fist_r then table.insert(inside, u); n_in = n_in + 1 else table.insert(outside, u) end
	end
	-- (step 7: the squads away from the fist are ordered below, when it is known whether the fist stages - then they go
	-- to the edge with the others, not to the fist's centre)
	local staged = {}
	local function join_far()
		for _, u in ipairs(outside) do
			if not staged[u.id] then
				A.st[u.id] = { mode = "gather", t = now }
				Brain.order(u, O.MOVE, cx, cy, cz, { "join the fist", "away", f0(d2(u.x, u.z, cx, cz)), "together", n_in .. "/" .. n })
			end
		end
	end
	local obj = Brain.plan.objective
	if obj == nil then join_far(); return end
	-- how much of the free army must stand together before it marches (step 3, against people - human_baseline_1113):
	-- in 1v1 their main group holds 67 % of the squads and they stand as one fist 43 % of the time; in team games 80 %
	-- and 63-68 %. FistFrac (set = both modes) / FistFrac1v1 0.6 / FistFracTeam 0.75.
	local team = ((Brain.perception.n_allies or 0) > 0)
	local fist_frac = Brain.num("FistFrac", team and Brain.num("FistFracTeam", 0.75) or Brain.num("FistFrac1v1", 0.6))
	local frac = n_in / n
	local dco = d2(cx, cz, obj.x, obj.z)
	local tail = { "together", n_in .. "/" .. n, "centre", f0(cx), f0(cz), "to", obj.kind, obj.key, "dist", f0(dco) }
	local function say(what, why)
		local parts = { "fist", what }
		for _, w in ipairs(tail) do table.insert(parts, w) end
		table.insert(parts, "why"); table.insert(parts, why)
		Brain.say("ARMY", "fist", Brain.num("FistLogSecs", 10), parts, what .. "|" .. obj.key .. "|" .. why)
	end
	-- ENGAGE OR NOT, before contact: the strongest enemy clump we SEE (or remember: ghosts, at a discount) within ThreatR
	-- of the fist or at the objective. Weaker than it (below Even) - the fist does not walk into it: it stands (R5, R15).
	-- Stronger (Win) and the clump is near - the fist goes for it (R11). In between - the march goes on; contact is a fight.
	local P = Brain.perception
	local threat_r = Brain.num("ThreatR", 70)
	local th, th_s, th_ratio
	local function look(en, x, z, k, F)
		if table.getn(en) == 0 or table.getn(inside) == 0 then return end
		if d2(x, z, cx, cz) > threat_r and d2(x, z, obj.x, obj.z) > Brain.num("ThreatObjR", 40) then return end
		local s_en = k * P.strength(en, P.mix_of(inside))
		if th_s == nil or s_en > th_s then
			th, th_s = { x = x, z = z, n = table.getn(en), ghost = (k < 1), en = en, F = F }, s_en
			th_ratio = P.strength(inside, P.mix_of(en)) / math.max(s_en, 1)
			-- (step 7: the enemy of a fight of ours is weighed against the fist AND our squads that fight it - a squad back
			-- from the base stood where it was, 'the enemy ahead is stronger', while its fist was holding that enemy)
			-- (bench s7_a, 48 games: with it on by default the fist stood half as often and attacked twice as often - more
			-- fights, 2.42 models lost a minute against 2.04; StageCountFight=1 turns it on)
			if F ~= nil and Brain.num("StageCountFight", 0) >= 1 then th_ratio = th_ratio + (F.s_ours or 0) / math.max(F.s_en or s_en, 1) end
		end
	end
	for _, c in ipairs(W.threats) do look(c.en, c.x, c.z, 1) end
	for _, c in ipairs(W.fights) do look(c.en, c.x, c.z, 1, c) end
	if table.getn(W.ghosts) > 0 then
		local gx, gz, gk = 0, 0, 0
		local near = {}
		for _, g in ipairs(W.ghosts) do
			if d2(g.x, g.z, cx, cz) <= threat_r or d2(g.x, g.z, obj.x, obj.z) <= Brain.num("ThreatObjR", 40) then
				table.insert(near, g); gx, gz, gk = gx + g.x, gz + g.z, gk + 1
			end
		end
		-- (step 6, mark 9 'runs back and forth': 'fist MARCH ... threat 1g@-66,36 ratio 0.97', two seconds later 'STAND ...
		-- threat 1@-66,36 ratio 0.48', then MARCH again - the same squad counted half the moment it stepped out of sight.
		-- What was seen within GhostFreshSecs (8 s) counts in full.)
		local fresh = false
		for _, g in ipairs(near) do if (g.age or 99) <= Brain.num("GhostFreshSecs", 8) then fresh = true end end
		if gk > 0 then look(near, gx / gk, gz / gk, fresh and 1 or Brain.num("GhostK", 0.5)) end
	end
	-- Step 7: does the fist stage? It is about to go into the enemy 'th' (it would attack it, or its objective lies within
	-- that enemy's reach) and is not weaker - then nobody walks in ahead: A.stage_gate.
	local even_now = Brain.num("Even", 0.8)
	if th ~= nil then
		if A.fist_stop ~= nil and now - A.fist_stop < Brain.num("FistBackSecs", 12) then even_now = even_now * (1 + Brain.num("FistBackBand", 0.25)) end
		if now >= Brain.num("LateSecs", 840) and (W.vp.behind or W.vp.losing) then even_now = math.min(even_now, Brain.num("LateEven", 0.65)) end
	end
	local stage_cand
	if th ~= nil and th_ratio >= even_now and Brain.num("Stage", 1) >= 1 and table.getn(th.en) >= Brain.num("StageMinEnemy", 1) then
		local keep = stage_keep(th.en)
		local to_obj = (d2(th.x, th.z, obj.x, obj.z) <= keep + Brain.num("StageObjPad", 15))
		local attack = (th_ratio >= A.win_line(W) and not th.ghost and d2(th.x, th.z, cx, cz) <= threat_r)
		if to_obj or attack then
			stage_cand = {}
			for _, u in ipairs(list) do
				local d = near_enemy(u, th.en)
				if d <= Brain.num("StageComeD", 150) then table.insert(stage_cand, u); staged[u.id] = true end
			end
		end
	end
	join_far()
	if th ~= nil then
		table.insert(tail, "threat"); table.insert(tail, th.n .. (th.ghost and "g" or "") .. "@" .. f0(th.x) .. "," .. f0(th.z)); table.insert(tail, "ratio"); table.insert(tail, f2(th_ratio))
		-- (step 6: a fist that stood or went back for this threat marches again only when it is clearly no weaker - the
		-- line moves up by FistBackBand 25 % for FistBackSecs 12 s; behind in the race late in the game it takes an even fight)
		local even_line = Brain.num("Even", 0.8)
		if A.fist_stop ~= nil and now - A.fist_stop < Brain.num("FistBackSecs", 12) then even_line = even_line * (1 + Brain.num("FistBackBand", 0.25)) end
		if now >= Brain.num("LateSecs", 840) and (W.vp.behind or W.vp.losing) then even_line = math.min(even_line, Brain.num("LateEven", 0.65)) end
		if th_ratio < even_line then
			if A.fist_stop == nil or now - A.fist_stop >= Brain.num("FistBackSecs", 12) or th_ratio < Brain.num("Even", 0.8) then A.fist_stop = now end
			-- near us: back to our point behind (walking, R2/R5) and stand there; only at the objective: stand where we are
			-- (much stronger, below Lost: back; a bit stronger: stand - hold the ground, the fight rule steps if it comes to contact)
			local fb = (th_ratio < Brain.num("Lost", 0.45) and d2(th.x, th.z, cx, cz) <= threat_r) and fallback(th, W) or nil
			if fb ~= nil and d2(cx, cz, fb.x, fb.z) > Brain.num("ArriveR", 20) then
				for _, u in ipairs(inside) do
					A.st[u.id] = { mode = "back", t = now, tx = fb.x, tz = fb.z }
					Brain.order(u, O.MOVE, fb.x, fb.y, fb.z, { "the enemy near is stronger: back to", fb.key, "ratio", f2(th_ratio) })
				end
				say("BACK", "the enemy " .. (th.ghost and "last seen" or "seen") .. " near is stronger: to our point " .. fb.key)
				return
			end
			for _, u in ipairs(inside) do
				local st = A.st[u.id]
				if st == nil or st.mode ~= "stand" then
					A.st[u.id] = { mode = "stand", t = now }
					Brain.order(u, O.MOVE, u.x, u.y, u.z, { "stand: the enemy ahead is stronger", "ratio", f2(th_ratio) })
				end
			end
			say("STAND", "the enemy " .. (th.ghost and "last seen" or "seen") .. " ahead is stronger")
			return
		end
		-- (step 6: not into burnt ground - the enemy 'seen near' there is the bait of a nest - without a machine or twice its strength)
		local burnt = false
		if A.zone_at(th.x, th.z) ~= nil and th_ratio < Brain.num("ZonePressRatio", 2) then
			burnt = true
			for _, u in ipairs(inside) do if u.veh then burnt = false end end
		end
		if stage_cand ~= nil and not burnt then
			local g, ready, sn = A.stage_gate(th.F and th.F.key or "fist", stage_cand, th.en, W, team)
			if g == "wait" then
				say("STAGE", "at the edge of the enemy's reach " .. ready .. " of " .. sn .. ": all go in together")
				return
			end
			-- the gate is open: everybody that was staged goes in now
			if th_ratio >= A.win_line(W) and not th.ghost and d2(th.x, th.z, cx, cz) <= threat_r then
				for _, u in ipairs(stage_cand) do
					A.st[u.id] = { mode = "attack", t = now }
					Brain.order(u, O.AMOVE, th.x, u.y, th.z, { "attack together: the fist was at the edge", ready .. "/" .. sn, "ratio", f2(th_ratio) })
				end
				say("ATTACK", "together from the edge of the enemy's reach")
				return
			end
			for _, u in ipairs(stage_cand) do
				A.st[u.id] = { mode = "march", t = now }
				Brain.order(u, O.AMOVE, obj.x, obj.y, obj.z, { "march together from the edge", obj.kind, obj.key, "fist", ready .. "/" .. sn })
			end
			say("MARCH", "together from the edge of the enemy's reach: " .. obj.why)
			return
		end
		if th_ratio >= A.win_line(W) and not th.ghost and not burnt and d2(th.x, th.z, cx, cz) <= threat_r and frac >= fist_frac then
			for _, u in ipairs(inside) do
				A.st[u.id] = { mode = "attack", t = now }
				Brain.order(u, O.AMOVE, th.x, u.y, th.z, { "attack: stronger than the enemy seen", "ratio", f2(th_ratio) })
			end
			say("ATTACK", "stronger than the enemy seen near")
			return
		end
	end
	if n >= 2 and frac < fist_frac then
		for _, u in ipairs(inside) do
			local st = A.st[u.id]
			if st ~= nil and st.mode == "march" then
				A.st[u.id] = { mode = "wait", t = now }
				Brain.order(u, O.MOVE, u.x, u.y, u.z, { "wait for the fist", "together", n_in .. "/" .. n })
			end
		end
		say("WAIT", "less than " .. f2(fist_frac) .. " of the army together" .. (team and " (team game)" or " (1v1)"))
		return
	end
	if dco <= Brain.num("ArriveR", 20) then
		for _, u in ipairs(inside) do A.st[u.id] = { mode = "at", t = now } end
		say("AT", obj.why)
		return
	end
	local lead = Brain.num("LeadD", 20)
	for _, u in ipairs(inside) do
		local du = d2(u.x, u.z, obj.x, obj.z)
		local st = A.st[u.id]
		if n_in >= 2 and du < dco - lead then
			if st == nil or st.mode ~= "wait" then
				A.st[u.id] = { mode = "wait", t = now }
				Brain.order(u, O.MOVE, u.x, u.y, u.z, { "ahead of the fist: wait", "ahead by", f0(dco - du) })
			end
		else
			A.st[u.id] = { mode = "march", t = now }
			Brain.order(u, O.AMOVE, obj.x, obj.y, obj.z, { "march", obj.kind, obj.key, "fist", n_in .. "/" .. n })
		end
	end
	say("MARCH", obj.why)
end

-- ---- the tick --------------------------------------------------------------------------------------------------------
function A.update(W)
	A.turrets = W.turrets
	-- (step 7: is there anything with the army that can break a turret - a machine or a squad whose trade is armour; 20_plan.ai)
	A.can_siege = false
	for _, u in ipairs(W.army) do
		local role = Brain.roles.of(u)
		if (u.veh or role == "av") and role ~= "transport" then A.can_siege = true end
	end
	for _, id in ipairs(Brain.keys(A.st)) do
		if W.by_id[id] == nil then A.st[id] = nil; Brain.forget(id) end
	end
	local taken = {}
	-- Step 6 (Orca's match 1: 'melee squads sit in a building'). Who sends them in: Relic's squad tactic 'Hold'
	-- (tactics.ai TacticDemand_Hold - the demand grows the nearer a building that can be held is; the brain left the
	-- squads' own tactics to the engine). For a mob the demand is refused (90_boot.ai), and a mob found inside a building
	-- is ordered out (a MOVE order leaves the building).
	if Brain.num("NoMeleeGarrison", 1) >= 1 and type(Squad_IsInHoldEntity) == "function" then
		for _, u in ipairs(W.own) do
			if u.mel and u.sq ~= nil and Squad_IsInHoldEntity(u.sq) == true then
				A.stats.evict = (A.stats.evict or 0) + 1
				local to = A.centre or W.home or u
				local dd = math.max(d2(u.x, u.z, to.x, to.z), 1)
				local k = math.min(Brain.num("EvictD", 18) / dd, 1)
				-- (the order out is OFF by default, Brain_Evict=1: no working unload command is known - elite.scar, mode 14;
				-- bench s6_t6 - s6_t10. With the tactic's filter on no mob entered a building in 108 live games; the line
				-- below says so in a tester's log if one does.)
				if Brain.num("Evict", 0) < 1 then
					Brain.say("ARMY", "inhouse|" .. u.id, 30, { "squad", u.id, Brain.short(u.key), "INSIDE", "why", "a mob sits in a building and no order takes it out", "at", f0(u.x), f0(u.z) }, "inhouse")
				else
				taken[u.id] = true                                             -- (no other order this tick: a charge order after it kept the squad inside)
				if Brain.order(u, O.UNLOAD, u.x + (to.x - u.x) * k, u.y, u.z + (to.z - u.z) * k, { "out of the building: a mob does not hold one" }) then
					Brain.log("ARMY", "squad", u.id, Brain.short(u.key), "OUT", "why", "a mob sits in a building: out of it", "at", f0(u.x), f0(u.z), "hold tactic wrapped", tostring(Brain.hold_wrapped))
				end
				end
			end
		end
	end
	-- (every squad of ours, builders too: with the engine's own retreat switched off - Brain_RetreatLock, elite.scar - nobody
	-- else will send a dying squad home)
	for _, u in ipairs(W.own) do survive(u, W, taken) end
	for _, F in ipairs(W.fights) do fight(F, W, taken) end
	-- a squad that stepped back out of contact finishes its step and stands there for the rest of StepHoldSecs
	for _, u in ipairs(W.army) do
		local st = A.st[u.id]
		if not taken[u.id] and st ~= nil and st.mode == "step" and W.now - st.t < Brain.num("StepHoldSecs", 8) then taken[u.id] = true end
		-- a squad that was sent to our point behind walks all the way (it is not stopped half-way, 70 m from the enemy it left)
		if not taken[u.id] and st ~= nil and (st.mode == "behind" or st.mode == "walk" or st.mode == "back") and st.tx ~= nil
			and W.now - st.t < Brain.num("WalkMaxSecs", 30) and d2(u.x, u.z, st.tx, st.tz) > Brain.num("ArriveR", 20) then
			taken[u.id] = true
			if st.eff0 ~= nil and bleeds(u, st.eff0, st.n0) then
				retreat(u, { "walking back and taking losses", "eff", f2(st.eff0), "->", f2(u.eff), "models", st.n0 or u.n, "->", u.n, "of", u.full })
			end
		end
	end
	Brain.capture.update(W, taken)                                     -- R12: who captures (55_capture.ai); they are not the fist's
	fist(W, taken)
	Brain.every("army_stats", Brain.num("StatsSecs", 30), function()
		Brain.log("ARMY", "stats", "retreat", A.stats.retreat, "home", A.stats.home, "step", A.stats.step, "leave_walk", A.stats.leave,
			"charge", A.stats.charge, "orders", Brain.st.orders, "skipped", Brain.st.skipped,
			"verdict_changes", A.stats.verdicts, "members_in", A.stats.mem_in, "members_out", A.stats.mem_out, "loner", A.stats.loner,
			"retreat_not_ours", A.stats.not_ours, "leave_young", A.stats.young,
			"cover_asked", A.cover.asked, "cover_found", A.cover.found, "zones", A.stats.zones or 0, "flank", A.stats.flank or 0,
			"turrets", table.getn(W.turrets or {}), "siege", A.stats.siege or 0, "stage_wait", A.stats.stage_wait or 0, "stage_go", A.stats.stage_go or 0, "casts", Brain.abilities.n_cast or 0, "hold_refused", A.stats.hold_no or 0, "evicted", A.stats.evict or 0)
	end)
end

	end
	eliteai_brain_50_army()
end

-- ===== EliteAI brain/55_capture.ai =====
do
	local function eliteai_brain_55_capture()
-- BRAIN 55_capture: who captures which point. The brain's own capture orders - Relic's capture tasks do not run for a
-- brain player (Brain.LEGACY.capture = false in 90_boot.ai: CalcCapturePriorities and strategy_resourcing.execute are
-- never registered, so there is nothing to cap or to suppress).
-- Owns: R12 (a point is captured by one squad, rarely two; the army is not pulled apart), R16 (the map at the pace of
--   people), the captures of R55. The fist's objective stays the plan's (20_plan.ai).
-- In:  W (points, the army, the visible enemy and the ghosts), the plan's objective, the squads the army module has not
--   taken this tick (survive and the fights come first: a capturer that is shot at is theirs).
-- Out: a job per capturing squad (C.jobs[id]), the order CAPTURE (mode 5: elite.scar finds the point's entity and sends
--   the engine's own capture command - the squad walks there by itself); taken[id] = true: the fist does not gather it.
-- Cadence: with the army's tick (1 s): jobs are looked after every tick, new ones are chosen every CapSecs (2 s).
-- Log: 'BR CAP <t> point <key> START squad <id> <unit> why <fist objective|side point|was capturing> <kind of point> dist D
--        edge <its rank from the fist's centre>/<n> hero 0|1 jobs N'
--      'BR CAP <t> point <key> DONE|DROP squad <id> <unit> why <reason> secs S'
--
-- The rules:
--  * One squad a point. Two only for a victory point while we are behind in the race and the fist has four squads or more.
--  * WHO: never the fist's core. The squads of the fist are ranked by the distance from its centre: the inner half is the
--    core and stays; of the others (and of the squads that are away from the fist anyway) the one nearest to the point goes.
--    Not a machine, not a set-up team, not a healer or a worker, not a squad below CapMinHP.
--  * THE HERO: people capture with the hero in a third of their captures - every third job (CapHeroEvery) is the hero's
--    when it is free and within reach; in the other jobs the hero stays with the fist.
--  * HOW MANY at once besides the fist's own objective: one squad for every three of the army (at least one when the army
--    is two squads or more, CapJobsMax 2 at most; in the opening - before OpeningSecs and with no enemy seen yet - two).
--    None is started while the fist's objective is a fight.
--  * WHERE: the fist's objective when the fist is within CapFistD of it; side points: free or the enemy's, no enemy seen
--    (or remembered for GhostCapSecs) within CapDangerR, not under an enemy base, within CapSideMaxD of the fist.
--  * A squad that is found capturing (a person's order before the brain took over, the scenes of the bench) is left to
--    finish as a job of its own.
--  * A job ends: the point is ours (DONE), the enemy is at the point, the squad was taken by survive / a fight (a lone
--    capturer that meets a group walks back: the loner rule of 50_army.ai), or it took too long (DROP).

Brain.capture = {}
local C = Brain.capture
C.jobs = {}
C.count = 0
C.hero_n = 0                                                            -- the jobs the brain gave to the hero (C.count = all it gave)
C.stats = { started = 0, hero = 0, two = 0, done = 0, dropped = 0, adopted = 0, called = 0, hero_done = 0 }
local d2 = Brain.d2
local O = Brain.ORD
local function f0(v) return Brain.f0(v) end

local function point_by_key(W, key)
	for _, p in ipairs(W.pts) do if p.key == key then return p end end
	return nil
end
local function kind_of(p)
	return (p.vp and "victory point" or (p.pow and "power point" or "requisition point")) .. (p.enemy and " of the enemy" or " free")
end
local function danger(p, W, r)
	-- (step 7, the turret scenes from people's replays - test/scenes7, t7_tur_542a64_3m31: a squad was sent to capture the
	-- victory point 2 m from an IG turret and stood in its circle for 37 of the scene's samples; a point inside the
	-- circle of a turret we know - TurretR 42 m, 10_perception.ai - is no capture job. Brain_CapTurret=0: as before)
	if Brain.num("CapTurret", 1) >= 1 then
		for _, tu in ipairs(W.turrets or {}) do if d2(tu.x, tu.z, p.x, p.z) <= Brain.num("TurretR", 42) then return true end end
	end
	for _, e in ipairs(W.en) do if d2(e.x, e.z, p.x, p.z) <= r then return true end end
	local gs = Brain.num("GhostCapSecs", 10)
	for _, g in ipairs(W.ghosts) do if g.age <= gs and d2(g.x, g.z, p.x, p.z) <= r then return true end end
	return false
end
local function is_hero(u) return u.key ~= nil and string.find(u.key, "/heroes/", 1, true) ~= nil end
C.is_hero = is_hero
local function can_capture(u)
	if u.veh then return false end
	local roles = Brain.roles
	local role = roles.of(u)
	if roles.is_machine(role) or roles.is_rear(role) or role == "setup" then return false end
	return u.hp >= Brain.num("CapMinHP", 0.5)
end
-- the jobs on a point
function C.on_point(key)
	local n = 0
	for _, j in pairs(C.jobs) do if j.key == key then n = n + 1 end end        -- (a count: the order of pairs() does not matter)
	return n
end
-- for the plan: a point one of ours is already at and capturing, or a side point with its squad on the way - the fist
-- goes on to the next one (R12, R16: one captures, the others do not follow it)
function C.covered(key)
	for _, j in pairs(C.jobs) do                                          -- (any: the order does not matter)
		if j.key == key and (j.at or j.why ~= "fist objective") then return true end   -- a side point has its squad on the way: not the fist's business
	end
	return false
end

local function drop(id, u, why, done)
	local j = C.jobs[id]
	if j == nil then return end
	C.jobs[id] = nil
	if done then C.stats.done = C.stats.done + 1 else C.stats.dropped = C.stats.dropped + 1 end
	if done and j.hero then C.stats.hero_done = C.stats.hero_done + 1 end
	Brain.log("CAP", "point", j.key, done and "DONE" or "DROP", "squad", id, u and Brain.short(u.key) or "?", "why", why, "secs", f0(Brain.now - j.t))
	if u ~= nil and Brain.army.st[id] ~= nil and Brain.army.st[id].mode == "cap" then Brain.army.st[id] = nil end
end
-- the army module calls a capturer into a fight (50_army.ai, judge: lost without it, even with it; the hero: any fight
-- that is not won): the job ends here, with that reason in the line
function C.release(u, why)
	if C.jobs[u.id] == nil then return end
	C.stats.called = C.stats.called + 1
	drop(u.id, u, why, false)
end
local function start(u, p, why, rank, n, W)
	local hero = is_hero(u)
	C.jobs[u.id] = { key = p.key, x = p.x, y = p.y, z = p.z, t = W.now, why = why, hero = hero }
	C.stats.started = C.stats.started + 1
	if why == "was capturing" then C.stats.adopted = C.stats.adopted + 1 else C.count = C.count + 1; if hero then C.hero_n = C.hero_n + 1 end end
	if hero then C.stats.hero = C.stats.hero + 1 end
	local jobs = 0
	for _ in pairs(C.jobs) do jobs = jobs + 1 end
	Brain.log("CAP", "point", p.key, "START", "squad", u.id, Brain.short(u.key), "why", why, kind_of(p), "dist", f0(d2(u.x, u.z, p.x, p.z)),
		"edge", (rank or "-") .. "/" .. (n or "-"), "hero", hero and 1 or 0, "jobs", jobs)
end

-- the squad for a point: 'free' = the squads nobody took, 'rank' = id -> place from the fist's centre among ALL the squads
-- of the army (1 = the innermost; a squad that is away capturing is an outer one), 'n' = the army. The inner half of an
-- army of three or more is the core: it is not sent away ('core_ok' = the fist's own objective, where the fist stands:
-- there the outermost squad captures even when all of them are the core). Returns the unit or nil.
-- The hero's share (step 3; bench 13.11: 'every third job' gave the hero 19 % - its turn was lost whenever it was busy or
-- far at that moment): the hero takes a job whenever its share of the jobs given so far is below one in CapHeroEvery (a
-- debt, not a turn). 'hero_ok' = no fight of ours is on (the hero is not sent away from a fight), and not farther than
-- CapHeroMaxD. Brain_CapHeroDebt=0: the old turn.
local function pick(p, free, rank, n, max_d, core_ok, hero_ok)
	local every, k = math.max(Brain.num("CapHeroEvery", 3), 1), C.count + 1
	local hero_turn = (k - math.floor(k / every) * every == 0)
	local hero_d = max_d
	if Brain.num("CapHeroDebt", 1) >= 1 then
		hero_turn = hero_ok and (C.hero_n < k / every)
		hero_d = math.min(max_d, Brain.num("CapHeroMaxD", 90))
	end
	local core_n = (n >= 3) and math.ceil(n / 2) or 0
	local best, bs, hero
	for _, u in ipairs(free) do
		if C.jobs[u.id] == nil and can_capture(u) then
			local d = d2(u.x, u.z, p.x, p.z)
			if d <= max_d then
				local core = (rank[u.id] ~= nil and rank[u.id] <= core_n)
				if is_hero(u) then if d <= hero_d then hero = u end
				elseif core_ok or not core then
					local s = d + (core and 1000 or 0)                        -- (an outer squad before a core one, then the nearest)
					if bs == nil or s < bs then best, bs = u, s end
				end
			end
		end
	end
	if hero ~= nil and (hero_turn or (best == nil and table.getn(free) == 1)) then return hero end
	return best
end

function C.update(W, taken)
	local now = W.now
	local A = Brain.army
	-- 1. the jobs that are running (by squad id, in order)
	local ids = {}
	for id in pairs(C.jobs) do table.insert(ids, id) end
	table.sort(ids)
	-- Step 5, R7 by the situation (bench lib7, four opening scenes: where the human spread out - 2 % and 32 % of his army
	-- within 40 m - we stood bunched, 64-65 %; where he pulled everything together for the first clash - 64-66 % - we went
	-- on capturing, 27 %). THE FIRST CLASH (before CapClashSecs 210 s): a fight against two enemy squads or more that is
	-- not won yet (with the support below CapClashRatio 2) calls every capturer within CapClashD (160 m) that is not on
	-- its point already; no new job starts while it lasts.
	-- BOTH ARE OFF BY DEFAULT (Brain_CapClash=1, Brain_CapOpeningFree=1 turn them on): on the bench the clash rule did not
	-- fire once in twelve opening scenes, and 'every squad to a point' made R7 worse - the sum of |ours - human| over six
	-- R7 scenes 191 -> 235 points, models lost in twelve opening scenes 25 -> 31 (s5_r7k_f against s5_r7_f): the human
	-- who spreads out stays spread after a single enemy squad shows up, ours are then all called to that one fight.
	local clash
	if Brain.num("CapClash", 0) >= 1 and now < Brain.num("CapClashSecs", 210) then
		for _, F in ipairs(W.fights) do
			if table.getn(F.en) >= 2 and table.getn(F.ours) >= 1 and F.verdict ~= nil and (F.ratio_all or F.ratio or 0) < Brain.num("CapClashRatio", 2)
				and (clash == nil or F.s_en > clash.s_en) then clash = F end
		end
	end
	C.clash = clash
	-- Step 7: THE MUSTER ('the army arrives in pieces'; bench, 48 live games of step 6: in the fights against two enemy
	-- squads or more 2.2 of our 6.3 squads were there - and 1.0 squad was walking to a point or capturing, 0.4 stood at
	-- its post). A fight against MusterEnemy (2) squads or more that is not won (with the support below MusterRatio 1.6)
	-- is the army's business: a capturer within MusterD (150 m) of it that is not capturing yet is called, no new job
	-- starts while it lasts, the set-up team leaves its post for it (50_army.ai). After the opening only (MusterFrom
	-- 150 s: the first minutes are the people's 'everybody captures').
	-- OFF BY DEFAULT (Brain_Muster=1 turns it on): 48 live games with it (s7_c) against the same code without (s7_b) -
	-- 74 capturers called, our squads in a fight against two or more 2.22 against 2.27 (no gain), the one-sided
	-- five-second windows of those fights 235 against 188, ahead on tickets at the end 40 against 44.
	local muster
	if clash == nil and Brain.num("Muster", 0) >= 1 and now >= Brain.num("MusterFrom", 150) then
		for _, F in ipairs(W.fights) do
			if table.getn(F.en) >= Brain.num("MusterEnemy", 2) and table.getn(F.ours) >= 1 and F.verdict ~= nil and F.verdict ~= "avoid"
				and (F.ratio_all or F.ratio or 0) < Brain.num("MusterRatio", 1.6) and (muster == nil or F.s_en > muster.s_en) then muster = F end
		end
	end
	C.muster = muster
	for _, id in ipairs(ids) do
		local j, u = C.jobs[id], W.by_id[id]
		local p = point_by_key(W, j.key)
		if u == nil then C.jobs[id] = nil; C.stats.dropped = C.stats.dropped + 1
		elseif taken[id] then drop(id, u, A.why_taken(u), false)
		elseif clash ~= nil and not j.at and not u.capturing and d2(u.x, u.z, clash.x, clash.z) <= Brain.num("CapClashD", 160) then
			drop(id, u, "the first clash: called to the fight " .. clash.key .. " (" .. table.getn(clash.ours) .. " against " .. table.getn(clash.en) .. ")", false)
			C.stats.called = C.stats.called + 1
		elseif muster ~= nil and not j.at and not u.capturing and d2(u.x, u.z, muster.x, muster.z) <= Brain.num("MusterD", 150) then
			drop(id, u, "the muster: called to the fight " .. muster.key .. " (" .. table.getn(muster.ours) .. " against " .. table.getn(muster.en) .. ", ratio " .. Brain.f2(muster.ratio_all or muster.ratio or 0) .. ")", false)
			C.stats.called = C.stats.called + 1; C.stats.muster = (C.stats.muster or 0) + 1
		elseif p == nil then drop(id, u, "the point is gone", false)
		elseif p.ours then drop(id, u, "the point is ours", true)
		elseif danger(p, W, Brain.num("CapAbortR", 40)) and not u.capturing then drop(id, u, "the enemy is at the point", false)
		elseif now - j.t > Brain.num("CapMaxSecs", 90) then drop(id, u, "took too long", false)
		else
			taken[id] = true
			A.st[id] = { mode = "cap", t = now }
			local d = d2(u.x, u.z, p.x, p.z)
			j.at = (d <= Brain.num("CapAtR", 12))
			if not u.capturing then
				Brain.order(u, O.CAPTURE, p.x, p.y, p.z, { "capture", kind_of(p), j.why, "dist", f0(d) })
			end
		end
	end
	if now - (C.t_pick or -100) < Brain.num("CapSecs", 2) then return end
	C.t_pick = now
	-- 2. the squads nobody took, the fist among them and each one's place from its centre
	local free = {}
	for _, u in ipairs(W.army) do if not taken[u.id] then table.insert(free, u) end end
	table.sort(free, function(a, b) return a.id < b.id end)
	if table.getn(free) == 0 then return end
	-- a squad found capturing, no enemy in sight near it: it finishes (a job of its own)
	local rest = {}
	for _, u in ipairs(free) do
		local adopted = false
		if u.capturing and not danger(u, W, Brain.num("ThreatR", 70)) then
			local bp, bd
			for _, p in ipairs(W.pts) do
				local d = d2(u.x, u.z, p.x, p.z)
				if not p.ours and d <= Brain.num("CapAtR", 12) + 6 and (bd == nil or d < bd) then bp, bd = p, d end
			end
			if bp ~= nil then
				start(u, bp, "was capturing", nil, nil, W)
				C.jobs[u.id].at = true
				taken[u.id] = true; A.st[u.id] = { mode = "cap", t = now }
				adopted = true
			end
		end
		if not adopted then table.insert(rest, u) end
	end
	free = rest
	if table.getn(free) == 0 then return end
	local fist_r = Brain.num("FistR", 40)
	local cx, cz = A.group_centre(free, fist_r)
	-- every squad of the army by its distance from the fist's centre (those going home are not counted)
	local all, n_in = {}, 0
	for _, u in ipairs(W.army) do
		local st = A.st[u.id]
		if not u.retreating and not (st ~= nil and (st.mode == "retreat" or st.mode == "heal")) then table.insert(all, { u = u, d = d2(u.x, u.z, cx, cz) }) end
	end
	table.sort(all, function(a, b) if a.d ~= b.d then return a.d < b.d end; return a.u.id < b.u.id end)
	local rank, n_army = {}, table.getn(all)
	for i, e in ipairs(all) do rank[e.u.id] = i end
	for _, u in ipairs(free) do if d2(u.x, u.z, cx, cz) <= fist_r then n_in = n_in + 1 end end
	local function go(u, p, why)
		start(u, p, why, rank[u.id], n_army, W)
		taken[u.id] = true; A.st[u.id] = { mode = "cap", t = now }
		Brain.order(u, O.CAPTURE, p.x, p.y, p.z, { "capture", kind_of(p), why, "dist", f0(d2(u.x, u.z, p.x, p.z)) })
	end
	local function hq_near(p)
		for _, h in ipairs(W.ehq) do if d2(p.x, p.z, h.x, h.z) <= Brain.num("ObjHqR", 55) then return true end end
		return false
	end
	local obj = Brain.plan.objective
	-- (step 5: a fight as the fist's objective no longer stops every capture - bench lib6: the objective was a fight most
	-- of the game and the victory points stayed the enemy's. One side job goes on, two while the race is being lost;
	-- the squads of the fight itself are not free anyway. Brain_CapInFight=0: as before.)
	local in_fight = (obj ~= nil and obj.kind == "fight")
	local seen_ok = (Brain.num("CapOpeningSeen", 1) >= 1)
	local opening = (now < Brain.num("OpeningSecs", 150) and (seen_ok or not Brain.perception.enemy_ever))
	if clash ~= nil then return end                                     -- the first clash: nobody leaves for a point
	if muster ~= nil then return end                                    -- (step 7) the muster: nobody leaves for a point
	if in_fight and (opening or Brain.num("CapInFight", 1) < 1) then return end
	local danger_r = Brain.num("CapDangerR", 50)
	local hero_ok = (table.getn(W.fights) == 0)
	-- 3. the fist's objective: its capturer goes when the fist is near
	if obj ~= nil and obj.kind == "take" then
		local p = point_by_key(W, obj.key)
		if p ~= nil and not p.ours and d2(cx, cz, p.x, p.z) <= Brain.num("CapFistD", 45) and not danger(p, W, danger_r) then
			local want = 1
			if p.vp and W.vp.behind and n_in >= Brain.num("CapTwoFist", 4) then want = 2 end
			while C.on_point(p.key) < want do
				local u = pick(p, free, rank, n_army, Brain.num("CapFistD", 45) + fist_r, true, hero_ok)
				if u == nil then break end
				if C.on_point(p.key) >= 1 then C.stats.two = C.stats.two + 1 end
				go(u, p, "fist objective")
			end
		end
	end
	-- 4. side points: one squad each, a few at a time
	local max_side, free_open = 0, false
	if n_army >= 2 then
		max_side = math.min(Brain.num("CapJobsMax", 2), math.max(1, math.floor(n_army / 3)))
		if Brain.plan.push ~= nil then max_side = math.min(max_side, Brain.num("PushCapJobs", 1)) end   -- (step 7: the push keeps the fist whole)
		-- the opening (step 3, against people): in the first OpeningSecs they capture with nearly every squad, one a point
		-- (bench, k_1c56ef_0m52, 0:52-1:32: the human had 14 % of his army within 40 m of its centre, we 51-65 %; lib2
		-- r7_ork_0031c6: 39 %) - also after the first enemy squad was seen. All but one squad may capture (CapJobsOpening 3
		-- at most); a fight calls the free squads at once and the capturers when it is lost without them.
		-- Brain_CapOpeningSeen=0: as in step 2 (the opening ends when the first enemy is seen, two jobs).
		if opening then max_side = math.min(Brain.num("CapJobsOpening", seen_ok and 3 or 2), n_army - 1) end
		-- (step 5: nobody in sight and nobody remembered - people send EVERY squad to a point of its own, CapJobsOpeningFree 5)
		if opening and table.getn(W.en) == 0 and table.getn(W.ghosts) == 0 and Brain.num("CapOpeningFree", 0) >= 1 then
			max_side, free_open = math.min(Brain.num("CapJobsOpeningFree", 5), n_army), true
		end
	end
	if in_fight then max_side = math.min(max_side, W.vp.losing and 2 or 1) end
	local side = 0
	for _, j in pairs(C.jobs) do if j.why ~= "fist objective" then side = side + 1 end end   -- (a count)
	local guard = 0
	while side < max_side and guard < 4 do
		guard = guard + 1
		local bp, bs
		for _, p in ipairs(W.pts) do
			if not p.ours and C.on_point(p.key) == 0 and not (obj ~= nil and obj.key == p.key and not free_open) and not p.us_cap
				and d2(p.x, p.z, cx, cz) <= Brain.num("CapSideMaxD", 130) and not hq_near(p) and not danger(p, W, danger_r) then
				local worth = (p.vp and Brain.num("ObjVP", 3)) or (p.pow and Brain.num("ObjPow", 2)) or Brain.num("ObjReq", 1)
				if p.vp and (W.vp.losing or W.vp.behind) then worth = worth * Brain.num("ObjBehindK", 1.5) end
				-- the way of the squad that would go, not of the fist: a squad coming from home takes the point on its way
				local u = pick(p, free, rank, n_army, Brain.num("CapSquadMaxD", 120), free_open, hero_ok)
				if u ~= nil then
					local s = worth / (Brain.num("ObjDist0", 40) + d2(u.x, u.z, p.x, p.z))
					if bs == nil or s > bs then bp, bs = { p = p, u = u }, s end
				end
			end
		end
		if bp == nil then break end
		go(bp.u, bp.p, "side point")
		side = side + 1
	end
	Brain.every("cap_stats", Brain.num("StatsSecs", 30), function()
		Brain.log("CAP", "stats", "started", C.stats.started, "hero", C.stats.hero, "two", C.stats.two, "adopted", C.stats.adopted,
			"done", C.stats.done, "dropped", C.stats.dropped, "side_now", side, "side_max", max_side, "given", C.count, "given_hero", C.hero_n,
			"hero_done", C.stats.hero_done, "called", C.stats.called)
	end)
end

	end
	eliteai_brain_55_capture()
end

-- ===== EliteAI brain/60_roles.ai =====
do
	local function eliteai_brain_60_roles()
-- BRAIN 60_roles: what each unit is for. A role decides how the army module uses the squad in a fight and on the march.
-- Owns: R29-R36 (artillery behind, transports, set-up teams, walkers not ahead, infiltrators), R45, R46 - by stages.
-- In:  a unit of the world model (its blueprint key and data row), the race profile below.
-- Out: R.of(u) -> role;  R.melee_target(u, F) -> the enemy squad a melee squad charges;  R.profile() -> the race's table.
-- Cadence: asked by the army module every tick (a table lookup).  Log: 'BR ROLE <t> <id> <unit> <role> by profile|data' once per squad.
--
-- Roles: melee (charges), jump (charges by its jump), ranged, av (anti-vehicle), setup (heavy weapon team), grenadier,
--   flank (infiltrator), support (healer / caster: behind the line), worker, hero_melee, hero_ranged,
--   walker, vehicle, transport, artillery.
-- A blueprint that the profile does not name gets its role from the data row (stance, armour, set-up time) - a new Elite
-- unit is never without a role (R25).
-- Race order of the profiles (the owner, 13.11): orks, space_marines, chaos_marines, eldar, imperial_guard, tyranids,
-- t_tau, ordo_malleus. First slice: orks.

Brain.roles = {}
local R = Brain.roles
local d2 = Brain.d2
R.said = {}

-- ability numbers = the index in EliteAI_MECH_ABILITIES of append/scar/elite/elite.scar (keep in sync)
R.ABIL = { ORK_JUMP = 10, ORK_STIKKBOMB = 17, ORK_STUN = 21, ORK_WAAAGH_SHOUT = 29, ORK_NOB_FRENZY = 30, ORK_SUPP_BREAK = 31,
	ORK_BIGSTOMP = 32, ORK_STOMP = 33, ORK_RAPIDFIRE = 34, ORK_SHOOTA_SUPP = 35, ORK_MORTAR = 36, ORK_KOM_STIKK = 37, ORK_KOMH_STIKK = 38 }

R.PROFILES = {
	orks = {
		-- the ork way: cheap melee mobs close in together and shout; shootas and lootas hold the line behind them;
		-- mobs are refilled to the last boy before the next push (strength = the number of models)
		reinforce_to = 1.0,
		global_fight = "ork_waaagh",          -- the player's global for a fight (70_abilities.ai B.global): 'globals/ork_waaagh', 200 requisition AND 200 of the red resource
		-- the economy plan (30_economy.ai; step 4). The clock is the people's (human_baseline_1113, orks; seconds of game):
		--   squads above the starters: 2 at once, 3 by 5:00, 4 by 10:00, 4-5 by 15:00; generators 2 by 5:00, 2-3 by 10:00;
		--   T2 clicked at 6:47 (1v1 7:10), T3 at 13:27; the first post at 0:42-0:51; hero wargear from 1:40-2:15.
		econ = {
			starters = 1, army0 = 3,                         -- squads besides the hero: the starter mob + the two opening squads
			opening = { "race_ork/troops/ork_shoota", "race_ork/troops/ork_shoota" },   -- 86-93 % of the people's ork games
			-- step 7: the tier 3 core (40_composition.ai C.late_core): which squads and how many at most; late_order = the
			-- order they are asked for (rich = only while the bank holds CompCore2K x the price: the idle bank at the cap)
			late_core = { ["race_ork/troops/ork_nob_squad"] = 2, ["race_ork/vehicles/ork_looted_tank"] = 1 },
			late_order = { { key = "race_ork/troops/ork_nob_squad", n = 1 }, { key = "race_ork/vehicles/ork_looted_tank", n = 1, rich = true },
				{ key = "race_ork/troops/ork_nob_squad", n = 2, rich = true } },
			army_t = { 150, 480, 840 },                      -- one more squad stands from each of these on (the living are counted)
			post = "ORK_SECURE", gen = "ORK_GENERATOR", tiers = { "ORK_TIER2", "ORK_TIER3" },   -- EBP.* / UPG.* of lua_consts.ai
			post_t = { 40, 200, 600 }, gen_t = { 120, 180, 420 }, gen_max = 3,
			tier_t = { 400, 800 },
			gear_t = { 110, 240, 540 },                      -- the hero's pieces: one a slot (weapon, armour, accessory)
			gear = {
				["race_ork/heroes/ork_warboss"] = { "wp1_ork_bang_bang_hammer", "arm_ork_warboss_cybork_bits", "acc_warboss_boss_pole", "arm_warboss_spiky_armor",
					"acc_warboss_angry_bits", "acc_warboss_trophy_rack", "wp1_ork_kustom_shoota", "wp1_ork_warboss_power_claw", "arm_warboss_mega_armor" },
				["race_ork/heroes/ork_hero_mekboy"] = { "wp1_mekboy_big_shoota", "arm_mekboy_electric_armor", "acc_mekboy_force_field", "arm_mekboy_battery_pack",
					"acc_mekboy_prox_mines", "wp1_mekboy_deffgun", "wp1_ork_mekboy_beamy_deffgun", "acc_mekboy_uber_generator", "arm_mekboy_earthquake_machine" },
				["race_ork/heroes/ork_hero_kommando"] = { "arm_kommando_extra_equipment", "acc_kommando_grenade", "wp1_kommando_spechul_shoota",
					"wp1_ork_kommando_hero_assassin_knife", "acc_kommando_kaboom", "acc_kommando_booby_trap", "arm_kommando_camo_armor", "arm_kommando_boom_time",
					"wp1_kommando_rokkit_launcha" },
			},
			-- step 6: the hero's weapon against machines, bought over what it wears once machines are seen (the swap)
			gear_swap = { ["race_ork/heroes/ork_warboss"] = "wp1_ork_warboss_power_claw", ["race_ork/heroes/ork_hero_mekboy"] = "wp1_ork_mekboy_beamy_deffgun",
				["race_ork/heroes/ork_hero_kommando"] = "wp1_kommando_rokkit_launcha" },
			-- step 6: upgrades that need a reason ("veh" = machines of the enemy seen)
			upg_need = { ork_deffgun_beamy = "veh" },
			-- (step 7) the order of a squad's upgrades while machines of the enemy are remembered: the nobz' leader carries the power klaw
			upg_veh = { ["race_ork/troops/ork_nob_squad"] = { "ork_nob_leader_nobz", "ork_nob_hammers", "ork_nob_kit" } },
			upg_first = 75, upg_every = 110, upg_max = 10,   -- people: 10 squad upgrades a match (7-15), big shoota / burna among the first 8 purchases
			upg = {
				["race_ork/troops/ork_shoota"] = { "ork_big_shoota", "ork_nob_leader_shoota" },
				["race_ork/troops/ork_slugga"] = { "ork_burna", "ork_nob_leader" },
				["race_ork/troops/ork_stormboy"] = { "ork_nob_leader_stormboy", "ork_stormboy_jump_upgrade" },
				["race_ork/troops/ork_lootas"] = { "ork_deffgun_beamy" },
				["race_ork/troops/ork_nob_squad"] = { "ork_nob_kit", "ork_nob_hammers", "ork_nob_leader_nobz" },
				["race_ork/troops/ork_kommandos"] = { "ork_nob_leader_kommando" },
				["race_ork/troops/ork_flash_gits"] = { "ork_flashgitz_blastas" },
				["race_ork/vehicles/ork_deff_dread"] = { "ork_deff_dread_burna" },
				["race_ork/vehicles/ork_looted_tank"] = { "ork_tank_armor" },
				["race_ork/vehicles/ork_battlewagon"] = { "ork_tank_armor" },
			},
			-- what breaks a set-up team (grenades, a jump onto it): asked for when one is seen (40_composition.ai)
			breakers = { ["race_ork/troops/ork_stikkbommas"] = true, ["race_ork/troops/ork_stormboy"] = true },
			-- not bought yet: the brain cannot use them (a worker, a healer, a caster, a transport - stages "roles" / "abilities")
			never = { ["race_ork/troops/ork_gretchin"] = true, ["race_ork/troops/ork_painboy"] = true, ["race_ork/troops/ork_weirdboy"] = true,
				["race_ork/vehicles/ork_wartrukk"] = true },
		},
		-- the fight's global by the game's own command (elite.scar EliteAI_PLAYER_ABILITIES, mode 400+k): Elite 3.2.1 numbers
		global_k = 1, global_red = 200, global_req = 200, global_recharge = 90,
		units = {
			["race_ork/troops/ork_slugga"] = { role = "melee" },
			["race_ork/troops/ork_stormboy"] = { role = "jump" },
			["race_ork/troops/ork_nob_squad"] = { role = "melee" },
			["race_ork/troops/ork_kommandos_melee"] = { role = "melee" },
			["race_ork/troops/ork_shoota"] = { role = "ranged" },
			["race_ork/troops/ork_flash_gits"] = { role = "ranged" },
			["race_ork/troops/ork_stikkbommas"] = { role = "grenadier" },
			["race_ork/troops/ork_lootas"] = { role = "setup" },
			["race_ork/troops/ork_tankbustas"] = { role = "av" },
			["race_ork/troops/ork_kommandos"] = { role = "flank" },
			["race_ork/troops/ork_gretchin"] = { role = "worker" },
			["race_ork/troops/ork_painboy"] = { role = "support" },
			["race_ork/troops/ork_weirdboy"] = { role = "support" },
			["race_ork/heroes/ork_warboss"] = { role = "hero_melee" },
			["race_ork/heroes/ork_hero_kommando"] = { role = "hero_ranged" },
			["race_ork/heroes/ork_hero_mekboy"] = { role = "hero_ranged" },
			["race_ork/vehicles/ork_deff_dread"] = { role = "walker" },
			["race_ork/vehicles/ork_wartrukk"] = { role = "transport" },
			["race_ork/vehicles/ork_looted_tank"] = { role = "vehicle" },
			["race_ork/vehicles/ork_battlewagon"] = { role = "vehicle" },
		},
		-- what a squad casts when it charges: { ability, kind self|pos, the distance window to its target, its recharge }
		-- Checked on the bench (step 2, 13.11, elite.scar 'CAST seen ... doing 0|1'):
		--  * the stormboyz' jump (15-65 m / 15 s) goes off: the squad passes through the states Ability > Jump;
		--  * the nobz' frenzy goes off (Squad_IsDoingAbility = true after the order; it needs their kit);
		--  * 'ork_waaagh_shout' does NOT: 0 of 15 orders did anything. It is no ability of a squad: every ork model carries
		--    it as its answer to the player's global Waaagh ('ability/pvp/race_ork/globals/ork_waaagh', 200 of the red
		--    resource). The global is cast as Relic's player_abilities.ai casts every global - AIPlayer_CanPlayerCastAbility,
		--    then Request_PlayerAbilitySingleTarget(player, TGROUP_PlayerAbility, TPRIORITY_PlayerAbility, pbg, position) -
		--    and it stays there (Brain.LEGACY.purchases) until the stage "the race's globals". No shout order is sent.
		-- Step 6 (R37 / R38 / R43; Orca: 'no counter to set-up teams'): what a squad casts IN a fight we take, in the order
		-- of preference: { ability, kind pos | squad | self, at = whom, the distance window, its recharge }.
		--   at "setup" = a set-up team (devastators, a heavy weapon team); "clump" = shooters standing, 3+ models;
		--   "melee" = a mob; "inf" / "near" = any infantry in the window. Never at a squad that runs home (the owner's rule),
		--   never (ff) with a squad of ours within 6 m of the place.
		-- An ability the squad does not have (no upgrade, no wargear) is refused by the engine: one try a recharge, the
		-- watch says 'CAST seen ... took 0'.
		casts = {
			["race_ork/troops/ork_stikkbommas"] = {
				-- (the stun bomb is not in the list: bench s6_l8_c - took 1 of 20; what it needs is not known)
				{ k = R.ABIL.ORK_STIKKBOMB, kind = "pos", at = "setup", max = 28, cd = 25, name = "stikkbomb", ff = true },
				{ k = R.ABIL.ORK_STIKKBOMB, kind = "pos", at = "clump", max = 28, cd = 25, name = "stikkbomb", ff = true } },
			["race_ork/troops/ork_tankbustas"] = {
				{ k = R.ABIL.ORK_MORTAR, kind = "pos", at = "setup", min = 12, max = 50, cd = 40, name = "mortar", ff = true },
				{ k = R.ABIL.ORK_MORTAR, kind = "pos", at = "clump", min = 12, max = 50, cd = 40, name = "mortar", ff = true } },
			["race_ork/troops/ork_shoota"] = {
				{ k = R.ABIL.ORK_SHOOTA_SUPP, kind = "squad", at = "setup", max = 38, cd = 45, name = "suppressing fire", upg = "big_shoota" },
				{ k = R.ABIL.ORK_SHOOTA_SUPP, kind = "squad", at = "inf", max = 38, cd = 45, name = "suppressing fire", upg = "big_shoota" } },
			["race_ork/troops/ork_kommandos"] = {
				{ k = R.ABIL.ORK_KOM_STIKK, kind = "pos", at = "setup", max = 28, cd = 30, name = "stikkbomb", ff = true },
				{ k = R.ABIL.ORK_KOM_STIKK, kind = "pos", at = "clump", max = 28, cd = 30, name = "stikkbomb", ff = true } },
			["race_ork/heroes/ork_hero_kommando"] = {
				{ k = R.ABIL.ORK_KOMH_STIKK, kind = "pos", at = "setup", max = 28, cd = 30, name = "stikkbomb", ff = true },
				{ k = R.ABIL.ORK_KOMH_STIKK, kind = "pos", at = "clump", max = 28, cd = 30, name = "stikkbomb", ff = true } },
			["race_ork/heroes/ork_warboss"] = {
				{ k = R.ABIL.ORK_BIGSTOMP, kind = "self", at = "near", max = 7, cd = 45, name = "big stomp" },
				{ k = R.ABIL.ORK_STOMP, kind = "self", at = "near", max = 6, cd = 45, name = "stomp" },
				{ k = R.ABIL.ORK_RAPIDFIRE, kind = "squad", at = "setup", min = 8, max = 30, cd = 45, name = "rapid fire", gear = "kustom_shoota" },
				{ k = R.ABIL.ORK_RAPIDFIRE, kind = "squad", at = "inf", min = 8, max = 30, cd = 45, name = "rapid fire", gear = "kustom_shoota" } },
		},
		charge = {
			jump = { { k = R.ABIL.ORK_JUMP, kind = "pos", min = 18, max = 60, cd = 15, name = "jump" } },
			["race_ork/troops/ork_nob_squad"] = { { k = R.ABIL.ORK_NOB_FRENZY, kind = "self", min = 0, max = 12, cd = 60, name = "frenzy" } },
		},
	},
}

function R.profile() return R.PROFILES[s_current_race] end

local function from_data(u)
	local d = u.d
	local hero = (u.key ~= nil and string.find(u.key, "/heroes/", 1, true) ~= nil)
	if d == nil then return (u.veh and "vehicle") or "ranged" end
	if d.arm == "veh" or u.veh then return (d.mel == 1) and "walker" or "vehicle" end
	if hero then return (d.mel == 1) and "hero_melee" or "hero_ranged" end
	if d.setup == 1 then return "setup" end
	if d.mel == 1 then return (d.jump == 1) and "jump" or "melee" end
	if d.dV >= 20 and d.dV >= d.dI * 0.8 then return "av" end
	return "ranged"
end

function R.of(u)
	local prof = R.profile()
	local row = prof and prof.units[u.key] or nil
	local role, by = (row and row.role), "profile"
	if role == nil then role, by = from_data(u), "data" end
	if u.own and not R.said[u.id] then
		R.said[u.id] = true
		Brain.log("ROLE", u.id, Brain.short(u.key), role, "by", by)
	end
	return role
end
function R.is_melee(role) return role == "melee" or role == "jump" or role == "hero_melee" end
function R.is_machine(role) return role == "walker" or role == "vehicle" or role == "transport" or role == "artillery" end
function R.is_rear(role) return role == "support" or role == "worker" end

-- the squad a melee squad charges: within ChargeR; shooters and set-up teams before melee squads (a mob in their face is
-- what they fear), never a vehicle (a choppa does a tenth to armour); the nearest of the best kind
function R.melee_target(u, F)
	local best, bs
	local cr = Brain.num("ChargeR", 45)
	for _, e in ipairs(F.en) do
		local dist = d2(u.x, u.z, e.x, e.z)
		local arm = (e.d and e.d.arm) or (e.veh and "veh" or "inf")
		if dist <= cr and arm ~= "veh" and arm ~= "bld" and not e.veh then
			local s = dist
			if e.d ~= nil and e.d.setup == 1 then s = s - Brain.num("ChargeSetupBonus", 15)
			elseif e.d ~= nil and e.d.mel ~= 1 then s = s - Brain.num("ChargeShooterBonus", 8) end
			if bs == nil or s < bs then best, bs = e, s end
		end
	end
	return best
end
-- what the squad casts on its charge (the profile's list for its blueprint, else for its role)
function R.charge_casts(u, role)
	local prof = R.profile()
	if prof == nil or prof.charge == nil then return nil end
	return prof.charge[u.key] or prof.charge[role]
end

	end
	eliteai_brain_60_roles()
end

-- ===== EliteAI brain/70_abilities.ai =====
do
	local function eliteai_brain_70_abilities()
-- BRAIN 70_abilities: abilities and wargear - what is cast, at whom, when; and (later) which upgrades are bought.
-- Owns: R37-R43 (set-up breaking, grenades into clumps and never wasted, the whole kit of a squad, race globals, dodging,
--   wargear against the enemy seen), R34/R35 (unit modes). The owner's default: a grenade at a retreating squad only if it
--   finishes the squad.
-- In:  the unit, its target, the fight; the race profile's lists (60_roles.ai).
-- Out: cast orders through Brain.order (modes 100+k at a place, 200+k on a squad, 300+k on itself).
-- Cadence: with the army's tick (1 s); each (squad, ability) remembers its own recharge - one cast, not one per tick.
-- Log: the order line 'BR ORD <t> <id> <unit> CAST_SELF29 ... why charge waaagh_shout dist 22 target <id> <unit>'.
--
-- First slice: what a squad casts when it charges (orks: the shout, the nobz' frenzy, the stormboyz' jump).
-- What stays the engine's for now: its own tactics (ai_tuning 'tactic_info' + tactics.ai filters) keep casting the rest;
-- the race's global abilities stay with player_abilities.ai. Taking them over = stage "abilities" of the design.

Brain.abilities = {}
local B = Brain.abilities
B.cd = {}

function B.ready(u, k, cd)
	local t = B.cd[u.id .. "|" .. k]
	return t == nil or (Brain.now - t) >= cd
end
-- kind: "self" | "pos" (x y z) | "squad" (x = the target's id)
function B.cast(u, k, kind, x, y, z, cd, why)
	if not B.ready(u, k, cd) then return false end
	local mode = (kind == "self" and Brain.ORD.ABIL_SELF) or (kind == "pos" and Brain.ORD.ABIL_POS) or Brain.ORD.ABIL_SQUAD
	if Brain.order(u, mode + k, x, y, z, why) then
		B.cd[u.id .. "|" .. k] = Brain.now
		return true
	end
	return false
end
-- the charge: called by the army module for a melee squad that goes at 'target', 'dist' metres away. One cast per tick;
-- returns its kind ("pos" = the squad is on its way by the cast itself: no melee order this tick) or nil
function B.on_charge(u, role, target, dist)
	local list = Brain.roles.charge_casts(u, role)
	if list == nil then return end
	for _, c in ipairs(list) do
		if dist >= c.min and dist <= c.max then
			local why = { "charge", c.name, "dist", Brain.f0(dist), "target", target.id, Brain.short(target.key) }
			if c.kind == "pos" then
				if B.cast(u, c.k, "pos", target.x, target.y, target.z, c.cd, why) then return "pos" end
			else
				if B.cast(u, c.k, "self", 0, 0, 0, c.cd, why) then return "self" end
			end
		end
	end
	return nil
end

-- ---- step 6: what a squad casts in a fight (the profile's 'casts': grenades, the hero's abilities) -------------------------
-- Called by the army module for every squad of a fight we take (PRESS / HOLD), before its marching order. Returns "busy"
-- when a cast with a target went out now or CastBusySecs (2 s) ago - the squad gets no other order meanwhile (a new
-- order would cancel the throw); "self" for a cast without a target (the squad goes on); nil for nothing.
-- Log: 'BR ORD <t> <id> <unit> CAST_POS17 X Z why cast stikkbomb at setup <id> <unit> dist D models N F hold'.
B.busy, B.n_cast = {}, 0
function B.on_fight(u, role, F, W)
	if Brain.num("Casts", 1) < 1 then return nil end
	local now = Brain.now or 0
	if B.busy[u.id] ~= nil and now - B.busy[u.id] < Brain.num("CastBusySecs", 2) then return "busy" end
	local prof = Brain.roles.profile()
	local list = prof and prof.casts and (prof.casts[u.key] or prof.casts[role]) or nil
	if list == nil then return nil end
	-- (bench s6_l8_c, 24 games: rapid fire took 3 of 83, the shootas' suppression 134 of 331 - they come with the kustom
	-- shoota / the big shoota; a cast that needs a piece ('gear') or an upgrade ('upg') is tried only when the purse
	-- bought it. A takeover in mid-game does not know what was bought: no such casts there.)
	local function bought(t, sub)
		for k in pairs(t or {}) do if type(k) == "string" and string.find(k, sub, 1, true) ~= nil then return true end end
		return false
	end
	local E = Brain.economy
	for _, c in ipairs(list) do
		local has = (c.gear == nil or bought(E.gear, c.gear)) and (c.upg == nil or bought(E.upg[u.id], c.upg))
		if has and B.ready(u, c.k, c.cd) then
			local t, td
			for _, e in ipairs(F.en) do
				local d = Brain.d2(u.x, u.z, e.x, e.z)
				if not e.retreating and d <= c.max and d >= (c.min or 0) then
					local arm = (e.d and e.d.arm) or (e.veh and "veh" or "inf")
					local inf = (arm ~= "veh" and arm ~= "bld" and not e.veh)
					local ok = false
					if c.at == "setup" then ok = inf and e.d ~= nil and e.d.setup == 1
					elseif c.at == "clump" then ok = inf and (e.n or 1) >= 3 and not e.mel
					elseif c.at == "melee" then ok = inf and e.mel == true
					elseif c.at == "inf" or c.at == "near" then ok = inf
					elseif c.at == "veh" then ok = not inf end
					if ok and c.ff then
						for _, w in ipairs(W.own) do if w.id ~= u.id and Brain.d2(w.x, w.z, e.x, e.z) <= Brain.num("CastFfR", 6) then ok = false; break end end
					end
					if ok and (td == nil or d < td) then t, td = e, d end
				end
			end
			if t ~= nil then
				local why = { "cast", c.name, "at", c.at, t.id, Brain.short(t.key), "dist", Brain.f0(td), "models", t.n, F.key, tostring(F.verdict) }
				local done
				if c.kind == "pos" then done = B.cast(u, c.k, "pos", t.x, t.y, t.z, c.cd, why)
				elseif c.kind == "squad" then done = B.cast(u, c.k, "squad", t.id, 0, 0, c.cd, why)
				else done = B.cast(u, c.k, "self", 0, 0, 0, c.cd, why) end
				if done then
					B.n_cast = B.n_cast + 1
					if c.kind ~= "self" then B.busy[u.id] = now; return "busy" end
					return "self"
				end
			end
		end
	end
	return nil
end

-- ---- the player's global for a fight (step 3; orks: 'Waaagh!', 200 of the red resource) ----------------------------------
-- The verifier (13.11): with standard resources no 200-point spend of the red resource was seen in the brain's scenes,
-- with 200+ banked for tens of seconds - Relic's player_abilities.ai asks its own demand and position functions, which
-- lean on the military layer the brain replaced. The brain casts it itself:
--   at the START of a fight it can win: verdict PRESS, GlobalMinOurs (3) squads of ours in it against 2 or more, the
--     first GlobalStartSecs (8 s) after contact;
--   to break a STALEMATE: verdict HOLD, not weaker (ratio >= Even), GlobalStaleSecs (15 s) after contact.
-- The engine says whether it can be cast now (AIPlayer_CanPlayerCastAbility: the resource, the recharge); the request
-- goes through Relic's plumbing (Request_PlayerAbility / ...SingleTarget at our squads in that fight).
-- Log: 'BR ABIL <t> GLOBAL <ability> CAST|CANNOT why <reason> fight F ratio R ours N enemy N age S'. Brain_Global=0: off.
B.global_t = -100
-- Step 5 (the verifier, 13.11: 12 casts of 13 went into PRESS fights at 2 : 1 and better - 6-8 squads against 2): the
-- global is for a fight that is still IN THE BALANCE, or to break a STALL - not for mopping up. GlobalRule 4 (default):
--   decided for us, no cast: the ratio of THIS tick (not the smoothed one: it lags while the enemy melts) above
--     GlobalMaxRatio (1.6); or we are more than GlobalCountK (2) x their squads and stronger (GlobalCountRatio 1.2); or
--     the enemy has lost GlobalWonLossK (3) x what we lost in the last 10 s (and GlobalWonLossMin 150 health at least);
--   decided against us, no cast: the ratio below GlobalMinRatio (0.6), or the verdict is not PRESS / HOLD;
--   in the balance: GlobalMinAge (3 s) after the first fire, the ratio between the two lines;
--   a stall: GlobalStaleSecs (20 s) after the first fire, the ratio up to GlobalStallMaxRatio (2.2), not more than
--     GlobalCountK x their squads, and nobody is melting (neither side lost GlobalStallLoss 250 health in 10 s).
-- GlobalRule 3 = step 4 (any fight we press or hold, smoothed ratio up to GlobalMaxRatio3 3); 1 = step 3.
-- Returns the reason to cast, or nil and the reason not to (for the log).
function B.global_fit(F, rich)
	local n_ours, n_en = table.getn(F.ours), table.getn(F.en)
	local raw = (F.s_ours or 0) / math.max((F.s_en or 0), 1)
	-- two ratios: this tick's and the smoothed one of the verdicts. The smoothed one lags both ways - below while the enemy
	-- melts (the verifier: 2.89, 4.1 six seconds later), above when the fight turns against us (bench s5_x_a: '5 squads
	-- against 2 ... ratio 2.14 now 0.78 lost10s 246:0' was called won). Lost = both say so; won = this tick's is above the
	-- line and the smoothed one is not far below it (0.8 x), or the other way round.
	local sm = F.ratio or raw
	local r, r_lo = math.max(raw, sm), math.min(raw, sm)
	local lo, le = F.loss_ours or 0, F.loss_en or 0
	local head = n_ours .. " against " .. n_en .. " (" .. tostring(F.verdict) .. ", ratio now " .. Brain.f2(raw) .. ")"
	if F.verdict ~= "press" and F.verdict ~= "hold" then return nil, "we are leaving it" end
	if r < Brain.num("GlobalMinRatio", 0.6) then return nil, "it is lost" end
	if le >= Brain.num("GlobalWonLossMin", 150) and le >= Brain.num("GlobalWonLossK", 3) * math.max(lo, 1) then return nil, "it is won: the enemy melts (" .. Brain.f0(lo) .. ":" .. Brain.f0(le) .. " in 10 s)" end
	local many = n_ours > Brain.num("GlobalCountK", 2) * n_en
	if many and r_lo >= Brain.num("GlobalCountRatio", 1.2) then return nil, "it is won: " .. n_ours .. " squads against " .. n_en end
	-- (requisition lying idle - the army at the population cap, bench s5_l6_a: 967-1588 in the bank - or the red resource
	-- near its cap of 999 - s5_l6_b: 'red 999' for the last eight minutes - makes the global nearly free: the line of 'decided for us' moves up to GlobalRichMaxRatio 2.5; the count and the melting enemy stay)
	local max_r = rich and Brain.num("GlobalRichMaxRatio", 2.5) or Brain.num("GlobalMaxRatio", 1.6)
	if not (r > max_r and r_lo > 0.8 * max_r) then
		if F.age >= Brain.num("GlobalMinAge", 3) then return "a fight in the balance: " .. head end
		return nil, "the fight has only begun"
	end
	if r <= Brain.num("GlobalStallMaxRatio", 2.2) and not many and F.age >= Brain.num("GlobalStaleSecs", 20)
		and lo < Brain.num("GlobalStallLoss", 250) and le < Brain.num("GlobalStallLoss", 250) then
		return "a stall: " .. Brain.f0(F.age) .. " s and nobody gives, " .. head
	end
	return nil, "it is won: ratio " .. Brain.f2(r)
end
-- is the global in the engine's own list of this player's abilities? (asked once it is wanted; elite.scar resolves the
-- blueprint by its name WITHOUT pcall - the brain sends the command only for a blueprint the engine has shown it)
function B.global_known(pat)
	if B.global_has ~= nil then return B.global_has end
	if type(AIAbility_GetPlayerCount) ~= "function" or type(AIAbility_GetPlayerAt) ~= "function" or type(PBG_GetName) ~= "function" then return false end
	local n = AIAbility_GetPlayerCount(s_selfplayer) or 0
	if n <= 0 then return false end
	local has = false
	for i = 0, n - 1 do
		local p = AIAbility_GetPlayerAt(s_selfplayer, i)
		if p ~= nil then
			local nm = string.gsub(string.lower(tostring(PBG_GetName(p))), "\\", "/")
			if string.find(nm, pat, 1, true) ~= nil and string.find(nm, "shout", 1, true) == nil then has = true end
		end
	end
	B.global_has = has
	Brain.log("ABIL", "GLOBAL", pat, has and "is among" or "is NOT among", "the player's", n, "abilities (the engine's list)")
	return has
end
function B.global(W)
	local prof = Brain.roles.profile()
	local pat = prof and prof.global_fight or nil
	if pat == nil or Brain.num("Global", 1) < 1 then return end
	-- what elite.scar saw of the casts sent by the game's command (step 4): the recharge starts only when the resource went
	if table.getn(Brain.inbox) > 0 then
		for _, m in ipairs(Brain.inbox) do
			if m.took then B.global_took = W.now; B.global_done = (B.global_done or 0) + 1 end
			Brain.economy.hold = nil
			Brain.log("ABIL", "GLOBAL", pat, m.took and "TOOK" or "FAILED", "why", "elite.scar looked 2 s after the command: the red resource is", Brain.f0(m.red), "casts so far", B.global_done or 0)
		end
		Brain.inbox = {}
	end
	if W.now - B.global_t < Brain.num("GlobalGapSecs", 10) then return end
	local best, why, no_F, no_why
	local rule = Brain.num("GlobalRule", 4)
	for _, F in ipairs(W.fights) do
		if F.keep ~= nil and F.keep.tc ~= nil and table.getn(F.ours) >= Brain.num("GlobalMinOurs", 3) and table.getn(F.en) >= 2 then
			if rule >= 4 then
				local yes, no = B.global_fit(F, Brain.purse ~= nil and ((Brain.purse.req or 0) >= Brain.num("GlobalRichReq", 600) or (Brain.purse.red or 0) >= Brain.num("GlobalRichRed", 800)))
				-- (step 7: the push's fight - the fist is in at the plan's objective: the Waaagh goes with it unless the fight is
				-- lost or won already, GlobalPush=0: off)
				local obj = Brain.plan.objective
				if yes == nil and Brain.plan.push ~= nil and obj ~= nil and Brain.num("GlobalPush", 1) >= 1 and (F.verdict == "press" or F.verdict == "hold")
					and F.age >= Brain.num("GlobalMinAge", 3) and Brain.d2(F.x, F.z, obj.x, obj.z) <= Brain.num("GlobalPushR", 50)
					and F.ratio >= Brain.num("GlobalMinRatio", 0.6) and F.ratio <= Brain.num("GlobalRichMaxRatio", 2.5) then
					yes = "the push: the fist is in at the objective, " .. table.getn(F.ours) .. " against " .. table.getn(F.en) .. " (" .. F.verdict .. ", ratio " .. Brain.f2(F.ratio) .. ")"
				end
				if yes ~= nil then
					if best == nil or F.s_en > best.s_en then best, why = F, yes end
				elseif no_F == nil or F.s_en > no_F.s_en then no_F, no_why = F, no end
			elseif rule >= 3 then
				-- (step 4: not into a fight that is won anyway: bench s4_a - cast at 7 squads against 2 leftovers, ratio 845)
				if (F.verdict == "press" or F.verdict == "hold") and F.age >= 1 and F.ratio <= Brain.num("GlobalMaxRatio3", 3) and (best == nil or F.s_en > best.s_en) then
					best, why = F, "a fight of " .. table.getn(F.ours) .. " against " .. table.getn(F.en) .. " (" .. F.verdict .. ")"
				end
			elseif F.verdict == "press" and F.age >= 1 and F.age <= Brain.num("GlobalStartSecs", 8) then best, why = F, "the start of a fight we can win"
			elseif F.verdict == "hold" and F.age >= Brain.num("GlobalStaleSecs", 15) and F.ratio >= Brain.num("Even", 0.8) and best == nil then
				best, why = F, "a stalemate: even for " .. Brain.f0(F.age) .. " s"
			end
		end
	end
	if best == nil and no_F ~= nil then
		Brain.say("ABIL", "global|KEPT", 30, { "GLOBAL", pat, "KEPT", "why", no_why, "fight", no_F.key, "ratio", Brain.f2(no_F.ratio), "now", Brain.f2((no_F.s_ours or 0) / math.max(no_F.s_en or 0, 1)),
			"ours", table.getn(no_F.ours), "enemy", table.getn(no_F.en), "lost10s", Brain.f0(no_F.loss_ours or 0) .. ":" .. Brain.f0(no_F.loss_en or 0), "age", Brain.f0(no_F.age) }, no_F.key .. "|" .. no_why)
	end
	if best == nil then return end
	-- step 4: by the game's own command (elite.scar mode 400+k -> Cmd_PlayerAbility) with the purse the game counts. Bench
	-- 13.11: 'Waaagh!' costs 200 requisition AND 200 of the red resource (Elite 3.2.1); Relic's can-cast said no 99 times
	-- of 99 because the REQUISITION was not there (the purchase scripts spend it as it comes), not the red resource.
	local purse = Brain.purse
	if prof.global_k ~= nil and purse.t ~= nil and W.now - purse.t <= 3 and Brain.num("GlobalScar", 1) >= 1 then
		local tail = { "fight", best.key, "ratio", Brain.f2(best.ratio), "ours", table.getn(best.ours), "enemy", table.getn(best.en), "age", Brain.f0(best.age),
			"red", Brain.f0(purse.red), "req", Brain.f0(purse.req) }
		local function tell(what, reason, hold)
			local parts = { "GLOBAL", pat, what, "why", reason }
			for _, w in ipairs(tail) do table.insert(parts, w) end
			if what == "CAST" then Brain.log("ABIL", table.concat(parts, " ")) else Brain.say("ABIL", "global|" .. what, hold, parts, what .. "|" .. reason .. "|" .. best.key) end
		end
		local left = (B.global_took or -1000) + (prof.global_recharge or 90) - W.now
		if left > 0 then tell("CANNOT", "it recharges", 60); return end
		if purse.red < (prof.global_red or 0) then tell("CANNOT", "the red resource is short of " .. Brain.f0(prof.global_red) .. " - wanted for " .. why, 30); return end
		-- the purse elite.scar told is 1-3 s old and does not know what the purse of 30_economy.ai has asked for since (bench
		-- vf34_x4: 1 command of 9 failed - told 249, 146 in the bank: the reinforcements of that second and the one before
		-- were charged already). The price must be there AFTER the purchases of the last GlobalSpendSecs (2 s, and every
		-- second the told purse is old), with GlobalReqMargin (10) to spare.
		local since = W.now - Brain.num("GlobalSpendSecs", 2) - math.max(W.now - purse.t, 0)
		local spent = Brain.economy.active() and Brain.economy.spent_since(since) or 0
		local price = (prof.global_req or 0)
		if price > 0 and purse.req - spent < price + Brain.num("GlobalReqMargin", 10) then
			-- the purse keeps the requisition for it while the fight lasts (30_economy.ai, wish 3; reinforcing goes on)
			if Brain.economy.active() then Brain.economy.hold = { req = price, t = W.now, why = pat } end
			tell("CANNOT", "the requisition is short of " .. Brain.f0(price) .. " after " .. Brain.f0(spent) .. " asked for in the last seconds (the purse keeps it now) - wanted for " .. why, 30)
			return
		end
		if not B.global_known(pat) then tell("CANNOT", "the engine's list of the player's abilities does not show it", 600); return end
		B.global_t = W.now
		-- the command is executed by elite.scar within a second: the purse keeps the price until the answer comes (bench
		-- s4_x2: one command of 13 found the requisition gone - the economy had spent it in the same tick: 'took 0 ... req 53')
		if Brain.economy.active() then Brain.economy.hold = { req = prof.global_req, t = W.now, why = pat } end
		Brain.signal(400 + prof.global_k, 0, 0, 0)
		B.global_n = (B.global_n or 0) + 1
		tell("CAST", why .. " - by the game's command", 0)
		return
	end
	if type(AIAbility_GetPlayerCount) ~= "function" or type(AIAbility_GetPlayerAt) ~= "function" or type(AIPlayer_CanPlayerCastAbility) ~= "function"
		or type(Request_PlayerAbility) ~= "function" or type(PBG_GetName) ~= "function" then
		Brain.say("ABIL", "global_api", 600, { "GLOBAL", pat, "CANNOT", "why", "the engine's functions for a player ability are not here" })
		return
	end
	local pbg, name
	for i = 0, AIAbility_GetPlayerCount(s_selfplayer) - 1 do
		local p = AIAbility_GetPlayerAt(s_selfplayer, i)
		if p ~= nil then
			local nm = string.gsub(string.lower(tostring(PBG_GetName(p))), "\\", "/")
			if string.find(nm, pat, 1, true) ~= nil and string.find(nm, "shout", 1, true) == nil then pbg, name = p, string.gsub(nm, "^.*/", "") end
		end
	end
	local tail = { "fight", best.key, "ratio", Brain.f2(best.ratio), "ours", table.getn(best.ours), "enemy", table.getn(best.en), "age", Brain.f0(best.age) }
	local function say(what, reason, hold)
		local parts = { "GLOBAL", name or pat, what, "why", reason }
		for _, w in ipairs(tail) do table.insert(parts, w) end
		if what == "CAST" then Brain.log("ABIL", table.concat(parts, " ")) else Brain.say("ABIL", "global|" .. what, hold, parts, what .. "|" .. reason .. "|" .. best.key) end
	end
	if pbg == nil then say("CANNOT", "the player has no such ability", 600); return end
	-- the resource by Relic's own books (AIAbility_GetCost against what the player has), so that the line says which it is
	local can = (AIPlayer_CanPlayerCastAbility(s_selfplayer, pbg) == true)
	local rich
	if type(AIAbility_GetCost) == "function" and type(AIResource_GetCurrentResources) == "function" and type(ResourceAmount_Has) == "function" then
		rich = (ResourceAmount_Has(AIResource_GetCurrentResources(s_selfplayer), AIAbility_GetCost(s_self_modplayer, pbg)) == true)
	end
	if rich == false then say("CANNOT", "not enough of the resource (can_cast " .. (can and 1 or 0) .. ") - wanted for " .. why, 30); return end
	if not can then say("CANNOT", "the engine says no" .. (rich and " WITH the resource in hand (the recharge or a requirement)" or " (the resource or the recharge)") .. " - wanted for " .. why, 30); return end
	B.global_t = W.now
	local targeted = (type(AIAbility_IsTargeted) == "function" and AIAbility_IsTargeted(pbg) == true)
	if targeted then
		-- at our squad of that fight that is nearest to the enemy (an engine position: read from the squad itself)
		local u
		for _, v in ipairs(best.ours) do if u == nil or (v.ed or 999) < (u.ed or 999) then u = v end end
		local pos
		for i = 0, Military_SquadTotalCount(s_selfplayer) - 1 do
			local aisq = Military_GetAISquadAtIndex(s_selfplayer, i)
			local sq = aisq and AISquad_ConvertToSimSquad(aisq) or nil
			-- (an empty squad has no position: Squad_GetPosition on it is the call that hung the game on 10.11 - counted first)
			if sq ~= nil and u ~= nil and type(Squad_Count) == "function" and Squad_Count(sq) > 0 and Squad_GetGameID(sq) == u.id then pos = Squad_GetPosition(sq) end
		end
		if pos == nil or type(Request_PlayerAbilitySingleTarget) ~= "function" then say("CANNOT", "no position for a targeted ability", 30); return end
		Request_PlayerAbilitySingleTarget(s_selfplayer, TGROUP_PlayerAbility, TPRIORITY_PlayerAbility, pbg, pos)
	else
		Request_PlayerAbility(s_selfplayer, TGROUP_PlayerAbility, TPRIORITY_PlayerAbility, pbg)
	end
	B.global_n = (B.global_n or 0) + 1
	say("CAST", why .. (targeted and " (at our squads)" or ""), 0)
end

	end
	eliteai_brain_70_abilities()
end

-- ===== EliteAI brain/80_team.ai =====
do
	local function eliteai_brain_80_team()
-- BRAIN 80_team: playing with allies (2v2, 3v3) - the same brain, with one more input.
-- Owns: R49-R52.
-- In:  the allies' squads and fights (their positions are on our screen as on a person's), their points being captured
--      (Military_IsMilitaryPointBeingCapturedByUs covers the team), W.
-- Out: extra candidates for the plan's objective ("ally's fight", "ally under attack") and vetoes ("ally is capturing
--      that point") - the army module itself does not know about allies.
-- Cadence: 5 s with the plan.  Log: 'BR TEAM <t> <HELP|JOIN|LEAVE_POINT|WITHDRAW> ally <player> why <reason>'.
-- STAGE: interface only. The first slice already keeps R51 half-way: a point our team is capturing is not ours to take
-- (20_plan.ai reads p.us_cap once the brain orders captures itself).
Brain.team = {}
function Brain.team.update(W) end

	end
	eliteai_brain_80_team()
end

-- ===== EliteAI brain/85_endgame.ai =====
do
	local function eliteai_brain_85_endgame()
-- BRAIN 85_endgame: when the game is lost - and when it is not yet.
-- Owns: R53, R54, R56.
-- In:  W.vp, our points, army and income over the last minutes, the tier of both sides (what was seen).
-- Out: a state for the plan: "fight on" (default) | "last stand" (no points: retake the nearest one with everything,
--      never sit at the base under the enemy's abilities) | "lost" (1v1 only, all of: no points, army gone, nothing to
--      rebuild with, for LostMinutes) -> surrender, once a way that is safe for the simulation's sync is found.
-- Cadence: 30 s.  Log: 'BR END <t> <state> why points N army S income R ...'.
-- STAGE: interface only.
Brain.endgame = { state = "fight on" }
function Brain.endgame.update(W) end

	end
	eliteai_brain_85_endgame()
end

-- ===== EliteAI brain/90_boot.ai =====
do
	local function eliteai_brain_90_boot()
-- BRAIN 90_boot: switching the brain on. The LAST file: everything above only defined tables.
--
-- What "on" means (EliteAI_MODE.brain, decided by the dispatcher at the top of default.ai: [Lua] Brain=1 and a race with a
-- profile, on the vanilla base, our old layer off - main.ai / mechanics.ai are passive, their director never starts):
--  * InitializeAI is REPLACED, not wrapped: the brain registers the time rules itself. What is not registered does not run -
--    that is the whole switch-off; there is no flag that some other code has to honour.
--  * Brain.LEGACY is the one list of Relic's script-side strategy that still runs. A topic leaves the list in the commit
--    that gives it to a brain module (the migration order: BRAIN_DESIGN_RU.md, section 6).
--  * Relic's plumbing below the scripts (tasks, production, construction, capture, pathing, weapons) is used as it is.

Brain.LEGACY = {
	analysis = true,      -- cache.perframe_data, state_analysis.update, ai_budget:update: the books Relic's purchase code reads
	capture = false,      -- CalcCapturePriorities + strategy_resourcing.execute: the engine's capture tasks - REPLACED by 55_capture.ai
	                      -- (step 2: the brain orders every capture itself). Never registered, never called.
	buildorder = true,    -- strategy_buildorder: the opening purchases - REPLACED by 30_economy.ai (step 4): set false in InitializeAI
	purchases = true,     -- ai_budget:do_purchases: units, tiers, posts, generators, upgrades - REPLACED by 30_economy.ai / 40_composition.ai
	                      -- (step 4; false in InitializeAI when the module is in charge: Brain_Econ=1 and a profile with a plan).
	                      -- Went with it and is NOT replaced yet: turrets, the race's other globals (Relic cast them as "purchases")
	structures = true,    -- unfinished buildings are finished or scuttled (plumbing: stays)
	military = false,     -- strategy_military: target ranking, combat / sniper tasks - REPLACED by 50_army.ai. Never registered.
}

-- Relic's AI_Think2 with the list applied (default.ai of the vanilla base; the purchase timers are Relic's)
Brain_Think2 = function()
	aipushtrace("Strategies")
	local L = Brain.LEGACY
	if s_buildorder_phase and L.buildorder then
		strategy_buildorder.execute()
		if (AIPlayer_TotalDamageReceived(s_selfplayer) > 0 or strategy_buildorder.is_done() or World_GetGameTime() > k_maxBuildOrderTime) then
			s_buildorder_phase = false
			Task_KillInactiveTasksInGroup(s_selfplayer, TGROUP_BuildOrder)
		end
		if L.capture then strategy_resourcing.execute() end
	else
		if s_buildorder_phase then s_buildorder_phase = false end
		if L.capture then strategy_resourcing.execute() end
		if L.purchases then
			if Purchase_IsTimeToPurchase(REGULAR_BUDGET_TYPE) then
				ai_budget:do_purchases(false)
				Purchase_ResetPurchaseTimer(REGULAR_BUDGET_TYPE)
			end
			if Purchase_IsTimeToPurchase(POWER_BUDGET_TYPE) then
				ai_budget:do_purchases(true)
				Purchase_ResetPurchaseTimer(POWER_BUDGET_TYPE)
			end
		end
	end
	-- Relic's AI_Think3 without strategy_military.execute()
	if L.structures then
		HandleIncompleteStructures()
		Construction_ScuttleIncompleteThreatenedBuildings(s_selfplayer, 50)
	end
	aipoptrace()
end

-- the brain's own tick
Brain_Tick = function()
	local now = World_GetGameTime()
	if now == nil then return end
	Brain.now = now
	if now < Brain.num("StartSecs", 1) then return end
	local W = Brain.perception.update(now)
	Brain.every("plan", Brain.num("PlanSecs", 5), Brain.plan.update, W)
	Brain.army.update(W)
	Brain.abilities.global(W)
	Brain.every("economy", Brain.num("EconSecs", 1), Brain.economy.update, W)
	Brain.every("composition", Brain.num("CompSecs", 5), Brain.composition.update, W)
	Brain.every("team", Brain.num("TeamSecs", 5), Brain.team.update, W)
	Brain.every("endgame", Brain.num("EndSecs", 30), Brain.endgame.update, W)
	-- the engine's own retreat rule works off the "aggression" of the squads; 1.0 = "allow units to die": the brain decides
	-- who leaves a fight (R1-R6). Relic set it in strategy_military, which does not run - so it is set here.
	Brain.every("wrap_hold", 10, function() if Brain.wrap_hold ~= nil then Brain.wrap_hold("t" .. Brain.f0(Brain.now)) end end)
	Brain.every("aggression", 30, function() Military_SetSquadAggression(s_selfplayer, Brain.num("Aggression", 1.0)) end)
end

if Brain.on then
	-- Step 6: Relic's squad tactic 'Hold' (enter a building near by) is refused for a mob of a brain player - wrapped when
	-- this file is loaded, before the engine asks for the function by its name; the rest of the squads keep it.
	function Brain.wrap_hold(when)
		-- (the engine may load tactics.ai once more after this file: the wrap is checked again at InitializeAI and every
		-- 10 s - a function that is not ours is wrapped again)
		-- (Brain_HoldFilter=0: the tactic is left alone and only the order out of the building works - for the bench)
		if type(TacticDemand_Hold) ~= "function" or TacticDemand_Hold == Brain.hold_fn or Brain.num("NoMeleeGarrison", 1) < 1 or Brain.num("HoldFilter", 1) < 1 then return end
		Brain.hold_wrapped = (Brain.hold_wrapped and (Brain.hold_wrapped .. "+") or "") .. when
		local relic_hold = TacticDemand_Hold
		Brain.hold_fn = function(squad, near_e, near_s)
			local pbg = (squad ~= nil) and AISquad_ConvertToPBG(squad) or nil
			local d = pbg and Brain.UNITS[Brain.bp_key(PBG_GetName(pbg) or "")] or nil
			if d ~= nil and d.mel == 1 then
				local S = Brain.army.stats
				S.hold_no = (S.hold_no or 0) + 1
				return -(s_demand_increment or 1)
			end
			return relic_hold(squad, near_e, near_s)
		end
		TacticDemand_Hold = Brain.hold_fn
		-- (the tactic's target filter as well: no building for a mob to enter)
		if type(EntityTargetFilter_FirstHold) == "function" then
			local relic_first = EntityTargetFilter_FirstHold
			EntityTargetFilter_FirstHold = function(squad, ents)
				local pbg = (squad ~= nil) and AISquad_ConvertToPBG(squad) or nil
				local d = pbg and Brain.UNITS[Brain.bp_key(PBG_GetName(pbg) or "")] or nil
				if d ~= nil and d.mel == 1 then
					local S = Brain.army.stats
					S.hold_no = (S.hold_no or 0) + 1
					return nil
				end
				return relic_first(squad, ents)
			end
		end
	end
	Brain.wrap_hold("load")
	function InitializeAI()
		Brain.wrap_hold("init")
		-- Relic's InitializeAI (default.ai), line for line, minus the military rules
		s_components = {}
		for ict = 0, (COMPONENT_COUNT - 1) do s_components[ict] = true end
		TimeRule_RemoveAll(0)
		if Brain.LEGACY.analysis then
			TimeRule_AddInterval(AI_Think1, 0.5, 0)
			TimeRule_AddInterval(AI_Analyze1, 0.5, 0)
			TimeRule_AddInterval(AI_Analyze2, 0.5, 0)
		end
		if Brain.LEGACY.capture then TimeRule_AddInterval(AI_Analyze3, 0.5, 0) end
		TimeRule_AddInterval(Brain_Think2, 0.5, 0)
		TimeRule_AddInterval(AI_Think4, 0.5, 0)
		dr_setdisplay("aidebug" .. AI_GetPlayerID(), true)
		InitializeCommonUseVars()
		cache.init()
		s_personality.Create()
		InitializePlayer()
		InitializeStrategies()
		if Brain.LEGACY.capture then CalcCapturePriorities() end
		Brain.now = World_GetGameTime() or 0
		Military_SetSquadAggression(s_selfplayer, Brain.num("Aggression", 1.0))
		TimeRule_AddInterval(Brain_Tick, Brain.num("TickSecs", 1), 0)
		-- words to elite.scar (the order queue): 10 = this player is here, no dodge reflex - its retreats are watched, whoever
		-- ordered them ('RETREAT seen ... by order|engine': only the brain may send a squad home); 11 = its casts are watched
		-- ('CAST seen ... took 0|1': did the shout / the jump really go off)
		if Brain.num("RetreatWatch", 1) >= 1 then Brain.signal(10, 0, 1, 1) end
		-- 12 = the engine's own retreat is switched off for this player's squads (Squad_EnableRetreat false) and opened only
		-- for the brain's own retreat order. Bench 13.11, 15 scenes: aggression 1.0 does not stop the engine (10 retreats
		-- "by engine", squads at 0.5-0.9 of their health among them), with the lock 0 "by engine", 16 "by order".
		if Brain.num("RetreatLock", 1) >= 1 then Brain.signal(12, 1, 0, 0) end
		if Brain.num("CastWatch", 1) >= 1 then Brain.signal(11, 1, Brain.num("ApiDump", 0), 0) end
		-- 13 = the purse as the game counts it comes back once a second (Brain_ScarNote): the red resource is in no book of
		-- the AI state; the player's own ability then goes by the game's command (modes 400+k / 500+k)
		if Brain.num("Purse", 1) >= 1 then Brain.listen() end
		-- step 4: the economy stage. With 30_economy.ai in charge Relic's purchase scripts and build order do not run.
		if Brain.economy.active() then Brain.LEGACY.purchases, Brain.LEGACY.buildorder = false, false end
		local leg = {}
		for _, k in ipairs({ "analysis", "capture", "buildorder", "purchases", "structures", "military" }) do
			table.insert(leg, k .. "=" .. (Brain.LEGACY[k] and 1 or 0))
		end
		local rows = 0
		for _ in pairs(Brain.UNITS or {}) do rows = rows + 1 end
		Brain.log("INIT", "brain", Brain.VERSION, "race", tostring(s_current_race), "profile", Brain.roles.profile() and 1 or 0,
			"team", tostring(s_self_team), "diff", tostring(s_diffLevel), "units", rows, "legacy", table.concat(leg, " "),
			"tick", Brain.num("TickSecs", 1), "hold_tactic_wrapped", tostring(Brain.hold_wrapped))
	end
end

	end
	eliteai_brain_90_boot()
end

-- ===== /EliteAI =====
InitializeAI()
