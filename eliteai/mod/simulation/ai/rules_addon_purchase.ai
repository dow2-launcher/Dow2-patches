if EliteAI_VANILLA then

---------------------------------------------------------------------------------
-- list all the addons we never want to build - quicker to do this instead of using the demand override functions below
s_ignore_addons = {}

---------------------------------------------------------------------------------
-- Rules for squad-addons

function SquadAddonUpgradeRules( upgradePBG, currentDemand )
		
	-- INSERT MORE RULES HERE
	
	-- other addson should decrease in demand as they increase in count
	local ucount = UtilPBG_CountTotal( upgradePBG )
	if (ucount > 0) then
		return -ucount*ucount*3 -- 3,12,27,...
	end
	
	return 0
end

else

---------------------------------------------------------------------------------
-- list all the addons we never want to build - quicker to do this instead of using the demand override functions below
s_ignore_addons = {}

---------------------------------------------------------------------------------
-- Rules for squad-addons

function SquadAddonUpgradeRules( upgradePBG, currentDemand )
		
	-- INSERT MORE RULES HERE
	
	-- other addson should decrease in demand as they increase in count
	local ucount = UtilPBG_CountTotal( upgradePBG )
	if (ucount > 0) then
		--[[ for k,value in pairs (s_personality.essential_upgrades) do
			if value["hero_gear"] ~= nil then 
				
				if  PBG_IsSame(value[1] , upgradePBG)  and 
					value["hero_gear"] ==  true then
					return -15
				end
			end
		end --]]
	return - 8*ucount -- 3,12,27,...	-- kk edited from ucount*ucount*3
	end

	return 0
end


function kk_SquadHero_AddOnRules( upgradePBG)
	local hero_gear_count = 0
	local upgrade_is_for_hero = false

	--[[  for k,value in pairs (s_personality.essential_upgrades) do
		if UtilPBG_CountTotal(value[1]) > 0 and 
				value["hero_gear"] ==  true then
			local hero_gear_count = hero_gear_count + 1
		end

		if PBG_IsSame(upgradePBG,value[1]) and
				value["hero_gear"] ==  true   then
			upgrade_is_for_hero = true
		end
	end

	if hero_gear_count >= cache.tech_tier_level and upgrade_is_for_hero ==  true then
			return -10
		else return 0
	end --]]

	return 0	
end
	
end
