if EliteAI_VANILLA then
-- EliteAI 10.11 (step 4b): copy of Elite 3.2.1 strategy_unit_purchase.ai + purchase variety for the new logic
-- (EliteAI.on, set in main.ai). Elite's AIs (EliteAI.on false/nil) run exactly the original code.
-- 1) diversity: the more squads of one blueprint (and of one class: troops/vehicles) we have, the lower its demand;
--    blueprints not built yet get a bonus. The enemy army is already in Elite's demand (CombatRatingDiff vs enemy team).
-- 2) super units (Baneblade, Land Raiders, Great Unclean One, Avatar, Swarmlord...): none before SuperMinTime (s) and
--    without SuperMinArmy combat squads, one at a time; until then the money goes into the army.
-- Tuning from EliteAI.ini [Lua]: DivK, DivShare, DivNew, CatShare, SuperMinTime, SuperMinArmy, SuperMult, SuperCost.
-- 3) spend (10.11, after import below): an idle-bank watchdog - money above Spend_BankReq/Spend_BankPow for Spend_IdleSecs
--    without a spawn is spent on units (diversity score, no engine demand) and squad upgrades; log "SPEND idle bank ...".
--    The class-share damping (CatShare) applies only to races with two unit classes among the buildables (tyranids: all
--    "inf" -> every unit got x0.36 before).
-- 4) reinf (10.11, after the spend block): the reinforcement budget - while the power bank piles up and the req bank is below
--    the next tier / the cheapest power unit, cheap squads (spawn cost power < Spend_PowUnit) are reinforced only by the rules
--    of the arbiter Conf_ReinforceVsSave (A/B/C) and within a share of the req income; log "REINF ...".
-- 5) gate (10.11, step 15): one verdict EliteAI_GateDrop for every blueprint we forbid (a super unit outside its window, a limit
--    of 0): no demand at all in AccumulateSquadDemand (so it is never the "first" choice Elite stalls on and reserves nothing),
--    not a candidate of the watchdog; log "GATE drop <sbps> <why>". The watchdog's "locked" exit (nothing affordable within the
--    budget's share while the bank could pay) no longer stops it: it buys over the locks of the budgets ahead of ours in the order
--    (BUDGET_PlayerAbility, Elite's researches), never over the tech plan's reserve (EliteAI_TechReserve); log "-> buy ... over_lock".
-- 6) energy (11.11, the scene polygon; the block after the reinf block): power in excess and req short - the req goes where the
--    power goes (units and squad upgrades by the power share of their cost, the next tier at once, no new generators), squad
--    upgrades respect the tech plan's reserve and wait for a unit that is within reach (arbiter Conf_AddonVsUnit A/B/C), "save"
--    only for a unit the income brings within Energy_EtaMax; every upgrade bought is logged ("buy_addon"); log "ENERGY ...".
-- 7) garrison (11.11): while mod/mechanics.ai reports an enemy squad in a building next to our point (EliteAI.gar) for
--    Gar_BuySecs, the counter units of reports/tactics_kb/kb.yaml and flamer / grenade upgrades get a higher demand; log "GAR ...".
EliteAI_P = { cost_logged = {}, tier_seen = {}, ncls = 2, pass = 0 }   -- tier_seen[name] = our tech level when the unit first became producible
local function eai_num(key, default)
	if EliteAI and EliteAI.num then return EliteAI.num(key, default) end
	return default
end
local function eai_log(...)
	if EliteAI and EliteAI.log then EliteAI.log(...) end
end
local function eai_time()
	local t = World_GetGameTime()                                           -- 12: direct (was a silent pcall)
	if t then return math.floor(t) end
	return -1
end
-- (step 6: "stormlord" - 800 / 180, the baneblade's price and chassis: 980 is under SuperCost by 20, so it was no super unit -
-- s5: waited for 7 times as "the dear unit of tier 3" from 13:30 on and never paid; "stormblade" - the same 800 / 180, the smoke
-- s6_sm_tyr2: "-> none wait_tier ig_stormblade ... dear" at population 92 of 100)
local SUPER_NAMES = { "baneblade", "stormlord", "stormblade", "landraider", "land_raider", "great_unclean_one", "avatar", "swarmlord", "squiggoth", "stompa" }
local function eai_class(name)
	if string.find(name, "heroes", 1, true) then return "hero" end
	if string.find(name, "vehicles", 1, true) then return "veh" end
	return "inf"
end
-- STEP 4 OF THE VANILLA BASE (SPEND 0.10; VANILLA_BASE_RU.md 14.2) THE TIER OF A UNIT. "The tier of a unit = our level when it first
-- became producible" - but the engine says "producible" (AIProduction_CanProduce) from the moment the tier research is REQUESTED,
-- and our level stays until the research is DONE (strategy_tech_purchase.ai: CalculateCurrentTechLevel for the new logic). So
-- every unit got the label of the tier below its own: s3h, all 7 mirrors, both sides - "buy 457 ... ork_deff_dread army 7 tier 1",
-- ig_manticore x84 "tier 1", ork_looted_tank / ork_kommandos / ig_kasrkin_squad "tier 2", not one "tier 3" in 334 purchases.
-- Everything that reads the label was off by one: Tech_TierMult (x1.5 for the tier we stand on) and Tech_NewTierMult were never
-- given (no blueprint ever had "ts >= lvl"), Tech_OldTierMult damped every blueprint alike for the rest of the match (the
-- count of "ours of this tier" stayed 0), and the swap at the population cap (EliteAI_SwapWeak "tier < 2") would have stepped
-- over the T2 units as well. The units we tech for were never preferred: 0 nob squads, 0 battlewagons, 0 leman russes, 0
-- ogryns in 7 matches x 2 players of this side (and of the released AI's - the same code; that file is frozen).
-- Now: a blueprint first seen while the research of the next tier is requested or runs (EliteAI_T.st[level]: started, not
-- done - the tech plan's own state, numbers) belongs to that next tier. Tier_Label=0 = the labels of 0.9.
local function p_tier_now()
	local lvl = (CalculateCurrentTechLevel and CalculateCurrentTechLevel()) or (cache and cache.tech_tier_level) or 1
	if eai_num("Tier_Label", 1) < 1 then return lvl end
	local T = EliteAI_T
	local st = (type(T) == "table" and type(T.st) == "table") and T.st[lvl] or nil
	if type(st) == "table" and st.started and not st.done then return lvl + 1 end
	return lvl
end
EliteAI_TierNow = p_tier_now                                                -- the stub run
-- STEP 5 OF THE VANILLA BASE (SPEND 0.11 / ENERGY 0.15; VANILLA_BASE_RU.md 16.1) THE ROOM FOR THE UNITS OF THE TIER.
-- s4_mir_tyr_ig, the tyranids of this side: T3 done at 14:55 and not one unit of tier 3 to the end, 699 power in the bank. The
-- log: population 86 at 11:00, 98 at 12:00 (a genestealer brood at 11:55), 96-100 of 100 from then to 22:00 with ten squads
-- that lost 19 models in the whole match - "ENERGY popcap ... no spawn can be asked for" from the day the tier came. No
-- carnifex (575 / 150, some 18 of population) could be asked for at any moment after the research was paid: the 300 req and
-- 150 power bought nothing, the req went into upgrades (7 -> 20 of them, 1325 req, after 15:00), and the swap of step 4 (on
-- at 18:13, by 450 power) frees room only as models die - none did. The orks' and IG's first units of tier 3 came 150 s after
-- the research for the same reason in the small: the room and the req had gone into one more unit of the old tiers.
-- The last Room_Pop (20) of the population cap are KEPT for the units of the tier we tech for:
--   from Room_Lead (180 s) before the plan's time of the tier-3 research (EliteAI_T.plan_tt, the tech plan's own number),
--   while that research is requested or runs, and after it - until Tech_TierWant (2) units of that tier are ours, and not
--   longer than Room_MaxSecs (300 s) after the research (or after the last unit of the tier): a tier whose units do not
--   come does not hold the army down for ever; nor does a research that is planned and not begun - the room "by the
--   plan" lasts Room_PlanMax (360 s: the lead, the arbiter's deadline of 150 s and a margin), then waits for the request -
-- * a blueprint of a LOWER tier is no candidate for a NEW squad when it would take the population into that room
--   (EliteAI_PurchaseMult 0 - Elite's demand, the plan's next unit and the watchdog alike; "SPEND room <unit> ...");
--   the population a blueprint takes is LEARNED from our own purchases (p_popcost: the population after the request was
--   started against the one before, the smallest seen; Room_UnitPop 15 until then);
-- * inside the room the T1 squads are refilled as in the gentle swap (EliteAI_PopSwap, way in "tier": Swap_FloatFill 0.6).
-- Room_On=0 = as 0.10. "room", "room_block" in ENERGY stats.
-- STEP 6 (SPEND 0.12; VANILLA_BASE_RU.md 17 / 18) THE ROOM IS SHORT. s5 (4499af7), 9 players: the room stood from ~9:10 (the plan's
-- time - 180 s) to 18:20-22:30 - the clock of "its units do not come" started anew with the first unit of the tier - and
-- all that time no squad of the old tiers was bought above 65 of population: the army at 12:00 and at the end paid for it,
-- while the first unit of tier 3 waited for its req, not for room (the population at the end of the research was 52-81).
-- Now: * the room begins with the REQUEST of the research (Room_Lead 0: "by the plan" only from the plan's time on, when
--        the research is late, Room_PlanMax = Room_Lead + 180 s at most);
--      * after the research it lasts Room_MaxSecs (180 s, was 300) FROM THE END OF THE RESEARCH - a unit of the tier does
--        not start the clock anew (Room_Restart=1 = as 0.11) - and ends with the first unit of the tier (Room_Want 1; was
--        Tech_TierWant 2). So: the research (78 s) + three minutes at most;
--      * a call-in (a global that brings squads for req) is no candidate while the room is kept, a raid at our base aside
--        (mod/mechanics.ai ra_demand: s5_tyr_ig - "tyr_spawn_without_number" 300 req, 54 s after the research: the population
--        81 -> 95, the lictor that was 40 s away came 234 s later);
--      * after the research, while the room is kept, the unit the pipeline waits for is first under every rule of
--        Conf_AddonVsUnit, as behind the tempo (e_hold_tick; Room_UnitFirst=0 = off).
EliteAI_P.popcost = {}
local function p_popcost( name, default )
	local v = EliteAI_P.popcost and EliteAI_P.popcost[name]
	if v ~= nil then return v end
	return default or eai_num("Room_UnitPop", 15)
end
EliteAI_PopCost = p_popcost                                                 -- the stub run
-- returns on (bool), the tier the room is kept for, why ("plan" | "plan_full" | "research" | "done")
function EliteAI_Room()
	local E = EliteAI_E
	if EliteAI == nil or EliteAI.on ~= true or cache == nil or E == nil or eai_num("Room_On", 1) < 1 then return false end
	local now = World_GetGameTime()
	if E.room_t == now then return E.room == true, E.room_tier, E.room_why end
	E.room_t = now
	local lvl = cache.tech_tier_level or 1
	local rt = eai_num("Room_Tier", 3)
	local tier, why = nil, nil
	local T = EliteAI_T
	if lvl >= rt then tier, why = lvl, "done"
	elseif lvl == rt - 1 and type(T) == "table" and type(T.st) == "table" then
		local st = T.st[lvl]
		if type(st) == "table" and st.started and not st.done then tier, why = rt, "research"
		elseif T.k == lvl and type(T.plan_tt) == "number" then
			-- (step 6, the smoke s6_sm_tyr_eo: tyranids at 96 of 100 from ~10:00, the research at 14:49 - with Room_Lead 0 the
			-- room began at 96 and the tier came at 95: no unit of tier 3 in 20:00. An army AT THE CAP loses nothing to the room -
			-- it cannot buy anyway - while the room keeps what it loses from being bought back: so the room by the plan begins
			-- Room_LeadFull (180 s) before the plan's time when the population is within Room_FullGap (8) of the cap then
			-- ("why plan_full"; as step 5 did for every army). Room_LeadFull=0 = Room_Lead for all.)
			-- (step 7, VANILLA_BASE_RU.md 19.4 p.5: s6_tyr_ig - the tyranids stood at 88-90 of 100 at the plan's time, the gap of 8 did
			-- not let plan_full in; the room came with the research at 14:37 and the first unit of tier 3 at 20:43: Room_FullGap 12)
			-- (step 8, VANILLA_BASE_RU.md 21.4 p.4: s7_eo2_a, the orks at 91 of 100 at 9:07 - plan_full came, but at the cap the room is
			-- made only by losses: the first unit of tier 3 216 s after the tier. The room by the plan begins earlier, while the army
			-- still grows: within Room_FullGap 20 (was 12) of the cap and Room_LeadFull 240 s (was 180) before the plan's time -
			-- the last 20 of the population are not filled any more)
			local lead = eai_num("Room_Lead", 0)
			local lfull = eai_num("Room_LeadFull", 240)
			local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
			if E.room_plan_t0 ~= nil then
				if E.room_full then lead = math.max(lead, lfull) end
			elseif lfull > lead and popmax > 0 and pop >= popmax - eai_num("Room_FullGap", 20) and now >= T.plan_tt - lfull then
				lead = lfull
			end
			-- (step 7, the smoke s7_sm_eo: the plan's time moves between ticks - 725 / 770 - and the room by the plan went on / off / on
			-- within 12 s; once begun it holds to Room_PlanMax)
			if now >= T.plan_tt - lead or E.room_plan_t0 ~= nil then
				if E.room_plan_t0 == nil then E.room_plan_t0, E.room_full = now, (lead > eai_num("Room_Lead", 0)) end
				if now - E.room_plan_t0 <= eai_num("Room_PlanMax", lead + 180) then tier, why = rt, E.room_full and "plan_full" or "plan" end
			end
		end
	end
	local on = false
	if tier ~= nil then
		local P = EliteAI_P
		local have = (P.tier_n and P.tier_n[tier]) or 0
		if why == "done" then
			if E.room_ref == nil or E.room_ref_tier ~= tier then E.room_ref, E.room_ref_tier = now, tier end   -- the research is done: the clock of "its units do not come"
			on = have < eai_num("Room_Want", 1) and now - E.room_ref <= eai_num("Room_MaxSecs", 180)
		else
			on = true
		end
	end
	if on ~= (E.room == true) or (on and why ~= E.room_why) then
		E.n_room_sw = (E.n_room_sw or 0) + 1
		eai_log("SPEND", "room", on and "on" or "off", "tier", tostring(tier or E.room_tier or "-"), "why", tostring(why or "-"),
			"pop", (cache.current_population_personnel or 0) .. "/" .. (cache.max_population_personnel or 0), "keeps", eai_num("Room_Pop", 20),
			"have", (tier and EliteAI_P.tier_n and EliteAI_P.tier_n[tier]) or 0, "of", eai_num("Room_Want", 1), "t", math.floor(now),
			"plan", (type(T) == "table" and type(T.plan_tt) == "number") and math.floor(T.plan_tt) or -1,
			"since_ref", (E.room_ref ~= nil) and math.floor(now - E.room_ref) or -1)
	end
	E.room, E.room_tier, E.room_why = on, tier, why
	return on, tier, why
end
-- is this blueprint (of a tier below the one the room is kept for) one that would be bought INTO the room now
-- STEP 6 (SPEND 0.12; VANILLA_BASE_RU.md 18): AFTER the research, until the first unit of the tier (Room_Want) or Room_MaxSecs, a
-- blueprint of a lower tier is no candidate WHATEVER the population - the 7th value is "tier" then. The smoke s6_sm_tyr2
-- (tyranids, slot 1000): T3 done at 14:56 with population 67, the pipeline waited for the carnifex (575/150, 39 s away) and the
-- watchdog bought a zoanthrope (T2, 360) with the bank it had gathered - the first unit of tier 3 came 312 s after the research,
-- after the room had run out. Room_TierOnly=0 = the room by the population only (as 0.11).
function EliteAI_RoomBlock( name )
	local on, tier, why = EliteAI_Room()
	if not on or tier == nil then return false end
	local P = EliteAI_P
	if (P.tier_seen[name] or 1) >= tier then return false end
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	if popmax <= 0 then return false end
	local pc, keep = p_popcost( name ), eai_num("Room_Pop", 20)
	if pop + pc <= popmax - keep then
		if why == "done" and eai_num("Room_TierOnly", 1) >= 1 then return true, pop, popmax, pc, keep, tier, "tier" end
		return false
	end
	return true, pop, popmax, pc, keep, tier
end
-- STEP 7 (SPEND 0.13 / ENERGY 0.17; VANILLA_BASE_RU.md 19.4 p.5): s6_tyr_ig - the tyranids at 88-90 of 100 when the research was
-- done, no losses, the room on - and 885 req went into upgrades in 4 minutes ("float on" lifts their demand) while no carnifex
-- (18 of population) could be asked for: the first unit of tier 3 came at 20:43, 288 s after the tier. While the room is kept
-- (during the research and after it) and the smallest unit of the room's tier does not fit under the cap (its population -
-- learned, else Room_UnitPop - more than the cap less the population), the upgrades take no req (e_addon_filter: "room_pop"):
-- the req waits for the first models to die. The room lasts the research + Room_MaxSecs (180 s) at most. Room_AddonHold=0 = off.
-- Returns true (no unit of the tier fits), the free population, the smallest population of such a unit.
function EliteAI_RoomNoFit()
	if eai_num("Room_AddonHold", 1) < 1 then return false end
	local on, tier, why = EliteAI_Room()
	if not on or tier == nil or cache == nil or (why ~= "research" and why ~= "done") then return false end   -- (the smoke s7_sm_eo: not "by the plan")
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	if popmax <= 0 then return false end
	local P, need = EliteAI_P, nil
	for name, ts in pairs(P.tier_seen) do                                  -- (a minimum: the order of pairs() does not matter)
		if ts == tier and eai_class(name) ~= "hero" then
			local pc = p_popcost( name )
			if need == nil or pc < need then need = pc end
		end
	end
	need = need or eai_num("Room_UnitPop", 15)
	return popmax - pop < need, popmax - pop, need
end
-- once per AccumulateSquadDemand: counts of our squads per class among the buildable blueprints
function EliteAI_PurchasePrep()
	local P = EliteAI_P
	P.cls = { inf = 0, veh = 0, hero = 0 }; P.total = 0; P.supers = 0
	P.tier_n, P.dmax, P.dmax_name = {}, 0, "-"         -- 0.7: our units by the tier they came with; the top of Elite's demand (EliteAI_PurchaseShape)
	P.ans = {}                                         -- 0.8: the blueprints the Counter / Setup / Garrison layers ask for in this tick (EliteAI_PurchaseMult)
	local races = {}                                   -- 0.8: the race folders of the buildable list (EliteAI_GateDrop "foreign")
	local worth = 0                                    -- 12: req worth of the squads we have (alive + ordered) - the army's share below
	local seen = { inf = false, veh = false }          -- which classes this race can build at all (tyranids: "inf" only)
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		local name = string.lower(PBG_GetName(pbg) or "")
		local c = UtilPBG_CountTotal( pbg )
		local k = eai_class(name)
		if k ~= "hero" then seen[k] = true end
		local _, _, rf = string.find(name, "[/\\](race_[%l%d_]+)[/\\]")
		if rf ~= nil then races[rf] = (races[rf] or 0) + 1 end
		-- tech (10.11): the tier of a unit = our tech level when it first became producible (AIProduction_CanProduce, as in
		-- AccumulateSquadDemand below); for the new logic the level stays while a research runs (strategy_tech_purchase.ai)
		if not P.tier_seen[name] and AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) then
			-- verify 10.11: the level fresh, not cache.tech_tier_level (refreshed later: in t7 chimera/leman_russ/carnifex got tier-1 labels)
			P.tier_seen[name] = p_tier_now()                                   -- (step 4: the tier the research under way brings, see p_tier_now)
		end
		P.cls[k] = P.cls[k] + c
		if k ~= "hero" then P.total = P.total + c end
		if k ~= "hero" and c > 0 and P.tier_seen[name] then P.tier_n[P.tier_seen[name]] = (P.tier_n[P.tier_seen[name]] or 0) + c end
		-- 0.7: the highest demand Elite's engine rating gives a blueprint we may buy now (the calls and their order are those of
		-- AccumulateSquadDemand below: AIProduction_CanProduce, then CalcSquadDemand, then the gate)
		if k ~= "hero" and eai_num("Demand_Gamma", 0.4) < 1 and AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) == true then
			local d = CalcSquadDemand( pbg )
			if d > P.dmax and not EliteAI_GateDrop( pbg, name ) then P.dmax, P.dmax_name = d, name end
		end
		if k ~= "hero" and c > 0 then
			local cost = SquadStats_GetCost( s_self_modplayer, pbg )
			worth = worth + c * ((cost and cost.requisition) or 0)
		end
		if EliteAI_IsSuper(pbg, name) then P.supers = P.supers + c end
	end
	P.ncls = (seen.inf and 1 or 0) + (seen.veh and 1 or 0)
	P.army_req = worth
	local rbest, rn = nil, 0                           -- the folder most of the list lies in; a tie: the first by name (no order of pairs())
	for rf, c in pairs(races) do if c > rn or (c == rn and (rbest == nil or rf < rbest)) then rbest, rn = rf, c end end
	P.race = rbest
end
function EliteAI_IsSuper(pbg, name)
	for _, s in ipairs(SUPER_NAMES) do
		if string.find(name, s, 1, true) then return true end
	end
	-- 12 (TECH_RU.md 11.10): direct, the blueprint checked first - was a pcall that swallowed the error without a line, on
	-- every blueprint of the demand every tick. The same call with the same arguments has run bare since step 13 (r_need,
	-- EliteAI_PurchaseMult with a power bank, the watchdog) and is Elite's own (TryPurchaseUnitChoice).
	if pbg == nil then return false end
	local cost = SquadStats_GetCost( s_self_modplayer, pbg )
	if cost and (cost.requisition or 0) + (cost.power or 0) >= eai_num("SuperCost", 1000) then return true end
	return false
end
-- gate (10.11, step 15): the one verdict for a blueprint we forbid - why (a string) or nil = allowed. "cap0" = s_unit_purchase_limit 0
-- (spore mines, IG spotters); "super_time" / "super_army" / "super_have" = a super unit before SuperMinTime, with fewer than
-- SuperMinArmy combat squads, or while one is alive/queued. Called before the demand (AccumulateSquadDemand: demand 0 -> no ETA, no
-- entry in HighestSquadDemand, never the "first" choice TryPurchaseUnitChoice stalls on, nothing reserved), by the watchdog and by
-- EliteAI_PurchaseMult (a super unit outside its window: x0). Log "GATE drop <sbps> <why> t T army N have H" at most once per
-- Gate_LogSecs per blueprint and reason. State between ticks: numbers/strings only (EliteAI_G); no pcall, no randomness.
EliteAI_GATE_VERSION = "0.1"
EliteAI_G = { said = {}, n_drop = 0 }
function EliteAI_GateDrop(pbg, name)
	local P = EliteAI_P
	if not P.cls then EliteAI_PurchasePrep() end
	local why = nil
	local cap = s_unit_purchase_limit and s_unit_purchase_limit[ PBG_GetID( pbg ) ]
	local t, army = World_GetGameTime(), (cache and cache.military_count) or 0
	-- 0.8 (TECH_RU.md 21.6; BACKLOG "GK bought tau_kroot_squad"): a blueprint from another race's folder in OUR buildable list.
	-- The line of fb 621 was a tau AI of an earlier session in the same log file (p1001 "init race t_tau", 21:25), not the grey
	-- knights - so by default this only SAYS it, once per blueprint; Gate_Foreign=1 drops such a blueprint from every purchase path
	local foreign = P.race ~= nil and string.find(name, "race_", 1, true) ~= nil
		and string.find(name, P.race .. "\\", 1, true) == nil and string.find(name, P.race .. "/", 1, true) == nil
	if foreign and eai_num("Gate_Foreign", 0) < 1 then
		if EliteAI_G.said[name .. "|foreign_seen"] == nil then
			EliteAI_G.said[name .. "|foreign_seen"] = t
			eai_log("GATE", "foreign", name, "is not of", P.race, "(not dropped: Gate_Foreign=0)")
		end
		foreign = false
	end
	if cap and cap < 1 then why = "cap0"
	elseif foreign then why = "foreign"
	elseif EliteAI_IsSuper(pbg, name) then
		if t < eai_num("SuperMinTime", 1080) then why = "super_time"
		elseif army < eai_num("SuperMinArmy", 8) then why = "super_army"
		elseif (P.supers or 0) >= 1 then why = "super_have" end
	end
	if why == nil then return nil end
	local G = EliteAI_G
	G.n_drop = G.n_drop + 1
	local k = name .. "|" .. why
	local last = G.said[k]
	if last == nil or t - last >= eai_num("Gate_LogSecs", 30) then
		G.said[k] = t
		eai_log("GATE", "drop", name, why, "t", math.floor(t), "army", army, "have", P.supers or 0)
	end
	return why
end
-- 0.7 (TECH_RU.md 20.2) WHY THE DEMAND NEVER BECAME A PURCHASE. Malum's ork match (fb 590, newai-18): eleven deff dreads in a row
-- while "COUNTER demand ork_tankbustas x2 class vehicle" was written 38 times. Two things:
--  (1) Elite's demand is the engine's combat rating of the blueprint (CalcSquadDemand) and it spans orders of magnitude
--      ("top ork_battlewagon 22541.9"); our multipliers are x1.2 .. x2 and 1 / (1 + 0.35 n) - they never changed the order.
--      EliteAI_PurchaseShape: the rating is kept as an ORDER, its span is compressed - top x (demand / top) ^ Demand_Gamma (0.4):
--      a blueprint rated at a tenth of the top one stands at 0.40 of it, at a hundredth - 0.16. The top one keeps its value
--      (the reinforcement entries are measured against it as before). Demand_Gamma=1 = Elite's numbers.
--  (2) the purchases were the watchdog's: the power floated (454), so only blueprints of 40+ power were candidates (pmin) -
--      the tankbustas (power 30) were not, the battlewagon and the looted tank were out of the req's reach, "cand 1" = the
--      deff dread, every time. Now an ANSWER (the Counter / Setup / Garrison layers ask for it) is a candidate whatever its
--      power, and the watchdog waits for a better blueprint that the income brings within Spend_WaitEta (EliteAI_SpendIdle).
-- And the army of one kind: SameMax (3) squads of a blueprint, SameMaxBig (2) of a vehicle or of anything that costs
-- SameBigCost (450 req + power) or more; each one beyond that x SameOver (0.15). After a tier research (Malum fb 584: "it goes to
-- T2 and builds the T1 units as before"): the blueprints of the new tier x Tech_TierMult (1.5), and until Tech_TierWant (2) of
-- them are ours the older ones x Tech_OldTierMult (0.5) - an answer to the enemy's army keeps its weight. An answer that has
-- been asked for Counter_ForceSecs (90 s) and is still not ours: x Counter_ForceMult (3) on top ("COUNTER force ...").
function EliteAI_PurchaseShape( demand )
	local P = EliteAI_P
	local g, m = eai_num("Demand_Gamma", 0.4), P.dmax or 0
	if g >= 1 or demand == nil or demand <= 0 or m <= 0 or demand >= m then return demand end
	return m * (demand / m) ^ g
end
local function p_say( key, secs, ... )
	local P, now = EliteAI_P, World_GetGameTime()
	P.said = P.said or {}
	if P.said[key] ~= nil and now - P.said[key] < secs then return end
	P.said[key] = now
	eai_log(...)
end
local function p_short( name ) return (string.gsub(name or "", "^.*[/\\]", "")) end
-- STEP 6 (SPEND 0.12): mod/mechanics.ai (ra_demand) asks before a call-in - a global that brings squads for req - becomes a
-- candidate: true = the room is kept and the call-in waits. After the research (the first unit of the tier is waited for)
-- every call-in waits; while the research runs - one that would take the population into the room (Room_CallInPop 12: what
-- a call-in brings is not known before it lands). A raid at our base is the caller's business (it does not ask then).
-- Room_CallIn=0 = off. "room_callin" in ENERGY stats, line "SPEND room callin <ability> ...".
function EliteAI_RoomCallIn( name )
	if eai_num("Room_CallIn", 1) < 1 or cache == nil then return false end
	local on, tier, why = EliteAI_Room()
	if not on then return false end
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	if why ~= "done" and pop + eai_num("Room_CallInPop", 12) <= popmax - eai_num("Room_Pop", 20) then return false end
	local E = EliteAI_E
	E.n_room_callin = (E.n_room_callin or 0) + 1
	p_say("room_callin|" .. tostring(name), 60, "SPEND", "room", "callin", p_short(string.lower(tostring(name))), "waits", "pop", pop .. "/" .. popmax,
		"- the room is kept for the units of tier", tostring(tier), "why", tostring(why), "n", E.n_room_callin)
	return true
end
-- multiplier for the demand of a buildable squad (new logic only); the second value: true = an answer the layers ask for
-- STEP 2 OF THE VANILLA BASE (VANILLA_BASE_RU.md 9; this file only): PEOPLE'S OPENING - the hook for the first purchases taken
-- from 1v1 replays (mod/data/human_plan.ai -> EliteAI_HUMAN_PLAN, read through EliteAI_HumanPlan() of
-- strategy_tech_purchase.ai; no table / no such race / no list = nothing happens). The race's entry may hold
--   opening = { "ork_slugga", "ork_shoota", ... }   the first units in the order people buy them: the short blueprint name (a full
--             sbps path or { name = } / { bp = } / { unit = } / { "<name>" } works too); what is not a unit (tier, upgrade,
--             wargear, generator, node) is dropped at init - the tiers are the tech plan's, the generators the energy plan's;
--   pop = { [5] = 55, [10] = 80 }                   the population by minute (EliteAI_Tempo's target instead of 30 + 5 a minute).
-- The n-th unit of the match is the n-th entry: while it is the step, that blueprint's demand is x Open_Mult (6) and - while
-- the engine offers it (seen as a candidate within Open_SeenSecs 15) - the others' x Open_Other (0.3), answers of the Counter
-- / Setup / Garrison layers excepted. A step ends when a unit is bought (whichever), when its blueprint has not been offered
-- for Open_UnseenSecs (20 s: not buildable yet) or after Open_StepMax (150 s); the whole opening ends with the list, at
-- Open_MaxSteps (8) or Open_MaxSecs (360 s). Numbers and strings only; no engine call but the clock. Open_On=0 = off.
-- Lines "OPEN init ...", "OPEN step N <unit> bought|skip ...", "OPEN done ...".
EliteAI_O = { done = true }
local function o_short( v )
	if type(v) == "table" then v = v.name or v.bp or v.unit or v.sbps or v.squad or v[1] end
	if type(v) ~= "string" then return nil end
	return (string.gsub(string.lower(v), "^.*[/\\]", ""))
end
local O_NOT_UNIT = { "tier_", "tier2", "tier3", "research", "upgrade", "wargear", "generator", "listening_post", "power_node", "turret", "wp_", "arm_", "acc_" }
function EliteAI_OpeningInit()
	EliteAI_O = { done = true }
	local O = EliteAI_O
	if eai_num("Open_On", 1) < 1 or type(EliteAI_HumanPlan) ~= "function" then return end
	local H = EliteAI_HumanPlan()
	if type(H) ~= "table" then return end
	-- the population by minute: sorted numbers
	if type(H.pop) == "table" then
		local pts = {}
		for m, v in pairs(H.pop) do
			if tonumber(m) ~= nil and tonumber(v) ~= nil then table.insert(pts, { tonumber(m), tonumber(v) }) end
		end
		table.sort(pts, function(a, b) return a[1] < b[1] end)
		if table.getn(pts) > 0 then O.pop = pts end
	end
	local src = H.opening or H.first or H.build or H.purchases
	local list, dropped = {}, {}
	if type(src) == "table" then
		for _, v in ipairs(src) do
			local n = o_short( v )
			if n ~= nil and n ~= "" then
				local unit = true
				for _, k in ipairs(O_NOT_UNIT) do if string.find(n, k, 1, true) then unit = false; break end end
				if unit then
					if table.getn(list) < eai_num("Open_MaxSteps", 8) then table.insert(list, n) end
				else table.insert(dropped, n) end
			end
		end
	end
	if table.getn(list) > 0 then
		O.list, O.i, O.buys, O.t, O.seen_t, O.n_skip, O.n_hit, O.done = list, 1, 0, 0, -1000, 0, 0, false
	end
	eai_log("OPEN", "init", tostring(s_current_race), "steps", table.getn(list), table.concat(list, " "), "| not units:", table.getn(dropped), table.concat(dropped, " "),
		"| pop by minute:", O.pop and table.getn(O.pop) or 0, "mult", eai_num("Open_Mult", 6), "other", eai_num("Open_Other", 0.3))
end
-- the population people have at this time (nil = no such table): between the listed minutes by a straight line
function EliteAI_OpeningPop( now )
	local pts = EliteAI_O and EliteAI_O.pop
	if pts == nil or eai_num("Open_Pop", 1) < 1 then return nil end
	local m, n = now / 60, table.getn(pts)
	if m <= pts[1][1] then return pts[1][2] end
	for i = 2, n do
		if m <= pts[i][1] then
			local a, b = pts[i - 1], pts[i]
			return a[2] + (b[2] - a[2]) * (m - a[1]) / math.max(b[1] - a[1], 0.01)
		end
	end
	return pts[n][2]
end
local function o_step( now )
	local O = EliteAI_O
	if O == nil or O.done or O.list == nil then return nil end
	local buys = (type(EliteAI_UnitBuys) == "function") and EliteAI_UnitBuys() or 0
	local n = table.getn(O.list)
	if buys > O.buys then
		eai_log("OPEN", "step", O.i, O.list[O.i] or "-", "bought", "units", buys, "t", math.floor(now), "waited", math.floor(now - O.t))
		O.i, O.buys, O.t, O.seen_t = O.i + (buys - O.buys), buys, now, -1000
	elseif (now - O.t >= eai_num("Open_UnseenSecs", 20) and now - O.seen_t >= eai_num("Open_UnseenSecs", 20)) or now - O.t >= eai_num("Open_StepMax", 150) then
		O.n_skip = O.n_skip + 1
		eai_log("OPEN", "step", O.i, O.list[O.i] or "-", "skip", (now - O.t >= eai_num("Open_StepMax", 150)) and "too long" or "not offered by the engine", "t", math.floor(now))
		O.i, O.t, O.seen_t = O.i + 1, now, -1000
	end
	if O.i > n or now >= eai_num("Open_MaxSecs", 360) then
		O.done = true
		eai_log("OPEN", "done", "t", math.floor(now), "steps", n, "at", O.i, "units", buys, "skipped", O.n_skip, "boosted", O.n_hit)
		return nil
	end
	return O.list[O.i]
end
-- the multiplier of a candidate's demand while the opening runs (1 = nothing); ans = an answer of the Counter / Setup / Garrison layers
function EliteAI_OpeningMult( name, ans )
	local O = EliteAI_O
	if O == nil or O.done then return 1 end
	local now = World_GetGameTime()
	local want = o_step( now )
	if want == nil then return 1 end
	local short = string.gsub(name, "^.*[/\\]", "")
	local wl, sl = string.len(want), string.len(short)
	if short == want or (sl > wl and string.sub(short, sl - wl) == "_" .. want) then
		O.seen_t = now
		O.n_hit = O.n_hit + 1
		return eai_num("Open_Mult", 6)
	end
	if not ans and now - O.seen_t <= eai_num("Open_SeenSecs", 15) then return eai_num("Open_Other", 0.3) end
	return 1
end

-- STEP 7 (SPEND 0.13; VANILLA_BASE_RU.md 19.4 p.4) THE DEAR UNIT'S WAIT IS ONE EPISODE. s6: 5 of 10 waits ended with the unit itself;
-- the others were the SECOND wait for a unit of the tier (the second leman russ: eta 20-86, then kasrkin / a manticore), a wait
-- begun at eta 87 of the 90 s, and the kasrkin bought 7 s after the last "wait_tier ig_leman_russ ... eta 20 ... left 30" - the
-- mark of the block lived Spend_DearBlockSecs (7 s) past the watchdog's last line, and the watchdog stops writing as soon as
-- the bank or the eta moves. Now a wait is an EPISODE (EliteAI_S.dear_ep): it begins only when the dear unit's req is
-- Spend_DearEta (60 s) of income away and only for the first Spend_DearEps (1) episode of the tier; for its whole length
-- (Spend_DearMax, 90 s, from its first line) no other blueprint is a candidate and the upgrades keep its req; the watchdog buys
-- nothing else meanwhile ("-> none wait_tier <unit> ... dear ... episode"). It ends when the unit is asked for (by anyone:
-- EliteAI_UnitNoteRequest) - "SPEND dear end <unit> asked" - or by the clock - "SPEND dear end <unit> by the clock".
-- Spend_DearHold=0 = the block of 0.12 (Spend_DearBlockSecs past the last line, no episode, every wait of the tier).
local function dear_ep_live( now )
	local S = EliteAI_S
	local ep = S and S.dear_ep
	if ep == nil then return nil end
	if now - ep.t0 <= (ep.max or eai_num("Spend_DearMax", 90)) then return ep end   -- (step 8: a rich episode has its own length)
	eai_log("SPEND", "dear", "end", p_short(ep.name), "by the clock after", math.floor(now - ep.t0), "s", "tier", ep.tier, "lines", ep.n or 0)
	S.dear_ep = nil
	S.n_dear_clock = (S.n_dear_clock or 0) + 1
	return nil
end
-- the blueprint the dear unit's block keeps the candidacy for, and the req it keeps from the upgrades; nil = no block
function EliteAI_DearBlockName()
	local S = EliteAI_S
	if S == nil or eai_num("Spend_DearBlock", 1) < 1 then return nil, 0 end
	local now = World_GetGameTime()
	if eai_num("Spend_DearHold", 1) >= 1 then
		local ep = dear_ep_live( now )
		if ep ~= nil then return ep.name, ep.req or 0 end
		return nil, 0
	end
	if S.dear_name ~= nil and now - (S.dear_t or -1000) <= eai_num("Spend_DearBlockSecs", 7) then return S.dear_name, S.dear_req or 0 end
	return nil, 0
end
function EliteAI_PurchaseMult(pbg, curAmount)
	local P = EliteAI_P
	if not P.cls then EliteAI_PurchasePrep() end
	local name = string.lower(PBG_GetName(pbg) or "")
	if not P.cost_logged[name] then
		P.cost_logged[name] = true
		local cost = SquadStats_GetCost( s_self_modplayer, pbg )             -- 12: direct (was a silent pcall); pbg comes from the buildable list of this tick
		if cost then eai_log("cost", name, math.floor(cost.requisition or -1), math.floor(cost.power or -1), EliteAI_IsSuper(pbg, name) and "super" or "") end
		P.costs = P.costs or {}
		if cost then P.costs[name] = (cost.requisition or 0) + (cost.power or 0) end   -- 0.7: a number, for SameMaxBig
		P.creq = P.creq or {}
		if cost then P.creq[name] = cost.requisition or 0 end                  -- step 8: the req, for the generator ahead of the unit
	end
	-- STEP 8 (ENERGY 0.18): the generator ahead of the unit (e_gen_limits, E.gen_ahead) - a unit that would leave the bank below the
	-- generator's price is no candidate meanwhile
	local EA = EliteAI_E
	if EA ~= nil and EA.gen_ahead == true and EA.gen_ahead_at ~= nil and World_GetGameTime() - EA.gen_ahead_at <= 6 and eai_class(name) ~= "hero"
		and P.creq ~= nil and P.creq[name] ~= nil and cache ~= nil and cache.resources ~= nil then
		local gp = (EA.gen_req ~= nil and EA.gen_req > 0) and EA.gen_req or 100
		if (cache.resources.requisition or 0) - P.creq[name] < gp then
			EA.n_gen_ahead_block = (EA.n_gen_ahead_block or 0) + 1
			return 0, false
		end
	end
	-- tech (10.11): the tier a unit belongs to = our level when it first became producible (cache.tech_tier_level stays
	-- during a research for the new logic, see strategy_tech_purchase.ai); units of the tier we just reached get a bonus
	local lvl = (cache and cache.tech_tier_level) or 1
	if not P.tier_seen[name] then P.tier_seen[name] = p_tier_now() end      -- (step 4: was lvl - the level before the research that brings the unit)
	-- 0.9 (TECH_RU.md 21.13): a blueprint whose last request the engine did not start ("buy_dead") or cannot start now
	-- ("SPEND notnow") is no candidate until its mute is over - in Elite's demand, the plan's next unit and the watchdog alike
	if EliteAI_UnitMuted and EliteAI_UnitMuted( name ) then return 0, false end
	-- STEP 6 (SPEND 0.12; VANILLA_BASE_RU.md 17.5 / 18): while the watchdog waits for the dear unit of the tier (EliteAI_SpendIdle,
	-- "-> none wait_tier ... dear"), no other blueprint is a candidate for a new squad - s5: 13 of 14 such waits ended 7-36 s
	-- later with a cheaper unit of the same tier bought by Elite's pipeline (looted tank, leman russ), whose demand the wait
	-- did not touch. The watchdog's own scan (S.scan) sees every blueprint: it decides whether the wait goes on. The mark
	-- lives Spend_DearBlockSecs (7 s = two purchase ticks) past the watchdog's last "wait". Spend_DearBlock=0 = as 0.11.
	-- (step 7: the block lasts the whole episode of the wait - EliteAI_DearBlockName)
	local S6 = EliteAI_S
	local bname = (S6 ~= nil and S6.scan ~= true) and EliteAI_DearBlockName() or nil
	if bname ~= nil and name ~= bname and eai_class(name) ~= "hero" then
		S6.n_dear_block = (S6.n_dear_block or 0) + 1
		return 0, false
	end
	if EliteAI_IsSuper(pbg, name) then
		if EliteAI_GateDrop(pbg, name) then return 0, false end              -- gate: outside its window ("GATE drop", was "super_block")
		return eai_num("SuperMult", 0.6), false
	end
	local k = eai_class(name)
	if k == "hero" then return 1, false end
	-- STEP 3 (ENERGY 0.13): the swap at the population cap - a T1 blueprint is no candidate for a new squad (EliteAI_PopSwap)
	if EliteAI_PopSwap ~= nil and EliteAI_PopSwap() and EliteAI_SwapWeak( name ) then return 0, false end
	-- STEP 5 (SPEND 0.11): the room for the units of the tier - a blueprint of a lower tier is not bought into it (EliteAI_Room)
	if EliteAI_RoomBlock ~= nil then
		local rb, rpop, rmax, rpc, rkeep, rtier, rwhy = EliteAI_RoomBlock( name )
		if rb and rwhy == "tier" then                                      -- (step 6: after the research the unit of the tier is first)
			P.n_room_tier = (P.n_room_tier or 0) + 1
			p_say("room_tier|" .. name, 60, "SPEND", "room", p_short(name), "tier", P.tier_seen[name] or 1, "pop", rpop .. "/" .. rmax, "takes", rpc,
				"- after the research the first unit is one of tier", rtier, "n", P.n_room_tier)
			return 0, false
		elseif rb then
			P.n_room = (P.n_room or 0) + 1
			p_say("room|" .. name, 60, "SPEND", "room", p_short(name), "tier", P.tier_seen[name] or 1, "pop", rpop .. "/" .. rmax, "takes", rpc,
				"- the last", rkeep, "are kept for the units of tier", rtier, "n", P.n_room)
			return 0, false
		end
	end
	local mult = 1 / (1 + eai_num("DivK", 0.35) * curAmount)
	-- 0.7: the answers first - they decide what the rules below may damp
	local gm = EliteAI_GarMult and EliteAI_GarMult( name, curAmount ) or 1
	local sm = EliteAI_SetupMult and EliteAI_SetupMult( name, curAmount ) or 1
	local cm = EliteAI_CounterMult and EliteAI_CounterMult( name, curAmount ) or 1
	local now0 = World_GetGameTime()
	if cm >= eai_num("Counter_ForceFrom", 2) and curAmount == 0 and eai_num("Counter_Force", 1) >= 1 then
		P.cn_since, P.cn_last = P.cn_since or {}, P.cn_last or {}
		if P.cn_since[name] == nil or now0 - (P.cn_last[name] or -1000) > eai_num("Counter_ForceGap", 30) then P.cn_since[name] = now0 end
		P.cn_last[name] = now0
		if now0 - P.cn_since[name] >= eai_num("Counter_ForceSecs", 90) then
			cm = cm * eai_num("Counter_ForceMult", 3)
			p_say("force|" .. name, 30, "COUNTER", "force", p_short(name), "x" .. cm, "asked for", math.floor(now0 - P.cn_since[name]), "s and not ours")
		end
	end
	local ans = (gm > 1 or sm > 1 or cm > 1)
	if P.ans ~= nil then P.ans[name] = ans end                               -- 0.8: the generators' turn reads it (e_gen_first)
	-- 0.7: SameMax - an army of one kind is no army
	if eai_num("SameMax", 3) > 0 then
		local big = (k == "veh") or ((P.costs and P.costs[name] or 0) >= eai_num("SameBigCost", 450))
		local cap = big and eai_num("SameMaxBig", 2) or eai_num("SameMax", 3)
		if curAmount >= cap then
			-- 0.8 (TECH_RU.md 21.6; 20.10: s25a / s25b, IG - the third and the fourth manticore were bought AFTER "SPEND same ig_manticore
			-- have 2 cap 2 big x0.150": the engine's rating of a manticore stands so far above the rest that x0.15 left it on top,
			-- and the watchdog's score is this multiplier too). The ceiling is a ceiling in every purchase path - the demand of
			-- Elite's pipeline, the plan's next unit, the watchdog all take the 0 from here: a vehicle or a squad of SameBigCost at
			-- its cap, any other squad SameHardOver (1) above it (the one squad in between stays damped x SameOver). SameHard=0 = 0.7.
			if eai_num("SameHard", 1) >= 1 and (big or curAmount >= cap + eai_num("SameHardOver", 1)) then
				P.n_same = (P.n_same or 0) + 1
				p_say("same|" .. name, 60, "SPEND", "same", p_short(name), "have", curAmount, "cap", cap, big and "big" or "-", "x0 hard")
				return 0, ans
			end
			mult = mult * eai_num("SameOver", 0.15) ^ (curAmount - cap + 1)
			P.n_same = (P.n_same or 0) + 1
			p_say("same|" .. name, 60, "SPEND", "same", p_short(name), "have", curAmount, "cap", cap, big and "big" or "-", string.format("x%.3f", eai_num("SameOver", 0.15) ^ (curAmount - cap + 1)))
		end
	end
	local total = P.total
	if total >= 4 then
		local share, smax = curAmount / total, eai_num("DivShare", 0.25)
		if share > smax then mult = mult * (smax / share) ^ 2 end
		local cshare, cmax = P.cls[k] / total, eai_num("CatShare", 0.6)
		-- spend (10.11): only when the race builds both classes; with one class the share is always 1 -> x0.36 on everything
		if (P.ncls or 2) >= 2 and cshare > cmax then mult = mult * (cmax / cshare) ^ 2 end
	end
	if curAmount == 0 and total >= 3 then mult = mult * eai_num("DivNew", 1.4) end
	if curAmount == 0 and lvl >= 2 and P.tier_seen[name] == lvl then mult = mult * eai_num("Tech_NewTierMult", 1.3) end   -- we teched for these
	-- 0.7: the tier we stand on (Malum fb 584) - its blueprints first, the older ones step back until Tech_TierWant of the new are ours
	if lvl >= 2 and eai_num("Tech_TierShift", 1) >= 1 then
		local ts, tn = P.tier_seen[name] or lvl, (P.tier_n and P.tier_n[lvl]) or 0
		if ts >= lvl then mult = mult * eai_num("Tech_TierMult", 1.5)
		elseif tn < eai_num("Tech_TierWant", 2) and cm <= 1 then
			mult = mult * eai_num("Tech_OldTierMult", 0.5)
			P.n_old = (P.n_old or 0) + 1
		end
	end
	-- 10.11 verify s9: power piles up (bank power >= Spend_BankPow) -> units that use little power (< Spend_PowUnit 40:
	-- guardsmen, hws, termagaunts) are damped x Spend_LowPowMult so the req goes to power units (chimera, leman russ,
	-- lictor, zoanthrope...); in s9 Elite and the watchdog kept buying 240-300 T1 squads while the power sat at 1000-1400
	local bank = cache and cache.resources
	local cost = nil
	if bank and (bank.power or 0) >= eai_num("Spend_BankPow", 300) then
		cost = SquadStats_GetCost( s_self_modplayer, pbg )
		-- energy (11.11): not when no power unit is within reach at this income (EliteAI_R.unreach, r_need) - then the cheap
		-- units are all there is and nothing is held back for a unit that will not come
		if cost and (cost.power or 0) < eai_num("Spend_PowUnit", 40) and not (EliteAI_R and EliteAI_R.unreach) and not ans then   -- (0.7: not an answer)
			mult = mult * eai_num("Spend_LowPowMult", 0.25)
			-- reinf (10.11): while saving req for a power unit / the next tier, the cheap spawns step back further
			if EliteAI_R and EliteAI_R.save then mult = mult * eai_num("Reinf_SaveSpawnMult", 0.4) end
		end
	end
	-- energy (11.11): power in excess, req short (EliteAI_E.float) - the req goes to the units whose cost is power-heavy
	if EliteAI_E and EliteAI_E.float then
		cost = cost or SquadStats_GetCost( s_self_modplayer, pbg )
		local cr, cp = (cost and cost.requisition) or 0, (cost and cost.power) or 0
		-- step 2 (ENERGY 0.12; s1_tyr_ig: 1081 power at the end): the deeper the float, the more the power share counts - the
		-- power bank over Energy_DeepFrom (1.5) x Energy_FloatPow, up to x Energy_DeepMax (3): at 900 power a carnifex
		-- (575/150) gets x1.8 instead of x1.4, a squad without power x1. Energy_Deep=0 = as 0.11.
		local depth = 1
		if eai_num("Energy_Deep", 1) >= 1 and bank then
			local fp = eai_num("Energy_FloatPow", eai_num("Spend_BankPow", 300)) * eai_num("Energy_DeepFrom", 1.5)
			if fp > 0 then depth = math.max(1, math.min((bank.power or 0) / fp, eai_num("Energy_DeepMax", 3))) end
		end
		if cr + cp > 0 then mult = mult * (1 + eai_num("Energy_ShareK", 2) * depth * cp / (cr + cp)) end
	end
	-- garrison (11.11): the counter units while an enemy squad holds a building next to our point (EliteAI_GarMult below)
	-- set-up teams (11.11, step 22): the counter units while the enemy fields two or more of them (EliteAI_SetupMult below)
	-- the enemy's army as we have seen it (11.11, step 24): the answers to its classes (EliteAI_CounterMult below; mod/mechanics.ai Counter)
	-- (0.7: worked out above - gm, sm, cm)
	mult = mult * gm * sm * cm
	-- step 2: people's opening (the first units in the order of mod/data/human_plan.ai; 1 without the table)
	mult = mult * EliteAI_OpeningMult( name, ans )
	return mult, ans
end


--
-- This file is responsible for prioritizing and purchasing all units.
--


import("util/demand.ai")
import("rules_unit_purchase.ai")

-------------------------------------------------------------------------------------------------
-- EliteAI 10.11 (spend): the idle-bank watchdog of the new logic (EliteAI.on only; Elite's AIs never get here).
-- WHY: Elite's unit purchase (do_purchase below) has several exits that buy nothing and write nothing: the popcap return
-- (AccumulateSquadDemand), "reinforce only" of the difficulty cap (state_analysis.enable_military_unit_building), the
-- engine demand PlayerStats_EvaluateSquadPurchaseCombatRatingDiff <= 0 for every blueprint ("demand > 0" gate), a
-- reinforcement/resurrection entry (demand x50 / x10) chosen instead of a spawn whose request then waits in the HQ channel
-- (every spawn stalls on PBG_GetNumRequestsForProducer, the request is killed as inactive 3 s later and placed again),
-- or no money in the budget's share. In t7 (newai-7, 2v2) the tyranids bought nothing for the last 8 minutes with a bank
-- of 1458/1197 and the log could not say which exit it was.
-- WHAT: when the bank stays above Spend_BankReq req or Spend_BankPow power for Spend_IdleSecs without a spawn, the units
-- budget buys on its own, before Elite's pipeline: every producible blueprint (s_unit_purchase_limit, the super-unit
-- rules and the diversity multiplier of EliteAI_PurchaseMult still apply, the engine demand does not), ranked by the
-- diversity score (fewest of this blueprint first; a blueprint the engine can start right now before one it cannot),
-- paid from the budget's availableResources (a tech reserve locked by strategy_tech_purchase.ai stays respected).
-- A request waiting in the HQ channel that is inactive (a reinforcement no squad goes home for; a spawn Elite would kill
-- next tick anyway, default.ai:201-217) is dropped first (Spend_KillInactive=1). One request per Spend_RetrySecs so a
-- request the engine cannot start does not spam. Squad upgrades: while the watchdog is "hot", CalcSquadUpgradeDemand is
-- floored at Spend_AddonFloor so strategy_addon_purchase.ai buys them too (power is not left either).
-- LOG (EliteAI.log, "AI: p<id> SPEND ..."): "SPEND idle bank R/P for T s -> buy <name> <cost> ..." / "-> none <why> ..."
-- (why: popcap, no_unit, locked = nothing affordable in the budget's share, blocked = only super units, channel N = an
-- active task holds the HQ, cooldown), at most once per Spend_LogSecs per reason; every line ends with a diagnostic
-- tail "| avail R/P reinf N need N resur N hq_tasks active/all pop c/m build on|off addon_floor N" plus
-- "engine_pos K/P top <name> <demand>" (how many producible blueprints Elite's own demand rates > 0) - this names the
-- silent exit of the next match; "SPEND idle end bank R/P after T s bought N" when the bank is below the threshold again.
-- SAFETY: numbers/strings between ticks only (EliteAI_S), PBGs are read and used within the tick, no pcall around engine
-- calls, every engine function is one Elite's own scripts call (file:line in reports/newai_1110/TECH_RU.md).
EliteAI_SPEND_VERSION = "0.14"
EliteAI_S = { last_buy = 0, above_t = -1, hot = false, said = {}, n_buy = 0, n_none = 0, addon_floor = 0, bought_hot = 0, cool = -1 }
local function s_on() return EliteAI ~= nil and EliteAI.on == true end
-- VANILLA BASE (11.11): WHEN a node / a generator may be asked for. Vanilla's own rules wait for 30-35 % of the population cap,
-- 35 % of the map and 300-400 req in the bank (strategy_defence_purchase.ai SecureStructureDemand, strategy_resourcing.ai
-- ResourceStructureDemand): the first generator at pop 35+, IG with 0-1 generators in a whole match (VANILLA_BASE_RU.md 5).
-- HOW MANY is the plan's business under the new logic (the cap and the need, ENERGY below), and the plan and the tech times
-- were measured where these thresholds were 12 % / 10 % / 100-150 req. So under the new logic the thresholds are OURS:
-- Energy_GenGateBank / Map / Pop (150 / 0.10 / 0.12), Energy_SecGateBank / Pop (100 / 0.12). Energy_Gates=0 = vanilla's.
-- nil for the plain vanilla (the two files call it and keep their own numbers on nil).
-- STEP 2 (VANILLA_BASE_RU.md 9): the same for the SQUAD UPGRADES (kind "addon"; strategy_addon_purchase.ai UpdateSquadDemand).
-- Vanilla asks for none below 50 % of the population cap, 25 % of the map and (req income 100 or 250 req in the bank); Elite,
-- where the upgrades' share, "unit first" and the float were measured, has 20 % / 15 % / 75 req. s1_ork_ig: the orks' first
-- upgrade at 9:30 (the population fell back under 50 at 5:00-7:00), four upgrades by 12:00 against 7-9 of the released AI
-- with MORE units bought (8-9 against 6-8) - the army's value at 12:00 was 20-25 % lower. How much goes into upgrades is the
-- business of the layer above (Share_Addon*, Conf_AddonVsUnit, the tempo): Energy_AddonGateBank / Map / Pop = 75 / 0.15 /
-- 0.20. Energy_AddonGates=0 = vanilla's numbers for the upgrades alone.
function EliteAI_EnergyGates( kind )
	if not s_on() or eai_num("Energy_Gates", 1) < 1 then return nil end
	if kind == "addon" then
		if eai_num("Energy_AddonGates", 1) < 1 then return nil end
		return eai_num("Energy_AddonGateBank", 75), eai_num("Energy_AddonGateMap", 0.15), eai_num("Energy_AddonGatePop", 0.20)
	end
	if kind == "gen" then
		if eai_num("Energy_GenPlan", 1) < 1 then return nil end
		return eai_num("Energy_GenGateBank", 150), eai_num("Energy_GenGateMap", 0.10), eai_num("Energy_GenGatePop", 0.12)
	end
	return eai_num("Energy_SecGateBank", 100), nil, eai_num("Energy_SecGatePop", 0.12)
end
local function s_rp(r) return math.floor((r and r.requisition) or 0) .. "/" .. math.floor((r and r.power) or 0) end

-- the clock: above the threshold since when, "hot" after Spend_IdleSecs without a spawn; back to cold below the threshold
local function s_state( now, bank )
	local S = EliteAI_S
	local above = (bank.requisition or 0) >= eai_num("Spend_BankReq", 400) or (bank.power or 0) >= eai_num("Spend_BankPow", 300)
	if not above then
		if S.hot then
			eai_log("SPEND", "idle", "end", "bank", s_rp(bank), "after", math.floor(now - S.above_t), "s", "bought", S.bought_hot, "floored", S.addon_floor)
		end
		S.above_t, S.hot, S.bought_hot, S.addon_floor = -1, false, 0, 0
		return false
	end
	if S.above_t < 0 then S.above_t = now end
	-- 0.3 (TECH_RU.md 11): Spend_IdleSecs without a spawn and the bank above the threshold for Spend_AboveSecs. Was: above for
	-- the whole Spend_IdleSecs - one dip below it restarted the clock (s14, IG: the T2 research took the bank from 663 to 369 req,
	-- back at 455-663 the watchdog stayed cold for the next 63 s)
	if not S.hot and now - S.last_buy >= eai_num("Spend_IdleSecs", 45) and now - S.above_t >= eai_num("Spend_AboveSecs", 12) then
		S.hot, S.bought_hot, S.addon_floor = true, 0, 0
	end
	return S.hot
end

-- the diagnostic tail: the state of every silent exit of Elite's pipeline, this tick
local function s_diag( avail )
	local c = cache or {}
	local need = 0
	if AIProduction_AnyReinforcementsNeeded( s_selfplayer ) then need = AIProduction_GetReinforcementSquadCount( s_selfplayer ) end
	return string.format("| avail %s reinf %d need %d resur %d hq_tasks %d/%d pop %d/%d build %s addon_floor %d",
		s_rp(avail), Task_CountProduction( s_selfplayer, PITEM_SquadReinforce ), need, Task_Count( s_selfplayer, TGROUP_Resurrect ),
		Task_CountActiveInGroup( s_selfplayer, TGROUP_BuildUnits ), Task_CountInGroup( s_selfplayer, TGROUP_BuildUnits ),
		c.current_population_personnel or -1, c.max_population_personnel or -1,
		(state_analysis and state_analysis.enable_military_unit_building == false) and ((eai_num("Spend_NoGlue", 1) >= 1) and "off(ignored)" or "off") or "on", EliteAI_S.addon_floor)
end

-- called first in strategy_unit_purchase.do_purchase (every purchase tick, 3 s, and again when the budget loop re-runs);
-- returns true, cost when it placed a spawn request, nil otherwise (Elite's pipeline then runs as usual)
function EliteAI_SpendIdle( availableResources, purchase_count )
	if not s_on() or cache == nil or cache.resources == nil or availableResources == nil then return nil end
	local S = EliteAI_S
	local now = World_GetGameTime()
	local bank = cache.resources
	-- s9: the power bank decides (was: req bank < Spend_BankReq) - with req >= 400 and power 1000+ the watchdog bought guardsmen
	local pmin = ((bank.power or 0) >= eai_num("Spend_BankPow", 300)) and eai_num("Spend_PowUnit", 40) or 0
	if EliteAI_R and EliteAI_R.unreach then pmin = 0 end                    -- energy (11.11): no power unit within reach at this income - buy what there is
	if purchase_count == 0 then
		if not s_state( now, bank ) then return nil end
	elseif not S.hot then
		return nil
	end
	local for_s = math.floor(now - S.last_buy)                                 -- 0.3: seconds without a spawn (was: seconds above the threshold)
	local function none( why, ... )
		S.n_none = S.n_none + 1
		local last = S.said[why]
		if last and now - last < eai_num("Spend_LogSecs", 30) then return nil end
		S.said[why] = now
		local args, extra = { ... }, {}                                    -- Lua 5.1: "..." not in the last position is cut to one value
		for i = 1, table.getn(args) do extra[i] = tostring(args[i]) end
		eai_log("SPEND", "idle", "bank", s_rp(bank), "for", for_s, "s", "->", "none", why, table.concat(extra, " "), s_diag( availableResources ))
		return nil
	end
	if S.cool >= 0 and now - S.cool < eai_num("Spend_RetrySecs", 12) then return none("cooldown", S.cool_name or "-") end
	-- popcap: nothing can spawn (AccumulateSquadDemand returns the same way); the addon floor still works
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	-- 11.11 (20.10, s25b): at 97-100 of 100 every request was refused by the engine (no room for a squad) while the watchdog
	-- logged a "buy" every 3-4 s - near the cap there is no room for any squad of the line: PopMargin
	if pop >= popmax or popmax - pop < eai_num("PopMargin", 8) then return none("popcap", pop .. "/" .. popmax) end
	EliteAI_PurchasePrep()
	local lvl = cache.tech_tier_level or 1
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	local prod, afford, pos, bank_afford = 0, 0, 0, 0
	local best, best_score, best_name, best_cost, best_now = nil, -1, "-", nil, false
	local top_name, top_dem = "-", nil
	local cands = {}                                                           -- this tick only: { pbg, name, cost, score, now_ok }
	-- 0.9 (TECH_RU.md 21.13): s27b - "now false" in 6 "-> buy" lines of 15, none of the six was started by the engine (all runs:
	-- 56 of 57). What the engine cannot start now is no request (Unit_NowOnly=0 = as before: after the ones it can)
	local now_only = eai_num("Unit_NowOnly", 1) >= 1
	local notnow, nn_name, nn_score = 0, "-", -1
	local wait_best = nil                                                      -- 0.7: { name, score, eta } - numbers and a string
	-- STEP 4 (SPEND 0.10; VANILLA_BASE_RU.md 14.2) THE UNIT OF THE TIER WE STAND ON IS WAITED FOR. s3h: after T3 (12:19-13:49) the IG
	-- of this side bought 27 manticores, 5 chimeras, 3 stormtroopers, 2 psykers and 2 devils in 7 matches - not one leman russ;
	-- the orks 9 deff dreads and 2 looted tanks, no nob squad, no battlewagon. s3h_b4, IG: "SPEND stall ig_leman_russ 575/135 why
	-- money ... eta 88" at 949 s, and 12 s later "SPEND idle bank 328/323 for 102 s -> ask ig_manticore 300/75": the watchdog
	-- waits for a better blueprint only when the income brings it within Spend_WaitEta (75 s) and, behind the tempo, for
	-- Tempo_WaitMax (30 s) - a unit of 450-700 req is never that near while one of 270-300 is paid. The 300 req and 150
	-- power of the T3 research bought nothing, and the power kept piling up (the units that take 100-180 of it each were
	-- never reached). Now, while fewer than Tech_TierWant (2) units of our tier are ours, from tier Spend_TierWaitTier (3) on and
	-- with an army of Spend_TierWaitArmy (5) squads: a blueprint of our tier whose power the bank holds already is waited for
	-- when the income brings its req within Spend_TierWaitEta (150 s), for Spend_TierWaitMax (150 s) at most, behind the tempo
	-- or not - "-> none wait_tier ...". Spend_TierWait=0 = as 0.9.
	local P = EliteAI_P
	local tw_on = eai_num("Spend_TierWait", 1) >= 1 and lvl >= eai_num("Spend_TierWaitTier", 3)
		and ((P.tier_n and P.tier_n[lvl]) or 0) < eai_num("Tech_TierWant", 2) and ((cache.military_count or 0) >= eai_num("Spend_TierWaitArmy", 5))
	-- STEP 5 (SPEND 0.11; VANILLA_BASE_RU.md 16.1) THE DEAR UNIT OF THE TIER. s4, four mirrors: every player of this side bought a
	-- unit of tier 3 (3 leman russes, 3 kasrkin, 3 kommandos, 3 looted tanks) - and no nob squad (450 / 100), no battlewagon
	-- (700 / 180), with 500-760 power in the bank at the end. The battlewagon was waited for twice ("-> none wait_tier
	-- ork_battlewagon score 4.40 eta 106 over ork_deff_dread 1.11"); both times the wait ended 6 s later with "-> ask
	-- ork_looted_tank 400/100 score 4.39": the rule waits only for a blueprint whose score is Spend_WaitK (1.6) times the
	-- score of what the bank can pay, and two units of one tier score alike - the dearer one never wins by 1.6. With the
	-- power lying idle and the population near its cap the dear unit is the right one: it takes the most power for a place
	-- in the army. While the power bank is at least Spend_DearPow (300), from tier Spend_TierWaitTier (3) on, with an army
	-- of Spend_TierWaitArmy (5) squads -
	--  * WAIT: a blueprint of our tier that takes MORE POWER than the best one the bank can pay, whose power lies in the
	--    bank, that has room (the population it takes - learned, else Spend_DearRoom 18 - fits under the cap) and whose req
	--    the income brings within what is left of the wait (Spend_TierWaitMax 150 s in a row at most) is waited for:
	--    "-> none wait_tier <unit> ... dear pow A over B". A wait that cannot end in time is not begun - the bank buys now;
	--    nor is a blueprint waited for that the bank paid and the engine could not start within the last Spend_DearNotNow
	--    (240 s: it did not fit - the population it takes is not known until one is bought);
	--  * PICK: of the blueprints of our tier the bank can pay now, the one that takes the most power is bought when its
	--    score is at least Spend_DearK (0.5) of the best score ("-> ask ... dear").
	-- Spend_Dear=0 = as 0.10. "wait_dear" / "dear_pick" in ENERGY stats.
	local dear_on = eai_num("Spend_Dear", 1) >= 1 and lvl >= eai_num("Spend_TierWaitTier", 3) and (bank.power or 0) >= eai_num("Spend_DearPow", 300)
		and ((cache.military_count or 0) >= eai_num("Spend_TierWaitArmy", 5))
	local dear_wait, dear_pick = nil, nil                                      -- this tick only: { name, score, eta, pow } / { pbg, name, cost, score }
	local dhold = eai_num("Spend_DearHold", 1) >= 1                            -- step 7: the wait is an episode (dear_ep_live)
	local ep = dhold and dear_ep_live( now ) or nil
	local ep_pick = nil
	local function better( now_ok, score ) return (now_ok and not best_now) or (now_ok == best_now and score > best_score) end
	S.scan = true                                                              -- (step 6: this scan sees every blueprint - the dear unit's block is for the others' callers)
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		if AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) then
			prod = prod + 1
			local name = string.lower(PBG_GetName(pbg) or "")
			local dem = CalcSquadDemand( pbg )                                 -- Elite's (engine) demand: diagnostics only
			if dem > 0 then pos = pos + 1 end
			local cap = s_unit_purchase_limit and s_unit_purchase_limit[ PBG_GetID( pbg ) ]
			-- heroes: Elite's resurrection path; the gate: limit 0 and super units outside their window ("GATE drop")
			if eai_class(name) ~= "hero" and not EliteAI_GateDrop( pbg, name ) then
				-- 0.3: "top" names the best blueprint that may be bought (was: any - a gated swarmlord read as "saving for it")
				if top_dem == nil or dem > top_dem then top_dem, top_name = dem, name end
				local cur = UtilPBG_CountTotal( pbg )
				local mult, ans = EliteAI_PurchaseMult( pbg, cur )
				if cap and cur >= cap then mult = mult / ((cur - cap) + 6) end   -- Elite's damping over the limit (AccumulateSquadDemand)
				local cost = (mult > 0) and SquadStats_GetCost( s_self_modplayer, pbg ) or nil
				-- 10.11 verify s8: hot on power alone (req bank below Spend_BankReq) -> only units that use power
				-- (Spend_PowUnit 40: T2/T3 and vehicles); in s8 the power-only trigger spent the req on 240-300 T1 squads
				-- (guardsmen/termagaunts), the req never reached 350-575 for T2/T3 units or the IG T3 research
				if cost and (cost.power or 0) < pmin and not ans then mult = 0 end   -- (0.7: an answer is a candidate whatever its power)
				if mult > 0 then
					local score = mult * 2 / (2 + cur)
					local now_ok = AIProduction_CanProduceNow( s_selfplayer, PITEM_Spawn, pbg ) and true or false
					-- 0.7: the best blueprint the bank cannot pay yet - how far away is it (util/demand.ai GetETAFromCost, as the
					-- reinforcement entries below)
					if not ResourceAmount_Has( availableResources, cost ) and (wait_best == nil or score > wait_best.score) then
						local eta = GetETAFromCost( cost, availableResources )
						-- (step 4: a unit of our tier, its power in the bank - only its req is waited for)
						local top = tw_on and (P.tier_seen[name] or 0) >= lvl and (cost.power or 0) <= (bank.power or 0)
						if eta ~= nil and eta <= (top and eai_num("Spend_TierWaitEta", 150) or eai_num("Spend_WaitEta", 75)) then
							wait_best = { name = name, score = score, eta = eta, top = top }
						end
					end
					-- (step 7: the unit of the dear episode, paid by what the budget gives now)
					if ep ~= nil and name == ep.name and now_ok and ResourceAmount_Has( availableResources, cost ) then
						ep_pick = { pbg = pbg, name = name, cost = cost, score = score, pow = cost.power or 0 }
					end
					-- (step 5: the dear unit of our tier - its power in the bank, room for it under the cap)
					if dear_on and (P.tier_seen[name] or 0) >= lvl then
						local cpw = cost.power or 0
						if not ResourceAmount_Has( availableResources, cost ) then
							-- (what the BANK cannot pay yet: a share locked by another budget is the over-lock's business below)
							local eta = (not ResourceAmount_Has( bank, cost )) and GetETAFromCost( cost, availableResources ) or nil
							if eta ~= nil and eta <= eai_num("Spend_TierWaitEta", 150) and cpw <= (bank.power or 0)
								and popmax - pop >= p_popcost( name, eai_num("Spend_DearRoom", 18) )
								and now - ((P.nn_t and P.nn_t[name]) or -1000) >= eai_num("Spend_DearNotNow", 240)
								and (dear_wait == nil or cpw > dear_wait.pow or (cpw == dear_wait.pow and score > dear_wait.score)) then
								dear_wait = { name = name, score = score, eta = eta, pow = cpw, req = cost.requisition or 0 }
							end
						elseif now_ok and (dear_pick == nil or cpw > dear_pick.pow or (cpw == dear_pick.pow and score > dear_pick.score)) then
							dear_pick = { pbg = pbg, name = name, cost = cost, score = score, pow = cpw }
						end
					end
					if ResourceAmount_Has( bank, cost ) then
						bank_afford = bank_afford + 1
						table.insert(cands, { pbg = pbg, name = name, cost = cost, score = score, now_ok = now_ok })
					end
					if ResourceAmount_Has( availableResources, cost ) then
						afford = afford + 1
						if now_only and not now_ok then
							notnow = notnow + 1
							if score > nn_score then nn_name, nn_score = name, score end
							P.nn_t = P.nn_t or {}; P.nn_t[name] = now                    -- (step 5: paid and not startable - not a unit to wait for, see dear_on)
						elseif better( now_ok, score ) then
							best, best_score, best_name, best_cost, best_now = pbg, score, name, cost, now_ok
						end
					end
				end
			end
		end
	end
	S.scan = false
	local topstr = string.format("engine_pos %d/%d top %s %.1f pmin %d", pos, prod, top_name, top_dem or 0, pmin)
	if prod == 0 then return none("no_unit", topstr) end
	-- step 15 (s12): nothing fits the budget's share while the bank could pay = "locked": the money is held by the budgets ahead
	-- of ours in the order (util/budget.ai:310-361: BUDGET_PlayerAbility at weight 60 holds the cost of the chosen global ability
	-- until it casts, Elite's researches), not by a unit of ours (a gated super unit has no demand and reserves nothing). The
	-- watchdog then buys from what the bank really has - bank minus the tasks (budget.ai:271/318) minus the tech plan's reserve
	-- (EliteAI_TechReserve: the tier research promoted first) - the best candidate by the same rule. Spend_OverLock=0 = old exit.
	local over = nil
	if best == nil and bank_afford > 0 and eai_num("Spend_OverLock", 1) >= 1 then
		local free = ResourceAmount_Subtract( bank, Task_CountCost( s_selfplayer, false ) )
		local rr, rp = 0, 0
		if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
		local wr, wp = 0, 0
		if type(EliteAI_EnergyWalk) == "function" then wr, wp = EliteAI_EnergyWalk( now ) end   -- 0.9: the node a squad walks to (the engine holds its cost)
		free.requisition, free.power = (free.requisition or 0) - rr - wr, (free.power or 0) - rp - wp
		for _, c in ipairs(cands) do
			if ResourceAmount_Has( free, c.cost ) and (c.now_ok or not now_only) and better( c.now_ok, c.score ) then
				best, best_score, best_name, best_cost, best_now = c.pbg, c.score, c.name, c.cost, c.now_ok
			end
		end
		over = string.format("over_lock avail %s free %s reserve %d/%d", s_rp(availableResources), s_rp(free), rr, rp)
		if best == nil and notnow > 0 then return none("not_now", p_short(nn_name), "of", notnow, topstr) end   -- 0.9: the share pays, the engine cannot start it
		if best == nil then return none("locked", "bank_afford", bank_afford, "free", s_rp(free), "reserve", rr .. "/" .. rp, topstr) end
	end
	if best == nil then
		if afford == 0 and bank_afford > 0 then return none("locked", "bank_afford", bank_afford, topstr) end   -- other budgets hold it (Spend_OverLock=0)
		if afford == 0 then return none("poor", topstr) end                                                  -- the bank itself is short
		if notnow > 0 then return none("not_now", p_short(nn_name), "of", notnow, topstr) end                -- 0.9: the engine cannot start what the bank can pay (pop, the producer)
		return none("blocked", topstr)                                                                       -- only super units left
	end
	-- step 5: the dear unit of our tier (see dear_on above) - picked among what the bank pays, waited for when it is not paid yet
	local dear = nil
	if dear_on and dear_pick ~= nil and dear_pick.name ~= best_name and dear_pick.pow > ((best_cost and best_cost.power) or 0)
		and dear_pick.score >= best_score * eai_num("Spend_DearK", 0.5) and not over then
		best, best_score, best_name, best_cost, best_now = dear_pick.pbg, dear_pick.score, dear_pick.name, dear_pick.cost, true
		dear = "dear"
		S.n_dear_pick = (S.n_dear_pick or 0) + 1
	end
	-- step 7: the episode of the dear unit - its unit when the budget pays it, else nothing else is bought until it ends
	if ep ~= nil then
		if ep_pick ~= nil then
			best, best_score, best_name, best_cost, best_now = ep_pick.pbg, ep_pick.score, ep_pick.name, ep_pick.cost, true
			dear = "dear episode"
		else
			ep.n = (ep.n or 0) + 1
			S.n_wait, S.n_wait_tier, S.n_wait_dear = (S.n_wait or 0) + 1, (S.n_wait_tier or 0) + 1, (S.n_wait_dear or 0) + 1
			local dw = (dear_wait ~= nil and dear_wait.name == ep.name) and dear_wait or nil
			return none("wait_tier", p_short(ep.name), string.format("score %.2f eta %d", dw and dw.score or 0, dw and dw.eta or ep.eta or 0), "over", p_short(best_name), string.format("%.2f", best_score),
				"dear pow", ep.pow or 0, "over", (best_cost and best_cost.power) or 0, "left", math.floor((ep.max or eai_num("Spend_DearMax", 90)) - (now - ep.t0)), "episode", topstr)
		end
	elseif dhold and dear_on and dear_wait ~= nil and dear_wait.pow > ((best_cost and best_cost.power) or 0) and not over then
		-- step 7: an episode begins only near (Spend_DearEta 60 s) and only the first of the tier (Spend_DearEps 1)
		S.dear_eps = S.dear_eps or {}
		local neps = S.dear_eps[lvl] or 0
		local eta_max = eai_num("Spend_DearEta", 60)
		-- STEP 8 (SPEND 0.14; VANILLA_BASE_RU.md 21.4 p.2 / 21.6 p.2): THE POWER BANK IS SPENT ON THE DEAR UNIT. s7: the orks never waited for
		-- the battlewagon ("dear skip ... eta 78-145 of 60", 7 times; req 150-200 a minute) and ended with 954-1503 power; the bank of
		-- all 16 players 784 at the end. With Spend_DearRichPow (500) power in the bank the episode begins up to Spend_DearRichEta (120 s)
		-- away and lasts its eta + 30 s (at least Spend_DearMax, at most Spend_DearRichMax 150 s); a second episode of the tier only with
		-- Spend_DearEps2Pow (600) power. "SPEND dear start ... rich", "dear_rich" in "ENERGY stats8". Spend_DearRichPow=0 = as 0.13.
		local rich = eai_num("Spend_DearRichPow", 500) > 0 and (bank.power or 0) >= eai_num("Spend_DearRichPow", 500)
		if rich and eta_max > 0 and eai_num("Spend_DearRichEta", 120) > eta_max then eta_max = eai_num("Spend_DearRichEta", 120) end
		local eps_max = eai_num("Spend_DearEps", 1)
		-- (the smoke s8_sm_en: two episodes of tier 3 and still 960-1000 power at the end - one more episode per Spend_DearEpsStep (300) over it)
		if eps_max > 0 and eai_num("Spend_DearRichPow", 500) > 0 and eai_num("Spend_DearEps2Pow", 600) > 0 and (bank.power or 0) >= eai_num("Spend_DearEps2Pow", 600) then
			eps_max = eps_max + 1
			if eai_num("Spend_DearEpsStep", 300) > 0 then eps_max = eps_max + math.floor(((bank.power or 0) - eai_num("Spend_DearEps2Pow", 600)) / eai_num("Spend_DearEpsStep", 300)) end
		end
		if (eta_max <= 0 or dear_wait.eta <= eta_max) and (eps_max <= 0 or neps < eps_max) then
			local emax = eai_num("Spend_DearMax", 90)
			local far = dear_wait.eta > eai_num("Spend_DearEta", 60) or neps >= eai_num("Spend_DearEps", 1)   -- begun only by the rich rule
			if rich and far then emax = math.max(emax, math.min(eai_num("Spend_DearRichMax", 150), math.floor(dear_wait.eta) + 30)) end
			S.dear_eps[lvl] = neps + 1
			S.dear_ep = { name = dear_wait.name, t0 = now, tier = lvl, req = dear_wait.req, pow = dear_wait.pow, eta = math.floor(dear_wait.eta), n = 1, max = emax }
			S.n_wait, S.n_wait_tier, S.n_wait_dear = (S.n_wait or 0) + 1, (S.n_wait_tier or 0) + 1, (S.n_wait_dear or 0) + 1
			S.n_dear_ep = (S.n_dear_ep or 0) + 1
			if rich and far then S.n_dear_rich = (S.n_dear_rich or 0) + 1 end
			eai_log("SPEND", "dear", "start", p_short(dear_wait.name), "eta", math.floor(dear_wait.eta), "tier", lvl, "episode", neps + 1, "of", eps_max,
				"for", emax, "s at most", "bank", s_rp(bank), (rich and far) and "rich" or "")
			return none("wait_tier", p_short(dear_wait.name), string.format("score %.2f eta %d", dear_wait.score, dear_wait.eta), "over", p_short(best_name), string.format("%.2f", best_score),
				"dear pow", dear_wait.pow, "over", (best_cost and best_cost.power) or 0, "left", emax, "episode", topstr)
		end
		S.n_dear_skip = (S.n_dear_skip or 0) + 1
		p_say("dear_skip|" .. dear_wait.name, 60, "SPEND", "dear", "skip", p_short(dear_wait.name), "eta", math.floor(dear_wait.eta), "of", eta_max,
			"episodes of tier", lvl, neps, "of", eps_max, "- the bank buys now")
	elseif not dhold and dear_on and dear_wait ~= nil and dear_wait.pow > ((best_cost and best_cost.power) or 0) and not over then
		if S.wait_t == nil or now - (S.wait_last or -1000) > 15 then S.wait_t = now end
		-- (step 6: its own limit, Spend_DearMax 90 s - was Spend_TierWaitMax 150; with the block below nothing else is bought
		-- meanwhile, so the wait is kept short: a unit the income brings within a minute and a half)
		local left = eai_num("Spend_DearMax", 90) - (now - S.wait_t)
		if dear_wait.eta <= left then
			S.wait_last = now
			S.dear_name, S.dear_t, S.dear_req = dear_wait.name, now, dear_wait.req   -- the block of the other blueprints (EliteAI_PurchaseMult) and of the upgrades
			S.n_wait, S.n_wait_tier, S.n_wait_dear = (S.n_wait or 0) + 1, (S.n_wait_tier or 0) + 1, (S.n_wait_dear or 0) + 1
			return none("wait_tier", p_short(dear_wait.name), string.format("score %.2f eta %d", dear_wait.score, dear_wait.eta), "over", p_short(best_name), string.format("%.2f", best_score),
				"dear pow", dear_wait.pow, "over", (best_cost and best_cost.power) or 0, "left", math.floor(left), topstr)
		end
	end
	-- 0.7 (TECH_RU.md 20.2): what the bank can pay is far worse than what the income brings within Spend_WaitEta (its score is
	-- Spend_WaitK times lower - the fourth squad of a kind, a blueprint nobody asked for against an answer): the watchdog waits.
	-- At most Spend_WaitMax (120 s) in a row - then it buys what there is.
	if wait_best ~= nil and eai_num("Spend_Wait", 1) >= 1 and wait_best.score >= best_score * eai_num("Spend_WaitK", 1.6) then
		if S.wait_t == nil or now - (S.wait_last or -1000) > 15 then S.wait_t = now end
		S.wait_last = now
		-- 0.8 (TECH_RU.md 21.1): behind the tempo the bank does not lie for two more minutes - Tempo_WaitMax (30 s), then what there is
		local wmax = eai_num("Spend_WaitMax", 120)
		if wait_best.top then wmax = math.max(wmax, eai_num("Spend_TierWaitMax", 150))   -- step 4: the unit of our tier, behind the tempo or not
		elseif type(EliteAI_Tempo) == "function" and EliteAI_Tempo() == true then wmax = math.min(wmax, eai_num("Tempo_WaitMax", 30)) end
		if now - S.wait_t < wmax then
			S.n_wait = (S.n_wait or 0) + 1
			if wait_best.top then S.n_wait_tier = (S.n_wait_tier or 0) + 1 end
			return none(wait_best.top and "wait_tier" or "wait", p_short(wait_best.name), string.format("score %.2f eta %d", wait_best.score, wait_best.eta), "over", p_short(best_name), string.format("%.2f", best_score), topstr)
		end
	end
	-- the HQ channel (Elite stalls every spawn while a request waits there, TryPurchaseUnitChoice): an inactive request is
	-- dropped first - a reinforcement no squad goes home for, or a spawn Elite would kill next tick anyway (default.ai:201-217)
	local queued = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, best )
	local killed = 0
	if queued > 0 and eai_num("Spend_KillInactive", 1) >= 1 then
		local inactive = Task_CountInGroup( s_selfplayer, TGROUP_BuildUnits ) - Task_CountActiveInGroup( s_selfplayer, TGROUP_BuildUnits )
		if inactive > 0 then
			local back = Task_CountGroupCost( s_selfplayer, TGROUP_BuildUnits, false )
			ai_budget:add_resources( back, "BUDGET_Units" )
			Task_KillInactiveTasksInGroup( s_selfplayer, TGROUP_BuildUnits )
			killed = inactive
			queued = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, best )
		end
	end
	if queued > 0 then return none("channel", queued, best_name, "killed", killed, topstr) end
	-- 0.9: after requests the engine did not start ("buy_dead") nothing is asked for a while (EliteAI_UnitPause)
	if EliteAI_UnitPause( now ) then return none("dead_pause", best_name, topstr) end
	-- 0.9 (TECH_RU.md 21.13): a request, not a purchase yet - the "buy" line, the book, the idle clock, the save state and the
	-- plan's claim are settled at the next tick, when the engine has started it or not (EliteAI_UnitNoteRequest / u_settle)
	EliteAI_UnitNoteRequest( best, best_name, best_cost, over and "spend over_lock" or "spend", best_now )   -- (the count before the request)
	Request_Production( s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits, PITEM_Spawn, best )
	S.cool, S.cool_name, S.wait_t = now, best_name, nil
	S.dear_name, S.dear_t, S.dear_req = nil, nil, nil                          -- (step 6: a unit is asked for - the dear unit's block ends)
	eai_log("SPEND", "idle", "bank", s_rp(bank), "for", for_s, "s", "->", "ask", best_name, s_rp(best_cost),
		string.format("score %.2f now %s cand %d killed %d", best_score, tostring(best_now), afford, killed),
		dear and (dear .. " " .. topstr) or (over and (over .. " " .. topstr) or topstr), s_diag( availableResources ))
	return true, best_cost
end

-- squad upgrades while hot: strategy_addon_purchase.ai (UpdateSquadDemand) rejects an addon whose CalcSquadUpgradeDemand
-- (engine rating diff) is <= 1 - the same engine judgement that leaves the units unbought; floored, the addon budget buys
if type(CalcSquadUpgradeDemand) == "function" and not EliteAI_SpendAddonWrapped then
	EliteAI_SpendAddonWrapped = true
	local Elite_CalcSquadUpgradeDemand = CalcSquadUpgradeDemand
	CalcSquadUpgradeDemand = function( upgradePBG, aiSquad )
		local d = Elite_CalcSquadUpgradeDemand( upgradePBG, aiSquad )
		-- energy (11.11): also while the power floats or a garrison calls for flamers / grenades (the new filter of the
		-- addon run then sorts the candidates by the power share of their cost)
		if (EliteAI_S.hot or (EliteAI_E and EliteAI_E.float) or (EliteAI_GarAddon and EliteAI_GarAddon( upgradePBG ))) and s_on() then
			local f = eai_num("Spend_AddonFloor", 8)
			if d < f then
				-- energy 0.3 (TECH_RU.md 12): never for an upgrade that was bought before in this match - a second purchase is
				-- by the engine's own rating alone (s15, floating: the hero's weapons acid_splatter / devourer_ap bought in turn,
				-- four and three times, 110-145 req each - with the floor the item just replaced is a candidate again)
				local nm = (upgradePBG ~= nil) and string.lower(PBG_GetName( upgradePBG ) or "") or ""
				if EliteAI_E and EliteAI_E.abought and EliteAI_E.abought[nm] then return d end
				EliteAI_S.addon_floor = EliteAI_S.addon_floor + 1
				return f
			end
		end
		return d
	end
end

-------------------------------------------------------------------------------------------------
-- EliteAI 10.11 (reinf): the reinforcement budget of the new logic (EliteAI.on only; Elite's AIs keep their code).
-- WHY: Elite reinforces first. AccumulateReinforceDemand gives every squad that misses a model a demand x50 (sk_reinforce_mult)
-- whenever one model is affordable within 30 s, so a reinforcement entry outranks every spawn in HighestSquadDemand. In s10
-- (2v2, selenonfissure, 38cd631) the tyranids bought 7 squads and nothing after 13:08: the req income (175-266/min) went into
-- gaunt reinforcements (pop 57-79 with 6-9 squads, 86 models lost and replaced), the req bank stayed below 300 while the power
-- bank grew to 1287 - the T2/T3 units (genestealer 350/45, zoanthrope 360/40, lictor 400/65, carnifex 575/150) never got req.
-- WHAT: a "save" state with hysteresis: on while the power bank is >= Reinf_BankPow and the req bank is below `need` = what we
-- save for (the next tier research the tech plan wants and has not placed, or the cheapest producible unit that uses power
-- >= Spend_PowUnit; capped by Reinf_NeedMax); off when the power is spent (< Reinf_BankPow x Reinf_ExitK), the req is there
-- and nobody takes it (need + Reinf_ReqMargin), a power unit was bought (then a pause of Reinf_PauseSecs so the squads
-- refill) or after Reinf_SaveMax without such a buy (pause too: something else holds the money). While saving, a cheap squad
-- (spawn cost power < Spend_PowUnit: gaunts, guardsmen, hws...) gets its reinforcement demand only when the arbiter
-- Conf_ReinforceVsSave says so; squads that use power are always reinforced ("pow_unit"). Readiness = 1 - missing models /
-- the most models seen in one squad of that blueprint (missing = the engine's total reinforce cost / the cost of one model;
-- the weakest squad of a blueprint decides, the engine's request is per blueprint); "in a fight" = a squad of the blueprint
-- was under attack in the last scan. Rules: 1 (A) = save: only a weak squad (readiness <= Reinf_LowHp) that is NOT in a fight
-- is refilled (a losing fight gets no money; the director sends it home at RetreatHP); 2 (B) = balanced: a weak squad is
-- refilled, in a fight or not; 3 (C) = army first: every squad in a fight and every squad below Reinf_FullHp. On top, the
-- cheap reinforcements of the last minute may not exceed Reinf_Share of the req income per minute (0.2 / 0.35 / 0.5 by rule;
-- the ledger counts the requests TryPurchaseUnitChoice places). A decision per blueprint holds Reinf_ConfHold seconds,
-- every switch is logged. While saving, the spawn demand of the cheap units is damped x Reinf_SaveSpawnMult on top of
-- Spend_LowPowMult (EliteAI_PurchaseMult), so the saved req goes to the power units: Elite's own stall ("lack of moola")
-- then locks the money for the chosen power unit until it is affordable, and the watchdog (pmin) buys them too.
-- LOG (EliteAI.log, "AI: p<id> REINF ..."): "REINF init ...", "REINF save on|off req R pow P need N (<what>) why <why> rule K",
-- "REINF skip|allow <sbps> req R pow P why <why> miss M n N hit H rule K per C spent S cap C" (while saving; counted always,
-- printed at most once per Reinf_LogSecs per blueprint and verdict), "REINF Conf_ReinforceVsSave <sbps> allow->skip <why>
-- rule K" (every switch of the arbiter), "REINF stats ..." every Reinf_StatsSecs. Off without a rebuild: Reinf_BankPow=99999.
-- SAFETY: numbers and strings between ticks only (EliteAI_R); squads are read and dropped within the tick (aisq / sim squad
-- nil checks, Squad_Count > 0 before health); no pcall around engine calls; no randomness; every engine function is one
-- Elite's scripts or our in-game-verified files call (file:line in reports/newai_1110/TECH_RU.md section 8).
EliteAI_REINF_VERSION = "0.8"
EliteAI_R = {}
local function r_reset()
	EliteAI_R = { save = false, save_t = -1, sw_t = -1000, pause_until = -1, need = 0, need_what = "-", need_t = -1000, conf = {}, said = {},
		ledger = {}, sq = {}, maxc = {}, scan_t = -1000, last_stats = 0, n_skip = 0, n_allow = 0, n_sw = 0, n_req = 0, skip_est = 0,
		dir = {}, n_dir = 0, n_dir_poor = 0, n_dir_cap = 0, n_dir_mute = 0, dir_now = -1, dir_used = 0,   -- 0.2: the director's squads
		pow_buys = 0, last_pow_buy = -1, last_pow_name = "-", save_n = 0, save_secs = 0,
		cnt = {}, n_models = 0, req_models = 0, req_led = {}, free_until = -1,   -- 0.3: models that came (the real spend), the requests apart
		save_why = "-", uneed = 0, uneed_what = "-", last_buy = -1, last_buy_name = "-", claim_t = -1000,   -- 0.3: the "unit" save
		n_unit_skip = 0, n_dir_unit = 0, n_dir_lost = 0, dir_used_p = 0 }
end
r_reset()
local function r_short(name)                                                -- "sbps\pvp\race_tyranid\troops\tyr_termagaunt" -> "tyr_termagaunt"
	local s = string.lower(name or "")
	local _, _, short = string.find(s, "([^/\\]+)$")
	return short or s
end
local function r_key(name) return (string.gsub(string.lower(name or ""), "\\", "/")) end
local function r_vidx() local v = EliteAI and EliteAI.variant; return (v == "B" and 2) or (v == "C" and 3) or 1 end
local function r_rule()                                                     -- Conf_ReinforceVsSave = 1/2/3 (default: the variant)
	local r = math.floor(eai_num("Conf_ReinforceVsSave", r_vidx()))
	if r < 1 then r = 1 elseif r > 3 then r = 3 end
	return r
end
local function r_share()                                                    -- the share of the req income per minute for cheap reinforcements
	local r = r_rule()
	return eai_num("Reinf_Share", (r == 1 and 0.2) or (r == 2 and 0.35) or 0.5)
end
-- the arbiter's memory: a decision per blueprint holds Reinf_ConfHold seconds (hysteresis); every switch is logged
local function r_decide( key, v, why, now )
	local R = EliteAI_R
	local c = R.conf[key]
	if not c then R.conf[key] = { v = v, t = now }; return v, false end
	if c.v == v then return v, false end
	if now - c.t < eai_num("Reinf_ConfHold", 10) then return c.v, true end
	eai_log("REINF", "Conf_ReinforceVsSave", r_short(key), c.v .. "->" .. v, why, "rule", r_rule())
	c.v, c.t = v, now
	R.n_sw = R.n_sw + 1
	return v, false
end
-- the ledgers of the last 60 s (numbers only). 0.3 (TECH_RU.md 13): R.ledger = the req of the models that CAME (r_models below:
-- the real spend - the share cap and the book of purchases read it); R.req_led = the req of the requests placed, whatever
-- became of them (s16: "reinf 88x 2278" in the book and reinf_req_min 254-510 at an income of 240 - requests the engine killed
-- as inactive and Elite placed again, the same mistake the upgrades had before 12.3)
local function r_sum60( key, now )
	local R, keep, sum = EliteAI_R, {}, 0
	for _, e in ipairs(R[key]) do
		if now - e.t < 60 then table.insert(keep, e); sum = sum + e.req end
	end
	R[key] = keep
	return sum
end
local function r_ledger( now ) return r_sum60( "ledger", now ) end
-- the director's orders that are paid (or will be) and have not brought their model yet: req (each entry on its own, a sum)
local function r_pending( now )
	local sum = 0
	for _, d in pairs(EliteAI_R.dir) do
		if now - d.last <= 30 then
			local coming = d.sent - math.max(0, (d.have or d.n0) - d.n0)
			if coming > 0 then sum = sum + coming * (d.per or 0) end
		end
	end
	return sum
end
-- 0.3 the models that came, every units tick: a squad that has more models than at the last tick was reinforced - by Elite's
-- request, by the director's order (mode 6), whoever asked. That many models x the cost of one (AIPlayer_GetProductionCost,
-- PITEM_SquadReinforce: AccumulateReinforceDemand below) is what was really paid: into R.ledger and the book ("reinf").
-- Not counted: a squad seen for the first time and its first Reinf_NewSecs (it may leave the HQ model by model), the seconds
-- after a spawn ability (EliteAI_ReinforceFree: "without number" fills squads for the ability's price, which is in the book
-- as "abil"). A model lost and a model gained by one squad between two ticks cancel out (the book is a little low then); a
-- squad leader bought as an upgrade reads as one model (a little high). Numbers per squad id between ticks (R.cnt).
local function r_models( now )
	local R = EliteAI_R
	local newsecs, free = eai_num("Reinf_NewSecs", 6), (now < (R.free_until or -1))
	local n = Military_SquadTotalCount( s_selfplayer )                       -- strategy_addon_purchase.ai:120
	for i = 0, n - 1 do
		local aisq = Military_GetAISquadAtIndex( s_selfplayer, i )            -- strategy_addon_purchase.ai:123
		if aisq ~= nil then
			local s = AISquad_ConvertToSimSquad( aisq )                       -- tactics.ai:270 (nil for a squad that is not spawned)
			local c = (s ~= nil) and Squad_Count( s ) or 0
			local id = (c > 0) and Squad_GetGameID( s ) or nil                -- main.ai (the director's scan; in game since step 7)
			if id ~= nil then
				local e = R.cnt[id]
				if e == nil then
					R.cnt[id] = { c = c, t0 = now, t = now }
				else
					if c > e.c and now - e.t0 >= newsecs and not free then
						local pbg = AISquad_ConvertToPBG( aisq )
						if pbg ~= nil then
							local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
							local k = c - e.c
							local pr, pp = ((per and per.requisition) or 0) * k, ((per and per.power) or 0) * k
							table.insert(R.ledger, { t = now, req = pr })
							R.n_models, R.req_models = R.n_models + k, R.req_models + pr
							if EliteAI_EnergyNote then EliteAI_EnergyNote( "reinf", { requisition = pr, power = pp }, k ) end
						end
					end
					e.c, e.t = c, now
				end
			end
		end
	end
	for id, e in pairs(R.cnt) do if now - e.t > 60 then R.cnt[id] = nil end end   -- squads that are gone (each entry on its own)
end
-- a spawn ability was cast (mod/mechanics.ai): the models it brings are paid with the ability
function EliteAI_ReinforceFree( secs )
	if not s_on() then return end
	EliteAI_R.free_until = World_GetGameTime() + (secs or eai_num("Reinf_FreeSecs", 8))
end
-- our squads by blueprint, numbers only: EliteAI_R.sq[key] = { n, hit, low, minc }; EliteAI_R.maxc[key] = most models seen in one squad
local function r_scan( now )
	local R = EliteAI_R
	if now - R.scan_t < eai_num("Reinf_ScanSecs", 6) then return end
	R.scan_t = now
	local lowhp = eai_num("Reinf_LowHp", 0.5)
	local sq, maxc = {}, R.maxc
	local n = Military_SquadTotalCount( s_selfplayer )                       -- strategy_addon_purchase.ai:120
	for i = 0, n - 1 do
		local aisq = Military_GetAISquadAtIndex( s_selfplayer, i )            -- strategy_addon_purchase.ai:123
		if aisq ~= nil then
			local s = AISquad_ConvertToSimSquad( aisq )                       -- tactics.ai:270 (nil for a squad that is not spawned)
			local c = (s ~= nil) and Squad_Count( s ) or 0                    -- mechanics.ai:308 (in game since step 7)
			if c > 0 then
				local pbg = AISquad_ConvertToPBG( aisq )                       -- strategy_unit_purchase.ai:104 (Elite), strategy_addon.ai:188
				local key = (pbg ~= nil) and r_key(PBG_GetName( pbg )) or ""
				if key ~= "" then
					local e = sq[key]
					if not e then e = { n = 0, hit = 0, low = 0, minc = c }; sq[key] = e end
					e.n = e.n + 1
					if c < e.minc then e.minc = c end
					if not maxc[key] or c > maxc[key] then maxc[key] = c end
					if Squad_IsUnderAttack( s, 5 ) then e.hit = e.hit + 1 end      -- player-tactics.ai:51
					local hmax = Squad_GetHealthMax( s )                            -- tactics.ai:277
					if hmax > 0 and Squad_GetHealth( s ) / hmax <= lowhp then e.low = e.low + 1 end
				end
			end
		end
	end
	R.sq = sq
end
-- what we save the req for: the next tier research the tech plan wants and has not placed yet, or the cheapest producible unit
-- that uses power (>= Spend_PowUnit; heroes, forbidden and super units aside); 0 = nothing to save for; at most once per Reinf_NeedSecs
local function r_need( now )
	local R = EliteAI_R
	if now - R.need_t < eai_num("Reinf_NeedSecs", 10) then return R.need end
	R.need_t = now
	local need, what = 0, "-"
	local tech_first = false
	local T = EliteAI_T                                                      -- strategy_tech_purchase.ai (numbers; nil in the stub)
	if type(T) == "table" and T.want and T.k and (T.cost_req or 0) > 0 then
		local st = T.st and T.st[T.k]
		if not (st and st.started) then
			need, what = T.cost_req, "tech_" .. tostring(T.tag or "?")
			tech_first = (T.decision == "tech")                              -- 11: the plan holds its reserve - the save is for the research, not for a dearer unit
		end
	end
	local pmin = eai_num("Spend_PowUnit", 40)
	-- energy (11.11): only a unit the income brings within Energy_EtaMax is worth saving for (the polygon: the save state held
	-- the req for a unit while nothing could come for minutes); ETA by the req bank and the req income per minute (cache.ai:156)
	local req = (cache.resources and cache.resources.requisition) or 0
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local eta_max = eai_num("Energy_EtaMax", 120)
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	local best, best_name, best_eta, far, far_name, far_eta = nil, "-", 0, nil, "-", 0
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		if pbg ~= nil and AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) then
			local name = string.lower(PBG_GetName( pbg ) or "")
			local cap = s_unit_purchase_limit and s_unit_purchase_limit[ PBG_GetID( pbg ) ]
			if eai_class(name) ~= "hero" and not (cap and cap < 1) and not EliteAI_IsSuper( pbg, name ) then
				local cost = SquadStats_GetCost( s_self_modplayer, pbg )
				local cr, cp = (cost and cost.requisition) or 0, (cost and cost.power) or 0
				if cp >= pmin and cr > 0 then
					local eta = 0
					if cr > req then eta = (rate > 0) and (60 * (cr - req) / rate) or 11111 end
					if eta <= eta_max then
						if best == nil or cr < best then best, best_name, best_eta = cr, name, eta end
					elseif far == nil or cr < far then
						far, far_name, far_eta = cr, name, eta
					end
				end
			end
		end
	end
	local unreach = (best == nil and far ~= nil)                            -- power units exist, none within reach at this income
	if unreach ~= (R.unreach == true) then
		if unreach then
			eai_log("REINF", "need", "none", "cheapest power unit", r_short(far_name), math.floor(far), "req is", math.floor(far_eta), "s away at",
				math.floor(rate), "req/min (>", eta_max, "): not saving for it, cheap units are not held back")
		else
			eai_log("REINF", "need", "back", best and r_short(best_name) or "-", best and math.floor(best) or 0, "eta", math.floor(best_eta), "s")
		end
	end
	R.unreach = unreach
	if best and best > need and not tech_first then need, what = best, r_short(best_name) end
	local mx = eai_num("Reinf_NeedMax", 600)
	if need > mx then need = mx end
	R.need, R.need_what = need, what
	return need
end
-- 0.3 (TECH_RU.md 13) THE UNIT FIRST. s16 (tyranids): 4 units by 12:00, none for 464 s; a genestealer (350/45) waited from 6:03
-- to the end. From 7:00 to 10:30 the log has no "SPEND stall" line at all: a reinforcement entry (demand x50) was the first
-- choice of the units budget at every tick, its request (18 req) was placed, and the second pass of that tick runs with a
-- unit wait of 0 s (CalculateUnitETA) - a spawn that is not affordable at once is no entry there. So no unit was "stalled":
-- no lock of its money, no Conf_AddonVsUnit (the upgrades took ~650 req), no "save" (it asked for 300 power in the bank and
-- came at 10:41) - while 46 of 71 ticks placed a reinforcement request.
-- Now the plan's next unit is noted before the choice (EliteAI_PlanClaim, EliteAI_E.stall), whatever is bought first, and:
--   * "quick" - the unit has its money and waits for the HQ, or the income brings it within Reinf_UnitEta (45 s): a squad
--     gets a model only when it is weak (readiness <= Reinf_LowHp; rule 1: and not in a fight) or, rules 2 / 3, in a fight;
--     a squad that is not in a fight and above half waits for the unit (Elite's requests: the gate; the director's: the purse);
--     a unit that had its money and a free HQ at the last tick ("ready") and was not bought goes before every model;
--   * the "save" state comes on when the unit has been short of req for Reinf_WaitSecs (45 s) without a break, whatever the
--     power bank ("save on ... why unit short of req for N s"); it ends when a unit is bought (pause Reinf_PauseSecs: the
--     squads refill), when no unit is waited for (Reinf_ClaimGone 20 s), with the req there or after Reinf_SaveMax.
-- Reinf_UnitFirst=0 = as before (the power-bank save only).
-- 0.6 EXPENDABLES (TECH_RU.md 19.3; Orca's live matches against the tyranids, variant C - fb 544: "70 refills of gaunts, 114 models
-- lost, 8 units in 14 minutes"; newai-17, 22 minutes: 11 units 3290 req, 75 models 1644 req - 918 of them 18-req gaunts of six
-- broods - 143 models lost; the plan's genestealer 350/45 stood at "why money" for 210 s with 50-290 req in the bank). A cheap
-- brood that dies in every fight was refilled as a "weak" squad - past the unit that waits, within 60 % of the income - again
-- and again: the req of three units went into models that did not change a fight. The squads of REINF_EXPENDABLE (the races'
-- data, by a part of the sbps name: the gaunt broods - the testers' word; other races: no evidence, none listed), while a
-- unit of the plan WAITS (the stall record of the units budget, any reason):
--   * are not "weak" squads: no model past the unit;
--   * get models only from the req that lies in the bank BEYOND the unit's price (the unit waits for power or for the HQ:
--     the rest is free), and
--   * all of them together within Reinf_ExpShare (0.35) of the req income per minute.
-- No unit waits (the population cap, nothing wanted) - as any squad. Both ways of a model: the director's refill at home
-- (EliteAI_ReinforceDir) and Elite's own requests (EliteAI_ReinforceGate). Lines "REINF dir expendable ...", "REINF skip ...
-- expendable ..."; the stats: exp_held, exp_paid. Reinf_Exp=0 = as 0.5.
local REINF_EXPENDABLE = { "troops/tyr_termagaunt", "troops/tyr_hormagaunt", "troops/tyr_ripper" }
local function r_exp( key )
	if eai_num("Reinf_Exp", 1) < 1 or key == nil then return false end
	for _, k in ipairs(REINF_EXPENDABLE) do if string.find(key, k, 1, true) then return true end end
	return false
end
local function r_exp60( now )                                               -- req paid for expendables' models in the last minute
	local L, sum, keep = EliteAI_R.exp_log or {}, 0, {}
	for _, e in ipairs(L) do if now - e.t <= 60 then sum = sum + e.r; table.insert(keep, e) end end
	EliteAI_R.exp_log = keep
	return sum
end
local function r_exp_note( now, req )
	local R = EliteAI_R
	R.exp_log = R.exp_log or {}
	table.insert(R.exp_log, { t = now, r = req })
	R.exp_paid = (R.exp_paid or 0) + req
end
-- how many models of `pr` req an expendable squad may get now while the unit `st` waits (0 = none), and why not
local function r_exp_room( now, st, pr, used )
	local bank = cache.resources
	local rr = 0
	if type(EliteAI_TechReserve) == "function" then rr = EliteAI_TechReserve() or 0 end
	if pr <= 0 then return 99, nil end
	local beyond = math.floor(((bank.requisition or 0) - rr - (used or 0) - (st.req or 0)) / pr)
	if beyond < 1 then return 0, "unit" end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local fit = math.floor((rate * eai_num("Reinf_ExpShare", 0.35) - r_exp60( now )) / pr)
	if fit < 1 then return 0, "share" end
	return math.min(beyond, fit), nil
end
local function r_claim( now )                                               -- quick (bool), the record { name, req, pow, eta, why, msince } or nil
	local st = EliteAI_E and EliteAI_E.stall
	if st == nil or now - st.t > 7 or eai_num("Reinf_UnitFirst", 1) < 1 then return false, nil end
	local reach = eai_num("Reinf_UnitEta", 45)
	if type(EliteAI_TechUnitFirst) == "function" and EliteAI_TechUnitFirst() == true then reach = math.max(reach, eai_num("Tech_FloatUnitEta", 75) * 1.5) end   -- 0.5 (TECH_RU.md 15.3)
	return (st.why ~= "money") or ((st.eta or 0) <= reach), st
end
local function r_need_now()                                                 -- what the save state saves for: req, name
	local R = EliteAI_R
	if R.save and R.save_why == "unit" then return R.uneed or 0, R.uneed_what or "-" end
	return R.need, R.need_what
end
function EliteAI_ReinforceNeed() return r_need_now() end                    -- mod/mechanics.ai (the line of a held ability)
local function r_save_log( on, bank, why )
	local need, what = r_need_now()
	eai_log("REINF", "save", on and "on" or "off", "req", math.floor(bank.requisition or 0), "pow", math.floor(bank.power or 0),
		"need", math.floor(need), "(" .. what .. ")", "why", why, "rule", r_rule())
end
-- the save state: a switch holds Reinf_ConfHold seconds; a buy of what it saved for switches it off at once (then the pause)
local function r_save_state( now, bank )
	local R = EliteAI_R
	local req, pow = bank.requisition or 0, bank.power or 0
	local bp = eai_num("Reinf_BankPow", eai_num("Spend_BankPow", 300))
	local need = r_need( now )
	local hold = eai_num("Reinf_ConfHold", 10)
	local margin, pause, smax = eai_num("Reinf_ReqMargin", 200), eai_num("Reinf_PauseSecs", 45), eai_num("Reinf_SaveMax", 240)
	local _, st = r_claim( now )
	local short = (st ~= nil and st.why == "money")                         -- 0.3: the plan's unit is short of money ...
	local uwait = (short and st.msince ~= nil) and (now - st.msince) or -1  -- ... for this long without a break
	if st ~= nil then R.claim_t = now end
	if R.save then
		local why
		if R.save_why == "unit" then
			if short then R.uneed, R.uneed_what = st.req or 0, st.name or "-" end
			if R.last_buy >= R.save_t then                                  -- >=: the buy can come later in the tick that switched on
				why = "unit_buy " .. r_short(R.last_buy_name); R.pause_until = now + pause
			elseif now - R.sw_t < hold then
				return true
			elseif now - R.claim_t >= eai_num("Reinf_ClaimGone", 20) then
				why = "no_unit"
			elseif req >= (R.uneed or 0) + margin then
				why = "req " .. math.floor(req) .. ">=" .. math.floor((R.uneed or 0) + margin)
			elseif now - R.save_t >= smax then
				why = "timeout " .. math.floor(now - R.save_t); R.pause_until = now + pause
			end
		elseif R.last_pow_buy >= R.save_t then                              -- >=: the buy can come later in the tick that switched on
			why = "pow_buy " .. r_short(R.last_pow_name); R.pause_until = now + pause
		elseif now - R.sw_t < hold then
			return true
		elseif pow < bp * eai_num("Reinf_ExitK", 0.5) then
			why = "pow " .. math.floor(pow)
		elseif need <= 0 then
			why = "no_need"
		elseif req >= need + margin then
			why = "req " .. math.floor(req) .. ">=" .. math.floor(need + margin)
		elseif now - R.save_t >= smax then
			why = "timeout " .. math.floor(now - R.save_t); R.pause_until = now + pause
		end
		if why then
			r_save_log( false, bank, why )                                  -- (before the switch: the line names what it saved for)
			R.save, R.sw_t = false, now
			R.save_secs = R.save_secs + (now - R.save_t)
		end
		return R.save
	end
	if now < R.pause_until or now - R.sw_t < hold then return false end
	if pow >= bp and need > 0 and req < need then
		R.save, R.save_t, R.sw_t, R.save_n, R.save_why = true, now, now, R.save_n + 1, "pow"
		r_save_log( true, bank, "pow " .. math.floor(pow) .. ">=" .. math.floor(bp) .. " req " .. math.floor(req) .. "<" .. math.floor(need) )
	elseif uwait >= eai_num("Reinf_WaitSecs", 45) then
		R.save, R.save_t, R.sw_t, R.save_n, R.save_why = true, now, now, R.save_n + 1, "unit"
		R.uneed, R.uneed_what = st.req or 0, st.name or "-"
		r_save_log( true, bank, "unit short of req for " .. math.floor(uwait) .. " s" )
	end
	return R.save
end
-- the verdict per blueprint for this tick (called by AccumulateReinforceDemand): key -> true (reinforce) / false (skip);
-- nil = Elite's AI (everything as before)
function EliteAI_ReinforceGate( reinforcecount, availableResources )
	if not s_on() or cache == nil or cache.resources == nil then return nil end
	local R = EliteAI_R
	local now = World_GetGameTime()
	local bank = cache.resources
	local gate = {}
	local quick, st = r_claim( now )                                        -- 0.3: the unit the plan waits for is within reach
	-- 0.6: an expendable brood while a unit waits (see REINF_EXPENDABLE) - true = no model for it now
	local function exp_skip( k, pbg )
		if st == nil or not r_exp( k ) then return false end
		local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
		local room, why = r_exp_room( now, st, (per and per.requisition) or 0, 0 )
		if room >= 1 then return false end
		R.n_exp = (R.n_exp or 0) + 1
		if R.said["exp:" .. k] == nil or now - R.said["exp:" .. k] >= eai_num("Reinf_LogSecs", 30) then
			R.said["exp:" .. k] = now
			eai_log("REINF", "skip", r_short(k), "expendable", why == "share" and "over its share of the income" or "the unit first:", tostring(st.name), tostring(st.req) .. "/" .. tostring(st.pow),
				tostring(st.why), "eta", math.floor(st.eta or 0), "bank", s_rp(bank), "exp60", math.floor(r_exp60( now )), "held", R.n_exp)
		end
		return true
	end
	-- STEP 3 (0.13): the swap at the population cap - no model for a T1 blueprint whose weakest squad stands at Swap_Fill or
	-- above (R.sq: the fewest models seen in one squad of the blueprint at the last scan; R.maxc: a full one)
	local function swap_skip( k, pbg )
		if EliteAI_PopSwap == nil or not EliteAI_PopSwap() then return false end
		if not EliteAI_SwapWeak( string.lower(PBG_GetName( pbg ) or "") ) then return false end
		local s, fsz = R.sq and R.sq[k], R.maxc[k] or 0
		if s == nil or fsz < 3 then return false end
		local fill = math.max(2, math.ceil(fsz * EliteAI_SwapFill()))
		if s.minc < fill then return false end
		EliteAI_E.n_swap_skip = (EliteAI_E.n_swap_skip or 0) + 1
		if R.said["swap:" .. k] == nil or now - R.said["swap:" .. k] >= eai_num("Reinf_LogSecs", 30) then
			R.said["swap:" .. k] = now
			eai_log("REINF", "skip", r_short(k), "req", math.floor(bank.requisition or 0), "pow", math.floor(bank.power or 0), "why", "swap", "models", s.minc, "of", fsz, "fill", fill,
				"pop", (cache.current_population_personnel or 0) .. "/" .. (cache.max_population_personnel or 0))
		end
		return true
	end
	if not R.save and not quick then
		for i = 0, reinforcecount - 1 do
			local pbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
			if pbg ~= nil then
				local k = r_key(PBG_GetName( pbg ))
				if gate[k] == nil then
					if exp_skip( k, pbg ) then gate[k] = false; R.n_skip = R.n_skip + 1
					elseif swap_skip( k, pbg ) then gate[k] = false; R.n_skip = R.n_skip + 1
					else gate[k] = true; R.n_allow = R.n_allow + 1 end
				end
			end
		end
		return gate
	end
	-- the unit had its money and a free HQ at the last tick and was not bought: something went first (a refill of 18 req is
	-- enough to leave it short on the second pass). This tick nothing is refilled - it is bought now, the models come next tick
	if st ~= nil and st.why == "ready" then
		for i = 0, reinforcecount - 1 do
			local pbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
			if pbg ~= nil then
				local k = r_key(PBG_GetName( pbg ))
				if gate[k] == nil then gate[k] = false; R.n_skip, R.n_unit_skip = R.n_skip + 1, R.n_unit_skip + 1 end
			end
		end
		return gate
	end
	local unit_mode = not R.save                                            -- 0.3: not saving - the unit within reach is why we are here
	local utxt = unit_mode and ("unit " .. tostring(st.name) .. " " .. tostring(st.why) .. " eta " .. math.floor(st.eta or 0)) or ""
	local pmin, low, full, rule = eai_num("Spend_PowUnit", 40), eai_num("Reinf_LowHp", 0.5), eai_num("Reinf_FullHp", 0.8), r_rule()
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0   -- per minute (cache.ai:156)
	local spent = r_ledger( now ) + r_pending( now )                        -- 0.3: paid (the models that came) + the director's orders on their way
	local cap = rate * r_share()
	-- the entries by blueprint; the weakest squad of a blueprint decides
	local ent, order = {}, {}
	for i = 0, reinforcecount - 1 do
		local pbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
		if pbg ~= nil then
			local k = r_key(PBG_GetName( pbg ))
			local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
			local total = AIProduction_GetReinforcementSquadCostAt( s_selfplayer, i )
			local pr, tr = (per and per.requisition) or 0, (total and total.requisition) or 0
			local missing = 1
			if pr > 0 and tr > 0 then missing = math.floor(tr / pr + 0.5); if missing < 1 then missing = 1 end end
			local e = ent[k]
			if not e then
				local cost = SquadStats_GetCost( s_self_modplayer, pbg )
				e = { pow = (cost and cost.power) or 0, per = pr, missing = missing, n = 0 }
				ent[k] = e; table.insert(order, k)
			end
			e.n = e.n + 1
			if e.exp == nil then e.exp = exp_skip( k, pbg ) end                 -- 0.6
			if e.swap == nil then e.swap = swap_skip( k, pbg ) end              -- step 3 (0.13)
			if missing > e.missing then e.missing = missing end
		end
	end
	for _, k in ipairs(order) do
		local e = ent[k]
		local v, why, ready, hit = "allow", "pow_unit", 1, false
		if e.pow < pmin or unit_mode then                                   -- (for the unit within reach a squad that uses power waits as the cheap ones do)
			-- the full size of the squad: the fewest models seen in a squad of this blueprint (last scan) + the most missing
			-- (the weakest squad is the one missing most) - exact with a fresh scan; the most models ever seen as the floor
			local s, fsz = R.sq[k], R.maxc[k] or 0                         -- fsz: models in a full squad (not `full` = Reinf_FullHp)
			if s ~= nil and s.minc + e.missing > fsz then fsz = s.minc + e.missing end
			if fsz > 0 then ready = (fsz - e.missing) / fsz; if ready < 0 then ready = 0 end
			else ready = (e.missing <= 1) and 0.9 or 0.3 end                 -- no scan of this blueprint yet: one model short = nearly full
			hit = (s ~= nil and s.hit > 0)
			local rtxt = string.format("ready %.2f", ready)
			if unit_mode then
				-- 0.3: a weak squad is refilled all the same (rule 1: not into a losing fight), a squad in a fight too (rules 2, 3);
				-- one that is out of the fight and above half waits for the unit
				if ready <= low and not (rule == 1 and hit) then v, why = "allow", "weak " .. rtxt .. (hit and " in_fight" or "")
				elseif hit and rule >= 2 then v, why = "allow", "in_fight " .. rtxt
				elseif st.why == "channel" and (bank.requisition or 0) - (st.req or 0) >= e.per then v, why = "allow", "bank pays both " .. rtxt   -- the unit's money stays whole
				else v, why = "skip", utxt .. " " .. rtxt end
			elseif rule == 1 then
				if ready <= low and not hit then v, why = "allow", "weak " .. rtxt
				elseif ready <= low then v, why = "skip", "weak_in_fight " .. rtxt
				else v, why = "skip", rtxt end
			elseif rule == 2 then
				if ready <= low then v, why = "allow", "weak " .. rtxt .. (hit and " in_fight" or "")
				else v, why = "skip", rtxt end
			else
				if hit then v, why = "allow", "in_fight " .. rtxt
				elseif ready <= full then v, why = "allow", "weak " .. rtxt
				else v, why = "skip", rtxt end
			end
		end
		-- step 14 (s11): the share cap holds for squads with power too - in s11 genestealer/ravener refills ("pow_unit")
		-- took 337-437 req/min against a cap of 74-101 while saving, and the req never reached the next power unit
		-- 0.4: a model that costs more than the minute's share (GK: 75 req against a cap of 53 at rule 1) is not shut out for
		-- good - one goes when nothing was paid for a minute (the cap is the average, a model is its grain)
		if v == "allow" and e.exp then v, why = "skip", "expendable, a unit waits" end   -- 0.6
		if v == "allow" and e.swap then v, why = "skip", "swap" end                    -- step 3 (0.13)
		if v == "allow" and cap > 0 and spent + e.per > cap and spent > 0 then
			v, why = "skip", string.format("share %d+%d>%d", spent, e.per, cap) .. ((e.pow >= pmin) and " pow_unit" or "")
		end
		local dv, held = r_decide( k, v, why, now )
		if dv == "allow" then R.n_allow = R.n_allow + 1
		else
			R.n_skip = R.n_skip + 1; R.skip_est = R.skip_est + e.per
			if unit_mode then R.n_unit_skip = R.n_unit_skip + 1 end
		end
		local sk = k .. ":" .. dv
		local last = R.said[sk]
		if last == nil or now - last >= eai_num("Reinf_LogSecs", 30) then
			R.said[sk] = now
			eai_log("REINF", dv, r_short(k), "req", math.floor(bank.requisition or 0), "pow", math.floor(bank.power or 0),
				"why", why .. (held and " (held)" or ""), "miss", e.missing, "n", e.n, "hit", hit and 1 or 0, "rule", rule,
				"per", math.floor(e.per), "spent", math.floor(spent), "cap", math.floor(cap))
		end
		gate[k] = (dv == "allow")
	end
	return gate
end
function EliteAI_ReinforceNoteRequest( cost )                               -- TryPurchaseUnitChoice placed a reinforcement request
	if not s_on() then return end
	local R = EliteAI_R
	table.insert(R.req_led, { t = World_GetGameTime(), req = (cost and cost.requisition) or 0 })   -- 0.3: a request, not a purchase (r_models books the model)
	R.n_req = R.n_req + 1
end
function EliteAI_ReinforceNoteBuy( name, cost, now )                        -- a spawn request ends the save state: any unit the "unit" save, a power unit the "pow" save
	if not s_on() then return end
	local R = EliteAI_R
	R.last_buy, R.last_buy_name = now, name or "-"
	if cost and (cost.power or 0) >= eai_num("Spend_PowUnit", 40) then
		R.pow_buys, R.last_pow_buy, R.last_pow_name = R.pow_buys + 1, now, name or "-"
	end
end
-- every purchase tick (do_purchase, before the watchdog, first pass of the budget loop): the scan, the save state, the stats line
function EliteAI_ReinforceTick( availableResources, purchase_count )
	if not s_on() or cache == nil or cache.resources == nil or purchase_count ~= 0 then return end
	local R = EliteAI_R
	local now = World_GetGameTime()
	r_models( now )                                                          -- 0.3: the models that came since the last tick = the real spend
	r_scan( now )
	r_save_state( now, cache.resources )
	if now - R.last_stats < eai_num("Reinf_StatsSecs", 60) then return end
	R.last_stats = now
	for key, c in pairs(R.conf) do if now - c.t > 300 then R.conf[key] = nil end end   -- old decisions of blueprints gone
	local nsq, nhit, nlow = 0, 0, 0
	for _, e in pairs(R.sq) do nsq = nsq + e.n; nhit = nhit + e.hit; nlow = nlow + e.low end
	local saved = R.save_secs + (R.save and (now - R.save_t) or 0)
	eai_log("REINF", "stats", "t", math.floor(now), "save", R.save and "on" or "off", "since", R.save and math.floor(now - R.save_t) or 0,
		"saved_secs", math.floor(saved), "episodes", R.save_n, "need", math.floor((r_need_now())), "(" .. select(2, r_need_now()) .. ")", "rule", r_rule(),
		"bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "skip", R.n_skip, "allow", R.n_allow, "skip_est", math.floor(R.skip_est),
		"requests", R.n_req, "reinf_req_min", math.floor(r_sum60( "req_led", now )), "share", string.format("%.2f", r_share()),
		"pow_buys", R.pow_buys, "switches", R.n_sw, "squads", nsq, "hit", nhit, "low", nlow,
		"dir", R.n_dir, "dir_poor", R.n_dir_poor, "dir_cap", R.n_dir_cap, "dir_mute", R.n_dir_mute, "dir_dry", R.n_dir_dry or 0,
		"models", R.n_models, "paid", math.floor(R.req_models), "paid_min", math.floor(r_ledger( now )),   -- 0.3: what came and what it cost
		"save_why", R.save and R.save_why or "-", "unit_skip", R.n_unit_skip, "dir_goal", R.n_dir_goal or 0, "dir_unit", R.n_dir_unit, "dir_lost", R.n_dir_lost)
end
-- 0.2 (TECH_RU.md 12) THE DIRECTOR'S SQUADS. The engine's list of squads to reinforce (AIProduction_AnyReinforcementsNeeded,
-- GetReinforcementSquad*) is filled by a squad's own AI task: AITaskCombatState::Enter_Reinforce -> AISquad::RequestReinforce ->
-- AIProductionManager::RegisterForReinforcements (the symbols of the Mac build, decompiled). A squad the director moves has no
-- combat task (strategy_military.execute kills them for a directed AI), so it never gets on that list: only the squads in
-- Elite's capture tasks were ever reinforced. s15: 6-7 of the 8 tyranid squads were the director's all match - 28 models
-- lost, 1 request (s14: 22 requests with half the squads in capture tasks; IG 15 against 25).
-- Now the director asks for the model itself: a squad of its army that stands at home (within Reinf_HomeR of our HQ, main.ai)
-- with fewer models than the most seen in a squad of its blueprint gets one reinforce order per director tick, through the DLL
-- queue to the SCAR side (mode 6: Command_Squad(player, sgroup, SCMD_ReinforceUnit, false) - the command of the player's
-- button; the engine checks the reach of a reinforce point and takes the money). This function is the purse: true = order.
-- Not below the tech plan's reserve; within Reinf_DirShare (0.5) of the req income per minute - the arbiter's share
-- (Reinf_Share 0.2 / 0.35 / 0.5) while the save state is on - counted with Elite's own requests in one ledger; never more
-- orders than models missing nor more than Reinf_DirAhead (2) ahead of the models that came; Reinf_DirTries (2) orders and
-- no model more Reinf_DirWait (20 s) after the first = none for that
-- squad for Reinf_DirMute (60 s; "REINF dir no effect": out of reach of a reinforce point, or the command does not take).
-- Returns order (true/false), busy (models are on their way or an order went: the director keeps the squad at home).
-- Numbers per squad id between ticks (EliteAI_R.dir); the AISquad is the caller's, of this tick. Reinf_Dir=0 = off.
-- 0.3 (TECH_RU.md 13): returns n, busy, why - n = how many models to order this tick (0 = none; up to Reinf_DirBatch 3 when the
-- money is there: scene b - one order per tick, 6 models took 33 s), busy as before, why = full | ordered | unit | save | poor |
-- cap | mute | order. The unit first: while the plan's unit is within reach (r_claim) or the save state is on, only a weak
-- squad (models <= Reinf_LowHp of a full one) is refilled; a weak squad is not held by the share of the income either (it is
-- useless as it stands, and a model is the cheapest army there is) - the money and the tech plan's reserve are its bounds.
-- The cap reads what was paid in the last minute (the models that came) + what is ordered and on its way. Orders that brought
-- no model for Reinf_DirLost (0.4: 15 s, counted from the moment the squad stands) are written off and may be ordered again ("dir_lost").
-- 0.4 (TECH_RU.md 14): * "moving" (main.ai: the squad is not standing yet - it still runs home): the clocks of "nothing came"
-- (Reinf_DirLost, the "no effect" check) start when it stands, not with the order. s17: 50005 was ordered 3 models on its way
-- in, 10 s later they were written off and ordered again, the first came 15 s after the order - 6 clicks, 6 models, "dir_lost 3".
-- Reinf_DirLost is 15 s (was 10). * A squad above half while a unit is waited for (save / within reach): no longer "none" but
-- within the arbiter's share of the income (Reinf_Share 0.2 / 0.35 / 0.5 - s17: IG "dir_unit", a 6 of 9 squad stood at home
-- unfilled; a model is half the price of the same model in a new squad); a unit that has its money keeps it whole as before.
-- Reinf_DirHeld=1 = as 0.3. * A weak squad while a unit is waited for: Reinf_WeakShare (0.6) of the income (was: no bound -
-- s17 145-182 req a minute at an income of 235). * A model dearer than the minute's share: one when nothing was paid for a minute.
-- 0.7 (TECH_RU.md 20.4) THE GOAL OF A REFILL. Until now a squad at home was refilled to the last model whatever it was for;
-- the tyranids of Malum's match (fb 581) paid 2856 req for 131 models against 4340 for 14 units. Orca (fb 557): "do not refill
-- the side cappers to a full squad; late, without the map and the income, do not reinforce the squads that bleed". A squad is
-- refilled to its GOAL, and the goal is by what the squad is worth to us:
--  * a runner / a squad that takes the army's goal points (mechanics.ai EliteAI_MechRole; also Reinf_RoleSecs after it was one)
--    - Reinf_RunnerFill (0.6) of a full squad, two models at least: it walks between points, it does not hold a line;
--  * POOR TIMES - later than Reinf_LateSecs (600 s) and the req income below Reinf_PoorRate (190 a minute: the upkeep of what
--    we have eats it) or less than Reinf_PoorPts (0.25) of the map ours:
--      a squad that BLEEDS (lost Reinf_BleedK 0.5 of a full squad within Reinf_BleedSecs 150 s - main.ai counts the falls) -
--      Reinf_BleedFill (0.5): the models would be dead before they pay back;
--      an expendable brood or a T1 blueprint when we stand on T2+ - Reinf_PoorFill (0.75);
--    the blueprints of the later tiers are refilled to the last model (a model of theirs is the cheapest fire we can buy).
-- The quiet trip home (EliteAI_ReinforceCan) knows the same goal - a squad at its goal does not walk home for more.
-- Lines "REINF dir goal <id> <unit> models A of B goal G why runner|capper|bleeds|poor ...". Reinf_Goal=0 = to the last model.
-- STEP 5 (REINF 0.8; VANILLA_BASE_RU.md 15.4 / 16.3): "poor" reads what the bank really gets - the rate x the factor the script
-- measures itself (EliteAI_IncomeK below: 1.30 +- 0.05 on the computer slots of the stand in every mode, 1.0 on the local
-- slot). Reinf_PoorRate (190 a minute) was set where the two were the same; on a computer slot a player with a rate of
-- 150-185 (a real 195-240) counted as poor and thinned its T1 squads and the ones that bleed. Reinf_PoorIncomeK=0 = the rate.
local function r_poor( now )
	if now < eai_num("Reinf_LateSecs", 600) then return false end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	if eai_num("Reinf_PoorIncomeK", 1) >= 1 and type(EliteAI_IncomeK) == "function" then
		local _, kr = EliteAI_IncomeK()
		rate = rate * (kr or 1)
	end
	local pct = cache.percentage_pts_captured or 1                          -- cache.ai:126
	return rate < eai_num("Reinf_PoorRate", 190) or pct < eai_num("Reinf_PoorPts", 0.25)
end
EliteAI_ReinforcePoor = r_poor                                              -- the stub run
local function r_goal( id, key, name, count, full, now )
	if eai_num("Reinf_Goal", 1) < 1 or full < 3 or id == nil then return full, "-" end
	local goal, why = full, "-"
	local role = (type(EliteAI_MechRole) == "function") and EliteAI_MechRole( id ) or nil
	if role ~= nil then goal, why = math.max(2, math.ceil(full * eai_num("Reinf_RunnerFill", 0.6))), role end
	if r_poor( now ) then
		local lost = (type(EliteAI_LossRecent) == "function") and EliteAI_LossRecent( id, eai_num("Reinf_BleedSecs", 150) ) or 0
		local lvl = (cache and cache.tech_tier_level) or 1
		local g, w = nil, nil
		if lost >= full * eai_num("Reinf_BleedK", 0.5) then g, w = math.ceil(full * eai_num("Reinf_BleedFill", 0.5)), "bleeds"
		elseif r_exp( key ) or (lvl >= 2 and (EliteAI_P.tier_seen[name] or 1) < 2) then g, w = math.ceil(full * eai_num("Reinf_PoorFill", 0.75)), "poor" end
		if g ~= nil and math.max(2, g) < goal then goal, why = math.max(2, g), w end
	end
	-- STEP 3 (0.13): the swap at the population cap - a T1 squad is refilled to Swap_Fill only (EliteAI_PopSwap below)
	if EliteAI_PopSwap ~= nil and EliteAI_PopSwap() and EliteAI_SwapWeak( name ) then
		local g = math.max(2, math.ceil(full * EliteAI_SwapFill()))
		if g < goal then goal, why = g, "swap" end
	end
	return goal, why
end
EliteAI_ReinforceGoal = r_goal                                              -- the stub run
function EliteAI_ReinforceDir( aisq, id, count, now, moving )
	if not s_on() or aisq == nil or id == nil or cache == nil or cache.resources == nil or eai_num("Reinf_Dir", 1) < 1 then return 0, false, "off" end
	local R = EliteAI_R
	local pbg = AISquad_ConvertToPBG( aisq )                                 -- r_scan above; strategy_addon.ai:188
	if pbg == nil then return 0, false, "off" end
	local key = r_key(PBG_GetName( pbg ))
	local full = R.maxc[key] or 0                                           -- the most models seen in one squad of this blueprint (r_scan)
	local d = R.dir[id]
	if count >= full then R.dir[id] = nil; return 0, false, "full" end      -- complete (heroes, vehicles: always)
	if d ~= nil and now - d.last > eai_num("Reinf_DirGap", 30) then d = nil end   -- it was away: a new stay at home
	if d == nil then d = { n0 = count, sent = 0, tot = 0, t0 = now, last = now, prog = now, mute = -1 }; R.dir[id] = d end
	if count > (d.have or count) then d.prog = now end                      -- a model came
	d.have = count                                                          -- (r_pending reads it)
	if moving then                                                          -- 0.4: not at the reinforce point yet - nothing can have come
		d.prog = now
		if count <= d.n0 then d.t0 = now end
	end
	if now < d.mute then return 0, false, "mute" end
	local tries = math.min(eai_num("Reinf_DirTries", 2), full - d.n0)       -- (one model missing: one order is all there is to try)
	if d.tot >= tries and d.tot > 0 and count <= d.n0 and now - d.t0 >= eai_num("Reinf_DirWait", 20) then
		d.mute, d.sent, d.tot, d.t0, d.last = now + eai_num("Reinf_DirMute", 60), 0, 0, now, now
		R.n_dir_mute = R.n_dir_mute + 1
		eai_log("REINF", "dir", "no effect", tostring(id), r_short(key), "models", count, "of", full, "after", tries, "orders in",
			eai_num("Reinf_DirWait", 20), "s: none for", eai_num("Reinf_DirMute", 60), "s (out of reach of a reinforce point?)")
		return 0, false, "mute"
	end
	local coming = d.sent - math.max(0, count - d.n0)                      -- ordered and not there yet
	if coming < 0 then coming = 0 end
	if coming > 0 and now - d.prog >= eai_num("Reinf_DirLost", 15) then     -- the engine did not take them (no money at that moment, a command dropped)
		d.sent, d.prog = d.sent - coming, now
		R.n_dir_lost = R.n_dir_lost + coming
		coming = 0
	end
	local left = (full - count) - coming                                   -- models neither here nor on their way
	local room = math.floor(eai_num("Reinf_DirAhead", 3)) - coming          -- never more than this many ahead of the arrivals
	if left <= 0 or room <= 0 then d.last = now; return 0, (coming > 0), "ordered" end
	local goal, gwhy = r_goal( id, key, string.lower(PBG_GetName( pbg ) or ""), count, full, now )   -- 0.7: what this squad is refilled to
	if goal < full then
		if count + coming >= goal then
			R.n_dir_goal = (R.n_dir_goal or 0) + 1
			local sk = "goal:" .. key .. ":" .. tostring(gwhy)
			if R.said[sk] == nil or now - R.said[sk] >= eai_num("Reinf_LogSecs", 30) then
				R.said[sk] = now
				eai_log("REINF", "dir", "goal", tostring(id), r_short(key), "models", count, "of", full, "goal", goal, "why", gwhy, "none:",
					"lost", (type(EliteAI_LossRecent) == "function") and EliteAI_LossRecent( id, eai_num("Reinf_BleedSecs", 150) ) or 0, "in", eai_num("Reinf_BleedSecs", 150), "s",
					"rate", s_rp(cache.resources_rate), "bank", s_rp(cache.resources), "held", R.n_dir_goal)
			end
			d.last = now
			return 0, (coming > 0), "goal"
		end
		left = math.min(left, goal - count - coming)
	end
	local weak = (count <= full * eai_num("Reinf_LowHp", 0.5))
	local st0 = EliteAI_E and EliteAI_E.stall                               -- 0.6: a unit of the plan waits (the units budget's stall record, at most two ticks old)
	local exp = (st0 ~= nil and now - (st0.t or -1000) <= 7 and st0.why ~= "ready" and r_exp( key ))
	if exp then weak = false end                                            -- an expendable brood is no "weak" squad while a unit waits
	local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )   -- AccumulateReinforceDemand below (Elite's)
	local pr, pp = (per and per.requisition) or 0, (per and per.power) or 0
	d.per = pr
	local bank = cache.resources
	local rr, rp = 0, 0
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	local same = (R.dir_now == now)                                         -- the orders of this director tick (the bank is the cache's)
	local used, used_p = same and R.dir_used or 0, same and (R.dir_used_p or 0) or 0
	local quick, st = r_claim( now )
	local exp_room = nil
	if exp then
		local ewhy
		exp_room, ewhy = r_exp_room( now, st0, pr, used )
		if exp_room < 1 then
			R.n_exp = (R.n_exp or 0) + 1
			local sk = "expd:" .. key
			if R.said[sk] == nil or now - R.said[sk] >= eai_num("Reinf_LogSecs", 30) then
				R.said[sk] = now
				eai_log("REINF", "dir", "expendable", tostring(id), r_short(key), "models", count, "of", full, "none:", ewhy == "share" and "over its share of the income," or "the unit first,",
					tostring(st0.name), tostring(st0.req) .. "/" .. tostring(st0.pow), tostring(st0.why), "eta", math.floor(st0.eta or 0), "bank", s_rp(bank), "per", math.floor(pr),
					"exp60", math.floor(r_exp60( now )), "held", R.n_exp)
			end
			return 0, (coming > 0), "expendable"
		end
	end
	-- the unit first: one that has its money and a free HQ is bought before any model; one that has its money and waits for the
	-- HQ keeps it whole (what lies beyond it is free); for one that is short of money a squad above half gets its models within
	-- the arbiter's share of the income (0.4; was: none)
	local ready = (st ~= nil and st.why == "ready")
	local held = (R.save or quick) and not weak
	local spare, capped = nil, false
	if held and st ~= nil and st.why == "channel" and pr > 0 then
		spare = math.floor(((bank.requisition or 0) - (rr or 0) - used - (st.req or 0)) / pr)
	end
	local wait = ready
	if held and not ready then
		if spare ~= nil then wait = (spare < 1)
		elseif eai_num("Reinf_DirHeld", 0) >= 1 then wait = true
		else capped = true end
	end
	-- 0.7 (TECH_RU.md 18.4; s21, tyranids: no unit 7:39-12:00, the genestealer 350/45 was 11 s away at 10:17 with 302 req when three
	-- hormagaunts were ordered - bank 220 - and so on: five orders, 294 req, in that gap, each inside its share of the income). In a
	-- DROUGHT (EliteAI_E.dry: no unit bought for Spend_DroughtSecs while one waits) the unit is first for the refills too: a
	-- squad above half gets models only from the req that lies beyond the unit's price, a weak squad within Reinf_DroughtShare
	-- (0.25) of the income instead of Reinf_WeakShare (0.6). The drought ends with the unit. Reinf_DirDrought=0 = as 0.6.
	local dry = (st ~= nil and EliteAI_E ~= nil and EliteAI_E.dry == true and eai_num("Reinf_DirDrought", 1) >= 1)
	local beyond = nil
	if dry and not wait and pr > 0 then
		beyond = math.floor(((bank.requisition or 0) - (rr or 0) - used - (st.req or 0)) / pr)
		if not weak and beyond < 1 then
			R.n_dir_dry = (R.n_dir_dry or 0) + 1
			local sk = "dry:" .. key
			if R.said[sk] == nil or now - R.said[sk] >= eai_num("Reinf_LogSecs", 30) then
				R.said[sk] = now
				eai_log("REINF", "dir", "drought", tostring(id), r_short(key), "models", count, "of", full, "none: no unit for", math.floor(EliteAI_E.dry_for or 0), "s,",
					tostring(st.name), st.req .. "/" .. st.pow, "first", "bank", s_rp(bank), "per", math.floor(pr) .. "/" .. math.floor(pp), "held", R.n_dir_dry)
			end
			return 0, (coming > 0), "drought"
		end
	end
	if wait then
		R.n_dir_unit = R.n_dir_unit + 1
		return 0, (coming > 0), R.save and "save" or "unit"
	end
	local k = math.min(left, room, math.max(1, math.floor(eai_num("Reinf_DirBatch", 3))))
	if spare ~= nil then k = math.min(k, spare) end
	if beyond ~= nil and not weak then k = math.min(k, beyond) end           -- 0.7: a drought - only the req beyond the unit's price
	if exp_room ~= nil then k = math.min(k, exp_room) end                    -- 0.6: an expendable brood - beyond the unit's price and within its share
	if pr > 0 then k = math.min(k, math.floor(((bank.requisition or 0) - (rr or 0) - used) / pr)) end
	if pp > 0 then k = math.min(k, math.floor(((bank.power or 0) - (rp or 0) - used_p) / pp)) end
	if k < 1 then
		R.n_dir_poor = R.n_dir_poor + 1
		return 0, (coming > 0), "poor"
	end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0   -- per minute (cache.ai:156)
	local share = nil                                                       -- nil = no bound but the money
	if capped then share = r_share()
	elseif weak then
		if R.save or quick then share = eai_num("Reinf_WeakShare", 0.6) end -- 0.4: while a unit is waited for the weak squads leave it 40 % of the income
		if dry then share = math.min(share or 1, eai_num("Reinf_DroughtShare", 0.25)) end   -- 0.7: in a drought - a quarter
	else share = R.save and r_share() or eai_num("Reinf_DirShare", 0.5) end
	local spent = r_ledger( now ) + r_pending( now )                        -- paid (the models that came) + ordered and on their way
	if share ~= nil and rate > 0 and pr > 0 then
		local fit = math.floor((rate * share - spent) / pr)
		if fit < 1 and spent <= 0 then fit = 1 end                          -- 0.4: a model dearer than the minute's share - one when nothing was paid for a minute
		k = math.min(k, fit)
		if k < 1 then
			R.n_dir_cap = R.n_dir_cap + 1
			if capped then R.n_dir_unit = R.n_dir_unit + 1 end
			return 0, (coming > 0), "cap"
		end
	end
	if coming == 0 then d.prog = now end                                    -- the clock of "nothing came" starts with the first order on its way
	d.sent, d.tot, d.last = d.sent + k, d.tot + k, now
	R.n_dir, R.dir_now, R.dir_used, R.dir_used_p = R.n_dir + k, now, used + pr * k, used_p + pp * k   -- (the book notes a model when it comes: r_models)
	local sk = "dir:" .. key
	local last = R.said[sk]
	if last == nil or now - last >= eai_num("Reinf_LogSecs", 30) then
		R.said[sk] = now
		eai_log("REINF", "dir", "order", tostring(id), r_short(key), "models", count, "of", full, "x" .. k, "per", math.floor(pr) .. "/" .. math.floor(pp),
			"bank", s_rp(bank), "spent60", math.floor(spent), "cap", share and math.floor(rate * share) or -1, weak and "weak" or (capped and "share" or (R.save and "save" or "-")), "orders", R.n_dir,
			dry and "drought" or "")
	end
	if type(EliteAI_EnergyPay) == "function" then EliteAI_EnergyPay( "reinf_dir", pr * k, pp * k ) end   -- 0.7: paid now, booked when the models come
	if r_exp( key ) then r_exp_note( now, pr * k ) end                       -- 0.6: the expendables' minute
	return k, true, "order"
end
-- 0.4 main.ai (the refill trip of a weak squad, out of a fight): how many models the purse would pay this squad now if it stood
-- at home - the bank beyond the tech plan's reserve, never more than it misses; 0 = none. No order, no state.
function EliteAI_ReinforceCan( aisq, count, id )
	if not s_on() or aisq == nil or cache == nil or cache.resources == nil or eai_num("Reinf_Dir", 1) < 1 then return 0 end
	local pbg = AISquad_ConvertToPBG( aisq )
	if pbg == nil then return 0 end
	local full = EliteAI_R.maxc[r_key(PBG_GetName( pbg ))] or 0
	if count >= full then return 0 end
	if id ~= nil then                                                       -- 0.7: no trip home for more than its goal
		full = r_goal( id, r_key(PBG_GetName( pbg )), string.lower(PBG_GetName( pbg ) or ""), count, full, World_GetGameTime() )
		if count >= full then return 0 end
	end
	local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
	local pr, pp = (per and per.requisition) or 0, (per and per.power) or 0
	local rr, rp = 0, 0
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	local bank = cache.resources
	local k = full - count
	if pr > 0 then k = math.min(k, math.floor(((bank.requisition or 0) - (rr or 0)) / pr)) end
	if pp > 0 then k = math.min(k, math.floor(((bank.power or 0) - (rp or 0)) / pp)) end
	if k < 0 then k = 0 end
	return k
end
-- the most models seen in one squad of this squad's blueprint (0 = unknown yet): the director's "is it worth going home for" check
function EliteAI_ReinforceFull( aisq )
	if not s_on() or aisq == nil then return 0 end
	local pbg = AISquad_ConvertToPBG( aisq )
	if pbg == nil then return 0 end
	return EliteAI_R.maxc[r_key(PBG_GetName( pbg ))] or 0
end
local function r_init_log()
	r_reset()
	eai_log("REINF", "init", "version", EliteAI_REINF_VERSION, "rule", r_rule(), "bank_pow", eai_num("Reinf_BankPow", eai_num("Spend_BankPow", 300)),
		"exit_k", eai_num("Reinf_ExitK", 0.5), "low_hp", eai_num("Reinf_LowHp", 0.5), "full_hp", eai_num("Reinf_FullHp", 0.8), "share", r_share(),
		"save_spawn_mult", eai_num("Reinf_SaveSpawnMult", 0.4), "pause", eai_num("Reinf_PauseSecs", 45), "save_max", eai_num("Reinf_SaveMax", 240),
		"req_margin", eai_num("Reinf_ReqMargin", 200), "need_max", eai_num("Reinf_NeedMax", 600), "conf_hold", eai_num("Reinf_ConfHold", 10),
		"scan", eai_num("Reinf_ScanSecs", 6), "pow_unit", eai_num("Spend_PowUnit", 40),
		"unit_first", eai_num("Reinf_UnitFirst", 1), "unit_eta", eai_num("Reinf_UnitEta", 45), "wait", eai_num("Reinf_WaitSecs", 45),
		"dir_batch", eai_num("Reinf_DirBatch", 3), "dir_share", eai_num("Reinf_DirShare", 0.5))
end
EliteAI_ReinforceInit = r_init_log

-------------------------------------------------------------------------------------------------
-- EliteAI 11.11 (energy): power in excess, req short (the scene polygon, reports/polygon_1111: IG T2 with 400 req / 1000 power
-- bought one ogryn in 120 s, the power stayed at 900+; the req trickled into squad upgrades that cost no power - sergeants,
-- 75 req each - as soon as it reached 75, so the 300 req of the unit the "save" state waited for never came; tyranids: a
-- genestealer and ~410 req of upgrades in the first 10 s, then "none poor" for 80 s). New logic only (EliteAI.on).
-- WHY the old blocks could not see it: squad upgrades are bought by BUDGET_AddOn in the OTHER budget run (default.ai:335-344:
-- do_purchases(false) = AddOn/Secure/ResourceAddOn, then do_purchases(true) = Units/Tech/abilities). A budget's total only
-- orders the budgets inside one run (util/budget.ai:297-361), so whatever the units side waits for - the unit Elite stalls on,
-- the tech plan's reserve, the "save" state - the addon run sees the whole bank every 3 s and takes the req from under it.
-- WHAT:
--  * the float state (EliteAI_EnergyFloat, hysteresis Energy_Hold): on when the power bank >= Energy_FloatPow and >=
--    Energy_FloatRatio x the req bank; off below Energy_ExitK of either. Log "ENERGY float on|off ...".
--  * while floating, the req goes where the power goes: units get x (1 + Energy_ShareK x share), share = power / (req + power)
--    of the cost (EliteAI_PurchaseMult); squad upgrades with a share >= Energy_AddonMinShare get x (1 + Energy_AddonShareK x
--    share), the ones below it x Energy_AddonLowMult and, while the "save" state saves for a power unit, nothing at all
--    ("low_pow_save"); CalcSquadUpgradeDemand is floored (Spend_AddonFloor) so the upgrades the engine rates low are
--    candidates too; no new generators (ResourceStructureDemand is skipped: "ENERGY gen hold"); the tech plan of
--    strategy_tech_purchase.ai wants the next tier at once (reason "float": the research is 300 req for 125-150 power, the
--    best power sink there is, and it opens the units that use power).
--  * the reserves the addon run now respects: the tech plan's reserve (EliteAI_TechReserve: an upgrade may not take the req
--    bank below it - "tech_reserve") and the next unit - the arbiter Conf_AddonVsUnit (A/B/C = 1/2/3): when the spawn Elite
--    chose is short of money (or has the money and waits for the busy HQ) and its ETA at the current income is within
--    Spend_UnitFirstEta (1: 60 s, 2: 40 s), an upgrade may not take the req bank below that unit's cost ("unit_first") for at
--    most Spend_UnitFirstMax (75 / 45 s), then the upgrades get a window of Spend_UnitFirstPause (20 / 30 s); 3 = as Elite
--    (no waiting). With a bank that pays both, nothing waits. Hysteresis Reinf_ConfHold; log "ENERGY Conf_AddonVsUnit bank
--    addons->unit ...". This is the "minimal reserve for the key purchase": bounded in time, only for a unit within reach.
--  * "save" by the income (r_need above): a power unit is saved for only when its ETA is within Energy_EtaMax (120 s);
--    when none is, nothing is held for it (REINF "need none ...", the watchdog's pmin and the low-power damping are off).
--  * the Garrison pattern of mod/mechanics.ai (EliteAI.gar): once an enemy squad has held a building next to our point for
--    Gar_BuySecs, the counter units of reports/tactics_kb/kb.yaml (threats.garrisoned_enemy) get x Gar_BuyMult (x
--    Gar_BuyMultHave when we have one) and flamer / grenade upgrades x Gar_AddonMult (they also pass the waits above).
--    Log "GAR demand <sbps> x2.5 garrison <id> held N s ...".
--  * the book: every purchase the scripts place is noted by kind (unit, addon, reinf, tech, gen, secure, abil) - "buy_addon <t>
--    <upgrade> req/pow" per upgrade (they were invisible in the log) and "ENERGY stats ... spent60 ..." once a minute.
-- 0.2 (11.11, after the verification of newai-10 - TECH_RU.md 10.10 / 11):
--  * WHO HELD THE REQ. (1) BUDGET_Secure (the power node on a captured point, 125 req): its request is a task, and a task's cost is
--    taken off what every budget may spend from the moment it is placed (util/budget.ai:271 Task_CountCost). A request nobody
--    executes is killed as inactive at the next tick (default.ai:249) and placed again: s14 - 115 / 137 requests in 817 s, 2-18 a
--    minute, i.e. 125-375 req out of reach of the units and the research for half the match; scene r2: bank 375-402, devils 350
--    not bought for 11 s, then the node took 125. Now: one request at a time (Energy_SecureMax), Energy_SecureTries (2) requests
--    killed in a row = no request for Energy_SecureMute (60 s), none while the power floats (Energy_SecureHold, as the
--    generators), and neither Secure nor the generators may take the bank below the tech plan's reserve or the unit the upgrades
--    wait for (e_reserved; "ENERGY reserve skip ..."). (2) The order of the budgets inside a run: whoever is first locks its
--    cost. The units budget now takes the tech plan's reserve off itself whatever the order and, while the plan holds it,
--    locks nothing for a unit it is short of money for (do_purchase). (3) Elite's rule "one request per producer": while a unit
--    is produced (28-37 s) or the tier research runs in the HQ, the next spawn is not requested - the line "SPEND stall <unit>
--    why channel|money avail .. bank .. tasks .. queue N" now names which of the two it is, at most once per Spend_StallLog.
--  * Conf_AddonVsUnit had the 10 s of Reinf_ConfHold and one threshold: 31-34 switches a match, three in 20-30 s in four scenes.
--    Now a switch holds Spend_UnitFirstHold (20 s: two in 30 s at most), the unit is dropped only beyond Spend_UnitFirstOffK
--    (1.5) x the ETA that takes it, "the unit was bought" is no switch (the decision stays, nothing is reserved while no unit
--    waits; back to "addons" after Spend_UnitFirstIdle 20 s without one), the ETA is by what the units budget really has, and
--    the wait clock (Spend_UnitFirstMax) counts only the seconds a unit was short of money (not those it had the money and
--    waited for the HQ - scene r2: the window for the upgrades opened the moment the HQ got free).
--  * the book: "secure" is noted when the request survived to the next tick or a point became secured, not on every request
--    (it read "secure 137x 19125" - more than the whole income); the requests are counted apart (stats: secure_req / dead / hold).
-- SAFETY: numbers and strings between ticks only (EliteAI_E); PBGs are read within the tick; no pcall around engine calls; no
-- randomness; engine functions are the ones Elite's scripts call (file:line in reports/newai_1110/TECH_RU.md sections 10, 11).
EliteAI_ENERGY_VERSION = "0.18"
EliteAI_E = {}
local function e_reset()
	EliteAI_E = { float = false, float_t = -1, sw_t = -1000, said = {}, stall = nil, hold = false, hold_t = -1000, hold_sw = -1000, hold_pause = -1,
		led = {}, tot = {}, n_addon = 0, n_addon_skip = 0, n_addon_boost = 0, n_gen_skip = 0, n_gar = 0, last_stats = 0, gar_on = false,
		hold_req = 0, idle_t = -1000, n_hold_sw = 0, n_res_skip = 0,          -- 0.2: the arbiter's reserve; purchases of the other run held back by a reserve
		areq = {}, adead = {}, amute = {}, abought = {}, n_addon_req = 0, n_addon_dead = 0,   -- 0.3: upgrade requests waiting for their verdict (names, numbers)
		cap_t = -1, cap = nil, cap_why = "-", n_share_skip = 0, n_hold_keep = 0,              -- 0.3: the army's share
		gen_t = nil, gen_req = 0, gen_pow = 0, gen_n = 0, gen_dead = 0, gen_mute = -1, n_gen_req = 0, n_gen_dead = 0,   -- 0.4: BUDGET_ResourceAddOn
		sec_t = nil, sec_req = 0, sec_pow = 0, sec_n = 0, sec_dead = 0, sec_mute = -1, n_sec_req = 0, n_sec_dead = 0, n_sec_hold = 0,   -- 0.2: BUDGET_Secure
		ureq = {}, udead = {}, udead_t = {}, umute = {}, upause = -1, gdead = 0, n_unit_req = 0, n_unit_dead = 0, n_unit_notnow = 0, n_unit_mute = 0 }   -- 0.9: spawn requests waiting for their verdict (names, numbers)
end
e_reset()
local GAR_COUNTER_UNITS = { "ig_devils", "ig_kasrkin_squad", "ig_banewolf", "sm_scout_marine", "sm_tactical_marine", "eld_fire_dragon", "eld_guardian",
	"ork_stikkbommas", "csm_cultist", "csm_noise_marines", "gk_purgation_squad", "tau_vespid_squad" }   -- kb.yaml garrisoned_enemy (tyranids: no buildable counter)
local GAR_ADDON_KEYS = { "flamer", "flame", "grenade", "burna", "incinerat", "battle_equipment" }
-- 0.6: who answers set-up teams (kb.yaml threats.suppression_spam.responses + units.*.counters setup_team), by the end of the sbps name
local SETUP_COUNTER_UNITS = { "sm_assault_marine", "sm_scout_marine", "sm_devastator_plasma_cannon", "sm_whirlwind",
	"ig_devils", "ig_manticore", "eld_ranger", "eld_banshee", "eld_warp_spider", "ork_stormboy", "ork_stikkbommas", "ork_kommandos",
	"tyr_ravener", "tyr_lictor", "tyr_tyrant_guard", "csm_raptor", "csm_noise_marines", "gk_interceptor_squad", "gk_operatives", "tau_vespid_squad", "tau_stealth_suits" }
local function e_ends(name, key)
	local n, k = string.len(name), string.len(key)
	return n >= k and string.sub(name, n - k + 1) == key
end
local function e_has(name, keys)
	for _, k in ipairs(keys) do if string.find(name, k, 1, true) then return true end end
	return false
end
local function e_say(key, secs, ...)                                       -- a line at most once per `secs` per key
	local E, now = EliteAI_E, World_GetGameTime()
	local last = E.said[key]
	if last ~= nil and now - last < secs then return end
	E.said[key] = now
	eai_log(...)
end
local function e_share(cost)                                               -- the power share of a cost
	local r, p = (cost and cost.requisition) or 0, (cost and cost.power) or 0
	if r + p <= 0 then return 0 end
	return p / (r + p)
end
-- the float state, evaluated at most once per game time value (the tech plan asks first in a tick, strategy_tech_purchase.ai)
function EliteAI_EnergyFloat()
	if not s_on() or cache == nil or cache.resources == nil then return false end
	local E, now = EliteAI_E, World_GetGameTime()
	if E.float_t == now then return E.float end
	E.float_t = now
	local req, pow = cache.resources.requisition or 0, cache.resources.power or 0
	local fp, fr, xk = eai_num("Energy_FloatPow", eai_num("Spend_BankPow", 300)), eai_num("Energy_FloatRatio", 1.5), eai_num("Energy_ExitK", 0.6)
	local want = E.float
	if E.float then
		if pow < fp * xk or pow < req * fr * xk then want = false end
	elseif pow >= fp and pow >= req * fr then
		want = true
	end
	if want ~= E.float and now - E.sw_t >= eai_num("Energy_Hold", 10) then
		E.float, E.sw_t = want, now
		eai_log("ENERGY", "float", want and "on" or "off", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate),
			"need", string.format("pow>=%d and pow>=%.1fxreq", fp, fr))
	end
	return E.float
end
-- the book of purchases by kind (numbers only): the last 60 s and the totals of the match
-- 0.4 (TECH_RU.md 13): every kind is noted when it was PAID, not when it was asked for - "reinf" by the models that came
-- (r_models; n = how many), "gen" by the request that survived or the generator that stands (e_gen_gate), as "addon" and
-- "secure" before. s16: "reinf 88x 2278" (tyranids, more than they could have paid) and "gen 28x 2800" (IG, 13 a minute)
-- were requests; the army's share of the upgrades was worked out from them (addon_share 0.19 with ~0.27 really paid).
function EliteAI_EnergyNote( kind, cost, n, nopay )
	if not s_on() or cost == nil then return end
	local E = EliteAI_E
	local r, p = cost.requisition or 0, cost.power or 0
	table.insert(E.led, { t = World_GetGameTime(), k = kind, r = r, p = p })
	-- (booked when asked for; 0.9: a unit is booked when its request is confirmed, the "asked" half was written at the request - nopay)
	if not nopay and (kind == "unit" or kind == "tech" or kind == "abil" or kind == "revive") then EliteAI_EnergyPay( kind, r, p ) end
	local tt = E.tot[kind]
	if not tt then tt = { n = 0, r = 0, p = 0 }; E.tot[kind] = tt end
	tt.n, tt.r, tt.p = tt.n + (n or 1), tt.r + r, tt.p + p
end
local E_KINDS = { "unit", "addon", "reinf", "tech", "gen", "secure", "abil", "revive" }
-- 0.7 (TECH_RU.md 18.4): WHAT WAS ASKED FOR, when - the other half of the book. The book notes a purchase when it is known to be
-- paid (a model that came, a generator that stands) or when it was asked for (a unit, a research, a call-in); the engine takes
-- the money at its own moment. s21: of five "SPEND unbooked" lines of the tyranids two were purchases that ARE in the book - the
-- T2 research (asked at 362 s, paid at 365: outside the window it was booked in) and the call-in - and two were the
-- director's refills (paid at the order, booked on arrival - or never, "nothing came"). So every request leaves an entry here
-- { time, kind, req, pow } (EliteAI_EnergyPay), and two things read it: the meter below counts what was asked for up to
-- Spend_LeakLag before its window, and the tracer names every single fall of the bank no request explains.
function EliteAI_EnergyPay( kind, r, p )
	if not s_on() then return end
	local E = EliteAI_E
	E.pay = E.pay or {}
	table.insert(E.pay, { t = World_GetGameTime(), k = kind, r = r or 0, p = p or 0 })
end
local function e_book( now )
	local E, keep, sum = EliteAI_E, {}, {}
	for _, e in ipairs(E.led) do
		if now - e.t < 60 then
			table.insert(keep, e)
			local s = sum[e.k]
			if not s then s = { r = 0, p = 0 }; sum[e.k] = s end
			s.r, s.p = s.r + e.r, s.p + e.p
		end
	end
	E.led = keep
	local a, b = {}, {}
	for _, k in ipairs(E_KINDS) do
		local s, tt = sum[k], E.tot[k]
		if s then table.insert(a, string.format("%s %d/%d", k, s.r, s.p)) end
		if tt then table.insert(b, string.format("%s %dx %d/%d", k, tt.n, tt.r, tt.p)) end
	end
	return table.concat(a, ", "), table.concat(b, ", ")
end
-- the Garrison pattern has lasted long enough to buy against it: true, seconds held
local function e_gar_active( now )
	local g = EliteAI and EliteAI.gar
	if type(g) ~= "table" or g.t0 == nil then return false, 0 end
	local held = now - g.t0
	return held >= eai_num("Gar_BuySecs", 25), held
end
-- multiplier of a buildable squad's demand while a garrison holds (EliteAI_PurchaseMult; the watchdog's candidates too)
function EliteAI_GarMult( name, curAmount )
	if not s_on() then return 1 end
	local on, held = e_gar_active( World_GetGameTime() )
	if not on then return 1 end
	for _, k in ipairs(GAR_COUNTER_UNITS) do
		if e_ends(name, k) then
			local m = ((curAmount or 0) == 0) and eai_num("Gar_BuyMult", 2.5) or eai_num("Gar_BuyMultHave", 1.3)
			EliteAI_E.n_gar = EliteAI_E.n_gar + 1
			e_say("gar|" .. k, eai_num("Gar_LogSecs", 30), "GAR", "demand", r_short(name), "x" .. tostring(m), "garrison", tostring(EliteAI.gar.id),
				"held", math.floor(held), "s", "decision", tostring(EliteAI.gar.v), "have", curAmount or 0)
			return m
		end
	end
	return 1
end
-- 0.6 (TECH_RU.md 15.9; Orca, fb 511: "it does not use its anti-set-up squads") THE ENEMY'S SET-UP TEAMS. mod/mechanics.ai counts the
-- enemy squads that set a heavy weapon up (EliteAI.setup = { n, t0, t }, numbers; there from SetupBuyMin = 2 teams on). While it
-- has stood for Setup_BuySecs (20 s) and is fresh (30 s), the race's answers - reports/tactics_kb/kb.yaml threats.suppression_spam
-- .responses and the units whose "counters" name setup_team: jump squads, grenades, snipers, artillery (SETUP_COUNTER_UNITS, by
-- the end of the sbps name; the squads Elite's own gates drop - spotters, spore mines - stay dropped) - get x Setup_BuyMult
-- (2.0) while we have none of that kind, x Setup_BuyMultHave (1.3) with one, x 1 with two or more: an answer, not an army of
-- them. Log "SETUP demand <sbps> x2 enemy set-up teams N for S s have H" (once per 30 s per unit). Setup_Buy=0 = off.
function EliteAI_SetupMult( name, curAmount )
	if not s_on() or eai_num("Setup_Buy", 1) < 1 then return 1 end
	local S = EliteAI and EliteAI.setup
	if type(S) ~= "table" or S.t0 == nil then return 1 end
	local now = World_GetGameTime()
	if now - (S.t or -1000) > 30 or now - S.t0 < eai_num("Setup_BuySecs", 20) then return 1 end
	local have = curAmount or 0
	if have >= 2 then return 1 end
	for _, k in ipairs(SETUP_COUNTER_UNITS) do
		if e_ends(name, k) then
			local m = (have == 0) and eai_num("Setup_BuyMult", 2.0) or eai_num("Setup_BuyMultHave", 1.3)
			EliteAI_E.n_setup = (EliteAI_E.n_setup or 0) + 1
			e_say("setup|" .. k, 30, "SETUP", "demand", r_short(name), "x" .. ((m == math.floor(m)) and string.format("%d", m) or string.format("%.1f", m)), "enemy set-up teams", tostring(S.n), "for", math.floor(now - S.t0), "s", "have", have)
			return m
		end
	end
	return 1
end
-- 0.5 (TECH_RU.md 17.4; the owner, Orca fb 513 / 515) THE ANSWER TO THE ENEMY'S ARMY. mod/mechanics.ai classifies the enemy squads we
-- have seen (light masses, melee swarms, heavy infantry, vehicles, dangerous melee squads, jump squads, infiltrators, snipers,
-- turrets nothing of ours outranges), its arbiter Conf_CounterVsPlan decides per class "counter" or "plan", and
-- EliteAI_MechCounterMult gives the multiplier of a buildable squad that answers a class (x2 while we have no answer, x1.3 with
-- one, x1.2 for a class left to the plan; the data and the log line "COUNTER demand ..." are there). Counter_Buy=0 = off here.
function EliteAI_CounterMult( name, curAmount )
	if not s_on() or eai_num("Counter_Buy", 1) < 1 or type(EliteAI_MechCounterMult) ~= "function" then return 1 end
	local m = EliteAI_MechCounterMult( name, curAmount or 0 ) or 1
	if m ~= 1 then EliteAI_E.n_counter = (EliteAI_E.n_counter or 0) + 1 end
	return m
end
-- a flamer / grenade upgrade while a garrison holds (the floor of CalcSquadUpgradeDemand above lets it be a candidate)
function EliteAI_GarAddon( upgradePBG )
	if not s_on() or not EliteAI_E.gar_on or upgradePBG == nil then return false end
	return e_has(string.lower(PBG_GetName( upgradePBG ) or ""), GAR_ADDON_KEYS)
end
-- 0.3 THE ARMY'S SHARE (TECH_RU.md 12; s15, 4p_tharsisforge: 6 / 5 units by 12:00 against 8 / 9 in s13; IG paid ~1650 req for
-- upgrades and 1500 for units in those 12 minutes, 23 upgrade lines against 3 units between 4:30 and 9:00). Elite's addon
-- budget asks for the best upgrade every 3 s and buys it as soon as the bank holds its 50-150 req, so a unit of 300-575 req
-- is always "far" (ETA by the bank it never gets), and the arbiter below only protects a unit that is already within reach.
-- A good player in T1-T2 puts most of the req into squads and upgrades them once the army is there. The rule, one for all
-- races, by real costs (the book of purchases, bought requests only):
--   upgrades may take at most Share_AddonT1 / T2 / T3 (0.15 / 0.20 / 0.30) of the req spent on the army so far - spawns,
--   reinforcements, the globals that spawn squads (book kinds unit, reinf, abil; or the worth of the squads we have, when
--   that is more) plus the upgrades themselves;
--   half of that (Share_SmallK) while the army is below Share_ArmyT1 / T2 / T3 (4 / 6 / 8) squads - "the army is not there yet";
--   half of that (Share_BehindK) while our team's army is behind the closest enemy's (cache.military_percent_value <
--   Share_BehindPct 0, the value Elite and the tech arbiter use);
--   no cap at Share_PopFree (0.9) of the population cap (no unit can come), while Share_RichReq (400) req lie in the bank
--   beyond the cost of the unit that is waited for (the money is idle), and for the Garrison pattern's flamers / grenades.
-- An upgrade that would take the share over the cap is not a candidate this tick ("ENERGY addon skip <name> why share ...").
-- The cap is an upper bound; the lower bound is the arbiter's window: after Spend_UnitFirstMax of waiting for a unit the
-- upgrades get their Spend_UnitFirstPause only while they are below Share_FloorK (0.5) of the cap - with their share taken
-- the unit stays first (s15, IG: "unit->addons waited 46 s" three times at a unit ETA of 12-36 s). Share_On=0 = as before.
local function e_tot( kind )
	local tt = EliteAI_E.tot[kind]
	return (tt and tt.r) or 0
end
-- req on the army so far; req on upgrades (bought, plus the requests that wait for their verdict). The army: what the book
-- says we paid, or what the squads we have are worth when that is more (EliteAI_PurchasePrep of the last units tick: an army
-- that was not bought through these scripts - the polygon's scenes place it, the build order's first squads).
local function e_spent()
	local pend = 0
	for _, q in ipairs(EliteAI_E.areq) do pend = pend + q.r end
	local army = e_tot("unit") + e_tot("reinf") + e_tot("abil")
	local have = (EliteAI_P and EliteAI_P.army_req) or 0
	if have > army then army = have end
	return army, e_tot("addon") + pend
end
local function e_addon_share()
	local army, add = e_spent()
	if army + add <= 0 then return 0 end
	return add / (army + add)
end
-- the cap of this tick: share, why
local function e_share_cap()
	local E, now = EliteAI_E, World_GetGameTime()
	if E.cap_t == now and E.cap ~= nil then return E.cap, E.cap_why end
	local c = cache or {}
	local lvl = c.tech_tier_level or 1
	local cap = (lvl <= 1 and eai_num("Share_AddonT1", 0.15)) or (lvl == 2 and eai_num("Share_AddonT2", 0.20)) or eai_num("Share_AddonT3", 0.30)
	local need = (lvl <= 1 and eai_num("Share_ArmyT1", 4)) or (lvl == 2 and eai_num("Share_ArmyT2", 6)) or eai_num("Share_ArmyT3", 8)
	local why = "T" .. tostring(lvl)
	local army, pct = c.military_count or 0, c.military_percent_value or 0
	local pop, popmax = c.current_population_personnel or 0, c.max_population_personnel or 0
	if eai_num("Share_On", 1) < 1 then cap, why = 1, "off"
	elseif popmax > 0 and pop >= popmax * eai_num("Share_PopFree", 0.9) then cap, why = 1, "pop " .. pop .. "/" .. popmax
	elseif ((c.resources and c.resources.requisition) or 0) - (E.hold_req or 0) >= eai_num("Share_RichReq", 400) then cap, why = 1, "rich"   -- req lies idle beyond the unit that is waited for
	elseif army < need then cap, why = cap * eai_num("Share_SmallK", 0.5), why .. " army " .. army .. "<" .. need
	elseif pct < eai_num("Share_BehindPct", 0) then cap, why = cap * eai_num("Share_BehindK", 0.5), why .. string.format(" behind %.2f", pct)
	end
	E.cap_t, E.cap, E.cap_why = now, cap, why
	return cap, why
end
EliteAI_EnergyShare = function() local cap, why = e_share_cap(); return e_addon_share(), cap, why end   -- the stub run, the stats

-- Conf_AddonVsUnit: squad upgrades wait for the unit Elite's pipeline is short of money for, when it is within reach

local function e_rule()
	local r = math.floor(eai_num("Conf_AddonVsUnit", r_vidx()))
	if r < 1 then r = 1 elseif r > 3 then r = 3 end
	return r
end
-- 0.10 (TECH_RU.md 21.1) THE ARMY'S TEMPO. Both testers after newai-19 / 20: "the bot is very weak, few units, it develops badly"
-- (Malum fb 623: grey knights, an army of 4-7 squads for 26 minutes, pop <= 59 of 100; Orca fb 634: chaos, 7 units in 14 minutes).
-- Their books at 12:30 - Malum: units 1760 req of 4705 spent (37 %), generators and nodes 1650 (35 %: twelve generators and nine
-- nodes in the match, the enemy razed them four times), models 635, upgrades 360; Orca: units 1850 of 4734 (39 %), models 979,
-- upgrades 555, T3 at 11:06 with seven squads. The req income is 210-340 a minute whatever is held (the upkeep eats what the
-- points bring), so a player's army at 10 minutes is that income spent on squads - and here less than two fifths of it was.
-- The tempo is one number for every purse: the population the army should have by now - Tempo_Pop0 (30) + Tempo_PopPerMin (5)
-- a minute, up to Tempo_PopShare (0.8) of the cap: 55 at 5:00, 80 at 10:00. BEHIND it the unit the pipeline waits for is first:
--  * the upgrades leave it its req whatever its ETA and under every rule of Conf_AddonVsUnit (e_hold_tick: the ETA limits were
--    why "unit_first" was off in most stats lines - right after any purchase the unit is 60-100 s away at this income, so the
--    upgrades went through, and they kept it away); the upgrades' own floor share still opens their window (Share_FloorK);
--  * a generator / a node beyond the base is asked for only when the POWER is what we wait for (e_gen_need below).
-- Tempo=0 = off (0.9 as it was). Line "SPEND tempo behind|ok pop P target T ..." once a minute, "tempo P/T" in ENERGY stats.
function EliteAI_Tempo()
	if not s_on() or cache == nil or eai_num("Tempo", 1) < 1 then return false, 0, 0 end
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	if popmax <= 0 then return false, pop, 0 end
	local target = eai_num("Tempo_Pop0", 30) + eai_num("Tempo_PopPerMin", 5) * World_GetGameTime() / 60
	-- step 2: people's plan may give the population by minute (human_plan.ai, the race's "pop" table; EliteAI_OpeningPop)
	local hpop = EliteAI_OpeningPop( World_GetGameTime() )
	if hpop ~= nil then target = hpop end
	target = math.min(popmax * eai_num("Tempo_PopShare", 0.8), target)
	return pop < target, pop, target
end
local function e_hold_tick( now )
	local E, r = EliteAI_E, e_rule()
	local st = E.stall
	local fresh = (st ~= nil and now - st.t <= 7)                           -- a spawn stalled within the last two purchase ticks
	local eta_max = eai_num("Spend_UnitFirstEta", (r == 1) and 60 or 40)
	-- 0.10: behind the tempo the unit is first whatever its ETA and the rule (the upgrades' floor share keeps its window)
	local behind, tpop, ttarget = EliteAI_Tempo()
	local tempo = behind and eai_num("Tempo_Hold", 1) >= 1
	E.tempo, E.tempo_pop, E.tempo_target = behind, tpop, ttarget
	if behind then E.n_tempo = (E.n_tempo or 0) + 1 end
	if eai_num("Tempo", 1) >= 1 then e_say("tempo", 60, "SPEND", "tempo", behind and "behind" or "ok", "pop", tpop, "target", math.floor(ttarget), "army", (cache and cache.military_count) or -1,
		"bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "unit", st and fresh and st.name or "-", "hold", E.hold and 1 or 0) end
	-- STEP 6 (ENERGY 0.16; VANILLA_BASE_RU.md 17.5 / 18): after the tier research, while the room is kept for the first unit of the
	-- tier, that unit is first as behind the tempo - whatever its ETA and the rule (s5_tyr_ig, rule 3: 435 req of upgrades
	-- between the research and the first unit of tier 3, 288 s later). Room_UnitFirst=0 = off.
	if not tempo and eai_num("Room_UnitFirst", 1) >= 1 and EliteAI_Room ~= nil then
		local ron, _, rwhy = EliteAI_Room()
		if ron and rwhy == "done" then tempo = true; E.n_room_first = (E.n_room_first or 0) + 1 end
	end
	if tempo then eta_max = 9999 end
	-- 0.6 (TECH_RU.md 15.3): the tech plan gave the float research's money to this unit - the upgrades leave it its req as well
	local tuf = (r < 3) and type(EliteAI_TechUnitFirst) == "function" and EliteAI_TechUnitFirst() == true
	if tuf then eta_max = math.max(eta_max, eai_num("Tech_FloatUnitEta", 75)) end
	local eta_off = eta_max * eai_num("Spend_UnitFirstOffK", 1.5)           -- 0.2: a band, not one threshold
	local max_s = eai_num("Spend_UnitFirstMax", (r == 1) and 75 or 45)
	-- 0.5 (TECH_RU.md 17.3; s20: no unit for 262 s, tyranids - after the T2 research took the bank the unit's ETA was 84 s at this
	-- income, "eta 80>60" let the upgrades through, four of them (355 req) and a generator kept the ETA there for two minutes).
	-- A DROUGHT - no unit bought for Spend_DroughtSecs while one waits - is no time for upgrades whatever the ETA: the unit is
	-- first until it is bought (rules 1 and 2; rule 3 never holds the upgrades). The ETA is long BECAUSE the req goes elsewhere.
	local dsecs = eai_num("Spend_DroughtSecs", 120)
	-- 0.6 (TECH_RU.md 18.7; Orca fb 527, IG, newai-15: units at 0:01 and 0:29, the third at 3:38 - three generators (300 req), a
	-- sergeant, a stomp and 160 req of models went first while "ig_devils 350/35" stood at "why money" for 168 s): an army of
	-- Spend_DroughtArmy (3) squads or fewer is in a drought after Spend_DroughtSmall (60 s) already. 0 = the one clock for all.
	local dsmall = eai_num("Spend_DroughtSmall", 60)
	if dsecs > 0 and dsmall > 0 and dsmall < dsecs and cache ~= nil and (cache.military_count or 99) <= eai_num("Spend_DroughtArmy", 3) then dsecs = dsmall end
	local dry_for = (EliteAI_S ~= nil) and (eai_time() - (EliteAI_S.last_buy or 0)) or 0
	-- 0.6 (TECH_RU.md 18.7; Orca's second match, tyranids, variant C = rule 3 "the upgrades never wait"): the units' pipeline
	-- stood at "why money" for 413 s in a row (4:09-11:20: a ravener 400/45, then a genestealer 350/45, then a tyrant guard) -
	-- every time the bank came near the price an upgrade request locked 120-150 req of it ("bank 405/95 tasks 150/50 avail
	-- 255/23"); 8 units and 15 upgrades (1700 req) in 21 minutes. The variants differ where
	-- the outcome is not clear; a unit that nobody can buy for minutes is clear. A drought holds under rule 3 too
	-- (Spend_DroughtRule3=0 = rule 3 never holds, as before)
	local dry = (r < 3 or eai_num("Spend_DroughtRule3", 1) >= 1) and fresh and dsecs > 0 and dry_for >= dsecs
	E.dry, E.dry_for = dry, dry_for                                         -- 0.7: the director's refills read it (EliteAI_ReinforceDir)
	local want, why, paused = E.hold, "-", false
	-- the wait clock: seconds a unit was short of money since the decision "unit" (not the time it had the money and waited
	-- for the busy HQ, not the time no unit waited at all)
	local dt = math.min(now - (E.hold_last or now), 5)
	E.hold_last = now
	if r >= 3 and not dry and not tempo then
		want, why = false, "rule 3"
	elseif E.hold then
		if fresh then
			E.idle_t = now
			if st.eta > 0 then E.hold_wait = (E.hold_wait or 0) + dt end
			if dry then
				E.n_dry = (E.n_dry or 0) + 1
				e_say("hold_dry", 60, "ENERGY", "Conf_AddonVsUnit", "bank", "unit kept", st.name, "eta", math.floor(st.eta), "drought", math.floor(dry_for), "s without a unit", "rule", r)
			elseif st.eta > eta_off then want, why = false, string.format("%s eta %.0f>%.0f", st.name, st.eta, eta_off)
			elseif (E.hold_wait or 0) >= max_s then
				-- 0.3: the window is for upgrades that are short of their share; with the share taken the unit stays first
				local cap = e_share_cap()
				local sh, floor = e_addon_share(), cap * eai_num("Share_FloorK", 0.5)
				-- 0.6 (Orca fb 527, 11:52: the ogryns 400/85 were 34 req - 8 s - away with 366 req when "waited 46 s share 0.09<0.10"
				-- opened the upgrades' window; the commissar's power claw (130/40) took it, the match ended with 253/241 in the bank
				-- and no ogryns): a unit that is Spend_UnitFirstNear (15 s) away is bought first, the window comes after it
				if st.eta <= eai_num("Spend_UnitFirstNear", 15) then
					E.n_hold_keep = E.n_hold_keep + 1
					e_say("hold_near", 30, "ENERGY", "Conf_AddonVsUnit", "bank", "unit kept", st.name, "eta", math.floor(st.eta), "waited", math.floor(E.hold_wait), "s",
						"the unit is that near: the upgrades' window comes after it", "rule", r)
				elseif sh < floor then
					want, why, paused = false, string.format("waited %.0f s share %.2f<%.2f", E.hold_wait, sh, floor), true   -- the upgrades get their window
				else
					E.n_hold_keep = E.n_hold_keep + 1
					e_say("hold_keep", 60, "ENERGY", "Conf_AddonVsUnit", "bank", "unit kept", st.name, "eta", math.floor(st.eta), "waited", math.floor(E.hold_wait), "s",
						"upgrades have their share", string.format("%.2f>=%.2f", sh, floor), "rule", r)
				end
			end
		elseif now - E.idle_t >= eai_num("Spend_UnitFirstIdle", 20) then
			want, why = false, "no stalled unit"
		end
	elseif fresh and st.eta <= eta_max and now >= E.hold_pause then
		want, why = true, string.format("%s %d/%d eta %.0f%s", st.name, st.req, st.pow, st.eta, tempo and " tempo" or "")
	elseif dry then
		want, why = true, string.format("%s %d/%d eta %.0f drought %.0f s", st.name, st.req, st.pow, st.eta, dry_for)
	end
	-- what the upgrades (and Secure, the generators) have to leave in the bank: only while a unit really waits
	E.hold_req = (E.hold and fresh) and st.req or 0
	if want == E.hold then return end
	if now - E.hold_sw < eai_num("Spend_UnitFirstHold", 20) then return end -- hysteresis: two switches in 30 s at most
	E.hold, E.hold_sw = want, now
	E.n_hold_sw = E.n_hold_sw + 1
	if want then E.hold_t, E.idle_t, E.hold_req, E.hold_wait = now, now, st.req, 0 else E.hold_req = 0 end
	if paused then E.hold_pause = now + eai_num("Spend_UnitFirstPause", (r == 1) and 20 or 30) end
	eai_log("ENERGY", "Conf_AddonVsUnit", "bank", want and "addons->unit" or "unit->addons", why, "rule", r, "bank", s_rp(cache.resources))
end
-- TryPurchaseUnitChoice: the chosen spawn stalls - why = "money" (short in what the units budget may spend) or "channel"
-- (the money is there, the producer has a request: a unit in production, the tier research)
-- 0.4: also called by the plan (EliteAI_PlanClaim) before the choice - why "ready" = the money is there and the HQ is free (no
-- line: it is bought in this tick unless something goes first).
-- STEP 2 (ENERGY 0.12; VANILLA_BASE_RU.md 8: the tyranids ended with 566 req / 1107 power). Within PopMargin of the population cap
-- no spawn is asked for (TryPurchaseUnitChoice) - but the unit stayed the plan's claim: s1_tyr_ig from 15:00 on, pop 97-98 of
-- 100, "SPEND stall tyr_lictor 400/65 why money ... for 120 s", then "tyr_carnifex 575/150 ... for 198 s", and for all that
-- time "ENERGY addon skip ... why unit_first" (133 of the match's 191 skips) - the upgrades waited for a unit that could not
-- be asked for, the unit's cost was locked in the budget run, and both banks grew. At the cap the unit is no claim and locks
-- nothing: the bank is the upgrades' (the power-heavy ones first while the power floats), the reinforcements' and the
-- research's. Energy_PopCapFree=0 = as 0.11. Line "ENERGY popcap ..." once a minute, "popcap N" in the stats.
function EliteAI_PopCapped()
	if not s_on() or cache == nil or eai_num("Energy_PopCapFree", 1) < 1 then return false end
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	return popmax > 0 and popmax - pop < eai_num("PopMargin", 8)
end
-- STEP 3 (ENERGY 0.13; VANILLA_BASE_RU.md 10.1 / 11.4) THE SWAP AT THE POPULATION CAP. s2: from 15-17 minutes the population is 96-100 of
-- 100, every upgrade is bought ("wargear_skip 448-522"), a unit is no claim at the cap - and both banks grow to 1000+ (7 of 8
-- players). The army that fills the cap is the one bought on the way there: half of it T1 squads. They cannot be disbanded
-- or sent to die; but they need not be REFILLED. While the swap is ON -
--   our tier >= Swap_Tier (3), the population within Swap_PopFrom (15) of the cap, the bank at least Swap_BankReq (500) req
--   and Swap_BankPow (150) power (a T3 unit's price lies there); it stays on until the req bank is below Swap_OffK (0.5) of
--   that or the population is 2 x Swap_PopFrom below the cap, and at least Swap_HoldSecs (30 s) -
-- * a squad of a T1 blueprint (EliteAI_P.tier_seen < 2; not a hero) is refilled only to Swap_Fill (0.4) of a full squad - just
--   above the "third" the director sends home (r_goal "swap", the director's purse and the quiet trip; the engine's own
--   requests - EliteAI_ReinforceGate "swap");
-- * a T1 blueprint is no candidate for a new squad (EliteAI_PurchaseMult 0): the room the losses free is not filled with the
--   same squads again - the unit pipeline (PopMargin 8, the engine's "can start now") buys what the tier gives.
-- Lines "SPEND swap on|off ...", "REINF dir goal ... why swap", "REINF skip <unit> ... why swap ..."; "swap" in ENERGY stats.
-- Swap_On=0 = as 0.12.
-- STEP 4 (ENERGY 0.14; VANILLA_BASE_RU.md 14.2) THE SECOND WAY IN: THE POWER LIES IDLE. In 8 mirrors of step 3 the swap never went
-- on ("swap on x0"): the req bank does not reach Swap_BankReq (500) - at the cap the req goes into the refills and the
-- upgrades as it comes (s3h_b4, orks, 13:30-22:30: pop 84-100, req 17-365, power 387 -> 860; "ENERGY popcap ... no spawn can
-- be asked for" 56 times; 9 squads, 6 of them T1). The sign that the cap is filled with the wrong army is the POWER nobody
-- can spend, not the req: with Swap_Float (1) the swap also goes on at tier >= Swap_Tier within Swap_PopFrom of the cap when
-- the power bank is at least Swap_FloatPow (450), and then stays on while the power is above Swap_OffK (0.5) of that (the
-- population rule and Swap_HoldSecs as before). Entered this way it is the gentle one: the T1 squads are refilled to
-- Swap_FloatFill (0.6) of a full squad, not 0.4 - the req they do not take and the room their losses leave go to the units
-- of the tier (the watchdog's wait above). "SPEND swap on ... by float|req", "swap_why" in the stats. Swap_Float=0 = as 0.13.
-- STEP 5 (ENERGY 0.15; VANILLA_BASE_RU.md 16.1): * Swap_FloatPow is 300 (was 450) - the watchdog's own mark of "the power lies
-- idle" (Spend_BankPow), the price in power of the dearest pair of the tier: s4, the tyranids - the swap went on at 18:13,
-- 198 s after the tier, with the power at 300+ from 15:00 on; the orks of s4_mir_h_a at 16:25 with 312 at 14:07.
-- * THE THIRD WAY IN: "tier" - the room for the units of the tier (EliteAI_Room above) is on and the population stands
--   inside it (within Room_Pop of the cap): the gentle swap (Swap_FloatFill), whatever the banks hold and already while
--   the research runs; it ends with the room (two units of the tier, or Room_MaxSecs) or Room_PopOff (5) below the room.
function EliteAI_SwapFill()
	if EliteAI_E ~= nil and (EliteAI_E.swap_why == "float" or EliteAI_E.swap_why == "tier") then return eai_num("Swap_FloatFill", 0.6) end
	return eai_num("Swap_Fill", 0.4)
end
function EliteAI_PopSwap()
	if not s_on() or cache == nil or cache.resources == nil or eai_num("Swap_On", 1) < 1 then return false end
	local E, now = EliteAI_E, World_GetGameTime()
	if E.swap_t == now then return E.swap == true end
	E.swap_t = now
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	local lvl = cache.tech_tier_level or 1
	local br, bp = cache.resources.requisition or 0, cache.resources.power or 0
	local from, need_r, need_p = eai_num("Swap_PopFrom", 15), eai_num("Swap_BankReq", 500), eai_num("Swap_BankPow", 150)
	local tier_ok = popmax > 0 and lvl >= eai_num("Swap_Tier", 3)
	local fpow, fon = eai_num("Swap_FloatPow", 300), (eai_num("Swap_Float", 1) >= 1)   -- step 4 (0.14): the power that lies idle (step 5: 300, was 450)
	local ron, rpop = false, eai_num("Room_Pop", 20)                          -- step 5 (0.15): the room for the units of the tier
	if EliteAI_Room ~= nil and popmax > 0 then ron = (EliteAI_Room()) == true end
	local want, why = false, E.swap_why
	if E.swap == true then
		if why == "tier" then want = ron and popmax - pop < rpop + eai_num("Room_PopOff", 5)   -- (narrow: the T1 squads are refilled again 5 below the room)
		elseif why == "float" then want = tier_ok and popmax - pop < from * 2 and bp >= fpow * eai_num("Swap_OffK", 0.5)
		else want = tier_ok and popmax - pop < from * 2 and br >= need_r * eai_num("Swap_OffK", 0.5) end
		if not want and now - (E.swap_since or now) < eai_num("Swap_HoldSecs", 30) and (tier_ok or (why == "tier" and ron)) then want = true end
	else
		want, why = (tier_ok and popmax - pop < from and br >= need_r and bp >= need_p), "req"
		if not want and fon and tier_ok and popmax - pop < from and bp >= fpow then want, why = true, "float" end
		if not want and ron and popmax - pop < rpop then want, why = true, "tier" end
	end
	if want ~= (E.swap == true) then
		E.swap, E.swap_since, E.n_swap = want, now, (E.n_swap or 0) + 1
		if want then E.swap_why = why end                                     -- (the fill of this swap: EliteAI_SwapFill)
		eai_log("SPEND", "swap", want and "on" or "off", "pop", pop .. "/" .. popmax, "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "tier", lvl,
			want and "T1 squads are refilled to" or "after", want and EliteAI_SwapFill() or math.floor(now - (E.swap_on_t or now)), want and "of a full one, no new T1 squad" or "s", "n", E.n_swap,
			"by", tostring(E.swap_why or "-"))
		if want then E.swap_on_t = now else E.swap_why = nil end
	end
	if want then E.n_swap_ticks = (E.n_swap_ticks or 0) + 1 end
	return want
end
-- is the blueprint (its lower-case name) one the swap steps over: of the first tier, not a hero
function EliteAI_SwapWeak( name )
	if name == nil then return false end
	if eai_class(name) == "hero" then return false end
	return (EliteAI_P.tier_seen[name] or 1) < 2
end
function EliteAI_EnergyNoteStall( pbg, cost, why, availableResources, queue )
	if not s_on() or cache == nil or cache.resources == nil or cost == nil or pbg == nil then return end
	local E, now = EliteAI_E, World_GetGameTime()
	if EliteAI_PopCapped() then
		E.n_popcap = (E.n_popcap or 0) + 1
		e_say("popcap", 60, "ENERGY", "popcap", (cache.current_population_personnel or 0) .. "/" .. (cache.max_population_personnel or 0),
			"no spawn can be asked for (PopMargin " .. eai_num("PopMargin", 8) .. "):", r_short(PBG_GetName( pbg )), s_rp(cost), "is no claim - the bank is the upgrades'",
			"bank", s_rp(cache.resources), "float", E.float and 1 or 0, "n", E.n_popcap)
		return
	end
	why = why or "money"
	local eta = 0
	if why == "money" then eta = GetETAFromCost( cost, availableResources or cache.resources ) or 0 end   -- util/demand.ai:105, at the current income
	local name = r_short(PBG_GetName( pbg ))
	local since, msince = now, nil
	local prev = (E.stall ~= nil and now - E.stall.t <= 7) and E.stall or nil
	if prev then since = prev.since or prev.t end                           -- stalled without a break (whatever the unit)
	if why == "money" then msince = (prev and prev.msince) or now end       -- 0.4: short of money without a break (the "unit" save of the reinforcement budget)
	E.stall = { t = now, since = since, msince = msince, req = cost.requisition or 0, pow = cost.power or 0, eta = eta, name = name, why = why }
	local full = string.lower(PBG_GetName( pbg ) or "")
	E.stall.ans = (EliteAI_P ~= nil and EliteAI_P.ans ~= nil and EliteAI_P.ans[full] == true)   -- 0.10: an answer the layers ask for (e_gen_first)
	if why == "ready" then e_hold_tick( now ); return end
	-- 0.2: who holds the money - the line the verification of newai-10 could not get from the log
	e_say("stall|" .. why, eai_num("Spend_StallLog", 20), "SPEND", "stall", name, s_rp(cost), "why", why, "avail", s_rp(availableResources or cache.resources),
		"bank", s_rp(cache.resources), "tasks", s_rp(Task_CountCost( s_selfplayer, false )), "queue", queue or 0, "eta", math.floor(eta),
		"for", math.floor(now - since), "s", "tech_reserve", E.res_req or 0, "secure_pending", E.sec_pending or 0,
		"budget_gave", math.floor(E.av_req or -1) .. "/" .. math.floor(E.av_pow or -1))   -- below bank - tasks = a budget ahead of the units locked the difference
	e_hold_tick( now )                                                      -- at once: the addon run of the next tick comes before the next units run
end
-- strategy_tech_purchase.ai (decision "army"): the unit the pipeline is about to buy - it has the money and waits for the HQ, or
-- is within Tech_ArmyEta (10 s) of it: its req, power; 0, 0 = none. A unit that is far from affordable is not protected this way:
-- with a small army rule 2 says "army" for minutes, and the tier research would not come before Tech_T2Late.
function EliteAI_UnitWant()
	local st = EliteAI_E and EliteAI_E.stall
	if not s_on() or st == nil or World_GetGameTime() - st.t > 7 then return 0, 0 end
	if st.why ~= "channel" and (st.eta or 0) > eai_num("Tech_ArmyEta", 10) then return 0, 0 end
	return st.req or 0, st.pow or 0
end
-- 0.4 THE PLAN'S NEXT UNIT (TECH_RU.md 13). Until now "the unit we wait for" was the spawn TryPurchaseUnitChoice stalled on - and
-- that exists only when a spawn is the first choice of the first pass. A reinforcement entry (demand x50) goes first whenever
-- a model is affordable within 30 s, and a spawn farther than Elite's wait (personality eta_unit_wait_time + 5 s per squad
-- above 4) is no entry at all: with the bank kept low by refills and upgrades the unit was never "waited for" (s16: no stall
-- line from 7:00 to 10:30), so nothing stepped back for it. Now AccumulateSquadDemand notes, on the first pass, the best spawn
-- by the demand it would get (the entries within Elite's wait first, then the ones the income brings within Plan_EtaMax =
-- Energy_EtaMax 120 s - those are worked out by the same rules and never set as a demand: Elite's choice is as it was), and
-- do_purchase makes it the claim before the choice: EliteAI_E.stall, why "money" (short), "channel" (the HQ has a request) or
-- "ready". Everything that steps back for a unit reads that one record: the upgrades (Conf_AddonVsUnit), the tech arbiter
-- (EliteAI_UnitWant), the reinforcements (r_claim), the race's abilities (EliteAI_UnitClaim, mod/mechanics.ai).
-- The blueprint is kept within the tick only (EliteAI_P.plan is dropped in EliteAI_PlanClaim). Plan_Claim=0 = off.
function EliteAI_PlanNote( pbg, demand, eta, in_wait )
	local P = EliteAI_P
	if not s_on() or pbg == nil or P.pass ~= 0 then return end
	local name = string.lower(PBG_GetName( pbg ) or "")
	if eai_class(name) == "hero" then return end
	local pl = P.plan
	if pl == nil or (in_wait and not pl.in_wait)
		or (in_wait == pl.in_wait and (demand > pl.demand or (demand == pl.demand and name < pl.name))) then   -- ties by name: the order of the list does not matter
		P.plan = { pbg = pbg, name = name, demand = demand, eta = eta, in_wait = in_wait }
	end
end
function EliteAI_PlanClaim( availableResources )
	local P = EliteAI_P
	local pl = P.plan
	P.plan = nil
	if not s_on() or pl == nil or pl.pbg == nil or cache == nil or cache.resources == nil or eai_num("Plan_Claim", 1) < 1 then return end
	local cost = SquadStats_GetCost( s_self_modplayer, pl.pbg )              -- TryPurchaseUnitChoice below (Elite's)
	if cost == nil then return end
	local av = availableResources or cache.resources
	local why, q = "ready", 0
	if not ResourceAmount_Has( av, cost ) then
		why = "money"
	else
		q = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, pl.pbg ) or 0   -- TryPurchaseUnitChoice below (Elite's)
		if q > 0 then why = "channel" end
	end
	EliteAI_EnergyNoteStall( pl.pbg, cost, why, av, q )
end
-- the unit the plan waits for, for the scripts outside this file: req, pow, eta (s, 0 = has its money), name, why, waited (s);
-- nil = none (numbers and strings: nothing of the engine is handed out)
function EliteAI_UnitClaim()
	local st = EliteAI_E and EliteAI_E.stall
	if not s_on() or st == nil then return nil end
	local now = World_GetGameTime()
	if now - st.t > 7 then return nil end
	return st.req or 0, st.pow or 0, st.eta or 0, st.name or "-", st.why or "money", now - (st.since or st.t)
end
-- 0.5 (TECH_RU.md 14) mod/mechanics.ai: a call-in was cast - a global that brings squads for req. It is a unit bought through
-- another channel: the line "callin <t> <ability> R/P army N" (the count of units of a match = "buy" + "callin"), the idle clock
-- of the watchdog, the save state (it ends as with a unit: the squads get their pause), and the wait for the plan's unit
-- starts anew. The cost is in the book as "abil" (EliteAI_EnergyNote, mechanics.ai).
function EliteAI_UnitCallIn( name, cost )
	if not s_on() then return end
	EliteAI_S.n_callin = (EliteAI_S.n_callin or 0) + 1
	eai_log("callin", eai_time(), string.lower(name or "-"), s_rp(cost), "army", (cache and cache.military_count) or -1, "n", EliteAI_S.n_callin)
	EliteAI_S.last_buy = eai_time()
	EliteAI_ReinforceNoteBuy( r_short(name), cost, World_GetGameTime() )
	EliteAI_E.stall = nil
end
-- 0.6 (TECH_RU.md 15.2) THE CALL-IN OR THE UNIT, BEFORE THE UNIT IS BOUGHT (mod/mechanics.ai EliteAI_MechCallInFirst). The polygon's
-- scene d (newai-13): the bank reached 355, this budget bought the genestealer (350) in that tick, and the ability budget -
-- which runs after it - found no money for the spore (350): the arbiter Conf_AbilityVsUnit never saw the pair. Now
-- TryPurchaseUnitChoice asks at the three places a spawn is decided: it would be bought now ("ready"), it has its money and
-- waits for the HQ ("channel"), it is short of money and would lock its cost ("money"). The unit is the claim the arbiter
-- reads (EliteAI_E.stall); a call-in the arbiter lets pass over it is cast at once and this budget is charged with it
-- (returns its name and cost; nil = the unit goes on as before). Mech_AbilCallInFirst=0 = off.
function EliteAI_CallInFirst( pbg, unitCost, why, availableResources )
	if not s_on() or type(EliteAI_MechCallInFirst) ~= "function" or pbg == nil or unitCost == nil or availableResources == nil then return nil end
	if why == "ready" then EliteAI_EnergyNoteStall( pbg, unitCost, "ready", availableResources, 0 ) end   -- this unit is the claim (the stalls noted it already)
	local name, cost = EliteAI_MechCallInFirst( availableResources )
	if name == nil then return nil end
	EliteAI_E.n_callin_first = (EliteAI_E.n_callin_first or 0) + 1
	eai_log("SPEND", "callin_first", r_short(name), s_rp(cost), "over", r_short(PBG_GetName( pbg )), s_rp(unitCost), why, "avail", s_rp(availableResources))
	return name, cost
end
-- 0.6 (TECH_RU.md 15.3) how many units were bought so far - the spawn requests of the units budget and of the watchdog (the book's
-- "unit") and the call-ins: strategy_tech_purchase.ai ends its "unit first" with the next one
function EliteAI_UnitBuys()
	if not s_on() then return 0 end
	local tt = EliteAI_E and EliteAI_E.tot and EliteAI_E.tot.unit
	return ((tt and tt.n) or 0) + ((EliteAI_S and EliteAI_S.n_callin) or 0)
end
-- 0.6 (TECH_RU.md 15.3): is the tech plan's "unit first" on (the float research stepped back for the unit that was waited for)?
-- While it is, that unit is "within reach" for everything that steps back for a unit - the reinforcements (r_claim) and the
-- upgrades (Conf_AddonVsUnit) - up to Tech_FloatUnitEta: s18, 11:03 - the arbiter said "unit_first tyr_warrior_venom_cannon eta 63"
-- and in the next 5 s two models (36 req) and two upgrades (90 req) were bought with the req that was left to the unit.
-- (EliteAI_TechUnitFirst of strategy_tech_purchase.ai is asked in r_claim and e_hold_tick.)
-- 0.5 (TECH_RU.md 14) strategy_tech_purchase.ai, the reason "float": the unit the plan waited for BEFORE the research was wanted
-- (t_want) and that the income brings within Tech_FloatUnitEta (75 s = the time of a research) - name, eta, req, pow; nil = none.
-- s17: the zoanthrope (360/40) had been waited for since 9:07; at 11:02 the float state asked for T3, the plan's reserve took
-- the bank (the unit was 57 s away: "avail 0/119"), T3 started at 11:37, the 7th unit came at 12:54. A unit whose wait began
-- after the research was wanted does not hold it: one unit, 75 s at most, then the research. The eta is by the bank less the
-- tasks - not by what the units budget is given (the reserve itself makes that 0).
function EliteAI_UnitAhead( t_want )
	local st = EliteAI_E and EliteAI_E.stall
	if not s_on() or st == nil or cache == nil or cache.resources == nil then return nil end
	local now = World_GetGameTime()
	if now - st.t > 7 or (st.since or st.t) >= (t_want or now) then return nil end
	local eta = 0
	if st.why == "money" then
		local tasks = Task_CountCost( s_selfplayer, false )                  -- util/budget.ai:271
		local rate = cache.resources_rate or {}
		local function wait( need, have, per_min )
			if need <= have then return 0 end
			return (per_min > 0) and (60 * (need - have) / per_min) or 11111
		end
		eta = math.max(wait( st.req or 0, (cache.resources.requisition or 0) - ((tasks and tasks.requisition) or 0), rate.requisition or 0 ),
			wait( st.pow or 0, (cache.resources.power or 0) - ((tasks and tasks.power) or 0), rate.power or 0 ))
	end
	if eta > eai_num("Tech_FloatUnitEta", 75) then return nil end
	return st.name or "-", eta, st.req or 0, st.pow or 0
end
-- 0.2: what a budget may really spend = what the budget system gives it, but never the bank below the reserves: the tech plan's
-- (EliteAI_TechReserve: the tier research while the arbiter says "tech") and, for the budgets of the other run, the unit the
-- upgrades wait for (Conf_AddonVsUnit). The budget system's own value only knows the locks of the budgets that ran before
-- this one in this run. Returns the same object when nothing is reserved, else a copy with req / power cut.
local function e_reserved( availableResources, with_unit )
	local E = EliteAI_E
	E.res_req, E.res_pow = 0, 0
	if availableResources == nil or cache == nil or cache.resources == nil or eai_num("Energy_Reserve", 1) < 1 then return availableResources end
	local rr, rp = 0, 0
	if type(EliteAI_TechEval) == "function" then EliteAI_TechEval() end      -- the plan of this tick (the tech budget may run after us)
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	rr, rp = rr or 0, rp or 0
	local ur = (with_unit and E.hold and E.hold_req) or 0
	E.res_req, E.res_pow = rr, rp
	-- 0.9 (TECH_RU.md 21.13): the cost of the node a squad walks to is the engine's until the node is placed (EliteAI_EnergyWalk)
	local wr, wp = 0, 0
	if type(EliteAI_EnergyWalk) == "function" then wr, wp = EliteAI_EnergyWalk( World_GetGameTime() ) end
	if rr + rp + ur + wr + wp <= 0 then return availableResources end
	local free = ResourceAmount_Subtract( cache.resources, Task_CountCost( s_selfplayer, false ) )   -- util/budget.ai:271, 318
	local fr, fp = (free.requisition or 0) - rr - ur - wr, (free.power or 0) - rp - wp
	local ar, ap = availableResources.requisition or 0, availableResources.power or 0
	if fr >= ar and fp >= ap then return availableResources end
	local out = ResourceAmount_Subtract( availableResources, ResourceAmount_Zero() )   -- a copy: the budget system's object stays as it is
	out.requisition, out.power = math.max(0, math.min(ar, fr)), math.max(0, math.min(ap, fp))
	return out
end
EliteAI_EnergyReserved = e_reserved                                         -- the stub run
-- 0.2 BUDGET_Secure, before Elite's purchase function: true = no request this tick. The inactive requests of the last tick are
-- killed by now (default.ai:249, before the purchases), so Util_CountSecureRequests() = the ones a squad is executing.
-- 0.9 (TECH_RU.md 20.1) WHAT "DEAD" MEANT. The power node (<race>_listening_post, 125 req, 20 s, built by a squad) can stand only
-- on a POWER point of ours that has none; Elite asks for one whenever "points owned > points secured" (strategy_defence_purchase.ai:
-- 81) - requisition and victory points count as owned and can never be secured, so the demand is there for the whole match and
-- nearly every request has nothing to build ("secure_req 13 secure_dead 13" while the nodes that could be built were built:
-- s24a, tyranids - the first generator stood at 68 s with two "dead" requests before it). And a request that WAS taken read as
-- dead too: its task is gone by the next tick and the point counts as secured only when the node is finished, 20 s later. Now:
--  * the request is asked for only while mechanics.ai sees a power point of our team without a node (EliteAI.pw.unsec, from
--    Military_MilitaryPointIsSecuredPoint of its point scan; no scan = as before) - "secure_none" counts the ticks without one;
--  * the verdict waits Energy_SecureVerdict (25 s) for the task, a new secured point or a new node (PBG_GetCount of the securing
--    structure); no second request while it is open;
--  * with a point to secure the request is not cut by the unit the upgrades wait for (it is the condition of every generator).
local function e_is_secure( v ) return BS_Secure ~= nil and v.buildstyle == BS_Secure end   -- the node's entry (personality/<race>/standard.ai)
local function e_node_count()
	local n = 0
	if type(s_securing_structures) == "table" then
		for _, v in pairs(s_securing_structures) do                          -- a sum: the order of pairs() does not matter
			if v and v.pbg and e_is_secure( v ) then n = n + (PBG_GetCount( s_selfplayer, v.pbg ) or 0) end
		end
	end
	return n
end
-- 0.9 (TECH_RU.md 21.13) THE NODE A SQUAD WALKS TO HOLDS ITS PRICE INSIDE THE ENGINE. s27b, orks: "secure req t 487" (125/15),
-- "secure built after 3 s nodes 0->0 ... task 1" - the task is active, a squad walks to the point - and from 491 to 512 s seven
-- requests for a deff dread (270/65) with 281-385 req in the bank were not started; the dread was paid at ~515 with 396 in the
-- bank (270 + 125), the node at 519 ("SPEND drop ... -120/-13", "MECH Builder ... builds"). The same in s27b, IG (node asked at
-- 484, placed at ~527: manticore / chimera 300 not started with 317-422 = below 425) and s27a, IG (425 -> ~443). The budget
-- system takes off the INACTIVE tasks only (util/budget.ai:271 Task_CountCost( .., false )): an active task that has not paid
-- yet is money the scripts saw as free. So while a node's task is active (Task_CountActivePBG( .., true ), count_util.ai:25;
-- the task ends when the node is placed - "nodes 0->1 ... task 0") its price (the last secure request's) is off what the
-- budgets may spend: the unit waits as "why money" (its claim, the upgrades' hold) and no request is placed that the engine
-- cannot start. At most Energy_SecureWalkMax (60 s) per walk. Returns req, pow. Energy_SecureWalk=0 = off.
function EliteAI_EnergyWalk( now )
	local E = EliteAI_E
	if not s_on() or eai_num("Energy_SecureWalk", 1) < 1 or type(s_securing_structures) ~= "table" then return 0, 0 end
	if (E.sec_req or 0) + (E.sec_pow or 0) <= 0 then return 0, 0 end        -- no request of ours yet: the price is not known
	local act = 0
	for _, v in pairs(s_securing_structures) do                             -- a sum: the order of pairs() does not matter
		if v and v.pbg and e_is_secure( v ) then act = act + (Task_CountActivePBG( s_selfplayer, v.pbg, true ) or 0) end
	end
	if act <= 0 then E.walk_t, E.walk_req, E.walk_pow = nil, 0, 0; return 0, 0 end
	if E.walk_t == nil then E.walk_t, E.n_walk = now, (E.n_walk or 0) + 1 end
	if now - E.walk_t > eai_num("Energy_SecureWalkMax", 60) then E.walk_req, E.walk_pow = 0, 0; return 0, 0 end
	E.walk_req, E.walk_pow = (E.sec_req or 0) * act, (E.sec_pow or 0) * act
	e_say("walk", 30, "ENERGY", "secure", "walk", "tasks", act, "the engine holds", E.walk_req .. "/" .. E.walk_pow, "for the node a squad walks to: off what the budgets may spend",
		"for", math.floor(now - E.walk_t), "s", "bank", s_rp(cache and cache.resources), "n", E.n_walk)
	return E.walk_req, E.walk_pow
end
local function e_pw( now )                                                  -- mechanics.ai's look at our power points; nil = no fresh one
	local pw = EliteAI and EliteAI.pw
	if type(pw) ~= "table" or pw.t == nil or now - pw.t > eai_num("Energy_PwFresh", 15) or eai_num("Energy_SecureKnow", 1) < 1 then return nil end
	return pw
end
-- STEP 7 (ENERGY 0.17; VANILLA_BASE_RU.md 19.2): THE PLACES FOR A GENERATOR BY THE ENGINE. s6_eo_b, the orks of slot 1000: from 11:00 to the
-- end no generator was built - the plan asked for 3-5, a power point of ours held its node, and mechanics.ai counted "pw_slots 0"
-- (its own sum: PowerSlots less AIResource_GetCapturePointAddOnCount per secured power point of ours) - so "gen sites none" and
-- the node of another point were asked for instead. The engine keeps its own count, the one vanilla's generator rule reads
-- (cache.total_pts_secured_w_addon_capacity = AIResource_GetNumSecuredCapturePointsForAddOns, cache.ai:116; the generator
-- waits while it is 0, strategy_resourcing.ai:172). That count decides now (Energy_GenSlotsEngine 1; 0 = mechanics.ai's as 0.16);
-- the two are written side by side ("free places A engine B" in "ENERGY gen plan" and "gen sites none"), and a line
-- "ENERGY gen slots differ ..." with what each power point of ours holds (key:s|u<add-ons>[x<losses>]) when they disagree.
local function e_slots( pw )
	local eng = cache and cache.total_pts_secured_w_addon_capacity
	local own = (type(pw) == "table") and pw.slots or nil
	if type(eng) == "number" and type(own) == "number" and (eng > 0) ~= (own > 0) then
		e_say("gen_slots_differ", 60, "ENERGY", "gen", "slots", "differ", "ours", own, "engine", eng, "own", pw.own or 0, "unsec", pw.unsec or 0,
			"points", tostring(pw.pts or "-"), "generators", (EliteAI_E.gen_have or "?"))
	end
	if eai_num("Energy_GenSlotsEngine", 1) >= 1 and type(eng) == "number" then return eng end
	return own or 0
end
local function e_secure_gate()
	local E, now = EliteAI_E, World_GetGameTime()
	local pending = (type(Util_CountSecureRequests) == "function") and Util_CountSecureRequests() or 0   -- strategy_defence_purchase.ai:68
	local secured = (cache and cache.total_pts_secured) or 0                -- cache.ai:115
	local nodes, pw = e_node_count(), e_pw( now )
	E.sec_pending, E.sec_first = pending, false
	if E.sec_t ~= nil and now > E.sec_t then                                -- the open request: taken, a node placed or a point secured = bought
		if pending > 0 or secured > (E.sec_n0 or 0) or nodes > (E.sec_nodes0 or 0) then
			EliteAI_EnergyNote( "secure", { requisition = E.sec_req, power = E.sec_pow } )
			eai_log("ENERGY", "secure", "built", "after", math.floor(now - E.sec_t), "s", "nodes", (E.sec_nodes0 or 0) .. "->" .. nodes, "secured", (E.sec_n0 or 0) .. "->" .. secured, "task", pending)
			E.sec_hist = E.sec_hist or {}                                       -- step 8: what the nodes cost lately (the cap after 12:00)
			table.insert(E.sec_hist, { t = E.sec_t, r = E.sec_req or 0 })
			E.sec_built_t = now                                               -- step 8: the next request waits for this one's result
			if nodes > (E.sec_nodes0 or 0) then E.sec_watch = { t = now, s0 = secured } end   -- step 8: a node placed - does it stand up?
			E.sec_dead, E.sec_t = 0, nil
		elseif now - E.sec_t >= eai_num("Energy_SecureVerdict", 25) then
			E.sec_dead, E.n_sec_dead = E.sec_dead + 1, E.n_sec_dead + 1
			eai_log("ENERGY", "secure", "dead", "after", math.floor(now - E.sec_t), "s", "nodes", nodes, "secured", secured,
				"power points ours", pw and pw.own or "?", "without a node", pw and pw.unsec or "?", "squads", (cache and cache.military_count) or -1)
			E.sec_t = nil
		else
			E.n_sec_hold = E.n_sec_hold + 1
			if pw ~= nil and (pw.unsec or 0) > 0 then EliteAI.build_open = now end   -- main.ai's order book: the squads at the point stay
			return true                                                       -- the verdict is open: no second request
		end
	end
	E.sec_n = secured
	if E.sec_dead >= eai_num("Energy_SecureTries", 2) then
		local mute = (pw ~= nil and (pw.unsec or 0) > 0) and eai_num("Energy_SecureMuteKnown", 20) or eai_num("Energy_SecureMute", 60)
		E.sec_dead = 0
		E.sec_mute = now + mute
		eai_log("ENERGY", "secure", "hold", "dead", "the last", eai_num("Energy_SecureTries", 2), "requests were killed as inactive (nobody builds it): none for",
			mute, "s", "bank", s_rp(cache.resources), "requests", E.n_sec_req, "dead", E.n_sec_dead)
	end
	if pw ~= nil and (pw.unsec or 0) <= 0 then E.n_sec_none = (E.n_sec_none or 0) + 1; return true end   -- no power point of ours without a node
	-- STEP 8 (ENERGY 0.18; VANILLA_BASE_RU.md 21.2 / 21.6 p.1): THE NODES AS PEOPLE BUILD THEM. s7_* - 4 node orders by 10:00 (people: 2 posts
	-- at ALL points), 1375-1750 req on nodes for an IG against Elite Normal. Four holds, every one with its counter in "ENERGY stats8":
	-- (1) the result of the last request first (s7_en_a p1003: "req t 295 ... built ... nodes 0->1", 4 s later "req t 299 nodes 1" - the
	--     same point while its node was being built; "built ... secured 1->2", then "req t 316 ... dead" - the scan still read the point
	--     without its node): no request while every point of ours without a node has one being built (PBG_GetCount of the node counts
	--     the ones being built), nor for Energy_SecureSettle (20 s) after a "built" verdict and until mechanics.ai's scan is newer than
	--     it (at most Energy_SecureSettleMax 60 s). "ENERGY secure hold settle ...", sec_settle;
	local held_all = math.max(secured, (pw ~= nil) and ((pw.own or 0) - (pw.unsec or 0)) or 0) + nodes   -- the nodes we have (standing + being built)
	-- (5) step 8, the smoke s8_sm_en (IG 1003): "secure built ... nodes 0->1 secured 1->1" at 239 / 316 / 435 / 540 s - each node razed
	--     WHILE BEING BUILT at the forward point: mechanics.ai counts a loss only of a finished node, so the point never cooled. A node
	--     placed that is gone (nodes 0) before the point counts as secured is "lost while being built": no new node for
	--     Energy_SecureFailHold (120 s) x the losses in a row (at most Energy_SecureFailMax 360 s) while a node of ours stands; a node
	--     that stands up ends the row. "ENERGY secure lost while being built ...", "secure hold failed", sec_fail in stats8.
	local W8 = E.sec_watch
	if W8 ~= nil then
		if secured > W8.s0 then E.sec_watch, E.sec_fails = nil, 0
		elseif nodes == 0 and now - W8.t >= 5 then
			E.sec_watch, E.sec_fails, E.sec_fail_t = nil, (E.sec_fails or 0) + 1, now
			E.n_sec_fail = (E.n_sec_fail or 0) + 1
			eai_log("ENERGY", "secure", "lost while being built", "after", math.floor(now - W8.t), "s", "in a row", E.sec_fails, "secured", secured,
				"hold", math.min(eai_num("Energy_SecureFailHold", 120) * E.sec_fails, eai_num("Energy_SecureFailMax", 360)), "s", "points", tostring(pw and pw.pts or "-"))
		elseif now - W8.t > 90 then E.sec_watch = nil end
	end
	if (E.sec_fails or 0) > 0 and E.sec_fail_t ~= nil and held_all >= 1 and eai_num("Energy_SecureFailHold", 120) > 0
		and now - E.sec_fail_t < math.min(eai_num("Energy_SecureFailHold", 120) * E.sec_fails, eai_num("Energy_SecureFailMax", 360)) then
		E.n_sec_failhold = (E.n_sec_failhold or 0) + 1
		e_say("secure_fail", 60, "ENERGY", "secure", "hold", "failed", "lost while being built", E.sec_fails, "in a row", "for", math.floor(now - E.sec_fail_t), "s", "nodes", held_all)
		return true
	end
	if eai_num("Energy_SecureSettle", 20) > 0 and pw ~= nil then
		local bt = E.sec_built_t
		local why
		if nodes > 0 and (pw.unsec or 0) - nodes <= 0 then E.sec_bld_t = E.sec_bld_t or now else E.sec_bld_t = nil end
		if E.sec_bld_t ~= nil and now - E.sec_bld_t < eai_num("Energy_SecureBuildMax", 90) then why = "building"   -- (a node nobody finishes: asked again after 90 s)
		elseif bt ~= nil and now - bt < eai_num("Energy_SecureSettleMax", 60) and (now - bt < eai_num("Energy_SecureSettle", 20) or (pw.t or 0) <= bt) then why = "settle" end
		if why ~= nil then
			E.n_sec_settle = (E.n_sec_settle or 0) + 1
			e_say("secure_settle", 30, "ENERGY", "secure", "hold", "settle", why, "nodes being built", nodes, "secured", secured, "power points ours", pw.own or 0,
				"without a node", pw.unsec or 0, "since built", bt and math.floor(now - bt) or -1)
			return true
		end
	end
	-- (2) people's count by 10:00: Energy_NodeCap10 (2) nodes of ours (standing + being built, at any point) until Energy_NodeCapUntil
	--     (600 s) - no third node before it, whatever asks for one. "ENERGY secure hold cap10 ...", sec_cap10;
	if now < eai_num("Energy_NodeCapUntil", 600) and eai_num("Energy_NodeCap10", 2) > 0 and held_all >= eai_num("Energy_NodeCap10", 2) then
		E.n_sec_cap10 = (E.n_sec_cap10 or 0) + 1
		e_say("secure_cap10", 60, "ENERGY", "secure", "hold", "cap10", "nodes", held_all, "of", eai_num("Energy_NodeCap10", 2), "t", math.floor(now), "people have 2 posts by 10:00")
		return true
	end
	-- step 7 (mechanics.ai 1.8): every point of ours without a node lost one PowLostN times and was razed / seen the enemy lately -
	-- not asked for again at once (s6: 5-6 nodes by 12:00 at the forward points, 625-750 req)
	-- (the smoke s7_sm_tyr: never down to no node at all - with every node razed the next one is asked for at once, as before)
	-- (3) step 8: mechanics.ai 1.9 cools a point after ONE loss (PowLostN 1); the point stays without a new node while it is cooled
	--     (the loss is fresh or the enemy was seen there) - also with no node of ours standing, when the power bank is at least
	--     Energy_SecureCoolPow (Swap_FloatPow, 300): the power is not what we lack. "secure hold razed ...", sec_cool / sec_cool_pow;
	if pw ~= nil and type(pw.unsec_ok) == "number" and pw.unsec_ok <= 0 and (pw.cooled or 0) > 0 and eai_num("Energy_SecureCool", 1) >= 1 then
		local other = ((pw.own or 0) - (pw.unsec or 0) >= 1)
		local rich = (eai_num("Energy_SecureCoolPow", eai_num("Swap_FloatPow", 300)) > 0 and cache.resources ~= nil
			and (cache.resources.power or 0) >= eai_num("Energy_SecureCoolPow", eai_num("Swap_FloatPow", 300)))
		if other or rich then
			E.n_sec_cool = (E.n_sec_cool or 0) + 1
			if not other then E.n_sec_cool_pow = (E.n_sec_cool_pow or 0) + 1 end
			e_say("secure_cool", 60, "ENERGY", "secure", "hold", "razed", "power points without a node", pw.unsec, "lost there again and again", pw.cooled,
				"points", tostring(pw.pts or "-"), "bank", s_rp(cache.resources), "by", other and "another node" or "the power bank")
			return true
		end
	end
	-- (4) after Energy_SecureCapAt (720 s): the nodes built in the last Energy_SecureCapWin (240 s) and this one no more than
	--     Energy_SecureCapK (0.15) of the req income of that time (the rate x the slot's multiplier) - one node a window always, while
	--     a node of ours stands (none = asked for). "ENERGY secure hold spend ...", sec_capspend.
	if eai_num("Energy_SecureCapK", 0.15) > 0 and now >= eai_num("Energy_SecureCapAt", 720) and held_all >= 1 and cache.resources_rate ~= nil then
		local win, spent = eai_num("Energy_SecureCapWin", 240), 0
		for _, h in ipairs(E.sec_hist or {}) do if now - h.t < win then spent = spent + h.r end end
		local _, kr = EliteAI_IncomeK()
		local inc = (cache.resources_rate.requisition or 0) * kr * win / 60
		local price = (E.sec_req ~= nil and E.sec_req > 0) and E.sec_req or 125
		if spent > 0 and spent + price > eai_num("Energy_SecureCapK", 0.15) * inc then
			E.n_sec_capspend = (E.n_sec_capspend or 0) + 1
			e_say("secure_capspend", 60, "ENERGY", "secure", "hold", "spend", "nodes", math.floor(spent), "+", math.floor(price), "of the income", math.floor(inc),
				"in", win, "s", "share", eai_num("Energy_SecureCapK", 0.15))
			return true
		end
	end
	E.sec_first = (pw ~= nil)                                               -- there is one: the unit's reserve does not cut the request
	-- 0.10 (TECH_RU.md 21.2): the first node always; another one only while the power is what we wait for (Malum fb 621: nine
	-- nodes = 1125 req, most of them with 220-300 power in the bank)
	-- 0.11 (TECH_RU.md 21.13; the polygon's s_tempo: nodes asked at 92 / 113 / 134 s with "nodes 0 secured 2 / 3 / 4" and "gen_need
	-- no" - 375 req while a sentinel waited for its money for 147 s): PBG_GetCount of the node counts the ones being BUILT
	-- ("nodes 0->1 secured 0->0", then "nodes 2->1 secured 0->1": a finished node is a secured point, not a count), so
	-- "nodes >= Energy_NodeBase" was true only during a construction. The nodes we have = being built + secured points.
	local nodes_all = nodes + ((eai_num("Energy_NodeSecured", 1) >= 1) and secured or 0)
	-- STEP 7 (ENERGY 0.17; Malum 12.11, newai-22, the bot's whole match on ONE secured power point: "secure hold need nodes 2 the power is
	-- not what we wait for" with 340-920 power in the bank, so the second point never got its node - no place for the generator
	-- a raid took). The nodes come by people's clock too: Energy_Node2At (300 s) the second, Energy_Node3At (600 s, at T2 or
	-- later) the third - counted as the power points of ours that hold a node (mechanics.ai: own less unsec) - when a power point
	-- of ours without a node is there (and not cooled, mechanics.ai 1.8) and the req rate (x the slot's multiplier) is at least
	-- Energy_GenHumanRate (150). Such a node is not held by "the power is not what we wait for" nor by the idle power: a big
	-- power bank is a reason to spend it (the dear unit, the upgrades), not to leave a point unsecured. "ENERGY secure want human
	-- nodes A of B". Energy_NodeHuman=0 = off.
	local hnode = false
	-- (step 8, s8_sm_en: "want human nodes 1 of 2" asked the node of the forward point again after every cooling - x2, x3, x4 losses:
	-- people's clock counts only a point that never lost its node, pw.unsec_new of mechanics.ai 1.9; Energy_NodeHumanFresh=0 = any)
	local fresh_ok = (eai_num("Energy_NodeHumanFresh", 1) < 1 or pw == nil or pw.unsec_new == nil or pw.unsec_new > 0)
	if eai_num("Energy_NodeHuman", 1) >= 1 and pw ~= nil and (pw.unsec or 0) > 0 and (pw.unsec_ok == nil or pw.unsec_ok > 0) and fresh_ok and cache.resources_rate ~= nil then
		local tier = cache.tech_tier_level or 1
		local want = 1
		if now >= eai_num("Energy_Node2At", 300) then want = 2 end
		-- step 8: people's "2 posts" are the nodes at ALL points - the third by the clock is off (Energy_Node3At 0; 600 = as 0.17)
		if tier >= 2 and eai_num("Energy_Node3At", 0) > 0 and now >= eai_num("Energy_Node3At", 0) then want = 3 end
		local held = held_all                                              -- step 8: every node of ours, standing or being built (0.17: own less unsec)
		local _, kr = EliteAI_IncomeK()
		if held < want and (cache.resources_rate.requisition or 0) * kr >= eai_num("Energy_GenHumanRate", 150) then
			hnode = true
			if want >= 2 then e_say("secure_human", 60, "ENERGY", "secure", "want", "human", "nodes", held, "of", want, "t", math.floor(now), "power points ours", pw.own or 0,
				"without a node", pw.unsec or 0, "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate)) end
		end
	end
	if nodes_all >= eai_num("Energy_NodeBase", 1) and eai_num("Energy_GenNeed", 1) >= 1 then
		local need, nwhy = EliteAI_EnergyGenNeed( now )                        -- (defined below, with the generators' plan)
		-- (step 6: the plan is behind and no power point of ours has a free place - this node is the only way to a generator)
		if not need and E.gen_behind == true and pw ~= nil and e_slots( pw ) <= 0 and eai_num("Energy_GenSite", 1) >= 1 then need = true end
		if not need and hnode then need = true; E.n_sec_human = (E.n_sec_human or 0) + 1 end   -- step 7: people's clock
		if not need then
			E.n_sec_noneed = (E.n_sec_noneed or 0) + 1
			e_say("secure_need", 60, "ENERGY", "secure", "hold", "need", "nodes", nodes_all, "the power is not what we wait for", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate))
			return true
		end
	end
	if now < E.sec_mute then E.n_sec_hold = E.n_sec_hold + 1; return true end
	if pending >= eai_num("Energy_SecureMax", 1) then return true end       -- one at a time: every pending one is 125 req nobody else may spend
	if eai_num("Energy_SecureHold", 1) >= 1 and EliteAI_EnergyFloat() and not hnode then  -- a power node while the power lies idle (step 7: not one by people's clock)
		E.n_sec_hold = E.n_sec_hold + 1
		e_say("secure_float", 60, "ENERGY", "secure", "hold", "float", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate))
		return true
	end
	return false
end
-- 0.4 BUDGET_ResourceAddOn (the generators), before Elite's purchase function: true = no request this tick.
-- 0.5 (TECH_RU.md 14): s17 (IG) - 10 lines "buy_gen ... by count" for the generators 1 -> 4 ("generators 3" four times in 110 s),
-- Orca's match "gen 17x 1700". The count (PBG_GetCount over s_resource_structures, as Util_CountResourceBuildRequests :36
-- walks them) goes up the tick after a request and comes down again when the request dies - the builder is a squad the
-- director orders about - so "more than at the last tick" booked one generator many times. Now two things apart:
--  * the request of the last tick is ALIVE when its task is there or there are more generators than at the moment it was
--    placed (E.gen_n0), else dead; Energy_GenTries (2) dead in a row = none for Energy_GenMute (60 s), "ENERGY gen hold dead";
--  * the BOOK notes a generator when it stands: the count has been above the level the book knows (E.gen_book; what stood
--    at the first look is no purchase) for Energy_GenStand (20 s) without a break - the lowest count of that time is the new
--    level, "buy_gen <t> R/P by stand generators N". A level that is gone for Energy_GenLost (45 s) is lowered ("ENERGY
--    gen lost"): the generator was destroyed, the next one is a purchase again.
-- 0.9 (TECH_RU.md 20.1) THE GENERATOR PLAN. "One or two generators in every game" (Orca fb 588, Malum fb 593) is Elite's own cap:
-- strategy_resourcing.ai:194 stops at "generators >= structure.limit + tier - 3", and the limit of the race's personality
-- (personality/<race>/standard.ai - the one file every difficulty loads: personality.ai:124 sets "standard" for all, and
-- default.ai:36-54 reads a variable that is never set, so build_max is 3 on every level) is build_max for the tyranids = 1 / 2 /
-- 3 generators at T1 / T2 / T3, build_max + 1 for the orks (2 / 3 / 4), + 2 for IG, marines, chaos, GK, tau (3 / 4 / 5), + 3 for
-- the eldar. Every stand match shows it: the tyranids held one generator until T2 and two after it, IG three and four.
-- The new logic sets the limit itself, before Elite's rule reads it: Energy_GenPlanBase (2) generators from the start, one
-- more every Energy_GenPlanSecs (150 s), at least Energy_GenPlanT2 (4) with T2 and Energy_GenPlanT3 (6) with T3, never more
-- than Energy_GenPlanMax (6) and, beyond the base, never more than the army has squads less one (the first units come first).
-- Elite's other rules stay (a node with a free place, one request at a time, the req rule). Behind the plan the request is
-- not cut by the unit the upgrades wait for, and the float holds the generators only from Energy_GenFloor (4) up.
-- Energy_GenPlan=0 = Elite's limits. Lines "ENERGY gen plan ...", "ENERGY gen req ...".
-- STEP 4 OF THE VANILLA BASE (ENERGY 0.14; VANILLA_BASE_RU.md 14.1) THE REAL INCOME. AIResource_GetCurrentResourceRate (cache.ai:156,
-- "rate" in every line of ours) is not what the bank gets: in every run of the stand (s1 - s3h, every mode) the bank of the
-- players 1001-1003 - the computer slots, Hard - grows 1.30-1.33 times faster than the rate says, in both resources; the bank
-- of player 1000 (the local slot handed to the AI) grows by the rate. s3h_b4, the orks of this side, 19:30-20:30 with nothing
-- bought: "pow 660 -> 702 -> 743" = 82-84 a minute at "powr 62-66". Every rule that compares the rate with a number measured
-- where the two were the same is 30 % off on such a slot - the generators' need most of all: Energy_GenRateT1 / T2 / T3 =
-- 40 / 60 / 85 a minute. s3h, 7 mirrors, this side: 15 generator requests between 6:00 and 12:00 by "rate" / "count" (the
-- rate 52-63 against the floor 60 at T2 - the bank really got 68-82) against 3 of the released AI, the team's power rate
-- 61-63 against 53-54 for the rest of the match, and the power bank at the end 663 (orks) / 535 (IG) against 309 / 346 -
-- while this side SPENT as much power or more (1004 / 1124 against 810 / 1106): the bank is the generators', not the
-- purchases'. What a generator brings is what the bank gets, so the need reads the real income:
--   e_income (every purchase tick): per resource a window that grows while the bank does not fall (a payment, a gap of 15 s
--   or a tick that brought less than Energy_IncomePayK 0.4 of what the rate promised starts it anew); after Energy_IncomeWin
--   (24 s) the factor = the bank's growth / what the rate promised, taken when it lies in 0.7 .. 2.5 and smoothed 0.7 / 0.3.
--   EliteAI_IncomeK() -> the power factor, the req factor, each between 1 and Energy_IncomeMax (1.6); 1 until the first window.
-- e_gen_need multiplies both rates by it ("unit", "tier", "rate", "count", "income"). Numbers only, no engine call but the
-- clock. Lines "ENERGY income x<pow>/<req> ..." when the factor is first known and when it moves by 0.1; "income_k" in the
-- stats. Energy_IncomeK=0 = the rate as it is, as 0.13.
local function e_inc_one( I, key, now, bank, rate, min_exp )
	local w = I[key]
	if w ~= nil and now == w.t then return end                               -- (a second call in the same tick: nothing new)
	local step = (w ~= nil) and rate * (now - w.t) / 60 or 0
	if w == nil or now < w.t or now - w.t > 15 or bank < w.last or (step > 0 and bank - w.last < step * eai_num("Energy_IncomePayK", 0.4)) then
		I[key] = { t0 = now, t = now, b0 = bank, last = bank, exp = 0 }
		return
	end
	w.exp = w.exp + step
	w.t, w.last = now, bank
	if now - w.t0 >= eai_num("Energy_IncomeWin", 24) and w.exp >= min_exp then
		local k = (bank - w.b0) / w.exp
		if k >= 0.7 and k <= 2.5 then
			local kk, nk = "k" .. key, "n" .. key
			I[kk] = (I[kk] == nil) and k or (I[kk] * 0.7 + k * 0.3)
			I[nk] = (I[nk] or 0) + 1
		end
		I[key] = { t0 = now, t = now, b0 = bank, last = bank, exp = 0 }
	end
end
function EliteAI_IncomeK()
	local I = EliteAI_E and EliteAI_E.inc
	if I == nil or eai_num("Energy_IncomeK", 1) < 1 then return 1, 1 end
	local max = eai_num("Energy_IncomeMax", 1.6)
	return math.max(1, math.min(I.kp or 1, max)), math.max(1, math.min(I.kr or 1, max))
end
local function e_income( now, req, pow )
	local E = EliteAI_E
	if eai_num("Energy_IncomeK", 1) < 1 or cache == nil or cache.resources_rate == nil then return end
	local I = E.inc
	if I == nil then I = {}; E.inc = I end
	e_inc_one( I, "p", now, pow, cache.resources_rate.power or 0, eai_num("Energy_IncomeMinPow", 8) )
	e_inc_one( I, "r", now, req, cache.resources_rate.requisition or 0, eai_num("Energy_IncomeMinReq", 40) )
	local kp, kr = EliteAI_IncomeK()
	if I.kp ~= nil and (I.said_kp == nil or math.abs(kp - I.said_kp) >= 0.1) then
		I.said_kp = kp
		eai_log("ENERGY", "income", string.format("x%.2f/%.2f", kp, kr), "the bank's growth against the rate: pow", string.format("%.2f", I.kp), "windows", I.np or 0,
			"req", string.format("%.2f", I.kr or 1), "windows", I.nr or 0, "t", math.floor(now), "rate", s_rp(cache.resources_rate), "(the generators' need reads rate x this)")
	end
end
EliteAI_EnergyIncome = e_income                                             -- the stub run
local function e_gen_have()
	local have, tot = 0, 0
	if type(s_resource_structures) == "table" then
		for _, v in pairs(s_resource_structures) do                          -- sums: the order of pairs() does not matter
			if v and v.pbg and not e_is_secure( v ) then
				have = have + (PBG_GetCount( s_selfplayer, v.pbg ) or 0)
				tot = tot + (UtilPBG_CountTotal( v.pbg ) or 0)                  -- with the active tasks: what Elite's limit reads
			end
		end
	end
	return have, tot
end
local function e_gen_plan( now )
	if eai_num("Energy_GenPlan", 1) < 1 then return nil end
	local tier, army = (cache and cache.tech_tier_level) or 1, (cache and cache.military_count) or 0
	local base, max = eai_num("Energy_GenPlanBase", 2), eai_num("Energy_GenPlanMax", 6)
	local cap, why = base + math.floor(now / math.max(eai_num("Energy_GenPlanSecs", 150), 1)), "time"
	local tmin = (tier >= 3) and eai_num("Energy_GenPlanT3", 6) or ((tier >= 2) and eai_num("Energy_GenPlanT2", 4) or 0)
	if cap < tmin then cap, why = tmin, "tier" end
	if eai_num("Energy_GenPlanArmy", 1) >= 1 and cap > base and cap > army - 1 then cap, why = math.max(base, army - 1), "army" end
	-- STEP 6 (ENERGY 0.16; VANILLA_BASE_RU.md 18): PEOPLE'S GENERATORS. Orca (newai-22, IG Normal, 12.11): "only 2 gens again" -
	-- "gen plan cap 2 by time" from 0:01 to 5:44: the clock gives the third at 2:30, the army rule ("never more than the squads
	-- less one") held it at two until the fifth squad. People (human_plan.ai "gens", the median of the strong: IG, orks, eldar 3 by
	-- minute 5, the others 2; all 3 by minute 10) build the third early. The floor of the plan: gens.m5 from Energy_GenHumanT5
	-- (225 s = 3:45), gens.m10 from Energy_GenHumanT10 (540 s), over the army rule and the "need" (e_gen_limits), when the income
	-- allows - the req rate (x the slot's multiplier) >= Energy_GenHumanRate (150, vanilla's own healthy economy) and the power
	-- does not lie idle (bank < Energy_GenCountBank 300, no float). Energy_GenHuman=0 = off. "by human" in "ENERGY gen plan".
	local E = EliteAI_E
	E.gen_hfloor, E.gen_htarget = 0, 0
	if eai_num("Energy_GenHuman", 1) >= 1 and cache ~= nil and cache.resources_rate ~= nil and type(EliteAI_HumanPlan) == "function" then
		local H = EliteAI_HumanPlan()
		local g = (type(H) == "table" and type(H.gens) == "table") and H.gens or nil
		if g ~= nil then
			local hc = 0
			local _, kr = EliteAI_IncomeK()
			local rr = (cache.resources_rate.requisition or 0) * kr
			local bp = (cache.resources and cache.resources.power) or 0
			-- (step 7, VANILLA_BASE_RU.md 19.2: the floor added power nobody spent - the bank at the end 582 / 923 against 519 / 781 of
			-- step 5. gens.m10 holds only when the power bank stayed below Swap_FloatPow (300) for the last Energy_GenHumanLowSecs
			-- (120 s); m5 as before. Energy_GenHumanLowSecs=0 = as 0.16)
			if bp >= eai_num("Swap_FloatPow", 300) then E.gen_pow_hi_t = now end
			if now >= eai_num("Energy_GenHumanT5", 225) then hc = tonumber(g.m5) or 0 end
			local lows = eai_num("Energy_GenHumanLowSecs", 120)
			if now >= eai_num("Energy_GenHumanT10", 540) then
				if lows <= 0 or now - (E.gen_pow_hi_t or -100000) >= lows then hc = math.max(hc, tonumber(g.m10) or 0)
				elseif (tonumber(g.m10) or 0) > hc then E.n_gen_m10_skip = (E.n_gen_m10_skip or 0) + 1 end
			end
			-- (step 7, Malum 12.11: people's count by the clock alone, whatever the bank - the generators a raid took are rebuilt to it, e_gen_limits)
			local ht = 0
			if now >= eai_num("Energy_GenHumanT5", 225) then ht = tonumber(g.m5) or 0 end
			if now >= eai_num("Energy_GenHumanT10", 540) then ht = math.max(ht, tonumber(g.m10) or 0) end
			if rr >= eai_num("Energy_GenHumanRate", 150) then E.gen_htarget = math.min(ht, max) end
			if hc > 0 and rr >= eai_num("Energy_GenHumanRate", 150) and bp < eai_num("Energy_GenCountBank", 300) and not EliteAI_EnergyFloat() then
				E.gen_hfloor = math.min(hc, max)
				if cap < E.gen_hfloor then cap, why = E.gen_hfloor, "human" end
			end
		end
	end
	if cap > max then cap, why = max, "max" end
	return cap, why, tier
end
-- 0.10 (TECH_RU.md 21.2) IS THE POWER WHAT WE WAIT FOR? The plan of 0.9 builds by the clock: 6 generators and 2 nodes = 850 req by
-- 10-12 minutes whatever the power bank holds. 20.10: the power bank at the end 870-1250 in all four stand AIs; Malum's grey
-- knights (fb 621): 12 generators and 9 nodes = 2325 req in 26 minutes - seven squads - with 220-300 power in the bank from the
-- 12th minute on, each farm the enemy razed rebuilt at once. A generator is worth its 100 req only while the power is the
-- short resource. Beyond the base (Energy_GenPlanBase, 2) the plan asks for one only when
--   "unit": the unit the pipeline waits for lacks power and the power comes later than its req (by Energy_GenNeedLead, 10 s), or
--   "tier": the power income will not bring the next tier's power by the plan's time (EliteAI_T, the state of this tick), or
--   "rate": the power income is below the tier's floor (Energy_GenRateT1 / T2 / T3 = 40 / 60 / 85 a minute: what the units and
--           the upgrades of that tier take at this req income) and the power bank is below Energy_GenNeedBank (150).
-- After the enemy razed generators ("ENERGY gen lost") the base does not hold for Energy_GenRaidSecs (150 s): no rebuilding by the
-- clock into the same raid, only by need. The node follows the same question (e_secure_gate): the first one always, another
-- only while the power is needed. Energy_GenNeed=0 = the plan of 0.9. Lines "ENERGY gen plan cap N by need ... need <why>".
local function e_gen_need( now )
	local E = EliteAI_E
	if eai_num("Energy_GenNeed", 1) < 1 or cache == nil or cache.resources == nil or cache.resources_rate == nil then return true, "off" end
	local br, bp = cache.resources.requisition or 0, cache.resources.power or 0
	local rr, rp = cache.resources_rate.requisition or 0, cache.resources_rate.power or 0     -- per minute (cache.ai:156)
	local kp, kr = EliteAI_IncomeK()                                         -- step 4 (0.14): what the bank really gets (1, 1 = the rate)
	rr, rp = rr * kr, rp * kp
	local st = E.stall
	if st ~= nil and now - (st.t or -1000) <= 7 and st.why == "money" and (st.pow or 0) > bp then
		local pe = (rp > 0) and 60 * (st.pow - bp) / rp or 9999
		local re = 0
		if (st.req or 0) > br then re = (rr > 0) and 60 * (st.req - br) / rr or 9999 end
		if pe > re + eai_num("Energy_GenNeedLead", 10) then return true, "unit" end
	end
	local T = EliteAI_T
	if type(T) == "table" and T.k ~= nil and (T.cost_pow or 0) > 0 and type(T.st) == "table" then
		local ts = T.st[T.k]
		if not (type(ts) == "table" and ts.started) then
			local left = math.max(0, (T.plan_tt or 0) - now)
			if bp + rp * left / 60 < T.cost_pow then return true, "tier" end
		end
	end
	local tier = cache.tech_tier_level or 1
	local floor = (tier >= 3) and eai_num("Energy_GenRateT3", 85) or ((tier >= 2) and eai_num("Energy_GenRateT2", 60) or eai_num("Energy_GenRateT1", 40))
	if rp < floor and bp < eai_num("Energy_GenNeedBank", 150) then return true, "rate" end
	-- 0.12 (step 2 of the vanilla base; VANILLA_BASE_RU.md 8): s1_ork_ig 10:00-13:30 - "gen plan cap 0 by need have 0 ... rate 189/39
	-- need no": no generator stood (the enemy razed them at 5:58 and 10:36), the power income was 16-39 a minute at T2 (the
	-- floor is 60) and the plan said the power was not needed, because 171-201 power lay in the bank (>= 150) - what was left
	-- of the income of the generators that were gone. A bank is the past; the income is what the next units and the next tier
	-- are paid with. "count": fewer generators (standing or being built) than the tier's minimum - Energy_GenMinT1 / T2 / T3 =
	-- 2 / 3 / 4 - with the income below the tier's floor is a need whatever the bank holds, short of a float (the power
	-- really lies idle) or Energy_GenCountBank (500). "income": the income below Energy_GenLowK (0.5) of the floor likewise.
	-- After a raid ("gen lost") not for Energy_GenRaidWait (40 s; the clock's own rebuilding still waits Energy_GenRaidSecs).
	-- Energy_GenCount=0 = as 0.11.
	-- STEP 3 (0.13): ... and not above Energy_GenCountBank 300 (was 500) - the float's own mark (Energy_FloatPow): with that
	-- much power in the bank the "three generators" are a number, not a need (s2: IG 150-300 power in the bank from 3:35 to
	-- 12:30 with 60 a minute from its points - nothing waited for power)
	if eai_num("Energy_GenCount", 1) >= 1 and rp < floor and bp < eai_num("Energy_GenCountBank", 300) and not EliteAI_EnergyFloat()
		and (E.gen_raid_t == nil or now - E.gen_raid_t >= eai_num("Energy_GenRaidWait", 40)) then
		local _, tot = e_gen_have()
		local min = (tier >= 3) and eai_num("Energy_GenMinT3", 4) or ((tier >= 2) and eai_num("Energy_GenMinT2", 3) or eai_num("Energy_GenMinT1", 2))
		if tot < min then return true, "count" end
		if rp < floor * eai_num("Energy_GenLowK", 0.5) then return true, "income" end
	end
	return false, "no"
end
EliteAI_EnergyGenNeed = e_gen_need                                          -- the stub run
-- called before Elite's ResourceStructureDemand: the limits of the generators by the plan; returns the plan's cap, the
-- generators that stand, and those with the active tasks (nil = no plan)
local function e_gen_limits( now )
	local E = EliteAI_E
	local cap, why, tier = e_gen_plan( now )
	local have, tot = e_gen_have()
	if cap ~= nil then
		local base = eai_num("Energy_GenPlanBase", 2)
		if E.gen_raid_t ~= nil and now - E.gen_raid_t < eai_num("Energy_GenRaidSecs", 150) then base = 0 end
		local need, nwhy = e_gen_need( now )
		E.gen_need, E.gen_need_why = need, nwhy
		-- (step 6: people's floor holds over "not needed"; after a raid only Energy_GenRaidWait, 40 s, not the clock's 150 s)
		local hf = E.gen_hfloor or 0
		if E.gen_raid_t ~= nil and now - E.gen_raid_t < eai_num("Energy_GenRaidWait", 40) then hf = 0 end
		if not need and tot >= base and cap > tot and tot >= hf then
			cap, why = tot, "need"
			E.n_gen_noneed = (E.n_gen_noneed or 0) + 1
		elseif not need and tot >= base and cap > hf and hf > tot then
			cap, why = hf, "human"
		end
		-- STEP 7 (ENERGY 0.17; Malum 12.11, newai-22: one secured power point all match, a generator lost and never rebuilt - "cap 3 by
		-- need ... free places 0 ... need no" with 530-870 power in the bank). A generator we HAD and lost is rebuilt up to people's
		-- count by the clock (E.gen_htarget: gens.m5 / m10, the req rate allowing) whatever the power bank, when the engine sees a
		-- place for it (e_slots) - "by restore". A big power bank is a reason to spend the power, not to leave the place empty.
		-- Energy_GenRestore=0 = off.
		if have > (E.gen_peak or 0) then E.gen_peak = have end
		local rc = math.min(E.gen_peak or 0, E.gen_htarget or 0)
		if eai_num("Energy_GenRestore", 1) >= 1 and rc > tot and cap < rc and not (E.gen_raid_t ~= nil and now - E.gen_raid_t < eai_num("Energy_GenRaidWait", 40))
			and e_slots( e_pw( now ) ) > 0 then
			cap, why = rc, "restore"
			E.n_gen_restore = (E.n_gen_restore or 0) + 1
		end
	end
	E.gen_cap, E.gen_have, E.gen_behind = cap, have, (cap ~= nil and tot < cap)
	-- STEP 8 (ENERGY 0.18; VANILLA_BASE_RU.md 21.4 p.6 / 21.6 p.5): THE GENERATOR AHEAD OF THE UNIT. s7: IG at 2 generators to 5:45 and 4 cases of
	-- 120-210 s before a lost one was rebuilt with a place for it - the generator stood behind the units ("gen after the answer
	-- ig_devils 350/35 waits for its req: not ahead of it", the units' budgets took the req first). While fewer generators stand
	-- (with the tasks) than people's count by the clock (E.gen_hfloor: gens.m5 from 3:45, m10 from 9:00 with the power low - the
	-- floor of the plan) and the engine sees a place (e_slots), with no generator request of ours open: "ahead" - the generator is
	-- not held behind an answer, and a unit is no candidate when buying it would leave the bank below the generator's price
	-- (EliteAI_PurchaseMult; heroes aside). At most Energy_GenAheadMax (45 s) a time, then Energy_GenAheadMute (60 s) without it.
	-- "ENERGY gen ahead ...", "gen_ahead" / "gen_ahead_block" in ENERGY stats8. Energy_GenAhead=0 = off.
	local ahead = false
	if cap ~= nil and eai_num("Energy_GenAhead", 1) >= 1 and tot < (E.gen_hfloor or 0) and E.gen_t == nil
		and not (E.gen_raid_t ~= nil and now - E.gen_raid_t < eai_num("Energy_GenRaidWait", 40)) and now >= (E.gen_ahead_mute or -1)
		and e_slots( e_pw( now ) ) > 0 then
		if E.gen_ahead_t0 == nil then
			E.gen_ahead_t0 = now
			E.n_gen_ahead = (E.n_gen_ahead or 0) + 1
			eai_log("ENERGY", "gen", "ahead", "have", tot, "of people's", E.gen_hfloor, "t", math.floor(now), "places", e_slots( e_pw( now ) ), "price", (E.gen_req ~= nil and E.gen_req > 0) and E.gen_req or 100,
				"bank", s_rp(cache.resources), "- the units wait for it", "n", E.n_gen_ahead)
		end
		if now - E.gen_ahead_t0 <= eai_num("Energy_GenAheadMax", 45) then ahead = true
		else
			E.gen_ahead_mute, E.gen_ahead_t0 = now + eai_num("Energy_GenAheadMute", 60), nil
			eai_log("ENERGY", "gen", "ahead", "over", "by the clock", "have", tot, "bank", s_rp(cache.resources))
		end
	elseif E.gen_ahead_t0 ~= nil then E.gen_ahead_t0 = nil end
	E.gen_ahead, E.gen_ahead_at = ahead, now
	if type(s_resource_structures) ~= "table" then return cap, have, tot end
	-- VANILLA BASE (11.11): vanilla's rule is "count >= structure.limit" (strategy_resourcing.ai, no "+ tier - 3" of Elite) and
	-- the Hard personality gives no limit at all (nil = as many as the rules let through). The plan's cap is the limit all
	-- the same; vanilla's own value (or none) is kept and comes back when the plan is off (Energy_GenPlan=0)
	local l0 = nil
	for _, v in pairs(s_resource_structures) do
		if v and v.pbg and not e_is_secure( v ) then
			if not v.eliteai_limit_kept then v.eliteai_limit_kept = true; v.eliteai_limit0 = v.limit end   -- the base's own, for the log
			l0 = v.eliteai_limit0
			if cap ~= nil then v.limit = cap else v.limit = v.eliteai_limit0 end
		end
	end
	if cap == nil then return cap, have, tot end
	-- (0.10: the need moves the cap up and down between the ticks - a line per new value at most once in Energy_GenPlanLog, 20 s)
	if E.gen_cap_said ~= cap and (E.gen_cap_said == nil or now - (E.gen_cap_t or -1000) >= eai_num("Energy_GenPlanLog", 20)) then
		E.gen_cap_said, E.gen_cap_t = cap, now
		local pw = EliteAI and EliteAI.pw
		eai_log("ENERGY", "gen", "plan", "cap", cap, "by", why, "have", have, "with tasks", tot, "tier", tier, "t", math.floor(now),
			"Elite's cap", (l0 ~= nil) and l0 or "none", "army", (cache and cache.military_count) or -1,
			"nodes", e_node_count(), "free places", (type(pw) == "table" and pw.slots) or "?", "engine", (cache and cache.total_pts_secured_w_addon_capacity) or "?",
			"bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "need", tostring(E.gen_need_why or "-"))
	end
	return cap, have, tot
end
EliteAI_EnergyGenPlan = e_gen_plan                                          -- the stub run
-- STEP 6 (ENERGY 0.16): NO PLACE FOR A GENERATOR. Orca (12.11, IG): at 6:23 both generators fell with their points ("gen lost
-- generators 2 -> 0"), then "nodes 0 free places 0" to the end of the log (8:30) - the plan wanted 3-4 and there was nowhere to
-- build one: a generator is an add-on of a SECURED power point of ours (strategy_resourcing.ai: "total_pts_secured_w_addon_capacity",
-- strategic_point_pvp maximum_addon_structures 3; the HQ is no capture point and takes none). True = the plan is behind
-- (fewer generators, with the tasks, than its cap) and mechanics.ai sees no power point of ours with a free place or without
-- its node: then the power points are captured first - Target_CalcCapturePriority x Energy_GenSiteMult (targets.ai, the
-- engine's capture tasks) and the runners' bonus Mech_RunnerPowBonus (mechanics.ai) - and the node of a power point taken is
-- asked for at once (e_secure_gate). Energy_GenSite=0 = off. "gen_site" in ENERGY stats, line "ENERGY gen sites none".
function EliteAI_GenSiteWanted()
	if not s_on() or eai_num("Energy_GenSite", 1) < 1 or cache == nil then return false end
	local E, now = EliteAI_E, World_GetGameTime()
	if E.gen_site_t == now then return E.gen_site == true end
	E.gen_site_t = now
	local pw = e_pw( now )
	-- (the smokes s6_sm_*2: "sites none ... t 4" - at the start no power point is ours yet; the opening's captures stay the engine's
	-- own: from Energy_GenSiteFrom (240 s) on, or once a generator was lost)
	local from = (now >= eai_num("Energy_GenSiteFrom", 240) or E.gen_raid_t ~= nil)
	local want = (from and E.gen_cap ~= nil and E.gen_behind == true and pw ~= nil and e_slots( pw ) <= 0 and (pw.unsec or 0) <= 0)
	if want and not E.gen_site then
		E.n_gen_site = (E.n_gen_site or 0) + 1
		eai_log("ENERGY", "gen", "sites", "none", "have", E.gen_have or "?", "cap", E.gen_cap or "-", "power points ours", pw.own or 0,
			"- the power points are captured first", "t", math.floor(now), "n", E.n_gen_site, "free places", pw.slots or "?", "engine", (cache and cache.total_pts_secured_w_addon_capacity) or "?")
	end
	E.gen_site = want
	return want
end
local function e_gen_gate()
	local E, now = EliteAI_E, World_GetGameTime()
	local tasks = Task_CountInGroup( s_selfplayer, TGROUP_ResourceAddOns )
	-- 0.9: a generator request is never killed by Elite (TGROUP_ResourceAddOns is in no list of default.ai:140-156) and blocks
	-- the next one (strategy_resourcing.ai:169) and 100 req for as long as nobody builds it. One that has been inactive for
	-- Energy_GenTaskMax (60 s) is dropped as Elite drops the others (default.ai:205-216); the plan asks again.
	local tmax = eai_num("Energy_GenTaskMax", 60)
	if tasks > 0 and tmax > 0 then
		local act = Task_CountActiveInGroup( s_selfplayer, TGROUP_ResourceAddOns )
		if act < tasks then EliteAI.build_open = now end                      -- main.ai's order book: the squads at the node stay
		if act >= tasks then E.gen_task_t = nil
		elseif E.gen_task_t == nil then E.gen_task_t = now
		elseif now - E.gen_task_t >= tmax then
			local back = Task_CountGroupCost( s_selfplayer, TGROUP_ResourceAddOns, false )
			ai_budget:add_resources( back, "BUDGET_ResourceAddOn" )
			Task_KillInactiveTasksInGroup( s_selfplayer, TGROUP_ResourceAddOns )
			E.n_gen_stuck = (E.n_gen_stuck or 0) + 1
			eai_log("ENERGY", "gen", "task", "inactive for", math.floor(now - E.gen_task_t), "s (nobody builds it): dropped", "tasks", tasks, "active", act,
				"squads", (cache and cache.military_count) or -1, "bank", s_rp(cache.resources), "n", E.n_gen_stuck)
			E.gen_task_t = nil
			tasks = Task_CountInGroup( s_selfplayer, TGROUP_ResourceAddOns )
		end
	else E.gen_task_t = nil end
	local have = 0
	if type(s_resource_structures) == "table" then
		for _, v in pairs(s_resource_structures) do                          -- a sum: the order of pairs() does not matter
			if v and v.pbg then have = have + (PBG_GetCount( s_selfplayer, v.pbg ) or 0) end
		end
	end
	-- STEP 3 (ENERGY 0.13; VANILLA_BASE_RU.md 11.3): s2_tyr_ig_a, tyranids - "gen req t 771", "gen req t 774", "gen hold dead the last
	-- 2 requests died without a generator (nobody builds it)" at 775 s ... and "gens 2" in the telemetry of 810 s: both
	-- requests were alive. A generator is an add-on the node builds itself - no squad builds it; the task is gone a tick
	-- after it was taken and the count goes up when the engine has placed it, which took 4 s at 88 s and longer here. The
	-- verdict of the next tick called a living request dead, a second one was placed on top of it and the gate went mute
	-- for a minute. Now the verdict stays OPEN for Energy_GenVerdict (30 s; the node has 25): bought when a task is there
	-- or the count is above the one at the request, dead only when neither came in that time; while it is open no second
	-- request is placed. Energy_GenVerdict=0 = the verdict of the next tick, as 0.12.
	local pending = false
	if E.gen_t ~= nil and now > E.gen_t then
		if tasks > 0 or have > (E.gen_n0 or 0) then E.gen_dead = 0; E.gen_t = nil
		elseif now - E.gen_t < eai_num("Energy_GenVerdict", 30) then pending = true; E.n_gen_wait = (E.n_gen_wait or 0) + 1
		else E.gen_dead, E.n_gen_dead = E.gen_dead + 1, E.n_gen_dead + 1; E.gen_t = nil end
	end
	E.gen_n = have
	if E.gen_book == nil then E.gen_book = have end
	if have > E.gen_book then
		E.gen_low_t = nil
		if E.gen_up_t == nil then E.gen_up_t, E.gen_up_min = now, have end
		if have < E.gen_up_min then E.gen_up_min = have end
		if now - E.gen_up_t >= eai_num("Energy_GenStand", 20) then
			local k = E.gen_up_min - E.gen_book
			-- step 8 (the smoke s8_sm_en0, IG 1001: "buy_gen ... by stand generators 4 x2" with no "gen req" - the count of the
			-- generators drops and comes back when a point flips, and the book bought them again: 17-34 "bought" against 9-21 requests
			-- a match in s7 / s8): a rise is a purchase only up to the requests not booked yet; the rest is counted, not bought.
			-- Energy_GenBookReq=0 = as 0.17
			if eai_num("Energy_GenBookReq", 1) >= 1 then
				local free = (E.n_gen_req or 0) - (E.gen_req_booked or 0)
				if k > free then
					eai_log("ENERGY", "gen", "back", "generators", E.gen_book, "->", E.gen_up_min, "requests not booked", math.max(free, 0), "- counted again, not bought")
					E.n_gen_back = (E.n_gen_back or 0) + (k - math.max(free, 0))
					k = math.max(free, 0)
				end
				E.gen_req_booked = (E.gen_req_booked or 0) + k
			end
			local r, p = (E.gen_req or 0) > 0 and E.gen_req or eai_num("Energy_GenReq", 100), E.gen_pow or 0
			if k > 0 then EliteAI_EnergyNote( "gen", { requisition = r * k, power = p * k }, k ) end
			E.gen_book, E.gen_up_t = E.gen_up_min, nil
			if k > 0 then eai_log("buy_gen", math.floor(now), (r * k) .. "/" .. (p * k), "by", "stand", "generators", E.gen_book, "x" .. k) end
		end
	else
		E.gen_up_t = nil
		if have < E.gen_book then
			if E.gen_low_t == nil then E.gen_low_t = now end
			if now - E.gen_low_t >= eai_num("Energy_GenLost", 45) then
				eai_log("ENERGY", "gen", "lost", "generators", E.gen_book, "->", have)
				E.gen_raid_t, E.n_gen_lost = now, (E.n_gen_lost or 0) + (E.gen_book - have)   -- 0.10: no rebuilding by the clock for Energy_GenRaidSecs (e_gen_limits)
				E.gen_book, E.gen_low_t = have, nil
			end
		else E.gen_low_t = nil end
	end
	if E.gen_dead >= eai_num("Energy_GenTries", 2) then
		E.gen_dead = 0
		E.gen_mute = now + eai_num("Energy_GenMute", 60)
		eai_log("ENERGY", "gen", "hold", "dead", "the last", eai_num("Energy_GenTries", 2), "requests died without a generator (nobody builds it): none for",
			eai_num("Energy_GenMute", 60), "s", "bank", s_rp(cache.resources), "requests", E.n_gen_req, "dead", E.n_gen_dead)
	end
	return now < E.gen_mute or pending
end
EliteAI_EnergyGenGate = e_gen_gate                                          -- the stub run
-- after Elite's UpdateSquadDemand (strategy_addon_purchase.ai:71) filled s_addonDemand for one production type: the waits and
-- the multipliers of the new logic on the entries of that type (an entry set to false is skipped by HighestAddonDemand, :28)
-- 0.7 (TECH_RU.md 18.7; Orca's second match): "buy_addon ... wp_hive_venom_cannon 120/30" at 466, 613 and 659 s, "wp_hive_heavy_claw
-- 150/50" at 571, 641 and 1089 s - the hive tyrant's two weapons bought in turns, six purchases, 810 req and 240 power for one
-- weapon slot (an item of a slot replaces the one that is in it; Elite offers every item we do not hold - so the one just
-- replaced is on offer again). The slot of a commander's item by its name (Elite's attributes, upgrade/pvp/<race>/wargear:
-- wp_ / wp1_ / <race>_weapon_ = the weapon, arm_ / _arm_ / <race>_armor_ = the armour, acc_ / <race>_acc_ = the accessory; tau
-- names have no slot in them - no rule). One item per slot and match; an item that answers a class the Counter layer counters
-- may replace it once. Energy_WargearOnce=0 = as before. Line "ENERGY addon skip <item> why wargear_slot ... holds <item>".
local function e_wg_slot( name )
	if not string.find(name, "wargear", 1, true) then return nil end
	local short = string.gsub(name, "^.*[/\\]", "")
	if string.find(short, "^wp%d*_") or string.find(short, "_weapon_", 1, true) then return "weapon" end
	if string.find(short, "^arm%d*_") or string.find(short, "_arm_", 1, true) or string.find(short, "_armor_", 1, true) then return "armour" end
	if string.find(short, "^acc%d*_") or string.find(short, "_acc_", 1, true) then return "accessory" end
	return nil
end
EliteAI_EnergyWargearSlot = e_wg_slot                                       -- the stub run
local function e_addon_filter( PITEM_type )
	if s_addonDemand == nil or cache == nil or cache.resources == nil then return end
	local E, now, bank = EliteAI_E, World_GetGameTime(), cache.resources
	local float = EliteAI_EnergyFloat()
	local save = (type(EliteAI_R) == "table" and EliteAI_R.save == true)
	local rr, rp, pfloor = 0, 0, 0
	if type(EliteAI_TechEval) == "function" then EliteAI_TechEval() end      -- 0.2: the plan of this tick (this run comes before the tech budget's)
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	if type(EliteAI_TechPowerFloor) == "function" then pfloor = EliteAI_TechPowerFloor() or 0 end   -- 0.3: the power the T2 research will need
	rr, rp = rr or 0, rp or 0
	local gar = e_gar_active( now )
	local min_share, low_mult, share_k = eai_num("Energy_AddonMinShare", 0.15), eai_num("Energy_AddonLowMult", 0.25), eai_num("Energy_AddonShareK", 3)
	local cap, cap_why = e_share_cap()                                      -- 0.3: the army's share
	local army_r, add_r = e_spent()
	-- 0.6 (TECH_RU.md 18.3; Orca fb 529: the lascannon was never given against the dreadnought): an upgrade that answers a class
	-- the Counter layer has decided to counter is treated as the anti-garrison upgrades are - it does not wait for the unit, the
	-- upgrades' share of the army or the saved power (the tech reserve and a muted dead request still hold it) - and it is the
	-- first upgrade of this pass: its demand is lifted over the highest of the others (Elite asks for the highest only).
	-- Counter_AddonFirst=0 = the multiplier alone, as 0.5.
	local top, cfirst = 0, eai_num("Counter_AddonFirst", 1) >= 1 and eai_num("Counter_Buy", 1) >= 1 and type(EliteAI_MechCounterAddon) == "function"
	for pbg, dem in pairs(s_addonDemand) do                                 -- (a maximum: the order of pairs() does not matter)
		if pbg and dem ~= false and dem.pitem_type == PITEM_type and (dem.demand or 0) > top then top = dem.demand end
	end
	for pbg, dem in pairs(s_addonDemand) do                                 -- each entry on its own: the order of pairs() does not matter
		if pbg and dem ~= false and dem.pitem_type == PITEM_type then
			local cost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_type, pbg )   -- strategy_addon_purchase.ai:236
			local cr, cp = (cost and cost.requisition) or 0, (cost and cost.power) or 0
			local name = string.lower(PBG_GetName( pbg ) or "")
			local share = e_share( cost )
			local cm, ck = 1, nil
			if cfirst then cm, ck = EliteAI_MechCounterAddon( name ) end
			cm = cm or 1
			local ganti = gar and e_has(name, GAR_ADDON_KEYS)                     -- (against a garrison: step 19)
			-- 0.8 (TECH_RU.md 19.5; the polygon's scene a, r15: "addon first acc_hive_bioplasma class mhero ... bank 351" - 100 req at
			-- 18 s, the zoanthrope 360/40 that r11 bought at 29 s never came, "second unit within 90 s" failed): an upgrade that
			-- answers a class goes past the unit's wait - but not past a unit that is Counter_AddonUnitEta (30 s) of income away
			-- or has its money and waits for the HQ: that unit first, the upgrade right after it
			local unit_near = false
			if E.stall ~= nil and now - (E.stall.t or -1000) <= 7 and E.hold then
				unit_near = (E.stall.why ~= "money") or ((E.stall.eta or 999) <= eai_num("Counter_AddonUnitEta", 30))
			end
			local anti = ganti or (cfirst and cm > 1 and not unit_near)
			local why = nil
			-- (step 6: the dear unit the watchdog waits for - an upgrade may not take the req bank below its price, as "unit_first")
			local _, dreq = EliteAI_DearBlockName()                             -- (step 7: the whole episode)
			dreq = dreq or 0
			local rnofit, rfree, rneed = false, 0, 0
			if cr > 0 and not anti and type(EliteAI_RoomNoFit) == "function" then rnofit, rfree, rneed = EliteAI_RoomNoFit() end
			local slot = (eai_num("Energy_WargearOnce", 1) >= 1) and e_wg_slot( name ) or nil
			local held = slot and E.wg and E.wg[slot] or nil
			if held ~= nil and not (cfirst and cm > 1 and not held.ctr) then why = "wargear_slot"   -- 0.7: the slot has its item
			elseif E.amute[name] ~= nil and now < E.amute[name] then why = "dead_mute"   -- 0.3: its last requests were killed as inactive
			elseif rr > 0 and (bank.requisition or 0) - cr < rr then why = "tech_reserve"
			elseif rp > 0 and cp > 0 and (bank.power or 0) - cp < rp then why = "tech_reserve"   -- 0.3: the reserve's power too
			elseif pfloor > 0 and cp > 0 and not anti and (bank.power or 0) - cp < pfloor then why = "t2_power"   -- 0.3: the power T2 will need
			elseif E.hold and not anti and (bank.requisition or 0) - cr < (E.hold_req or 0) then why = "unit_first"   -- only what would take the unit's req
			elseif dreq > 0 and not anti and cr > 0 and (bank.requisition or 0) - cr < dreq then why = "dear_first"
			elseif rnofit then why = "room_pop"; E.n_room_addon = (E.n_room_addon or 0) + 1   -- step 7: no unit of tier 3 fits yet
			elseif cap < 1 and not anti and cr > 0 and (add_r + cr) > cap * (army_r + add_r + cr) then why = "share"   -- 0.3: over the upgrades' cap
			elseif float and save and share < min_share and not anti then why = "low_pow_save" end
			if why == "share" then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip, E.n_share_skip = E.n_addon_skip + 1, E.n_share_skip + 1
				e_say("skip|share", eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "skip", r_short(name), "why", "share", "cost", s_rp(cost), "bank", s_rp(bank),
					"upgrades", math.floor(add_r), "army", math.floor(army_r), "share", string.format("%.2f", (add_r + cr) / (army_r + add_r + cr)),
					"cap", string.format("%.2f", cap), "(" .. cap_why .. ")")
			elseif why == "t2_power" then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip, E.n_pow_skip = E.n_addon_skip + 1, (E.n_pow_skip or 0) + 1
				e_say("skip|t2_power", eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "skip", r_short(name), "why", "t2_power", "cost", s_rp(cost), "bank", s_rp(bank),
					"the T2 research needs", math.floor(pfloor), "power in the bank now")
			elseif why == "wargear_slot" then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip, E.n_wg_skip = E.n_addon_skip + 1, (E.n_wg_skip or 0) + 1
				e_say("skip|wg|" .. name, eai_num("Energy_LogSecs", 30) * 4, "ENERGY", "addon", "skip", r_short(name), "why", "wargear_slot", "cost", s_rp(cost),
					"the", slot, "slot holds", r_short(held.name), "bought at", math.floor(held.t), "s")
			elseif why then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip = E.n_addon_skip + 1
				e_say("skip|" .. why .. "|" .. name, eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "skip", r_short(name), "why", why,
					"cost", s_rp(cost), "bank", s_rp(bank), "reserve", rr, "demand", string.format("%.1f", dem.demand or 0),
					(why == "room_pop") and ("free " .. rfree .. " the unit of the tier takes " .. rneed) or "")
			else
				local m = 1
				if ganti then m = m * eai_num("Gar_AddonMult", 3) end
				-- 0.5: an upgrade that answers a class of the enemy's army the Counter layer counters (flamers, plasma, melta ... by name)
				if not cfirst and type(EliteAI_MechCounterAddon) == "function" and eai_num("Counter_Buy", 1) >= 1 then
					cm = EliteAI_MechCounterAddon( name ) or 1
				end
				if cm ~= 1 then m = m * cm; E.n_counter = (E.n_counter or 0) + 1 end
				if float then
					if share >= min_share then m = m * (1 + share_k * share)
					elseif not anti then m = m * low_mult end
				end
				if m ~= 1 and (dem.demand or 0) > 0 then
					dem.demand = dem.demand * m
					if m > 1 then E.n_addon_boost = E.n_addon_boost + 1 end
					if cfirst and cm > 1 and dem.demand <= top * 1.1 then
						dem.demand = top * 1.1 + 1
						e_say("counter_first|" .. name, eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "first", r_short(name), "class", tostring(ck),
							"demand", string.format("%.1f", dem.demand), "over the highest", string.format("%.1f", top), "cost", s_rp(cost), "bank", s_rp(bank))
					end
					if ganti then
						e_say("gar_addon|" .. name, eai_num("Gar_LogSecs", 30), "GAR", "addon", r_short(name), "x" .. tostring(m), "garrison", tostring(EliteAI.gar.id))
					end
				end
			end
		end
	end
end
-- 0.3 (TECH_RU.md 12; s15: "buy_addon tyr_endless_swarm" 19 times in 75 s with a growing bank, "..execute_3" 8 times). The
-- line was written when the request was PLACED. A request is a task; one the squad cannot start stays inactive, is killed at
-- the next purchase tick (default.ai:201-217 Purchase_KillInActiveBudgetTasks, :249) and - still the highest demand - placed
-- again. Every round it took its cost off what each budget may spend (util/budget.ai:271) for the units run of that tick
-- ("tasks 50/15" in the SPEND stall lines), it was the one request of the addon budget in that pass (strategy_addon_purchase
-- asks for the highest demand only: nothing else of that run was bought), and the book counted it as money spent.
-- Now a request gets its verdict at the next addon tick, after the engine killed the inactive ones: BOUGHT when its task is
-- active (Task_CountActivePBG, strategy_tech_purchase.ai:226), the player has one more of the upgrade (PBG_GetCount,
-- strategy_addon_purchase.ai:119), it is no longer on offer, or the req bank is below what it was at the request; else DEAD.
-- "buy_addon" and the book note the bought ones only (the line keeps the time and the bank of the request and says "by
-- task|count|gone|bank"). Energy_AddonDeadTries (2) dead requests of one upgrade in a row = none for Energy_AddonDeadMute
-- (60 s), then one try at a time: line "ENERGY addon dead ...", the filter's "dead_mute". Between ticks: names and numbers;
-- the PBG is looked up again by its name among the production items of the tick.
local function e_addon_pbg( name )
	for _, pt in ipairs({ PITEM_Upgrade, PITEM_SquadUpgrade }) do
		local n = AIProduction_GetProductionItemCount( s_selfplayer, pt )     -- strategy_addon_purchase.ai:103
		for i = 0, n - 1 do
			local pbg = AIProduction_GetProductionItemAt( s_selfplayer, pt, i )   -- strategy_addon_purchase.ai:105
			if pbg ~= nil and string.lower(PBG_GetName( pbg ) or "") == name then return pbg end
		end
	end
	return nil
end
local function e_addon_settle()
	local E, now = EliteAI_E, World_GetGameTime()
	if table.getn(E.areq) == 0 or cache == nil or cache.resources == nil then return end
	local keep = {}
	local bank_req = cache.resources.requisition or 0
	local tries, mute = eai_num("Energy_AddonDeadTries", 2), eai_num("Energy_AddonDeadMute", 60)
	for _, q in ipairs(E.areq) do
		if q.t >= now then
			table.insert(keep, q)                                           -- placed in this very tick (the budget loop re-runs)
		else
			local by = nil
			local pbg = e_addon_pbg( q.name )
			if pbg == nil then by = "gone"                                  -- not on offer any more: it was taken
			elseif Task_CountActivePBG( s_selfplayer, pbg, true ) > 0 then by = "task"
			elseif (PBG_GetCount( s_selfplayer, pbg ) or 0) > q.cnt then by = "count"
			elseif q.r > 0 and bank_req < q.bank then by = "bank" end
			if by then
				E.abought[q.name] = (E.abought[q.name] or 0) + 1
				local wslot = e_wg_slot( q.name )                                 -- 0.7: the commander's slot has its item now
				if wslot ~= nil then
					E.wg = E.wg or {}
					local ctr = type(EliteAI_MechCounterAddon) == "function" and (EliteAI_MechCounterAddon( q.name ) or 1) > 1
					E.wg[wslot] = { name = q.name, t = q.gt or 0, ctr = ctr or (E.wg[wslot] ~= nil and E.wg[wslot].ctr) or false }
				end
				E.adead[q.name] = nil
				EliteAI_EnergyNote( "addon", { requisition = q.r, power = q.p } )
				if type(EliteAI_MechAddonBought) == "function" then EliteAI_MechAddonBought( q.name ) end   -- 0.6: its carriers shoot vehicles first
				eai_log("buy_addon", q.gt, q.short, q.r .. "/" .. q.p, "bank", q.bank_s, "float", q.float, "share", string.format("%.2f", q.share), "by", by)
			else
				E.n_addon_dead = E.n_addon_dead + 1
				local n = (E.adead[q.name] or 0) + 1
				if n >= tries then
					E.amute[q.name] = now + mute
					E.adead[q.name] = tries - 1                                -- after the mute: one try at a time
					eai_log("ENERGY", "addon", "dead", q.short, q.r .. "/" .. q.p, "killed as inactive", n, "in a row (the squad cannot start it): none for", mute, "s",
						"bank", s_rp(cache.resources), "requests", E.n_addon_req, "dead", E.n_addon_dead)
				else
					E.adead[q.name] = n
				end
			end
		end
	end
	E.areq = keep
end
EliteAI_EnergyAddonSettle = e_addon_settle                                  -- the stub run
function EliteAI_EnergyNoteAddon( cost )                                    -- the addon budget placed a request: which upgrade it was
	if not s_on() then return end
	local E = EliteAI_E
	local name, short, cnt = "?", "?", 0
	if type(HighestAddonDemand) == "function" then
		local pbg = HighestAddonDemand()                                    -- strategy_addon_purchase.ai:22: the table of this tick is unchanged
		if pbg then
			name = string.lower(PBG_GetName( pbg ) or "?")
			short = r_short(name)
			cnt = PBG_GetCount( s_selfplayer, pbg ) or 0
		end
	end
	E.n_addon, E.n_addon_req = E.n_addon + 1, E.n_addon_req + 1
	table.insert(E.areq, { name = name, short = short, r = (cost and cost.requisition) or 0, p = (cost and cost.power) or 0,
		t = World_GetGameTime(), gt = eai_time(), cnt = cnt, float = E.float and 1 or 0, share = e_share(cost),
		bank = (cache and cache.resources and cache.resources.requisition) or 0, bank_s = s_rp(cache and cache.resources) })
end
-- 0.9 (TECH_RU.md 21.13) A SPAWN REQUEST IS NOT A PURCHASE. s27b, orks: "buy 491 / 494 / 498 / 501 / 505 / 508 / 512 ...
-- ork_deff_dread" with the bank growing 266 -> 385 and one dread on the field; then seven "ork_looted_tank" at pop 91-97 of 100
-- and none built; IG: five manticores and five chimeras in 28 s. The line was written and the cost booked ("unit Nx" of ENERGY
-- stats, EliteAI_UnitBuys, the idle clock of the watchdog, the drought clock of the upgrades' arbiter, the end of the save
-- state of the reinforcements, the plan's claim dropped - the upgrades took the bank at 512 s) when the request was PLACED. A
-- request the engine does not start stays inactive, Elite kills it at the next purchase tick (default.ai Purchase_KillInActive
-- BudgetTasks) and - still the first choice - it is placed again. Three causes were found: the money the engine holds for the
-- node a squad walks to (EliteAI_EnergyWalk), no room in the population for THIS squad (PopMargin is 8, a looted tank needs
-- more) and whatever else makes AIProduction_CanProduceNow false. Now, as the upgrades since 0.3 (e_addon_settle):
--  * every spawn request of the two places that ask (TryPurchaseUnitChoice, the watchdog) is noted with the bank and the count
--    of that moment and gets its verdict at the next purchase tick, after Elite's kill: BOUGHT when its task is active
--    (Task_CountActivePBG( .., true ), count_util.ai:25), the player has one more squad of the blueprint (PBG_GetCount), or the
--    req bank is below "then + income - Unit_PaidK (0.9) of the price"; else DEAD.
--  * "buy <t> <sbps> army N tier N [spend [over_lock]] by task|count|bank" (the time of the request) and everything that
--    counts a purchase - for the bought ones only. A dead one: "buy_dead <t> <sbps> R/P bank then -> now pop c/m now 0|1 walk R
--    n N none for S s dead D of Q" - the blueprint is no candidate for Unit_DeadMute (12 s, doubled per dead request in a row
--    up to Unit_DeadMuteMax 60; EliteAI_PurchaseMult returns 0, so Elite's demand, the plan and the watchdog pass it over),
--    and no spawn at all is asked for Unit_DeadPause (5 s per dead request in a row, up to Unit_DeadPauseMax 20).
--  * a blueprint the bank can pay and the engine cannot start now is not asked for (Unit_NowOnly): "SPEND notnow ...", no
--    candidate for Unit_NotNowMute (15 s), nothing locked and no claim left for it (the upgrades are not held for a unit
--    that cannot come).
-- Between ticks: names and numbers; the PBG is looked up again by its name in the buildable list of the tick.
local function u_pbg( name )
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		if pbg ~= nil and string.lower(PBG_GetName( pbg ) or "") == name then return pbg end
	end
	return nil
end
function EliteAI_UnitNoteRequest( pbg, name, cost, src, now_ok )
	if not s_on() or pbg == nil or cost == nil then return end
	local E, now = EliteAI_E, World_GetGameTime()
	local bank = cache and cache.resources
	local r, p = cost.requisition or 0, cost.power or 0
	E.n_unit_req = E.n_unit_req + 1
	table.insert(E.ureq, { name = name, short = r_short(name), r = r, p = p, t = now, gt = eai_time(), src = src or "", now_ok = now_ok and 1 or 0,
		cnt = PBG_GetCount( s_selfplayer, pbg ) or 0, bank = (bank and bank.requisition) or 0, bank_s = s_rp(bank),
		army = (cache and cache.military_count) or -1, tier = EliteAI_P.tier_seen[name] or (cache and cache.tech_tier_level) or -1,
		pop = (cache and cache.current_population_personnel) or -1 })           -- (step 5: the population before it, for p_popcost)
	EliteAI_EnergyPay( "unit", r, p )                                       -- the "asked" half of the book (the tracer of the bank's falls)
	local S = EliteAI_S                                                     -- (step 7: the dear unit's episode ends with its request, whoever placed it)
	if S ~= nil and S.dear_ep ~= nil and name == S.dear_ep.name then
		eai_log("SPEND", "dear", "end", r_short(name), "asked after", math.floor(now - S.dear_ep.t0), "s", "by", (src ~= nil and src ~= "") and src or "task", "tier", S.dear_ep.tier)
		S.dear_ep = nil
		S.n_dear_ok = (S.n_dear_ok or 0) + 1
	end
end
local function u_settle( now )
	local E, S = EliteAI_E, EliteAI_S
	if E.ureq == nil or table.getn(E.ureq) == 0 or cache == nil or cache.resources == nil then return end
	local keep = {}
	local br = cache.resources.requisition or 0
	local rr = (cache.resources_rate and cache.resources_rate.requisition) or 0   -- per minute (cache.ai:156)
	for _, q in ipairs(E.ureq) do
		if q.t >= now then
			table.insert(keep, q)                                           -- placed in this very tick (the budget loop re-runs)
		else
			local by = nil
			local pbg = u_pbg( q.name )
			if pbg ~= nil and Task_CountActivePBG( s_selfplayer, pbg, true ) > 0 then by = "task"
			elseif pbg ~= nil and (PBG_GetCount( s_selfplayer, pbg ) or 0) > q.cnt then by = "count"
			elseif q.r > 0 and br <= q.bank + rr * (now - q.t) / 60 - q.r * eai_num("Unit_PaidK", 0.9) then by = "bank" end
			if by then
				E.udead[q.name], E.udead_t[q.name], E.umute[q.name], E.gdead, E.upause = nil, nil, nil, 0, -1
				local cost = { requisition = q.r, power = q.p }
				EliteAI_EnergyNote( "unit", cost, 1, true )                     -- energy: the book of purchases (asked for at the request)
				S.last_buy, S.n_buy = q.gt, S.n_buy + 1                         -- spend: a spawn resets the idle clock
				if q.src ~= "" then S.bought_hot = S.bought_hot + 1 end
				EliteAI_ReinforceNoteBuy( q.name, cost, now )                   -- reinf: a power unit ends the save state
				E.stall = nil                                                   -- a unit is bought - the plan's claim starts anew
				-- step 5: the population the blueprint takes (the smallest rise seen: models that came in the same seconds
				-- only add)
				local pnow = cache.current_population_personnel or -1
				if (q.pop or -1) >= 0 and pnow - q.pop >= 3 and pnow - q.pop <= 30 then
					local P = EliteAI_P
					P.popcost = P.popcost or {}
					if P.popcost[q.name] == nil or pnow - q.pop < P.popcost[q.name] then P.popcost[q.name] = pnow - q.pop end
				end
				-- (step 6: the clock runs from the end of the research - Room_Restart=1 = a unit of the tier starts it anew, as 0.11)
				if eai_num("Room_Restart", 0) >= 1 and E.room_ref_tier ~= nil and (q.tier or 0) >= E.room_ref_tier then E.room_ref = now end
				if q.src ~= "" then eai_log("buy", q.gt, q.name, "army", q.army, "tier", q.tier, q.src, "by", by)
				else eai_log("buy", q.gt, q.name, "army", q.army, "tier", q.tier, "by", by) end
			else
				E.n_unit_dead, E.gdead = E.n_unit_dead + 1, (E.gdead or 0) + 1
				local n = (E.udead[q.name] or 0) + 1
				if E.udead_t[q.name] ~= nil and now - E.udead_t[q.name] > eai_num("Unit_DeadForget", 120) then n = 1 end
				E.udead[q.name], E.udead_t[q.name] = n, now
				local mute = math.min(eai_num("Unit_DeadMuteMax", 60), eai_num("Unit_DeadMute", 12) * 2 ^ (n - 1))
				E.umute[q.name] = now + mute
				E.upause = now + math.min(eai_num("Unit_DeadPauseMax", 20), eai_num("Unit_DeadPause", 5) * E.gdead)
				eai_log("buy_dead", q.gt, q.name, q.r .. "/" .. q.p, "bank", q.bank_s, "->", s_rp(cache.resources),
					"pop", (cache.current_population_personnel or -1) .. "/" .. (cache.max_population_personnel or -1), "now", q.now_ok, "walk", E.walk_req or 0,
					"n", n, "none for", mute, "s", "dead", E.n_unit_dead, "of", E.n_unit_req, q.src)
			end
		end
	end
	E.ureq = keep
end
EliteAI_UnitSettle = u_settle                                               -- the stub run
function EliteAI_UnitMuted( name )                                          -- EliteAI_PurchaseMult: no candidate while its mute lasts
	local E = EliteAI_E
	local m = E and E.umute and E.umute[name]
	if m == nil or not s_on() then return false end
	if World_GetGameTime() >= m then E.umute[name] = nil; return false end
	E.n_unit_mute = (E.n_unit_mute or 0) + 1
	return true
end
function EliteAI_UnitPause( now )                                           -- no spawn request at all after the dead ones
	local E = EliteAI_E
	return s_on() and E ~= nil and now < (E.upause or -1)
end
function EliteAI_UnitNotNow( pbg, cost )                                    -- TryPurchaseUnitChoice: the bank pays, the engine cannot start it now
	if not s_on() or pbg == nil then return end
	local E, now = EliteAI_E, World_GetGameTime()
	local name = string.lower(PBG_GetName( pbg ) or "")
	local short, mute = r_short(name), eai_num("Unit_NotNowMute", 15)
	E.n_unit_notnow = E.n_unit_notnow + 1
	E.umute[name] = now + mute
	if E.stall ~= nil and E.stall.name == short then E.stall, E.hold_req = nil, 0 end   -- nothing waits for a unit that cannot come
	e_say("notnow|" .. name, 30, "SPEND", "notnow", short, s_rp(cost), "bank", s_rp(cache and cache.resources),
		"pop", ((cache and cache.current_population_personnel) or -1) .. "/" .. ((cache and cache.max_population_personnel) or -1),
		"walk", E.walk_req or 0, "the engine cannot start it now: none for", mute, "s", "n", E.n_unit_notnow)
end
-- 0.9 (TECH_RU.md 21.13): Elite's choice among the entries within the variance is by a random start (ChooseBestAvailableUnitFromList)
-- - a spawn the layers did not ask for steps back for the best ANSWER (Counter / Setup / Garrison, EliteAI_P.ans of this tick)
-- among the same entries whose producer is free. `choices` is sorted by demand (util/demand.ai:61). Unit_AnswerFirst=0 = off.
function EliteAI_AnswerChoice( choices, best )
	local P = EliteAI_P
	if not s_on() or eai_num("Unit_AnswerFirst", 1) < 1 or type(choices) ~= "table" or best == nil or P == nil or P.ans == nil then return best end
	if best[3] ~= PURCHASETYPE_SPAWN or best[1] == nil then return best end
	local bname = string.lower(PBG_GetName( best[1] ) or "")
	if P.ans[bname] == true then return best end
	for i = 1, table.getn(choices) do
		local c = choices[i]
		if c ~= nil and c[3] == PURCHASETYPE_SPAWN and c[1] ~= nil then
			local n = string.lower(PBG_GetName( c[1] ) or "")
			if P.ans[n] == true and PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, c[1] ) == 0 then
				EliteAI_E.n_ans_choice = (EliteAI_E.n_ans_choice or 0) + 1
				e_say("ans_choice|" .. n, 30, "SPEND", "answer_first", r_short(n), "over", r_short(bname), "among", table.getn(choices), "choices", "n", EliteAI_E.n_ans_choice)
				return c
			end
		end
	end
	return best
end
-- 0.5 (TECH_RU.md 17.3) REQ THAT LEFT THE BANK AND IS IN NO BOOK. s20, IG, 3:36-3:45: the bank fell from 266 to 36 req, "ENERGY
-- stats ... spent60 []" - no line says who took 230 req while ig_devils (350) had been waited for for 129 s. The watch: a
-- sample per purchase tick { time, bank req, the book's total req, the income so far }; over Spend_LeakSecs (30 s) the bank
-- should be "then + income - booked". More than Spend_LeakMin (150) req missing = a line "SPEND unbooked ..." with what the
-- engine has in its tasks now (Task_CountCost, as the stall line) - once per window. Numbers only; nothing is decided by it.
-- (A purchase is booked when it is PAID FOR / has come - a reinforcement by the model, a generator by the request that
-- survived: a line right before such a booking is that purchase, the next ENERGY stats shows it.)
-- 0.7: THE TRACER. Between two purchase ticks the bank should be "then + income"; a fall of Spend_DropMin (60) req or
-- Spend_DropMinPow (12) power below that is a payment. The requests of the last Spend_DropLag (25 s) that no earlier fall has
-- taken explain it (each request once, the oldest first); what they do not explain by Spend_DropTol (25 req / 8 power) is named with its exact
-- price - "SPEND drop t N req -R pow -P in D s unknown -U/-V | asked: <kind R/P age> ..." (a price is a signature: 75/15 is
-- an upgrade, 66/7 a ravener model, 100/0 a generator). Numbers only; nothing is decided by it. Spend_DropMin=0 = off.
local function e_drop( now, req, pow )
	local E = EliteAI_E
	local dmin, dminp = eai_num("Spend_DropMin", 60), eai_num("Spend_DropMinPow", 12)
	local D = E.drop
	local rr = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local rp = (cache.resources_rate and cache.resources_rate.power) or 0
	if D == nil or dmin <= 0 or now - D.t > 15 or now <= D.t then E.drop = { t = now, req = req, pow = pow }; return end
	local dt = now - D.t
	local fr, fp = D.req + rr * dt / 60 - req, D.pow + rp * dt / 60 - pow
	E.drop = { t = now, req = req, pow = pow }
	local lag, keep, asked, ar, ap = eai_num("Spend_DropLag", 25), {}, {}, 0, 0
	local tol, tolp = eai_num("Spend_DropTol", 25), eai_num("Spend_DropTolPow", 8)
	-- every fall, small ones too, takes the requests it can pay for (the oldest first; a request is taken once): a request that
	-- was paid by a small fall must not explain a later one
	for _, q in ipairs(E.pay or {}) do
		if now - q.t <= lag then
			if not q.used and q.r <= fr - ar + tol and q.p <= fp - ap + tolp then
				q.used = true
				ar, ap = ar + q.r, ap + q.p
				table.insert(asked, string.format("%s %d/%d %ds", q.k, q.r, q.p, now - q.t))
			end
			table.insert(keep, q)
		end
	end
	E.pay = keep
	if not (fr >= dmin or fp >= dminp) then return end
	local ur, up = fr - ar, fp - ap
	if ur >= tol or up >= tolp then
		E.n_drop = (E.n_drop or 0) + 1
		E.drop_req = (E.drop_req or 0) + math.max(ur, 0)
		eai_log("SPEND", "drop", "t", math.floor(now), "req", string.format("%d", -math.floor(fr)), "pow", string.format("%d", -math.floor(fp)), "in", math.floor(dt), "s",
			"unknown", string.format("%d/%d", -math.floor(math.max(ur, 0)), -math.floor(math.max(up, 0))),
			"| asked:", (table.getn(asked) > 0) and table.concat(asked, ", ") or "nothing", "| bank", math.floor(req) .. "/" .. math.floor(pow),
			"tasks", s_rp(Task_CountCost( s_selfplayer, false )), "n", E.n_drop, "sum", math.floor(E.drop_req))
	end
end
local function e_leak( now )
	local E = EliteAI_E
	local win, min = eai_num("Spend_LeakSecs", 30), eai_num("Spend_LeakMin", 150)
	local req = cache.resources.requisition or 0
	e_drop( now, req, cache.resources.power or 0 )
	e_income( now, req, cache.resources.power or 0 )                        -- step 4 (0.14): the bank's growth against the rate
	if min <= 0 then return end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local booked = 0
	for _, k in ipairs(E_KINDS) do local tt = E.tot[k]; if tt then booked = booked + tt.r end end
	local L = E.leak
	if L == nil then L = { s = {}, inc = 0, t = now, said = -1000 }; E.leak = L end
	L.inc = L.inc + rate * math.max(now - L.t, 0) / 60                       -- (the rate is per minute)
	L.t = now
	table.insert(L.s, { t = now, req = req, booked = booked, inc = L.inc })
	-- 0.7: the samples of the window AND of Spend_LeakLag (10 s) before it are kept: what was booked up to that long before the
	-- window counts as paid in it (a research asked 3 s before the window is paid inside it)
	local lag = eai_num("Spend_LeakLag", 10)
	while table.getn(L.s) > 1 and now - L.s[2].t >= win + lag do table.remove(L.s, 1) end
	local a, b0 = nil, L.s[1]
	for _, q in ipairs(L.s) do if now - q.t <= win then a = q; break end end   -- the first sample inside the window
	if a == nil or now - a.t < win * 0.8 then return end
	local income, spent = L.inc - a.inc, booked - b0.booked
	local missing = a.req + income - spent - req
	if missing >= min and now - L.said >= win then
		L.said = now
		E.n_leak = (E.n_leak or 0) + 1
		eai_log("SPEND", "unbooked", "t", math.floor(now), "req", -math.floor(missing), "in", math.floor(now - a.t), "s: bank", math.floor(a.req), "->", math.floor(req),
			"income", math.floor(income), "booked", math.floor(spent), "tasks", s_rp(Task_CountCost( s_selfplayer, false )), "tech_reserve", E.res_req or 0,
			"secure_pending", E.sec_pending or 0, "addon_pending", table.getn(E.areq or {}), "n", E.n_leak)
	end
end
-- every purchase tick, first pass of the budget loop (do_purchase): the float state, the arbiter, the stats line
function EliteAI_EnergyTick( purchase_count )
	if not s_on() or cache == nil or cache.resources == nil or purchase_count ~= 0 then return end
	local E, now = EliteAI_E, World_GetGameTime()
	EliteAI_EnergyFloat()
	u_settle( now )                                                         -- 0.9: the spawn requests of the earlier ticks - bought or dead
	e_hold_tick( now )
	e_leak( now )
	E.gar_on = e_gar_active( now )
	if now - E.last_stats < eai_num("Energy_StatsSecs", 60) then return end
	E.last_stats = now
	local last60, total = e_book( now )
	eai_log("ENERGY", "stats", "t", math.floor(now), "float", E.float and "on" or "off", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate),
		"spent60", "[" .. last60 .. "]", "total", "[" .. total .. "]", "addon_skip", E.n_addon_skip, "addon_boost", E.n_addon_boost, "gen_hold", E.n_gen_skip,
		"unit_first", E.hold and "on" or "off", "rule", e_rule(), "gar_demand", E.n_gar,
		"unit_first_sw", E.n_hold_sw, "reserve_skip", E.n_res_skip, "secure_req", E.n_sec_req, "secure_dead", E.n_sec_dead, "secure_hold", E.n_sec_hold, "secure_none", E.n_sec_none or 0,
		"addon_req", E.n_addon_req, "addon_dead", E.n_addon_dead,
		"addon_share", string.format("%.2f", e_addon_share()), "cap", string.format("%.2f", (e_share_cap())), "(" .. tostring(E.cap_why) .. ")",
		"share_skip", E.n_share_skip, "unit_kept", E.n_hold_keep, "t2_power_skip", E.n_pow_skip or 0,
		"gen_req", E.n_gen_req, "gen_dead", E.n_gen_dead, "dry", E.n_dry or 0, "wargear_skip", E.n_wg_skip or 0, "unbooked", E.n_leak or 0, "drops", E.n_drop or 0, "drop_req", math.floor(E.drop_req or 0), "counter_demand", E.n_counter or 0,
		"gens", E.gen_have or 0, "gen_cap", E.gen_cap or "-", "gen_stuck", E.n_gen_stuck or 0, "nodes", e_node_count(),
		"tempo", math.floor(E.tempo_pop or 0) .. "/" .. math.floor(E.tempo_target or 0), "tempo_state", E.tempo and "behind" or "ok", "tempo_ticks", E.n_tempo or 0,
		"gen_need", tostring(E.gen_need_why or "-"), "gen_noneed", E.n_gen_noneed or 0, "node_noneed", E.n_sec_noneed or 0, "gen_lost", E.n_gen_lost or 0,
		"ans_first", E.n_ans_first or 0, "pop", (cache.current_population_personnel or -1) .. "/" .. (cache.max_population_personnel or -1),
		"unit_req", E.n_unit_req or 0, "unit_dead", E.n_unit_dead or 0, "unit_notnow", E.n_unit_notnow or 0, "unit_mute", E.n_unit_mute or 0,
		"node_walk", E.n_walk or 0, "walk_now", E.walk_req or 0, "ans_choice", E.n_ans_choice or 0,
		"popcap", E.n_popcap or 0, "open", (EliteAI_O and EliteAI_O.list) and ((EliteAI_O.done and "done" or tostring(EliteAI_O.i)) .. "/" .. table.getn(EliteAI_O.list)) or "-",
		"swap", (E.swap == true) and "on" or "off", "swap_sw", E.n_swap or 0, "swap_ticks", E.n_swap_ticks or 0, "swap_skip", E.n_swap_skip or 0, "gen_wait", E.n_gen_wait or 0,
		"income_k", string.format("%.2f/%.2f", EliteAI_IncomeK()), "swap_why", tostring(E.swap_why or "-"), "wait_tier", EliteAI_S.n_wait_tier or 0,   -- step 4 (0.14)
		"room", ((E.room == true) and "on" or "off") .. "/" .. tostring(E.room_why or "-"), "room_block", EliteAI_P.n_room or 0, "room_sw", E.n_room_sw or 0,   -- step 5 (0.15)
		"wait_dear", EliteAI_S.n_wait_dear or 0, "dear_pick", EliteAI_S.n_dear_pick or 0, "poor", (EliteAI_ReinforcePoor( now )) and 1 or 0,
		"dear_block", EliteAI_S.n_dear_block or 0, "room_callin", E.n_room_callin or 0, "room_first", E.n_room_first or 0,   -- step 6 (0.16)
		"room_tier", EliteAI_P.n_room_tier or 0, "gen_site", E.n_gen_site or 0, "gen_hfloor", E.gen_hfloor or 0)
	-- step 7 (0.17): a line of its own - the game cuts a log line at ~1200 characters ("ENERGY stats" reaches it)
	eai_log("ENERGY", "stats7", "t", math.floor(now), "room_addon", E.n_room_addon or 0,
		"dear_ep", (EliteAI_S.n_dear_ep or 0) .. "/" .. (EliteAI_S.n_dear_ok or 0) .. "/" .. (EliteAI_S.n_dear_clock or 0) .. "/" .. (EliteAI_S.n_dear_skip or 0),
		"gen_eng", (cache and cache.total_pts_secured_w_addon_capacity) or -1, "gen_slots", (type(EliteAI.pw) == "table" and EliteAI.pw.slots) or -1,
		"gen_m10_skip", E.n_gen_m10_skip or 0, "sec_cool", E.n_sec_cool or 0, "sec_human", E.n_sec_human or 0, "gen_restore", E.n_gen_restore or 0,
		"gen_htarget", E.gen_htarget or 0, "gen_peak", E.gen_peak or 0)
	-- step 8 (0.18): a line of its own as well
	eai_log("ENERGY", "stats8", "t", math.floor(now), "sec_settle", E.n_sec_settle or 0, "sec_cap10", E.n_sec_cap10 or 0, "sec_cool_pow", E.n_sec_cool_pow or 0,
		"sec_capspend", E.n_sec_capspend or 0, "sec_fail", (E.n_sec_fail or 0) .. "/" .. (E.n_sec_failhold or 0), "sec_req", E.n_sec_req or 0, "dear_rich", EliteAI_S.n_dear_rich or 0, "gen_ahead", E.n_gen_ahead or 0, "gen_ahead_block", E.n_gen_ahead_block or 0, "gen_back", E.n_gen_back or 0, "secure", (E.tot and E.tot.secure and E.tot.secure.r) or 0,
		"gen", (E.tot and E.tot.gen and E.tot.gen.r) or 0)
end
-- once per (re)initialisation, new logic only: the wrappers around Elite's functions that are loaded after this file
-- (strategy_addon_purchase.ai) and the purchase callbacks of the budgets of the other run
local function e_install()
	e_reset()
	if type(UpdateSquadDemand) == "function" and not EliteAI_EnergyAddonWrapped then
		EliteAI_EnergyAddonWrapped = true
		local Elite_UpdateSquadDemand = UpdateSquadDemand
		UpdateSquadDemand = function( PITEM_type )
			Elite_UpdateSquadDemand( PITEM_type )
			if s_on() and eai_num("Energy_Addons", 1) >= 1 then e_addon_filter( PITEM_type ) end
		end
	end
	if type(ResourceStructureDemand) == "function" and not EliteAI_EnergyGenWrapped then
		EliteAI_EnergyGenWrapped = true
		local Elite_ResourceStructureDemand = ResourceStructureDemand        -- strategy_resourcing.ai:151
		ResourceStructureDemand = function()
			if not s_on() then return Elite_ResourceStructureDemand() end
			local cap, have = e_gen_limits( World_GetGameTime() )              -- 0.9: the plan's limits before Elite's rule reads them
			if eai_num("Energy_GenHold", 1) >= 1 and EliteAI_EnergyFloat()
				and not (cap ~= nil and EliteAI_E.gen_behind and have < eai_num("Energy_GenFloor", 4)) then
				EliteAI_E.n_gen_skip = EliteAI_E.n_gen_skip + 1
				e_say("gen", 60, "ENERGY", "gen", "hold", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "have", have, "cap", cap or "-")
				return
			end
			return Elite_ResourceStructureDemand()
		end
	end
	local bl = ai_budget and ai_budget.budget_list
	if type(bl) == "table" then
		for _, d in ipairs({ { "BUDGET_AddOn", "addon" }, { "BUDGET_ResourceAddOn", "gen" }, { "BUDGET_Secure", "secure" } }) do
			local b, kind = bl[d[1]], d[2]
			if type(b) == "table" and type(b.purchase_func) == "function" and not b.eliteai_noted then
				b.eliteai_noted = true
				local Elite_purchase = b.purchase_func
				b.purchase_func = function( availableResources, purchase_count )
					if not s_on() then return Elite_purchase( availableResources, purchase_count ) end
					local E = EliteAI_E
					if kind == "secure" and e_secure_gate() then return false end
					if kind == "gen" and e_gen_gate() then return false end   -- 0.4: the request of the last tick - bought or dead
					if kind == "addon" then e_addon_settle() end            -- 0.3: the requests of the earlier ticks - bought or killed
					-- the upgrades have their own filter per item (e_addon_filter); Secure and the generators get the cut bank
					local avail = availableResources
					-- 0.9: a generator the plan is behind with and a node on a power point that has none are not cut by the unit the
					-- upgrades wait for (100 / 125 req against 300-400: the unit waited for the whole match and so did they -
					-- "reserve_skip 34"); the tech plan's reserve still holds
					if kind == "gen" then e_gen_limits( World_GetGameTime() ) end   -- the plan of this tick (E.gen_behind)
					local first = (kind == "gen" and E.gen_behind == true and eai_num("Energy_GenFirst", 1) >= 1)
						or (kind == "secure" and E.sec_first == true and eai_num("Energy_SecureFirst", 1) >= 1)
					-- 0.10 (TECH_RU.md 21.2; the polygon's scene b_garrison, r19: "SPEND stall ig_devils 350/35 why money" for 168 s while
					-- generators were asked for at 92 / 116 / 183 s - the answer to the garrison was never bought): a generator / a node
					-- is not ahead of an ANSWER (a unit the Counter / Setup / Garrison layers ask for) that waits for its req - unless
					-- the power is what that unit lacks ("need unit")
					if kind == "gen" and E.gen_ahead == true then first = true end   -- step 8: behind people's count, a place for it
					if first and kind ~= "addon" and eai_num("Energy_AnswerFirst", 1) >= 1 and not (kind == "gen" and E.gen_ahead == true) then
						local st, tnow = E.stall, World_GetGameTime()
						if st ~= nil and tnow - (st.t or -1000) <= 7 and st.ans == true and st.why == "money" then
							local _, nwhy = EliteAI_EnergyGenNeed( tnow )
							if nwhy ~= "unit" then
								first = false
								E.n_ans_first = (E.n_ans_first or 0) + 1
								e_say("ans_first|" .. kind, 30, "ENERGY", kind, "after", "the answer", tostring(st.name), s_rp({ requisition = st.req, power = st.pow }), "waits for its req: not ahead of it",
									"bank", s_rp(cache.resources), "hold", E.hold and 1 or 0)
							end
						end
					end
					if kind ~= "addon" then avail = e_reserved( availableResources, not first ) end
					local ok, cost = Elite_purchase( avail, purchase_count )
					if ok and cost then
						if kind == "addon" then EliteAI_EnergyNoteAddon( cost ); EliteAI_EnergyPay( "addon", cost.requisition, cost.power )
						elseif kind == "secure" then
							E.sec_t, E.sec_req, E.sec_pow = World_GetGameTime(), cost.requisition or 0, cost.power or 0   -- noted when it survives (e_secure_gate)
							E.sec_n0, E.sec_nodes0 = (cache and cache.total_pts_secured) or 0, e_node_count()   -- 0.9: the verdict's start
							eai_log("ENERGY", "secure", "req", "t", math.floor(E.sec_t), "bank", s_rp(cache.resources), "nodes", E.sec_nodes0, "secured", E.sec_n0,
								"power points ours", (type(EliteAI.pw) == "table" and EliteAI.pw.own) or "?", "without a node", (type(EliteAI.pw) == "table" and EliteAI.pw.unsec) or "?", "first", first and 1 or 0)
							EliteAI.build_req_t = E.sec_t                           -- 0.8: main.ai's builder wait (the order book)
							EliteAI_EnergyPay( "secure", cost.requisition, cost.power )
							E.n_sec_req = E.n_sec_req + 1
						else
							E.gen_t, E.gen_req, E.gen_pow = World_GetGameTime(), cost.requisition or 0, cost.power or 0   -- 0.4: its verdict at the next tick (e_gen_gate)
							E.gen_n0 = E.gen_n or 0                                 -- 0.5: the generators at the moment of the request
							eai_log("ENERGY", "gen", "req", "t", math.floor(E.gen_t), "bank", s_rp(cache.resources), "have", E.gen_have or "?", "cap", E.gen_cap or "-",
								"free places", (type(EliteAI.pw) == "table" and EliteAI.pw.slots) or "?", "first", first and 1 or 0)
							EliteAI.build_req_t = E.gen_t                           -- 0.8: main.ai's builder wait (the order book)
							EliteAI_EnergyPay( "gen", cost.requisition, cost.power )
							E.n_gen_req = E.n_gen_req + 1
						end
					elseif not ok and cost and avail ~= availableResources and ResourceAmount_Has( availableResources, cost ) then
						-- held back by a reserve of ours alone: nothing is locked for the budgets after this one
						E.n_res_skip = E.n_res_skip + 1
						e_say("res_skip|" .. kind, eai_num("Energy_LogSecs", 30), "ENERGY", "reserve", "skip", kind, s_rp(cost), "bank", s_rp(cache.resources),
							"tech_reserve", (E.res_req or 0) .. "/" .. (E.res_pow or 0), "unit_first", E.hold and E.hold_req or 0)
						return false
					end
					return ok, cost
				end
			end
		end
	end
	eai_log("ENERGY", "init", "version", EliteAI_ENERGY_VERSION, "float_pow", eai_num("Energy_FloatPow", eai_num("Spend_BankPow", 300)),
		"float_ratio", eai_num("Energy_FloatRatio", 1.5), "exit_k", eai_num("Energy_ExitK", 0.6), "eta_max", eai_num("Energy_EtaMax", 120),
		"share_k", eai_num("Energy_ShareK", 2), "addon_min_share", eai_num("Energy_AddonMinShare", 0.15), "addon_low_mult", eai_num("Energy_AddonLowMult", 0.25),
		"addon_share_k", eai_num("Energy_AddonShareK", 3), "gen_hold", eai_num("Energy_GenHold", 1), "Conf_AddonVsUnit", e_rule(),
		"gar_buy", eai_num("Gar_BuySecs", 25) .. "/" .. eai_num("Gar_BuyMult", 2.5) .. "/" .. eai_num("Gar_AddonMult", 3),
		"wrapped", (EliteAI_EnergyAddonWrapped and "addon" or "-") .. "," .. (EliteAI_EnergyGenWrapped and "gen" or "-"),
		"unit_first_hold", eai_num("Spend_UnitFirstHold", 20), "off_k", eai_num("Spend_UnitFirstOffK", 1.5),
		"secure", eai_num("Energy_SecureMax", 1) .. "/" .. eai_num("Energy_SecureTries", 2) .. "/" .. eai_num("Energy_SecureMute", 60) .. "/" .. eai_num("Energy_SecureHold", 1),
		"share", eai_num("Share_On", 1) .. " " .. eai_num("Share_AddonT1", 0.15) .. "/" .. eai_num("Share_AddonT2", 0.20) .. "/" .. eai_num("Share_AddonT3", 0.30),
		"army", eai_num("Share_ArmyT1", 4) .. "/" .. eai_num("Share_ArmyT2", 6) .. "/" .. eai_num("Share_ArmyT3", 8), "floor_k", eai_num("Share_FloorK", 0.5),
		"addon_dead", eai_num("Energy_AddonDeadTries", 2) .. "/" .. eai_num("Energy_AddonDeadMute", 60),
		-- step 4 (0.14): the real income, the tier's label and the wait for its unit, the swap by the idle power
		"income_k", eai_num("Energy_IncomeK", 1), "tier_label", eai_num("Tier_Label", 1),
		"tier_wait", eai_num("Spend_TierWait", 1) .. "/" .. eai_num("Spend_TierWaitEta", 150) .. "/" .. eai_num("Spend_TierWaitMax", 150),
		"swap_float", eai_num("Swap_Float", 1) .. "/" .. eai_num("Swap_FloatPow", 300) .. "/" .. eai_num("Swap_FloatFill", 0.6),
		-- step 5 (0.15): the room for the units of the tier, the dear unit of the tier, "poor" by the real income
		"room", eai_num("Room_On", 1) .. "/" .. eai_num("Room_Pop", 20) .. "/" .. eai_num("Room_Lead", 0) .. "/" .. eai_num("Room_MaxSecs", 180),
		"dear", eai_num("Spend_Dear", 1) .. "/" .. eai_num("Spend_DearPow", 300) .. "/" .. eai_num("Spend_DearK", 0.5),
		"poor_income_k", eai_num("Reinf_PoorIncomeK", 1),
		-- step 6 (0.16): the room's end (units of the tier wanted / the clock restarts / call-ins wait / the unit first), the dear unit's block and limit
		"room6", eai_num("Room_Want", 1) .. "/" .. eai_num("Room_Restart", 0) .. "/" .. eai_num("Room_CallIn", 1) .. "/" .. eai_num("Room_UnitFirst", 1),
		"dear6", eai_num("Spend_DearBlock", 1) .. "/" .. eai_num("Spend_DearMax", 90), "room_tier_only", eai_num("Room_TierOnly", 1),
		"room_full", eai_num("Room_LeadFull", 240) .. "/" .. eai_num("Room_FullGap", 20),
		-- step 7 (0.17): the upgrades wait while no unit of tier 3 fits under the cap in the room
		"room_addon", eai_num("Room_AddonHold", 1),
		"dear7", eai_num("Spend_DearHold", 1) .. "/" .. eai_num("Spend_DearEta", 60) .. "/" .. eai_num("Spend_DearEps", 1),
		"dear8", eai_num("Spend_DearRichPow", 500) .. "/" .. eai_num("Spend_DearRichEta", 120) .. "/" .. eai_num("Spend_DearRichMax", 150) .. "/" .. eai_num("Spend_DearEps2Pow", 600),
		"gen7", eai_num("Energy_GenSlotsEngine", 1) .. "/" .. eai_num("Energy_GenHumanLowSecs", 120) .. "/" .. eai_num("Energy_SecureCool", 1),
		"node7", eai_num("Energy_NodeHuman", 1) .. "/" .. eai_num("Energy_Node2At", 300) .. "/" .. eai_num("Energy_Node3At", 0) .. "/" .. eai_num("Energy_GenRestore", 1),
		-- step 8 (0.18): the nodes as people build them (the result first, 2 by 10:00, razed points by the bank, the share after 12:00)
		"gen8", eai_num("Energy_GenAhead", 1) .. "/" .. eai_num("Energy_GenAheadMax", 45) .. "/" .. eai_num("Energy_GenAheadMute", 60) .. "/" .. eai_num("Energy_GenBookReq", 1),
		"node8", eai_num("Energy_SecureSettle", 20) .. "/" .. eai_num("Energy_NodeCap10", 2) .. "/" .. eai_num("Energy_NodeCapUntil", 600) .. "/"
			.. eai_num("Energy_SecureCoolPow", eai_num("Swap_FloatPow", 300)) .. "/" .. eai_num("Energy_SecureCapAt", 720) .. "/" .. eai_num("Energy_SecureCapWin", 240) .. "/" .. eai_num("Energy_SecureCapK", 0.15))
end
EliteAI_EnergyInit = e_install

strategy_unit_purchase =
{
}

s_capturerMult = 1
s_demand_variance = 0
s_eta_unit_wait_time = 60
s_reinforce_wait_time = 30
s_resurrect_wait_time = 30

function strategy_unit_purchase.init()
	
	print("strategy_unit_purchase.init")
	 
	s_unit_purchase_limit = {} -- example {[PBG_GetID(SBP.SM_MARINE)] = 2,...}

	-- EliteAI base (compatibility with Elite's data, the list of Elite 3.2.1 strategy_unit_purchase.ai:26-52): the units Elite
	-- forbids (0) or keeps to one (1). Vanilla's s_unit_purchase_limit only halves the demand, so these are HARD caps
	-- (s_unit_hard_limit, AccumulateSquadDemand below). Elite's other caps (sentinel, guardsmen, heavy weapons, devastators,
	-- rhino: 1-2 by modFactor) are its balance, not a ban - not taken.
	s_unit_hard_limit = {}
	local function hard_limit( path, n )
		local id = PBG_GetID( PBG_Get( path ) )
		s_unit_purchase_limit[id] = n
		s_unit_hard_limit[id] = n
	end
	hard_limit( "sbps/pvp/race_tyranid/troops/tyr_spore_mines", 0 )
	hard_limit( "sbps/pvp/race_imperial_guard/troops/ig_spotter_squad", 0 )
	hard_limit( "sbps/pvp/race_tyranid/troops/tyr_ripper", 1 )
	hard_limit( "sbps/pvp/race_ork/troops/ork_lootas", 1 )

	-- stored off so this can be overriden by scar
	s_demand_variance = s_personality.demand_variance
	s_eta_unit_wait_time = s_personality.eta_unit_wait_time

	-- EliteAI (spend): fresh state on init/Reset and one line that says the watchdog is in
	if EliteAI and EliteAI.on then
		EliteAI_S = { last_buy = 0, above_t = -1, hot = false, said = {}, n_buy = 0, n_none = 0, addon_floor = 0, bought_hot = 0, cool = -1 }
		eai_log("SPEND", "init", "version", EliteAI_SPEND_VERSION, "bank", eai_num("Spend_BankReq", 400) .. "/" .. eai_num("Spend_BankPow", 300),
			"idle", eai_num("Spend_IdleSecs", 45), "retry", eai_num("Spend_RetrySecs", 12), "addon_floor", eai_num("Spend_AddonFloor", 8),
			"kill_inactive", eai_num("Spend_KillInactive", 1), "pow_unit", eai_num("Spend_PowUnit", 40), "lowpow_mult", eai_num("Spend_LowPowMult", 0.25),
			"over_lock", eai_num("Spend_OverLock", 1), "no_glue", eai_num("Spend_NoGlue", 1))

		EliteAI_G = { said = {}, n_drop = 0 }                                 -- gate: fresh state + "GATE init"
		eai_log("GATE", "init", "version", EliteAI_GATE_VERSION, "super_min_time", eai_num("SuperMinTime", 1080), "super_min_army", eai_num("SuperMinArmy", 8),
			"super_cost", eai_num("SuperCost", 1000), "log", eai_num("Gate_LogSecs", 30))
		EliteAI_ReinforceInit()                                              -- reinf: fresh state + "REINF init"
		EliteAI_EnergyInit()                                                 -- energy: fresh state, wrappers of the addon run + "ENERGY init"
		EliteAI_OpeningInit()                                                -- step 2: people's opening (human_plan.ai) + "OPEN init"
	end
end

function AccumulateReinforceDemand( availableResources )
	-- run through all the squads that need reinforcements and see if they could use
	-- a reinforcement - or we can allocate money to them
	if (Task_CountProduction( s_selfplayer, PITEM_SquadReinforce ) == 0 and AIProduction_AnyReinforcementsNeeded( s_selfplayer )) then
		local reinforcecount = AIProduction_GetReinforcementSquadCount( s_selfplayer )

		aitrace("Units needing reinforcement:"..reinforcecount)
		
		-- EliteAI (reinf): the verdict per blueprint of the new logic (nil for Elite's AIs = everything as before)
		local gate = nil
		if EliteAI and EliteAI.on then gate = EliteAI_ReinforceGate( reinforcecount, availableResources ) end

		for i=0, reinforcecount-1 do 
			local squadpbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
			local reinforce_cost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, squadpbg )
			
			aitrace("ReinforceCost:"..res_to_str( reinforce_cost ).. " total cost:"..res_to_str(AIProduction_GetReinforcementSquadCostAt( s_selfplayer, i )))
			
			local eta = GetETAFromCost( reinforce_cost, availableResources )
			local allowed = true
			if gate ~= nil then
				local key = (squadpbg ~= nil) and (string.gsub(string.lower(PBG_GetName( squadpbg ) or ""), "\\", "/")) or ""
				allowed = (gate[key] ~= false)                                 -- false = the arbiter skips this blueprint now
			end
			if (eta <= s_reinforce_wait_time) and allowed then

				local sk_reinforce_mult = 20
				-- EliteAI (vanilla base): under the new logic WHETHER a squad is refilled now is the verdict of REINF (the gate above,
				-- the unit-first rule, the save) - a refill it lets through must outrank the units as where REINF was measured
				-- (x50). Reinf_DemandMult; vanilla's x20 for the plain vanilla
				if EliteAI and EliteAI.on then sk_reinforce_mult = eai_num("Reinf_DemandMult", 50) end
				
				aitrace("Reinforce squad: " .. PBG_GetName( squadpbg ) )
				
				-- approximate demand for this unit (tends to over-estimate value, but we prefer to reinforce so that should be fine)
				local demand = CalcSquadDemand( squadpbg )
				aitrace("Reinforce demand before:"..demand.." after:"..demand*sk_reinforce_mult)
			
				SetSquadDemand( squadpbg, demand*sk_reinforce_mult, PURCHASETYPE_REINFORCE )
			end
		end
	end
end

function AccumulateResurrectDemand( availableResources )
	-- run through all the squads that are unconscious and see if they could use resurrection
	-- or we can allocate money to them
	
	if (Task_Count(s_selfplayer, TGROUP_Resurrect) == 0 and AIResource_GetNumUnconsciousSquads( s_selfplayer ) > 0) then
		aitrace("A Unit needs Resurrection.")

		local squad = AIResource_GetUnconsciousSquad( s_selfplayer )
		local resurrect_cost = AIResource_GetResurrectSquadCost( squad )
			
		aitrace("ResurrectCost:"..res_to_str( resurrect_cost ))
			
		local eta = GetETAFromCost( resurrect_cost, availableResources )
		if (eta <= s_resurrect_wait_time) then
			local squadpbg = AISquad_ConvertToPBG(squad)
			local deprecProgress = AIResource_GetResurrectDepreciationProgress(squad)
			-- deprecProgress^4 to push purchase towards cheaper end of purchase
			local sk_resurrect_mult = 10 * deprecProgress * deprecProgress * deprecProgress * deprecProgress
				
			-- approximate demand for this unit -- ideally we would use the squad itself, with health set to max, since it may be upgraded and levelled up.
			local demand = CalcSquadDemand( squadpbg )
			aitrace("Resurrect demand before:"..demand.." after:"..demand*sk_resurrect_mult)
			
			SetSquadDemand( squadpbg, demand*sk_resurrect_mult, PURCHASETYPE_RESURRECT )
		end
	end
end

function AccumulateSquadDemand( availableResources, reinforce_only )

	aipushtrace("AccumulateSquadDemand")

	-- do reserrection demand
	AccumulateResurrectDemand( availableResources )
	
	-- check popcaps - if we are too high then no need to demand anything at all
	-- 
	local curpopcap = cache.current_population_personnel
	local maxpopcap = cache.max_population_personnel
	if (curpopcap >= maxpopcap) then
		aitrace("Reached popcap - cannot produce units")
		aipoptrace()
		return
	end
	
	-- do reinforcement demand
	aipushtrace("AccumulateReinforceSquadDemand")

	AccumulateReinforceDemand( availableResources )
	
	aipoptrace()

	-- since we are asked to only do reinforcements - skip the rest
	if (reinforce_only) then
		aitrace("Stop short because of reinforce_only flag")
		aipoptrace()
		return
	end
	
	-- If we need more units for map control, prefer units which can be built immediately
	local needSquadsUrgentlyMultiplier = GetSquadUrgentNeedMultiplier()
	if (needSquadsUrgentlyMultiplier > 1) then
		aitrace("AI needs squads!  Badly!  needSquadsUrgentlyMultiplier:"..tostring(needSquadsUrgentlyMultiplier))
	end
	
	aipushtrace("AccumulatePurchaseSquadDemand")

	local eai_on = EliteAI and EliteAI.on
	if eai_on then EliteAI_PurchasePrep(); EliteAI_P.plan = nil end        -- (13: the plan's next unit is noted in the loop below)

	-- go through each buildable squad for this AI and determine what its demand is given
	-- this AIs class/anti-class needs are
	local buildableTotal = AIProduction_GetBuildableSquadCount( s_selfplayer )
	for i=0, buildableTotal-1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
	
		-- if this unit is available then lets determine the demand for this unit
		if (AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) == true) then
		
			-- since we can produce this unit - lets determine this units demand
			local demand = CalcSquadDemand( pbg )
			-- EliteAI base: a unit Elite forbids / keeps to one gets no demand at its cap (it only skips itself)
			local hardcap = s_unit_hard_limit and s_unit_hard_limit[ PBG_GetID( pbg ) ]
			if hardcap and UtilPBG_CountTotal( pbg ) >= hardcap then demand = 0 end
			-- EliteAI (gate, step 15): a blueprint we forbid (super unit outside its window, limit 0) gets no demand at all - no
			-- ETA, no entry in HighestSquadDemand, never the "first" choice TryPurchaseUnitChoice stalls on ("GATE drop" in the log)
			if eai_on and EliteAI_GateDrop( pbg, string.lower(PBG_GetName( pbg ) or "") ) then demand = 0 end
			if eai_on then demand = EliteAI_PurchaseShape( demand ) end        -- 0.7: the engine's rating as an order, its span compressed
			
			-- add capturer demand (only if pbg can capture NOW)
			if (PBG_CanCapture( s_selfplayer, pbg )) then
				local capmult = GetCapturerDemandMult()
				-- EliteAI (vanilla base): vanilla's multiplier is 0 while our base is threatened and one capturer is alive
				-- (CalcCapturerDemand below: 'demand = 0') - no infantry at all is asked for during an attack on the base. Under the
				-- new logic it stays a bonus (never below 1): what to buy against the attack is the answer's business (COUNTER)
				if eai_on and capmult < 1 then capmult = 1 end
				demand = demand * capmult
			end
									
			if (demand > 0) then
			
				-- ETA - how does the time factor into this unit
				local eta, requisitionETA, powerETA = GetUnitETA( pbg, availableResources )
				
				aitrace( string.format("%s Demand:%.0f ETA:%.0f/%.0f Req-ETA:%.0f Pow-ETA:%.0f", PBG_GetName(pbg), demand, eta, s_eta_unit_wait_time, requisitionETA, powerETA ) )
				
				-- EliteAI (13): the plan's next unit - on the first pass the demand of a unit beyond Elite's wait that the income
				-- brings within Plan_EtaMax is worked out by the same rules; it is noted (EliteAI_PlanNote), never set as a demand
				local in_wait = (eta <= s_eta_unit_wait_time)
				if in_wait or (eai_on and EliteAI_P.pass == 0 and eta <= eai_num("Plan_EtaMax", eai_num("Energy_EtaMax", 120))) then
				
					-- duplicate demand decrease - this decreases the demand of a unit we have too many of
					local demandmult = 1
					local pbgid = PBG_GetID( pbg )
					if (s_unit_purchase_limit and s_unit_purchase_limit[ pbgid ]) then
						local unitcap = s_unit_purchase_limit[ pbgid ]
						local curAmount = UtilPBG_CountTotal( pbg )
						if eai_on and unitcap < 1 then demand = 0 end      -- EliteAI: a forbidden unit only skips itself (the gate above dropped it already)
						if (curAmount >= unitcap) then
							demandmult = 1 / ( (curAmount-unitcap) + 2 )  -- 1/2, 1/3, 1/4, 1/5 etc
						end
						demand = demand * demandmult
						
						aitrace("Lower-Demand Mult:"..demandmult)
					end
	
					if (needSquadsUrgentlyMultiplier > 1.0) then
						if (eta == 0) then
							demand = demand * needSquadsUrgentlyMultiplier
							aitrace("Urgent-Demand Increase:"..needSquadsUrgentlyMultiplier)
						else
							demand = demand / needSquadsUrgentlyMultiplier
							aitrace("Urgent-Demand Decrease:"..needSquadsUrgentlyMultiplier)
						end
						
					end

					if eai_on then
						demand = demand * EliteAI_PurchaseMult( pbg, UtilPBG_CountTotal( pbg ) )   -- (vanilla base: curAmount is a local of the limit block above)
					end

					aitrace( string.format("FinalDemand:%.0f", demand ) )
									
					if (demand > 0) then
						if in_wait then SetSquadDemand( pbg, demand, PURCHASETYPE_SPAWN ) end
						if eai_on then EliteAI_PlanNote( pbg, demand, eta, in_wait ) end
					end
					
				end
			end
			
		else
			aitrace("CanNOTProduce:"..PBG_GetName( pbg ) )
		end
		
	end
		
	aipoptrace()
	aipoptrace()
	
end

function CalcCapturerDemand( )
	
	aipushtrace("CalcCapturerDemand")
	
	s_capturerMult = 1
	
	-- only ask for capture demand increases when we have are not losing by a ton 
	if (cache.military_value > 15 and cache.military_percent_value < -0.3) then
		aitrace("Losing: giving no capturer mults")
		return
	end
	
	local ptsWanted = s_capture_pts_wanted - Task_CountActive( s_selfplayer, TASK_Capture, false )
	aitrace("PtsWanted(from resourcing):"..ptsWanted)

	local curCapturers = AIResource_GetNumCapturers( s_selfplayer )
	-- also need to know how many we have requested for
	local capturerRequests = Task_CountCapturerPBG( s_selfplayer )
	-- total capturers + requested
	local totalCapturers = (capturerRequests + curCapturers);
	aitrace("Capturers: Cur:"..curCapturers.." Req:"..capturerRequests.." Total:"..totalCapturers)
	
	-- don't ask for more capturers then there are ptsWanted
	local trueCapturerDemand = math.max( ptsWanted - totalCapturers, 0 )
	
	aitrace("CapturerNeed:"..trueCapturerDemand)
	if (trueCapturerDemand <= 0) then
		return
	end
			
	-- this is default number we should aim for
	local minCapturers = 1
	local wantedCapturers = 2
	local maxCapturers = 3
	
	if (totalCapturers >= maxCapturers) then
		return -- early out
	end
	
	-- 1. check if our base is under attack if we are the demands will change based on the attack 
	if (cache.threat_at_base > 10 ) then
		minCapturers = 0
		wantedCapturers = 0
		maxCapturers = 1
	end
	
	local bonusdemand = trueCapturerDemand/40  -- adds .1 for every 4 more pts we want
	aitrace("BonusDemandMult:"..bonusdemand)
	local demand = 0
	if (totalCapturers  < minCapturers) then
		demand = 1.3 + bonusdemand
	elseif (totalCapturers < wantedCapturers) then
		demand = 1.2 + bonusdemand
	elseif (totalCapturers < maxCapturers) then
		demand = 1.1
	end
	
	s_capturerMult = demand
	aitrace("Capturer Demand Mult:"..demand)
	
	aipoptrace()
	
end

function GetCapturerDemandMult()

	return s_capturerMult

end

------------------------------------------------------
-- Calculate the time we will wait for a unit we 
-- really want (sometimes we just don't have the time
-- or the funds to get what we want)
-- 
function CalculateUnitETA( purchase_count )

	aitrace("CalcUnitETA")
	
	local offset_eta = 0
	
	-- if we have previously purchased a unit on this frame (then bypass offset)
	if (purchase_count == 0) then
	
		-- if we have some military units then we have some safe-guard so we can increase
		-- it slightly
		if (cache.military_count > 3) then
			offset_eta = offset_eta + (cache.military_count-3)*5
		end

		aitrace("OffsetETA:"..offset_eta)
		
		-- get the base rate from the personality file
		s_eta_unit_wait_time = math.max( s_personality.eta_unit_wait_time + offset_eta, 0 )
	else
		s_eta_unit_wait_time = 0
	end
	
	aitrace("NewUnitETA:"..s_eta_unit_wait_time)
	
end

function GetETAFromChoice( choice_entry, availableResources )
	
	if (choice_entry[3] == PURCHASETYPE_SPAWN) then
		return GetUnitETA( choice_entry[1], availableResources )
	elseif (choice_entry[3] == PURCHASETYPE_ABILITY) then
		local cost = AIAbility_GetCost( s_self_modplayer, choice_entry[1] )
		return GetETAFromCost( cost, availableResources )
	elseif (choice_entry[3] == PURCHASETYPE_REINFORCE) then
		local cost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, choice_entry[1] )
		return GetETAFromCost( cost, availableResources )
	elseif (choice_entry[3] == PURCHASETYPE_RESURRECT) then
		local squad = AIResource_GetUnconsciousSquadByPBG( s_selfplayer, choice_entry[1] )
		local cost = AIResource_GetResurrectSquadCost( squad )
		return GetETAFromCost( cost, availableResources )
	end
	
	return 0
end

-- takes a table filled with chosen units, and this picks 
function ChooseBestAvailableUnitFromList( sorted_choices, availableResources )
		
	if (sorted_choices==nil) then
		aitrace("Nothing to purchase!")
		return nil
	end
	
	local num_choices = table.getn( sorted_choices )
	aitrace("Num Choices:"..num_choices)
	
	if (num_choices == 0) then
		aitrace("Nothing to purchase!")
		return nil
	end
	
	local found_valid = false
	-- initialize the best choice as the first one
	local best_choice = sorted_choices[1]

	-- return pos between 0 and num_choices-1
	local random_startpos = AI_RandMax( num_choices )
	aitrace("Rand start choice:"..random_startpos)
	
	for k,v in pairs(sorted_choices) do
	
		local choice_index = random_startpos+k
		-- loop around check
		if (choice_index > num_choices) then
			choice_index = choice_index - num_choices
		end
	
		-- get this choice
		local choice = sorted_choices[ choice_index ]
		
		-- if requested, see if this item can be built immediately
		local passedETATest = true
		
		if (availableResources) then
			local eta = GetETAFromChoice( choice, availableResources )
			if (eta==nil or eta>0) then
				passedETATest = false
			end
		end
		
		if (passedETATest) then
		
			local prevReq = 0
			-- look at pbgs that need a spawner
			if (choice[3] == PURCHASETYPE_SPAWN) then
				-- see if this choice is available
				prevReq = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, choice[1] )
			end
			aitrace("Trying to purchase "..PBG_GetName( choice[1] ).."! Available:"..prevReq )
			
			-- if this choice has a place to be built, then lets build it
			if (prevReq==0) then
				aitrace("Chose a free unit, index:"..choice_index)
				best_choice = choice
				found_valid = true
				break
			end
		end
	end
	
	return best_choice, found_valid

end

function FindZeroETAUnit( availableResources )
	
	aitrace("FindZeroETAUnit")
	
	-- generate a request for this unit if can be built
	local sorted_choices = HighestSquadDemand(0.8)
	
	-- runs through the list of demanded units and finds one that can be built (not checking money)
	local best_choice, is_valid = ChooseBestAvailableUnitFromList( sorted_choices, availableResources )
	
	-- see if found anything
	if (best_choice==nil or is_valid==false) then
		return
	end
		
	-- tries to purchase the best choice, if not it locks the resources anyways
	local purchased, cost = TryPurchaseUnitChoice( best_choice, availableResources )
	
	return purchased, cost
end

function TryPurchaseUnitChoice( best_choice, availableResources ) 

	-- set readable vars
	local pbg, demand, purchase_type = best_choice[1], best_choice[2], best_choice[3]
		
	if (pbg) then

		if (purchase_type == nil) then
			error("PURCHASE TYPE HAS NOT BEEN DEFINED!! "..PBG_GetName(pbg))
		end

		aitrace("Highest demand:: type:"..tostring(purchase_type).." demand:"..tostring(demand).." name: "..PBG_GetName( pbg ));
		local unitCost
		
		if (purchase_type==PURCHASETYPE_SPAWN) then
			-- EliteAI step 2 (ENERGY 0.12): within PopMargin of the cap the spawn cannot be asked for - it waits for nothing and
			-- locks nothing for the budgets after this one (EliteAI_PopCapped above)
			if EliteAI and EliteAI.on and EliteAI_PopCapped() then return false end
			unitCost = SquadStats_GetCost( s_self_modplayer, pbg )
		elseif (purchase_type==PURCHASETYPE_ABILITY) then
			unitCost = AIAbility_GetCost( s_self_modplayer, pbg )
		elseif (purchase_type==PURCHASETYPE_REINFORCE) then
			unitCost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
		elseif (purchase_type==PURCHASETYPE_RESURRECT) then
			local squad = AIResource_GetUnconsciousSquadByPBG( s_selfplayer, pbg )
			unitCost = AIResource_GetResurrectSquadCost( squad )
		end
		
		-- determine if this can purchase this item
		if (not ResourceAmount_Has( availableResources, unitCost )) then
			aitrace("Stalling because of lack of moola("..PBG_GetName(pbg)..") Demand:"..demand)
			-- EliteAI (energy): the spawn the pipeline waits for - squad upgrades wait for it when it is within reach (Conf_AddonVsUnit)
			if EliteAI and EliteAI.on and purchase_type == PURCHASETYPE_SPAWN then
				EliteAI_EnergyNoteStall( pbg, unitCost, "money", availableResources, 0 )
				-- 0.6: a call-in this budget can pay and the arbiter lets pass over the unit goes now - nothing is locked for the unit
				local cn, cc = EliteAI_CallInFirst( pbg, unitCost, "money", availableResources )
				if cn then return true, cc end
			end
			return false, unitCost
		end
	
		-- do the following checks for ability spawned units
		if (purchase_type==PURCHASETYPE_ABILITY) then
			
			-- count number of abilities inactive
			local taskCount = Task_CountActive( s_selfplayer, TASK_PlayerAbility, false )
			-- only request one of these at a time
			if (taskCount>0) then
				aitrace("PlayerAbility had already been purchased, skipping!")
				return false, unitCost
			end
			
			aitrace("Producing an ability-based unit("..PBG_GetName(pbg)..") Demand:"..demand)
			-- cast this ability which creates a request
			PlayerAbility_Cast( pbg )
						
		elseif (purchase_type==PURCHASETYPE_REINFORCE) then
			
			Request_Production( s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits+20, PITEM_SquadReinforce, pbg )
			if EliteAI and EliteAI.on then
				EliteAI_ReinforceNoteRequest( unitCost )                            -- reinf: the ledger of the last minute
				EliteAI_EnergyPay( "reinf", unitCost and unitCost.requisition, unitCost and unitCost.power )
			end

		elseif (purchase_type==PURCHASETYPE_RESURRECT) then
			
			-- EliteAI 0.8 (Orca's match on newai-17: "buy_revive 620 ... 250/0 bank 262/165" three times in one tick, the book says
			-- "revive 6x 1500" for two revivals of 250 - the units budget runs several passes a tick and the task count Elite
			-- checks is the last tick's): one request per Energy_ReviveGap (10 s)
			local rev_now = World_GetGameTime()
			local rev_dup = EliteAI and EliteAI.on and EliteAI_E ~= nil and EliteAI_E.rev_t ~= nil and rev_now - EliteAI_E.rev_t < eai_num("Energy_ReviveGap", 10)
			if not rev_dup then Request_Resurrection( s_selfplayer, TGROUP_Resurrect, TPRIORITY_BuildUnits+20, pbg ) end
			if EliteAI and EliteAI.on and EliteAI_E ~= nil and not rev_dup then EliteAI_E.rev_t = rev_now end
			-- EliteAI 0.7: the commander's revival was in no book and in no line (a purchase of this budget like the others)
			if EliteAI and EliteAI.on and unitCost ~= nil and not rev_dup then
				eai_log("buy_revive", eai_time(), string.lower(PBG_GetName(pbg) or ""), s_rp(unitCost), "bank", s_rp(cache and cache.resources))
				EliteAI_EnergyNote( "revive", unitCost )
			end

		else
			-- get the number of producers available (with considering requests/queues) for the given pbg
			local prevReq = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, pbg )
			
			aitrace("MinimumFullChannels:"..prevReq)
		
			-- if there are no channels open - then stall this request
			if (prevReq > 0) then
				aitrace("Stalling unitbuild because of lack of production channels("..PBG_GetName(pbg)..") Demand:"..demand)
				-- EliteAI (energy): the money is there, the HQ is busy - the upgrades of the other run leave this unit its req (Conf_AddonVsUnit)
				if EliteAI and EliteAI.on then
					EliteAI_EnergyNoteStall( pbg, unitCost, "channel", availableResources, prevReq )
					local cn, cc = EliteAI_CallInFirst( pbg, unitCost, "channel", availableResources )   -- 0.6: the HQ is busy, the call-in needs none
					if cn then return true, cc end
				end
				return false, unitCost
			end
	
			-- EliteAI 0.6 (TECH_RU.md 15.2): the call-in or this unit is decided before the unit is bought (the scene d: the unit took
			-- the bank in the tick the call-in of the same price could first be cast, the arbiter never saw the pair)
			if EliteAI and EliteAI.on then
				local cn, cc = EliteAI_CallInFirst( pbg, unitCost, "ready", availableResources )
				if cn then return true, cc end
			end
			-- 11.11 (20.10, s25b): no request the engine refuses for the population cap (phantom "buy" lines, the counter's demand
			-- "answered" by nothing); PopMargin = room for a squad of the line
			if EliteAI and EliteAI.on and cache then
				local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
				if popmax > 0 and popmax - pop < eai_num("PopMargin", 8) then return false, unitCost end
			end
			-- EliteAI 0.9 (TECH_RU.md 21.13; s27a / s27b: "buy" every 3-4 s with a growing bank and no squad). A request the engine
			-- does not start stays inactive, Elite kills it at the next purchase tick and this place asks again - and wrote "buy"
			-- and booked the cost every time. Now: (1) nothing is asked while the last requests died (EliteAI_UnitPause) or while
			-- the engine says it cannot start this blueprint now (AIProduction_CanProduceNow - the watchdog's "now false": pop,
			-- the producer): the blueprint steps aside for Unit_NotNowMute and nothing is locked for it; (2) the request is
			-- noted and gets its verdict at the next tick (u_settle): "buy ... by task|count|bank" and the book, or "buy_dead"
			if EliteAI and EliteAI.on then
				if EliteAI_UnitPause( World_GetGameTime() ) then return false, unitCost end
				if eai_num("Unit_NowOnly", 1) >= 1 and not AIProduction_CanProduceNow( s_selfplayer, PITEM_Spawn, pbg ) then
					EliteAI_UnitNotNow( pbg, unitCost )
					return false
				end
			end
			aitrace("Producing a unit("..PBG_GetName(pbg)..") Demand:"..demand)
			if EliteAI and EliteAI.on then
				EliteAI_UnitNoteRequest( pbg, string.lower(PBG_GetName(pbg) or ""), unitCost, "", true )   -- its "buy" line and the book: u_settle
			end
			Request_Production( s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits, PITEM_Spawn, pbg )
			print("UnitPurchase: Produce:"..PBG_GetName(pbg)  )
		end
		
		if (s_designer_squad_chosen) then
			DesignerDemandChosen( s_designer_squad_chosen )
		end
		
		return true, unitCost
	end
		
	return false

end

-- purchase_count - is the number of times this frame we have purchased units (for when we have lots of money)
function strategy_unit_purchase.do_purchase( availableResources, purchase_count )
	
	-- check to see if this is enabled
	if (s_components[COMPONENT_BuildUnits]==false) then
		aitrace("SKIPPING - Build-Unit-Strategy COMPONENT")
		return
	end

	AIProfile_Marker("AIUnitPurchase")
	
	aipushtrace("Build-Unit-Strategy")

	-- EliteAI (spend): the idle-bank watchdog goes first - before reinforcements, the difficulty cap and Elite's demand
	if EliteAI and EliteAI.on then
		EliteAI_P.pass = purchase_count or 0                                -- 13: the plan's next unit is noted on the first pass only
		EliteAI_EnergyTick( purchase_count )                                -- energy: float state, units-vs-upgrades arbiter, stats
		EliteAI_ReinforceTick( availableResources, purchase_count )         -- reinf: squad scan, save state, stats (numbers only)
		-- energy 0.2: the tech plan's reserve is off this budget whatever the order of the budgets in this tick (scene c: the plan
		-- wanted T3 at 0.2 s, the units budget ran first and bought an ogryn with the whole bank at 0.3 s; c2: the genestealer)
		if availableResources ~= nil then
			EliteAI_E.av_req, EliteAI_E.av_pow = availableResources.requisition or 0, availableResources.power or 0   -- what the budget system gave (the stall line)
			availableResources = e_reserved( availableResources, false )
		end

		local sp, sc = EliteAI_SpendIdle( availableResources, purchase_count )
		if sp then
			aipoptrace()
			return sp, sc
		end
	end

	local reinforce_only = false
	-- is unit purchasing disabled because the AI has too many units? 
	if (s_designer_demand_enabled == false and state_analysis.enable_military_unit_building==false) then
		aitrace("AI Has Too Many Units As Per Difficulty Level - REINFORCE ONLY")
		reinforce_only = true
		-- EliteAI (11.11, the scene polygon): Elite's cap of the Easy / Normal personalities ("glue": no new units, reinforcements
		-- only, while our army is glue_military_percentage times the closest enemy's - state_analysis.ai:29-65, base_standard.ai:54-58)
		-- is not for the new logic, which plays the standard personality but is meant to be one good player. In the polygon's
		-- scenes (a strong army against dummies) it switched the unit pipeline off from the second second on: "builds next to
		-- nothing", and no counter unit could be bought against a garrison. Spend_NoGlue=0 gives the cap back.
		if EliteAI and EliteAI.on and eai_num("Spend_NoGlue", 1) >= 1 then
			reinforce_only = false
			local now = World_GetGameTime()
			if EliteAI_S.glue_said == nil or now - EliteAI_S.glue_said >= 60 then
				EliteAI_S.glue_said = now
				eai_log("SPEND", "cap", "off", "Elite's unit cap ignored (reinforce only), building goes on:", "mil", math.floor((cache and cache.military_value) or -1),
					"pct", string.format("%.2f", math.min((cache and cache.military_percent_value) or 0, 9999)), "glue", tostring(s_personality and s_personality.glue_military_percentage))
			end
		end
	end
	
	aitrace("------------------------------------")
	
	-- this determines the amount of time we will wait for the next best unit
	CalculateUnitETA(purchase_count)
	
	-- reset the demand system - since we are going to start all over again
	ResetDemand()
	
	-- if designer demand is enabled, we will use the values they have set
	if (s_designer_demand_enabled==true) then
		aitrace("Designer Demand Enabled")
		
		s_designer_squad_chosen = CalcDesignerDemand()
		-- get info from designers/scar to determine the demand of units
		-- if this returns nil, try the designer preferences
		if (s_designer_squad_chosen==nil) then
			AccumulateSquadDemand( availableResources, reinforce_only )
		end
	else
		aitrace("Calculating demand from game-state")
		
		-- calculate demand based on the world state
		Demand_UpdateAICombatRatings()

		-- calc capturing demand values
		CalcCapturerDemand()
		
		-- take all the demands (class, anti-class, preferences) and set the demand per squad
		AccumulateSquadDemand( availableResources, reinforce_only )

	end
	
	-- EliteAI (13): the plan's next unit becomes the claim before the choice - a reinforcement that goes first in this tick
	-- no longer hides that a unit is waited for (EliteAI_PlanClaim)
	if EliteAI and EliteAI.on and purchase_count == 0 then EliteAI_PlanClaim( availableResources ) end

	-- generate a request for this unit if can be built
	local sorted_choices = HighestSquadDemand(s_demand_variance)
	
	-- runs through the list of demanded units and finds one that can be built (not checking money)
	local best_choice = ChooseBestAvailableUnitFromList( sorted_choices )
	
	-- see if found anything
	if (best_choice==nil) then
		aipoptrace()
		return
	end

	-- EliteAI 0.9 (TECH_RU.md 21.13, the polygon's scene p_ork_answer): Elite takes one of the choices within the variance by a
	-- random start - the deff dread (270) became affordable before the tankbustas (300) the Counter layer asked for and was
	-- bought every time the bank reached it. An answer among the choices goes first (it waits for its money as Elite's own choice would)
	if EliteAI and EliteAI.on then best_choice = EliteAI_AnswerChoice( sorted_choices, best_choice ) end
		
	-- tries to purchase the best choice, if not it locks the resources anyways
	local purchased, cost = TryPurchaseUnitChoice( best_choice, availableResources )

	-- EliteAI (energy 0.2): while the tech plan holds its reserve, a unit that is short of money locks nothing - the research is
	-- first whatever the order of the budgets (the lock of a stalled genestealer left the research "avail 0/855", scene c2)
	if EliteAI and EliteAI.on and purchased == false and cost and ((EliteAI_E.res_req or 0) + (EliteAI_E.res_pow or 0)) > 0 then
		return false                                                        -- (no aipoptrace: as Elite's own return at the end of this function)
	end
	
	-- if we didn't purchase anything but locked some money, and we have excess money, see if we can 
	-- buy anything with the leftovers
	if (purchased==false and cost and cache.resources.requisition > 750) then
		-- 
		aitrace("Trying to use up excess requisition")
		local modifiedRes = ResourceAmount_Subtract( availableResources, cost )
		if (modifiedRes.requisition > 100) then
			local eta_purchase, eta_cost = FindZeroETAUnit( modifiedRes )
			if (eta_purchase and eta_cost) then
				local total_cost = ResourceAmount_Add( cost, eta_cost )
				return false, total_cost
			end
		end
		
	end
	
	return purchased, cost
	
end

else
-- EliteAI 10.11 (step 4b): copy of Elite 3.2.1 strategy_unit_purchase.ai + purchase variety for the new logic
-- (EliteAI.on, set in main.ai). Elite's AIs (EliteAI.on false/nil) run exactly the original code.
-- 1) diversity: the more squads of one blueprint (and of one class: troops/vehicles) we have, the lower its demand;
--    blueprints not built yet get a bonus. The enemy army is already in Elite's demand (CombatRatingDiff vs enemy team).
-- 2) super units (Baneblade, Land Raiders, Great Unclean One, Avatar, Swarmlord...): none before SuperMinTime (s) and
--    without SuperMinArmy combat squads, one at a time; until then the money goes into the army.
-- Tuning from EliteAI.ini [Lua]: DivK, DivShare, DivNew, CatShare, SuperMinTime, SuperMinArmy, SuperMult, SuperCost.
-- 3) spend (10.11, after import below): an idle-bank watchdog - money above Spend_BankReq/Spend_BankPow for Spend_IdleSecs
--    without a spawn is spent on units (diversity score, no engine demand) and squad upgrades; log "SPEND idle bank ...".
--    The class-share damping (CatShare) applies only to races with two unit classes among the buildables (tyranids: all
--    "inf" -> every unit got x0.36 before).
-- 4) reinf (10.11, after the spend block): the reinforcement budget - while the power bank piles up and the req bank is below
--    the next tier / the cheapest power unit, cheap squads (spawn cost power < Spend_PowUnit) are reinforced only by the rules
--    of the arbiter Conf_ReinforceVsSave (A/B/C) and within a share of the req income; log "REINF ...".
-- 5) gate (10.11, step 15): one verdict EliteAI_GateDrop for every blueprint we forbid (a super unit outside its window, a limit
--    of 0): no demand at all in AccumulateSquadDemand (so it is never the "first" choice Elite stalls on and reserves nothing),
--    not a candidate of the watchdog; log "GATE drop <sbps> <why>". The watchdog's "locked" exit (nothing affordable within the
--    budget's share while the bank could pay) no longer stops it: it buys over the locks of the budgets ahead of ours in the order
--    (BUDGET_PlayerAbility, Elite's researches), never over the tech plan's reserve (EliteAI_TechReserve); log "-> buy ... over_lock".
-- 6) energy (11.11, the scene polygon; the block after the reinf block): power in excess and req short - the req goes where the
--    power goes (units and squad upgrades by the power share of their cost, the next tier at once, no new generators), squad
--    upgrades respect the tech plan's reserve and wait for a unit that is within reach (arbiter Conf_AddonVsUnit A/B/C), "save"
--    only for a unit the income brings within Energy_EtaMax; every upgrade bought is logged ("buy_addon"); log "ENERGY ...".
-- 7) garrison (11.11): while mod/mechanics.ai reports an enemy squad in a building next to our point (EliteAI.gar) for
--    Gar_BuySecs, the counter units of reports/tactics_kb/kb.yaml and flamer / grenade upgrades get a higher demand; log "GAR ...".
EliteAI_P = { cost_logged = {}, tier_seen = {}, ncls = 2, pass = 0 }   -- tier_seen[name] = our tech level when the unit first became producible
local function eai_num(key, default)
	if EliteAI and EliteAI.num then return EliteAI.num(key, default) end
	return default
end
local function eai_log(...)
	if EliteAI and EliteAI.log then EliteAI.log(...) end
end
local function eai_time()
	local t = World_GetGameTime()                                           -- 12: direct (was a silent pcall)
	if t then return math.floor(t) end
	return -1
end
local SUPER_NAMES = { "baneblade", "landraider", "land_raider", "great_unclean_one", "avatar", "swarmlord", "squiggoth", "stompa" }
local function eai_class(name)
	if string.find(name, "heroes", 1, true) then return "hero" end
	if string.find(name, "vehicles", 1, true) then return "veh" end
	return "inf"
end
-- once per AccumulateSquadDemand: counts of our squads per class among the buildable blueprints
function EliteAI_PurchasePrep()
	local P = EliteAI_P
	P.cls = { inf = 0, veh = 0, hero = 0 }; P.total = 0; P.supers = 0
	P.tier_n, P.dmax, P.dmax_name = {}, 0, "-"         -- 0.7: our units by the tier they came with; the top of Elite's demand (EliteAI_PurchaseShape)
	P.ans = {}                                         -- 0.8: the blueprints the Counter / Setup / Garrison layers ask for in this tick (EliteAI_PurchaseMult)
	local races = {}                                   -- 0.8: the race folders of the buildable list (EliteAI_GateDrop "foreign")
	local worth = 0                                    -- 12: req worth of the squads we have (alive + ordered) - the army's share below
	local seen = { inf = false, veh = false }          -- which classes this race can build at all (tyranids: "inf" only)
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		local name = string.lower(PBG_GetName(pbg) or "")
		local c = UtilPBG_CountTotal( pbg )
		local k = eai_class(name)
		if k ~= "hero" then seen[k] = true end
		local _, _, rf = string.find(name, "[/\\](race_[%l%d_]+)[/\\]")
		if rf ~= nil then races[rf] = (races[rf] or 0) + 1 end
		-- tech (10.11): the tier of a unit = our tech level when it first became producible (AIProduction_CanProduce, as in
		-- AccumulateSquadDemand below); for the new logic the level stays while a research runs (strategy_tech_purchase.ai)
		if not P.tier_seen[name] and AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) then
			-- verify 10.11: the level fresh, not cache.tech_tier_level (refreshed later: in t7 chimera/leman_russ/carnifex got tier-1 labels)
			P.tier_seen[name] = (CalculateCurrentTechLevel and CalculateCurrentTechLevel()) or (cache and cache.tech_tier_level) or 1
		end
		P.cls[k] = P.cls[k] + c
		if k ~= "hero" then P.total = P.total + c end
		if k ~= "hero" and c > 0 and P.tier_seen[name] then P.tier_n[P.tier_seen[name]] = (P.tier_n[P.tier_seen[name]] or 0) + c end
		-- 0.7: the highest demand Elite's engine rating gives a blueprint we may buy now (the calls and their order are those of
		-- AccumulateSquadDemand below: AIProduction_CanProduce, then CalcSquadDemand, then the gate)
		if k ~= "hero" and eai_num("Demand_Gamma", 0.4) < 1 and AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) == true then
			local d = CalcSquadDemand( pbg )
			if d > P.dmax and not EliteAI_GateDrop( pbg, name ) then P.dmax, P.dmax_name = d, name end
		end
		if k ~= "hero" and c > 0 then
			local cost = SquadStats_GetCost( s_self_modplayer, pbg )
			worth = worth + c * ((cost and cost.requisition) or 0)
		end
		if EliteAI_IsSuper(pbg, name) then P.supers = P.supers + c end
	end
	P.ncls = (seen.inf and 1 or 0) + (seen.veh and 1 or 0)
	P.army_req = worth
	local rbest, rn = nil, 0                           -- the folder most of the list lies in; a tie: the first by name (no order of pairs())
	for rf, c in pairs(races) do if c > rn or (c == rn and (rbest == nil or rf < rbest)) then rbest, rn = rf, c end end
	P.race = rbest
end
function EliteAI_IsSuper(pbg, name)
	for _, s in ipairs(SUPER_NAMES) do
		if string.find(name, s, 1, true) then return true end
	end
	-- 12 (TECH_RU.md 11.10): direct, the blueprint checked first - was a pcall that swallowed the error without a line, on
	-- every blueprint of the demand every tick. The same call with the same arguments has run bare since step 13 (r_need,
	-- EliteAI_PurchaseMult with a power bank, the watchdog) and is Elite's own (TryPurchaseUnitChoice).
	if pbg == nil then return false end
	local cost = SquadStats_GetCost( s_self_modplayer, pbg )
	if cost and (cost.requisition or 0) + (cost.power or 0) >= eai_num("SuperCost", 1000) then return true end
	return false
end
-- gate (10.11, step 15): the one verdict for a blueprint we forbid - why (a string) or nil = allowed. "cap0" = s_unit_purchase_limit 0
-- (spore mines, IG spotters); "super_time" / "super_army" / "super_have" = a super unit before SuperMinTime, with fewer than
-- SuperMinArmy combat squads, or while one is alive/queued. Called before the demand (AccumulateSquadDemand: demand 0 -> no ETA, no
-- entry in HighestSquadDemand, never the "first" choice TryPurchaseUnitChoice stalls on, nothing reserved), by the watchdog and by
-- EliteAI_PurchaseMult (a super unit outside its window: x0). Log "GATE drop <sbps> <why> t T army N have H" at most once per
-- Gate_LogSecs per blueprint and reason. State between ticks: numbers/strings only (EliteAI_G); no pcall, no randomness.
EliteAI_GATE_VERSION = "0.1"
EliteAI_G = { said = {}, n_drop = 0 }
function EliteAI_GateDrop(pbg, name)
	local P = EliteAI_P
	if not P.cls then EliteAI_PurchasePrep() end
	local why = nil
	local cap = s_unit_purchase_limit and s_unit_purchase_limit[ PBG_GetID( pbg ) ]
	local t, army = World_GetGameTime(), (cache and cache.military_count) or 0
	-- 0.8 (TECH_RU.md 21.6; BACKLOG "GK bought tau_kroot_squad"): a blueprint from another race's folder in OUR buildable list.
	-- The line of fb 621 was a tau AI of an earlier session in the same log file (p1001 "init race t_tau", 21:25), not the grey
	-- knights - so by default this only SAYS it, once per blueprint; Gate_Foreign=1 drops such a blueprint from every purchase path
	local foreign = P.race ~= nil and string.find(name, "race_", 1, true) ~= nil
		and string.find(name, P.race .. "\\", 1, true) == nil and string.find(name, P.race .. "/", 1, true) == nil
	if foreign and eai_num("Gate_Foreign", 0) < 1 then
		if EliteAI_G.said[name .. "|foreign_seen"] == nil then
			EliteAI_G.said[name .. "|foreign_seen"] = t
			eai_log("GATE", "foreign", name, "is not of", P.race, "(not dropped: Gate_Foreign=0)")
		end
		foreign = false
	end
	if cap and cap < 1 then why = "cap0"
	elseif foreign then why = "foreign"
	elseif EliteAI_IsSuper(pbg, name) then
		if t < eai_num("SuperMinTime", 1080) then why = "super_time"
		elseif army < eai_num("SuperMinArmy", 8) then why = "super_army"
		elseif (P.supers or 0) >= 1 then why = "super_have" end
	end
	if why == nil then return nil end
	local G = EliteAI_G
	G.n_drop = G.n_drop + 1
	local k = name .. "|" .. why
	local last = G.said[k]
	if last == nil or t - last >= eai_num("Gate_LogSecs", 30) then
		G.said[k] = t
		eai_log("GATE", "drop", name, why, "t", math.floor(t), "army", army, "have", P.supers or 0)
	end
	return why
end
-- 0.7 (TECH_RU.md 20.2) WHY THE DEMAND NEVER BECAME A PURCHASE. Malum's ork match (fb 590, newai-18): eleven deff dreads in a row
-- while "COUNTER demand ork_tankbustas x2 class vehicle" was written 38 times. Two things:
--  (1) Elite's demand is the engine's combat rating of the blueprint (CalcSquadDemand) and it spans orders of magnitude
--      ("top ork_battlewagon 22541.9"); our multipliers are x1.2 .. x2 and 1 / (1 + 0.35 n) - they never changed the order.
--      EliteAI_PurchaseShape: the rating is kept as an ORDER, its span is compressed - top x (demand / top) ^ Demand_Gamma (0.4):
--      a blueprint rated at a tenth of the top one stands at 0.40 of it, at a hundredth - 0.16. The top one keeps its value
--      (the reinforcement entries are measured against it as before). Demand_Gamma=1 = Elite's numbers.
--  (2) the purchases were the watchdog's: the power floated (454), so only blueprints of 40+ power were candidates (pmin) -
--      the tankbustas (power 30) were not, the battlewagon and the looted tank were out of the req's reach, "cand 1" = the
--      deff dread, every time. Now an ANSWER (the Counter / Setup / Garrison layers ask for it) is a candidate whatever its
--      power, and the watchdog waits for a better blueprint that the income brings within Spend_WaitEta (EliteAI_SpendIdle).
-- And the army of one kind: SameMax (3) squads of a blueprint, SameMaxBig (2) of a vehicle or of anything that costs
-- SameBigCost (450 req + power) or more; each one beyond that x SameOver (0.15). After a tier research (Malum fb 584: "it goes to
-- T2 and builds the T1 units as before"): the blueprints of the new tier x Tech_TierMult (1.5), and until Tech_TierWant (2) of
-- them are ours the older ones x Tech_OldTierMult (0.5) - an answer to the enemy's army keeps its weight. An answer that has
-- been asked for Counter_ForceSecs (90 s) and is still not ours: x Counter_ForceMult (3) on top ("COUNTER force ...").
function EliteAI_PurchaseShape( demand )
	local P = EliteAI_P
	local g, m = eai_num("Demand_Gamma", 0.4), P.dmax or 0
	if g >= 1 or demand == nil or demand <= 0 or m <= 0 or demand >= m then return demand end
	return m * (demand / m) ^ g
end
local function p_say( key, secs, ... )
	local P, now = EliteAI_P, World_GetGameTime()
	P.said = P.said or {}
	if P.said[key] ~= nil and now - P.said[key] < secs then return end
	P.said[key] = now
	eai_log(...)
end
local function p_short( name ) return (string.gsub(name or "", "^.*[/\\]", "")) end
-- multiplier for the demand of a buildable squad (new logic only); the second value: true = an answer the layers ask for
function EliteAI_PurchaseMult(pbg, curAmount)
	local P = EliteAI_P
	if not P.cls then EliteAI_PurchasePrep() end
	local name = string.lower(PBG_GetName(pbg) or "")
	if not P.cost_logged[name] then
		P.cost_logged[name] = true
		local cost = SquadStats_GetCost( s_self_modplayer, pbg )             -- 12: direct (was a silent pcall); pbg comes from the buildable list of this tick
		if cost then eai_log("cost", name, math.floor(cost.requisition or -1), math.floor(cost.power or -1), EliteAI_IsSuper(pbg, name) and "super" or "") end
		P.costs = P.costs or {}
		if cost then P.costs[name] = (cost.requisition or 0) + (cost.power or 0) end   -- 0.7: a number, for SameMaxBig
	end
	-- tech (10.11): the tier a unit belongs to = our level when it first became producible (cache.tech_tier_level stays
	-- during a research for the new logic, see strategy_tech_purchase.ai); units of the tier we just reached get a bonus
	local lvl = (cache and cache.tech_tier_level) or 1
	if not P.tier_seen[name] then P.tier_seen[name] = lvl end
	-- 0.9 (TECH_RU.md 21.13): a blueprint whose last request the engine did not start ("buy_dead") or cannot start now
	-- ("SPEND notnow") is no candidate until its mute is over - in Elite's demand, the plan's next unit and the watchdog alike
	if EliteAI_UnitMuted and EliteAI_UnitMuted( name ) then return 0, false end
	if EliteAI_IsSuper(pbg, name) then
		if EliteAI_GateDrop(pbg, name) then return 0, false end              -- gate: outside its window ("GATE drop", was "super_block")
		return eai_num("SuperMult", 0.6), false
	end
	local k = eai_class(name)
	if k == "hero" then return 1, false end
	local mult = 1 / (1 + eai_num("DivK", 0.35) * curAmount)
	-- 0.7: the answers first - they decide what the rules below may damp
	local gm = EliteAI_GarMult and EliteAI_GarMult( name, curAmount ) or 1
	local sm = EliteAI_SetupMult and EliteAI_SetupMult( name, curAmount ) or 1
	local cm = EliteAI_CounterMult and EliteAI_CounterMult( name, curAmount ) or 1
	local now0 = World_GetGameTime()
	if cm >= eai_num("Counter_ForceFrom", 2) and curAmount == 0 and eai_num("Counter_Force", 1) >= 1 then
		P.cn_since, P.cn_last = P.cn_since or {}, P.cn_last or {}
		if P.cn_since[name] == nil or now0 - (P.cn_last[name] or -1000) > eai_num("Counter_ForceGap", 30) then P.cn_since[name] = now0 end
		P.cn_last[name] = now0
		if now0 - P.cn_since[name] >= eai_num("Counter_ForceSecs", 90) then
			cm = cm * eai_num("Counter_ForceMult", 3)
			p_say("force|" .. name, 30, "COUNTER", "force", p_short(name), "x" .. cm, "asked for", math.floor(now0 - P.cn_since[name]), "s and not ours")
		end
	end
	local ans = (gm > 1 or sm > 1 or cm > 1)
	if P.ans ~= nil then P.ans[name] = ans end                               -- 0.8: the generators' turn reads it (e_gen_first)
	-- 0.7: SameMax - an army of one kind is no army
	if eai_num("SameMax", 3) > 0 then
		local big = (k == "veh") or ((P.costs and P.costs[name] or 0) >= eai_num("SameBigCost", 450))
		local cap = big and eai_num("SameMaxBig", 2) or eai_num("SameMax", 3)
		if curAmount >= cap then
			-- 0.8 (TECH_RU.md 21.6; 20.10: s25a / s25b, IG - the third and the fourth manticore were bought AFTER "SPEND same ig_manticore
			-- have 2 cap 2 big x0.150": the engine's rating of a manticore stands so far above the rest that x0.15 left it on top,
			-- and the watchdog's score is this multiplier too). The ceiling is a ceiling in every purchase path - the demand of
			-- Elite's pipeline, the plan's next unit, the watchdog all take the 0 from here: a vehicle or a squad of SameBigCost at
			-- its cap, any other squad SameHardOver (1) above it (the one squad in between stays damped x SameOver). SameHard=0 = 0.7.
			if eai_num("SameHard", 1) >= 1 and (big or curAmount >= cap + eai_num("SameHardOver", 1)) then
				P.n_same = (P.n_same or 0) + 1
				p_say("same|" .. name, 60, "SPEND", "same", p_short(name), "have", curAmount, "cap", cap, big and "big" or "-", "x0 hard")
				return 0, ans
			end
			mult = mult * eai_num("SameOver", 0.15) ^ (curAmount - cap + 1)
			P.n_same = (P.n_same or 0) + 1
			p_say("same|" .. name, 60, "SPEND", "same", p_short(name), "have", curAmount, "cap", cap, big and "big" or "-", string.format("x%.3f", eai_num("SameOver", 0.15) ^ (curAmount - cap + 1)))
		end
	end
	local total = P.total
	if total >= 4 then
		local share, smax = curAmount / total, eai_num("DivShare", 0.25)
		if share > smax then mult = mult * (smax / share) ^ 2 end
		local cshare, cmax = P.cls[k] / total, eai_num("CatShare", 0.6)
		-- spend (10.11): only when the race builds both classes; with one class the share is always 1 -> x0.36 on everything
		if (P.ncls or 2) >= 2 and cshare > cmax then mult = mult * (cmax / cshare) ^ 2 end
	end
	if curAmount == 0 and total >= 3 then mult = mult * eai_num("DivNew", 1.4) end
	if curAmount == 0 and lvl >= 2 and P.tier_seen[name] == lvl then mult = mult * eai_num("Tech_NewTierMult", 1.3) end   -- we teched for these
	-- 0.7: the tier we stand on (Malum fb 584) - its blueprints first, the older ones step back until Tech_TierWant of the new are ours
	if lvl >= 2 and eai_num("Tech_TierShift", 1) >= 1 then
		local ts, tn = P.tier_seen[name] or lvl, (P.tier_n and P.tier_n[lvl]) or 0
		if ts >= lvl then mult = mult * eai_num("Tech_TierMult", 1.5)
		elseif tn < eai_num("Tech_TierWant", 2) and cm <= 1 then
			mult = mult * eai_num("Tech_OldTierMult", 0.5)
			P.n_old = (P.n_old or 0) + 1
		end
	end
	-- 10.11 verify s9: power piles up (bank power >= Spend_BankPow) -> units that use little power (< Spend_PowUnit 40:
	-- guardsmen, hws, termagaunts) are damped x Spend_LowPowMult so the req goes to power units (chimera, leman russ,
	-- lictor, zoanthrope...); in s9 Elite and the watchdog kept buying 240-300 T1 squads while the power sat at 1000-1400
	local bank = cache and cache.resources
	local cost = nil
	if bank and (bank.power or 0) >= eai_num("Spend_BankPow", 300) then
		cost = SquadStats_GetCost( s_self_modplayer, pbg )
		-- energy (11.11): not when no power unit is within reach at this income (EliteAI_R.unreach, r_need) - then the cheap
		-- units are all there is and nothing is held back for a unit that will not come
		if cost and (cost.power or 0) < eai_num("Spend_PowUnit", 40) and not (EliteAI_R and EliteAI_R.unreach) and not ans then   -- (0.7: not an answer)
			mult = mult * eai_num("Spend_LowPowMult", 0.25)
			-- reinf (10.11): while saving req for a power unit / the next tier, the cheap spawns step back further
			if EliteAI_R and EliteAI_R.save then mult = mult * eai_num("Reinf_SaveSpawnMult", 0.4) end
		end
	end
	-- energy (11.11): power in excess, req short (EliteAI_E.float) - the req goes to the units whose cost is power-heavy
	if EliteAI_E and EliteAI_E.float then
		cost = cost or SquadStats_GetCost( s_self_modplayer, pbg )
		local cr, cp = (cost and cost.requisition) or 0, (cost and cost.power) or 0
		if cr + cp > 0 then mult = mult * (1 + eai_num("Energy_ShareK", 2) * cp / (cr + cp)) end
	end
	-- garrison (11.11): the counter units while an enemy squad holds a building next to our point (EliteAI_GarMult below)
	-- set-up teams (11.11, step 22): the counter units while the enemy fields two or more of them (EliteAI_SetupMult below)
	-- the enemy's army as we have seen it (11.11, step 24): the answers to its classes (EliteAI_CounterMult below; mod/mechanics.ai Counter)
	-- (0.7: worked out above - gm, sm, cm)
	mult = mult * gm * sm * cm
	return mult, ans
end


--
-- This file is responsible for prioritizing and purchasing all units.
--


import("util/demand.ai")
import("rules_unit_purchase.ai")

-------------------------------------------------------------------------------------------------
-- EliteAI 10.11 (spend): the idle-bank watchdog of the new logic (EliteAI.on only; Elite's AIs never get here).
-- WHY: Elite's unit purchase (do_purchase below) has several exits that buy nothing and write nothing: the popcap return
-- (AccumulateSquadDemand), "reinforce only" of the difficulty cap (state_analysis.enable_military_unit_building), the
-- engine demand PlayerStats_EvaluateSquadPurchaseCombatRatingDiff <= 0 for every blueprint ("demand > 0" gate), a
-- reinforcement/resurrection entry (demand x50 / x10) chosen instead of a spawn whose request then waits in the HQ channel
-- (every spawn stalls on PBG_GetNumRequestsForProducer, the request is killed as inactive 3 s later and placed again),
-- or no money in the budget's share. In t7 (newai-7, 2v2) the tyranids bought nothing for the last 8 minutes with a bank
-- of 1458/1197 and the log could not say which exit it was.
-- WHAT: when the bank stays above Spend_BankReq req or Spend_BankPow power for Spend_IdleSecs without a spawn, the units
-- budget buys on its own, before Elite's pipeline: every producible blueprint (s_unit_purchase_limit, the super-unit
-- rules and the diversity multiplier of EliteAI_PurchaseMult still apply, the engine demand does not), ranked by the
-- diversity score (fewest of this blueprint first; a blueprint the engine can start right now before one it cannot),
-- paid from the budget's availableResources (a tech reserve locked by strategy_tech_purchase.ai stays respected).
-- A request waiting in the HQ channel that is inactive (a reinforcement no squad goes home for; a spawn Elite would kill
-- next tick anyway, default.ai:201-217) is dropped first (Spend_KillInactive=1). One request per Spend_RetrySecs so a
-- request the engine cannot start does not spam. Squad upgrades: while the watchdog is "hot", CalcSquadUpgradeDemand is
-- floored at Spend_AddonFloor so strategy_addon_purchase.ai buys them too (power is not left either).
-- LOG (EliteAI.log, "AI: p<id> SPEND ..."): "SPEND idle bank R/P for T s -> buy <name> <cost> ..." / "-> none <why> ..."
-- (why: popcap, no_unit, locked = nothing affordable in the budget's share, blocked = only super units, channel N = an
-- active task holds the HQ, cooldown), at most once per Spend_LogSecs per reason; every line ends with a diagnostic
-- tail "| avail R/P reinf N need N resur N hq_tasks active/all pop c/m build on|off addon_floor N" plus
-- "engine_pos K/P top <name> <demand>" (how many producible blueprints Elite's own demand rates > 0) - this names the
-- silent exit of the next match; "SPEND idle end bank R/P after T s bought N" when the bank is below the threshold again.
-- SAFETY: numbers/strings between ticks only (EliteAI_S), PBGs are read and used within the tick, no pcall around engine
-- calls, every engine function is one Elite's own scripts call (file:line in reports/newai_1110/TECH_RU.md).
EliteAI_SPEND_VERSION = "0.9"
EliteAI_S = { last_buy = 0, above_t = -1, hot = false, said = {}, n_buy = 0, n_none = 0, addon_floor = 0, bought_hot = 0, cool = -1 }
local function s_on() return EliteAI ~= nil and EliteAI.on == true end
local function s_rp(r) return math.floor((r and r.requisition) or 0) .. "/" .. math.floor((r and r.power) or 0) end

-- the clock: above the threshold since when, "hot" after Spend_IdleSecs without a spawn; back to cold below the threshold
local function s_state( now, bank )
	local S = EliteAI_S
	local above = (bank.requisition or 0) >= eai_num("Spend_BankReq", 400) or (bank.power or 0) >= eai_num("Spend_BankPow", 300)
	if not above then
		if S.hot then
			eai_log("SPEND", "idle", "end", "bank", s_rp(bank), "after", math.floor(now - S.above_t), "s", "bought", S.bought_hot, "floored", S.addon_floor)
		end
		S.above_t, S.hot, S.bought_hot, S.addon_floor = -1, false, 0, 0
		return false
	end
	if S.above_t < 0 then S.above_t = now end
	-- 0.3 (TECH_RU.md 11): Spend_IdleSecs without a spawn and the bank above the threshold for Spend_AboveSecs. Was: above for
	-- the whole Spend_IdleSecs - one dip below it restarted the clock (s14, IG: the T2 research took the bank from 663 to 369 req,
	-- back at 455-663 the watchdog stayed cold for the next 63 s)
	if not S.hot and now - S.last_buy >= eai_num("Spend_IdleSecs", 45) and now - S.above_t >= eai_num("Spend_AboveSecs", 12) then
		S.hot, S.bought_hot, S.addon_floor = true, 0, 0
	end
	return S.hot
end

-- the diagnostic tail: the state of every silent exit of Elite's pipeline, this tick
local function s_diag( avail )
	local c = cache or {}
	local need = 0
	if AIProduction_AnyReinforcementsNeeded( s_selfplayer ) then need = AIProduction_GetReinforcementSquadCount( s_selfplayer ) end
	return string.format("| avail %s reinf %d need %d resur %d hq_tasks %d/%d pop %d/%d build %s addon_floor %d",
		s_rp(avail), Task_CountProduction( s_selfplayer, PITEM_SquadReinforce ), need, Task_Count( s_selfplayer, TGROUP_Resurrect ),
		Task_CountActiveInGroup( s_selfplayer, TGROUP_BuildUnits ), Task_CountInGroup( s_selfplayer, TGROUP_BuildUnits ),
		c.current_population_personnel or -1, c.max_population_personnel or -1,
		(state_analysis and state_analysis.enable_military_unit_building == false) and ((eai_num("Spend_NoGlue", 1) >= 1) and "off(ignored)" or "off") or "on", EliteAI_S.addon_floor)
end

-- called first in strategy_unit_purchase.do_purchase (every purchase tick, 3 s, and again when the budget loop re-runs);
-- returns true, cost when it placed a spawn request, nil otherwise (Elite's pipeline then runs as usual)
function EliteAI_SpendIdle( availableResources, purchase_count )
	if not s_on() or cache == nil or cache.resources == nil or availableResources == nil then return nil end
	local S = EliteAI_S
	local now = World_GetGameTime()
	local bank = cache.resources
	-- s9: the power bank decides (was: req bank < Spend_BankReq) - with req >= 400 and power 1000+ the watchdog bought guardsmen
	local pmin = ((bank.power or 0) >= eai_num("Spend_BankPow", 300)) and eai_num("Spend_PowUnit", 40) or 0
	if EliteAI_R and EliteAI_R.unreach then pmin = 0 end                    -- energy (11.11): no power unit within reach at this income - buy what there is
	if purchase_count == 0 then
		if not s_state( now, bank ) then return nil end
	elseif not S.hot then
		return nil
	end
	local for_s = math.floor(now - S.last_buy)                                 -- 0.3: seconds without a spawn (was: seconds above the threshold)
	local function none( why, ... )
		S.n_none = S.n_none + 1
		local last = S.said[why]
		if last and now - last < eai_num("Spend_LogSecs", 30) then return nil end
		S.said[why] = now
		local args, extra = { ... }, {}                                    -- Lua 5.1: "..." not in the last position is cut to one value
		for i = 1, table.getn(args) do extra[i] = tostring(args[i]) end
		eai_log("SPEND", "idle", "bank", s_rp(bank), "for", for_s, "s", "->", "none", why, table.concat(extra, " "), s_diag( availableResources ))
		return nil
	end
	if S.cool >= 0 and now - S.cool < eai_num("Spend_RetrySecs", 12) then return none("cooldown", S.cool_name or "-") end
	-- popcap: nothing can spawn (AccumulateSquadDemand returns the same way); the addon floor still works
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	-- 11.11 (20.10, s25b): at 97-100 of 100 every request was refused by the engine (no room for a squad) while the watchdog
	-- logged a "buy" every 3-4 s - near the cap there is no room for any squad of the line: PopMargin
	if pop >= popmax or popmax - pop < eai_num("PopMargin", 8) then return none("popcap", pop .. "/" .. popmax) end
	EliteAI_PurchasePrep()
	local lvl = cache.tech_tier_level or 1
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	local prod, afford, pos, bank_afford = 0, 0, 0, 0
	local best, best_score, best_name, best_cost, best_now = nil, -1, "-", nil, false
	local top_name, top_dem = "-", nil
	local cands = {}                                                           -- this tick only: { pbg, name, cost, score, now_ok }
	-- 0.9 (TECH_RU.md 21.13): s27b - "now false" in 6 "-> buy" lines of 15, none of the six was started by the engine (all runs:
	-- 56 of 57). What the engine cannot start now is no request (Unit_NowOnly=0 = as before: after the ones it can)
	local now_only = eai_num("Unit_NowOnly", 1) >= 1
	local notnow, nn_name, nn_score = 0, "-", -1
	local wait_best = nil                                                      -- 0.7: { name, score, eta } - numbers and a string
	local function better( now_ok, score ) return (now_ok and not best_now) or (now_ok == best_now and score > best_score) end
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		if AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) then
			prod = prod + 1
			local name = string.lower(PBG_GetName(pbg) or "")
			local dem = CalcSquadDemand( pbg )                                 -- Elite's (engine) demand: diagnostics only
			if dem > 0 then pos = pos + 1 end
			local cap = s_unit_purchase_limit and s_unit_purchase_limit[ PBG_GetID( pbg ) ]
			-- heroes: Elite's resurrection path; the gate: limit 0 and super units outside their window ("GATE drop")
			if eai_class(name) ~= "hero" and not EliteAI_GateDrop( pbg, name ) then
				-- 0.3: "top" names the best blueprint that may be bought (was: any - a gated swarmlord read as "saving for it")
				if top_dem == nil or dem > top_dem then top_dem, top_name = dem, name end
				local cur = UtilPBG_CountTotal( pbg )
				local mult, ans = EliteAI_PurchaseMult( pbg, cur )
				if cap and cur >= cap then mult = mult / ((cur - cap) + 6) end   -- Elite's damping over the limit (AccumulateSquadDemand)
				local cost = (mult > 0) and SquadStats_GetCost( s_self_modplayer, pbg ) or nil
				-- 10.11 verify s8: hot on power alone (req bank below Spend_BankReq) -> only units that use power
				-- (Spend_PowUnit 40: T2/T3 and vehicles); in s8 the power-only trigger spent the req on 240-300 T1 squads
				-- (guardsmen/termagaunts), the req never reached 350-575 for T2/T3 units or the IG T3 research
				if cost and (cost.power or 0) < pmin and not ans then mult = 0 end   -- (0.7: an answer is a candidate whatever its power)
				if mult > 0 then
					local score = mult * 2 / (2 + cur)
					local now_ok = AIProduction_CanProduceNow( s_selfplayer, PITEM_Spawn, pbg ) and true or false
					-- 0.7: the best blueprint the bank cannot pay yet - how far away is it (util/demand.ai GetETAFromCost, as the
					-- reinforcement entries below)
					if not ResourceAmount_Has( availableResources, cost ) and (wait_best == nil or score > wait_best.score) then
						local eta = GetETAFromCost( cost, availableResources )
						if eta ~= nil and eta <= eai_num("Spend_WaitEta", 75) then wait_best = { name = name, score = score, eta = eta } end
					end
					if ResourceAmount_Has( bank, cost ) then
						bank_afford = bank_afford + 1
						table.insert(cands, { pbg = pbg, name = name, cost = cost, score = score, now_ok = now_ok })
					end
					if ResourceAmount_Has( availableResources, cost ) then
						afford = afford + 1
						if now_only and not now_ok then
							notnow = notnow + 1
							if score > nn_score then nn_name, nn_score = name, score end
						elseif better( now_ok, score ) then
							best, best_score, best_name, best_cost, best_now = pbg, score, name, cost, now_ok
						end
					end
				end
			end
		end
	end
	local topstr = string.format("engine_pos %d/%d top %s %.1f pmin %d", pos, prod, top_name, top_dem or 0, pmin)
	if prod == 0 then return none("no_unit", topstr) end
	-- step 15 (s12): nothing fits the budget's share while the bank could pay = "locked": the money is held by the budgets ahead
	-- of ours in the order (util/budget.ai:310-361: BUDGET_PlayerAbility at weight 60 holds the cost of the chosen global ability
	-- until it casts, Elite's researches), not by a unit of ours (a gated super unit has no demand and reserves nothing). The
	-- watchdog then buys from what the bank really has - bank minus the tasks (budget.ai:271/318) minus the tech plan's reserve
	-- (EliteAI_TechReserve: the tier research promoted first) - the best candidate by the same rule. Spend_OverLock=0 = old exit.
	local over = nil
	if best == nil and bank_afford > 0 and eai_num("Spend_OverLock", 1) >= 1 then
		local free = ResourceAmount_Subtract( bank, Task_CountCost( s_selfplayer, false ) )
		local rr, rp = 0, 0
		if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
		local wr, wp = 0, 0
		if type(EliteAI_EnergyWalk) == "function" then wr, wp = EliteAI_EnergyWalk( now ) end   -- 0.9: the node a squad walks to (the engine holds its cost)
		free.requisition, free.power = (free.requisition or 0) - rr - wr, (free.power or 0) - rp - wp
		for _, c in ipairs(cands) do
			if ResourceAmount_Has( free, c.cost ) and (c.now_ok or not now_only) and better( c.now_ok, c.score ) then
				best, best_score, best_name, best_cost, best_now = c.pbg, c.score, c.name, c.cost, c.now_ok
			end
		end
		over = string.format("over_lock avail %s free %s reserve %d/%d", s_rp(availableResources), s_rp(free), rr, rp)
		if best == nil and notnow > 0 then return none("not_now", p_short(nn_name), "of", notnow, topstr) end   -- 0.9: the share pays, the engine cannot start it
		if best == nil then return none("locked", "bank_afford", bank_afford, "free", s_rp(free), "reserve", rr .. "/" .. rp, topstr) end
	end
	if best == nil then
		if afford == 0 and bank_afford > 0 then return none("locked", "bank_afford", bank_afford, topstr) end   -- other budgets hold it (Spend_OverLock=0)
		if afford == 0 then return none("poor", topstr) end                                                  -- the bank itself is short
		if notnow > 0 then return none("not_now", p_short(nn_name), "of", notnow, topstr) end                -- 0.9: the engine cannot start what the bank can pay (pop, the producer)
		return none("blocked", topstr)                                                                       -- only super units left
	end
	-- 0.7 (TECH_RU.md 20.2): what the bank can pay is far worse than what the income brings within Spend_WaitEta (its score is
	-- Spend_WaitK times lower - the fourth squad of a kind, a blueprint nobody asked for against an answer): the watchdog waits.
	-- At most Spend_WaitMax (120 s) in a row - then it buys what there is.
	if wait_best ~= nil and eai_num("Spend_Wait", 1) >= 1 and wait_best.score >= best_score * eai_num("Spend_WaitK", 1.6) then
		if S.wait_t == nil or now - (S.wait_last or -1000) > 15 then S.wait_t = now end
		S.wait_last = now
		-- 0.8 (TECH_RU.md 21.1): behind the tempo the bank does not lie for two more minutes - Tempo_WaitMax (30 s), then what there is
		local wmax = eai_num("Spend_WaitMax", 120)
		if type(EliteAI_Tempo) == "function" and EliteAI_Tempo() == true then wmax = math.min(wmax, eai_num("Tempo_WaitMax", 30)) end
		if now - S.wait_t < wmax then
			S.n_wait = (S.n_wait or 0) + 1
			return none("wait", p_short(wait_best.name), string.format("score %.2f eta %d", wait_best.score, wait_best.eta), "over", p_short(best_name), string.format("%.2f", best_score), topstr)
		end
	end
	-- the HQ channel (Elite stalls every spawn while a request waits there, TryPurchaseUnitChoice): an inactive request is
	-- dropped first - a reinforcement no squad goes home for, or a spawn Elite would kill next tick anyway (default.ai:201-217)
	local queued = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, best )
	local killed = 0
	if queued > 0 and eai_num("Spend_KillInactive", 1) >= 1 then
		local inactive = Task_CountInGroup( s_selfplayer, TGROUP_BuildUnits ) - Task_CountActiveInGroup( s_selfplayer, TGROUP_BuildUnits )
		if inactive > 0 then
			local back = Task_CountGroupCost( s_selfplayer, TGROUP_BuildUnits, false )
			ai_budget:add_resources( back, "BUDGET_Units" )
			Task_KillInactiveTasksInGroup( s_selfplayer, TGROUP_BuildUnits )
			killed = inactive
			queued = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, best )
		end
	end
	if queued > 0 then return none("channel", queued, best_name, "killed", killed, topstr) end
	-- 0.9: after requests the engine did not start ("buy_dead") nothing is asked for a while (EliteAI_UnitPause)
	if EliteAI_UnitPause( now ) then return none("dead_pause", best_name, topstr) end
	-- 0.9 (TECH_RU.md 21.13): a request, not a purchase yet - the "buy" line, the book, the idle clock, the save state and the
	-- plan's claim are settled at the next tick, when the engine has started it or not (EliteAI_UnitNoteRequest / u_settle)
	EliteAI_UnitNoteRequest( best, best_name, best_cost, over and "spend over_lock" or "spend", best_now )   -- (the count before the request)
	Request_Production( s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits, PITEM_Spawn, best )
	S.cool, S.cool_name, S.wait_t = now, best_name, nil
	eai_log("SPEND", "idle", "bank", s_rp(bank), "for", for_s, "s", "->", "ask", best_name, s_rp(best_cost),
		string.format("score %.2f now %s cand %d killed %d", best_score, tostring(best_now), afford, killed),
		over and (over .. " " .. topstr) or topstr, s_diag( availableResources ))
	return true, best_cost
end

-- squad upgrades while hot: strategy_addon_purchase.ai (UpdateSquadDemand) rejects an addon whose CalcSquadUpgradeDemand
-- (engine rating diff) is <= 1 - the same engine judgement that leaves the units unbought; floored, the addon budget buys
if type(CalcSquadUpgradeDemand) == "function" and not EliteAI_SpendAddonWrapped then
	EliteAI_SpendAddonWrapped = true
	local Elite_CalcSquadUpgradeDemand = CalcSquadUpgradeDemand
	CalcSquadUpgradeDemand = function( upgradePBG, aiSquad )
		local d = Elite_CalcSquadUpgradeDemand( upgradePBG, aiSquad )
		-- energy (11.11): also while the power floats or a garrison calls for flamers / grenades (the new filter of the
		-- addon run then sorts the candidates by the power share of their cost)
		if (EliteAI_S.hot or (EliteAI_E and EliteAI_E.float) or (EliteAI_GarAddon and EliteAI_GarAddon( upgradePBG ))) and s_on() then
			local f = eai_num("Spend_AddonFloor", 8)
			if d < f then
				-- energy 0.3 (TECH_RU.md 12): never for an upgrade that was bought before in this match - a second purchase is
				-- by the engine's own rating alone (s15, floating: the hero's weapons acid_splatter / devourer_ap bought in turn,
				-- four and three times, 110-145 req each - with the floor the item just replaced is a candidate again)
				local nm = (upgradePBG ~= nil) and string.lower(PBG_GetName( upgradePBG ) or "") or ""
				if EliteAI_E and EliteAI_E.abought and EliteAI_E.abought[nm] then return d end
				EliteAI_S.addon_floor = EliteAI_S.addon_floor + 1
				return f
			end
		end
		return d
	end
end

-------------------------------------------------------------------------------------------------
-- EliteAI 10.11 (reinf): the reinforcement budget of the new logic (EliteAI.on only; Elite's AIs keep their code).
-- WHY: Elite reinforces first. AccumulateReinforceDemand gives every squad that misses a model a demand x50 (sk_reinforce_mult)
-- whenever one model is affordable within 30 s, so a reinforcement entry outranks every spawn in HighestSquadDemand. In s10
-- (2v2, selenonfissure, 38cd631) the tyranids bought 7 squads and nothing after 13:08: the req income (175-266/min) went into
-- gaunt reinforcements (pop 57-79 with 6-9 squads, 86 models lost and replaced), the req bank stayed below 300 while the power
-- bank grew to 1287 - the T2/T3 units (genestealer 350/45, zoanthrope 360/40, lictor 400/65, carnifex 575/150) never got req.
-- WHAT: a "save" state with hysteresis: on while the power bank is >= Reinf_BankPow and the req bank is below `need` = what we
-- save for (the next tier research the tech plan wants and has not placed, or the cheapest producible unit that uses power
-- >= Spend_PowUnit; capped by Reinf_NeedMax); off when the power is spent (< Reinf_BankPow x Reinf_ExitK), the req is there
-- and nobody takes it (need + Reinf_ReqMargin), a power unit was bought (then a pause of Reinf_PauseSecs so the squads
-- refill) or after Reinf_SaveMax without such a buy (pause too: something else holds the money). While saving, a cheap squad
-- (spawn cost power < Spend_PowUnit: gaunts, guardsmen, hws...) gets its reinforcement demand only when the arbiter
-- Conf_ReinforceVsSave says so; squads that use power are always reinforced ("pow_unit"). Readiness = 1 - missing models /
-- the most models seen in one squad of that blueprint (missing = the engine's total reinforce cost / the cost of one model;
-- the weakest squad of a blueprint decides, the engine's request is per blueprint); "in a fight" = a squad of the blueprint
-- was under attack in the last scan. Rules: 1 (A) = save: only a weak squad (readiness <= Reinf_LowHp) that is NOT in a fight
-- is refilled (a losing fight gets no money; the director sends it home at RetreatHP); 2 (B) = balanced: a weak squad is
-- refilled, in a fight or not; 3 (C) = army first: every squad in a fight and every squad below Reinf_FullHp. On top, the
-- cheap reinforcements of the last minute may not exceed Reinf_Share of the req income per minute (0.2 / 0.35 / 0.5 by rule;
-- the ledger counts the requests TryPurchaseUnitChoice places). A decision per blueprint holds Reinf_ConfHold seconds,
-- every switch is logged. While saving, the spawn demand of the cheap units is damped x Reinf_SaveSpawnMult on top of
-- Spend_LowPowMult (EliteAI_PurchaseMult), so the saved req goes to the power units: Elite's own stall ("lack of moola")
-- then locks the money for the chosen power unit until it is affordable, and the watchdog (pmin) buys them too.
-- LOG (EliteAI.log, "AI: p<id> REINF ..."): "REINF init ...", "REINF save on|off req R pow P need N (<what>) why <why> rule K",
-- "REINF skip|allow <sbps> req R pow P why <why> miss M n N hit H rule K per C spent S cap C" (while saving; counted always,
-- printed at most once per Reinf_LogSecs per blueprint and verdict), "REINF Conf_ReinforceVsSave <sbps> allow->skip <why>
-- rule K" (every switch of the arbiter), "REINF stats ..." every Reinf_StatsSecs. Off without a rebuild: Reinf_BankPow=99999.
-- SAFETY: numbers and strings between ticks only (EliteAI_R); squads are read and dropped within the tick (aisq / sim squad
-- nil checks, Squad_Count > 0 before health); no pcall around engine calls; no randomness; every engine function is one
-- Elite's scripts or our in-game-verified files call (file:line in reports/newai_1110/TECH_RU.md section 8).
EliteAI_REINF_VERSION = "0.7"
EliteAI_R = {}
local function r_reset()
	EliteAI_R = { save = false, save_t = -1, sw_t = -1000, pause_until = -1, need = 0, need_what = "-", need_t = -1000, conf = {}, said = {},
		ledger = {}, sq = {}, maxc = {}, scan_t = -1000, last_stats = 0, n_skip = 0, n_allow = 0, n_sw = 0, n_req = 0, skip_est = 0,
		dir = {}, n_dir = 0, n_dir_poor = 0, n_dir_cap = 0, n_dir_mute = 0, dir_now = -1, dir_used = 0,   -- 0.2: the director's squads
		pow_buys = 0, last_pow_buy = -1, last_pow_name = "-", save_n = 0, save_secs = 0,
		cnt = {}, n_models = 0, req_models = 0, req_led = {}, free_until = -1,   -- 0.3: models that came (the real spend), the requests apart
		save_why = "-", uneed = 0, uneed_what = "-", last_buy = -1, last_buy_name = "-", claim_t = -1000,   -- 0.3: the "unit" save
		n_unit_skip = 0, n_dir_unit = 0, n_dir_lost = 0, dir_used_p = 0 }
end
r_reset()
local function r_short(name)                                                -- "sbps\pvp\race_tyranid\troops\tyr_termagaunt" -> "tyr_termagaunt"
	local s = string.lower(name or "")
	local _, _, short = string.find(s, "([^/\\]+)$")
	return short or s
end
local function r_key(name) return (string.gsub(string.lower(name or ""), "\\", "/")) end
local function r_vidx() local v = EliteAI and EliteAI.variant; return (v == "B" and 2) or (v == "C" and 3) or 1 end
local function r_rule()                                                     -- Conf_ReinforceVsSave = 1/2/3 (default: the variant)
	local r = math.floor(eai_num("Conf_ReinforceVsSave", r_vidx()))
	if r < 1 then r = 1 elseif r > 3 then r = 3 end
	return r
end
local function r_share()                                                    -- the share of the req income per minute for cheap reinforcements
	local r = r_rule()
	return eai_num("Reinf_Share", (r == 1 and 0.2) or (r == 2 and 0.35) or 0.5)
end
-- the arbiter's memory: a decision per blueprint holds Reinf_ConfHold seconds (hysteresis); every switch is logged
local function r_decide( key, v, why, now )
	local R = EliteAI_R
	local c = R.conf[key]
	if not c then R.conf[key] = { v = v, t = now }; return v, false end
	if c.v == v then return v, false end
	if now - c.t < eai_num("Reinf_ConfHold", 10) then return c.v, true end
	eai_log("REINF", "Conf_ReinforceVsSave", r_short(key), c.v .. "->" .. v, why, "rule", r_rule())
	c.v, c.t = v, now
	R.n_sw = R.n_sw + 1
	return v, false
end
-- the ledgers of the last 60 s (numbers only). 0.3 (TECH_RU.md 13): R.ledger = the req of the models that CAME (r_models below:
-- the real spend - the share cap and the book of purchases read it); R.req_led = the req of the requests placed, whatever
-- became of them (s16: "reinf 88x 2278" in the book and reinf_req_min 254-510 at an income of 240 - requests the engine killed
-- as inactive and Elite placed again, the same mistake the upgrades had before 12.3)
local function r_sum60( key, now )
	local R, keep, sum = EliteAI_R, {}, 0
	for _, e in ipairs(R[key]) do
		if now - e.t < 60 then table.insert(keep, e); sum = sum + e.req end
	end
	R[key] = keep
	return sum
end
local function r_ledger( now ) return r_sum60( "ledger", now ) end
-- the director's orders that are paid (or will be) and have not brought their model yet: req (each entry on its own, a sum)
local function r_pending( now )
	local sum = 0
	for _, d in pairs(EliteAI_R.dir) do
		if now - d.last <= 30 then
			local coming = d.sent - math.max(0, (d.have or d.n0) - d.n0)
			if coming > 0 then sum = sum + coming * (d.per or 0) end
		end
	end
	return sum
end
-- 0.3 the models that came, every units tick: a squad that has more models than at the last tick was reinforced - by Elite's
-- request, by the director's order (mode 6), whoever asked. That many models x the cost of one (AIPlayer_GetProductionCost,
-- PITEM_SquadReinforce: AccumulateReinforceDemand below) is what was really paid: into R.ledger and the book ("reinf").
-- Not counted: a squad seen for the first time and its first Reinf_NewSecs (it may leave the HQ model by model), the seconds
-- after a spawn ability (EliteAI_ReinforceFree: "without number" fills squads for the ability's price, which is in the book
-- as "abil"). A model lost and a model gained by one squad between two ticks cancel out (the book is a little low then); a
-- squad leader bought as an upgrade reads as one model (a little high). Numbers per squad id between ticks (R.cnt).
local function r_models( now )
	local R = EliteAI_R
	local newsecs, free = eai_num("Reinf_NewSecs", 6), (now < (R.free_until or -1))
	local n = Military_SquadTotalCount( s_selfplayer )                       -- strategy_addon_purchase.ai:120
	for i = 0, n - 1 do
		local aisq = Military_GetAISquadAtIndex( s_selfplayer, i )            -- strategy_addon_purchase.ai:123
		if aisq ~= nil then
			local s = AISquad_ConvertToSimSquad( aisq )                       -- tactics.ai:270 (nil for a squad that is not spawned)
			local c = (s ~= nil) and Squad_Count( s ) or 0
			local id = (c > 0) and Squad_GetGameID( s ) or nil                -- main.ai (the director's scan; in game since step 7)
			if id ~= nil then
				local e = R.cnt[id]
				if e == nil then
					R.cnt[id] = { c = c, t0 = now, t = now }
				else
					if c > e.c and now - e.t0 >= newsecs and not free then
						local pbg = AISquad_ConvertToPBG( aisq )
						if pbg ~= nil then
							local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
							local k = c - e.c
							local pr, pp = ((per and per.requisition) or 0) * k, ((per and per.power) or 0) * k
							table.insert(R.ledger, { t = now, req = pr })
							R.n_models, R.req_models = R.n_models + k, R.req_models + pr
							if EliteAI_EnergyNote then EliteAI_EnergyNote( "reinf", { requisition = pr, power = pp }, k ) end
						end
					end
					e.c, e.t = c, now
				end
			end
		end
	end
	for id, e in pairs(R.cnt) do if now - e.t > 60 then R.cnt[id] = nil end end   -- squads that are gone (each entry on its own)
end
-- a spawn ability was cast (mod/mechanics.ai): the models it brings are paid with the ability
function EliteAI_ReinforceFree( secs )
	if not s_on() then return end
	EliteAI_R.free_until = World_GetGameTime() + (secs or eai_num("Reinf_FreeSecs", 8))
end
-- our squads by blueprint, numbers only: EliteAI_R.sq[key] = { n, hit, low, minc }; EliteAI_R.maxc[key] = most models seen in one squad
local function r_scan( now )
	local R = EliteAI_R
	if now - R.scan_t < eai_num("Reinf_ScanSecs", 6) then return end
	R.scan_t = now
	local lowhp = eai_num("Reinf_LowHp", 0.5)
	local sq, maxc = {}, R.maxc
	local n = Military_SquadTotalCount( s_selfplayer )                       -- strategy_addon_purchase.ai:120
	for i = 0, n - 1 do
		local aisq = Military_GetAISquadAtIndex( s_selfplayer, i )            -- strategy_addon_purchase.ai:123
		if aisq ~= nil then
			local s = AISquad_ConvertToSimSquad( aisq )                       -- tactics.ai:270 (nil for a squad that is not spawned)
			local c = (s ~= nil) and Squad_Count( s ) or 0                    -- mechanics.ai:308 (in game since step 7)
			if c > 0 then
				local pbg = AISquad_ConvertToPBG( aisq )                       -- strategy_unit_purchase.ai:104 (Elite), strategy_addon.ai:188
				local key = (pbg ~= nil) and r_key(PBG_GetName( pbg )) or ""
				if key ~= "" then
					local e = sq[key]
					if not e then e = { n = 0, hit = 0, low = 0, minc = c }; sq[key] = e end
					e.n = e.n + 1
					if c < e.minc then e.minc = c end
					if not maxc[key] or c > maxc[key] then maxc[key] = c end
					if Squad_IsUnderAttack( s, 5 ) then e.hit = e.hit + 1 end      -- player-tactics.ai:51
					local hmax = Squad_GetHealthMax( s )                            -- tactics.ai:277
					if hmax > 0 and Squad_GetHealth( s ) / hmax <= lowhp then e.low = e.low + 1 end
				end
			end
		end
	end
	R.sq = sq
end
-- what we save the req for: the next tier research the tech plan wants and has not placed yet, or the cheapest producible unit
-- that uses power (>= Spend_PowUnit; heroes, forbidden and super units aside); 0 = nothing to save for; at most once per Reinf_NeedSecs
local function r_need( now )
	local R = EliteAI_R
	if now - R.need_t < eai_num("Reinf_NeedSecs", 10) then return R.need end
	R.need_t = now
	local need, what = 0, "-"
	local tech_first = false
	local T = EliteAI_T                                                      -- strategy_tech_purchase.ai (numbers; nil in the stub)
	if type(T) == "table" and T.want and T.k and (T.cost_req or 0) > 0 then
		local st = T.st and T.st[T.k]
		if not (st and st.started) then
			need, what = T.cost_req, "tech_" .. tostring(T.tag or "?")
			tech_first = (T.decision == "tech")                              -- 11: the plan holds its reserve - the save is for the research, not for a dearer unit
		end
	end
	local pmin = eai_num("Spend_PowUnit", 40)
	-- energy (11.11): only a unit the income brings within Energy_EtaMax is worth saving for (the polygon: the save state held
	-- the req for a unit while nothing could come for minutes); ETA by the req bank and the req income per minute (cache.ai:156)
	local req = (cache.resources and cache.resources.requisition) or 0
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local eta_max = eai_num("Energy_EtaMax", 120)
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	local best, best_name, best_eta, far, far_name, far_eta = nil, "-", 0, nil, "-", 0
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		if pbg ~= nil and AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) then
			local name = string.lower(PBG_GetName( pbg ) or "")
			local cap = s_unit_purchase_limit and s_unit_purchase_limit[ PBG_GetID( pbg ) ]
			if eai_class(name) ~= "hero" and not (cap and cap < 1) and not EliteAI_IsSuper( pbg, name ) then
				local cost = SquadStats_GetCost( s_self_modplayer, pbg )
				local cr, cp = (cost and cost.requisition) or 0, (cost and cost.power) or 0
				if cp >= pmin and cr > 0 then
					local eta = 0
					if cr > req then eta = (rate > 0) and (60 * (cr - req) / rate) or 11111 end
					if eta <= eta_max then
						if best == nil or cr < best then best, best_name, best_eta = cr, name, eta end
					elseif far == nil or cr < far then
						far, far_name, far_eta = cr, name, eta
					end
				end
			end
		end
	end
	local unreach = (best == nil and far ~= nil)                            -- power units exist, none within reach at this income
	if unreach ~= (R.unreach == true) then
		if unreach then
			eai_log("REINF", "need", "none", "cheapest power unit", r_short(far_name), math.floor(far), "req is", math.floor(far_eta), "s away at",
				math.floor(rate), "req/min (>", eta_max, "): not saving for it, cheap units are not held back")
		else
			eai_log("REINF", "need", "back", best and r_short(best_name) or "-", best and math.floor(best) or 0, "eta", math.floor(best_eta), "s")
		end
	end
	R.unreach = unreach
	if best and best > need and not tech_first then need, what = best, r_short(best_name) end
	local mx = eai_num("Reinf_NeedMax", 600)
	if need > mx then need = mx end
	R.need, R.need_what = need, what
	return need
end
-- 0.3 (TECH_RU.md 13) THE UNIT FIRST. s16 (tyranids): 4 units by 12:00, none for 464 s; a genestealer (350/45) waited from 6:03
-- to the end. From 7:00 to 10:30 the log has no "SPEND stall" line at all: a reinforcement entry (demand x50) was the first
-- choice of the units budget at every tick, its request (18 req) was placed, and the second pass of that tick runs with a
-- unit wait of 0 s (CalculateUnitETA) - a spawn that is not affordable at once is no entry there. So no unit was "stalled":
-- no lock of its money, no Conf_AddonVsUnit (the upgrades took ~650 req), no "save" (it asked for 300 power in the bank and
-- came at 10:41) - while 46 of 71 ticks placed a reinforcement request.
-- Now the plan's next unit is noted before the choice (EliteAI_PlanClaim, EliteAI_E.stall), whatever is bought first, and:
--   * "quick" - the unit has its money and waits for the HQ, or the income brings it within Reinf_UnitEta (45 s): a squad
--     gets a model only when it is weak (readiness <= Reinf_LowHp; rule 1: and not in a fight) or, rules 2 / 3, in a fight;
--     a squad that is not in a fight and above half waits for the unit (Elite's requests: the gate; the director's: the purse);
--     a unit that had its money and a free HQ at the last tick ("ready") and was not bought goes before every model;
--   * the "save" state comes on when the unit has been short of req for Reinf_WaitSecs (45 s) without a break, whatever the
--     power bank ("save on ... why unit short of req for N s"); it ends when a unit is bought (pause Reinf_PauseSecs: the
--     squads refill), when no unit is waited for (Reinf_ClaimGone 20 s), with the req there or after Reinf_SaveMax.
-- Reinf_UnitFirst=0 = as before (the power-bank save only).
-- 0.6 EXPENDABLES (TECH_RU.md 19.3; Orca's live matches against the tyranids, variant C - fb 544: "70 refills of gaunts, 114 models
-- lost, 8 units in 14 minutes"; newai-17, 22 minutes: 11 units 3290 req, 75 models 1644 req - 918 of them 18-req gaunts of six
-- broods - 143 models lost; the plan's genestealer 350/45 stood at "why money" for 210 s with 50-290 req in the bank). A cheap
-- brood that dies in every fight was refilled as a "weak" squad - past the unit that waits, within 60 % of the income - again
-- and again: the req of three units went into models that did not change a fight. The squads of REINF_EXPENDABLE (the races'
-- data, by a part of the sbps name: the gaunt broods - the testers' word; other races: no evidence, none listed), while a
-- unit of the plan WAITS (the stall record of the units budget, any reason):
--   * are not "weak" squads: no model past the unit;
--   * get models only from the req that lies in the bank BEYOND the unit's price (the unit waits for power or for the HQ:
--     the rest is free), and
--   * all of them together within Reinf_ExpShare (0.35) of the req income per minute.
-- No unit waits (the population cap, nothing wanted) - as any squad. Both ways of a model: the director's refill at home
-- (EliteAI_ReinforceDir) and Elite's own requests (EliteAI_ReinforceGate). Lines "REINF dir expendable ...", "REINF skip ...
-- expendable ..."; the stats: exp_held, exp_paid. Reinf_Exp=0 = as 0.5.
local REINF_EXPENDABLE = { "troops/tyr_termagaunt", "troops/tyr_hormagaunt", "troops/tyr_ripper" }
local function r_exp( key )
	if eai_num("Reinf_Exp", 1) < 1 or key == nil then return false end
	for _, k in ipairs(REINF_EXPENDABLE) do if string.find(key, k, 1, true) then return true end end
	return false
end
local function r_exp60( now )                                               -- req paid for expendables' models in the last minute
	local L, sum, keep = EliteAI_R.exp_log or {}, 0, {}
	for _, e in ipairs(L) do if now - e.t <= 60 then sum = sum + e.r; table.insert(keep, e) end end
	EliteAI_R.exp_log = keep
	return sum
end
local function r_exp_note( now, req )
	local R = EliteAI_R
	R.exp_log = R.exp_log or {}
	table.insert(R.exp_log, { t = now, r = req })
	R.exp_paid = (R.exp_paid or 0) + req
end
-- how many models of `pr` req an expendable squad may get now while the unit `st` waits (0 = none), and why not
local function r_exp_room( now, st, pr, used )
	local bank = cache.resources
	local rr = 0
	if type(EliteAI_TechReserve) == "function" then rr = EliteAI_TechReserve() or 0 end
	if pr <= 0 then return 99, nil end
	local beyond = math.floor(((bank.requisition or 0) - rr - (used or 0) - (st.req or 0)) / pr)
	if beyond < 1 then return 0, "unit" end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local fit = math.floor((rate * eai_num("Reinf_ExpShare", 0.35) - r_exp60( now )) / pr)
	if fit < 1 then return 0, "share" end
	return math.min(beyond, fit), nil
end
local function r_claim( now )                                               -- quick (bool), the record { name, req, pow, eta, why, msince } or nil
	local st = EliteAI_E and EliteAI_E.stall
	if st == nil or now - st.t > 7 or eai_num("Reinf_UnitFirst", 1) < 1 then return false, nil end
	local reach = eai_num("Reinf_UnitEta", 45)
	if type(EliteAI_TechUnitFirst) == "function" and EliteAI_TechUnitFirst() == true then reach = math.max(reach, eai_num("Tech_FloatUnitEta", 75) * 1.5) end   -- 0.5 (TECH_RU.md 15.3)
	return (st.why ~= "money") or ((st.eta or 0) <= reach), st
end
local function r_need_now()                                                 -- what the save state saves for: req, name
	local R = EliteAI_R
	if R.save and R.save_why == "unit" then return R.uneed or 0, R.uneed_what or "-" end
	return R.need, R.need_what
end
function EliteAI_ReinforceNeed() return r_need_now() end                    -- mod/mechanics.ai (the line of a held ability)
local function r_save_log( on, bank, why )
	local need, what = r_need_now()
	eai_log("REINF", "save", on and "on" or "off", "req", math.floor(bank.requisition or 0), "pow", math.floor(bank.power or 0),
		"need", math.floor(need), "(" .. what .. ")", "why", why, "rule", r_rule())
end
-- the save state: a switch holds Reinf_ConfHold seconds; a buy of what it saved for switches it off at once (then the pause)
local function r_save_state( now, bank )
	local R = EliteAI_R
	local req, pow = bank.requisition or 0, bank.power or 0
	local bp = eai_num("Reinf_BankPow", eai_num("Spend_BankPow", 300))
	local need = r_need( now )
	local hold = eai_num("Reinf_ConfHold", 10)
	local margin, pause, smax = eai_num("Reinf_ReqMargin", 200), eai_num("Reinf_PauseSecs", 45), eai_num("Reinf_SaveMax", 240)
	local _, st = r_claim( now )
	local short = (st ~= nil and st.why == "money")                         -- 0.3: the plan's unit is short of money ...
	local uwait = (short and st.msince ~= nil) and (now - st.msince) or -1  -- ... for this long without a break
	if st ~= nil then R.claim_t = now end
	if R.save then
		local why
		if R.save_why == "unit" then
			if short then R.uneed, R.uneed_what = st.req or 0, st.name or "-" end
			if R.last_buy >= R.save_t then                                  -- >=: the buy can come later in the tick that switched on
				why = "unit_buy " .. r_short(R.last_buy_name); R.pause_until = now + pause
			elseif now - R.sw_t < hold then
				return true
			elseif now - R.claim_t >= eai_num("Reinf_ClaimGone", 20) then
				why = "no_unit"
			elseif req >= (R.uneed or 0) + margin then
				why = "req " .. math.floor(req) .. ">=" .. math.floor((R.uneed or 0) + margin)
			elseif now - R.save_t >= smax then
				why = "timeout " .. math.floor(now - R.save_t); R.pause_until = now + pause
			end
		elseif R.last_pow_buy >= R.save_t then                              -- >=: the buy can come later in the tick that switched on
			why = "pow_buy " .. r_short(R.last_pow_name); R.pause_until = now + pause
		elseif now - R.sw_t < hold then
			return true
		elseif pow < bp * eai_num("Reinf_ExitK", 0.5) then
			why = "pow " .. math.floor(pow)
		elseif need <= 0 then
			why = "no_need"
		elseif req >= need + margin then
			why = "req " .. math.floor(req) .. ">=" .. math.floor(need + margin)
		elseif now - R.save_t >= smax then
			why = "timeout " .. math.floor(now - R.save_t); R.pause_until = now + pause
		end
		if why then
			r_save_log( false, bank, why )                                  -- (before the switch: the line names what it saved for)
			R.save, R.sw_t = false, now
			R.save_secs = R.save_secs + (now - R.save_t)
		end
		return R.save
	end
	if now < R.pause_until or now - R.sw_t < hold then return false end
	if pow >= bp and need > 0 and req < need then
		R.save, R.save_t, R.sw_t, R.save_n, R.save_why = true, now, now, R.save_n + 1, "pow"
		r_save_log( true, bank, "pow " .. math.floor(pow) .. ">=" .. math.floor(bp) .. " req " .. math.floor(req) .. "<" .. math.floor(need) )
	elseif uwait >= eai_num("Reinf_WaitSecs", 45) then
		R.save, R.save_t, R.sw_t, R.save_n, R.save_why = true, now, now, R.save_n + 1, "unit"
		R.uneed, R.uneed_what = st.req or 0, st.name or "-"
		r_save_log( true, bank, "unit short of req for " .. math.floor(uwait) .. " s" )
	end
	return R.save
end
-- the verdict per blueprint for this tick (called by AccumulateReinforceDemand): key -> true (reinforce) / false (skip);
-- nil = Elite's AI (everything as before)
function EliteAI_ReinforceGate( reinforcecount, availableResources )
	if not s_on() or cache == nil or cache.resources == nil then return nil end
	local R = EliteAI_R
	local now = World_GetGameTime()
	local bank = cache.resources
	local gate = {}
	local quick, st = r_claim( now )                                        -- 0.3: the unit the plan waits for is within reach
	-- 0.6: an expendable brood while a unit waits (see REINF_EXPENDABLE) - true = no model for it now
	local function exp_skip( k, pbg )
		if st == nil or not r_exp( k ) then return false end
		local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
		local room, why = r_exp_room( now, st, (per and per.requisition) or 0, 0 )
		if room >= 1 then return false end
		R.n_exp = (R.n_exp or 0) + 1
		if R.said["exp:" .. k] == nil or now - R.said["exp:" .. k] >= eai_num("Reinf_LogSecs", 30) then
			R.said["exp:" .. k] = now
			eai_log("REINF", "skip", r_short(k), "expendable", why == "share" and "over its share of the income" or "the unit first:", tostring(st.name), tostring(st.req) .. "/" .. tostring(st.pow),
				tostring(st.why), "eta", math.floor(st.eta or 0), "bank", s_rp(bank), "exp60", math.floor(r_exp60( now )), "held", R.n_exp)
		end
		return true
	end
	if not R.save and not quick then
		for i = 0, reinforcecount - 1 do
			local pbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
			if pbg ~= nil then
				local k = r_key(PBG_GetName( pbg ))
				if gate[k] == nil then
					if exp_skip( k, pbg ) then gate[k] = false; R.n_skip = R.n_skip + 1
					else gate[k] = true; R.n_allow = R.n_allow + 1 end
				end
			end
		end
		return gate
	end
	-- the unit had its money and a free HQ at the last tick and was not bought: something went first (a refill of 18 req is
	-- enough to leave it short on the second pass). This tick nothing is refilled - it is bought now, the models come next tick
	if st ~= nil and st.why == "ready" then
		for i = 0, reinforcecount - 1 do
			local pbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
			if pbg ~= nil then
				local k = r_key(PBG_GetName( pbg ))
				if gate[k] == nil then gate[k] = false; R.n_skip, R.n_unit_skip = R.n_skip + 1, R.n_unit_skip + 1 end
			end
		end
		return gate
	end
	local unit_mode = not R.save                                            -- 0.3: not saving - the unit within reach is why we are here
	local utxt = unit_mode and ("unit " .. tostring(st.name) .. " " .. tostring(st.why) .. " eta " .. math.floor(st.eta or 0)) or ""
	local pmin, low, full, rule = eai_num("Spend_PowUnit", 40), eai_num("Reinf_LowHp", 0.5), eai_num("Reinf_FullHp", 0.8), r_rule()
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0   -- per minute (cache.ai:156)
	local spent = r_ledger( now ) + r_pending( now )                        -- 0.3: paid (the models that came) + the director's orders on their way
	local cap = rate * r_share()
	-- the entries by blueprint; the weakest squad of a blueprint decides
	local ent, order = {}, {}
	for i = 0, reinforcecount - 1 do
		local pbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
		if pbg ~= nil then
			local k = r_key(PBG_GetName( pbg ))
			local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
			local total = AIProduction_GetReinforcementSquadCostAt( s_selfplayer, i )
			local pr, tr = (per and per.requisition) or 0, (total and total.requisition) or 0
			local missing = 1
			if pr > 0 and tr > 0 then missing = math.floor(tr / pr + 0.5); if missing < 1 then missing = 1 end end
			local e = ent[k]
			if not e then
				local cost = SquadStats_GetCost( s_self_modplayer, pbg )
				e = { pow = (cost and cost.power) or 0, per = pr, missing = missing, n = 0 }
				ent[k] = e; table.insert(order, k)
			end
			e.n = e.n + 1
			if e.exp == nil then e.exp = exp_skip( k, pbg ) end                 -- 0.6
			if missing > e.missing then e.missing = missing end
		end
	end
	for _, k in ipairs(order) do
		local e = ent[k]
		local v, why, ready, hit = "allow", "pow_unit", 1, false
		if e.pow < pmin or unit_mode then                                   -- (for the unit within reach a squad that uses power waits as the cheap ones do)
			-- the full size of the squad: the fewest models seen in a squad of this blueprint (last scan) + the most missing
			-- (the weakest squad is the one missing most) - exact with a fresh scan; the most models ever seen as the floor
			local s, fsz = R.sq[k], R.maxc[k] or 0                         -- fsz: models in a full squad (not `full` = Reinf_FullHp)
			if s ~= nil and s.minc + e.missing > fsz then fsz = s.minc + e.missing end
			if fsz > 0 then ready = (fsz - e.missing) / fsz; if ready < 0 then ready = 0 end
			else ready = (e.missing <= 1) and 0.9 or 0.3 end                 -- no scan of this blueprint yet: one model short = nearly full
			hit = (s ~= nil and s.hit > 0)
			local rtxt = string.format("ready %.2f", ready)
			if unit_mode then
				-- 0.3: a weak squad is refilled all the same (rule 1: not into a losing fight), a squad in a fight too (rules 2, 3);
				-- one that is out of the fight and above half waits for the unit
				if ready <= low and not (rule == 1 and hit) then v, why = "allow", "weak " .. rtxt .. (hit and " in_fight" or "")
				elseif hit and rule >= 2 then v, why = "allow", "in_fight " .. rtxt
				elseif st.why == "channel" and (bank.requisition or 0) - (st.req or 0) >= e.per then v, why = "allow", "bank pays both " .. rtxt   -- the unit's money stays whole
				else v, why = "skip", utxt .. " " .. rtxt end
			elseif rule == 1 then
				if ready <= low and not hit then v, why = "allow", "weak " .. rtxt
				elseif ready <= low then v, why = "skip", "weak_in_fight " .. rtxt
				else v, why = "skip", rtxt end
			elseif rule == 2 then
				if ready <= low then v, why = "allow", "weak " .. rtxt .. (hit and " in_fight" or "")
				else v, why = "skip", rtxt end
			else
				if hit then v, why = "allow", "in_fight " .. rtxt
				elseif ready <= full then v, why = "allow", "weak " .. rtxt
				else v, why = "skip", rtxt end
			end
		end
		-- step 14 (s11): the share cap holds for squads with power too - in s11 genestealer/ravener refills ("pow_unit")
		-- took 337-437 req/min against a cap of 74-101 while saving, and the req never reached the next power unit
		-- 0.4: a model that costs more than the minute's share (GK: 75 req against a cap of 53 at rule 1) is not shut out for
		-- good - one goes when nothing was paid for a minute (the cap is the average, a model is its grain)
		if v == "allow" and e.exp then v, why = "skip", "expendable, a unit waits" end   -- 0.6
		if v == "allow" and cap > 0 and spent + e.per > cap and spent > 0 then
			v, why = "skip", string.format("share %d+%d>%d", spent, e.per, cap) .. ((e.pow >= pmin) and " pow_unit" or "")
		end
		local dv, held = r_decide( k, v, why, now )
		if dv == "allow" then R.n_allow = R.n_allow + 1
		else
			R.n_skip = R.n_skip + 1; R.skip_est = R.skip_est + e.per
			if unit_mode then R.n_unit_skip = R.n_unit_skip + 1 end
		end
		local sk = k .. ":" .. dv
		local last = R.said[sk]
		if last == nil or now - last >= eai_num("Reinf_LogSecs", 30) then
			R.said[sk] = now
			eai_log("REINF", dv, r_short(k), "req", math.floor(bank.requisition or 0), "pow", math.floor(bank.power or 0),
				"why", why .. (held and " (held)" or ""), "miss", e.missing, "n", e.n, "hit", hit and 1 or 0, "rule", rule,
				"per", math.floor(e.per), "spent", math.floor(spent), "cap", math.floor(cap))
		end
		gate[k] = (dv == "allow")
	end
	return gate
end
function EliteAI_ReinforceNoteRequest( cost )                               -- TryPurchaseUnitChoice placed a reinforcement request
	if not s_on() then return end
	local R = EliteAI_R
	table.insert(R.req_led, { t = World_GetGameTime(), req = (cost and cost.requisition) or 0 })   -- 0.3: a request, not a purchase (r_models books the model)
	R.n_req = R.n_req + 1
end
function EliteAI_ReinforceNoteBuy( name, cost, now )                        -- a spawn request ends the save state: any unit the "unit" save, a power unit the "pow" save
	if not s_on() then return end
	local R = EliteAI_R
	R.last_buy, R.last_buy_name = now, name or "-"
	if cost and (cost.power or 0) >= eai_num("Spend_PowUnit", 40) then
		R.pow_buys, R.last_pow_buy, R.last_pow_name = R.pow_buys + 1, now, name or "-"
	end
end
-- every purchase tick (do_purchase, before the watchdog, first pass of the budget loop): the scan, the save state, the stats line
function EliteAI_ReinforceTick( availableResources, purchase_count )
	if not s_on() or cache == nil or cache.resources == nil or purchase_count ~= 0 then return end
	local R = EliteAI_R
	local now = World_GetGameTime()
	r_models( now )                                                          -- 0.3: the models that came since the last tick = the real spend
	r_scan( now )
	r_save_state( now, cache.resources )
	if now - R.last_stats < eai_num("Reinf_StatsSecs", 60) then return end
	R.last_stats = now
	for key, c in pairs(R.conf) do if now - c.t > 300 then R.conf[key] = nil end end   -- old decisions of blueprints gone
	local nsq, nhit, nlow = 0, 0, 0
	for _, e in pairs(R.sq) do nsq = nsq + e.n; nhit = nhit + e.hit; nlow = nlow + e.low end
	local saved = R.save_secs + (R.save and (now - R.save_t) or 0)
	eai_log("REINF", "stats", "t", math.floor(now), "save", R.save and "on" or "off", "since", R.save and math.floor(now - R.save_t) or 0,
		"saved_secs", math.floor(saved), "episodes", R.save_n, "need", math.floor((r_need_now())), "(" .. select(2, r_need_now()) .. ")", "rule", r_rule(),
		"bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "skip", R.n_skip, "allow", R.n_allow, "skip_est", math.floor(R.skip_est),
		"requests", R.n_req, "reinf_req_min", math.floor(r_sum60( "req_led", now )), "share", string.format("%.2f", r_share()),
		"pow_buys", R.pow_buys, "switches", R.n_sw, "squads", nsq, "hit", nhit, "low", nlow,
		"dir", R.n_dir, "dir_poor", R.n_dir_poor, "dir_cap", R.n_dir_cap, "dir_mute", R.n_dir_mute, "dir_dry", R.n_dir_dry or 0,
		"models", R.n_models, "paid", math.floor(R.req_models), "paid_min", math.floor(r_ledger( now )),   -- 0.3: what came and what it cost
		"save_why", R.save and R.save_why or "-", "unit_skip", R.n_unit_skip, "dir_goal", R.n_dir_goal or 0, "dir_unit", R.n_dir_unit, "dir_lost", R.n_dir_lost)
end
-- 0.2 (TECH_RU.md 12) THE DIRECTOR'S SQUADS. The engine's list of squads to reinforce (AIProduction_AnyReinforcementsNeeded,
-- GetReinforcementSquad*) is filled by a squad's own AI task: AITaskCombatState::Enter_Reinforce -> AISquad::RequestReinforce ->
-- AIProductionManager::RegisterForReinforcements (the symbols of the Mac build, decompiled). A squad the director moves has no
-- combat task (strategy_military.execute kills them for a directed AI), so it never gets on that list: only the squads in
-- Elite's capture tasks were ever reinforced. s15: 6-7 of the 8 tyranid squads were the director's all match - 28 models
-- lost, 1 request (s14: 22 requests with half the squads in capture tasks; IG 15 against 25).
-- Now the director asks for the model itself: a squad of its army that stands at home (within Reinf_HomeR of our HQ, main.ai)
-- with fewer models than the most seen in a squad of its blueprint gets one reinforce order per director tick, through the DLL
-- queue to the SCAR side (mode 6: Command_Squad(player, sgroup, SCMD_ReinforceUnit, false) - the command of the player's
-- button; the engine checks the reach of a reinforce point and takes the money). This function is the purse: true = order.
-- Not below the tech plan's reserve; within Reinf_DirShare (0.5) of the req income per minute - the arbiter's share
-- (Reinf_Share 0.2 / 0.35 / 0.5) while the save state is on - counted with Elite's own requests in one ledger; never more
-- orders than models missing nor more than Reinf_DirAhead (2) ahead of the models that came; Reinf_DirTries (2) orders and
-- no model more Reinf_DirWait (20 s) after the first = none for that
-- squad for Reinf_DirMute (60 s; "REINF dir no effect": out of reach of a reinforce point, or the command does not take).
-- Returns order (true/false), busy (models are on their way or an order went: the director keeps the squad at home).
-- Numbers per squad id between ticks (EliteAI_R.dir); the AISquad is the caller's, of this tick. Reinf_Dir=0 = off.
-- 0.3 (TECH_RU.md 13): returns n, busy, why - n = how many models to order this tick (0 = none; up to Reinf_DirBatch 3 when the
-- money is there: scene b - one order per tick, 6 models took 33 s), busy as before, why = full | ordered | unit | save | poor |
-- cap | mute | order. The unit first: while the plan's unit is within reach (r_claim) or the save state is on, only a weak
-- squad (models <= Reinf_LowHp of a full one) is refilled; a weak squad is not held by the share of the income either (it is
-- useless as it stands, and a model is the cheapest army there is) - the money and the tech plan's reserve are its bounds.
-- The cap reads what was paid in the last minute (the models that came) + what is ordered and on its way. Orders that brought
-- no model for Reinf_DirLost (0.4: 15 s, counted from the moment the squad stands) are written off and may be ordered again ("dir_lost").
-- 0.4 (TECH_RU.md 14): * "moving" (main.ai: the squad is not standing yet - it still runs home): the clocks of "nothing came"
-- (Reinf_DirLost, the "no effect" check) start when it stands, not with the order. s17: 50005 was ordered 3 models on its way
-- in, 10 s later they were written off and ordered again, the first came 15 s after the order - 6 clicks, 6 models, "dir_lost 3".
-- Reinf_DirLost is 15 s (was 10). * A squad above half while a unit is waited for (save / within reach): no longer "none" but
-- within the arbiter's share of the income (Reinf_Share 0.2 / 0.35 / 0.5 - s17: IG "dir_unit", a 6 of 9 squad stood at home
-- unfilled; a model is half the price of the same model in a new squad); a unit that has its money keeps it whole as before.
-- Reinf_DirHeld=1 = as 0.3. * A weak squad while a unit is waited for: Reinf_WeakShare (0.6) of the income (was: no bound -
-- s17 145-182 req a minute at an income of 235). * A model dearer than the minute's share: one when nothing was paid for a minute.
-- 0.7 (TECH_RU.md 20.4) THE GOAL OF A REFILL. Until now a squad at home was refilled to the last model whatever it was for;
-- the tyranids of Malum's match (fb 581) paid 2856 req for 131 models against 4340 for 14 units. Orca (fb 557): "do not refill
-- the side cappers to a full squad; late, without the map and the income, do not reinforce the squads that bleed". A squad is
-- refilled to its GOAL, and the goal is by what the squad is worth to us:
--  * a runner / a squad that takes the army's goal points (mechanics.ai EliteAI_MechRole; also Reinf_RoleSecs after it was one)
--    - Reinf_RunnerFill (0.6) of a full squad, two models at least: it walks between points, it does not hold a line;
--  * POOR TIMES - later than Reinf_LateSecs (600 s) and the req income below Reinf_PoorRate (190 a minute: the upkeep of what
--    we have eats it) or less than Reinf_PoorPts (0.25) of the map ours:
--      a squad that BLEEDS (lost Reinf_BleedK 0.5 of a full squad within Reinf_BleedSecs 150 s - main.ai counts the falls) -
--      Reinf_BleedFill (0.5): the models would be dead before they pay back;
--      an expendable brood or a T1 blueprint when we stand on T2+ - Reinf_PoorFill (0.75);
--    the blueprints of the later tiers are refilled to the last model (a model of theirs is the cheapest fire we can buy).
-- The quiet trip home (EliteAI_ReinforceCan) knows the same goal - a squad at its goal does not walk home for more.
-- Lines "REINF dir goal <id> <unit> models A of B goal G why runner|capper|bleeds|poor ...". Reinf_Goal=0 = to the last model.
local function r_poor( now )
	if now < eai_num("Reinf_LateSecs", 600) then return false end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local pct = cache.percentage_pts_captured or 1                          -- cache.ai:126
	return rate < eai_num("Reinf_PoorRate", 190) or pct < eai_num("Reinf_PoorPts", 0.25)
end
local function r_goal( id, key, name, count, full, now )
	if eai_num("Reinf_Goal", 1) < 1 or full < 3 or id == nil then return full, "-" end
	local goal, why = full, "-"
	local role = (type(EliteAI_MechRole) == "function") and EliteAI_MechRole( id ) or nil
	if role ~= nil then goal, why = math.max(2, math.ceil(full * eai_num("Reinf_RunnerFill", 0.6))), role end
	if r_poor( now ) then
		local lost = (type(EliteAI_LossRecent) == "function") and EliteAI_LossRecent( id, eai_num("Reinf_BleedSecs", 150) ) or 0
		local lvl = (cache and cache.tech_tier_level) or 1
		local g, w = nil, nil
		if lost >= full * eai_num("Reinf_BleedK", 0.5) then g, w = math.ceil(full * eai_num("Reinf_BleedFill", 0.5)), "bleeds"
		elseif r_exp( key ) or (lvl >= 2 and (EliteAI_P.tier_seen[name] or 1) < 2) then g, w = math.ceil(full * eai_num("Reinf_PoorFill", 0.75)), "poor" end
		if g ~= nil and math.max(2, g) < goal then goal, why = math.max(2, g), w end
	end
	return goal, why
end
EliteAI_ReinforceGoal = r_goal                                              -- the stub run
function EliteAI_ReinforceDir( aisq, id, count, now, moving )
	if not s_on() or aisq == nil or id == nil or cache == nil or cache.resources == nil or eai_num("Reinf_Dir", 1) < 1 then return 0, false, "off" end
	local R = EliteAI_R
	local pbg = AISquad_ConvertToPBG( aisq )                                 -- r_scan above; strategy_addon.ai:188
	if pbg == nil then return 0, false, "off" end
	local key = r_key(PBG_GetName( pbg ))
	local full = R.maxc[key] or 0                                           -- the most models seen in one squad of this blueprint (r_scan)
	local d = R.dir[id]
	if count >= full then R.dir[id] = nil; return 0, false, "full" end      -- complete (heroes, vehicles: always)
	if d ~= nil and now - d.last > eai_num("Reinf_DirGap", 30) then d = nil end   -- it was away: a new stay at home
	if d == nil then d = { n0 = count, sent = 0, tot = 0, t0 = now, last = now, prog = now, mute = -1 }; R.dir[id] = d end
	if count > (d.have or count) then d.prog = now end                      -- a model came
	d.have = count                                                          -- (r_pending reads it)
	if moving then                                                          -- 0.4: not at the reinforce point yet - nothing can have come
		d.prog = now
		if count <= d.n0 then d.t0 = now end
	end
	if now < d.mute then return 0, false, "mute" end
	local tries = math.min(eai_num("Reinf_DirTries", 2), full - d.n0)       -- (one model missing: one order is all there is to try)
	if d.tot >= tries and d.tot > 0 and count <= d.n0 and now - d.t0 >= eai_num("Reinf_DirWait", 20) then
		d.mute, d.sent, d.tot, d.t0, d.last = now + eai_num("Reinf_DirMute", 60), 0, 0, now, now
		R.n_dir_mute = R.n_dir_mute + 1
		eai_log("REINF", "dir", "no effect", tostring(id), r_short(key), "models", count, "of", full, "after", tries, "orders in",
			eai_num("Reinf_DirWait", 20), "s: none for", eai_num("Reinf_DirMute", 60), "s (out of reach of a reinforce point?)")
		return 0, false, "mute"
	end
	local coming = d.sent - math.max(0, count - d.n0)                      -- ordered and not there yet
	if coming < 0 then coming = 0 end
	if coming > 0 and now - d.prog >= eai_num("Reinf_DirLost", 15) then     -- the engine did not take them (no money at that moment, a command dropped)
		d.sent, d.prog = d.sent - coming, now
		R.n_dir_lost = R.n_dir_lost + coming
		coming = 0
	end
	local left = (full - count) - coming                                   -- models neither here nor on their way
	local room = math.floor(eai_num("Reinf_DirAhead", 3)) - coming          -- never more than this many ahead of the arrivals
	if left <= 0 or room <= 0 then d.last = now; return 0, (coming > 0), "ordered" end
	local goal, gwhy = r_goal( id, key, string.lower(PBG_GetName( pbg ) or ""), count, full, now )   -- 0.7: what this squad is refilled to
	if goal < full then
		if count + coming >= goal then
			R.n_dir_goal = (R.n_dir_goal or 0) + 1
			local sk = "goal:" .. key .. ":" .. tostring(gwhy)
			if R.said[sk] == nil or now - R.said[sk] >= eai_num("Reinf_LogSecs", 30) then
				R.said[sk] = now
				eai_log("REINF", "dir", "goal", tostring(id), r_short(key), "models", count, "of", full, "goal", goal, "why", gwhy, "none:",
					"lost", (type(EliteAI_LossRecent) == "function") and EliteAI_LossRecent( id, eai_num("Reinf_BleedSecs", 150) ) or 0, "in", eai_num("Reinf_BleedSecs", 150), "s",
					"rate", s_rp(cache.resources_rate), "bank", s_rp(cache.resources), "held", R.n_dir_goal)
			end
			d.last = now
			return 0, (coming > 0), "goal"
		end
		left = math.min(left, goal - count - coming)
	end
	local weak = (count <= full * eai_num("Reinf_LowHp", 0.5))
	local st0 = EliteAI_E and EliteAI_E.stall                               -- 0.6: a unit of the plan waits (the units budget's stall record, at most two ticks old)
	local exp = (st0 ~= nil and now - (st0.t or -1000) <= 7 and st0.why ~= "ready" and r_exp( key ))
	if exp then weak = false end                                            -- an expendable brood is no "weak" squad while a unit waits
	local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )   -- AccumulateReinforceDemand below (Elite's)
	local pr, pp = (per and per.requisition) or 0, (per and per.power) or 0
	d.per = pr
	local bank = cache.resources
	local rr, rp = 0, 0
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	local same = (R.dir_now == now)                                         -- the orders of this director tick (the bank is the cache's)
	local used, used_p = same and R.dir_used or 0, same and (R.dir_used_p or 0) or 0
	local quick, st = r_claim( now )
	local exp_room = nil
	if exp then
		local ewhy
		exp_room, ewhy = r_exp_room( now, st0, pr, used )
		if exp_room < 1 then
			R.n_exp = (R.n_exp or 0) + 1
			local sk = "expd:" .. key
			if R.said[sk] == nil or now - R.said[sk] >= eai_num("Reinf_LogSecs", 30) then
				R.said[sk] = now
				eai_log("REINF", "dir", "expendable", tostring(id), r_short(key), "models", count, "of", full, "none:", ewhy == "share" and "over its share of the income," or "the unit first,",
					tostring(st0.name), tostring(st0.req) .. "/" .. tostring(st0.pow), tostring(st0.why), "eta", math.floor(st0.eta or 0), "bank", s_rp(bank), "per", math.floor(pr),
					"exp60", math.floor(r_exp60( now )), "held", R.n_exp)
			end
			return 0, (coming > 0), "expendable"
		end
	end
	-- the unit first: one that has its money and a free HQ is bought before any model; one that has its money and waits for the
	-- HQ keeps it whole (what lies beyond it is free); for one that is short of money a squad above half gets its models within
	-- the arbiter's share of the income (0.4; was: none)
	local ready = (st ~= nil and st.why == "ready")
	local held = (R.save or quick) and not weak
	local spare, capped = nil, false
	if held and st ~= nil and st.why == "channel" and pr > 0 then
		spare = math.floor(((bank.requisition or 0) - (rr or 0) - used - (st.req or 0)) / pr)
	end
	local wait = ready
	if held and not ready then
		if spare ~= nil then wait = (spare < 1)
		elseif eai_num("Reinf_DirHeld", 0) >= 1 then wait = true
		else capped = true end
	end
	-- 0.7 (TECH_RU.md 18.4; s21, tyranids: no unit 7:39-12:00, the genestealer 350/45 was 11 s away at 10:17 with 302 req when three
	-- hormagaunts were ordered - bank 220 - and so on: five orders, 294 req, in that gap, each inside its share of the income). In a
	-- DROUGHT (EliteAI_E.dry: no unit bought for Spend_DroughtSecs while one waits) the unit is first for the refills too: a
	-- squad above half gets models only from the req that lies beyond the unit's price, a weak squad within Reinf_DroughtShare
	-- (0.25) of the income instead of Reinf_WeakShare (0.6). The drought ends with the unit. Reinf_DirDrought=0 = as 0.6.
	local dry = (st ~= nil and EliteAI_E ~= nil and EliteAI_E.dry == true and eai_num("Reinf_DirDrought", 1) >= 1)
	local beyond = nil
	if dry and not wait and pr > 0 then
		beyond = math.floor(((bank.requisition or 0) - (rr or 0) - used - (st.req or 0)) / pr)
		if not weak and beyond < 1 then
			R.n_dir_dry = (R.n_dir_dry or 0) + 1
			local sk = "dry:" .. key
			if R.said[sk] == nil or now - R.said[sk] >= eai_num("Reinf_LogSecs", 30) then
				R.said[sk] = now
				eai_log("REINF", "dir", "drought", tostring(id), r_short(key), "models", count, "of", full, "none: no unit for", math.floor(EliteAI_E.dry_for or 0), "s,",
					tostring(st.name), st.req .. "/" .. st.pow, "first", "bank", s_rp(bank), "per", math.floor(pr) .. "/" .. math.floor(pp), "held", R.n_dir_dry)
			end
			return 0, (coming > 0), "drought"
		end
	end
	if wait then
		R.n_dir_unit = R.n_dir_unit + 1
		return 0, (coming > 0), R.save and "save" or "unit"
	end
	local k = math.min(left, room, math.max(1, math.floor(eai_num("Reinf_DirBatch", 3))))
	if spare ~= nil then k = math.min(k, spare) end
	if beyond ~= nil and not weak then k = math.min(k, beyond) end           -- 0.7: a drought - only the req beyond the unit's price
	if exp_room ~= nil then k = math.min(k, exp_room) end                    -- 0.6: an expendable brood - beyond the unit's price and within its share
	if pr > 0 then k = math.min(k, math.floor(((bank.requisition or 0) - (rr or 0) - used) / pr)) end
	if pp > 0 then k = math.min(k, math.floor(((bank.power or 0) - (rp or 0) - used_p) / pp)) end
	if k < 1 then
		R.n_dir_poor = R.n_dir_poor + 1
		return 0, (coming > 0), "poor"
	end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0   -- per minute (cache.ai:156)
	local share = nil                                                       -- nil = no bound but the money
	if capped then share = r_share()
	elseif weak then
		if R.save or quick then share = eai_num("Reinf_WeakShare", 0.6) end -- 0.4: while a unit is waited for the weak squads leave it 40 % of the income
		if dry then share = math.min(share or 1, eai_num("Reinf_DroughtShare", 0.25)) end   -- 0.7: in a drought - a quarter
	else share = R.save and r_share() or eai_num("Reinf_DirShare", 0.5) end
	local spent = r_ledger( now ) + r_pending( now )                        -- paid (the models that came) + ordered and on their way
	if share ~= nil and rate > 0 and pr > 0 then
		local fit = math.floor((rate * share - spent) / pr)
		if fit < 1 and spent <= 0 then fit = 1 end                          -- 0.4: a model dearer than the minute's share - one when nothing was paid for a minute
		k = math.min(k, fit)
		if k < 1 then
			R.n_dir_cap = R.n_dir_cap + 1
			if capped then R.n_dir_unit = R.n_dir_unit + 1 end
			return 0, (coming > 0), "cap"
		end
	end
	if coming == 0 then d.prog = now end                                    -- the clock of "nothing came" starts with the first order on its way
	d.sent, d.tot, d.last = d.sent + k, d.tot + k, now
	R.n_dir, R.dir_now, R.dir_used, R.dir_used_p = R.n_dir + k, now, used + pr * k, used_p + pp * k   -- (the book notes a model when it comes: r_models)
	local sk = "dir:" .. key
	local last = R.said[sk]
	if last == nil or now - last >= eai_num("Reinf_LogSecs", 30) then
		R.said[sk] = now
		eai_log("REINF", "dir", "order", tostring(id), r_short(key), "models", count, "of", full, "x" .. k, "per", math.floor(pr) .. "/" .. math.floor(pp),
			"bank", s_rp(bank), "spent60", math.floor(spent), "cap", share and math.floor(rate * share) or -1, weak and "weak" or (capped and "share" or (R.save and "save" or "-")), "orders", R.n_dir,
			dry and "drought" or "")
	end
	if type(EliteAI_EnergyPay) == "function" then EliteAI_EnergyPay( "reinf_dir", pr * k, pp * k ) end   -- 0.7: paid now, booked when the models come
	if r_exp( key ) then r_exp_note( now, pr * k ) end                       -- 0.6: the expendables' minute
	return k, true, "order"
end
-- 0.4 main.ai (the refill trip of a weak squad, out of a fight): how many models the purse would pay this squad now if it stood
-- at home - the bank beyond the tech plan's reserve, never more than it misses; 0 = none. No order, no state.
function EliteAI_ReinforceCan( aisq, count, id )
	if not s_on() or aisq == nil or cache == nil or cache.resources == nil or eai_num("Reinf_Dir", 1) < 1 then return 0 end
	local pbg = AISquad_ConvertToPBG( aisq )
	if pbg == nil then return 0 end
	local full = EliteAI_R.maxc[r_key(PBG_GetName( pbg ))] or 0
	if count >= full then return 0 end
	if id ~= nil then                                                       -- 0.7: no trip home for more than its goal
		full = r_goal( id, r_key(PBG_GetName( pbg )), string.lower(PBG_GetName( pbg ) or ""), count, full, World_GetGameTime() )
		if count >= full then return 0 end
	end
	local per = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
	local pr, pp = (per and per.requisition) or 0, (per and per.power) or 0
	local rr, rp = 0, 0
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	local bank = cache.resources
	local k = full - count
	if pr > 0 then k = math.min(k, math.floor(((bank.requisition or 0) - (rr or 0)) / pr)) end
	if pp > 0 then k = math.min(k, math.floor(((bank.power or 0) - (rp or 0)) / pp)) end
	if k < 0 then k = 0 end
	return k
end
-- the most models seen in one squad of this squad's blueprint (0 = unknown yet): the director's "is it worth going home for" check
function EliteAI_ReinforceFull( aisq )
	if not s_on() or aisq == nil then return 0 end
	local pbg = AISquad_ConvertToPBG( aisq )
	if pbg == nil then return 0 end
	return EliteAI_R.maxc[r_key(PBG_GetName( pbg ))] or 0
end
local function r_init_log()
	r_reset()
	eai_log("REINF", "init", "version", EliteAI_REINF_VERSION, "rule", r_rule(), "bank_pow", eai_num("Reinf_BankPow", eai_num("Spend_BankPow", 300)),
		"exit_k", eai_num("Reinf_ExitK", 0.5), "low_hp", eai_num("Reinf_LowHp", 0.5), "full_hp", eai_num("Reinf_FullHp", 0.8), "share", r_share(),
		"save_spawn_mult", eai_num("Reinf_SaveSpawnMult", 0.4), "pause", eai_num("Reinf_PauseSecs", 45), "save_max", eai_num("Reinf_SaveMax", 240),
		"req_margin", eai_num("Reinf_ReqMargin", 200), "need_max", eai_num("Reinf_NeedMax", 600), "conf_hold", eai_num("Reinf_ConfHold", 10),
		"scan", eai_num("Reinf_ScanSecs", 6), "pow_unit", eai_num("Spend_PowUnit", 40),
		"unit_first", eai_num("Reinf_UnitFirst", 1), "unit_eta", eai_num("Reinf_UnitEta", 45), "wait", eai_num("Reinf_WaitSecs", 45),
		"dir_batch", eai_num("Reinf_DirBatch", 3), "dir_share", eai_num("Reinf_DirShare", 0.5))
end
EliteAI_ReinforceInit = r_init_log

-------------------------------------------------------------------------------------------------
-- EliteAI 11.11 (energy): power in excess, req short (the scene polygon, reports/polygon_1111: IG T2 with 400 req / 1000 power
-- bought one ogryn in 120 s, the power stayed at 900+; the req trickled into squad upgrades that cost no power - sergeants,
-- 75 req each - as soon as it reached 75, so the 300 req of the unit the "save" state waited for never came; tyranids: a
-- genestealer and ~410 req of upgrades in the first 10 s, then "none poor" for 80 s). New logic only (EliteAI.on).
-- WHY the old blocks could not see it: squad upgrades are bought by BUDGET_AddOn in the OTHER budget run (default.ai:335-344:
-- do_purchases(false) = AddOn/Secure/ResourceAddOn, then do_purchases(true) = Units/Tech/abilities). A budget's total only
-- orders the budgets inside one run (util/budget.ai:297-361), so whatever the units side waits for - the unit Elite stalls on,
-- the tech plan's reserve, the "save" state - the addon run sees the whole bank every 3 s and takes the req from under it.
-- WHAT:
--  * the float state (EliteAI_EnergyFloat, hysteresis Energy_Hold): on when the power bank >= Energy_FloatPow and >=
--    Energy_FloatRatio x the req bank; off below Energy_ExitK of either. Log "ENERGY float on|off ...".
--  * while floating, the req goes where the power goes: units get x (1 + Energy_ShareK x share), share = power / (req + power)
--    of the cost (EliteAI_PurchaseMult); squad upgrades with a share >= Energy_AddonMinShare get x (1 + Energy_AddonShareK x
--    share), the ones below it x Energy_AddonLowMult and, while the "save" state saves for a power unit, nothing at all
--    ("low_pow_save"); CalcSquadUpgradeDemand is floored (Spend_AddonFloor) so the upgrades the engine rates low are
--    candidates too; no new generators (ResourceStructureDemand is skipped: "ENERGY gen hold"); the tech plan of
--    strategy_tech_purchase.ai wants the next tier at once (reason "float": the research is 300 req for 125-150 power, the
--    best power sink there is, and it opens the units that use power).
--  * the reserves the addon run now respects: the tech plan's reserve (EliteAI_TechReserve: an upgrade may not take the req
--    bank below it - "tech_reserve") and the next unit - the arbiter Conf_AddonVsUnit (A/B/C = 1/2/3): when the spawn Elite
--    chose is short of money (or has the money and waits for the busy HQ) and its ETA at the current income is within
--    Spend_UnitFirstEta (1: 60 s, 2: 40 s), an upgrade may not take the req bank below that unit's cost ("unit_first") for at
--    most Spend_UnitFirstMax (75 / 45 s), then the upgrades get a window of Spend_UnitFirstPause (20 / 30 s); 3 = as Elite
--    (no waiting). With a bank that pays both, nothing waits. Hysteresis Reinf_ConfHold; log "ENERGY Conf_AddonVsUnit bank
--    addons->unit ...". This is the "minimal reserve for the key purchase": bounded in time, only for a unit within reach.
--  * "save" by the income (r_need above): a power unit is saved for only when its ETA is within Energy_EtaMax (120 s);
--    when none is, nothing is held for it (REINF "need none ...", the watchdog's pmin and the low-power damping are off).
--  * the Garrison pattern of mod/mechanics.ai (EliteAI.gar): once an enemy squad has held a building next to our point for
--    Gar_BuySecs, the counter units of reports/tactics_kb/kb.yaml (threats.garrisoned_enemy) get x Gar_BuyMult (x
--    Gar_BuyMultHave when we have one) and flamer / grenade upgrades x Gar_AddonMult (they also pass the waits above).
--    Log "GAR demand <sbps> x2.5 garrison <id> held N s ...".
--  * the book: every purchase the scripts place is noted by kind (unit, addon, reinf, tech, gen, secure, abil) - "buy_addon <t>
--    <upgrade> req/pow" per upgrade (they were invisible in the log) and "ENERGY stats ... spent60 ..." once a minute.
-- 0.2 (11.11, after the verification of newai-10 - TECH_RU.md 10.10 / 11):
--  * WHO HELD THE REQ. (1) BUDGET_Secure (the power node on a captured point, 125 req): its request is a task, and a task's cost is
--    taken off what every budget may spend from the moment it is placed (util/budget.ai:271 Task_CountCost). A request nobody
--    executes is killed as inactive at the next tick (default.ai:249) and placed again: s14 - 115 / 137 requests in 817 s, 2-18 a
--    minute, i.e. 125-375 req out of reach of the units and the research for half the match; scene r2: bank 375-402, devils 350
--    not bought for 11 s, then the node took 125. Now: one request at a time (Energy_SecureMax), Energy_SecureTries (2) requests
--    killed in a row = no request for Energy_SecureMute (60 s), none while the power floats (Energy_SecureHold, as the
--    generators), and neither Secure nor the generators may take the bank below the tech plan's reserve or the unit the upgrades
--    wait for (e_reserved; "ENERGY reserve skip ..."). (2) The order of the budgets inside a run: whoever is first locks its
--    cost. The units budget now takes the tech plan's reserve off itself whatever the order and, while the plan holds it,
--    locks nothing for a unit it is short of money for (do_purchase). (3) Elite's rule "one request per producer": while a unit
--    is produced (28-37 s) or the tier research runs in the HQ, the next spawn is not requested - the line "SPEND stall <unit>
--    why channel|money avail .. bank .. tasks .. queue N" now names which of the two it is, at most once per Spend_StallLog.
--  * Conf_AddonVsUnit had the 10 s of Reinf_ConfHold and one threshold: 31-34 switches a match, three in 20-30 s in four scenes.
--    Now a switch holds Spend_UnitFirstHold (20 s: two in 30 s at most), the unit is dropped only beyond Spend_UnitFirstOffK
--    (1.5) x the ETA that takes it, "the unit was bought" is no switch (the decision stays, nothing is reserved while no unit
--    waits; back to "addons" after Spend_UnitFirstIdle 20 s without one), the ETA is by what the units budget really has, and
--    the wait clock (Spend_UnitFirstMax) counts only the seconds a unit was short of money (not those it had the money and
--    waited for the HQ - scene r2: the window for the upgrades opened the moment the HQ got free).
--  * the book: "secure" is noted when the request survived to the next tick or a point became secured, not on every request
--    (it read "secure 137x 19125" - more than the whole income); the requests are counted apart (stats: secure_req / dead / hold).
-- SAFETY: numbers and strings between ticks only (EliteAI_E); PBGs are read within the tick; no pcall around engine calls; no
-- randomness; engine functions are the ones Elite's scripts call (file:line in reports/newai_1110/TECH_RU.md sections 10, 11).
EliteAI_ENERGY_VERSION = "0.11"
EliteAI_E = {}
local function e_reset()
	EliteAI_E = { float = false, float_t = -1, sw_t = -1000, said = {}, stall = nil, hold = false, hold_t = -1000, hold_sw = -1000, hold_pause = -1,
		led = {}, tot = {}, n_addon = 0, n_addon_skip = 0, n_addon_boost = 0, n_gen_skip = 0, n_gar = 0, last_stats = 0, gar_on = false,
		hold_req = 0, idle_t = -1000, n_hold_sw = 0, n_res_skip = 0,          -- 0.2: the arbiter's reserve; purchases of the other run held back by a reserve
		areq = {}, adead = {}, amute = {}, abought = {}, n_addon_req = 0, n_addon_dead = 0,   -- 0.3: upgrade requests waiting for their verdict (names, numbers)
		cap_t = -1, cap = nil, cap_why = "-", n_share_skip = 0, n_hold_keep = 0,              -- 0.3: the army's share
		gen_t = nil, gen_req = 0, gen_pow = 0, gen_n = 0, gen_dead = 0, gen_mute = -1, n_gen_req = 0, n_gen_dead = 0,   -- 0.4: BUDGET_ResourceAddOn
		sec_t = nil, sec_req = 0, sec_pow = 0, sec_n = 0, sec_dead = 0, sec_mute = -1, n_sec_req = 0, n_sec_dead = 0, n_sec_hold = 0,   -- 0.2: BUDGET_Secure
		ureq = {}, udead = {}, udead_t = {}, umute = {}, upause = -1, gdead = 0, n_unit_req = 0, n_unit_dead = 0, n_unit_notnow = 0, n_unit_mute = 0 }   -- 0.9: spawn requests waiting for their verdict (names, numbers)
end
e_reset()
local GAR_COUNTER_UNITS = { "ig_devils", "ig_kasrkin_squad", "ig_banewolf", "sm_scout_marine", "sm_tactical_marine", "eld_fire_dragon", "eld_guardian",
	"ork_stikkbommas", "csm_cultist", "csm_noise_marines", "gk_purgation_squad", "tau_vespid_squad" }   -- kb.yaml garrisoned_enemy (tyranids: no buildable counter)
local GAR_ADDON_KEYS = { "flamer", "flame", "grenade", "burna", "incinerat", "battle_equipment" }
-- 0.6: who answers set-up teams (kb.yaml threats.suppression_spam.responses + units.*.counters setup_team), by the end of the sbps name
local SETUP_COUNTER_UNITS = { "sm_assault_marine", "sm_scout_marine", "sm_devastator_plasma_cannon", "sm_whirlwind",
	"ig_devils", "ig_manticore", "eld_ranger", "eld_banshee", "eld_warp_spider", "ork_stormboy", "ork_stikkbommas", "ork_kommandos",
	"tyr_ravener", "tyr_lictor", "tyr_tyrant_guard", "csm_raptor", "csm_noise_marines", "gk_interceptor_squad", "gk_operatives", "tau_vespid_squad", "tau_stealth_suits" }
local function e_ends(name, key)
	local n, k = string.len(name), string.len(key)
	return n >= k and string.sub(name, n - k + 1) == key
end
local function e_has(name, keys)
	for _, k in ipairs(keys) do if string.find(name, k, 1, true) then return true end end
	return false
end
local function e_say(key, secs, ...)                                       -- a line at most once per `secs` per key
	local E, now = EliteAI_E, World_GetGameTime()
	local last = E.said[key]
	if last ~= nil and now - last < secs then return end
	E.said[key] = now
	eai_log(...)
end
local function e_share(cost)                                               -- the power share of a cost
	local r, p = (cost and cost.requisition) or 0, (cost and cost.power) or 0
	if r + p <= 0 then return 0 end
	return p / (r + p)
end
-- the float state, evaluated at most once per game time value (the tech plan asks first in a tick, strategy_tech_purchase.ai)
function EliteAI_EnergyFloat()
	if not s_on() or cache == nil or cache.resources == nil then return false end
	local E, now = EliteAI_E, World_GetGameTime()
	if E.float_t == now then return E.float end
	E.float_t = now
	local req, pow = cache.resources.requisition or 0, cache.resources.power or 0
	local fp, fr, xk = eai_num("Energy_FloatPow", eai_num("Spend_BankPow", 300)), eai_num("Energy_FloatRatio", 1.5), eai_num("Energy_ExitK", 0.6)
	local want = E.float
	if E.float then
		if pow < fp * xk or pow < req * fr * xk then want = false end
	elseif pow >= fp and pow >= req * fr then
		want = true
	end
	if want ~= E.float and now - E.sw_t >= eai_num("Energy_Hold", 10) then
		E.float, E.sw_t = want, now
		eai_log("ENERGY", "float", want and "on" or "off", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate),
			"need", string.format("pow>=%d and pow>=%.1fxreq", fp, fr))
	end
	return E.float
end
-- the book of purchases by kind (numbers only): the last 60 s and the totals of the match
-- 0.4 (TECH_RU.md 13): every kind is noted when it was PAID, not when it was asked for - "reinf" by the models that came
-- (r_models; n = how many), "gen" by the request that survived or the generator that stands (e_gen_gate), as "addon" and
-- "secure" before. s16: "reinf 88x 2278" (tyranids, more than they could have paid) and "gen 28x 2800" (IG, 13 a minute)
-- were requests; the army's share of the upgrades was worked out from them (addon_share 0.19 with ~0.27 really paid).
function EliteAI_EnergyNote( kind, cost, n, nopay )
	if not s_on() or cost == nil then return end
	local E = EliteAI_E
	local r, p = cost.requisition or 0, cost.power or 0
	table.insert(E.led, { t = World_GetGameTime(), k = kind, r = r, p = p })
	-- (booked when asked for; 0.9: a unit is booked when its request is confirmed, the "asked" half was written at the request - nopay)
	if not nopay and (kind == "unit" or kind == "tech" or kind == "abil" or kind == "revive") then EliteAI_EnergyPay( kind, r, p ) end
	local tt = E.tot[kind]
	if not tt then tt = { n = 0, r = 0, p = 0 }; E.tot[kind] = tt end
	tt.n, tt.r, tt.p = tt.n + (n or 1), tt.r + r, tt.p + p
end
local E_KINDS = { "unit", "addon", "reinf", "tech", "gen", "secure", "abil", "revive" }
-- 0.7 (TECH_RU.md 18.4): WHAT WAS ASKED FOR, when - the other half of the book. The book notes a purchase when it is known to be
-- paid (a model that came, a generator that stands) or when it was asked for (a unit, a research, a call-in); the engine takes
-- the money at its own moment. s21: of five "SPEND unbooked" lines of the tyranids two were purchases that ARE in the book - the
-- T2 research (asked at 362 s, paid at 365: outside the window it was booked in) and the call-in - and two were the
-- director's refills (paid at the order, booked on arrival - or never, "nothing came"). So every request leaves an entry here
-- { time, kind, req, pow } (EliteAI_EnergyPay), and two things read it: the meter below counts what was asked for up to
-- Spend_LeakLag before its window, and the tracer names every single fall of the bank no request explains.
function EliteAI_EnergyPay( kind, r, p )
	if not s_on() then return end
	local E = EliteAI_E
	E.pay = E.pay or {}
	table.insert(E.pay, { t = World_GetGameTime(), k = kind, r = r or 0, p = p or 0 })
end
local function e_book( now )
	local E, keep, sum = EliteAI_E, {}, {}
	for _, e in ipairs(E.led) do
		if now - e.t < 60 then
			table.insert(keep, e)
			local s = sum[e.k]
			if not s then s = { r = 0, p = 0 }; sum[e.k] = s end
			s.r, s.p = s.r + e.r, s.p + e.p
		end
	end
	E.led = keep
	local a, b = {}, {}
	for _, k in ipairs(E_KINDS) do
		local s, tt = sum[k], E.tot[k]
		if s then table.insert(a, string.format("%s %d/%d", k, s.r, s.p)) end
		if tt then table.insert(b, string.format("%s %dx %d/%d", k, tt.n, tt.r, tt.p)) end
	end
	return table.concat(a, ", "), table.concat(b, ", ")
end
-- the Garrison pattern has lasted long enough to buy against it: true, seconds held
local function e_gar_active( now )
	local g = EliteAI and EliteAI.gar
	if type(g) ~= "table" or g.t0 == nil then return false, 0 end
	local held = now - g.t0
	return held >= eai_num("Gar_BuySecs", 25), held
end
-- multiplier of a buildable squad's demand while a garrison holds (EliteAI_PurchaseMult; the watchdog's candidates too)
function EliteAI_GarMult( name, curAmount )
	if not s_on() then return 1 end
	local on, held = e_gar_active( World_GetGameTime() )
	if not on then return 1 end
	for _, k in ipairs(GAR_COUNTER_UNITS) do
		if e_ends(name, k) then
			local m = ((curAmount or 0) == 0) and eai_num("Gar_BuyMult", 2.5) or eai_num("Gar_BuyMultHave", 1.3)
			EliteAI_E.n_gar = EliteAI_E.n_gar + 1
			e_say("gar|" .. k, eai_num("Gar_LogSecs", 30), "GAR", "demand", r_short(name), "x" .. tostring(m), "garrison", tostring(EliteAI.gar.id),
				"held", math.floor(held), "s", "decision", tostring(EliteAI.gar.v), "have", curAmount or 0)
			return m
		end
	end
	return 1
end
-- 0.6 (TECH_RU.md 15.9; Orca, fb 511: "it does not use its anti-set-up squads") THE ENEMY'S SET-UP TEAMS. mod/mechanics.ai counts the
-- enemy squads that set a heavy weapon up (EliteAI.setup = { n, t0, t }, numbers; there from SetupBuyMin = 2 teams on). While it
-- has stood for Setup_BuySecs (20 s) and is fresh (30 s), the race's answers - reports/tactics_kb/kb.yaml threats.suppression_spam
-- .responses and the units whose "counters" name setup_team: jump squads, grenades, snipers, artillery (SETUP_COUNTER_UNITS, by
-- the end of the sbps name; the squads Elite's own gates drop - spotters, spore mines - stay dropped) - get x Setup_BuyMult
-- (2.0) while we have none of that kind, x Setup_BuyMultHave (1.3) with one, x 1 with two or more: an answer, not an army of
-- them. Log "SETUP demand <sbps> x2 enemy set-up teams N for S s have H" (once per 30 s per unit). Setup_Buy=0 = off.
function EliteAI_SetupMult( name, curAmount )
	if not s_on() or eai_num("Setup_Buy", 1) < 1 then return 1 end
	local S = EliteAI and EliteAI.setup
	if type(S) ~= "table" or S.t0 == nil then return 1 end
	local now = World_GetGameTime()
	if now - (S.t or -1000) > 30 or now - S.t0 < eai_num("Setup_BuySecs", 20) then return 1 end
	local have = curAmount or 0
	if have >= 2 then return 1 end
	for _, k in ipairs(SETUP_COUNTER_UNITS) do
		if e_ends(name, k) then
			local m = (have == 0) and eai_num("Setup_BuyMult", 2.0) or eai_num("Setup_BuyMultHave", 1.3)
			EliteAI_E.n_setup = (EliteAI_E.n_setup or 0) + 1
			e_say("setup|" .. k, 30, "SETUP", "demand", r_short(name), "x" .. ((m == math.floor(m)) and string.format("%d", m) or string.format("%.1f", m)), "enemy set-up teams", tostring(S.n), "for", math.floor(now - S.t0), "s", "have", have)
			return m
		end
	end
	return 1
end
-- 0.5 (TECH_RU.md 17.4; the owner, Orca fb 513 / 515) THE ANSWER TO THE ENEMY'S ARMY. mod/mechanics.ai classifies the enemy squads we
-- have seen (light masses, melee swarms, heavy infantry, vehicles, dangerous melee squads, jump squads, infiltrators, snipers,
-- turrets nothing of ours outranges), its arbiter Conf_CounterVsPlan decides per class "counter" or "plan", and
-- EliteAI_MechCounterMult gives the multiplier of a buildable squad that answers a class (x2 while we have no answer, x1.3 with
-- one, x1.2 for a class left to the plan; the data and the log line "COUNTER demand ..." are there). Counter_Buy=0 = off here.
function EliteAI_CounterMult( name, curAmount )
	if not s_on() or eai_num("Counter_Buy", 1) < 1 or type(EliteAI_MechCounterMult) ~= "function" then return 1 end
	local m = EliteAI_MechCounterMult( name, curAmount or 0 ) or 1
	if m ~= 1 then EliteAI_E.n_counter = (EliteAI_E.n_counter or 0) + 1 end
	return m
end
-- a flamer / grenade upgrade while a garrison holds (the floor of CalcSquadUpgradeDemand above lets it be a candidate)
function EliteAI_GarAddon( upgradePBG )
	if not s_on() or not EliteAI_E.gar_on or upgradePBG == nil then return false end
	return e_has(string.lower(PBG_GetName( upgradePBG ) or ""), GAR_ADDON_KEYS)
end
-- 0.3 THE ARMY'S SHARE (TECH_RU.md 12; s15, 4p_tharsisforge: 6 / 5 units by 12:00 against 8 / 9 in s13; IG paid ~1650 req for
-- upgrades and 1500 for units in those 12 minutes, 23 upgrade lines against 3 units between 4:30 and 9:00). Elite's addon
-- budget asks for the best upgrade every 3 s and buys it as soon as the bank holds its 50-150 req, so a unit of 300-575 req
-- is always "far" (ETA by the bank it never gets), and the arbiter below only protects a unit that is already within reach.
-- A good player in T1-T2 puts most of the req into squads and upgrades them once the army is there. The rule, one for all
-- races, by real costs (the book of purchases, bought requests only):
--   upgrades may take at most Share_AddonT1 / T2 / T3 (0.15 / 0.20 / 0.30) of the req spent on the army so far - spawns,
--   reinforcements, the globals that spawn squads (book kinds unit, reinf, abil; or the worth of the squads we have, when
--   that is more) plus the upgrades themselves;
--   half of that (Share_SmallK) while the army is below Share_ArmyT1 / T2 / T3 (4 / 6 / 8) squads - "the army is not there yet";
--   half of that (Share_BehindK) while our team's army is behind the closest enemy's (cache.military_percent_value <
--   Share_BehindPct 0, the value Elite and the tech arbiter use);
--   no cap at Share_PopFree (0.9) of the population cap (no unit can come), while Share_RichReq (400) req lie in the bank
--   beyond the cost of the unit that is waited for (the money is idle), and for the Garrison pattern's flamers / grenades.
-- An upgrade that would take the share over the cap is not a candidate this tick ("ENERGY addon skip <name> why share ...").
-- The cap is an upper bound; the lower bound is the arbiter's window: after Spend_UnitFirstMax of waiting for a unit the
-- upgrades get their Spend_UnitFirstPause only while they are below Share_FloorK (0.5) of the cap - with their share taken
-- the unit stays first (s15, IG: "unit->addons waited 46 s" three times at a unit ETA of 12-36 s). Share_On=0 = as before.
local function e_tot( kind )
	local tt = EliteAI_E.tot[kind]
	return (tt and tt.r) or 0
end
-- req on the army so far; req on upgrades (bought, plus the requests that wait for their verdict). The army: what the book
-- says we paid, or what the squads we have are worth when that is more (EliteAI_PurchasePrep of the last units tick: an army
-- that was not bought through these scripts - the polygon's scenes place it, the build order's first squads).
local function e_spent()
	local pend = 0
	for _, q in ipairs(EliteAI_E.areq) do pend = pend + q.r end
	local army = e_tot("unit") + e_tot("reinf") + e_tot("abil")
	local have = (EliteAI_P and EliteAI_P.army_req) or 0
	if have > army then army = have end
	return army, e_tot("addon") + pend
end
local function e_addon_share()
	local army, add = e_spent()
	if army + add <= 0 then return 0 end
	return add / (army + add)
end
-- the cap of this tick: share, why
local function e_share_cap()
	local E, now = EliteAI_E, World_GetGameTime()
	if E.cap_t == now and E.cap ~= nil then return E.cap, E.cap_why end
	local c = cache or {}
	local lvl = c.tech_tier_level or 1
	local cap = (lvl <= 1 and eai_num("Share_AddonT1", 0.15)) or (lvl == 2 and eai_num("Share_AddonT2", 0.20)) or eai_num("Share_AddonT3", 0.30)
	local need = (lvl <= 1 and eai_num("Share_ArmyT1", 4)) or (lvl == 2 and eai_num("Share_ArmyT2", 6)) or eai_num("Share_ArmyT3", 8)
	local why = "T" .. tostring(lvl)
	local army, pct = c.military_count or 0, c.military_percent_value or 0
	local pop, popmax = c.current_population_personnel or 0, c.max_population_personnel or 0
	if eai_num("Share_On", 1) < 1 then cap, why = 1, "off"
	elseif popmax > 0 and pop >= popmax * eai_num("Share_PopFree", 0.9) then cap, why = 1, "pop " .. pop .. "/" .. popmax
	elseif ((c.resources and c.resources.requisition) or 0) - (E.hold_req or 0) >= eai_num("Share_RichReq", 400) then cap, why = 1, "rich"   -- req lies idle beyond the unit that is waited for
	elseif army < need then cap, why = cap * eai_num("Share_SmallK", 0.5), why .. " army " .. army .. "<" .. need
	elseif pct < eai_num("Share_BehindPct", 0) then cap, why = cap * eai_num("Share_BehindK", 0.5), why .. string.format(" behind %.2f", pct)
	end
	E.cap_t, E.cap, E.cap_why = now, cap, why
	return cap, why
end
EliteAI_EnergyShare = function() local cap, why = e_share_cap(); return e_addon_share(), cap, why end   -- the stub run, the stats

-- Conf_AddonVsUnit: squad upgrades wait for the unit Elite's pipeline is short of money for, when it is within reach

local function e_rule()
	local r = math.floor(eai_num("Conf_AddonVsUnit", r_vidx()))
	if r < 1 then r = 1 elseif r > 3 then r = 3 end
	return r
end
-- 0.10 (TECH_RU.md 21.1) THE ARMY'S TEMPO. Both testers after newai-19 / 20: "the bot is very weak, few units, it develops badly"
-- (Malum fb 623: grey knights, an army of 4-7 squads for 26 minutes, pop <= 59 of 100; Orca fb 634: chaos, 7 units in 14 minutes).
-- Their books at 12:30 - Malum: units 1760 req of 4705 spent (37 %), generators and nodes 1650 (35 %: twelve generators and nine
-- nodes in the match, the enemy razed them four times), models 635, upgrades 360; Orca: units 1850 of 4734 (39 %), models 979,
-- upgrades 555, T3 at 11:06 with seven squads. The req income is 210-340 a minute whatever is held (the upkeep eats what the
-- points bring), so a player's army at 10 minutes is that income spent on squads - and here less than two fifths of it was.
-- The tempo is one number for every purse: the population the army should have by now - Tempo_Pop0 (30) + Tempo_PopPerMin (5)
-- a minute, up to Tempo_PopShare (0.8) of the cap: 55 at 5:00, 80 at 10:00. BEHIND it the unit the pipeline waits for is first:
--  * the upgrades leave it its req whatever its ETA and under every rule of Conf_AddonVsUnit (e_hold_tick: the ETA limits were
--    why "unit_first" was off in most stats lines - right after any purchase the unit is 60-100 s away at this income, so the
--    upgrades went through, and they kept it away); the upgrades' own floor share still opens their window (Share_FloorK);
--  * a generator / a node beyond the base is asked for only when the POWER is what we wait for (e_gen_need below).
-- Tempo=0 = off (0.9 as it was). Line "SPEND tempo behind|ok pop P target T ..." once a minute, "tempo P/T" in ENERGY stats.
function EliteAI_Tempo()
	if not s_on() or cache == nil or eai_num("Tempo", 1) < 1 then return false, 0, 0 end
	local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
	if popmax <= 0 then return false, pop, 0 end
	local target = math.min(popmax * eai_num("Tempo_PopShare", 0.8), eai_num("Tempo_Pop0", 30) + eai_num("Tempo_PopPerMin", 5) * World_GetGameTime() / 60)
	return pop < target, pop, target
end
local function e_hold_tick( now )
	local E, r = EliteAI_E, e_rule()
	local st = E.stall
	local fresh = (st ~= nil and now - st.t <= 7)                           -- a spawn stalled within the last two purchase ticks
	local eta_max = eai_num("Spend_UnitFirstEta", (r == 1) and 60 or 40)
	-- 0.10: behind the tempo the unit is first whatever its ETA and the rule (the upgrades' floor share keeps its window)
	local behind, tpop, ttarget = EliteAI_Tempo()
	local tempo = behind and eai_num("Tempo_Hold", 1) >= 1
	E.tempo, E.tempo_pop, E.tempo_target = behind, tpop, ttarget
	if behind then E.n_tempo = (E.n_tempo or 0) + 1 end
	if eai_num("Tempo", 1) >= 1 then e_say("tempo", 60, "SPEND", "tempo", behind and "behind" or "ok", "pop", tpop, "target", math.floor(ttarget), "army", (cache and cache.military_count) or -1,
		"bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "unit", st and fresh and st.name or "-", "hold", E.hold and 1 or 0) end
	if tempo then eta_max = 9999 end
	-- 0.6 (TECH_RU.md 15.3): the tech plan gave the float research's money to this unit - the upgrades leave it its req as well
	local tuf = (r < 3) and type(EliteAI_TechUnitFirst) == "function" and EliteAI_TechUnitFirst() == true
	if tuf then eta_max = math.max(eta_max, eai_num("Tech_FloatUnitEta", 75)) end
	local eta_off = eta_max * eai_num("Spend_UnitFirstOffK", 1.5)           -- 0.2: a band, not one threshold
	local max_s = eai_num("Spend_UnitFirstMax", (r == 1) and 75 or 45)
	-- 0.5 (TECH_RU.md 17.3; s20: no unit for 262 s, tyranids - after the T2 research took the bank the unit's ETA was 84 s at this
	-- income, "eta 80>60" let the upgrades through, four of them (355 req) and a generator kept the ETA there for two minutes).
	-- A DROUGHT - no unit bought for Spend_DroughtSecs while one waits - is no time for upgrades whatever the ETA: the unit is
	-- first until it is bought (rules 1 and 2; rule 3 never holds the upgrades). The ETA is long BECAUSE the req goes elsewhere.
	local dsecs = eai_num("Spend_DroughtSecs", 120)
	-- 0.6 (TECH_RU.md 18.7; Orca fb 527, IG, newai-15: units at 0:01 and 0:29, the third at 3:38 - three generators (300 req), a
	-- sergeant, a stomp and 160 req of models went first while "ig_devils 350/35" stood at "why money" for 168 s): an army of
	-- Spend_DroughtArmy (3) squads or fewer is in a drought after Spend_DroughtSmall (60 s) already. 0 = the one clock for all.
	local dsmall = eai_num("Spend_DroughtSmall", 60)
	if dsecs > 0 and dsmall > 0 and dsmall < dsecs and cache ~= nil and (cache.military_count or 99) <= eai_num("Spend_DroughtArmy", 3) then dsecs = dsmall end
	local dry_for = (EliteAI_S ~= nil) and (eai_time() - (EliteAI_S.last_buy or 0)) or 0
	-- 0.6 (TECH_RU.md 18.7; Orca's second match, tyranids, variant C = rule 3 "the upgrades never wait"): the units' pipeline
	-- stood at "why money" for 413 s in a row (4:09-11:20: a ravener 400/45, then a genestealer 350/45, then a tyrant guard) -
	-- every time the bank came near the price an upgrade request locked 120-150 req of it ("bank 405/95 tasks 150/50 avail
	-- 255/23"); 8 units and 15 upgrades (1700 req) in 21 minutes. The variants differ where
	-- the outcome is not clear; a unit that nobody can buy for minutes is clear. A drought holds under rule 3 too
	-- (Spend_DroughtRule3=0 = rule 3 never holds, as before)
	local dry = (r < 3 or eai_num("Spend_DroughtRule3", 1) >= 1) and fresh and dsecs > 0 and dry_for >= dsecs
	E.dry, E.dry_for = dry, dry_for                                         -- 0.7: the director's refills read it (EliteAI_ReinforceDir)
	local want, why, paused = E.hold, "-", false
	-- the wait clock: seconds a unit was short of money since the decision "unit" (not the time it had the money and waited
	-- for the busy HQ, not the time no unit waited at all)
	local dt = math.min(now - (E.hold_last or now), 5)
	E.hold_last = now
	if r >= 3 and not dry and not tempo then
		want, why = false, "rule 3"
	elseif E.hold then
		if fresh then
			E.idle_t = now
			if st.eta > 0 then E.hold_wait = (E.hold_wait or 0) + dt end
			if dry then
				E.n_dry = (E.n_dry or 0) + 1
				e_say("hold_dry", 60, "ENERGY", "Conf_AddonVsUnit", "bank", "unit kept", st.name, "eta", math.floor(st.eta), "drought", math.floor(dry_for), "s without a unit", "rule", r)
			elseif st.eta > eta_off then want, why = false, string.format("%s eta %.0f>%.0f", st.name, st.eta, eta_off)
			elseif (E.hold_wait or 0) >= max_s then
				-- 0.3: the window is for upgrades that are short of their share; with the share taken the unit stays first
				local cap = e_share_cap()
				local sh, floor = e_addon_share(), cap * eai_num("Share_FloorK", 0.5)
				-- 0.6 (Orca fb 527, 11:52: the ogryns 400/85 were 34 req - 8 s - away with 366 req when "waited 46 s share 0.09<0.10"
				-- opened the upgrades' window; the commissar's power claw (130/40) took it, the match ended with 253/241 in the bank
				-- and no ogryns): a unit that is Spend_UnitFirstNear (15 s) away is bought first, the window comes after it
				if st.eta <= eai_num("Spend_UnitFirstNear", 15) then
					E.n_hold_keep = E.n_hold_keep + 1
					e_say("hold_near", 30, "ENERGY", "Conf_AddonVsUnit", "bank", "unit kept", st.name, "eta", math.floor(st.eta), "waited", math.floor(E.hold_wait), "s",
						"the unit is that near: the upgrades' window comes after it", "rule", r)
				elseif sh < floor then
					want, why, paused = false, string.format("waited %.0f s share %.2f<%.2f", E.hold_wait, sh, floor), true   -- the upgrades get their window
				else
					E.n_hold_keep = E.n_hold_keep + 1
					e_say("hold_keep", 60, "ENERGY", "Conf_AddonVsUnit", "bank", "unit kept", st.name, "eta", math.floor(st.eta), "waited", math.floor(E.hold_wait), "s",
						"upgrades have their share", string.format("%.2f>=%.2f", sh, floor), "rule", r)
				end
			end
		elseif now - E.idle_t >= eai_num("Spend_UnitFirstIdle", 20) then
			want, why = false, "no stalled unit"
		end
	elseif fresh and st.eta <= eta_max and now >= E.hold_pause then
		want, why = true, string.format("%s %d/%d eta %.0f%s", st.name, st.req, st.pow, st.eta, tempo and " tempo" or "")
	elseif dry then
		want, why = true, string.format("%s %d/%d eta %.0f drought %.0f s", st.name, st.req, st.pow, st.eta, dry_for)
	end
	-- what the upgrades (and Secure, the generators) have to leave in the bank: only while a unit really waits
	E.hold_req = (E.hold and fresh) and st.req or 0
	if want == E.hold then return end
	if now - E.hold_sw < eai_num("Spend_UnitFirstHold", 20) then return end -- hysteresis: two switches in 30 s at most
	E.hold, E.hold_sw = want, now
	E.n_hold_sw = E.n_hold_sw + 1
	if want then E.hold_t, E.idle_t, E.hold_req, E.hold_wait = now, now, st.req, 0 else E.hold_req = 0 end
	if paused then E.hold_pause = now + eai_num("Spend_UnitFirstPause", (r == 1) and 20 or 30) end
	eai_log("ENERGY", "Conf_AddonVsUnit", "bank", want and "addons->unit" or "unit->addons", why, "rule", r, "bank", s_rp(cache.resources))
end
-- TryPurchaseUnitChoice: the chosen spawn stalls - why = "money" (short in what the units budget may spend) or "channel"
-- (the money is there, the producer has a request: a unit in production, the tier research)
-- 0.4: also called by the plan (EliteAI_PlanClaim) before the choice - why "ready" = the money is there and the HQ is free (no
-- line: it is bought in this tick unless something goes first).
function EliteAI_EnergyNoteStall( pbg, cost, why, availableResources, queue )
	if not s_on() or cache == nil or cache.resources == nil or cost == nil or pbg == nil then return end
	local E, now = EliteAI_E, World_GetGameTime()
	why = why or "money"
	local eta = 0
	if why == "money" then eta = GetETAFromCost( cost, availableResources or cache.resources ) or 0 end   -- util/demand.ai:105, at the current income
	local name = r_short(PBG_GetName( pbg ))
	local since, msince = now, nil
	local prev = (E.stall ~= nil and now - E.stall.t <= 7) and E.stall or nil
	if prev then since = prev.since or prev.t end                           -- stalled without a break (whatever the unit)
	if why == "money" then msince = (prev and prev.msince) or now end       -- 0.4: short of money without a break (the "unit" save of the reinforcement budget)
	E.stall = { t = now, since = since, msince = msince, req = cost.requisition or 0, pow = cost.power or 0, eta = eta, name = name, why = why }
	local full = string.lower(PBG_GetName( pbg ) or "")
	E.stall.ans = (EliteAI_P ~= nil and EliteAI_P.ans ~= nil and EliteAI_P.ans[full] == true)   -- 0.10: an answer the layers ask for (e_gen_first)
	if why == "ready" then e_hold_tick( now ); return end
	-- 0.2: who holds the money - the line the verification of newai-10 could not get from the log
	e_say("stall|" .. why, eai_num("Spend_StallLog", 20), "SPEND", "stall", name, s_rp(cost), "why", why, "avail", s_rp(availableResources or cache.resources),
		"bank", s_rp(cache.resources), "tasks", s_rp(Task_CountCost( s_selfplayer, false )), "queue", queue or 0, "eta", math.floor(eta),
		"for", math.floor(now - since), "s", "tech_reserve", E.res_req or 0, "secure_pending", E.sec_pending or 0,
		"budget_gave", math.floor(E.av_req or -1) .. "/" .. math.floor(E.av_pow or -1))   -- below bank - tasks = a budget ahead of the units locked the difference
	e_hold_tick( now )                                                      -- at once: the addon run of the next tick comes before the next units run
end
-- strategy_tech_purchase.ai (decision "army"): the unit the pipeline is about to buy - it has the money and waits for the HQ, or
-- is within Tech_ArmyEta (10 s) of it: its req, power; 0, 0 = none. A unit that is far from affordable is not protected this way:
-- with a small army rule 2 says "army" for minutes, and the tier research would not come before Tech_T2Late.
function EliteAI_UnitWant()
	local st = EliteAI_E and EliteAI_E.stall
	if not s_on() or st == nil or World_GetGameTime() - st.t > 7 then return 0, 0 end
	if st.why ~= "channel" and (st.eta or 0) > eai_num("Tech_ArmyEta", 10) then return 0, 0 end
	return st.req or 0, st.pow or 0
end
-- 0.4 THE PLAN'S NEXT UNIT (TECH_RU.md 13). Until now "the unit we wait for" was the spawn TryPurchaseUnitChoice stalled on - and
-- that exists only when a spawn is the first choice of the first pass. A reinforcement entry (demand x50) goes first whenever
-- a model is affordable within 30 s, and a spawn farther than Elite's wait (personality eta_unit_wait_time + 5 s per squad
-- above 4) is no entry at all: with the bank kept low by refills and upgrades the unit was never "waited for" (s16: no stall
-- line from 7:00 to 10:30), so nothing stepped back for it. Now AccumulateSquadDemand notes, on the first pass, the best spawn
-- by the demand it would get (the entries within Elite's wait first, then the ones the income brings within Plan_EtaMax =
-- Energy_EtaMax 120 s - those are worked out by the same rules and never set as a demand: Elite's choice is as it was), and
-- do_purchase makes it the claim before the choice: EliteAI_E.stall, why "money" (short), "channel" (the HQ has a request) or
-- "ready". Everything that steps back for a unit reads that one record: the upgrades (Conf_AddonVsUnit), the tech arbiter
-- (EliteAI_UnitWant), the reinforcements (r_claim), the race's abilities (EliteAI_UnitClaim, mod/mechanics.ai).
-- The blueprint is kept within the tick only (EliteAI_P.plan is dropped in EliteAI_PlanClaim). Plan_Claim=0 = off.
function EliteAI_PlanNote( pbg, demand, eta, in_wait )
	local P = EliteAI_P
	if not s_on() or pbg == nil or P.pass ~= 0 then return end
	local name = string.lower(PBG_GetName( pbg ) or "")
	if eai_class(name) == "hero" then return end
	local pl = P.plan
	if pl == nil or (in_wait and not pl.in_wait)
		or (in_wait == pl.in_wait and (demand > pl.demand or (demand == pl.demand and name < pl.name))) then   -- ties by name: the order of the list does not matter
		P.plan = { pbg = pbg, name = name, demand = demand, eta = eta, in_wait = in_wait }
	end
end
function EliteAI_PlanClaim( availableResources )
	local P = EliteAI_P
	local pl = P.plan
	P.plan = nil
	if not s_on() or pl == nil or pl.pbg == nil or cache == nil or cache.resources == nil or eai_num("Plan_Claim", 1) < 1 then return end
	local cost = SquadStats_GetCost( s_self_modplayer, pl.pbg )              -- TryPurchaseUnitChoice below (Elite's)
	if cost == nil then return end
	local av = availableResources or cache.resources
	local why, q = "ready", 0
	if not ResourceAmount_Has( av, cost ) then
		why = "money"
	else
		q = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, pl.pbg ) or 0   -- TryPurchaseUnitChoice below (Elite's)
		if q > 0 then why = "channel" end
	end
	EliteAI_EnergyNoteStall( pl.pbg, cost, why, av, q )
end
-- the unit the plan waits for, for the scripts outside this file: req, pow, eta (s, 0 = has its money), name, why, waited (s);
-- nil = none (numbers and strings: nothing of the engine is handed out)
function EliteAI_UnitClaim()
	local st = EliteAI_E and EliteAI_E.stall
	if not s_on() or st == nil then return nil end
	local now = World_GetGameTime()
	if now - st.t > 7 then return nil end
	return st.req or 0, st.pow or 0, st.eta or 0, st.name or "-", st.why or "money", now - (st.since or st.t)
end
-- 0.5 (TECH_RU.md 14) mod/mechanics.ai: a call-in was cast - a global that brings squads for req. It is a unit bought through
-- another channel: the line "callin <t> <ability> R/P army N" (the count of units of a match = "buy" + "callin"), the idle clock
-- of the watchdog, the save state (it ends as with a unit: the squads get their pause), and the wait for the plan's unit
-- starts anew. The cost is in the book as "abil" (EliteAI_EnergyNote, mechanics.ai).
function EliteAI_UnitCallIn( name, cost )
	if not s_on() then return end
	EliteAI_S.n_callin = (EliteAI_S.n_callin or 0) + 1
	eai_log("callin", eai_time(), string.lower(name or "-"), s_rp(cost), "army", (cache and cache.military_count) or -1, "n", EliteAI_S.n_callin)
	EliteAI_S.last_buy = eai_time()
	EliteAI_ReinforceNoteBuy( r_short(name), cost, World_GetGameTime() )
	EliteAI_E.stall = nil
end
-- 0.6 (TECH_RU.md 15.2) THE CALL-IN OR THE UNIT, BEFORE THE UNIT IS BOUGHT (mod/mechanics.ai EliteAI_MechCallInFirst). The polygon's
-- scene d (newai-13): the bank reached 355, this budget bought the genestealer (350) in that tick, and the ability budget -
-- which runs after it - found no money for the spore (350): the arbiter Conf_AbilityVsUnit never saw the pair. Now
-- TryPurchaseUnitChoice asks at the three places a spawn is decided: it would be bought now ("ready"), it has its money and
-- waits for the HQ ("channel"), it is short of money and would lock its cost ("money"). The unit is the claim the arbiter
-- reads (EliteAI_E.stall); a call-in the arbiter lets pass over it is cast at once and this budget is charged with it
-- (returns its name and cost; nil = the unit goes on as before). Mech_AbilCallInFirst=0 = off.
function EliteAI_CallInFirst( pbg, unitCost, why, availableResources )
	if not s_on() or type(EliteAI_MechCallInFirst) ~= "function" or pbg == nil or unitCost == nil or availableResources == nil then return nil end
	if why == "ready" then EliteAI_EnergyNoteStall( pbg, unitCost, "ready", availableResources, 0 ) end   -- this unit is the claim (the stalls noted it already)
	local name, cost = EliteAI_MechCallInFirst( availableResources )
	if name == nil then return nil end
	EliteAI_E.n_callin_first = (EliteAI_E.n_callin_first or 0) + 1
	eai_log("SPEND", "callin_first", r_short(name), s_rp(cost), "over", r_short(PBG_GetName( pbg )), s_rp(unitCost), why, "avail", s_rp(availableResources))
	return name, cost
end
-- 0.6 (TECH_RU.md 15.3) how many units were bought so far - the spawn requests of the units budget and of the watchdog (the book's
-- "unit") and the call-ins: strategy_tech_purchase.ai ends its "unit first" with the next one
function EliteAI_UnitBuys()
	if not s_on() then return 0 end
	local tt = EliteAI_E and EliteAI_E.tot and EliteAI_E.tot.unit
	return ((tt and tt.n) or 0) + ((EliteAI_S and EliteAI_S.n_callin) or 0)
end
-- 0.6 (TECH_RU.md 15.3): is the tech plan's "unit first" on (the float research stepped back for the unit that was waited for)?
-- While it is, that unit is "within reach" for everything that steps back for a unit - the reinforcements (r_claim) and the
-- upgrades (Conf_AddonVsUnit) - up to Tech_FloatUnitEta: s18, 11:03 - the arbiter said "unit_first tyr_warrior_venom_cannon eta 63"
-- and in the next 5 s two models (36 req) and two upgrades (90 req) were bought with the req that was left to the unit.
-- (EliteAI_TechUnitFirst of strategy_tech_purchase.ai is asked in r_claim and e_hold_tick.)
-- 0.5 (TECH_RU.md 14) strategy_tech_purchase.ai, the reason "float": the unit the plan waited for BEFORE the research was wanted
-- (t_want) and that the income brings within Tech_FloatUnitEta (75 s = the time of a research) - name, eta, req, pow; nil = none.
-- s17: the zoanthrope (360/40) had been waited for since 9:07; at 11:02 the float state asked for T3, the plan's reserve took
-- the bank (the unit was 57 s away: "avail 0/119"), T3 started at 11:37, the 7th unit came at 12:54. A unit whose wait began
-- after the research was wanted does not hold it: one unit, 75 s at most, then the research. The eta is by the bank less the
-- tasks - not by what the units budget is given (the reserve itself makes that 0).
function EliteAI_UnitAhead( t_want )
	local st = EliteAI_E and EliteAI_E.stall
	if not s_on() or st == nil or cache == nil or cache.resources == nil then return nil end
	local now = World_GetGameTime()
	if now - st.t > 7 or (st.since or st.t) >= (t_want or now) then return nil end
	local eta = 0
	if st.why == "money" then
		local tasks = Task_CountCost( s_selfplayer, false )                  -- util/budget.ai:271
		local rate = cache.resources_rate or {}
		local function wait( need, have, per_min )
			if need <= have then return 0 end
			return (per_min > 0) and (60 * (need - have) / per_min) or 11111
		end
		eta = math.max(wait( st.req or 0, (cache.resources.requisition or 0) - ((tasks and tasks.requisition) or 0), rate.requisition or 0 ),
			wait( st.pow or 0, (cache.resources.power or 0) - ((tasks and tasks.power) or 0), rate.power or 0 ))
	end
	if eta > eai_num("Tech_FloatUnitEta", 75) then return nil end
	return st.name or "-", eta, st.req or 0, st.pow or 0
end
-- 0.2: what a budget may really spend = what the budget system gives it, but never the bank below the reserves: the tech plan's
-- (EliteAI_TechReserve: the tier research while the arbiter says "tech") and, for the budgets of the other run, the unit the
-- upgrades wait for (Conf_AddonVsUnit). The budget system's own value only knows the locks of the budgets that ran before
-- this one in this run. Returns the same object when nothing is reserved, else a copy with req / power cut.
local function e_reserved( availableResources, with_unit )
	local E = EliteAI_E
	E.res_req, E.res_pow = 0, 0
	if availableResources == nil or cache == nil or cache.resources == nil or eai_num("Energy_Reserve", 1) < 1 then return availableResources end
	local rr, rp = 0, 0
	if type(EliteAI_TechEval) == "function" then EliteAI_TechEval() end      -- the plan of this tick (the tech budget may run after us)
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	rr, rp = rr or 0, rp or 0
	local ur = (with_unit and E.hold and E.hold_req) or 0
	E.res_req, E.res_pow = rr, rp
	-- 0.9 (TECH_RU.md 21.13): the cost of the node a squad walks to is the engine's until the node is placed (EliteAI_EnergyWalk)
	local wr, wp = 0, 0
	if type(EliteAI_EnergyWalk) == "function" then wr, wp = EliteAI_EnergyWalk( World_GetGameTime() ) end
	if rr + rp + ur + wr + wp <= 0 then return availableResources end
	local free = ResourceAmount_Subtract( cache.resources, Task_CountCost( s_selfplayer, false ) )   -- util/budget.ai:271, 318
	local fr, fp = (free.requisition or 0) - rr - ur - wr, (free.power or 0) - rp - wp
	local ar, ap = availableResources.requisition or 0, availableResources.power or 0
	if fr >= ar and fp >= ap then return availableResources end
	local out = ResourceAmount_Subtract( availableResources, ResourceAmount_Zero() )   -- a copy: the budget system's object stays as it is
	out.requisition, out.power = math.max(0, math.min(ar, fr)), math.max(0, math.min(ap, fp))
	return out
end
EliteAI_EnergyReserved = e_reserved                                         -- the stub run
-- 0.2 BUDGET_Secure, before Elite's purchase function: true = no request this tick. The inactive requests of the last tick are
-- killed by now (default.ai:249, before the purchases), so Util_CountSecureRequests() = the ones a squad is executing.
-- 0.9 (TECH_RU.md 20.1) WHAT "DEAD" MEANT. The power node (<race>_listening_post, 125 req, 20 s, built by a squad) can stand only
-- on a POWER point of ours that has none; Elite asks for one whenever "points owned > points secured" (strategy_defence_purchase.ai:
-- 81) - requisition and victory points count as owned and can never be secured, so the demand is there for the whole match and
-- nearly every request has nothing to build ("secure_req 13 secure_dead 13" while the nodes that could be built were built:
-- s24a, tyranids - the first generator stood at 68 s with two "dead" requests before it). And a request that WAS taken read as
-- dead too: its task is gone by the next tick and the point counts as secured only when the node is finished, 20 s later. Now:
--  * the request is asked for only while mechanics.ai sees a power point of our team without a node (EliteAI.pw.unsec, from
--    Military_MilitaryPointIsSecuredPoint of its point scan; no scan = as before) - "secure_none" counts the ticks without one;
--  * the verdict waits Energy_SecureVerdict (25 s) for the task, a new secured point or a new node (PBG_GetCount of the securing
--    structure); no second request while it is open;
--  * with a point to secure the request is not cut by the unit the upgrades wait for (it is the condition of every generator).
local function e_is_secure( v ) return BS_Secure ~= nil and v.buildstyle == BS_Secure end   -- the node's entry (personality/<race>/standard.ai)
local function e_node_count()
	local n = 0
	if type(s_securing_structures) == "table" then
		for _, v in pairs(s_securing_structures) do                          -- a sum: the order of pairs() does not matter
			if v and v.pbg and e_is_secure( v ) then n = n + (PBG_GetCount( s_selfplayer, v.pbg ) or 0) end
		end
	end
	return n
end
-- 0.9 (TECH_RU.md 21.13) THE NODE A SQUAD WALKS TO HOLDS ITS PRICE INSIDE THE ENGINE. s27b, orks: "secure req t 487" (125/15),
-- "secure built after 3 s nodes 0->0 ... task 1" - the task is active, a squad walks to the point - and from 491 to 512 s seven
-- requests for a deff dread (270/65) with 281-385 req in the bank were not started; the dread was paid at ~515 with 396 in the
-- bank (270 + 125), the node at 519 ("SPEND drop ... -120/-13", "MECH Builder ... builds"). The same in s27b, IG (node asked at
-- 484, placed at ~527: manticore / chimera 300 not started with 317-422 = below 425) and s27a, IG (425 -> ~443). The budget
-- system takes off the INACTIVE tasks only (util/budget.ai:271 Task_CountCost( .., false )): an active task that has not paid
-- yet is money the scripts saw as free. So while a node's task is active (Task_CountActivePBG( .., true ), count_util.ai:25;
-- the task ends when the node is placed - "nodes 0->1 ... task 0") its price (the last secure request's) is off what the
-- budgets may spend: the unit waits as "why money" (its claim, the upgrades' hold) and no request is placed that the engine
-- cannot start. At most Energy_SecureWalkMax (60 s) per walk. Returns req, pow. Energy_SecureWalk=0 = off.
function EliteAI_EnergyWalk( now )
	local E = EliteAI_E
	if not s_on() or eai_num("Energy_SecureWalk", 1) < 1 or type(s_securing_structures) ~= "table" then return 0, 0 end
	if (E.sec_req or 0) + (E.sec_pow or 0) <= 0 then return 0, 0 end        -- no request of ours yet: the price is not known
	local act = 0
	for _, v in pairs(s_securing_structures) do                             -- a sum: the order of pairs() does not matter
		if v and v.pbg and e_is_secure( v ) then act = act + (Task_CountActivePBG( s_selfplayer, v.pbg, true ) or 0) end
	end
	if act <= 0 then E.walk_t, E.walk_req, E.walk_pow = nil, 0, 0; return 0, 0 end
	if E.walk_t == nil then E.walk_t, E.n_walk = now, (E.n_walk or 0) + 1 end
	if now - E.walk_t > eai_num("Energy_SecureWalkMax", 60) then E.walk_req, E.walk_pow = 0, 0; return 0, 0 end
	E.walk_req, E.walk_pow = (E.sec_req or 0) * act, (E.sec_pow or 0) * act
	e_say("walk", 30, "ENERGY", "secure", "walk", "tasks", act, "the engine holds", E.walk_req .. "/" .. E.walk_pow, "for the node a squad walks to: off what the budgets may spend",
		"for", math.floor(now - E.walk_t), "s", "bank", s_rp(cache and cache.resources), "n", E.n_walk)
	return E.walk_req, E.walk_pow
end
local function e_pw( now )                                                  -- mechanics.ai's look at our power points; nil = no fresh one
	local pw = EliteAI and EliteAI.pw
	if type(pw) ~= "table" or pw.t == nil or now - pw.t > eai_num("Energy_PwFresh", 15) or eai_num("Energy_SecureKnow", 1) < 1 then return nil end
	return pw
end
local function e_secure_gate()
	local E, now = EliteAI_E, World_GetGameTime()
	local pending = (type(Util_CountSecureRequests) == "function") and Util_CountSecureRequests() or 0   -- strategy_defence_purchase.ai:68
	local secured = (cache and cache.total_pts_secured) or 0                -- cache.ai:115
	local nodes, pw = e_node_count(), e_pw( now )
	E.sec_pending, E.sec_first = pending, false
	if E.sec_t ~= nil and now > E.sec_t then                                -- the open request: taken, a node placed or a point secured = bought
		if pending > 0 or secured > (E.sec_n0 or 0) or nodes > (E.sec_nodes0 or 0) then
			EliteAI_EnergyNote( "secure", { requisition = E.sec_req, power = E.sec_pow } )
			eai_log("ENERGY", "secure", "built", "after", math.floor(now - E.sec_t), "s", "nodes", (E.sec_nodes0 or 0) .. "->" .. nodes, "secured", (E.sec_n0 or 0) .. "->" .. secured, "task", pending)
			E.sec_dead, E.sec_t = 0, nil
		elseif now - E.sec_t >= eai_num("Energy_SecureVerdict", 25) then
			E.sec_dead, E.n_sec_dead = E.sec_dead + 1, E.n_sec_dead + 1
			eai_log("ENERGY", "secure", "dead", "after", math.floor(now - E.sec_t), "s", "nodes", nodes, "secured", secured,
				"power points ours", pw and pw.own or "?", "without a node", pw and pw.unsec or "?", "squads", (cache and cache.military_count) or -1)
			E.sec_t = nil
		else
			E.n_sec_hold = E.n_sec_hold + 1
			if pw ~= nil and (pw.unsec or 0) > 0 then EliteAI.build_open = now end   -- main.ai's order book: the squads at the point stay
			return true                                                       -- the verdict is open: no second request
		end
	end
	E.sec_n = secured
	if E.sec_dead >= eai_num("Energy_SecureTries", 2) then
		local mute = (pw ~= nil and (pw.unsec or 0) > 0) and eai_num("Energy_SecureMuteKnown", 20) or eai_num("Energy_SecureMute", 60)
		E.sec_dead = 0
		E.sec_mute = now + mute
		eai_log("ENERGY", "secure", "hold", "dead", "the last", eai_num("Energy_SecureTries", 2), "requests were killed as inactive (nobody builds it): none for",
			mute, "s", "bank", s_rp(cache.resources), "requests", E.n_sec_req, "dead", E.n_sec_dead)
	end
	if pw ~= nil and (pw.unsec or 0) <= 0 then E.n_sec_none = (E.n_sec_none or 0) + 1; return true end   -- no power point of ours without a node
	E.sec_first = (pw ~= nil)                                               -- there is one: the unit's reserve does not cut the request
	-- 0.10 (TECH_RU.md 21.2): the first node always; another one only while the power is what we wait for (Malum fb 621: nine
	-- nodes = 1125 req, most of them with 220-300 power in the bank)
	-- 0.11 (TECH_RU.md 21.13; the polygon's s_tempo: nodes asked at 92 / 113 / 134 s with "nodes 0 secured 2 / 3 / 4" and "gen_need
	-- no" - 375 req while a sentinel waited for its money for 147 s): PBG_GetCount of the node counts the ones being BUILT
	-- ("nodes 0->1 secured 0->0", then "nodes 2->1 secured 0->1": a finished node is a secured point, not a count), so
	-- "nodes >= Energy_NodeBase" was true only during a construction. The nodes we have = being built + secured points.
	local nodes_all = nodes + ((eai_num("Energy_NodeSecured", 1) >= 1) and secured or 0)
	if nodes_all >= eai_num("Energy_NodeBase", 1) and eai_num("Energy_GenNeed", 1) >= 1 then
		local need, nwhy = EliteAI_EnergyGenNeed( now )                        -- (defined below, with the generators' plan)
		if not need then
			E.n_sec_noneed = (E.n_sec_noneed or 0) + 1
			e_say("secure_need", 60, "ENERGY", "secure", "hold", "need", "nodes", nodes_all, "the power is not what we wait for", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate))
			return true
		end
	end
	if now < E.sec_mute then E.n_sec_hold = E.n_sec_hold + 1; return true end
	if pending >= eai_num("Energy_SecureMax", 1) then return true end       -- one at a time: every pending one is 125 req nobody else may spend
	if eai_num("Energy_SecureHold", 1) >= 1 and EliteAI_EnergyFloat() then  -- a power node while the power lies idle
		E.n_sec_hold = E.n_sec_hold + 1
		e_say("secure_float", 60, "ENERGY", "secure", "hold", "float", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate))
		return true
	end
	return false
end
-- 0.4 BUDGET_ResourceAddOn (the generators), before Elite's purchase function: true = no request this tick.
-- 0.5 (TECH_RU.md 14): s17 (IG) - 10 lines "buy_gen ... by count" for the generators 1 -> 4 ("generators 3" four times in 110 s),
-- Orca's match "gen 17x 1700". The count (PBG_GetCount over s_resource_structures, as Util_CountResourceBuildRequests :36
-- walks them) goes up the tick after a request and comes down again when the request dies - the builder is a squad the
-- director orders about - so "more than at the last tick" booked one generator many times. Now two things apart:
--  * the request of the last tick is ALIVE when its task is there or there are more generators than at the moment it was
--    placed (E.gen_n0), else dead; Energy_GenTries (2) dead in a row = none for Energy_GenMute (60 s), "ENERGY gen hold dead";
--  * the BOOK notes a generator when it stands: the count has been above the level the book knows (E.gen_book; what stood
--    at the first look is no purchase) for Energy_GenStand (20 s) without a break - the lowest count of that time is the new
--    level, "buy_gen <t> R/P by stand generators N". A level that is gone for Energy_GenLost (45 s) is lowered ("ENERGY
--    gen lost"): the generator was destroyed, the next one is a purchase again.
-- 0.9 (TECH_RU.md 20.1) THE GENERATOR PLAN. "One or two generators in every game" (Orca fb 588, Malum fb 593) is Elite's own cap:
-- strategy_resourcing.ai:194 stops at "generators >= structure.limit + tier - 3", and the limit of the race's personality
-- (personality/<race>/standard.ai - the one file every difficulty loads: personality.ai:124 sets "standard" for all, and
-- default.ai:36-54 reads a variable that is never set, so build_max is 3 on every level) is build_max for the tyranids = 1 / 2 /
-- 3 generators at T1 / T2 / T3, build_max + 1 for the orks (2 / 3 / 4), + 2 for IG, marines, chaos, GK, tau (3 / 4 / 5), + 3 for
-- the eldar. Every stand match shows it: the tyranids held one generator until T2 and two after it, IG three and four.
-- The new logic sets the limit itself, before Elite's rule reads it: Energy_GenPlanBase (2) generators from the start, one
-- more every Energy_GenPlanSecs (150 s), at least Energy_GenPlanT2 (4) with T2 and Energy_GenPlanT3 (6) with T3, never more
-- than Energy_GenPlanMax (6) and, beyond the base, never more than the army has squads less one (the first units come first).
-- Elite's other rules stay (a node with a free place, one request at a time, the req rule). Behind the plan the request is
-- not cut by the unit the upgrades wait for, and the float holds the generators only from Energy_GenFloor (4) up.
-- Energy_GenPlan=0 = Elite's limits. Lines "ENERGY gen plan ...", "ENERGY gen req ...".
local function e_gen_have()
	local have, tot = 0, 0
	if type(s_resource_structures) == "table" then
		for _, v in pairs(s_resource_structures) do                          -- sums: the order of pairs() does not matter
			if v and v.pbg and not e_is_secure( v ) then
				have = have + (PBG_GetCount( s_selfplayer, v.pbg ) or 0)
				tot = tot + (UtilPBG_CountTotal( v.pbg ) or 0)                  -- with the active tasks: what Elite's limit reads
			end
		end
	end
	return have, tot
end
local function e_gen_plan( now )
	if eai_num("Energy_GenPlan", 1) < 1 then return nil end
	local tier, army = (cache and cache.tech_tier_level) or 1, (cache and cache.military_count) or 0
	local base, max = eai_num("Energy_GenPlanBase", 2), eai_num("Energy_GenPlanMax", 6)
	local cap, why = base + math.floor(now / math.max(eai_num("Energy_GenPlanSecs", 150), 1)), "time"
	local tmin = (tier >= 3) and eai_num("Energy_GenPlanT3", 6) or ((tier >= 2) and eai_num("Energy_GenPlanT2", 4) or 0)
	if cap < tmin then cap, why = tmin, "tier" end
	if eai_num("Energy_GenPlanArmy", 1) >= 1 and cap > base and cap > army - 1 then cap, why = math.max(base, army - 1), "army" end
	if cap > max then cap, why = max, "max" end
	return cap, why, tier
end
-- 0.10 (TECH_RU.md 21.2) IS THE POWER WHAT WE WAIT FOR? The plan of 0.9 builds by the clock: 6 generators and 2 nodes = 850 req by
-- 10-12 minutes whatever the power bank holds. 20.10: the power bank at the end 870-1250 in all four stand AIs; Malum's grey
-- knights (fb 621): 12 generators and 9 nodes = 2325 req in 26 minutes - seven squads - with 220-300 power in the bank from the
-- 12th minute on, each farm the enemy razed rebuilt at once. A generator is worth its 100 req only while the power is the
-- short resource. Beyond the base (Energy_GenPlanBase, 2) the plan asks for one only when
--   "unit": the unit the pipeline waits for lacks power and the power comes later than its req (by Energy_GenNeedLead, 10 s), or
--   "tier": the power income will not bring the next tier's power by the plan's time (EliteAI_T, the state of this tick), or
--   "rate": the power income is below the tier's floor (Energy_GenRateT1 / T2 / T3 = 40 / 60 / 85 a minute: what the units and
--           the upgrades of that tier take at this req income) and the power bank is below Energy_GenNeedBank (150).
-- After the enemy razed generators ("ENERGY gen lost") the base does not hold for Energy_GenRaidSecs (150 s): no rebuilding by the
-- clock into the same raid, only by need. The node follows the same question (e_secure_gate): the first one always, another
-- only while the power is needed. Energy_GenNeed=0 = the plan of 0.9. Lines "ENERGY gen plan cap N by need ... need <why>".
local function e_gen_need( now )
	local E = EliteAI_E
	if eai_num("Energy_GenNeed", 1) < 1 or cache == nil or cache.resources == nil or cache.resources_rate == nil then return true, "off" end
	local br, bp = cache.resources.requisition or 0, cache.resources.power or 0
	local rr, rp = cache.resources_rate.requisition or 0, cache.resources_rate.power or 0     -- per minute (cache.ai:156)
	local st = E.stall
	if st ~= nil and now - (st.t or -1000) <= 7 and st.why == "money" and (st.pow or 0) > bp then
		local pe = (rp > 0) and 60 * (st.pow - bp) / rp or 9999
		local re = 0
		if (st.req or 0) > br then re = (rr > 0) and 60 * (st.req - br) / rr or 9999 end
		if pe > re + eai_num("Energy_GenNeedLead", 10) then return true, "unit" end
	end
	local T = EliteAI_T
	if type(T) == "table" and T.k ~= nil and (T.cost_pow or 0) > 0 and type(T.st) == "table" then
		local ts = T.st[T.k]
		if not (type(ts) == "table" and ts.started) then
			local left = math.max(0, (T.plan_tt or 0) - now)
			if bp + rp * left / 60 < T.cost_pow then return true, "tier" end
		end
	end
	local tier = cache.tech_tier_level or 1
	local floor = (tier >= 3) and eai_num("Energy_GenRateT3", 85) or ((tier >= 2) and eai_num("Energy_GenRateT2", 60) or eai_num("Energy_GenRateT1", 40))
	if rp < floor and bp < eai_num("Energy_GenNeedBank", 150) then return true, "rate" end
	return false, "no"
end
EliteAI_EnergyGenNeed = e_gen_need                                          -- the stub run
-- called before Elite's ResourceStructureDemand: the limits of the generators by the plan; returns the plan's cap, the
-- generators that stand, and those with the active tasks (nil = no plan)
local function e_gen_limits( now )
	local E = EliteAI_E
	local cap, why, tier = e_gen_plan( now )
	local have, tot = e_gen_have()
	if cap ~= nil then
		local base = eai_num("Energy_GenPlanBase", 2)
		if E.gen_raid_t ~= nil and now - E.gen_raid_t < eai_num("Energy_GenRaidSecs", 150) then base = 0 end
		local need, nwhy = e_gen_need( now )
		E.gen_need, E.gen_need_why = need, nwhy
		if not need and tot >= base and cap > tot then
			cap, why = tot, "need"
			E.n_gen_noneed = (E.n_gen_noneed or 0) + 1
		end
	end
	E.gen_cap, E.gen_have, E.gen_behind = cap, have, (cap ~= nil and tot < cap)
	if cap == nil or type(s_resource_structures) ~= "table" then return cap, have, tot end
	local l0 = nil
	for _, v in pairs(s_resource_structures) do
		if v and v.pbg and not e_is_secure( v ) and v.limit ~= nil then
			if v.eliteai_limit0 == nil then v.eliteai_limit0 = v.limit end     -- Elite's own, for the log
			l0 = v.eliteai_limit0
			v.limit = cap - tier + 3                                           -- strategy_resourcing.ai:194: count >= limit + tier - 3
		end
	end
	-- (0.10: the need moves the cap up and down between the ticks - a line per new value at most once in Energy_GenPlanLog, 20 s)
	if E.gen_cap_said ~= cap and (E.gen_cap_said == nil or now - (E.gen_cap_t or -1000) >= eai_num("Energy_GenPlanLog", 20)) then
		E.gen_cap_said, E.gen_cap_t = cap, now
		local pw = EliteAI and EliteAI.pw
		eai_log("ENERGY", "gen", "plan", "cap", cap, "by", why, "have", have, "with tasks", tot, "tier", tier, "t", math.floor(now),
			"Elite's cap", (l0 ~= nil) and (l0 + tier - 3) or "none", "army", (cache and cache.military_count) or -1,
			"nodes", e_node_count(), "free places", (type(pw) == "table" and pw.slots) or "?", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate),
			"need", tostring(E.gen_need_why or "-"))
	end
	return cap, have, tot
end
EliteAI_EnergyGenPlan = e_gen_plan                                          -- the stub run
local function e_gen_gate()
	local E, now = EliteAI_E, World_GetGameTime()
	local tasks = Task_CountInGroup( s_selfplayer, TGROUP_ResourceAddOns )
	-- 0.9: a generator request is never killed by Elite (TGROUP_ResourceAddOns is in no list of default.ai:140-156) and blocks
	-- the next one (strategy_resourcing.ai:169) and 100 req for as long as nobody builds it. One that has been inactive for
	-- Energy_GenTaskMax (60 s) is dropped as Elite drops the others (default.ai:205-216); the plan asks again.
	local tmax = eai_num("Energy_GenTaskMax", 60)
	if tasks > 0 and tmax > 0 then
		local act = Task_CountActiveInGroup( s_selfplayer, TGROUP_ResourceAddOns )
		if act < tasks then EliteAI.build_open = now end                      -- main.ai's order book: the squads at the node stay
		if act >= tasks then E.gen_task_t = nil
		elseif E.gen_task_t == nil then E.gen_task_t = now
		elseif now - E.gen_task_t >= tmax then
			local back = Task_CountGroupCost( s_selfplayer, TGROUP_ResourceAddOns, false )
			ai_budget:add_resources( back, "BUDGET_ResourceAddOn" )
			Task_KillInactiveTasksInGroup( s_selfplayer, TGROUP_ResourceAddOns )
			E.n_gen_stuck = (E.n_gen_stuck or 0) + 1
			eai_log("ENERGY", "gen", "task", "inactive for", math.floor(now - E.gen_task_t), "s (nobody builds it): dropped", "tasks", tasks, "active", act,
				"squads", (cache and cache.military_count) or -1, "bank", s_rp(cache.resources), "n", E.n_gen_stuck)
			E.gen_task_t = nil
			tasks = Task_CountInGroup( s_selfplayer, TGROUP_ResourceAddOns )
		end
	else E.gen_task_t = nil end
	local have = 0
	if type(s_resource_structures) == "table" then
		for _, v in pairs(s_resource_structures) do                          -- a sum: the order of pairs() does not matter
			if v and v.pbg then have = have + (PBG_GetCount( s_selfplayer, v.pbg ) or 0) end
		end
	end
	if E.gen_t ~= nil and now > E.gen_t then
		if tasks > 0 or have > (E.gen_n0 or 0) then E.gen_dead = 0
		else E.gen_dead, E.n_gen_dead = E.gen_dead + 1, E.n_gen_dead + 1 end
		E.gen_t = nil
	end
	E.gen_n = have
	if E.gen_book == nil then E.gen_book = have end
	if have > E.gen_book then
		E.gen_low_t = nil
		if E.gen_up_t == nil then E.gen_up_t, E.gen_up_min = now, have end
		if have < E.gen_up_min then E.gen_up_min = have end
		if now - E.gen_up_t >= eai_num("Energy_GenStand", 20) then
			local k = E.gen_up_min - E.gen_book
			local r, p = (E.gen_req or 0) > 0 and E.gen_req or eai_num("Energy_GenReq", 100), E.gen_pow or 0
			EliteAI_EnergyNote( "gen", { requisition = r * k, power = p * k }, k )
			E.gen_book, E.gen_up_t = E.gen_up_min, nil
			eai_log("buy_gen", math.floor(now), (r * k) .. "/" .. (p * k), "by", "stand", "generators", E.gen_book, "x" .. k)
		end
	else
		E.gen_up_t = nil
		if have < E.gen_book then
			if E.gen_low_t == nil then E.gen_low_t = now end
			if now - E.gen_low_t >= eai_num("Energy_GenLost", 45) then
				eai_log("ENERGY", "gen", "lost", "generators", E.gen_book, "->", have)
				E.gen_raid_t, E.n_gen_lost = now, (E.n_gen_lost or 0) + (E.gen_book - have)   -- 0.10: no rebuilding by the clock for Energy_GenRaidSecs (e_gen_limits)
				E.gen_book, E.gen_low_t = have, nil
			end
		else E.gen_low_t = nil end
	end
	if E.gen_dead >= eai_num("Energy_GenTries", 2) then
		E.gen_dead = 0
		E.gen_mute = now + eai_num("Energy_GenMute", 60)
		eai_log("ENERGY", "gen", "hold", "dead", "the last", eai_num("Energy_GenTries", 2), "requests died without a generator (nobody builds it): none for",
			eai_num("Energy_GenMute", 60), "s", "bank", s_rp(cache.resources), "requests", E.n_gen_req, "dead", E.n_gen_dead)
	end
	return now < E.gen_mute
end
EliteAI_EnergyGenGate = e_gen_gate                                          -- the stub run
-- after Elite's UpdateSquadDemand (strategy_addon_purchase.ai:71) filled s_addonDemand for one production type: the waits and
-- the multipliers of the new logic on the entries of that type (an entry set to false is skipped by HighestAddonDemand, :28)
-- 0.7 (TECH_RU.md 18.7; Orca's second match): "buy_addon ... wp_hive_venom_cannon 120/30" at 466, 613 and 659 s, "wp_hive_heavy_claw
-- 150/50" at 571, 641 and 1089 s - the hive tyrant's two weapons bought in turns, six purchases, 810 req and 240 power for one
-- weapon slot (an item of a slot replaces the one that is in it; Elite offers every item we do not hold - so the one just
-- replaced is on offer again). The slot of a commander's item by its name (Elite's attributes, upgrade/pvp/<race>/wargear:
-- wp_ / wp1_ / <race>_weapon_ = the weapon, arm_ / _arm_ / <race>_armor_ = the armour, acc_ / <race>_acc_ = the accessory; tau
-- names have no slot in them - no rule). One item per slot and match; an item that answers a class the Counter layer counters
-- may replace it once. Energy_WargearOnce=0 = as before. Line "ENERGY addon skip <item> why wargear_slot ... holds <item>".
local function e_wg_slot( name )
	if not string.find(name, "wargear", 1, true) then return nil end
	local short = string.gsub(name, "^.*[/\\]", "")
	if string.find(short, "^wp%d*_") or string.find(short, "_weapon_", 1, true) then return "weapon" end
	if string.find(short, "^arm%d*_") or string.find(short, "_arm_", 1, true) or string.find(short, "_armor_", 1, true) then return "armour" end
	if string.find(short, "^acc%d*_") or string.find(short, "_acc_", 1, true) then return "accessory" end
	return nil
end
EliteAI_EnergyWargearSlot = e_wg_slot                                       -- the stub run
local function e_addon_filter( PITEM_type )
	if s_addonDemand == nil or cache == nil or cache.resources == nil then return end
	local E, now, bank = EliteAI_E, World_GetGameTime(), cache.resources
	local float = EliteAI_EnergyFloat()
	local save = (type(EliteAI_R) == "table" and EliteAI_R.save == true)
	local rr, rp, pfloor = 0, 0, 0
	if type(EliteAI_TechEval) == "function" then EliteAI_TechEval() end      -- 0.2: the plan of this tick (this run comes before the tech budget's)
	if type(EliteAI_TechReserve) == "function" then rr, rp = EliteAI_TechReserve() end
	if type(EliteAI_TechPowerFloor) == "function" then pfloor = EliteAI_TechPowerFloor() or 0 end   -- 0.3: the power the T2 research will need
	rr, rp = rr or 0, rp or 0
	local gar = e_gar_active( now )
	local min_share, low_mult, share_k = eai_num("Energy_AddonMinShare", 0.15), eai_num("Energy_AddonLowMult", 0.25), eai_num("Energy_AddonShareK", 3)
	local cap, cap_why = e_share_cap()                                      -- 0.3: the army's share
	local army_r, add_r = e_spent()
	-- 0.6 (TECH_RU.md 18.3; Orca fb 529: the lascannon was never given against the dreadnought): an upgrade that answers a class
	-- the Counter layer has decided to counter is treated as the anti-garrison upgrades are - it does not wait for the unit, the
	-- upgrades' share of the army or the saved power (the tech reserve and a muted dead request still hold it) - and it is the
	-- first upgrade of this pass: its demand is lifted over the highest of the others (Elite asks for the highest only).
	-- Counter_AddonFirst=0 = the multiplier alone, as 0.5.
	local top, cfirst = 0, eai_num("Counter_AddonFirst", 1) >= 1 and eai_num("Counter_Buy", 1) >= 1 and type(EliteAI_MechCounterAddon) == "function"
	for pbg, dem in pairs(s_addonDemand) do                                 -- (a maximum: the order of pairs() does not matter)
		if pbg and dem ~= false and dem.pitem_type == PITEM_type and (dem.demand or 0) > top then top = dem.demand end
	end
	for pbg, dem in pairs(s_addonDemand) do                                 -- each entry on its own: the order of pairs() does not matter
		if pbg and dem ~= false and dem.pitem_type == PITEM_type then
			local cost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_type, pbg )   -- strategy_addon_purchase.ai:236
			local cr, cp = (cost and cost.requisition) or 0, (cost and cost.power) or 0
			local name = string.lower(PBG_GetName( pbg ) or "")
			local share = e_share( cost )
			local cm, ck = 1, nil
			if cfirst then cm, ck = EliteAI_MechCounterAddon( name ) end
			cm = cm or 1
			local ganti = gar and e_has(name, GAR_ADDON_KEYS)                     -- (against a garrison: step 19)
			-- 0.8 (TECH_RU.md 19.5; the polygon's scene a, r15: "addon first acc_hive_bioplasma class mhero ... bank 351" - 100 req at
			-- 18 s, the zoanthrope 360/40 that r11 bought at 29 s never came, "second unit within 90 s" failed): an upgrade that
			-- answers a class goes past the unit's wait - but not past a unit that is Counter_AddonUnitEta (30 s) of income away
			-- or has its money and waits for the HQ: that unit first, the upgrade right after it
			local unit_near = false
			if E.stall ~= nil and now - (E.stall.t or -1000) <= 7 and E.hold then
				unit_near = (E.stall.why ~= "money") or ((E.stall.eta or 999) <= eai_num("Counter_AddonUnitEta", 30))
			end
			local anti = ganti or (cfirst and cm > 1 and not unit_near)
			local why = nil
			local slot = (eai_num("Energy_WargearOnce", 1) >= 1) and e_wg_slot( name ) or nil
			local held = slot and E.wg and E.wg[slot] or nil
			if held ~= nil and not (cfirst and cm > 1 and not held.ctr) then why = "wargear_slot"   -- 0.7: the slot has its item
			elseif E.amute[name] ~= nil and now < E.amute[name] then why = "dead_mute"   -- 0.3: its last requests were killed as inactive
			elseif rr > 0 and (bank.requisition or 0) - cr < rr then why = "tech_reserve"
			elseif rp > 0 and cp > 0 and (bank.power or 0) - cp < rp then why = "tech_reserve"   -- 0.3: the reserve's power too
			elseif pfloor > 0 and cp > 0 and not anti and (bank.power or 0) - cp < pfloor then why = "t2_power"   -- 0.3: the power T2 will need
			elseif E.hold and not anti and (bank.requisition or 0) - cr < (E.hold_req or 0) then why = "unit_first"   -- only what would take the unit's req
			elseif cap < 1 and not anti and cr > 0 and (add_r + cr) > cap * (army_r + add_r + cr) then why = "share"   -- 0.3: over the upgrades' cap
			elseif float and save and share < min_share and not anti then why = "low_pow_save" end
			if why == "share" then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip, E.n_share_skip = E.n_addon_skip + 1, E.n_share_skip + 1
				e_say("skip|share", eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "skip", r_short(name), "why", "share", "cost", s_rp(cost), "bank", s_rp(bank),
					"upgrades", math.floor(add_r), "army", math.floor(army_r), "share", string.format("%.2f", (add_r + cr) / (army_r + add_r + cr)),
					"cap", string.format("%.2f", cap), "(" .. cap_why .. ")")
			elseif why == "t2_power" then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip, E.n_pow_skip = E.n_addon_skip + 1, (E.n_pow_skip or 0) + 1
				e_say("skip|t2_power", eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "skip", r_short(name), "why", "t2_power", "cost", s_rp(cost), "bank", s_rp(bank),
					"the T2 research needs", math.floor(pfloor), "power in the bank now")
			elseif why == "wargear_slot" then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip, E.n_wg_skip = E.n_addon_skip + 1, (E.n_wg_skip or 0) + 1
				e_say("skip|wg|" .. name, eai_num("Energy_LogSecs", 30) * 4, "ENERGY", "addon", "skip", r_short(name), "why", "wargear_slot", "cost", s_rp(cost),
					"the", slot, "slot holds", r_short(held.name), "bought at", math.floor(held.t), "s")
			elseif why then
				s_addonDemand[ pbg ] = false
				E.n_addon_skip = E.n_addon_skip + 1
				e_say("skip|" .. why .. "|" .. name, eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "skip", r_short(name), "why", why,
					"cost", s_rp(cost), "bank", s_rp(bank), "reserve", rr, "demand", string.format("%.1f", dem.demand or 0))
			else
				local m = 1
				if ganti then m = m * eai_num("Gar_AddonMult", 3) end
				-- 0.5: an upgrade that answers a class of the enemy's army the Counter layer counters (flamers, plasma, melta ... by name)
				if not cfirst and type(EliteAI_MechCounterAddon) == "function" and eai_num("Counter_Buy", 1) >= 1 then
					cm = EliteAI_MechCounterAddon( name ) or 1
				end
				if cm ~= 1 then m = m * cm; E.n_counter = (E.n_counter or 0) + 1 end
				if float then
					if share >= min_share then m = m * (1 + share_k * share)
					elseif not anti then m = m * low_mult end
				end
				if m ~= 1 and (dem.demand or 0) > 0 then
					dem.demand = dem.demand * m
					if m > 1 then E.n_addon_boost = E.n_addon_boost + 1 end
					if cfirst and cm > 1 and dem.demand <= top * 1.1 then
						dem.demand = top * 1.1 + 1
						e_say("counter_first|" .. name, eai_num("Energy_LogSecs", 30), "ENERGY", "addon", "first", r_short(name), "class", tostring(ck),
							"demand", string.format("%.1f", dem.demand), "over the highest", string.format("%.1f", top), "cost", s_rp(cost), "bank", s_rp(bank))
					end
					if ganti then
						e_say("gar_addon|" .. name, eai_num("Gar_LogSecs", 30), "GAR", "addon", r_short(name), "x" .. tostring(m), "garrison", tostring(EliteAI.gar.id))
					end
				end
			end
		end
	end
end
-- 0.3 (TECH_RU.md 12; s15: "buy_addon tyr_endless_swarm" 19 times in 75 s with a growing bank, "..execute_3" 8 times). The
-- line was written when the request was PLACED. A request is a task; one the squad cannot start stays inactive, is killed at
-- the next purchase tick (default.ai:201-217 Purchase_KillInActiveBudgetTasks, :249) and - still the highest demand - placed
-- again. Every round it took its cost off what each budget may spend (util/budget.ai:271) for the units run of that tick
-- ("tasks 50/15" in the SPEND stall lines), it was the one request of the addon budget in that pass (strategy_addon_purchase
-- asks for the highest demand only: nothing else of that run was bought), and the book counted it as money spent.
-- Now a request gets its verdict at the next addon tick, after the engine killed the inactive ones: BOUGHT when its task is
-- active (Task_CountActivePBG, strategy_tech_purchase.ai:226), the player has one more of the upgrade (PBG_GetCount,
-- strategy_addon_purchase.ai:119), it is no longer on offer, or the req bank is below what it was at the request; else DEAD.
-- "buy_addon" and the book note the bought ones only (the line keeps the time and the bank of the request and says "by
-- task|count|gone|bank"). Energy_AddonDeadTries (2) dead requests of one upgrade in a row = none for Energy_AddonDeadMute
-- (60 s), then one try at a time: line "ENERGY addon dead ...", the filter's "dead_mute". Between ticks: names and numbers;
-- the PBG is looked up again by its name among the production items of the tick.
local function e_addon_pbg( name )
	for _, pt in ipairs({ PITEM_Upgrade, PITEM_SquadUpgrade }) do
		local n = AIProduction_GetProductionItemCount( s_selfplayer, pt )     -- strategy_addon_purchase.ai:103
		for i = 0, n - 1 do
			local pbg = AIProduction_GetProductionItemAt( s_selfplayer, pt, i )   -- strategy_addon_purchase.ai:105
			if pbg ~= nil and string.lower(PBG_GetName( pbg ) or "") == name then return pbg end
		end
	end
	return nil
end
local function e_addon_settle()
	local E, now = EliteAI_E, World_GetGameTime()
	if table.getn(E.areq) == 0 or cache == nil or cache.resources == nil then return end
	local keep = {}
	local bank_req = cache.resources.requisition or 0
	local tries, mute = eai_num("Energy_AddonDeadTries", 2), eai_num("Energy_AddonDeadMute", 60)
	for _, q in ipairs(E.areq) do
		if q.t >= now then
			table.insert(keep, q)                                           -- placed in this very tick (the budget loop re-runs)
		else
			local by = nil
			local pbg = e_addon_pbg( q.name )
			if pbg == nil then by = "gone"                                  -- not on offer any more: it was taken
			elseif Task_CountActivePBG( s_selfplayer, pbg, true ) > 0 then by = "task"
			elseif (PBG_GetCount( s_selfplayer, pbg ) or 0) > q.cnt then by = "count"
			elseif q.r > 0 and bank_req < q.bank then by = "bank" end
			if by then
				E.abought[q.name] = (E.abought[q.name] or 0) + 1
				local wslot = e_wg_slot( q.name )                                 -- 0.7: the commander's slot has its item now
				if wslot ~= nil then
					E.wg = E.wg or {}
					local ctr = type(EliteAI_MechCounterAddon) == "function" and (EliteAI_MechCounterAddon( q.name ) or 1) > 1
					E.wg[wslot] = { name = q.name, t = q.gt or 0, ctr = ctr or (E.wg[wslot] ~= nil and E.wg[wslot].ctr) or false }
				end
				E.adead[q.name] = nil
				EliteAI_EnergyNote( "addon", { requisition = q.r, power = q.p } )
				if type(EliteAI_MechAddonBought) == "function" then EliteAI_MechAddonBought( q.name ) end   -- 0.6: its carriers shoot vehicles first
				eai_log("buy_addon", q.gt, q.short, q.r .. "/" .. q.p, "bank", q.bank_s, "float", q.float, "share", string.format("%.2f", q.share), "by", by)
			else
				E.n_addon_dead = E.n_addon_dead + 1
				local n = (E.adead[q.name] or 0) + 1
				if n >= tries then
					E.amute[q.name] = now + mute
					E.adead[q.name] = tries - 1                                -- after the mute: one try at a time
					eai_log("ENERGY", "addon", "dead", q.short, q.r .. "/" .. q.p, "killed as inactive", n, "in a row (the squad cannot start it): none for", mute, "s",
						"bank", s_rp(cache.resources), "requests", E.n_addon_req, "dead", E.n_addon_dead)
				else
					E.adead[q.name] = n
				end
			end
		end
	end
	E.areq = keep
end
EliteAI_EnergyAddonSettle = e_addon_settle                                  -- the stub run
function EliteAI_EnergyNoteAddon( cost )                                    -- the addon budget placed a request: which upgrade it was
	if not s_on() then return end
	local E = EliteAI_E
	local name, short, cnt = "?", "?", 0
	if type(HighestAddonDemand) == "function" then
		local pbg = HighestAddonDemand()                                    -- strategy_addon_purchase.ai:22: the table of this tick is unchanged
		if pbg then
			name = string.lower(PBG_GetName( pbg ) or "?")
			short = r_short(name)
			cnt = PBG_GetCount( s_selfplayer, pbg ) or 0
		end
	end
	E.n_addon, E.n_addon_req = E.n_addon + 1, E.n_addon_req + 1
	table.insert(E.areq, { name = name, short = short, r = (cost and cost.requisition) or 0, p = (cost and cost.power) or 0,
		t = World_GetGameTime(), gt = eai_time(), cnt = cnt, float = E.float and 1 or 0, share = e_share(cost),
		bank = (cache and cache.resources and cache.resources.requisition) or 0, bank_s = s_rp(cache and cache.resources) })
end
-- 0.9 (TECH_RU.md 21.13) A SPAWN REQUEST IS NOT A PURCHASE. s27b, orks: "buy 491 / 494 / 498 / 501 / 505 / 508 / 512 ...
-- ork_deff_dread" with the bank growing 266 -> 385 and one dread on the field; then seven "ork_looted_tank" at pop 91-97 of 100
-- and none built; IG: five manticores and five chimeras in 28 s. The line was written and the cost booked ("unit Nx" of ENERGY
-- stats, EliteAI_UnitBuys, the idle clock of the watchdog, the drought clock of the upgrades' arbiter, the end of the save
-- state of the reinforcements, the plan's claim dropped - the upgrades took the bank at 512 s) when the request was PLACED. A
-- request the engine does not start stays inactive, Elite kills it at the next purchase tick (default.ai Purchase_KillInActive
-- BudgetTasks) and - still the first choice - it is placed again. Three causes were found: the money the engine holds for the
-- node a squad walks to (EliteAI_EnergyWalk), no room in the population for THIS squad (PopMargin is 8, a looted tank needs
-- more) and whatever else makes AIProduction_CanProduceNow false. Now, as the upgrades since 0.3 (e_addon_settle):
--  * every spawn request of the two places that ask (TryPurchaseUnitChoice, the watchdog) is noted with the bank and the count
--    of that moment and gets its verdict at the next purchase tick, after Elite's kill: BOUGHT when its task is active
--    (Task_CountActivePBG( .., true ), count_util.ai:25), the player has one more squad of the blueprint (PBG_GetCount), or the
--    req bank is below "then + income - Unit_PaidK (0.9) of the price"; else DEAD.
--  * "buy <t> <sbps> army N tier N [spend [over_lock]] by task|count|bank" (the time of the request) and everything that
--    counts a purchase - for the bought ones only. A dead one: "buy_dead <t> <sbps> R/P bank then -> now pop c/m now 0|1 walk R
--    n N none for S s dead D of Q" - the blueprint is no candidate for Unit_DeadMute (12 s, doubled per dead request in a row
--    up to Unit_DeadMuteMax 60; EliteAI_PurchaseMult returns 0, so Elite's demand, the plan and the watchdog pass it over),
--    and no spawn at all is asked for Unit_DeadPause (5 s per dead request in a row, up to Unit_DeadPauseMax 20).
--  * a blueprint the bank can pay and the engine cannot start now is not asked for (Unit_NowOnly): "SPEND notnow ...", no
--    candidate for Unit_NotNowMute (15 s), nothing locked and no claim left for it (the upgrades are not held for a unit
--    that cannot come).
-- Between ticks: names and numbers; the PBG is looked up again by its name in the buildable list of the tick.
local function u_pbg( name )
	local n = AIProduction_GetBuildableSquadCount( s_selfplayer )
	for i = 0, n - 1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
		if pbg ~= nil and string.lower(PBG_GetName( pbg ) or "") == name then return pbg end
	end
	return nil
end
function EliteAI_UnitNoteRequest( pbg, name, cost, src, now_ok )
	if not s_on() or pbg == nil or cost == nil then return end
	local E, now = EliteAI_E, World_GetGameTime()
	local bank = cache and cache.resources
	local r, p = cost.requisition or 0, cost.power or 0
	E.n_unit_req = E.n_unit_req + 1
	table.insert(E.ureq, { name = name, short = r_short(name), r = r, p = p, t = now, gt = eai_time(), src = src or "", now_ok = now_ok and 1 or 0,
		cnt = PBG_GetCount( s_selfplayer, pbg ) or 0, bank = (bank and bank.requisition) or 0, bank_s = s_rp(bank),
		army = (cache and cache.military_count) or -1, tier = EliteAI_P.tier_seen[name] or (cache and cache.tech_tier_level) or -1 })
	EliteAI_EnergyPay( "unit", r, p )                                       -- the "asked" half of the book (the tracer of the bank's falls)
end
local function u_settle( now )
	local E, S = EliteAI_E, EliteAI_S
	if E.ureq == nil or table.getn(E.ureq) == 0 or cache == nil or cache.resources == nil then return end
	local keep = {}
	local br = cache.resources.requisition or 0
	local rr = (cache.resources_rate and cache.resources_rate.requisition) or 0   -- per minute (cache.ai:156)
	for _, q in ipairs(E.ureq) do
		if q.t >= now then
			table.insert(keep, q)                                           -- placed in this very tick (the budget loop re-runs)
		else
			local by = nil
			local pbg = u_pbg( q.name )
			if pbg ~= nil and Task_CountActivePBG( s_selfplayer, pbg, true ) > 0 then by = "task"
			elseif pbg ~= nil and (PBG_GetCount( s_selfplayer, pbg ) or 0) > q.cnt then by = "count"
			elseif q.r > 0 and br <= q.bank + rr * (now - q.t) / 60 - q.r * eai_num("Unit_PaidK", 0.9) then by = "bank" end
			if by then
				E.udead[q.name], E.udead_t[q.name], E.umute[q.name], E.gdead, E.upause = nil, nil, nil, 0, -1
				local cost = { requisition = q.r, power = q.p }
				EliteAI_EnergyNote( "unit", cost, 1, true )                     -- energy: the book of purchases (asked for at the request)
				S.last_buy, S.n_buy = q.gt, S.n_buy + 1                         -- spend: a spawn resets the idle clock
				if q.src ~= "" then S.bought_hot = S.bought_hot + 1 end
				EliteAI_ReinforceNoteBuy( q.name, cost, now )                   -- reinf: a power unit ends the save state
				E.stall = nil                                                   -- a unit is bought - the plan's claim starts anew
				if q.src ~= "" then eai_log("buy", q.gt, q.name, "army", q.army, "tier", q.tier, q.src, "by", by)
				else eai_log("buy", q.gt, q.name, "army", q.army, "tier", q.tier, "by", by) end
			else
				E.n_unit_dead, E.gdead = E.n_unit_dead + 1, (E.gdead or 0) + 1
				local n = (E.udead[q.name] or 0) + 1
				if E.udead_t[q.name] ~= nil and now - E.udead_t[q.name] > eai_num("Unit_DeadForget", 120) then n = 1 end
				E.udead[q.name], E.udead_t[q.name] = n, now
				local mute = math.min(eai_num("Unit_DeadMuteMax", 60), eai_num("Unit_DeadMute", 12) * 2 ^ (n - 1))
				E.umute[q.name] = now + mute
				E.upause = now + math.min(eai_num("Unit_DeadPauseMax", 20), eai_num("Unit_DeadPause", 5) * E.gdead)
				eai_log("buy_dead", q.gt, q.name, q.r .. "/" .. q.p, "bank", q.bank_s, "->", s_rp(cache.resources),
					"pop", (cache.current_population_personnel or -1) .. "/" .. (cache.max_population_personnel or -1), "now", q.now_ok, "walk", E.walk_req or 0,
					"n", n, "none for", mute, "s", "dead", E.n_unit_dead, "of", E.n_unit_req, q.src)
			end
		end
	end
	E.ureq = keep
end
EliteAI_UnitSettle = u_settle                                               -- the stub run
function EliteAI_UnitMuted( name )                                          -- EliteAI_PurchaseMult: no candidate while its mute lasts
	local E = EliteAI_E
	local m = E and E.umute and E.umute[name]
	if m == nil or not s_on() then return false end
	if World_GetGameTime() >= m then E.umute[name] = nil; return false end
	E.n_unit_mute = (E.n_unit_mute or 0) + 1
	return true
end
function EliteAI_UnitPause( now )                                           -- no spawn request at all after the dead ones
	local E = EliteAI_E
	return s_on() and E ~= nil and now < (E.upause or -1)
end
function EliteAI_UnitNotNow( pbg, cost )                                    -- TryPurchaseUnitChoice: the bank pays, the engine cannot start it now
	if not s_on() or pbg == nil then return end
	local E, now = EliteAI_E, World_GetGameTime()
	local name = string.lower(PBG_GetName( pbg ) or "")
	local short, mute = r_short(name), eai_num("Unit_NotNowMute", 15)
	E.n_unit_notnow = E.n_unit_notnow + 1
	E.umute[name] = now + mute
	if E.stall ~= nil and E.stall.name == short then E.stall, E.hold_req = nil, 0 end   -- nothing waits for a unit that cannot come
	e_say("notnow|" .. name, 30, "SPEND", "notnow", short, s_rp(cost), "bank", s_rp(cache and cache.resources),
		"pop", ((cache and cache.current_population_personnel) or -1) .. "/" .. ((cache and cache.max_population_personnel) or -1),
		"walk", E.walk_req or 0, "the engine cannot start it now: none for", mute, "s", "n", E.n_unit_notnow)
end
-- 0.9 (TECH_RU.md 21.13): Elite's choice among the entries within the variance is by a random start (ChooseBestAvailableUnitFromList)
-- - a spawn the layers did not ask for steps back for the best ANSWER (Counter / Setup / Garrison, EliteAI_P.ans of this tick)
-- among the same entries whose producer is free. `choices` is sorted by demand (util/demand.ai:61). Unit_AnswerFirst=0 = off.
function EliteAI_AnswerChoice( choices, best )
	local P = EliteAI_P
	if not s_on() or eai_num("Unit_AnswerFirst", 1) < 1 or type(choices) ~= "table" or best == nil or P == nil or P.ans == nil then return best end
	if best[3] ~= PURCHASETYPE_SPAWN or best[1] == nil then return best end
	local bname = string.lower(PBG_GetName( best[1] ) or "")
	if P.ans[bname] == true then return best end
	for i = 1, table.getn(choices) do
		local c = choices[i]
		if c ~= nil and c[3] == PURCHASETYPE_SPAWN and c[1] ~= nil then
			local n = string.lower(PBG_GetName( c[1] ) or "")
			if P.ans[n] == true and PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, c[1] ) == 0 then
				EliteAI_E.n_ans_choice = (EliteAI_E.n_ans_choice or 0) + 1
				e_say("ans_choice|" .. n, 30, "SPEND", "answer_first", r_short(n), "over", r_short(bname), "among", table.getn(choices), "choices", "n", EliteAI_E.n_ans_choice)
				return c
			end
		end
	end
	return best
end
-- 0.5 (TECH_RU.md 17.3) REQ THAT LEFT THE BANK AND IS IN NO BOOK. s20, IG, 3:36-3:45: the bank fell from 266 to 36 req, "ENERGY
-- stats ... spent60 []" - no line says who took 230 req while ig_devils (350) had been waited for for 129 s. The watch: a
-- sample per purchase tick { time, bank req, the book's total req, the income so far }; over Spend_LeakSecs (30 s) the bank
-- should be "then + income - booked". More than Spend_LeakMin (150) req missing = a line "SPEND unbooked ..." with what the
-- engine has in its tasks now (Task_CountCost, as the stall line) - once per window. Numbers only; nothing is decided by it.
-- (A purchase is booked when it is PAID FOR / has come - a reinforcement by the model, a generator by the request that
-- survived: a line right before such a booking is that purchase, the next ENERGY stats shows it.)
-- 0.7: THE TRACER. Between two purchase ticks the bank should be "then + income"; a fall of Spend_DropMin (60) req or
-- Spend_DropMinPow (12) power below that is a payment. The requests of the last Spend_DropLag (25 s) that no earlier fall has
-- taken explain it (each request once, the oldest first); what they do not explain by Spend_DropTol (25 req / 8 power) is named with its exact
-- price - "SPEND drop t N req -R pow -P in D s unknown -U/-V | asked: <kind R/P age> ..." (a price is a signature: 75/15 is
-- an upgrade, 66/7 a ravener model, 100/0 a generator). Numbers only; nothing is decided by it. Spend_DropMin=0 = off.
local function e_drop( now, req, pow )
	local E = EliteAI_E
	local dmin, dminp = eai_num("Spend_DropMin", 60), eai_num("Spend_DropMinPow", 12)
	local D = E.drop
	local rr = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local rp = (cache.resources_rate and cache.resources_rate.power) or 0
	if D == nil or dmin <= 0 or now - D.t > 15 or now <= D.t then E.drop = { t = now, req = req, pow = pow }; return end
	local dt = now - D.t
	local fr, fp = D.req + rr * dt / 60 - req, D.pow + rp * dt / 60 - pow
	E.drop = { t = now, req = req, pow = pow }
	local lag, keep, asked, ar, ap = eai_num("Spend_DropLag", 25), {}, {}, 0, 0
	local tol, tolp = eai_num("Spend_DropTol", 25), eai_num("Spend_DropTolPow", 8)
	-- every fall, small ones too, takes the requests it can pay for (the oldest first; a request is taken once): a request that
	-- was paid by a small fall must not explain a later one
	for _, q in ipairs(E.pay or {}) do
		if now - q.t <= lag then
			if not q.used and q.r <= fr - ar + tol and q.p <= fp - ap + tolp then
				q.used = true
				ar, ap = ar + q.r, ap + q.p
				table.insert(asked, string.format("%s %d/%d %ds", q.k, q.r, q.p, now - q.t))
			end
			table.insert(keep, q)
		end
	end
	E.pay = keep
	if not (fr >= dmin or fp >= dminp) then return end
	local ur, up = fr - ar, fp - ap
	if ur >= tol or up >= tolp then
		E.n_drop = (E.n_drop or 0) + 1
		E.drop_req = (E.drop_req or 0) + math.max(ur, 0)
		eai_log("SPEND", "drop", "t", math.floor(now), "req", string.format("%d", -math.floor(fr)), "pow", string.format("%d", -math.floor(fp)), "in", math.floor(dt), "s",
			"unknown", string.format("%d/%d", -math.floor(math.max(ur, 0)), -math.floor(math.max(up, 0))),
			"| asked:", (table.getn(asked) > 0) and table.concat(asked, ", ") or "nothing", "| bank", math.floor(req) .. "/" .. math.floor(pow),
			"tasks", s_rp(Task_CountCost( s_selfplayer, false )), "n", E.n_drop, "sum", math.floor(E.drop_req))
	end
end
local function e_leak( now )
	local E = EliteAI_E
	local win, min = eai_num("Spend_LeakSecs", 30), eai_num("Spend_LeakMin", 150)
	local req = cache.resources.requisition or 0
	e_drop( now, req, cache.resources.power or 0 )
	if min <= 0 then return end
	local rate = (cache.resources_rate and cache.resources_rate.requisition) or 0
	local booked = 0
	for _, k in ipairs(E_KINDS) do local tt = E.tot[k]; if tt then booked = booked + tt.r end end
	local L = E.leak
	if L == nil then L = { s = {}, inc = 0, t = now, said = -1000 }; E.leak = L end
	L.inc = L.inc + rate * math.max(now - L.t, 0) / 60                       -- (the rate is per minute)
	L.t = now
	table.insert(L.s, { t = now, req = req, booked = booked, inc = L.inc })
	-- 0.7: the samples of the window AND of Spend_LeakLag (10 s) before it are kept: what was booked up to that long before the
	-- window counts as paid in it (a research asked 3 s before the window is paid inside it)
	local lag = eai_num("Spend_LeakLag", 10)
	while table.getn(L.s) > 1 and now - L.s[2].t >= win + lag do table.remove(L.s, 1) end
	local a, b0 = nil, L.s[1]
	for _, q in ipairs(L.s) do if now - q.t <= win then a = q; break end end   -- the first sample inside the window
	if a == nil or now - a.t < win * 0.8 then return end
	local income, spent = L.inc - a.inc, booked - b0.booked
	local missing = a.req + income - spent - req
	if missing >= min and now - L.said >= win then
		L.said = now
		E.n_leak = (E.n_leak or 0) + 1
		eai_log("SPEND", "unbooked", "t", math.floor(now), "req", -math.floor(missing), "in", math.floor(now - a.t), "s: bank", math.floor(a.req), "->", math.floor(req),
			"income", math.floor(income), "booked", math.floor(spent), "tasks", s_rp(Task_CountCost( s_selfplayer, false )), "tech_reserve", E.res_req or 0,
			"secure_pending", E.sec_pending or 0, "addon_pending", table.getn(E.areq or {}), "n", E.n_leak)
	end
end
-- every purchase tick, first pass of the budget loop (do_purchase): the float state, the arbiter, the stats line
function EliteAI_EnergyTick( purchase_count )
	if not s_on() or cache == nil or cache.resources == nil or purchase_count ~= 0 then return end
	local E, now = EliteAI_E, World_GetGameTime()
	EliteAI_EnergyFloat()
	u_settle( now )                                                         -- 0.9: the spawn requests of the earlier ticks - bought or dead
	e_hold_tick( now )
	e_leak( now )
	E.gar_on = e_gar_active( now )
	if now - E.last_stats < eai_num("Energy_StatsSecs", 60) then return end
	E.last_stats = now
	local last60, total = e_book( now )
	eai_log("ENERGY", "stats", "t", math.floor(now), "float", E.float and "on" or "off", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate),
		"spent60", "[" .. last60 .. "]", "total", "[" .. total .. "]", "addon_skip", E.n_addon_skip, "addon_boost", E.n_addon_boost, "gen_hold", E.n_gen_skip,
		"unit_first", E.hold and "on" or "off", "rule", e_rule(), "gar_demand", E.n_gar,
		"unit_first_sw", E.n_hold_sw, "reserve_skip", E.n_res_skip, "secure_req", E.n_sec_req, "secure_dead", E.n_sec_dead, "secure_hold", E.n_sec_hold, "secure_none", E.n_sec_none or 0,
		"addon_req", E.n_addon_req, "addon_dead", E.n_addon_dead,
		"addon_share", string.format("%.2f", e_addon_share()), "cap", string.format("%.2f", (e_share_cap())), "(" .. tostring(E.cap_why) .. ")",
		"share_skip", E.n_share_skip, "unit_kept", E.n_hold_keep, "t2_power_skip", E.n_pow_skip or 0,
		"gen_req", E.n_gen_req, "gen_dead", E.n_gen_dead, "dry", E.n_dry or 0, "wargear_skip", E.n_wg_skip or 0, "unbooked", E.n_leak or 0, "drops", E.n_drop or 0, "drop_req", math.floor(E.drop_req or 0), "counter_demand", E.n_counter or 0,
		"gens", E.gen_have or 0, "gen_cap", E.gen_cap or "-", "gen_stuck", E.n_gen_stuck or 0, "nodes", e_node_count(),
		"tempo", math.floor(E.tempo_pop or 0) .. "/" .. math.floor(E.tempo_target or 0), "tempo_state", E.tempo and "behind" or "ok", "tempo_ticks", E.n_tempo or 0,
		"gen_need", tostring(E.gen_need_why or "-"), "gen_noneed", E.n_gen_noneed or 0, "node_noneed", E.n_sec_noneed or 0, "gen_lost", E.n_gen_lost or 0,
		"ans_first", E.n_ans_first or 0, "pop", (cache.current_population_personnel or -1) .. "/" .. (cache.max_population_personnel or -1),
		"unit_req", E.n_unit_req or 0, "unit_dead", E.n_unit_dead or 0, "unit_notnow", E.n_unit_notnow or 0, "unit_mute", E.n_unit_mute or 0,
		"node_walk", E.n_walk or 0, "walk_now", E.walk_req or 0, "ans_choice", E.n_ans_choice or 0)
end
-- once per (re)initialisation, new logic only: the wrappers around Elite's functions that are loaded after this file
-- (strategy_addon_purchase.ai) and the purchase callbacks of the budgets of the other run
local function e_install()
	e_reset()
	if type(UpdateSquadDemand) == "function" and not EliteAI_EnergyAddonWrapped then
		EliteAI_EnergyAddonWrapped = true
		local Elite_UpdateSquadDemand = UpdateSquadDemand
		UpdateSquadDemand = function( PITEM_type )
			Elite_UpdateSquadDemand( PITEM_type )
			if s_on() and eai_num("Energy_Addons", 1) >= 1 then e_addon_filter( PITEM_type ) end
		end
	end
	if type(ResourceStructureDemand) == "function" and not EliteAI_EnergyGenWrapped then
		EliteAI_EnergyGenWrapped = true
		local Elite_ResourceStructureDemand = ResourceStructureDemand        -- strategy_resourcing.ai:151
		ResourceStructureDemand = function()
			if not s_on() then return Elite_ResourceStructureDemand() end
			local cap, have = e_gen_limits( World_GetGameTime() )              -- 0.9: the plan's limits before Elite's rule reads them
			if eai_num("Energy_GenHold", 1) >= 1 and EliteAI_EnergyFloat()
				and not (cap ~= nil and EliteAI_E.gen_behind and have < eai_num("Energy_GenFloor", 4)) then
				EliteAI_E.n_gen_skip = EliteAI_E.n_gen_skip + 1
				e_say("gen", 60, "ENERGY", "gen", "hold", "bank", s_rp(cache.resources), "rate", s_rp(cache.resources_rate), "have", have, "cap", cap or "-")
				return
			end
			return Elite_ResourceStructureDemand()
		end
	end
	local bl = ai_budget and ai_budget.budget_list
	if type(bl) == "table" then
		for _, d in ipairs({ { "BUDGET_AddOn", "addon" }, { "BUDGET_ResourceAddOn", "gen" }, { "BUDGET_Secure", "secure" } }) do
			local b, kind = bl[d[1]], d[2]
			if type(b) == "table" and type(b.purchase_func) == "function" and not b.eliteai_noted then
				b.eliteai_noted = true
				local Elite_purchase = b.purchase_func
				b.purchase_func = function( availableResources, purchase_count )
					if not s_on() then return Elite_purchase( availableResources, purchase_count ) end
					local E = EliteAI_E
					if kind == "secure" and e_secure_gate() then return false end
					if kind == "gen" and e_gen_gate() then return false end   -- 0.4: the request of the last tick - bought or dead
					if kind == "addon" then e_addon_settle() end            -- 0.3: the requests of the earlier ticks - bought or killed
					-- the upgrades have their own filter per item (e_addon_filter); Secure and the generators get the cut bank
					local avail = availableResources
					-- 0.9: a generator the plan is behind with and a node on a power point that has none are not cut by the unit the
					-- upgrades wait for (100 / 125 req against 300-400: the unit waited for the whole match and so did they -
					-- "reserve_skip 34"); the tech plan's reserve still holds
					if kind == "gen" then e_gen_limits( World_GetGameTime() ) end   -- the plan of this tick (E.gen_behind)
					local first = (kind == "gen" and E.gen_behind == true and eai_num("Energy_GenFirst", 1) >= 1)
						or (kind == "secure" and E.sec_first == true and eai_num("Energy_SecureFirst", 1) >= 1)
					-- 0.10 (TECH_RU.md 21.2; the polygon's scene b_garrison, r19: "SPEND stall ig_devils 350/35 why money" for 168 s while
					-- generators were asked for at 92 / 116 / 183 s - the answer to the garrison was never bought): a generator / a node
					-- is not ahead of an ANSWER (a unit the Counter / Setup / Garrison layers ask for) that waits for its req - unless
					-- the power is what that unit lacks ("need unit")
					if first and kind ~= "addon" and eai_num("Energy_AnswerFirst", 1) >= 1 then
						local st, tnow = E.stall, World_GetGameTime()
						if st ~= nil and tnow - (st.t or -1000) <= 7 and st.ans == true and st.why == "money" then
							local _, nwhy = EliteAI_EnergyGenNeed( tnow )
							if nwhy ~= "unit" then
								first = false
								E.n_ans_first = (E.n_ans_first or 0) + 1
								e_say("ans_first|" .. kind, 30, "ENERGY", kind, "after", "the answer", tostring(st.name), s_rp({ requisition = st.req, power = st.pow }), "waits for its req: not ahead of it",
									"bank", s_rp(cache.resources), "hold", E.hold and 1 or 0)
							end
						end
					end
					if kind ~= "addon" then avail = e_reserved( availableResources, not first ) end
					local ok, cost = Elite_purchase( avail, purchase_count )
					if ok and cost then
						if kind == "addon" then EliteAI_EnergyNoteAddon( cost ); EliteAI_EnergyPay( "addon", cost.requisition, cost.power )
						elseif kind == "secure" then
							E.sec_t, E.sec_req, E.sec_pow = World_GetGameTime(), cost.requisition or 0, cost.power or 0   -- noted when it survives (e_secure_gate)
							E.sec_n0, E.sec_nodes0 = (cache and cache.total_pts_secured) or 0, e_node_count()   -- 0.9: the verdict's start
							eai_log("ENERGY", "secure", "req", "t", math.floor(E.sec_t), "bank", s_rp(cache.resources), "nodes", E.sec_nodes0, "secured", E.sec_n0,
								"power points ours", (type(EliteAI.pw) == "table" and EliteAI.pw.own) or "?", "without a node", (type(EliteAI.pw) == "table" and EliteAI.pw.unsec) or "?", "first", first and 1 or 0)
							EliteAI.build_req_t = E.sec_t                           -- 0.8: main.ai's builder wait (the order book)
							EliteAI_EnergyPay( "secure", cost.requisition, cost.power )
							E.n_sec_req = E.n_sec_req + 1
						else
							E.gen_t, E.gen_req, E.gen_pow = World_GetGameTime(), cost.requisition or 0, cost.power or 0   -- 0.4: its verdict at the next tick (e_gen_gate)
							E.gen_n0 = E.gen_n or 0                                 -- 0.5: the generators at the moment of the request
							eai_log("ENERGY", "gen", "req", "t", math.floor(E.gen_t), "bank", s_rp(cache.resources), "have", E.gen_have or "?", "cap", E.gen_cap or "-",
								"free places", (type(EliteAI.pw) == "table" and EliteAI.pw.slots) or "?", "first", first and 1 or 0)
							EliteAI.build_req_t = E.gen_t                           -- 0.8: main.ai's builder wait (the order book)
							EliteAI_EnergyPay( "gen", cost.requisition, cost.power )
							E.n_gen_req = E.n_gen_req + 1
						end
					elseif not ok and cost and avail ~= availableResources and ResourceAmount_Has( availableResources, cost ) then
						-- held back by a reserve of ours alone: nothing is locked for the budgets after this one
						E.n_res_skip = E.n_res_skip + 1
						e_say("res_skip|" .. kind, eai_num("Energy_LogSecs", 30), "ENERGY", "reserve", "skip", kind, s_rp(cost), "bank", s_rp(cache.resources),
							"tech_reserve", (E.res_req or 0) .. "/" .. (E.res_pow or 0), "unit_first", E.hold and E.hold_req or 0)
						return false
					end
					return ok, cost
				end
			end
		end
	end
	eai_log("ENERGY", "init", "version", EliteAI_ENERGY_VERSION, "float_pow", eai_num("Energy_FloatPow", eai_num("Spend_BankPow", 300)),
		"float_ratio", eai_num("Energy_FloatRatio", 1.5), "exit_k", eai_num("Energy_ExitK", 0.6), "eta_max", eai_num("Energy_EtaMax", 120),
		"share_k", eai_num("Energy_ShareK", 2), "addon_min_share", eai_num("Energy_AddonMinShare", 0.15), "addon_low_mult", eai_num("Energy_AddonLowMult", 0.25),
		"addon_share_k", eai_num("Energy_AddonShareK", 3), "gen_hold", eai_num("Energy_GenHold", 1), "Conf_AddonVsUnit", e_rule(),
		"gar_buy", eai_num("Gar_BuySecs", 25) .. "/" .. eai_num("Gar_BuyMult", 2.5) .. "/" .. eai_num("Gar_AddonMult", 3),
		"wrapped", (EliteAI_EnergyAddonWrapped and "addon" or "-") .. "," .. (EliteAI_EnergyGenWrapped and "gen" or "-"),
		"unit_first_hold", eai_num("Spend_UnitFirstHold", 20), "off_k", eai_num("Spend_UnitFirstOffK", 1.5),
		"secure", eai_num("Energy_SecureMax", 1) .. "/" .. eai_num("Energy_SecureTries", 2) .. "/" .. eai_num("Energy_SecureMute", 60) .. "/" .. eai_num("Energy_SecureHold", 1),
		"share", eai_num("Share_On", 1) .. " " .. eai_num("Share_AddonT1", 0.15) .. "/" .. eai_num("Share_AddonT2", 0.20) .. "/" .. eai_num("Share_AddonT3", 0.30),
		"army", eai_num("Share_ArmyT1", 4) .. "/" .. eai_num("Share_ArmyT2", 6) .. "/" .. eai_num("Share_ArmyT3", 8), "floor_k", eai_num("Share_FloorK", 0.5),
		"addon_dead", eai_num("Energy_AddonDeadTries", 2) .. "/" .. eai_num("Energy_AddonDeadMute", 60))
end
EliteAI_EnergyInit = e_install

strategy_unit_purchase =
{
}

s_capturerMult = 1
s_demand_variance = 0
s_eta_unit_wait_time = 60
s_reinforce_wait_time = 30
s_resurrect_wait_time = 30

function strategy_unit_purchase.init()
	
	print("strategy_unit_purchase.init")
	 
	s_unit_purchase_limit = {} -- example {[PBG_GetID(SBP.SM_MARINE)] = 2,...}

	SBP.TYR_SPORE_MINE = PBG_Get("sbps/pvp/race_tyranid/troops/tyr_spore_mines")
	s_unit_purchase_limit[PBG_GetID(SBP.TYR_SPORE_MINE)]=0

	SBP.TYR_RIPPER = PBG_Get("sbps/pvp/race_tyranid/troops/tyr_ripper")
	s_unit_purchase_limit[PBG_GetID(SBP.TYR_RIPPER)] = 1

	SBP.IG_SPOTTER = PBG_Get("sbps/pvp/race_imperial_guard/troops/ig_spotter_squad")
	s_unit_purchase_limit[PBG_GetID(SBP.IG_SPOTTER)]=0
	
	SBP.IG_SENTINEL = PBG_Get("sbps/pvp/race_imperial_guard/vehicles/ig_sentinel")
	s_unit_purchase_limit[PBG_GetID(SBP.IG_SENTINEL)]=math.ceil(1*modFactor)
	
	SBP.IG_GUARDSMEN = PBG_Get("sbps/pvp/race_imperial_guard/troops/ig_guardsmen_squad")
	s_unit_purchase_limit[PBG_GetID(SBP.IG_GUARDSMEN)]=math.ceil(1.5*modFactor)

	SBP.IG_HWT = PBG_Get("sbps/pvp/race_imperial_guard/troops/ig_heavy_weapon_squad")
	s_unit_purchase_limit[PBG_GetID(SBP.IG_HWT)]=math.ceil(1*modFactor)

	SBP.SM_DEV = PBG_Get("sbps/pvp/race_marine/troops/sm_devastator")
	s_unit_purchase_limit[PBG_GetID(SBP.SM_DEV)]=math.ceil(1.1*modFactor)

	SBP.SM_RHINO = PBG_Get("sbps/pvp/race_marine/vehicles/sm_rhino")
	s_unit_purchase_limit[PBG_GetID(SBP.SM_RHINO)]=math.ceil(1*modFactor)

	SBP.ORK_LOOTA = PBG_Get("sbps/pvp/race_ork/troops/ork_lootas")
	s_unit_purchase_limit[PBG_GetID(SBP.ORK_LOOTA)] = 1

	-- stored off so this can be overriden by scar
	s_demand_variance = s_personality.demand_variance
	s_eta_unit_wait_time = s_personality.eta_unit_wait_time

	-- EliteAI (spend): fresh state on init/Reset and one line that says the watchdog is in
	if EliteAI and EliteAI.on then
		EliteAI_S = { last_buy = 0, above_t = -1, hot = false, said = {}, n_buy = 0, n_none = 0, addon_floor = 0, bought_hot = 0, cool = -1 }
		eai_log("SPEND", "init", "version", EliteAI_SPEND_VERSION, "bank", eai_num("Spend_BankReq", 400) .. "/" .. eai_num("Spend_BankPow", 300),
			"idle", eai_num("Spend_IdleSecs", 45), "retry", eai_num("Spend_RetrySecs", 12), "addon_floor", eai_num("Spend_AddonFloor", 8),
			"kill_inactive", eai_num("Spend_KillInactive", 1), "pow_unit", eai_num("Spend_PowUnit", 40), "lowpow_mult", eai_num("Spend_LowPowMult", 0.25),
			"over_lock", eai_num("Spend_OverLock", 1), "no_glue", eai_num("Spend_NoGlue", 1))

		EliteAI_G = { said = {}, n_drop = 0 }                                 -- gate: fresh state + "GATE init"
		eai_log("GATE", "init", "version", EliteAI_GATE_VERSION, "super_min_time", eai_num("SuperMinTime", 1080), "super_min_army", eai_num("SuperMinArmy", 8),
			"super_cost", eai_num("SuperCost", 1000), "log", eai_num("Gate_LogSecs", 30))
		EliteAI_ReinforceInit()                                              -- reinf: fresh state + "REINF init"
		EliteAI_EnergyInit()                                                 -- energy: fresh state, wrappers of the addon run + "ENERGY init"
	end
end

function AccumulateReinforceDemand( availableResources )
	-- run through all the squads that need reinforcements and see if they could use
	-- a reinforcement - or we can allocate money to them
	if (Task_CountProduction( s_selfplayer, PITEM_SquadReinforce ) == 0 and AIProduction_AnyReinforcementsNeeded( s_selfplayer )) then
		local reinforcecount = AIProduction_GetReinforcementSquadCount( s_selfplayer )

		aitrace("Units needing reinforcement:"..reinforcecount)
		
		-- EliteAI (reinf): the verdict per blueprint of the new logic (nil for Elite's AIs = everything as before)
		local gate = nil
		if EliteAI and EliteAI.on then gate = EliteAI_ReinforceGate( reinforcecount, availableResources ) end

		for i=0, reinforcecount-1 do 
			local squadpbg = AIProduction_GetReinforcementSquadPBGAt( s_selfplayer, i )
			local reinforce_cost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, squadpbg )
			
			aitrace("ReinforceCost:"..res_to_str( reinforce_cost ).. " total cost:"..res_to_str(AIProduction_GetReinforcementSquadCostAt( s_selfplayer, i )))
			
			local eta = GetETAFromCost( reinforce_cost, availableResources )
			local allowed = true
			if gate ~= nil then
				local key = (squadpbg ~= nil) and (string.gsub(string.lower(PBG_GetName( squadpbg ) or ""), "\\", "/")) or ""
				allowed = (gate[key] ~= false)                                 -- false = the arbiter skips this blueprint now
			end
			if (eta <= s_reinforce_wait_time) and allowed then

				local sk_reinforce_mult = 50				-- kk increased from 20 to incr total reinforce demand
				
				aitrace("Reinforce squad: " .. PBG_GetName( squadpbg ) )
				
				-- approximate demand for this unit (tends to over-estimate value, but we prefer to reinforce so that should be fine)
				local demand = CalcSquadDemand( squadpbg )
				aitrace("Reinforce demand before:"..demand.." after:"..demand*sk_reinforce_mult)
			
				SetSquadDemand( squadpbg, demand*sk_reinforce_mult, PURCHASETYPE_REINFORCE )
			end
		end
	end
end

function AccumulateResurrectDemand( availableResources )
	-- run through all the squads that are unconscious and see if they could use resurrection
	-- or we can allocate money to them
	
	if (Task_Count(s_selfplayer, TGROUP_Resurrect) == 0 and AIResource_GetNumUnconsciousSquads( s_selfplayer ) > 0) then
		aitrace("A Unit needs Resurrection.")

		local squad = AIResource_GetUnconsciousSquad( s_selfplayer )
		local resurrect_cost = AIResource_GetResurrectSquadCost( squad )
			
		aitrace("ResurrectCost:"..res_to_str( resurrect_cost ))
			
		local eta = GetETAFromCost( resurrect_cost, availableResources )
		if (eta <= s_resurrect_wait_time) then
			local squadpbg = AISquad_ConvertToPBG(squad)
			local deprecProgress = AIResource_GetResurrectDepreciationProgress(squad)
			-- deprecProgress^4 to push purchase towards cheaper end of purchase
			local sk_resurrect_mult = 10 * deprecProgress * deprecProgress * deprecProgress * deprecProgress
				
			-- approximate demand for this unit -- ideally we would use the squad itself, with health set to max, since it may be upgraded and levelled up.
			local demand = CalcSquadDemand( squadpbg )
			aitrace("Resurrect demand before:"..demand.." after:"..demand*sk_resurrect_mult)
			
			SetSquadDemand( squadpbg, demand*sk_resurrect_mult, PURCHASETYPE_RESURRECT )
		end
	end
end

function AccumulateSquadDemand( availableResources, reinforce_only )

	aipushtrace("AccumulateSquadDemand")

	-- do reserrection demand
	AccumulateResurrectDemand( availableResources )
	
	-- check popcaps - if we are too high then no need to demand anything at all
	-- 
	local curpopcap = cache.current_population_personnel
	local maxpopcap = cache.max_population_personnel
	if (curpopcap >= maxpopcap) then
		aitrace("Reached popcap - cannot produce units")
		aipoptrace()
		return
	end
	
	-- do reinforcement demand
	aipushtrace("AccumulateReinforceSquadDemand")

	AccumulateReinforceDemand( availableResources )
	
	aipoptrace()

	-- since we are asked to only do reinforcements - skip the rest
	if (reinforce_only) then
		aitrace("Stop short because of reinforce_only flag")
		aipoptrace()
		return
	end
	
	-- If we need more units for map control, prefer units which can be built immediately
	local needSquadsUrgentlyMultiplier = GetSquadUrgentNeedMultiplier()
	if (needSquadsUrgentlyMultiplier > 1) then
		aitrace("AI needs squads!  Badly!  needSquadsUrgentlyMultiplier:"..tostring(needSquadsUrgentlyMultiplier))
	end
	
	aipushtrace("AccumulatePurchaseSquadDemand")

	local eai_on = EliteAI and EliteAI.on
	if eai_on then EliteAI_PurchasePrep(); EliteAI_P.plan = nil end        -- (13: the plan's next unit is noted in the loop below)

	-- go through each buildable squad for this AI and determine what its demand is given
	-- this AIs class/anti-class needs are
	local buildableTotal = AIProduction_GetBuildableSquadCount( s_selfplayer )
	for i=0, buildableTotal-1 do
		local pbg = AIProduction_GetBuildableSquadAt( s_selfplayer, i )
	
		-- if this unit is available then lets determine the demand for this unit
		if (AIProduction_CanProduce( s_selfplayer, PITEM_Spawn, pbg ) == true) then
		
			-- since we can produce this unit - lets determine this units demand
			local demand = CalcSquadDemand( pbg )
			-- EliteAI (gate, step 15): a blueprint we forbid (super unit outside its window, limit 0) gets no demand at all - no
			-- ETA, no entry in HighestSquadDemand, never the "first" choice TryPurchaseUnitChoice stalls on ("GATE drop" in the log)
			if eai_on and EliteAI_GateDrop( pbg, string.lower(PBG_GetName( pbg ) or "") ) then demand = 0 end
			if eai_on then demand = EliteAI_PurchaseShape( demand ) end        -- 0.7: the engine's rating as an order, its span compressed
			
			-- add capturer demand (only if pbg can capture NOW)
			if (PBG_CanCapture( s_selfplayer, pbg )) then
				demand = demand * GetCapturerDemandMult()
			end
			
		
						
			if (demand > 0) then
			
				-- ETA - how does the time factor into this unit
				local eta, requisitionETA, powerETA = GetUnitETA( pbg, availableResources )
				
				aitrace( string.format("%s Demand:%.0f ETA:%.0f/%.0f Req-ETA:%.0f Pow-ETA:%.0f", PBG_GetName(pbg), demand, eta, s_eta_unit_wait_time, requisitionETA, powerETA ) )
				
				-- EliteAI (13): the plan's next unit - on the first pass the demand of a unit beyond Elite's wait that the income
				-- brings within Plan_EtaMax is worked out by the same rules; it is noted (EliteAI_PlanNote), never set as a demand
				local in_wait = (eta <= s_eta_unit_wait_time)
				if in_wait or (eai_on and EliteAI_P.pass == 0 and eta <= eai_num("Plan_EtaMax", eai_num("Energy_EtaMax", 120))) then
				
					-- duplicate demand decrease - this decreases the demand of a unit we have too many of
					
					local pbgid = PBG_GetID( pbg )
						
					local curAmount = UtilPBG_CountTotal( pbg )
					
					local demandmult = 2/(2 + curAmount )                                -- kk moved this line and added declining demand

					if (s_unit_purchase_limit and s_unit_purchase_limit[ pbgid ]) then
						local unitcap = s_unit_purchase_limit[ pbgid ]

						if unitcap < 1 then 		-- kk k extra back up to stop forbidden unit purchase
							if not eai_on then return end
							demand = 0      -- EliteAI (10.11): a forbidden unit (spore mines, IG spotters) only skips itself; Elite's return
							                -- dropped every unit after it in the HQ list (tyranids: venom cannon, genestealers, tyrant guard, carnifex...)
						end

						-- local curAmount = UtilPBG_CountTotal( pbg )
						if (curAmount >= unitcap) or (curAmount >=  1+ math.ceil(1*modFactor)) then
							demandmult = 1 / ( (curAmount-unitcap) + 6)  -- 1/2, 1/3, 1/4, 1/5 etc -- kk changed to 1/6 from 1/2
						end
						

						demand = demand * demandmult
						aitrace("Lower-Demand Mult:"..demandmult)
					end
						
					if (needSquadsUrgentlyMultiplier > 1.0) then
						if (eta ==0) then							-- kk this must be for call ins
							demand = demand * needSquadsUrgentlyMultiplier
							aitrace("Urgent-Demand Increase:"..needSquadsUrgentlyMultiplier)
						else
							demand = demand / needSquadsUrgentlyMultiplier
							aitrace("Urgent-Demand Decrease:"..needSquadsUrgentlyMultiplier)
						end
						
					end

					if eai_on then
						demand = demand * EliteAI_PurchaseMult( pbg, curAmount )
					end

					aitrace( string.format("FinalDemand:%.0f", demand ) )
									
					if (demand > 0) then
						if in_wait then SetSquadDemand( pbg, demand, PURCHASETYPE_SPAWN ) end
						if eai_on then EliteAI_PlanNote( pbg, demand, eta, in_wait ) end
					end
					
				end
			end
			
		else
			aitrace("CanNOTProduce:"..PBG_GetName( pbg ) )
		end
		
	end
		
	aipoptrace()
	aipoptrace()
	
end

function CalcCapturerDemand( )
	
	aipushtrace("CalcCapturerDemand")
	
	s_capturerMult = 1
	
	-- only ask for capture demand increases when we have are not losing by a ton 
	if (cache.military_value > 15 and cache.military_percent_value < -0.3) then
		aitrace("Losing: giving no capturer mults")
		return
	end
	
	local ptsWanted = s_capture_pts_wanted - Task_CountActive( s_selfplayer, TASK_Capture, false )
	aitrace("PtsWanted(from resourcing):"..ptsWanted)

	local curCapturers = AIResource_GetNumCapturers( s_selfplayer )
	-- also need to know how many we have requested for
	local capturerRequests = Task_CountCapturerPBG( s_selfplayer )
	-- total capturers + requested
	local totalCapturers = (capturerRequests + curCapturers);
	aitrace("Capturers: Cur:"..curCapturers.." Req:"..capturerRequests.." Total:"..totalCapturers)
	
	-- don't ask for more capturers then there are ptsWanted
	local trueCapturerDemand = math.max( ptsWanted - totalCapturers, 0 )			
	
	aitrace("CapturerNeed:"..trueCapturerDemand)
	if (trueCapturerDemand <= 0) then
		return
	end
	
	local tier_level = cache.tech_tier_level						-- kk added line
	
	-- this is default number we should aim for
	local minCapturers = 2
	local wantedCapturers = 1+3 + math.ceil(1*modFactor*raceFact)
	local maxCapturers = 5 + math.ceil(2*modFactor*raceFact)					-- kk these numbers increased
	
	if (totalCapturers >= maxCapturers) then	
		return -- early out
	end
	
	-- 1. check if our base is under attack if we are the demands will change based on the attack 
	if (cache.threat_at_base > 5 ) then
		minCapturers = 1									-- kk these numbers increased
		wantedCapturers = math.ceil(2*modFactor)
		maxCapturers = math.ceil(3*modFactor)
	end
	
	local bonusdemand = trueCapturerDemand/40  -- adds .1 for every 4 more pts we want	-- kk changed back to original
		
			aitrace("BonusDemandMult:"..bonusdemand)
	local demand = 1
	local tier_level = cache.tech_tier_level

	if ( (tier_level == 1) and (cache.military_count >= wantedCapturers -1)) then
		demand = 0.5
	elseif (totalCapturers  < minCapturers) then
		demand = 2 + bonusdemand
	elseif (totalCapturers < wantedCapturers) then
		demand = math.max(3, bonusdemand)
	elseif (totalCapturers < maxCapturers) then
		demand = 2
	end
	
	s_capturerMult = demand
	aitrace("Capturer Demand Mult:"..demand)
	
	aipoptrace()
	
end

function GetCapturerDemandMult()
	CalcCapturerDemand( )
	return s_capturerMult

end

------------------------------------------------------
-- Calculate the time we will wait for a unit we 
-- really want (sometimes we just don't have the time
-- or the funds to get what we want)
-- 
function CalculateUnitETA( purchase_count )

	aitrace("CalcUnitETA")
	
	local offset_eta = 0
	
	-- if we have previously purchased a unit on this frame (then bypass offset)
	if (purchase_count == 0) then
	
		-- if we have some military units then we have some safe-guard so we can increase
		-- it slightly
		if (cache.military_count > 4) then							-- kk changed from 3 to 4
			offset_eta = offset_eta + (cache.military_count-4)*5
		end

		aitrace("OffsetETA:"..offset_eta)
		
		-- get the base rate from the personality file
		s_eta_unit_wait_time = math.max( s_personality.eta_unit_wait_time + offset_eta, 0 )
	else
		s_eta_unit_wait_time = 0
	end
	
	aitrace("NewUnitETA:"..s_eta_unit_wait_time)
	
end

function GetETAFromChoice( choice_entry, availableResources )
	
	if (choice_entry[3] == PURCHASETYPE_SPAWN) then
		return GetUnitETA( choice_entry[1], availableResources )
	elseif (choice_entry[3] == PURCHASETYPE_ABILITY) then
		local cost = AIAbility_GetCost( s_self_modplayer, choice_entry[1] )
		return GetETAFromCost( cost, availableResources )
	elseif (choice_entry[3] == PURCHASETYPE_REINFORCE) then
		local cost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, choice_entry[1] )
		return GetETAFromCost( cost, availableResources )
	elseif (choice_entry[3] == PURCHASETYPE_RESURRECT) then
		local squad = AIResource_GetUnconsciousSquadByPBG( s_selfplayer, choice_entry[1] )
		local cost = AIResource_GetResurrectSquadCost( squad )
		return GetETAFromCost( cost, availableResources )
	end
	
	return 0
end

-- takes a table filled with chosen units, and this picks 
function ChooseBestAvailableUnitFromList( sorted_choices, availableResources )
		
	if (sorted_choices==nil) then
		aitrace("Nothing to purchase!")
		return nil
	end
	
	local num_choices = table.getn( sorted_choices )
	aitrace("Num Choices:"..num_choices)
	
	if (num_choices == 0) then
		aitrace("Nothing to purchase!")
		return nil
	end
	
	local found_valid = false
	-- initialize the best choice as the first one
	local best_choice = sorted_choices[1]

	-- return pos between 0 and num_choices-1
	local random_startpos = AI_RandMax( num_choices )
	aitrace("Rand start choice:"..random_startpos)
	
	for k,v in pairs(sorted_choices) do
	
		local choice_index = random_startpos+k
		-- loop around check
		if (choice_index > num_choices) then
			choice_index = choice_index - num_choices
		end
	
		-- get this choice
		local choice = sorted_choices[ choice_index ]
		
		-- if requested, see if this item can be built immediately
		local passedETATest = true
		
		if (availableResources) then
			local eta = GetETAFromChoice( choice, availableResources )
			if (eta==nil or eta>0) then
				passedETATest = false
			end
		end
		
		if (passedETATest) then
		
			local prevReq = 0
			-- look at pbgs that need a spawner
			if (choice[3] == PURCHASETYPE_SPAWN) then
				-- see if this choice is available
				prevReq = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, choice[1] )
			end
			aitrace("Trying to purchase "..PBG_GetName( choice[1] ).."! Available:"..prevReq )
			
			-- if this choice has a place to be built, then lets build it
			if (prevReq==0) then
				aitrace("Chose a free unit, index:"..choice_index)
				best_choice = choice
				found_valid = true
				break
			end
		end
	end
	
	return best_choice, found_valid

end

function FindZeroETAUnit( availableResources )
	
	aitrace("FindZeroETAUnit")
	
	-- generate a request for this unit if can be built
	local sorted_choices = HighestSquadDemand(0.8)
	
	-- runs through the list of demanded units and finds one that can be built (not checking money)
	local best_choice, is_valid = ChooseBestAvailableUnitFromList( sorted_choices, availableResources )
	
	-- see if found anything
	if (best_choice==nil or is_valid==false) then
		return
	end
		
	-- tries to purchase the best choice, if not it locks the resources anyways
	local purchased, cost = TryPurchaseUnitChoice( best_choice, availableResources )
	
	return purchased, cost
end

function TryPurchaseUnitChoice( best_choice, availableResources ) 

	-- set readable vars
	local pbg, demand, purchase_type = best_choice[1], best_choice[2], best_choice[3]
		
	if (pbg) then

		if (purchase_type == nil) then
			error("PURCHASE TYPE HAS NOT BEEN DEFINED!! "..PBG_GetName(pbg))
		end

		aitrace("Highest demand:: type:"..tostring(purchase_type).." demand:"..tostring(demand).." name: "..PBG_GetName( pbg ));
		local unitCost
		
		if (purchase_type==PURCHASETYPE_SPAWN) then
			unitCost = SquadStats_GetCost( s_self_modplayer, pbg )
		elseif (purchase_type==PURCHASETYPE_ABILITY) then
			unitCost = AIAbility_GetCost( s_self_modplayer, pbg )
		elseif (purchase_type==PURCHASETYPE_REINFORCE) then
			unitCost = AIPlayer_GetProductionCost( s_self_modplayer, PITEM_SquadReinforce, pbg )
		elseif (purchase_type==PURCHASETYPE_RESURRECT) then
			local squad = AIResource_GetUnconsciousSquadByPBG( s_selfplayer, pbg )
			unitCost = AIResource_GetResurrectSquadCost( squad )
		end
		
		-- determine if this can purchase this item
		if (not ResourceAmount_Has( availableResources, unitCost )) then
			aitrace("Stalling because of lack of moola("..PBG_GetName(pbg)..") Demand:"..demand)
			-- EliteAI (energy): the spawn the pipeline waits for - squad upgrades wait for it when it is within reach (Conf_AddonVsUnit)
			if EliteAI and EliteAI.on and purchase_type == PURCHASETYPE_SPAWN then
				EliteAI_EnergyNoteStall( pbg, unitCost, "money", availableResources, 0 )
				-- 0.6: a call-in this budget can pay and the arbiter lets pass over the unit goes now - nothing is locked for the unit
				local cn, cc = EliteAI_CallInFirst( pbg, unitCost, "money", availableResources )
				if cn then return true, cc end
			end
			return false, unitCost
		end
	
		-- do the following checks for ability spawned units
		if (purchase_type==PURCHASETYPE_ABILITY) then
			
			-- count number of abilities inactive
			local taskCount = Task_CountActive( s_selfplayer, TASK_PlayerAbility, false )
			-- only request one of these at a time
			if (taskCount>0) then
				aitrace("PlayerAbility had already been purchased, skipping!")
				return false, unitCost
			end
			
			aitrace("Producing an ability-based unit("..PBG_GetName(pbg)..") Demand:"..demand)
			-- cast this ability which creates a request
			PlayerAbility_Cast( pbg )
						
		elseif (purchase_type==PURCHASETYPE_REINFORCE) then
			
			Request_Production( s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits+20, PITEM_SquadReinforce, pbg )
			if EliteAI and EliteAI.on then
				EliteAI_ReinforceNoteRequest( unitCost )                            -- reinf: the ledger of the last minute
				EliteAI_EnergyPay( "reinf", unitCost and unitCost.requisition, unitCost and unitCost.power )
			end

		elseif (purchase_type==PURCHASETYPE_RESURRECT) then
			
			-- EliteAI 0.8 (Orca's match on newai-17: "buy_revive 620 ... 250/0 bank 262/165" three times in one tick, the book says
			-- "revive 6x 1500" for two revivals of 250 - the units budget runs several passes a tick and the task count Elite
			-- checks is the last tick's): one request per Energy_ReviveGap (10 s)
			local rev_now = World_GetGameTime()
			local rev_dup = EliteAI and EliteAI.on and EliteAI_E ~= nil and EliteAI_E.rev_t ~= nil and rev_now - EliteAI_E.rev_t < eai_num("Energy_ReviveGap", 10)
			if not rev_dup then Request_Resurrection( s_selfplayer, TGROUP_Resurrect, TPRIORITY_BuildUnits+20, pbg ) end
			if EliteAI and EliteAI.on and EliteAI_E ~= nil and not rev_dup then EliteAI_E.rev_t = rev_now end
			-- EliteAI 0.7: the commander's revival was in no book and in no line (a purchase of this budget like the others)
			if EliteAI and EliteAI.on and unitCost ~= nil and not rev_dup then
				eai_log("buy_revive", eai_time(), string.lower(PBG_GetName(pbg) or ""), s_rp(unitCost), "bank", s_rp(cache and cache.resources))
				EliteAI_EnergyNote( "revive", unitCost )
			end

		else
			-- get the number of producers available (with considering requests/queues) for the given pbg
			local prevReq = PBG_GetNumRequestsForProducer( s_selfplayer, PITEM_Spawn, pbg )
			
			aitrace("MinimumFullChannels:"..prevReq)
		
			-- if there are no channels open - then stall this request
			if (prevReq > 0) then
				aitrace("Stalling unitbuild because of lack of production channels("..PBG_GetName(pbg)..") Demand:"..demand)
				-- EliteAI (energy): the money is there, the HQ is busy - the upgrades of the other run leave this unit its req (Conf_AddonVsUnit)
				if EliteAI and EliteAI.on then
					EliteAI_EnergyNoteStall( pbg, unitCost, "channel", availableResources, prevReq )
					local cn, cc = EliteAI_CallInFirst( pbg, unitCost, "channel", availableResources )   -- 0.6: the HQ is busy, the call-in needs none
					if cn then return true, cc end
				end
				return false, unitCost
			end
	
			-- EliteAI 0.6 (TECH_RU.md 15.2): the call-in or this unit is decided before the unit is bought (the scene d: the unit took
			-- the bank in the tick the call-in of the same price could first be cast, the arbiter never saw the pair)
			if EliteAI and EliteAI.on then
				local cn, cc = EliteAI_CallInFirst( pbg, unitCost, "ready", availableResources )
				if cn then return true, cc end
			end
			-- 11.11 (20.10, s25b): no request the engine refuses for the population cap (phantom "buy" lines, the counter's demand
			-- "answered" by nothing); PopMargin = room for a squad of the line
			if EliteAI and EliteAI.on and cache then
				local pop, popmax = cache.current_population_personnel or 0, cache.max_population_personnel or 0
				if popmax > 0 and popmax - pop < eai_num("PopMargin", 8) then return false, unitCost end
			end
			-- EliteAI 0.9 (TECH_RU.md 21.13; s27a / s27b: "buy" every 3-4 s with a growing bank and no squad). A request the engine
			-- does not start stays inactive, Elite kills it at the next purchase tick and this place asks again - and wrote "buy"
			-- and booked the cost every time. Now: (1) nothing is asked while the last requests died (EliteAI_UnitPause) or while
			-- the engine says it cannot start this blueprint now (AIProduction_CanProduceNow - the watchdog's "now false": pop,
			-- the producer): the blueprint steps aside for Unit_NotNowMute and nothing is locked for it; (2) the request is
			-- noted and gets its verdict at the next tick (u_settle): "buy ... by task|count|bank" and the book, or "buy_dead"
			if EliteAI and EliteAI.on then
				if EliteAI_UnitPause( World_GetGameTime() ) then return false, unitCost end
				if eai_num("Unit_NowOnly", 1) >= 1 and not AIProduction_CanProduceNow( s_selfplayer, PITEM_Spawn, pbg ) then
					EliteAI_UnitNotNow( pbg, unitCost )
					return false
				end
			end
			aitrace("Producing a unit("..PBG_GetName(pbg)..") Demand:"..demand)
			if EliteAI and EliteAI.on then
				EliteAI_UnitNoteRequest( pbg, string.lower(PBG_GetName(pbg) or ""), unitCost, "", true )   -- its "buy" line and the book: u_settle
			end
			Request_Production( s_selfplayer, TGROUP_BuildUnits, TPRIORITY_BuildUnits, PITEM_Spawn, pbg )
			print("UnitPurchase: Produce:"..PBG_GetName(pbg)  )
		end
		
		if (s_designer_squad_chosen) then
			DesignerDemandChosen( s_designer_squad_chosen )
		end
		
		return true, unitCost
	end
		
	return false

end

-- purchase_count - is the number of times this frame we have purchased units (for when we have lots of money)
function strategy_unit_purchase.do_purchase( availableResources, purchase_count )
	
	-- check to see if this is enabled
	if (s_components[COMPONENT_BuildUnits]==false) then
		aitrace("SKIPPING - Build-Unit-Strategy COMPONENT")
		return
	end

	AIProfile_Marker("AIUnitPurchase")
	
	aipushtrace("Build-Unit-Strategy")

	-- EliteAI (spend): the idle-bank watchdog goes first - before reinforcements, the difficulty cap and Elite's demand
	if EliteAI and EliteAI.on then
		EliteAI_P.pass = purchase_count or 0                                -- 13: the plan's next unit is noted on the first pass only
		EliteAI_EnergyTick( purchase_count )                                -- energy: float state, units-vs-upgrades arbiter, stats
		EliteAI_ReinforceTick( availableResources, purchase_count )         -- reinf: squad scan, save state, stats (numbers only)
		-- energy 0.2: the tech plan's reserve is off this budget whatever the order of the budgets in this tick (scene c: the plan
		-- wanted T3 at 0.2 s, the units budget ran first and bought an ogryn with the whole bank at 0.3 s; c2: the genestealer)
		if availableResources ~= nil then
			EliteAI_E.av_req, EliteAI_E.av_pow = availableResources.requisition or 0, availableResources.power or 0   -- what the budget system gave (the stall line)
			availableResources = e_reserved( availableResources, false )
		end

		local sp, sc = EliteAI_SpendIdle( availableResources, purchase_count )
		if sp then
			aipoptrace()
			return sp, sc
		end
	end

	local reinforce_only = false
	-- is unit purchasing disabled because the AI has too many units? 
	if (s_designer_demand_enabled == false and state_analysis.enable_military_unit_building==false) then
		aitrace("AI Has Too Many Units As Per Difficulty Level - REINFORCE ONLY")
		reinforce_only = true
		-- EliteAI (11.11, the scene polygon): Elite's cap of the Easy / Normal personalities ("glue": no new units, reinforcements
		-- only, while our army is glue_military_percentage times the closest enemy's - state_analysis.ai:29-65, base_standard.ai:54-58)
		-- is not for the new logic, which plays the standard personality but is meant to be one good player. In the polygon's
		-- scenes (a strong army against dummies) it switched the unit pipeline off from the second second on: "builds next to
		-- nothing", and no counter unit could be bought against a garrison. Spend_NoGlue=0 gives the cap back.
		if EliteAI and EliteAI.on and eai_num("Spend_NoGlue", 1) >= 1 then
			reinforce_only = false
			local now = World_GetGameTime()
			if EliteAI_S.glue_said == nil or now - EliteAI_S.glue_said >= 60 then
				EliteAI_S.glue_said = now
				eai_log("SPEND", "cap", "off", "Elite's unit cap ignored (reinforce only), building goes on:", "mil", math.floor((cache and cache.military_value) or -1),
					"pct", string.format("%.2f", math.min((cache and cache.military_percent_value) or 0, 9999)), "glue", tostring(s_personality and s_personality.glue_military_percentage))
			end
		end
	end
	
	aitrace("------------------------------------")
	
	-- this determines the amount of time we will wait for the next best unit
	CalculateUnitETA(purchase_count)
	
	-- reset the demand system - since we are going to start all over again
	ResetDemand()
	
	-- if designer demand is enabled, we will use the values they have set
	if (s_designer_demand_enabled==true) then
		aitrace("Designer Demand Enabled")
		
		s_designer_squad_chosen = CalcDesignerDemand()
		-- get info from designers/scar to determine the demand of units
		-- if this returns nil, try the designer preferences
		if (s_designer_squad_chosen==nil) then
			AccumulateSquadDemand( availableResources, reinforce_only )
		end
	else
		aitrace("Calculating demand from game-state")
		
		-- calculate demand based on the world state
		Demand_UpdateAICombatRatings()

		-- calc capturing demand values
		CalcCapturerDemand()
		
		-- take all the demands (class, anti-class, preferences) and set the demand per squad
		AccumulateSquadDemand( availableResources, reinforce_only )

	end
	
	-- EliteAI (13): the plan's next unit becomes the claim before the choice - a reinforcement that goes first in this tick
	-- no longer hides that a unit is waited for (EliteAI_PlanClaim)
	if EliteAI and EliteAI.on and purchase_count == 0 then EliteAI_PlanClaim( availableResources ) end

	-- generate a request for this unit if can be built
	local sorted_choices = HighestSquadDemand(s_demand_variance)
	
	-- runs through the list of demanded units and finds one that can be built (not checking money)
	local best_choice = ChooseBestAvailableUnitFromList( sorted_choices )
	
	-- see if found anything
	if (best_choice==nil) then
		aipoptrace()
		return
	end

	-- EliteAI 0.9 (TECH_RU.md 21.13, the polygon's scene p_ork_answer): Elite takes one of the choices within the variance by a
	-- random start - the deff dread (270) became affordable before the tankbustas (300) the Counter layer asked for and was
	-- bought every time the bank reached it. An answer among the choices goes first (it waits for its money as Elite's own choice would)
	if EliteAI and EliteAI.on then best_choice = EliteAI_AnswerChoice( sorted_choices, best_choice ) end
		
	-- tries to purchase the best choice, if not it locks the resources anyways
	local purchased, cost = TryPurchaseUnitChoice( best_choice, availableResources )

	-- EliteAI (energy 0.2): while the tech plan holds its reserve, a unit that is short of money locks nothing - the research is
	-- first whatever the order of the budgets (the lock of a stalled genestealer left the research "avail 0/855", scene c2)
	if EliteAI and EliteAI.on and purchased == false and cost and ((EliteAI_E.res_req or 0) + (EliteAI_E.res_pow or 0)) > 0 then
		return false                                                        -- (no aipoptrace: as Elite's own return at the end of this function)
	end
	
	-- if we didn't purchase anything but locked some money, and we have excess money, see if we can 
	-- buy anything with the leftovers
	if (purchased==false and cost and cache.resources.requisition > 750) then
		-- 
		aitrace("Trying to use up excess requisition")
		local modifiedRes = ResourceAmount_Subtract( availableResources, cost )
		if (modifiedRes.requisition > 100) then
			local eta_purchase, eta_cost = FindZeroETAUnit( modifiedRes )
			if (eta_purchase and eta_cost) then
				local total_cost = ResourceAmount_Add( cost, eta_cost )
				return false, total_cost
			end
		end
		
	end
	
	return purchased, cost
	
end

end
