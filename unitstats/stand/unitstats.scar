-- STAND ONLY (unitstats_test.sh): UnitStats experiment - spawn squads of different kinds near the base, select one at a time
local L = eliteai_log or (string and string.eliteai_log) or print
local function try(name, fn, ...) if type(fn) ~= "function" then L(name, "no function"); return false end local r = {pcall(fn, ...)}; L(name, tostring(r[1]), tostring(r[2])); return r[1], r[2] end
US = { list = {}, k = 0 }
local OWN = { "sbps/pvp/race_eldar/troops/eld_guardian", "sbps/pvp/race_eldar/troops/eld_banshee", "sbps/pvp/race_eldar/vehicles/eld_falcon",
	"sbps/pvp/race_eldar/vehicles/eld_wraithlord", "sbps/pvp/race_eldar/troops/eld_warp_spider" }
local ENEMY = { "sbps/pvp/race_marine/troops/sm_tactical_marine", "sbps/pvp/race_marine/troops/sm_assault_marine" }
local function spawn(p, bp, pos, tag)
	local ok, id = pcall(World_GetPropertyBagGroupID, bp); if not ok or not id then L("NO BLUEPRINT", bp); return end
	local ok2, s = pcall(Squad_CreateAndSpawnToward, id, p, 0, pos, US.base)
	if not ok2 or not s then L("SPAWN FAILED", bp, tostring(s)); return end
	local g = SGroup_CreateIfNotFound("us_g" .. (#US.list + 1)); SGroup_Add(g, s); pcall(SGroup_SetInvulnerable, g, true)
	table.insert(US.list, { s = s, name = bp, pos = pos, tag = tag }); L("spawned", tag, bp)
end
function US_Setup()
	US.P = World_GetPlayerAt(1); US.E = World_GetPlayerAt(2)
	US.base = Player_GetStartingPosition(US.P)
	SGroup_ForEach(Player_GetSquads(US.P), function(g, i, s) table.insert(US.list, { s = s, name = "start squad " .. i, pos = Squad_GetPosition(s), tag = "own" }) end)
	for i, bp in ipairs(OWN) do spawn(US.P, bp, World_Pos(US.base.x + 14 + 9 * ((i - 1) % 3), US.base.y, US.base.z + 14 + 10 * math.floor((i - 1) / 3)), "own") end
	for i, bp in ipairs(ENEMY) do spawn(US.E, bp, World_Pos(US.base.x + 18 + 10 * i, US.base.y, US.base.z + 40), "enemy") end
	try("FOW_RevealAll", FOW_RevealAll)
	L("SETUP done", #US.list)
end
Rule_AddOneShot(US_Setup, 3)
function US_Next()
	if #US.list == 0 then return end
	if US.prev then pcall(Misc_SelectSquad, US.prev, false) end
	US.k = US.k + 1; if US.k > #US.list then US.k = 1 end
	local e = US.list[US.k]
	local ok, p = pcall(Squad_GetPosition, e.s); if not ok then L("gone", e.name); return end
	try("Camera_FocusOnPosition", Camera_FocusOnPosition, p, false, 0, false)
	try("SELECT " .. US.k .. " " .. e.tag .. " " .. e.name, Misc_SelectSquad, e.s, true)
	US.prev = e.s
end
Rule_AddInterval(US_Next, 10)
L("unitstats scar loaded")
